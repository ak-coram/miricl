;;;; Indexed table semantics, collisions, mutation, and large native workloads.
(in-package #:miricl-test)
(in-suite :miricl)

(defun reference-hash-results (keys test)
  ;; Association lookup is an independent oracle for hashing. In particular,
  ;; ECL's EQUALP hash table misses some equal rational/float keys.
  (let ((entries nil))
    (labels ((put (key value)
               (let ((entry (assoc key entries :test test)))
                 (if entry (setf (cdr entry) value) (push (cons key value) entries))))
             (lookup (key &optional default)
               (let ((entry (assoc key entries :test test)))
                 (if entry (list (cdr entry) t) (list default nil)))))
      (loop for key in keys for i from 0 do (put key i))
      (let ((before (mapcar #'lookup keys)) (count (length entries)))
        (loop for key in keys for i from 0 when (evenp i)
              do (setf entries (remove key entries :key #'car :test test)))
        (let ((after (mapcar (lambda (key) (lookup key :missing)) keys))
              (remaining (length entries)))
          (dolist (key (reverse keys)) (put key :new))
          (list count before remaining after (length entries) (mapcar #'lookup keys)
                t 0 (mapcar (constantly '(nil nil)) keys)))))))

(test indexed-hash-tables
  (m:with-interpreter (vm :fuel 1000000000)
    (dolist (test '(eq eql equal equalp))
      (let* ((key-forms (append '(nil t 'a 'b (list 1 2) (list 1 2)
                                  (copy-seq "ab") (copy-seq "ab") (copy-seq "AB")
                                  (function car) (function cdr) (make-hash-table))
                                (unless (eq test 'eq)
                                  '(0 1 -1 1.0 1d0 1/2 -5/7 0.1 0.1d0 1/10
                                    (rational 0.1) (rational 0.1d0) #c(1 2) #c(1.0 0.0)
                                    #\a #\A #\λ #\Λ (list 1.0 2.0) (cons 1 2) (cons 1.0 2.0)))))
             (form `(let ((keys (list ,@key-forms)) (table (make-hash-table :test ',test)))
                      (let ((i 0)) (dolist (key keys) (setf (gethash key table) i) (incf i)))
                      (let ((before (mapcar (lambda (key) (multiple-value-list (gethash key table))) keys))
                            (count (hash-table-count table)))
                        (let ((i 0)) (dolist (key keys) (when (evenp i) (remhash key table)) (incf i)))
                        (let ((after (mapcar (lambda (key) (multiple-value-list (gethash key table :missing))) keys))
                              (remaining (hash-table-count table)))
                          (dolist (key (reverse keys)) (setf (gethash key table) :new))
                          (list count before remaining after (hash-table-count table)
                            (mapcar (lambda (key) (multiple-value-list (gethash key table))) keys)
                            (eq table (clrhash table)) (hash-table-count table)
                            (mapcar (lambda (key) (multiple-value-list (gethash key table))) keys)))))))
        (is (equal (reference-hash-results (eval `(list ,@key-forms)) test)
                   (m:evaluate vm form)) "Hash lookup mismatch for ~S" test)))
    ;; EQ/EQL hashing of mutable objects must stay stable after visible changes.
    (dolist (test '(eq eql))
      (let ((form `(let* ((a (list 1)) (b (copy-seq "abc")) (table (make-hash-table :test ',test)))
                     (setf (gethash a table) 1 (gethash b table) 2)
                     (setf (car a) 99 (char b 0) #\z)
                     (list (gethash a table) (gethash b table) (hash-table-count table)))))
        (is (equal (eval form) (m:evaluate vm form)))))
    (is (equal '(1 2 (nil t) (:missing nil)) (m:evaluate vm
      '(let ((table (make-hash-table :test 'equalp)))
         (setf (gethash 1 table) :first (gethash #c(1.0 0.0) table) nil)
         (list (hash-table-count table) (length (multiple-value-list (gethash 1.0 table)))
               (multiple-value-list (gethash 1d0 table)) (multiple-value-list (gethash 2 table :missing)))))))
    (dolist (form '((let ((table (make-hash-table)) (seen nil))
                     (list (setf (gethash (progn (push 1 seen) 'key)
                                   (progn (push 2 seen) table) (progn (push 3 seen) 'ignored))
                             (progn (push 4 seen) 9)) seen (multiple-value-list (gethash 'key table))))
                    (let ((table (make-hash-table :test 'equalp)))
                      (setf (gethash 0.0 table) :zero)
                      (list (gethash -0d0 table) (gethash 0 table) (hash-table-count table)))
                    (let ((table (make-hash-table :test 'equal)))
                      (setf (gethash 0.0 table) :positive (gethash -0.0 table) :negative)
                      (list (gethash 0.0 table) (gethash -0.0 table) (hash-table-count table)))))
      (is (equal (eval form) (m:evaluate vm form))))))

(test indexed-hash-collisions-and-cycles
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (test '(eq eql))
      (dolist (order '((0 1 2 3 4) (4 3 2 1 0) (2 0 4 1 3)))
        (let ((form `(let ((keys (list (list 1) (list 2) (list 3) (list 4) (list 5)))
                           (table (make-hash-table :test ',test)) (results nil))
                      (dolist (key keys) (setf (gethash key table) (car key)))
                      (dolist (index ',order)
                        (let ((key (nth index keys)))
                          (push (list (gethash key table) (remhash key table) (remhash key table)
                                  (hash-table-count table)
                                  (mapcar (lambda (k) (multiple-value-list (gethash k table))) keys)) results)))
                      results)))
          (is (equal (eval form) (m:evaluate vm form))))))
    (is (equal '(t t t) (m:evaluate vm
      '(let ((a (list 1)) (b (list 1)) (table (make-hash-table :test 'equal)))
         (setf (cdr a) a (cdr b) b)
         (list (typep (sxhash a) 'fixnum) (= (sxhash a) (sxhash b))
               (progn (setf (gethash a table) 42) (= (gethash a table) 42)))))))
    (dolist (form '((let ((a (make-list 20000 :initial-element 1)))
                     (= (sxhash a) (sxhash (copy-list a))))
                    (let* ((a (list nil)) (b (list nil)))
                      (setf (car a) a (car b) b) (= (sxhash a) (sxhash b)))
                    (let* ((s (make-symbol "HASH-NAME")) (before (sxhash s)))
                      (import s (make-package "HASH-IMPORT" :use nil))
                      (= before (sxhash s)))
                    (and (typep (sxhash nil) 'fixnum) (>= (sxhash nil) 0))))
      (is (eq t (m:evaluate vm form))))))

(test indexed-hash-large-characters
  (m:with-interpreter (vm :fuel 2000000000)
    (is (equal '(63488 63488 t t t) (m:evaluate vm
      '(let ((characters (make-hash-table :test 'equal)) (integers (make-hash-table :test 'eql)))
         (dotimes (i 65536)
           (let ((c (code-char i))) (when c (setf (gethash c characters) i (gethash i integers) c))))
         (list (hash-table-count characters) (hash-table-count integers)
           (eql (gethash (code-char 32768) characters) 32768)
           (eql (gethash 65535 integers) (code-char 65535))
           (null (gethash 55296 integers)))))))))

(test indexed-hash-mixed-updates
  (m:with-interpreter (vm :fuel 1000000000)
    (let ((form '(let ((table (make-hash-table)) (state 7) (results nil))
                   (dotimes (i 2048)
                     (setq state (logand (+ (* state 1103515245) 12345) 2147483647))
                     (let ((key (logand state 511)))
                       (case (logand (ash state -9) 3)
                         (0 (remhash key table))
                         (1 (setf (gethash key table) nil))
                         (2 (setf (gethash key table) i)))
                       (push (list (hash-table-count table)
                               (multiple-value-list (gethash key table :absent))) results)))
                   results)))
      (is (equal (eval form) (m:evaluate vm form))))
    (dolist (source '("(gethash)" "(gethash 1)" "(gethash 1 nil nil nil)"
                      "(hash-table-count)" "(hash-table-count nil nil)"
                      "(clrhash)" "(clrhash nil nil)" "(sxhash)" "(sxhash 1 2)"
                      "(funcall (fdefinition '(setf gethash)) 1 2)"))
      (is (eq t (m:evaluate-string vm (concatenate 'string
        "(handler-case " source " (program-error () t))")))))
    (dolist (source '("(gethash 1 nil)" "(setf (gethash 1 nil) 2)"
                      "(hash-table-count nil)" "(clrhash nil)" "(remhash 1 nil)"))
      (is (eq t (m:evaluate-string vm (concatenate 'string
        "(handler-case " source " (type-error () t))")))))))

(test hash-table-construction-properties
  (m:with-interpreter (vm :fuel 1000000000)
    (dolist (test '(eq eql equal equalp))
      (dolist (designator (list `',test `(function ,test)))
        (let ((form `(let ((h (make-hash-table :test ,designator :size 17 :rehash-size 3 :rehash-threshold 1/2)))
                       (list (hash-table-test h) (hash-table-rehash-size h)
                         (>= (hash-table-size h) 17) (= (hash-table-count h) 0)
                         (= (hash-table-rehash-threshold h) 1/2) (hash-table-p h)))))
          (is (equal (eval form) (m:evaluate vm form))))))
    (dolist (rehash '(1 2 17 1.5f0 1.5d0))
      (dolist (threshold '(0 1 1/3 1/2 0.5f0 1d0))
        (is (eq t (m:evaluate vm
          `(let* ((h (make-hash-table :size 0 :rehash-size ,rehash :rehash-threshold ,threshold))
                  (copy (make-hash-table :size (hash-table-size h) :test (hash-table-test h)
                          :rehash-size (hash-table-rehash-size h) :rehash-threshold (hash-table-rehash-threshold h))))
             (and (= (hash-table-rehash-size h) ,rehash)
                  (= (hash-table-rehash-threshold h) ,threshold)
                  (typep (hash-table-rehash-size h) ',(if (integerp rehash) 'integer 'float))
                  (zerop (hash-table-count copy)) (>= (hash-table-size copy) 0))))))))
    (is (eq t (m:evaluate vm
      '(let* ((hint (expt 2 100)) (rehash (1+ hint))
              (h (make-hash-table :size hint :rehash-size rehash :rehash-threshold 1/3)))
         (and (>= (hash-table-size h) hint) (eql (hash-table-rehash-size h) rehash)
           (= (hash-table-rehash-threshold h) 1/3))))))
    (is (eq t (m:evaluate vm
      '(let ((h (make-hash-table :size 1 :rehash-size 1 :rehash-threshold 0)))
         (dotimes (i 1000) (setf (gethash i h) i))
         (and (= (hash-table-count h) 1000) (>= (hash-table-size h) 1000)
           (progn (clrhash h) (and (zerop (hash-table-count h))
             (= (hash-table-rehash-size h) 1) (= (hash-table-rehash-threshold h) 0))))))))
    (is (eq t (m:evaluate vm
      '(let ((name (gensym)))
         (setf (symbol-function name) #'eq)
         (eq (hash-table-test (make-hash-table :test name)) 'eq)))))
    (is (equal '(eq 17 3 1/2) (m:evaluate vm
      '(let ((h (make-hash-table :test 'eq :test nil :size 17 :size -1
                  :rehash-size 3 :rehash-size 3/2 :rehash-threshold 1/2 :rehash-threshold -1
                  :unknown 17 :allow-other-keys t)))
         (list (hash-table-test h) (hash-table-size h) (hash-table-rehash-size h) (hash-table-rehash-threshold h))))))
    (dolist (function '(hash-table-test hash-table-size hash-table-rehash-size hash-table-rehash-threshold))
      (is (= 1 (length (multiple-value-list (m:evaluate vm `(,function (make-hash-table)))))))
      (dolist (bad '(nil 17 1/2 "bad" #(1 2) (1 2)))
        (is (eq t (m:evaluate vm `(let ((bad ',bad))
          (handler-case (,function bad)
            (type-error (c) (and (eq bad (type-error-datum c))
              (not (typep bad (type-error-expected-type c)))))))))))
      (dolist (args '(nil (nil nil)))
        (is (eq t (m:evaluate vm `(handler-case (,function ,@args) (program-error () t)))))))
    (dolist (options '((:test nil) (:test 'car) (:test #'car) (:test (lambda (a b) (eql a b)))
                       (:size -1) (:size 1.5) (:size nil)
                       (:rehash-size 0) (:rehash-size -1) (:rehash-size 3/2) (:rehash-size 1.0)
                       (:rehash-threshold -1) (:rehash-threshold 2) (:rehash-threshold nil)))
      (is (eq t (m:evaluate vm `(handler-case (make-hash-table ,@options) (type-error () t))))))
    (dolist (options '((:test) (:size) (:unknown 1)
                       (:allow-other-keys nil :allow-other-keys t :unknown 1)))
      (is (eq t (m:evaluate vm `(handler-case (make-hash-table ,@options) (program-error () t))))))))

(test hash-table-iteration-macro
  (m:with-interpreter (vm :fuel 1000000000)
    ;; Successful iterators return a generalized boolean (ECL uses an index).
    ;; Normalize that value while retaining the number of returned values.
    (dolist (form
      '((multiple-value-list (with-hash-table-iterator (next (make-hash-table))))
        (multiple-value-list (with-hash-table-iterator (next (make-hash-table)) (values)))
        (multiple-value-list (with-hash-table-iterator (next (make-hash-table)) (values 1 2 3)))
        (with-hash-table-iterator (next (make-hash-table)) (multiple-value-list (next)))
        (let ((h (make-hash-table))) (setf (gethash nil h) nil)
          (with-hash-table-iterator (next h) (list (multiple-value-call (lambda (more &rest values) (cons (not (null more)) values)) (next)) (multiple-value-call (lambda (more &rest values) (cons (not (null more)) values)) (next)))))
        (let ((n 0)) (with-hash-table-iterator (next (progn (incf n) (make-hash-table))) (declare (optimize)) n))
        (let ((a (make-hash-table)) (b (make-hash-table)))
          (setf (gethash 1 a) 2 (gethash 3 b) 4)
          (with-hash-table-iterator (outer a)
            (with-hash-table-iterator (inner b) (list (multiple-value-call (lambda (more &rest values) (cons (not (null more)) values)) (outer)) (multiple-value-call (lambda (more &rest values) (cons (not (null more)) values)) (inner))))))
        (let ((h (make-hash-table)) (pairs nil))
          (dotimes (i 20) (setf (gethash i h) (+ i 10)))
          (with-hash-table-iterator (next h)
            (loop (multiple-value-bind (more key value) (next)
              (unless more (return)) (remhash key h) (push (cons key value) pairs))))
          (list (hash-table-count h) (sort pairs #'< :key #'car)))
        (let ((h (make-hash-table)) (pairs nil))
          (dotimes (i 20) (setf (gethash i h) (+ i 10)))
          (with-hash-table-iterator (next h)
            (loop (multiple-value-bind (more key value) (next)
              (unless more (return)) (setf (gethash key h) (+ value 100)) (push (cons key value) pairs))))
          (list (hash-table-count h) (sort pairs #'< :key #'car)
                (loop for i below 20 collect (gethash i h))))
        (let ((h (make-hash-table))) (setf (gethash 1 h) 2)
          (with-hash-table-iterator (next h)
            (list (flet ((next () 17)) (next)) (multiple-value-call (lambda (more &rest values) (cons (not (null more)) values)) (next)))))
        (with-hash-table-iterator (next (make-hash-table))
          (macrolet ((expanded (&environment env) (if (equal (macroexpand '(next) env) '(next)) nil t))) (expanded)))
        (block done (let ((x 17)) (with-hash-table-iterator (next (return-from done x)) (declare (special x)))))))
      (is (equalp (eval form) (m:evaluate vm form)) "Iterator mismatch for ~S" form))
    (dolist (test '(eq eql equal equalp))
      (is (eq t (m:evaluate vm
        `(let ((h (make-hash-table :test ',test)) (count 0))
           (dotimes (i 20) (setf (gethash i h) (1+ i)))
           (with-hash-table-iterator (next h)
             (loop (multiple-value-bind (more key value) (next)
               (unless more (return)) (unless (= value (1+ key)) (error 'simple-error)) (incf count))))
           (= count 20))))))
    (dolist (form '((with-hash-table-iterator) (with-hash-table-iterator (next))
                    (with-hash-table-iterator (next nil 17))
                    (with-hash-table-iterator (next (make-hash-table)) (next 1))))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
    (is (eq t (m:evaluate vm '(handler-case (with-hash-table-iterator (next 17)) (type-error () t)))))))
