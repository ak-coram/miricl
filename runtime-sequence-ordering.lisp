        (if (ref.is_null (local.get $scan)) (then (local.set $result (local.get $cell)))
          (else (struct.set $obj $b (ref.cast (ref $obj) (local.get $scan)) (local.get $cell))))
        (local.set $scan (local.get $cell)))
