;;;; Initialization uses an explicit target metadata model, never host MOP layouts.
(in-package #:miricl-test)
(in-suite :miricl)

(defun clos-method-test-metadata (selector object extra)
  (case selector
    (0 (svref object 0))
    (1 (setf (svref object 0) t))
    (2 (svref object 1))
    (3 (svref object 2))
    ((4 13) (svref object 0))
    (5 (svref object 1))
    (6 (svref (svref object 2) 3))
    (7 (svref object 2))
    (8 (setf (svref (svref object 2) 4) extra
             (svref (svref object 2) 3) t))
    (9 (or (miricl-runtime:list-length-or-cycle object)
           (error 'type-error :datum object :expected-type 'list)))
    (10 (let ((size (clos-method-test-metadata 9 object nil)))
          (if (oddp size) (error 'program-error) size)))
    (14 (functionp object))
    (11 (svref object 0))
    (12 (error 'simple-type-error :datum object :expected-type 'list
               :format-control "Malformed target initialization metadata."))))

(test clos-method-initarg-selection
  (let ((args (list :a nil :b 2 :a 3 :c 4)))
    (dolist (keys '((:a) (:b :a) (:c :a :b)))
      (is (eq (cdr args) (miricl-runtime:clos-initarg-cell-value args keys #'clos-method-test-metadata))))
    (is (eq (nthcdr 3 args) (miricl-runtime:clos-initarg-cell-value args '(:b) #'clos-method-test-metadata)))
    (is (null (miricl-runtime:clos-initarg-cell-value args '(:unknown) #'clos-method-test-metadata))))
  (dolist (args '((:a) (:a . 3) 7))
    (signals error (miricl-runtime:clos-initarg-cell-value args '(:a) #'clos-method-test-metadata)))
  (let ((cycle (list :a 1)))
    (setf (cddr cycle) cycle)
    (signals type-error (miricl-runtime:clos-initarg-cell-value cycle '(:a) #'clos-method-test-metadata))
    (signals type-error (miricl-runtime:clos-initarg-cell-value '(:a 1) cycle #'clos-method-test-metadata)))
  (is (equal '(1) (miricl-runtime:clos-initarg-cell-value '(:a 1) '(:a) #'clos-method-test-metadata))))

(test clos-method-default-initargs
  (let* ((events nil) (value (list :identity))
         (defaults (list (list :a nil (lambda () (push :a events) (values value :ignored)))
                         (list :b nil (lambda () (push :b events) 2))
                         (list :a nil (lambda () (error "Overridden default ran.")))))
         (class (vector nil defaults nil))
         (args (list :b nil))
         (result (miricl-runtime:clos-default-initargs-value class args #'clos-method-test-metadata)))
    (is (svref class 0))
    (is (equal '(:b nil :a (:identity)) result))
    (is (eq value (fourth result)))
    (is (equal '(:a) events))
    (is (equal '(:b nil) args))
    (is (not (eq result args)))
    (let ((all (list :a 9 :b 10)))
      (is (eq all (miricl-runtime:clos-default-initargs-value class all #'clos-method-test-metadata)))))
  (let* ((class (vector t (list (list :x nil (lambda () (values :x :ignored)))
                               (list :y nil (lambda () :y))) nil))
         (result (multiple-value-list
                   (miricl-runtime:clos-default-initargs-value class nil #'clos-method-test-metadata))))
    (is (equal '((:x :x :y :y)) result)))
  (dolist (entry '(nil (:x) (:x nil) (:x nil nil) (:x nil 42)))
    (signals error
      (miricl-runtime:clos-default-initargs-value (vector t (list entry) nil) nil #'clos-method-test-metadata)))
  (let* ((defaults (list (list :x nil (lambda () 1)))) (class (vector t defaults nil)))
    (setf (cdr defaults) defaults)
    (signals type-error (miricl-runtime:clos-default-initargs-value class nil #'clos-method-test-metadata)))
  ;; Initfunctions may mutate the original metadata spine without taking over
  ;; the worker's finite traversal or changing its remaining slot identities.
  (let* ((defaults (list nil (list :b nil (lambda () 2))))
         (class (vector t defaults nil)))
    (setf (car defaults) (list :a nil (lambda () (setf (cdr defaults) defaults) 1)))
    (is (equal '(:a 1 :b 2)
          (miricl-runtime:clos-default-initargs-value class nil #'clos-method-test-metadata)))))

(test clos-method-shared-initialize
  (dolist (selection '(t nil (a) (b) (a b)))
    (let* ((events nil)
           (a (vector 'a '(:a :alias) (lambda () (push 'a events) (values 10 :ignored)) nil nil))
           (b (vector 'b '(:b) (lambda () (push 'b events) 20) t :bound))
           (c (vector 'c '(:c :alias) nil nil nil))
           (class (vector t nil (list a b c))) (object (vector class))
           (arguments (list :alias nil :a :later :b :new)))
      (is (equal (list object) (multiple-value-list
               (miricl-runtime:clos-shared-initialize-value object selection arguments #'clos-method-test-metadata))))
      (is (null events))
      (is (and (svref a 3) (null (svref a 4))))
      (is (eq :new (svref b 4)))
      (is (and (svref c 3) (null (svref c 4))))))
  (dolist (selection '(t nil (a) (b)))
    (let* ((events nil)
           (a (vector 'a '(:a) (lambda () (push 'a events) 10) nil nil))
           (b (vector 'b '(:b) (lambda () (push 'b events) (values 20 :ignored)) t :bound))
           (c (vector 'c nil nil nil nil))
           (class (vector t nil (list a b c))) (object (vector class)))
      (is (eq object (miricl-runtime:clos-shared-initialize-value object selection nil #'clos-method-test-metadata)))
      (is (equal (if (or (eq selection t) (member 'a selection)) '(a) nil) events))
      (is (eq :bound (svref b 4)))
      (is (not (svref c 3)))))
  (let* ((slot (vector 'x '(:x) nil nil nil)) (class (vector t nil (list slot))) (object (vector class))
         (cycle (list 'x)))
    (setf (cdr cycle) cycle)
    (signals type-error (miricl-runtime:clos-shared-initialize-value object cycle nil #'clos-method-test-metadata))
    (setf (svref slot 1) cycle)
    (signals type-error (miricl-runtime:clos-shared-initialize-value object t '(:x 1) #'clos-method-test-metadata))
    (setf (svref slot 1) '(:x))
    (is (eq object (miricl-runtime:clos-shared-initialize-value object t '(:x 1) #'clos-method-test-metadata)))
    (is (= 1 (svref slot 4)))))

(test clos-method-effective-slot-selection
  (let* ((first (vector 'x nil nil nil nil)) (last (vector 'x nil nil nil nil))
         (other (vector 'y nil nil nil nil)) (slots (list first other last)))
    (dolist (direct '(nil t))
      (is (eq last (miricl-runtime:clos-find-slot-value slots 'x direct #'clos-method-test-metadata)))
      (is (eq other (miricl-runtime:clos-find-slot-value slots 'y direct #'clos-method-test-metadata)))
      (is (null (miricl-runtime:clos-find-slot-value slots 'z direct #'clos-method-test-metadata))))
    (setf (cdddr slots) slots)
    (signals type-error (miricl-runtime:clos-find-slot-value slots 'x nil #'clos-method-test-metadata))
    (is (eq first (miricl-runtime:clos-find-slot-value (list first) 'x nil #'clos-method-test-metadata)))))
