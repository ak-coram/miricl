  #@(if (i32.and (call $scalar-integer-p (local.get $a)) (call $scalar-integer-p (local.get $b)))
    (then
      (local.set $av (call $magnitude64 (local.get $a)))
      (local.set $bv (call $magnitude64 (local.get $b)))
      (return (call $uint64 (i64.div_u (local.get $av) (local.get $bv)))
              (call $uint64 (i64.rem_u (local.get $av) (local.get $bv))))))
