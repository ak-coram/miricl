  ;; quotient estimation and correction mutate only these fresh scratch arrays.
  #@(local.set $n (call $integer-length (ref.as_non_null (local.get $b))))
  #@(local.set $shift (i32.sub (i32.clz (call $digit (local.get $b)
    (i32.sub (local.get $n) (i32.const 1)))) (i32.const 17)))
  #@(local.set $u (array.new_default $digits (i32.add (local.get $i) (i32.const 1))))
  #@(local.set $v (array.new_default $digits (local.get $n)))
  #@(local.set $j (i32.const 0))
  #@(loop $normalize-a
    (local.set $mid (i32.or (i32.shl (call $digit (local.get $a) (local.get $j)) (local.get $shift))
      (local.get $carry)))
    (array.set $digits (local.get $u) (local.get $j) (i32.and (local.get $mid) (i32.const 32767)))
    (local.set $carry (i32.shr_u (local.get $mid) (i32.const 15)))
    (local.set $j (i32.add (local.get $j) (i32.const 1)))
    (br_if $normalize-a (i32.lt_u (local.get $j) (local.get $i))))
  #@(array.set $digits (local.get $u) (local.get $i) (local.get $carry))
  #@(local.set $carry (i32.const 0))
