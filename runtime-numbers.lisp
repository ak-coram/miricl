;;;; Numeric tower: integers, ratios, floats, and complex arithmetic.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; Integers have three canonical representations: immediate signed i31,
;; boxed signed i64, then immutable signed-magnitude base-2^15 bignums.
;; The common object layout and the portable digit transport remain independent
;; of these representations. Only the boxed scalar subtype has an i64 field.
(define-runtime-function $int64 (($value i64)) (:object)
  #@(if (i32.and (i64.ge_s (local.get $value) (i64.const -1073741824))
                 (i64.le_s (local.get $value) (i64.const 1073741823)))
    (then (return (ref.i31 (i32.wrap_i64 (local.get $value))))))
  #@(struct.new $fixnum (call $allocate-object-tag (i32.const 1))
    (i32.sub (i64.gt_s (local.get $value) (i64.const 0)) (i64.lt_s (local.get $value) (i64.const 0)))
    (f64.const 0) (ref.null $digits) (ref.null eq) (ref.null eq) (ref.null eq) (local.get $value)))

(define-runtime-function $int (($n i32)) (:object)
  #@(call $int64 (i64.extend_i32_s (local.get $n))))

(define-runtime-function $scalar-integer-p (($x :nullable-object)) (i32)
  #@(i32.or (ref.test (ref i31) (local.get $x)) (ref.test (ref $fixnum) (local.get $x))))

(define-runtime-function $scalar-integer-value (($x :object)) (i64)
  #@(if (result i64) (ref.test (ref i31) (local.get $x))
    (then (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $x)))))
    (else (struct.get $fixnum $value (ref.cast (ref $fixnum) (local.get $x))))))

(define-runtime-function $magnitude64 (($x :object)) (i64)
  (:locals ($value i64))
  #@(local.set $value (call $scalar-integer-value (local.get $x)))
  ;; MIN-I64's magnitude is an unsigned i64; no signed ABS or division traps.
  #@(select (i64.sub (i64.const 0) (local.get $value)) (local.get $value)
            (i64.lt_s (local.get $value) (i64.const 0))))

(define-runtime-function $integer-length (($x :object)) (i32)
  (:locals ($bits i32))
  #@(if (call $scalar-integer-p (local.get $x))
    (then (local.set $bits (i32.sub (i32.const 64) (i32.wrap_i64 (i64.clz (call $magnitude64 (local.get $x))))))
      (return (select (i32.div_u (i32.add (local.get $bits) (i32.const 14)) (i32.const 15))
        (i32.const 1) (local.get $bits)))))
  #@(array.len (struct.get $obj $digits (ref.cast (ref $obj) (local.get $x)))))

(define-runtime-function $digit (($x :object) ($i i32)) (i32)
  #@(if (call $scalar-integer-p (local.get $x))
    (then
      (if (i32.ge_u (local.get $i) (i32.const 5)) (then (return (i32.const 0))))
      (return (i32.and (i32.wrap_i64 (i64.shr_u (call $magnitude64 (local.get $x))
        (i64.extend_i32_u (i32.mul (local.get $i) (i32.const 15))))) (i32.const 32767)))))
  #@(if (result i32) (i32.lt_u (local.get $i) (call $integer-length (local.get $x)))
    (then (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $x))) (local.get $i)))
    (else (i32.const 0))))

(define-runtime-function $integer
    (($sign i32) ($digits :digits)) (:object)
  (:locals ($length i32) ($trimmed :digits) ($bits i64) ($i i32) ($high i32))
  #@(local.set $length (array.len (local.get $digits)))
  #@(block $done (loop $trim
    (br_if $done (i32.le_u (local.get $length) (i32.const 1)))
    (br_if $done (array.get $digits (local.get $digits) (i32.sub (local.get $length) (i32.const 1))))
    (local.set $length (i32.sub (local.get $length) (i32.const 1))) (br $trim)))
  #@(if (i32.or (i32.eqz (local.get $sign))
        (i32.and (i32.eq (local.get $length) (i32.const 1)) (i32.eqz (array.get $digits (local.get $digits) (i32.const 0)))))
    (then (return (ref.i31 (i32.const 0)))))
  #@(local.set $high (array.get $digits (local.get $digits) (i32.sub (local.get $length) (i32.const 1))))
  #@(if (i32.or (i32.lt_u (local.get $length) (i32.const 5))
        (i32.and (i32.eq (local.get $length) (i32.const 5)) (i32.le_u (local.get $high) (i32.const 8))))
    (then
      (local.set $i (local.get $length))
      (block $loaded (loop $load (br_if $loaded (i32.eqz (local.get $i)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (local.set $bits (i64.or (i64.shl (local.get $bits) (i64.const 15))
          (i64.extend_i32_u (array.get $digits (local.get $digits) (local.get $i))))) (br $load)))
      (if (i32.or (i64.ge_s (local.get $bits) (i64.const 0))
            (i32.and (i32.lt_s (local.get $sign) (i32.const 0)) (i64.eq (local.get $bits) (i64.const -9223372036854775808))))
        (then (return (call $int64 (select (i64.sub (i64.const 0) (local.get $bits)) (local.get $bits)
          (i32.lt_s (local.get $sign) (i32.const 0)))))))))
  #@(local.set $trimmed (local.get $digits))
  #@(if (i32.ne (local.get $length) (array.len (local.get $digits)))
    (then (local.set $trimmed (array.new_default $digits (local.get $length)))
      (array.copy $digits $digits (local.get $trimmed) (i32.const 0) (local.get $digits) (i32.const 0) (local.get $length))))
  (wat-new-object :integer :n #@(local.get $sign) :digits #@(local.get $trimmed)))

(define-runtime-function $small-integer-value (($x :object)) (i32)
  ;; Callers prove at most two magnitude limbs (or otherwise an i32 range).
  #@(i32.wrap_i64 (call $scalar-integer-value (local.get $x))))

(define-runtime-function $negative (($x :object)) (:object)
  (:locals ($value i64))
  #@(if (call $scalar-integer-p (local.get $x))
    (then (local.set $value (call $scalar-integer-value (local.get $x)))
      (if (i64.eq (local.get $value) (i64.const -9223372036854775808))
        (then (return (call $uint64 (local.get $value)))))
      (return (call $int64 (i64.sub (i64.const 0) (local.get $value))))))
  ;; Negating positive 2^63 demotes to MIN-I64; other bignums retain their digits.
  #@(call $integer (i32.sub (i32.const 0) (call $value-n (local.get $x)))
    (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $x))))))

(define-runtime-function $iabs
    (($x :object))
    (:object)
  #@(if (result (ref eq)) (i32.lt_s (call $value-n (local.get $x)) (i32.const 0))
      (then (call $negative (local.get $x))) (else (local.get $x))))

(define-runtime-function $cmpabs
    (($a :object) ($b :object))
    (i32)
  (:locals ($na i32)
           ($nb i32)
           ($i i32)
           ($x i32)
           ($y i32))
  #@(local.set $na (call $integer-length (ref.as_non_null (local.get $a))))
  #@(local.set $nb (call $integer-length (ref.as_non_null (local.get $b))))
  #@(if (i32.ne (local.get $na) (local.get $nb))
      (then (return (select (i32.const -1) (i32.const 1) (i32.lt_u (local.get $na) (local.get $nb))))))
  #@(local.set $i (local.get $na))
  #@(block $done (loop $next
    (br_if $done (i32.eqz (local.get $i)))
    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
    (local.set $x (call $digit (local.get $a) (local.get $i)))
    (local.set $y (call $digit (local.get $b) (local.get $i)))
    (if (i32.ne (local.get $x) (local.get $y))
        (then (return (select (i32.const -1) (i32.const 1) (i32.lt_u (local.get $x) (local.get $y))))))
    (br $next)))
  #@(i32.const 0))

(define-runtime-function $addabs
    (($a :object) ($b :object) ($subtract i32))
    (:object)
  (:locals ($digits :digits)
           ($n i32)
           ($i i32)
           ($carry i32)
           ($v i32))
  #@(local.set $n (i32.add (i32.const 1)
    (select (call $integer-length (ref.as_non_null (local.get $a)))
            (call $integer-length (ref.as_non_null (local.get $b)))
            (i32.gt_u (call $integer-length (ref.as_non_null (local.get $a)))
                      (call $integer-length (ref.as_non_null (local.get $b)))))))
  #@(local.set $digits (array.new_default $digits (local.get $n)))
  #@(block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $v (i32.add (call $digit (local.get $a) (local.get $i)) (local.get $carry)))
    (if (local.get $subtract)
        (then (local.set $v (i32.sub (local.get $v) (call $digit (local.get $b) (local.get $i)))))
        (else (local.set $v (i32.add (local.get $v) (call $digit (local.get $b) (local.get $i))))))
    (array.set $digits (local.get $digits) (local.get $i) (i32.and (local.get $v) (i32.const 32767)))
    (local.set $carry (i32.shr_s (local.get $v) (i32.const 15)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(call $integer (i32.const 1) (local.get $digits)))

(define-runtime-function $iadd
    (($a :object) ($b :object))
    (:object)
  (:locals ($r :object) ($av i64) ($bv i64) ($sum i64)
           ($s i32))
  ;; Two signed i31 values add exactly in i32. No overflow test is needed
  ;; until an operand has already reached the boxed scalar tier.
  #@(if (i32.and (ref.test (ref i31) (local.get $a)) (ref.test (ref i31) (local.get $b)))
    (then (return (call $int (i32.add
      (i31.get_s (ref.cast (ref i31) (local.get $a)))
      (i31.get_s (ref.cast (ref i31) (local.get $b))))))))
  #@(if (i32.and (call $scalar-integer-p (local.get $a)) (call $scalar-integer-p (local.get $b)))
    (then
      (local.set $av (call $scalar-integer-value (local.get $a)))
      (local.set $bv (call $scalar-integer-value (local.get $b)))
      (local.set $sum (i64.add (local.get $av) (local.get $bv)))
      (if (i64.ge_s (i64.and (i64.xor (local.get $av) (local.get $sum))
                             (i64.xor (local.get $bv) (local.get $sum))) (i64.const 0))
        (then (return (call $int64 (local.get $sum)))))))
  #@(local.set $r (local.get $a))
  #@(local.set $s (call $value-n (local.get $a)))
  #@(if (i32.eqz (local.get $s)) (then (return (local.get $b))))
  #@(if (i32.eqz (call $value-n (local.get $b))) (then (return (local.get $a))))
  #@(if (i32.eq (local.get $s) (call $value-n (local.get $b)))
      (then (local.set $r (call $addabs (local.get $a) (local.get $b) (i32.const 0))))
      (else (if (i32.ge_s (call $cmpabs (local.get $a) (local.get $b)) (i32.const 0))
                (then (local.set $r (call $addabs (local.get $a) (local.get $b) (i32.const 1))))
                (else (local.set $r (call $addabs (local.get $b) (local.get $a) (i32.const 1)))
                      (local.set $s (call $value-n (local.get $b)))))))
  #@(if (result (ref eq)) (i32.lt_s (local.get $s) (i32.const 0))
      (then (call $negative (local.get $r))) (else (local.get $r))))

(define-runtime-function $isub (($a :object) ($b :object)) (:object)
  (:locals ($av i64) ($bv i64) ($difference i64))
  #@(if (i32.and (ref.test (ref i31) (local.get $a)) (ref.test (ref i31) (local.get $b)))
    (then (return (call $int (i32.sub
      (i31.get_s (ref.cast (ref i31) (local.get $a)))
      (i31.get_s (ref.cast (ref i31) (local.get $b))))))))
  #@(if (i32.and (call $scalar-integer-p (local.get $a)) (call $scalar-integer-p (local.get $b)))
    (then
      (local.set $av (call $scalar-integer-value (local.get $a)))
      (local.set $bv (call $scalar-integer-value (local.get $b)))
      (local.set $difference (i64.sub (local.get $av) (local.get $bv)))
      (if (i64.ge_s (i64.and (i64.xor (local.get $av) (local.get $bv))
                             (i64.xor (local.get $av) (local.get $difference))) (i64.const 0))
        (then (return (call $int64 (local.get $difference)))))))
  #@(call $iadd (local.get $a) (call $negative (local.get $b))))

(define-runtime-function $imul
    (($a :object) ($b :object))
    (:object)
  (:locals ($digits :digits) ($av i64) ($bv i64) ($limit i64) ($product64 i64) ($negative i32)
           ($a-digits (ref null $digits)) ($b-digits (ref null $digits))
           ($a-digit i32)
           ($na i32)
           ($nb i32)
           ($i i32)
           ($j i32)
           ($carry i32)
           ($v i32)
           ($k i32))
  ;; An i31 product fits signed i64, including MIN-I31 squared.
  #@(if (i32.and (ref.test (ref i31) (local.get $a)) (ref.test (ref i31) (local.get $b)))
    (then (return (call $int64 (i64.mul
      (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $a))))
      (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $b)))))))))
  #@(if (i32.and (call $scalar-integer-p (local.get $a)) (call $scalar-integer-p (local.get $b)))
    (then
      (local.set $av (call $magnitude64 (local.get $a)))
      (local.set $bv (call $magnitude64 (local.get $b)))
      (if (i64.eqz (local.get $bv)) (then (return (ref.i31 (i32.const 0)))))
      (local.set $negative (i32.lt_s (i32.mul (call $value-n (local.get $a)) (call $value-n (local.get $b))) (i32.const 0)))
      (local.set $limit (select (i64.const -9223372036854775808) (i64.const 9223372036854775807) (local.get $negative)))
      (if (i64.le_u (local.get $av) (i64.div_u (local.get $limit) (local.get $bv)))
        (then (local.set $product64 (i64.mul (local.get $av) (local.get $bv)))
          (return (call $int64 (select (i64.sub (i64.const 0) (local.get $product64))
            (local.get $product64) (local.get $negative))))))))
  #@(local.set $na (call $integer-length (ref.as_non_null (local.get $a))))
  #@(local.set $nb (call $integer-length (ref.as_non_null (local.get $b))))
  ;; Hoist representation checks and scalar magnitudes out of the limb loop.
  ;; Bignums reuse their existing arrays; mixed products allocate only the result.
  #@(if (call $scalar-integer-p (local.get $a))
    (then (local.set $av (call $magnitude64 (local.get $a))))
    (else (local.set $a-digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $a))))))
  #@(if (call $scalar-integer-p (local.get $b))
    (then (local.set $bv (call $magnitude64 (local.get $b))))
    (else (local.set $b-digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $b))))))
  #@(local.set $digits (array.new_default $digits (i32.add (local.get $na) (local.get $nb))))
  #@(block $done (loop $outer
    (br_if $done (i32.ge_u (local.get $i) (local.get $na)))
    (local.set $a-digit (if (result i32) (ref.is_null (local.get $a-digits))
      (then (i32.and (i32.wrap_i64 (i64.shr_u (local.get $av)
        (i64.extend_i32_u (i32.mul (local.get $i) (i32.const 15))))) (i32.const 32767)))
      (else (array.get $digits (ref.as_non_null (local.get $a-digits)) (local.get $i)))))
    (local.set $j (i32.const 0)) (local.set $carry (i32.const 0))
    (block $inner-done (loop $inner
      (br_if $inner-done (i32.ge_u (local.get $j) (local.get $nb)))
      (local.set $k (i32.add (local.get $i) (local.get $j)))
      (local.set $v (i32.add (local.get $carry)
        (i32.add (array.get $digits (local.get $digits) (local.get $k))
          (i32.mul (local.get $a-digit)
            (if (result i32) (ref.is_null (local.get $b-digits))
              (then (i32.and (i32.wrap_i64 (i64.shr_u (local.get $bv)
                (i64.extend_i32_u (i32.mul (local.get $j) (i32.const 15))))) (i32.const 32767)))
              (else (array.get $digits (ref.as_non_null (local.get $b-digits)) (local.get $j))))))))
      (array.set $digits (local.get $digits) (local.get $k) (i32.and (local.get $v) (i32.const 32767)))
      (local.set $carry (i32.shr_u (local.get $v) (i32.const 15)))
      (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $inner)))
    (array.set $digits (local.get $digits) (i32.add (local.get $i) (local.get $nb)) (local.get $carry))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $outer)))
  #@(call $integer (i32.mul (call $value-n (local.get $a)) (call $value-n (local.get $b)))
        (local.get $digits)))

(define-runtime-function $idiv
    (($a :object) ($b :object))
    (:object :object)
  (:locals ($q :digits) ($av i64) ($bv i64)
           ($u :digits) ($v :digits) ($remainder :digits)
