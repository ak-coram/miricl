;;;; Native elementary functions without host math imports.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun wat-horner-polynomial (variable coefficients)
  "Coefficients are ordered from the constant term upwards."
  (reduce (lambda (coefficient tail)
            `(f64.add (f64.const ,(coerce coefficient 'double-float))
                      (f64.mul (local.get ,variable) ,tail)))
          (butlast coefficients) :from-end t
          :initial-value `(f64.const ,(coerce (car (last coefficients)) 'double-float))))

(define-runtime-function $atan-f64 (($x f64)) (f64)
  (:locals ($t f64) ($square f64) ($offset f64))
  #@(local.set $t (f64.abs (local.get $x)))
  ;; Octant and half-angle reduction confine the alternating polynomial to
  ;; |t| < 1/5. Fourteen terms put its omitted tail below 2e-22.
  #@(if (f64.gt (local.get $t) (f64.const 2.414213562373095e0))
    (then (local.set $t (f64.div (f64.const -1) (local.get $t)))
      (local.set $offset (f64.const 1.5707963267948966e0)))
    (else (if (f64.gt (local.get $t) (f64.const 0.41421356237309503e0))
      (then (local.set $t (f64.div (f64.sub (local.get $t) (f64.const 1))
        (f64.add (local.get $t) (f64.const 1))))
        (local.set $offset (f64.const 0.7853981633974483e0))))))
  ;; Tiny arguments already round to ATAN(x)=x. Avoid halving a subnormal.
  #@(if (f64.lt (f64.abs (local.get $t)) (f64.const 1e-8))
    (then (return (f64.copysign (f64.add (local.get $offset) (local.get $t)) (local.get $x)))))
  #@(local.set $square (f64.mul (local.get $t) (local.get $t)))
  #@(local.set $t (f64.div (local.get $t)
    (f64.add (f64.const 1) (f64.sqrt (f64.add (f64.const 1) (local.get $square))))))
  #@(local.set $square (f64.mul (local.get $t) (local.get $t)))
  #@(f64.copysign (f64.add (local.get $offset)
    (f64.mul (f64.mul (f64.const 2) (local.get $t))
      ,(wat-horner-polynomial '$square
         (loop for i below 14 collect (/ (if (evenp i) 1 -1) (1+ (* 2 i)))))))
    (local.get $x)))

(define-runtime-function $atan2-f64 (($y f64) ($x f64)) (f64)
  (:locals ($angle f64))
  #@(if (f64.eq (local.get $y) (f64.const 0))
    (then (return (f64.copysign
      (if (result f64) (i64.lt_s (i64.reinterpret_f64 (local.get $x)) (i64.const 0))
        (then (f64.const 3.141592653589793e0)) (else (f64.const 0))) (local.get $y)))))
  #@(if (f64.eq (local.get $x) (f64.const 0))
    (then (return (f64.copysign (f64.const 1.5707963267948966e0) (local.get $y)))))
  #@(local.set $angle (if (result f64) (f64.gt (f64.abs (local.get $y)) (f64.abs (local.get $x)))
    (then (f64.sub (f64.const 1.5707963267948966)
      (call $atan-f64 (f64.abs (f64.div (local.get $x) (local.get $y))))))
    (else (call $atan-f64 (f64.abs (f64.div (local.get $y) (local.get $x)))))))
  #@(if (f64.lt (local.get $x) (f64.const 0))
    (then (local.set $angle (f64.sub (f64.const 3.141592653589793e0) (local.get $angle)))))
  #@(f64.copysign (local.get $angle) (local.get $y)))

(define-runtime-function $real-absolute (($x :object)) (:object)
  #@(if (result (ref $obj))
    (if (result i32) (i32.ge_u (call $tag (local.get $x)) (i32.const 3))
      (then (i64.lt_s (i64.reinterpret_f64 (struct.get $obj $f (local.get $x))) (i64.const 0)))
      (else (i32.lt_s (struct.get $obj $n (call $numerator (local.get $x))) (i32.const 0))))
    (then (call $negate-number (local.get $x))) (else (local.get $x))))

(define-runtime-function $real-angle (($y :object) ($x :object)) (f64)
  (:locals ($a :object) ($b :object) ($ratio f64) ($xs f64) ($ys f64))
  #@(if (i32.and (i32.ge_u (call $tag (local.get $x)) (i32.const 3))
                 (i32.ge_u (call $tag (local.get $y)) (i32.const 3)))
    (then (return (call $atan2-f64 (struct.get $obj $f (local.get $y))
      (struct.get $obj $f (local.get $x))))))
  ;; Normalize exact values before conversion. Neither a huge integer nor a
  ;; ratio of huge integers needs to fit a float to have a representable angle.
  #@(local.set $xs (f64.const 1))
  #@(local.set $ys (f64.const 1))
  #@(if (i32.ge_u (call $tag (local.get $x)) (i32.const 3))
    (then (local.set $xs (f64.copysign (f64.const 1) (struct.get $obj $f (local.get $x)))))
    (else (if (i32.lt_s (struct.get $obj $n (call $numerator (local.get $x))) (i32.const 0))
      (then (local.set $xs (f64.const -1))))))
  #@(if (i32.ge_u (call $tag (local.get $y)) (i32.const 3))
    (then (local.set $ys (f64.copysign (f64.const 1) (struct.get $obj $f (local.get $y)))))
    (else (if (i32.lt_s (struct.get $obj $n (call $numerator (local.get $y))) (i32.const 0))
      (then (local.set $ys (f64.const -1))))))
  #@(local.set $a (call $real-absolute (call $rational (local.get $y))))
  #@(local.set $b (call $real-absolute (call $rational (local.get $x))))
  #@(if (i32.and (call $zero (local.get $a)) (call $zero (local.get $b)))
    (then (return (call $atan2-f64 (f64.mul (f64.const 0) (local.get $ys))
      (f64.mul (f64.const 0) (local.get $xs))))))
  #@(if (i32.le_s (call $compare (local.get $a) (local.get $b)) (i32.const 0))
    (then (local.set $ratio (call $coerce-float
      (call $real-op (i32.const 3) (local.get $a) (local.get $b)) (i32.const 4)))
      (return (call $atan2-f64 (f64.mul (local.get $ratio) (local.get $ys)) (local.get $xs)))))
  #@(local.set $ratio (call $coerce-float
    (call $real-op (i32.const 3) (local.get $b) (local.get $a)) (i32.const 4)))
  #@(call $atan2-f64 (local.get $ys) (f64.mul (local.get $ratio) (local.get $xs))))

(define-runtime-function $transcendental-kind (($z :object)) (i32)
  #@(select (i32.const 4) (i32.const 3)
    (i32.eq (call $tag (call $part (local.get $z) (i32.const 0))) (i32.const 4))))

(define-runtime-function $phase-angle (($z :object)) (f64)
  #@(if (i32.eq (call $tag (local.get $z)) (i32.const 5))
    (then (return (call $real-angle
      (ref.as_non_null (struct.get $obj $b (local.get $z)))
      (ref.as_non_null (struct.get $obj $a (local.get $z)))))))
  ;; A real argument approaches the negative real axis from quadrant II.
  #@(if (result f64) (i32.ge_u (call $tag (local.get $z)) (i32.const 3))
    (then (call $atan2-f64 (f64.const 0) (struct.get $obj $f (local.get $z))))
    (else (if (result f64)
      (i32.lt_s (struct.get $obj $n (call $numerator (local.get $z))) (i32.const 0))
      (then (f64.const 3.141592653589793e0)) (else (f64.const 0))))))

(define-runtime-function $phase-native (($number :nullable-object)) (:object)
  (:locals ($z :object))
  #@(local.set $z (call $number (local.get $number)))
  #@(call $float (call $transcendental-kind (local.get $z)) (call $phase-angle (local.get $z))))

(define-runtime-function $log-series (($t f64)) (f64)
  (:locals ($square f64))
  ;; log((1+t)/(1-t)) = 2(t + t^3/3 + ...); |t| <= 1/5.
  #@(local.set $square (f64.mul (local.get $t) (local.get $t)))
  #@(f64.mul (f64.mul (f64.const 2) (local.get $t))
    ,(wat-horner-polynomial '$square (loop for i below 14 collect (/ 1 (1+ (* 2 i)))))))

(define-runtime-function $log-f64 (($x f64)) (f64)
  (:locals ($e i32) ($bits i64) ($m f64))
  #@(if (f64.lt (local.get $x) (f64.const 2.2250738585072014e-308))
    (then (local.set $x (f64.mul (local.get $x) (f64.const 18014398509481984e0)))
      (local.set $e (i32.const -54))))
  #@(local.set $bits (i64.reinterpret_f64 (local.get $x)))
  #@(local.set $e (i32.add (local.get $e)
    (i32.sub (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 52))) (i32.const 1023))))
  #@(local.set $m (f64.reinterpret_i64 (i64.or
    (i64.and (local.get $bits) (i64.const 4503599627370495)) (i64.const 4607182418800017408))))
  #@(if (f64.gt (local.get $m) (f64.const 1.4142135623730951e0))
    (then (local.set $m (f64.mul (local.get $m) (f64.const 0.5)))
      (local.set $e (i32.add (local.get $e) (i32.const 1)))))
  #@(f64.add (f64.mul (f64.convert_i32_s (local.get $e)) (f64.const 0.6931471803691238e0))
    (f64.add (call $log-series (f64.div (f64.sub (local.get $m) (f64.const 1))
      (f64.add (local.get $m) (f64.const 1))))
      (f64.mul (f64.convert_i32_s (local.get $e)) (f64.const 1.9082149292705877e-10)))))

(define-runtime-function $log1p-f64 (($x f64)) (f64)
  #@(if (result f64) (f64.le (f64.abs (local.get $x)) (f64.const 0.5))
    (then (call $log-series (f64.div (local.get $x) (f64.add (f64.const 2) (local.get $x)))))
    (else (call $log-f64 (f64.add (f64.const 1) (local.get $x))))))

(define-runtime-function $positive-real-log (($x :object)) (f64)
  (:locals ($a :object) ($b :object) ($e i32) ($m f64))
  #@(if (i32.ge_u (call $tag (local.get $x)) (i32.const 3))
    (then (return (call $log-f64 (struct.get $obj $f (local.get $x))))))
  #@(local.set $a (call $numerator (local.get $x)))
  #@(local.set $b (call $denominator (local.get $x)))
  #@(local.set $e (i32.sub (call $bitlength (local.get $a)) (call $bitlength (local.get $b))))
  ;; Rounding an exact argument near one before subtracting one can erase a
  ;; perfectly representable logarithm, e.g. LOG(1+2^-100). Subtract exactly.
  #@(if (i32.le_u (i32.add (local.get $e) (i32.const 1)) (i32.const 2))
    (then (return (call $log1p-f64 (call $coerce-float
      (call $real-op (i32.const 1) (local.get $x) (call $int (i32.const 1))) (i32.const 4))))))
  #@(if (i32.le_u (i32.add (local.get $e) (i32.const 1020)) (i32.const 2040))
    (then (return (call $log-f64 (call $coerce-float (local.get $x) (i32.const 4))))))
  #@(if (i32.gt_s (local.get $e) (i32.const 0))
    (then (local.set $b (ref.as_non_null (call $ash-native (local.get $b) (call $int (local.get $e))))))
    (else (local.set $a (ref.as_non_null (call $ash-native (local.get $a)
      (call $int (i32.sub (i32.const 0) (local.get $e))))))))
  #@(local.set $m (call $coerce-float (call $ratio (local.get $a) (local.get $b)) (i32.const 4)))
  #@(f64.add (f64.mul (f64.convert_i32_s (local.get $e)) (f64.const 0.6931471803691238e0))
    (f64.add (call $log-f64 (local.get $m))
      (f64.mul (f64.convert_i32_s (local.get $e)) (f64.const 1.9082149292705877e-10)))))

(define-runtime-function $square-error-f64 (($x f64) ($square f64)) (f64)
  (:locals ($split f64) ($high f64) ($low f64))
  ;; Dekker splitting recovers the rounding error of a square. This is used
  ;; only for components bounded by one, so splitting cannot overflow.
  #@(local.set $split (f64.mul (local.get $x) (f64.const 134217729)))
  #@(local.set $high (f64.sub (local.get $split) (f64.sub (local.get $split) (local.get $x))))
  #@(local.set $low (f64.sub (local.get $x) (local.get $high)))
  #@(f64.add (f64.add (f64.sub (f64.mul (local.get $high) (local.get $high)) (local.get $square))
    (f64.mul (f64.mul (f64.const 2) (local.get $high)) (local.get $low)))
    (f64.mul (local.get $low) (local.get $low))))

(define-runtime-function $unit-log-magnitude (($x f64) ($y f64)) (f64)
  (:locals ($a f64) ($b f64) ($sum f64) ($error f64))
  #@(local.set $a (f64.mul (local.get $x) (local.get $x)))
  #@(local.set $b (f64.mul (local.get $y) (local.get $y)))
  #@(local.set $sum (f64.add (local.get $a) (local.get $b)))
  ;; |x| >= |y|: FastTwoSum recovers the sum's error. Combining both square
  ;; errors before LOG1P retains small logarithms on either side of |z|=1.
  #@(local.set $error (f64.add (f64.sub (local.get $b) (f64.sub (local.get $sum) (local.get $a)))
    (f64.add (call $square-error-f64 (local.get $x) (local.get $a))
      (call $square-error-f64 (local.get $y) (local.get $b)))))
  #@(f64.mul (f64.const 0.5) (call $log1p-f64
    (f64.add (f64.sub (local.get $sum) (f64.const 1)) (local.get $error)))))

(define-runtime-function $natural-log (($z :object) ($kind i32)) (:object)
  (:locals ($a :object) ($b :object) ($swap :object) ($ratio f64) ($magnitude f64) ($angle f64))
  (wat-fail-when #@(call $zero (local.get $z)) :division-by-zero)
  #@(if (i32.ne (call $tag (local.get $z)) (i32.const 5))
    (then (local.set $a (call $real-absolute (local.get $z)))
      (local.set $magnitude (call $positive-real-log (local.get $a)))
      (if (ref.eq (local.get $a) (local.get $z))
        (then (return (call $float (local.get $kind) (local.get $magnitude)))))
      (return (call $complex (call $float (local.get $kind) (local.get $magnitude))
        (call $float (local.get $kind) (f64.const 3.141592653589793e0))))))
  #@(local.set $angle (call $phase-angle (local.get $z)))
  #@(local.set $a (call $real-absolute (ref.as_non_null (struct.get $obj $a (local.get $z)))))
  #@(local.set $b (call $real-absolute (ref.as_non_null (struct.get $obj $b (local.get $z)))))
  #@(if (i32.lt_s (call $compare (local.get $a) (local.get $b)) (i32.const 0))
    (then (local.set $swap (local.get $a)) (local.set $a (local.get $b)) (local.set $b (local.get $swap))))
  #@(if (i32.ge_u (call $tag (local.get $a)) (i32.const 3))
    (then (if (i32.and (f64.le (struct.get $obj $f (local.get $a)) (f64.const 1))
                       (f64.ge (struct.get $obj $f (local.get $a)) (f64.const 0.5)))
      (then (return (call $complex (call $float (local.get $kind)
        (call $unit-log-magnitude (struct.get $obj $f (local.get $a)) (struct.get $obj $f (local.get $b))))
        (call $float (local.get $kind) (local.get $angle)))))))
    (else (if (i32.le_u (i32.add (i32.sub (call $bitlength (call $numerator (local.get $a)))
                 (call $bitlength (call $denominator (local.get $a)))) (i32.const 1)) (i32.const 1))
      (then (return (call $complex (call $float (local.get $kind) (f64.mul (f64.const 0.5)
        (call $positive-real-log (call $real-op (i32.const 0)
          (call $real-op (i32.const 2) (local.get $a) (local.get $a))
          (call $real-op (i32.const 2) (local.get $b) (local.get $b))))))
        (call $float (local.get $kind) (local.get $angle))))))))
  ;; The smaller/larger ratio cannot overflow. A rational complex is divided
  ;; exactly; a float complex needs no temporary guest numbers for the ratio.
  #@(local.set $ratio (if (result f64) (i32.ge_u (call $tag (local.get $a)) (i32.const 3))
    (then (f64.div (struct.get $obj $f (local.get $b)) (struct.get $obj $f (local.get $a))))
    (else (call $coerce-float (call $real-op (i32.const 3) (local.get $b) (local.get $a)) (i32.const 4)))))
  #@(local.set $magnitude (f64.add (call $positive-real-log (local.get $a))
    (f64.mul (f64.const 0.5) (call $log1p-f64 (f64.mul (local.get $ratio) (local.get $ratio))))))
  #@(call $complex (call $float (local.get $kind) (local.get $magnitude))
    (call $float (local.get $kind) (local.get $angle))))

(define-runtime-function $log-native (($number :nullable-object) ($base :nullable-object) ($supplied i32)) (:object)
  (:locals ($z :object) ($b :object) ($kind i32))
  #@(local.set $z (call $number (local.get $number)))
  #@(local.set $b (local.get $z))
  #@(local.set $kind (call $transcendental-kind (local.get $z)))
  #@(if (local.get $supplied)
    (then (local.set $b (call $number (local.get $base)))
      (if (i32.eq (call $transcendental-kind (local.get $b)) (i32.const 4))
        (then (local.set $kind (i32.const 4))))
      (if (call $zero (local.get $b)) (then (return (call $float (local.get $kind) (f64.const 0)))))))
  #@(local.set $z (call $natural-log (local.get $z) (local.get $kind)))
  #@(if (result (ref $obj)) (local.get $supplied)
    (then (call $op (i32.const 3) (local.get $z) (call $natural-log (local.get $b) (local.get $kind))))
    (else (local.get $z))))

(define-runtime-function $log-hypot-f64 (($x f64) ($y f64)) (f64)
  (:locals ($scale f64) ($ratio f64))
  #@(local.set $x (f64.abs (local.get $x)))
  #@(local.set $y (f64.abs (local.get $y)))
  #@(local.set $scale (f64.max (local.get $x) (local.get $y)))
  (wat-fail-when #@(f64.eq (local.get $scale) (f64.const 0)) :division-by-zero)
  #@(local.set $ratio (f64.div (f64.min (local.get $x) (local.get $y)) (local.get $scale)))
  #@(f64.add (call $log-f64 (local.get $scale))
    (f64.mul (f64.const 0.5) (call $log1p-f64 (f64.mul (local.get $ratio) (local.get $ratio))))))

(define-runtime-function $atan-complex-f64 (($x f64) ($y f64) ($delta f64)) (f64 f64)
  (:locals ($a f64) ($scale f64) ($xs f64) ($ys f64) ($ds f64)
           ($den f64) ($num f64) ($real f64) ($imag f64))
  ;; DELTA is |y|-1. An exact rational caller subtracts before conversion,
  ;; retaining offsets from the poles that would round away in y itself.
  #@(local.set $a (f64.abs (local.get $y)))
  #@(local.set $scale (f64.max (f64.abs (local.get $x)) (local.get $a)))
  #@(if (f64.gt (local.get $scale) (f64.const 2))
    (then
      (local.set $xs (f64.div (local.get $x) (local.get $scale)))
      (local.set $ys (f64.div (local.get $a) (local.get $scale)))
      (local.set $ds (f64.div (local.get $delta) (local.get $scale)))
      (local.set $den (f64.div (f64.const 1) (local.get $scale)))
      (local.set $den (f64.sub (f64.sub (f64.mul (local.get $den) (local.get $den))
        (f64.mul (local.get $xs) (local.get $xs))) (f64.mul (local.get $ys) (local.get $ys))))
      (local.set $num (f64.div (f64.mul (f64.const 2) (local.get $xs)) (local.get $scale)))
      (local.set $real (f64.mul (f64.const 0.5) (call $atan2-f64 (local.get $num) (local.get $den))))
      (local.set $den (f64.add (f64.mul (local.get $xs) (local.get $xs))
        (f64.mul (local.get $ds) (local.get $ds))))
      (local.set $num (f64.div (f64.mul (f64.const 4) (local.get $ys)) (local.get $scale)))
      (local.set $imag (f64.mul (f64.const 0.25) (call $log1p-f64 (f64.div (local.get $num) (local.get $den))))))
    (else
      (local.set $den (f64.sub (f64.neg (f64.mul (local.get $delta) (f64.add (local.get $a) (f64.const 1))))
        (f64.mul (local.get $x) (local.get $x))))
      (local.set $real (f64.mul (f64.const 0.5)
        (call $atan2-f64 (f64.mul (f64.const 2) (local.get $x)) (local.get $den))))
      (local.set $den (f64.add (f64.mul (local.get $x) (local.get $x))
        (f64.mul (local.get $delta) (local.get $delta))))
      (if (f64.gt (local.get $den) (f64.const 1e-150))
        (then (local.set $imag (f64.mul (f64.const 0.25)
          (call $log1p-f64 (f64.div (f64.mul (f64.const 4) (local.get $a)) (local.get $den))))))
        (else (local.set $imag (f64.mul (f64.const 0.5)
          (f64.sub (call $log-hypot-f64 (local.get $x) (f64.add (local.get $a) (f64.const 1)))
            (call $log-hypot-f64 (local.get $x) (local.get $delta)))))))))
  #@(local.get $real)
  #@(f64.copysign (local.get $imag) (local.get $y)))

(define-runtime-function $wide-rational-p (($x :object)) (i32)
  #@(i32.and (i32.eqz (call $zero (local.get $x)))
    (i32.gt_u (i32.add (i32.sub (call $bitlength (call $numerator (local.get $x)))
      (call $bitlength (call $denominator (local.get $x)))) (i32.const 1020)) (i32.const 2040))))

(define-runtime-function $atan-rational-log (($x :object) ($y :object) ($kind i32)) (:object)
  (:locals ($plus :object) ($minus :object) ($one :object) ($real f64) ($imag f64))
  ;; Extreme exact inputs use the logarithmic identity without first rounding
  ;; either 1-y or 1+y. Ordinary inputs use the allocation-free float kernel.
  #@(local.set $one (call $int (i32.const 1)))
  #@(local.set $plus (call $natural-log (call $complex
