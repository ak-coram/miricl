;;;; Optional JavaScript host bridge. The standalone image has no JS imports.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $javascript-library-call (($op i32) ($args :nullable-object)) (:nullable-object)
  (:locals ($a :nullable-object) ($b :nullable-object) ($c :nullable-object))
  #@(call $check-apply-list (local.get $args))
  #@(local.set $a (call $car (local.get $args)))
  #@(local.set $b (call $car (call $cdr (local.get $args))))
  (apply #'runtime-wat-sequence
    (loop for (name primitive operation minimum maximum) in *native-javascript-functions* collect
      #@(if (i32.eq (local.get $op) (i32.const ,(clos-primitive-op primitive)))
        (then ,(wat-arity minimum (or maximum 2147483647))
          ,@(when (eq name 'miricl-js:callback)
              (list (wat-fragment #@(call $check-type (local.get $a) (call $symbol (i32.const ,(runtime-symbol-id 'function)))))))
          (call $clear-values)
          (return_call $javascript (i32.const ,operation)
            ,(let ((expression (cond ((equal name '(setf miricl-js:property)) #@(local.get $b))
                   ((eq name 'miricl-js:array) #@(local.get $args))
                   (t #@(local.get $a)))))
               (if (stringp expression) (wat-fragment expression) expression))
            ,(let ((expression (cond ((eq name 'miricl-js:call) (clos-library-reference 'miricl-js::%undefined))
                   ((equal name '(setf miricl-js:property)) #@(call $car (call $cdr (call $cdr (local.get $args)))))
                   ((member name '(miricl-js:property miricl-js:call-with-this miricl-js:invoke miricl-js:strict-equal)) #@(local.get $b))
                   (t #@(ref.null eq)))))
               (if (stringp expression) (wat-fragment expression) expression))
            ,(wat-fragment (cond ((member name '(miricl-js:call miricl-js:new)) #@(call $cdr (local.get $args)))
                   ((member name '(miricl-js:call-with-this miricl-js:invoke)) #@(call $cdr (call $cdr (local.get $args))))
                   ((equal name '(setf miricl-js:property)) #@(local.get $a))
                   (t #@(ref.null eq)))))))))
  (wat-fail :undefined-function)
  #@(ref.null eq))

(define-runtime-function $javascript-wrap (($value externref)) (:object)
  (:export-raw "javascript-wrap")
  #@(struct.new $javascript-value (call $allocate-object-tag (i32.const 47))
    (i32.const 0) (f64.const 0) (ref.null $digits)
    (ref.null eq) (ref.null eq) (ref.null eq) (local.get $value)))

(define-runtime-function $javascript-unwrap (($value :nullable-object)) (externref)
  (:export-raw "javascript-unwrap")
  #@(if (i32.eqz (ref.test (ref $javascript-value) (local.get $value)))
    (then (call $type-fail (local.get $value) ,(clos-library-reference 'miricl-js:value)
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(struct.get $javascript-value $external (ref.cast (ref $javascript-value) (local.get $value))))

(define-runtime-function $javascript
    (($operation i32) ($a :nullable-object) ($b :nullable-object) ($c :nullable-object)) (:nullable-object)
  (:locals ($value externref) ($failed i32))
  #@(if (i32.eqz (local.get $operation))
    (then (return (call $bool (i32.eqz (ref.is_null (table.get $javascript-services (i32.const 0))))))))
  #@(if (i32.eq (local.get $operation) (i32.const 1))
    (then (return (call $bool (ref.test (ref $javascript-value) (local.get $a))))))
  #@(if (ref.is_null (table.get $javascript-services (i32.const 0)))
    (then (return (call $apply ,(clos-library-reference 'miricl-js::%unavailable) (ref.null eq)))))
  #@(call_indirect $javascript-services (type $javascript-service-type) (local.get $operation)
    (extern.convert_any (local.get $a)) (extern.convert_any (local.get $b))
    (extern.convert_any (local.get $c)) (i32.const 0))
  #@(local.set $failed)
  #@(local.set $value)
  #@(if (i32.eq (local.get $failed) (i32.const 1))
    (then (return (call $apply ,(clos-library-reference 'miricl-js::%raise-error)
      (call $cons (call $javascript-wrap (local.get $value)) (ref.null eq))))))
  ;; A successful bridge result is a Lisp value, including NIL, not raw JS.
  #@(call $clear-values)
  #@(if (i32.eq (local.get $failed) (i32.const 2)) (then (global.set $value-count (i32.const 0))))
  #@(ref.cast (ref null eq) (any.convert_extern (local.get $value))))

;; A small reflection ABI keeps traversal and allocation loops in Wasm. Scratch
;; data starts at CURSOR and is consumed before reentry; existing output is safe.
(define-runtime-function $javascript-buffer (($bytes i32)) (i32)
  (:export-raw "javascript-buffer")
  #@(call $reserve (local.get $bytes))
  #@(global.get $cursor))

(define-runtime-function $javascript-info (($operation i32) ($value :nullable-object)) (f64)
  (:export-raw "javascript-info")
  #@(if (i32.eqz (local.get $operation)) (then (return (f64.convert_i32_u (call $tag (local.get $value))))))
  #@(if (i32.eq (local.get $operation) (i32.const 1)) (then (return (call $to-float (call $real (local.get $value))))))
  #@(if (i32.eq (local.get $operation) (i32.const 3)) (then (return (f64.convert_i32_u (call $stringp-native (local.get $value))))))
  #@(f64.convert_i32_s (call $value-n (local.get $value))))

(define-runtime-function $javascript-data (($value :nullable-object)) (i32 i32)
  (:export-raw "javascript-data")
  (:locals ($data (ref null $digits)) ($i i32) ($length i32) ($start i32))
  #@(if (call $stringp-native (local.get $value))
    (then (local.set $value (call $string-contents (local.get $value)))))
  #@(if (i32.eq (call $tag (local.get $value)) (i32.const 1))
    (then (local.set $length (call $integer-length (ref.as_non_null (local.get $value)))))
    (else (local.set $data (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $value)))))
      (local.set $length (array.len (local.get $data)))))
  (wat-fail-when #@(i32.gt_u (local.get $length) (i32.const 1073741823)) :allocation)
  #@(local.set $start (call $javascript-buffer (i32.mul (local.get $length) (i32.const 4))))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $length)))
    (i32.store align=1 (i32.add (local.get $start) (i32.mul (local.get $i) (i32.const 4)))
      (if (result i32) (i32.eq (call $tag (local.get $value)) (i32.const 1))
        (then (call $digit (ref.as_non_null (local.get $value)) (local.get $i)))
        (else (array.get $digits (local.get $data) (local.get $i)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(local.get $start)
  #@(local.get $length))

(define-runtime-function $javascript-make
    (($operation i32) ($sign i32) ($length i32) ($number f64)) (:nullable-object)
  (:export-raw "javascript-make")
  (:locals ($data :digits) ($i i32))
  #@(if (i32.eqz (local.get $operation)) (then (return (call $bool (local.get $sign)))))
  #@(if (i32.eq (local.get $operation) (i32.const 1))
    (then (return (call $float (i32.const 4) (local.get $number)))))
  #@(if (i32.eq (local.get $operation) (i32.const 4))
    (then (return (call $float (i32.const 3) (local.get $number)))))
  #@(local.set $data (array.new_default $digits (local.get $length)))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $length)))
    (array.set $digits (local.get $data) (local.get $i)
      (i32.load align=1 (i32.add (global.get $cursor) (i32.mul (local.get $i) (i32.const 4)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(if (i32.eq (local.get $operation) (i32.const 2)) (then (return (call $text (local.get $data)))))
  #@(call $integer (local.get $sign) (local.get $data)))

(define-runtime-function $javascript-link
    (($operation i32) ($a :nullable-object) ($b :nullable-object)) (:nullable-object)
  (:export-raw "javascript-link")
  (:locals ($extra :nullable-object) ($count i32) ($result :nullable-object))
  #@(if (i32.eqz (local.get $operation)) (then (return (call $car (local.get $a)))))
  #@(if (i32.eq (local.get $operation) (i32.const 1)) (then (return (call $cdr (local.get $a)))))
  #@(if (i32.eq (local.get $operation) (i32.const 2)) (then (return (call $cons (local.get $a) (local.get $b)))))
  #@(if (i32.eq (local.get $operation) (i32.const 4)) (then (return ,(clos-library-reference 'miricl-js::%null))))
  #@(if (i32.eq (local.get $operation) (i32.const 5)) (then (return ,(clos-library-reference 'miricl-js::%undefined))))
  #@(if (i32.eq (local.get $operation) (i32.const 6)) (then (return (call $symbol (i32.const 1)))))
  #@(if (i32.eq (local.get $operation) (i32.const 7)) (then (return (call $symbol-name (local.get $a)))))
  #@(if (i32.eq (local.get $operation) (i32.const 8))
    (then (local.set $result (global.get $standard-output))
      (global.set $standard-output (ref.null eq))
      (if (ref.is_null (local.get $result)) (then (return (ref.null eq))))
      (return (call $report-text (local.get $result)))))
  ;; APPLY restores dynamic scope even when a synchronous JS callback throws
  ;; to a surrounding Lisp target. Preserve the caller's multiple values too.
  #@(local.set $extra (global.get $extra-values))
  #@(local.set $count (global.get $value-count))
  #@(local.set $result (call $apply (local.get $a) (local.get $b)))
  #@(global.set $extra-values (local.get $extra))
  #@(global.set $value-count (local.get $count))
  #@(local.get $result))

(define-runtime-section javascript-runtime-wat ()
  #@(type $javascript-value (sub final $obj (struct
    (field $tag i32) (field $n (mut i32)) (field $f f64)
    (field $digits (ref null $digits))
    (field $a (mut (ref null eq))) (field $b (mut (ref null eq)))
    (field $c (mut (ref null eq))) (field $external externref))))
  #@(type $javascript-service-type (func (param i32 externref externref externref) (result externref i32)))
  #@(table $javascript-services (export "javascript-services") 1 1 funcref)
  ;; Host VM termination can skip JavaScript finally blocks. UNWIND resets
  ;; this counter along with guest dynamic state, allowing safe reuse.
  #@(global $javascript-depth (export "javascript-depth") (mut i32) (i32.const 0))
  ($javascript-wrap) ($javascript-unwrap) ($javascript) ($javascript-library-call)
  ($javascript-buffer) ($javascript-info) ($javascript-data) ($javascript-make) ($javascript-link))
