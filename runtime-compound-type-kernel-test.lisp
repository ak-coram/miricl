;;;; Shared boolean controls, literal identity, callbacks and mutation boundaries.
(in-package #:miricl-test)
(in-suite :miricl)

(defvar *compound-type-calls* nil)
(defvar *compound-type-control* nil)
(defvar *compound-type-cursor* nil)
(defun compound-type-yes (object)
  (push object *compound-type-calls*) (values :true :discard))
(defun compound-type-no (object)
  (push object *compound-type-calls*) (values nil :discard))
(defun compound-type-zero (object)
  (declare (ignore object)) (values))
(defun compound-type-change-tail (object)
  (declare (ignore object))
  (setf (cdr *compound-type-cursor*) (list 'nil)) t)
(defun compound-type-cycle-root (object)
  (declare (ignore object))
  (setf (cdr *compound-type-control*) *compound-type-control*) t)
(defun compound-type-cycle-detached (object)
  (declare (ignore object))
  (setf (cdr *compound-type-control*) nil
        (cdr *compound-type-cursor*) *compound-type-cursor*) t)

(defun compound-type-test-value (object type)
  (if (member (if (consp type) (car type) type) '(and or not member eql satisfies))
      (miricl-runtime:compound-typep-value object type #'compound-type-test-metadata)
      (progn (miricl-runtime:check-type-control-value type #'compound-type-test-metadata)
             (if (typep object type) t nil))))
(defun compound-type-test-metadata (selector object argument)
  (case selector
    (0 (compound-type-test-value object argument))
    (1 (eql object argument))
    (2 (funcall (fdefinition argument) object))
    (3 (list-length object))
    (4 (error 'simple-type-error :datum object :expected-type nil
              :format-control "Malformed type control (reason ~D)." :format-arguments (list argument)))
    (5 (miricl-runtime:check-type-control-value object #'compound-type-test-metadata))))

(test compound-type-port-boolean-values
  (dolist (case '((3 (and) t) (3 (or) nil) (3 (member) nil)
                  (3 (and integer (not string)) t) (3 (or string (eql 3)) t)
                  (3 (and integer (eql 4)) nil) (3 (not integer) nil)
                  (3 (member 1 2 3 4) t) (3 (member 1 2 4) nil)
                  (* (eql *) t) (* (member *) t) (nil (eql nil) t)
                  (3 (eql 3.0) nil) (3.0 (eql 3.0) t) (3.0 (eql 3.0d0) nil)
                  (3/4 (eql 3/4) t) (#\a (member #\b #\a) t)
                  (#c(1 2) (eql #c(1 2)) t)))
    (is (equal (list (third case))
               (multiple-value-list (compound-type-test-value (first case) (second case))))))
  (let ((literal (list :literal)))
    (setf (cdr literal) literal)
    (is (compound-type-test-value literal (list 'eql literal)))
    (is (compound-type-test-value literal (list 'member :other literal)))
    (is (not (compound-type-test-value (list :literal) (list 'eql literal))))))

(test compound-type-port-predicates-and-order
  (let ((*compound-type-calls* nil))
    (is (compound-type-test-value 3 '(and (satisfies compound-type-yes) (satisfies compound-type-yes))))
    (is (equal '(3 3) *compound-type-calls*)))
  (let ((*compound-type-calls* nil))
    (is (not (compound-type-test-value 4 '(and (satisfies compound-type-no) (satisfies compound-type-yes)))))
    (is (equal '(4) *compound-type-calls*)))
  (let ((*compound-type-calls* nil))
    (is (compound-type-test-value 5 '(or (satisfies compound-type-yes) (satisfies compound-type-no))))
    (is (equal '(5) *compound-type-calls*)))
  (is (equal '(t) (multiple-value-list (compound-type-test-value 1 '(satisfies compound-type-yes)))))
  (is (equal '(nil) (multiple-value-list (compound-type-test-value 1 '(satisfies compound-type-no)))))
  (is (equal '(nil) (multiple-value-list (compound-type-test-value 1 '(satisfies compound-type-zero)))))
  (let ((original (fdefinition 'compound-type-yes)))
    (unwind-protect
        (progn (setf (fdefinition 'compound-type-yes) #'compound-type-no)
               (is (not (compound-type-test-value 1 '(satisfies compound-type-yes)))))
      (setf (fdefinition 'compound-type-yes) original))))

(test compound-type-port-mutable-controls
  (let* ((*compound-type-control* (list 'and '(satisfies compound-type-change-tail) 't))
         (*compound-type-cursor* (cdr *compound-type-control*)))
    (is (not (compound-type-test-value 3 *compound-type-control*))))
  (dolist (predicate '(compound-type-cycle-root compound-type-cycle-detached))
    (let* ((*compound-type-control* (list 'and (list 'satisfies predicate) 'integer))
           (*compound-type-cursor* (cdr *compound-type-control*)))
      (signals error (compound-type-test-value 3 *compound-type-control*))
      (is (compound-type-test-value 3 '(and integer (not string)))))))

(test compound-type-port-malformed-and-recovery
  (dolist (type '(and or not member eql satisfies (not) (not integer string)
                  (eql) (eql 1 2) (satisfies) (satisfies 3) (satisfies (lambda (x) x))
                  (member . 3) (and integer . 3) (or integer . 3)))
    (signals error (compound-type-test-value 3 type))
    (is (compound-type-test-value 3 '(or (eql 3) string))))
  (dolist (name '(and or not))
    (let ((type (list name nil)))
      (setf (second type) type)
      (signals simple-type-error (compound-type-test-value 3 type))))
  (let ((type (list 'member 3)))
    (setf (cddr type) (cdr type))
    (signals simple-type-error (compound-type-test-value 3 type)))
  (is (compound-type-test-value 3 '(and (eql 3)))))

(defun compound-type-test-boundary-wat ()
  (miricl::wat-fragment
    (format nil
      "(func (export ~S) (param $mode i32) (result i32)
        (local $completed i32) (local $ok i32) (local $args (ref null eq))
        (block $failed (try_table (catch $transfer $failed)
          (if (i32.eqz (local.get $mode))
            (then (drop (call $compound-type-metadata-value (call $int (i32.const 6)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 1))
            (then (drop (call $compound-type-metadata-value (call $int64 (i64.const 4294967296)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 2))
            (then (drop (call $compound-type-metadata-value (call $int (i32.const 2)) (ref.null eq) (call $int (i32.const 3))))))
          (if (i32.eq (local.get $mode) (i32.const 3))
            (then (drop (call $compound-type-metadata-primitive (i32.const 0) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 4))
            (then (local.set $args (call $cons (ref.null eq) (ref.null eq)))
              (struct.set $obj $b (ref.cast (ref $obj) (local.get $args)) (local.get $args))
              (drop (call $compound-type-metadata-primitive (i32.const 0) (local.get $args)))))
          (local.set $completed (i32.const 1))))
        (local.set $ok (i32.and (i32.eqz (local.get $completed)) (i32.eqz (ref.is_null (global.get $last-condition)))))
        (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
        (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
        (call $clear-values) (local.get $ok))
      (func (export ~S) (param $bad i32) (result i32)
        (local $packet (ref null eq)) (local $completed i32) (local $ok i32)
        (local.set $packet (call $cons (call $int (i32.const 42)) (ref.null eq)))
        (global.set $extra-values (local.get $packet)) (global.set $value-count (i32.const 3))
        (block $failed (try_table (catch $transfer $failed)
          (if (local.get $bad)
            (then (drop (call $compound-typep-worker (call $int (i32.const 3))
              (call $cons (call $symbol (i32.const ~D)) (ref.null eq)))))
            (else (drop (call $compound-typep-worker (call $int (i32.const 3))
              (call $cons (call $symbol (i32.const ~D))
                (call $cons (call $symbol (i32.const ~D)) (ref.null eq)))))))
          (local.set $completed (i32.const 1))))
        (local.set $ok (i32.and
          (i32.and (ref.eq (global.get $extra-values) (local.get $packet)) (i32.eq (global.get $value-count) (i32.const 3)))
          (i32.eq (local.get $completed) (i32.eqz (local.get $bad)))))
        (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
        (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
        (call $clear-values) (local.get $ok))"
      "compound-type-checked-service" "compound-type-value-packets"
      (miricl::runtime-symbol-id 'not) (miricl::runtime-symbol-id 'satisfies)
      (miricl::runtime-symbol-id 'integerp))))

(test compound-type-port-raw-value-packets
  (let ((original (fdefinition 'miricl::type-runtime-wat)))
    (unwind-protect
        (progn
          (setf (fdefinition 'miricl::type-runtime-wat)
            (lambda () (miricl::runtime-wat-sequence (funcall original) (compound-type-test-boundary-wat))))
          (let* ((miricl::*interpreter-only-wasm* nil)
                 (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
            (m:with-interpreter (vm)
              (dolist (mode '(0 1))
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "compound-type-value-packets" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)"))))
              (dolist (mode '(0 1 2 3 4))
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "compound-type-checked-service" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)")))))))
      (setf (fdefinition 'miricl::type-runtime-wat) original))))
