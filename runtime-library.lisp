;;;; Build-time lowering of private Lisp libraries into guest object literals.
(in-package #:miricl)

(defparameter *shared-loop-symbols*
  '(%%while %%arithmetic-step %%case-form %%list-test %%list-accumulate
    %%numeric-collect %%parallel-place-form))

;; Libraries execute in the guest evaluator. No host macroexpansion or reader
;; is needed at runtime, and their uninterned symbols cannot capture user names.
(defun lower-runtime-library (form)
  (if (atom form) form
      (let ((expanded
              ;; Resolve private record/index macros before packing sources.
              ;; Interpreted bootstrap functions then execute direct accesses
              ;; without expanding an accessor macro on every field read.
              (if (and (symbolp (car form)) (get (car form) 'runtime-inline-macro)
                       (macro-function (car form)))
                  (macroexpand-1 form)
                  (case (car form)
                (quote (return-from lower-runtime-library form))
                (cond (if (cdr form)
                          `(if ,(caadr form) (progn ,@(cdadr form))
                               (cond ,@(cddr form))) nil))
                (when `(if ,(second form) (progn ,@(cddr form))))
                (unless `(if ,(second form) nil (progn ,@(cddr form))))
                (null `(not ,(second form)))
                (push (if (symbolp (third form))
                          `(setq ,(third form) (cons ,(second form) ,(third form)))
                          form))
                (pop `(let ((%popped (car ,(second form))))
                        (setq ,(second form) (cdr ,(second form))) %popped))
                (incf (if (symbolp (second form))
                          `(setq ,(second form) (+ ,(second form) ,(or (third form) 1))) form))
                (decf (if (symbolp (second form))
                          `(setq ,(second form) (- ,(second form) ,(or (third form) 1))) form))
                (cadr `(car (cdr ,(second form))))
                (cddr `(cdr (cdr ,(second form))))
                (caddr `(car (cdr (cdr ,(second form)))))
                (otherwise form)))))
        (if (eq expanded form) (mapcar #'lower-runtime-library form)
            (lower-runtime-library expanded)))))

(defun runtime-library-symbols (forms)
  (let ((symbols nil))
    (labels ((walk (x)
               (cond ((consp x)
                      (loop while (consp x) do (walk (car x)) (setf x (cdr x)))
                      (walk x))
                     ((and (symbolp x) (not (member x *runtime-symbols*)))
                      (pushnew x symbols)))))
      (mapc #'walk forms))
    (nreverse symbols)))

(defun runtime-library-structure-symbols (forms)
  ;; Accessors first referenced by another tooling source still need their
  ;; bootstrap identities installed before DEFSTRUCT interns their names.
  (loop for form in forms when (and (consp form)
                                  (member (car form) '(defstruct miricl-compiler::define-hir-record))
                                  (symbolp (second form))) append
    (let* ((name (second form)) (package (symbol-package name)) (text (symbol-name name)))
      (append (loop for suffix in '("-P" "") for prefix in '("" "COPY-")
                collect (intern (concatenate 'string prefix text suffix) package))
        (list (intern (concatenate 'string "MAKE-" text) package))
        (when (eq (car form) 'miricl-compiler::define-hir-record)
          (list (intern (concatenate 'string "%" text "-P") package)))
        (loop for slot in (cddr form) for slot-name = (if (consp slot) (car slot) slot)
              collect (intern (concatenate 'string text "-" (symbol-name slot-name)) package))))))

(defparameter *runtime-library-prefixes*
  ;; Spare tags stand for a proper list's length and first symbol.
  ;; These common syntax shapes save a tag plus a symbol payload, without
  ;; sharing any reconstructed conses or changing public symbol identities.
  '((2 quote 2) (5 if 4) (8 car 2) (9 progn 2) (11 setq 3)
    (12 cdr 2) (13 cons 3) (14 list 3) (15 defun 4) (17 eq 3)
    (18 if 3) (19 list 4) (20 let 4) (21 and 3) (22 let 3)
    (23 error 2) (26 not 2) (27 or 3) (28 list 2) (29 gensym 1)
    (30 defparameter 3) (31 progn 3)
    ;; Only the common 1..32 element lists need dedicated length tags.
    (64 name 2 :clos) (65 dolist 3) (66 declare 2) (67 nreverse 2)
    (68 or 4) (69 %accept 2 :loop) (70 write-string 3) (71 aref 3)
    (72 get-setf-expansion 3) (73 pathname 2) (74 caar 2) (75 %peek 2 :loop)
    (76 %take 1 :loop) (77 slot-definition-name 2) (78 fourth 2)
    (79 %pathname-case 3 :clos) (80 first 2) (81 and 4) (82 typep 3)
    (83 defvar 3) (84 list* 4) (85 %bind 3 :loop) (86 get 3)
    (87 = 3) (88 %classp 2 :clos) (89 lambda 3) (90 values 3)
    (91 %nth 3 :clos) (92 %compile-form 3 :clos) (93 %%while 4 :loop)
    (94 1+ 2) (95 class-name 2)
    ;; Long proper lists use a counted spine, freeing another prefix bank.
    (96 append 3) (97 setf 3) (98 consp 2) (99 reverse 2)
    (100 find-class 2) (101 defconstant 3) (102 length 2) (103 error 6)
    (104 member 3) (105 macro-function 2) (106 return-from 3) (107 char 3)
    (108 stringp 2) (109 defmacro 4) (110 function 2) (111 fdefinition 2)
    (112 symbolp 2) (113 class-of 2) (114 third 2) (115 ignore 2)
    (116 second 2) (117 %map 3 :clos) (118 %cell 3 :clos) (119 list 5)
    (120 defun 5) (121 %word 3 :loop) (122 %quote 2 :clos) (123 %member 3 :clos)
    (124 %%while 3 :loop) (125 %get 3 :clos) (126 %popped 2 :clos) (127 fifth 2)))

(defun runtime-library-prefix-value (entry)
  (if (null entry) 0
    (destructuring-bind (tag symbol length &optional namespace) entry
      (declare (ignore tag))
      (let* ((table (case namespace
                      (:clos (symbol-value '*clos-library-symbols*))
                      (:loop (symbol-value '*loop-library-symbols*))
                      (otherwise *runtime-symbols*)))
             (index (or (position symbol table) (error "Unknown prefix symbol ~S" symbol))))
        (logior (case namespace (:clos #x40000000) (:loop #x80000000) (otherwise 0))
          (ash index 3) length)))))

(defun runtime-library-prefix-namespace-p (entry symbols private-tag loop-symbols)
  (case (fourth entry)
    (:clos (and (= private-tag 24) (boundp '*clos-library-symbols*)
                (eq symbols (symbol-value '*clos-library-symbols*))))
    (:loop (and (boundp '*loop-library-symbols*)
                (or (and (= private-tag 25) (eq symbols (symbol-value '*loop-library-symbols*)))
                    (and (= private-tag 24) (member (second entry) *shared-loop-symbols*)
                         (eq loop-symbols (symbol-value '*loop-library-symbols*))))))
    (otherwise t)))

(defvar *runtime-library-symbol-codes* nil)

(defun runtime-library-symbol-codes (libraries)
  "Choose one-byte symbol references by the number of payload bytes saved.
Entries retain symbol and namespace identities, rather than table offsets."
  (let ((counts (make-hash-table :test 'equal)) (order nil))
    (dolist (library libraries)
      (destructuring-bind (forms symbols private-tag &optional loop-symbols) library
        (labels ((walk (form)
                   (cond
                     ((consp form)
                      (let ((length 0) (tail form))
                        (loop while (consp tail) do (incf length) (setf tail (cdr tail)))
                        (when (and (null tail)
                                   (find-if (lambda (entry)
                                     (and (eq (car form) (second entry)) (= length (third entry))
                                          (runtime-library-prefix-namespace-p entry symbols private-tag loop-symbols)))
                                     *runtime-library-prefixes*))
                          (setf form (cdr form))))
                      (loop while (consp form) do (walk (car form)) (setf form (cdr form)))
                      (walk form))
                     ((and form (symbolp form))
                      (let* ((id (position form *runtime-symbols*))
                             (namespace (unless id (if (or (= private-tag 25)
                                       (member form *shared-loop-symbols*)) :loop :clos)))
                             (entry (list form namespace))
                             (index (or id (position form (if (eq namespace :loop)
                                                            (symbol-value '*loop-library-symbols*) symbols)))))
                        (unless (gethash entry counts) (push entry order))
                        (incf (gethash entry counts 0) (if (< index 128) 1 2)))))))
          (mapc #'walk forms))))
    ;; Retain the existing namespace/index order inside the selected bank.
    (let ((selected (subseq (stable-sort (nreverse order) #'> :key (lambda (entry) (gethash entry counts)))
                           0 (min 128 (hash-table-count counts)))))
      (stable-sort (mapcar (lambda (entry) (list (first entry) 0 (second entry))) selected)
        #'< :key (lambda (entry) (runtime-library-prefix-value (cons 0 entry)))))))

(defun runtime-library-bytes (forms symbols private-tag &optional loop-symbols)
  "Pack library literals using byte tags, LEB128 payloads, and ZigZag integers.
Tags 32..63 encode proper lists of 1..32 elements; 128..255 encode common
symbols from the public and private tables. Tag 7 carries a counted spine and a dotted-tail flag.
Other tags abbreviate the proper list prefixes in *RUNTIME-LIBRARY-PREFIXES*."
  (let ((bytes (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (labels ((emit-byte (n) (vector-push-extend n bytes))
             (u32 (n) (dotimes (i 4) (emit-byte (ldb (byte 8 (* 8 i)) n))))
             (uleb (n)
               (assert (typep n '(unsigned-byte 32)))
               (loop do (emit-byte (logior (logand n 127) (if (>= n 128) 128 0)))
                        (setf n (ash n -7)) while (plusp n)))
             (emit (form)
               (cond ((null form) (emit-byte 0))
                     ((consp form)
                      (let ((length 0) (tail form))
                        (loop while (consp tail) do (incf length) (setf tail (cdr tail)))
                        (let ((prefix (and (null tail)
                                       (find-if (lambda (entry)
                                                  (and (eq (car form) (second entry))
                                                       (= length (third entry))
                                                       (runtime-library-prefix-namespace-p entry symbols private-tag loop-symbols)))
                                                *runtime-library-prefixes*))))
                          (cond (prefix (emit-byte (first prefix)) (setf form (cdr form)))
                                ((and (null tail) (<= length 32)) (emit-byte (+ 31 length)))
                                (t (emit-byte 7) (uleb (+ (* 2 length) (if tail 1 0))))))
                        (loop while (consp form) do (emit (car form)) (setf form (cdr form)))
                        (when tail (emit tail))))
                     ((symbolp form)
                      (let* ((id (position form *runtime-symbols*))
                             (compact (position-if (lambda (entry)
                               (and (eq form (first entry))
                                 (runtime-library-prefix-namespace-p (cons 0 entry) symbols private-tag loop-symbols)))
                               *runtime-library-symbol-codes*)))
                        (if compact (emit-byte (+ 128 compact))
                            (let ((cross (and (= private-tag 24) (member form *shared-loop-symbols*))))
                              (emit-byte (if id 6 (if cross 25 private-tag)))
                              (uleb (or id (position form (if cross loop-symbols symbols))
                                        (error "Unknown library symbol ~S" form)))))))
                     ((integerp form)
                      (assert (typep form '(signed-byte 32)))
                      (emit-byte 1) (uleb (logxor (ash form 1) (ash form -31))))
                     ((floatp form)
                      (emit-byte (if (typep form 'double-float) 4 3))
                      (cffi:with-foreign-object (value :double)
                        (setf (cffi:mem-ref value :double) (float form 1.0d0))
                        (let ((bits (cffi:mem-ref value :uint64)))
                          (u32 (ldb (byte 32 0) bits)) (u32 (ldb (byte 32 32) bits)))))
                     ((characterp form) (emit-byte 16) (uleb (char-code form)))
                     ((stringp form) (emit-byte 10) (uleb (length form))
                      (loop for char across form do (uleb (char-code char))))
                     (t (error "Unsupported library literal ~S" form)))))
      (mapc #'emit forms)) bytes))

(defun runtime-library-data (bytes)
  (wat-fragment (with-output-to-string (out)
    (write-char #\" out)
    (loop for byte across bytes do (format out "\\~2,'0X" byte))
    (write-char #\" out))))
