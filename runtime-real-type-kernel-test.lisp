;;;; Exact real interval regression coverage and host-only IEEE service adapter.
(in-package #:miricl-test)
(in-suite :miricl)

(defun real-type-test-adjacent (value up)
  ;; Host-only oracle from the CL numeric protocol, independent of target bits.
  ;; Keep it portable across the bootstrap hosts, including subnormal values.
  (let* ((single (typep value 'single-float))
         (maximum (if single most-positive-single-float most-positive-double-float))
         (least (if single least-positive-single-float least-positive-double-float))
         (normal (if single least-positive-normalized-single-float least-positive-normalized-double-float)))
    (cond ((zerop value) (if up least (- least)))
          ((and up (= value maximum)) 1)
          ((and (not up) (= value (- maximum))) -1)
          (t (multiple-value-bind (significand exponent sign) (integer-decode-float value)
               (declare (ignore sign))
               (let ((step (max (expt 2 exponent) (rational least))))
                 (when (and (if up (minusp value) (plusp value))
                            (= significand (ash 1 (1- (float-digits value))))
                            (> (abs value) normal))
                   (setf step (/ step 2)))
                 (float (+ (rational value) (if up step (- step))) value)))))))

(defun real-type-test-metadata (selector object argument)
  (case selector
    (0 (if (and (simple-vector-p object) (= (length object) 2) (eq (svref object 0) :class))
           (cons (svref object 1) t)))
    (1 (real-type-test-adjacent object argument))
    (2 (if (eq argument 'fixnum)
           (and (integerp object) (<= -9223372036854775808 object 9223372036854775807))
           (typep object argument)))
    (3 (list-length object))
    (4 (error 'simple-type-error :datum object :expected-type nil
              :format-control "Malformed real interval control (reason ~D)." :format-arguments (list argument)))
    (5 (if (= object 3) most-positive-single-float most-positive-double-float))))

(defun real-type-test-query (a b)
  (miricl-runtime:check-type-control-value a #'real-type-test-metadata)
  (miricl-runtime:check-type-control-value b #'real-type-test-metadata)
  (miricl-runtime:real-subtype-query-value a b #'real-type-test-metadata))

(test real-type-port-intervals
  (dolist (case '((rational nil #(nil nil 0 1)) (real nil #(nil nil 0 7))
                  (float nil #(nil nil 0 6)) (short-float nil #(nil nil 0 2))
                  (long-float nil #(nil nil 0 4)) (nil nil #(nil nil 0 8))
                  (integer nil #(nil nil 0 0)) (integer t #(nil nil 0 16))
                  (ratio t #(nil nil 0 32)) (complex t #(nil nil 0 8))
                  (number t #(nil nil 0 7)) ((rational (1/2) 2) nil #(1/2 2 1 1))
                  ((real * (0)) nil #(nil 0 2 7)) ((float 0 *) nil #(0 nil 0 6))))
    (is (equalp (third case) (miricl-runtime:real-type-interval-value (first case) (second case) #'real-type-test-metadata))))
  (is (equalp #(nil nil 0 4) (miricl-runtime:real-type-interval-value (vector :class 'double-float) nil #'real-type-test-metadata))))

(test real-type-port-proofs
  (dolist (case '(((rational 0 1) (real -1 2) 1) ((rational 0 1) (rational (0) 1) 2)
                  ((rational (0) 1) (rational 0 1) 1) ((rational (0) (1)) ratio 1)
                  ((rational 0 (1)) ratio 2) ((rational (0) 1) ratio 2)
                  ((rational 1 1) integer 1) ((rational 1/2 1/2) integer 2)
                  ((rational 1 1) (mod 2) 1) ((rational 2 2) (mod 2) 2)
                  ((rational 9223372036854775807 9223372036854775807) fixnum 1)
                  ((rational (0) 0) nil 1) ((real 2 1) nil 1)
                  ((real (0) (1)) rational 2) ((single-float 0 1) float 1)
                  (float single-float 2) (short-float single-float 1)
                  (long-float double-float 1) ((single-float 1 1) double-float 2)
                  ((single-float 1 1) (single-float (1) 2) 2)
                  ((single-float (1) 2) (single-float 1 2) 1)
                  ((single-float 0 0) (single-float -0.0 -0.0) 1)
                  ((single-float (0) (0)) nil 1)
                  ((double-float (0) (0)) nil 1)
                  ((rational 0 0) complex 2) ((opaque) real 0)))
    (is (= (third case) (real-type-test-query (first case) (second case)))))
  ;; Exact comparisons must not round an integer or ratio to the float format.
  (is (= 2 (real-type-test-query '(rational 16777217 16777217) '(real * 16777216.0))))
  (is (= 1 (real-type-test-query '(single-float 16777217 16777218) '(single-float 16777218 16777218))))
  (is (= 1 (real-type-test-query '(single-float 1/3 1/3) nil)))
  (is (= 1 (real-type-test-query '(double-float 1/3 1/3) nil)))
  (is (= 1 (real-type-test-query (list 'single-float (1+ (ash 1 1024)) '*) nil))))

(test real-type-port-float-rounding
  (dolist (kind '(3 4))
    (let* ((prototype (if (= kind 3) 1.0 1.0d0))
           (least (if (= kind 3) least-positive-single-float least-positive-double-float)))
      (is (= least (miricl-runtime:float-interval-bound-value 0 (vector t kind t) #'real-type-test-metadata)))
      (is (= (- least) (miricl-runtime:float-interval-bound-value -0.0d0 (vector t kind nil) #'real-type-test-metadata)))
      (dolist (bound '(1/3 -1/3 16777217 9007199254740993))
        (dolist (exclusive '(nil t))
          (let ((low (miricl-runtime:float-interval-bound-value bound (vector exclusive kind t) #'real-type-test-metadata))
                (high (miricl-runtime:float-interval-bound-value bound (vector exclusive kind nil) #'real-type-test-metadata)))
            (is (if exclusive (> low bound) (>= low bound)))
            (is (if exclusive (< high bound) (<= high bound)))
            (is (= prototype (float 1 low)))
            (is (if exclusive (<= (real-type-test-adjacent low nil) bound) (< (real-type-test-adjacent low nil) bound)))
            (is (if exclusive (>= (real-type-test-adjacent high t) bound) (> (real-type-test-adjacent high t) bound)))))))))

(test real-type-port-malformed-and-recovery
  (dolist (form '((real 1 2 3) (rational (1 2) 3) (float () 1) (single-float bad *)
                  (double-float ((1)) 2) (real (1 . 2) *)))
    (signals error (real-type-test-query form 'real)))
  (let ((bound (list 1)))
    (setf (cdr bound) bound)
    (signals simple-type-error (real-type-test-query (list 'real bound '*) 'real)))
  (let ((form (list 'and 'real)))
    (setf (cdr (cdr form)) (cdr form))
    (signals simple-type-error (real-type-test-query form 'real)))
  (is (= 1 (real-type-test-query '(real 1 2) 'real))))

(defun real-type-test-boundary-wat ()
  (miricl::wat-fragment
    (format nil
      "(func (export ~S) (param $mode i32) (result i32)
        (local $completed i32) (local $ok i32)
        (block $failed (try_table (catch $transfer $failed)
          (if (i32.eqz (local.get $mode))
            (then (drop (call $real-type-metadata-value (call $int (i32.const 1)) ~A (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 1))
            (then (drop (call $real-type-metadata-value (call $int (i32.const 6)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 2))
            (then (drop (call $real-type-metadata-value (call $int (i32.const 5)) (call $int64 (i64.const 4294967299)) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 3))
            (then (drop (call $real-type-metadata-call (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 4))
            (then (drop (call $real-type-metadata-value (call $int (i32.const 1)) (call $int (i32.const 1)) (ref.null eq)))))
          (local.set $completed (i32.const 1))))
        (local.set $ok (i32.and (i32.eqz (local.get $completed)) (i32.eqz (ref.is_null (global.get $last-condition)))))
        (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
        (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
        (call $clear-values) (local.get $ok))"
      "real-type-checked-service"
      (miricl::wat-string (miricl::wat-new-object (miricl::wat-fragment "(i32.const 3)")
                           :f (miricl::wat-fragment "(f64.const inf)"))))))

(test real-type-port-raw-value-packets
  (let ((original (fdefinition 'miricl::real-type-runtime-wat)))
    (unwind-protect
        (progn
          (setf (fdefinition 'miricl::real-type-runtime-wat)
            (lambda ()
              (miricl::runtime-wat-sequence (funcall original) (real-type-test-boundary-wat)
                (miricl::wat-fragment
                  (format nil
                    "(func (export ~S) (param $bad i32) (result i32)
                      (local $packet (ref null eq)) (local $completed i32) (local $ok i32)
                      (local.set $packet (call $cons (call $int (i32.const 42)) (ref.null eq)))
                      (global.set $extra-values (local.get $packet)) (global.set $value-count (i32.const 3))
                      (block $failed (try_table (catch $transfer $failed)
                        (if (local.get $bad)
                          (then (drop (call $real-type-worker
                            (call $cons (call $symbol (i32.const ~D))
                              (call $cons (call $symbol (i32.const ~D)) (ref.null eq)))
                            (ref.null eq) (i32.const 0))))
                          (else
                            (call $real-type-interval (call $symbol (i32.const ~D)) (i32.const 0)) (drop) (drop) (drop) (drop)
                            (drop (call $float-interval-bound (call $int (i32.const 0)) (i32.const 1) (i32.const 3) (i32.const 1)))
                            (drop (call $real-type-worker (call $symbol (i32.const ~D))
                              (call $symbol (i32.const ~D)) (i32.const 2)))))
                        (local.set $completed (i32.const 1))))
                      (local.set $ok (i32.and
                        (i32.and (ref.eq (global.get $extra-values) (local.get $packet)) (i32.eq (global.get $value-count) (i32.const 3)))
                        (i32.eq (local.get $completed) (i32.eqz (local.get $bad)))))
                      (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
                      (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
                      (call $clear-values) (local.get $ok))"
                    "real-type-value-packets" (miricl::runtime-symbol-id 'real) (miricl::runtime-symbol-id 'symbol)
                    (miricl::runtime-symbol-id 'real) (miricl::runtime-symbol-id 'rational) (miricl::runtime-symbol-id 'real))))))
          (let* ((miricl::*interpreter-only-wasm* nil)
                 (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
            (m:with-interpreter (vm)
              (dolist (mode '(0 1))
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "real-type-value-packets" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)"))))
              (dolist (mode (quote (0 1 2 3 4)))
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "real-type-checked-service" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)")))))))
      (setf (fdefinition 'miricl::real-type-runtime-wat) original))))
