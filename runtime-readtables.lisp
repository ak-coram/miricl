  #@(if (i32.lt_u (local.get $code) (i32.const 128))
    (then (if (i32.eqz (ref.is_null (struct.get $obj $a (ref.cast (ref $obj) (local.get $table)))))
      (then (return (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $table))))) (local.get $code)))))))
  #@(if (i32.and (i32.ge_s (local.get $code) (i32.const 128))
      (i32.eqz (ref.is_null (struct.get $obj $b (ref.cast (ref $obj) (local.get $table))))))
    (then (local.set $cell (call $hash-cell-native (call $int (local.get $code)) (struct.get $obj $b (ref.cast (ref $obj) (local.get $table)))))
      (if (i32.eqz (ref.is_null (local.get $cell)))
        (then (return (call $value-n (struct.get $obj $b (ref.cast (ref $obj) (local.get $cell)))))))))
  #@(call $standard-reader-syntax (local.get $code)))

