        (call $symbol (i32.const ,(runtime-symbol-id 'eql))) (ref.null $obj) (ref.null $obj)))))
      (drop (call $puthash-native (call $int (local.get $code)) (struct.get $obj $b (local.get $table))
        (if (result (ref null $obj)) (ref.is_null (local.get $entry))
          (then (call $node (i32.const 13) (local.get $syntax) (ref.null $obj) (ref.null $obj) (ref.null $obj)))
          (else (local.get $entry))))))))

