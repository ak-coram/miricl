      (then (struct.set $obj $b (ref.cast (ref $obj) (local.get $table)) (call $node (i32.const 29) (i32.const 0)
        (call $symbol (i32.const ,(runtime-symbol-id 'eql))) (ref.null eq) (ref.null eq)))))
      (drop (call $puthash-native (call $int (local.get $code)) (struct.get $obj $b (ref.cast (ref $obj) (local.get $table)))
