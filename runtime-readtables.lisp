  (:locals ($cell :nullable-object))
  #@(if (ref.is_null (local.get $table)) (then (return (call $standard-reader-syntax (local.get $code)))))
  #@(if (i32.lt_u (local.get $code) (i32.const 128))
    (then (if (i32.eqz (ref.is_null (struct.get $obj $a (local.get $table))))
      (then (return (array.get $digits (struct.get $obj $digits (struct.get $obj $a (local.get $table))) (local.get $code)))))))
  #@(if (i32.and (i32.ge_s (local.get $code) (i32.const 128))
      (i32.eqz (ref.is_null (struct.get $obj $b (local.get $table)))))
    (then (local.set $cell (call $hash-cell-native (call $int (local.get $code)) (struct.get $obj $b (local.get $table))))
      (if (i32.eqz (ref.is_null (local.get $cell)))
        (then (return (struct.get $obj $n (struct.get $obj $b (local.get $cell))))))))
  #@(call $standard-reader-syntax (local.get $code)))

(define-runtime-function $reader-syntax (($code i32)) (i32)
  #@(if (result i32) (global.get $reader-standard-syntax)
    (then (call $standard-reader-syntax (local.get $code)))
    (else (call $readtable-syntax (global.get $reader-readtable) (local.get $code)))))

(define-runtime-function $reader-white (($code i32)) (i32)
