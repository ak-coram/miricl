;;;; Target array type/shape algorithms and checked public boundaries.
(in-package #:miricl-test)
(in-suite :miricl)

(defun array-type-test-metadata (selector object environment)
  ;; An explicit target-model callback, never host SUBTYPEP/array upgrading.
  (case selector
    (0 (or (cdr (assoc object environment :test #'equal)) object))
    (1 (cond ((or (null object) (eq object 'extended-char)) 3)
             ((member object '(character base-char standard-char)) 1)
             ((eq object 'bit) 2)
             ((equal object '(integer 0 1)) 2)
             ((equal object '(unsigned-byte 1)) 2)
             (t 0)))
    (2 (cond ((and (vectorp object) (= (length object) 3) (eq (aref object 0) :target-class))
              (cons (aref object 1) (aref object 2)))
             ((member object '(array simple-array vector simple-vector string simple-string
                               base-string simple-base-string bit-vector simple-bit-vector
                               integer symbol character cons function))
              (cons object t))))
    (3 (list-length object))
    (4 (error 'simple-type-error :datum object :expected-type nil
              :format-control "Malformed array type (reason ~D)." :format-arguments (list environment)))))

(defun array-type-test-info (type &optional environment)
  (miricl-runtime:array-type-query-value type nil (vector 0 0 -1 environment) #'array-type-test-metadata))

(test array-type-port-descriptors
  (dolist (case '((array #(15 -1 nil)) ((array) #(15 -1 nil))
                  ((array *) #(15 -1 nil)) ((array t) #(1 -1 nil))
                  ((array bit) #(4 -1 nil)) ((array character) #(2 -1 nil))
                  ((array nil) #(8 -1 nil)) ((array extended-char) #(8 -1 nil))
                  ((array * 0) #(15 0 nil)) ((array * 2) #(15 2 nil))
                  ((array * 256) #(32 -1 nil)) ((array * 100000000000000000000) #(32 -1 nil))
                  ((array t ()) #(1 0 nil)) ((array t (*)) #(1 1 (*)))
                  ((array t (536870910 2)) #(32 2 nil))
                  ((array t (536870910 2 0)) #(1 3 (536870910 2 0)))
                  ((array t (536870910 2 *)) #(1 3 (536870910 2 *)))
                  ((array t (536870911 0)) #(32 -1 nil))
                  (vector #(15 1 nil)) ((vector bit 3) #(4 1 (3)))
                  ((vector (integer 0 1) 3) #(4 1 (3)))
                  (simple-vector #(17 1 nil)) ((simple-vector 0) #(17 1 (0)))
                  (string #(10 1 nil)) (simple-string #(26 1 nil))
                  (base-string #(2 1 nil)) (simple-base-string #(18 1 nil))
                  (bit-vector #(4 1 nil)) (simple-bit-vector #(20 1 nil))
                  ((and) #(64 -1 nil)) ((and t t) #(64 -1 nil))
                  ((and (array bit) (array character)) #(32 -1 nil))
                  ((and (array * 1) (array * 2)) #(32 -1 nil))
                  ((and (array * (* 2)) (simple-array bit (1 *))) #(20 2 (1 2)))
                  ((and (array * (536870910 *)) (array * (* 2))) #(32 2 nil))
                  ((and (array t (536870910 2 *)) (array t (* * 0))) #(1 3 (536870910 2 0)))
                  ((and unknown-array-restriction array) #(0 -1 nil))
                  ((and unknown-array-restriction nil) #(32 -1 nil))))
    (is (equalp (second case) (array-type-test-info (first case)))))
  (let* ((shape (list 1 '*)) (type (list 'array '* shape))
         (descriptor (array-type-test-info type)))
    (is (eq shape (svref descriptor 2)))
    (is (equal '(1 *) shape)))
  (let ((class (vector :target-class 'array t)))
    (is (equalp #(15 -1 nil) (array-type-test-info class))))
  (is (equalp #(4 1 (3)) (array-type-test-info '(array local-bit (3)) '((local-bit . bit))))))

(test array-type-port-subtype-decisions
  (dolist (case '(((array t (3)) (array t (*)) 1)
                  ((array t (*)) (array t (3)) 2)
                  ((array nil (*)) (array nil (0)) 2)
                  ((array nil (1)) nil 2) ((array nil ()) nil 2)
                  ((array * 256) nil 1) (nil unknown-array-type 1)
                  (array atom 1) (t array 2) ((and t t) atom 2)
                  ((array t (*)) sequence 1) ((array t (* *)) sequence 2)
                  ((array t ()) integer 2) (integer array 2)
                  ((array * (1 2)) (and (array * (* 2)) (array * (1 *))) 1)
                  ((and (array * (* 2)) (array * (1 *))) (array * (1 2)) 1)
                  ((array t (*)) (and (array * (*)) (simple-array * (*))) 2)
                  (unknown-array-type array 0) (array (satisfies opaque-predicate) 0)))
    (is (= (third case)
           (miricl-runtime:array-type-query-value (first case) (second case)
             (vector 3 0 -1 nil) #'array-type-test-metadata)))))

(test array-type-port-malformed-and-control-cycles
  (dolist (type '((array t () extra) (simple-vector 1 2) (array t -1)
                  (array t 1/2) (array t (-1)) (array t (nil)) (array t (1 . bad))))
    (signals error (array-type-test-info type)))
  (let* ((spine (list 'array 't)) (last (cdr spine)))
    (setf (cdr last) last)
    (signals error (array-type-test-info spine)))
  (let ((type (list 'and '(array bit) nil)))
    (setf (third type) type)
    (signals simple-type-error (miricl-runtime:check-type-control-value type #'array-type-test-metadata))
    (signals simple-type-error (array-type-test-info type)))
  (let ((dimensions (list 2)))
    (setf (cdr dimensions) dimensions)
    (signals simple-type-error
      (miricl-runtime:check-type-control-value (list 'array 't dimensions) #'array-type-test-metadata)))
  (let ((type (list 'complex nil)))
    (setf (second type) type)
    (let ((condition (handler-case
                       (progn (miricl-runtime:check-type-control-value type #'array-type-test-metadata) nil)
                       (simple-type-error (condition) condition))))
      (is (typep condition 'simple-type-error))
      (when condition (is (eq type (type-error-datum condition))))))
  (let ((datum (list :value)))
    (setf (cdr datum) datum)
    (dolist (type (list (list 'member datum) (list 'eql datum) (list 'opaque-derived-type datum)))
      (is (eq type (miricl-runtime:check-type-control-value type #'array-type-test-metadata)))))
  (let* ((leaf '(array bit (*))) (type (list 'and leaf leaf)))
    (is (eq type (miricl-runtime:check-type-control-value type #'array-type-test-metadata)))
    (is (equalp #(4 1 (*)) (array-type-test-info type))))
  (is (equalp #(4 1 (3)) (array-type-test-info '(vector bit 3)))))

(test array-type-port-raw-packets-and-recovery
  (let ((original (fdefinition 'miricl::array-type-runtime-wat)))
    (unwind-protect
        (progn
          (setf (fdefinition 'miricl::array-type-runtime-wat)
            (lambda ()
              (miricl::runtime-wat-sequence
                (funcall original)
                (miricl::wat-fragment
                  (format nil
                    "(func (export ~S) (param $mode i32) (param $expected i32) (result i32)
                       (local $input (ref null eq)) (local $other (ref null eq)) (local $saved (ref null eq))
                       (local $caught i32)
                       (local.set $input (call $symbol-value (call $intern ~A (global.get $current-package))))
                       (local.set $other (call $symbol-value (call $intern ~A (global.get $current-package))))
                       (global.set $extra-values (call $cons (call $int (i32.const 42)) (ref.null eq)))
                       (global.set $value-count (i32.const 2))
                       (local.set $saved (global.get $extra-values))
                       (block $caught (try_table (catch $transfer $caught)
                         (if (i32.eq (local.get $mode) (i32.const 0))
                           (then (call $array-type-info (local.get $input) (ref.null eq)) (drop) (drop) (drop)))
                         (if (i32.eq (local.get $mode) (i32.const 1))
                           (then (call $array-shape-info (i32.const 15) (i32.const -1) (local.get $input)) (drop) (drop) (drop)))
                         (if (i32.eq (local.get $mode) (i32.const 2))
                           (then (call $array-intersection-info (local.get $input) (ref.null eq)) (drop) (drop) (drop)))
                         (if (i32.eq (local.get $mode) (i32.const 3))
                           (then (drop (call $array-subtypep (local.get $input) (local.get $other) (ref.null eq)))))
                         (if (i32.eq (local.get $mode) (i32.const 4))
                           (then (call $check-type-control-structure (local.get $input))))
                         (if (i32.eq (local.get $mode) (i32.const 5))
                           (then (call $array-shape-info (i32.const -1) (i32.const -1) (ref.null eq)) (drop) (drop) (drop)))
                         (if (i32.eq (local.get $mode) (i32.const 6))
                           (then (call $array-shape-info (i32.const 15) (i32.const -2) (ref.null eq)) (drop) (drop) (drop)))
                         (local.set $caught (i32.const -1))))
                       (i32.and (i32.eq (local.get $caught) (local.get $expected))
                         (i32.and (i32.eq (global.get $value-count) (i32.const 2))
                           (ref.eq (local.get $saved) (global.get $extra-values)))))"
                    "array-type-raw-packet"
                    (miricl:wat-string (miricl::wat-text-literal "*ARRAY-TYPE-RAW-INPUT*"))
                    (miricl:wat-string (miricl::wat-text-literal "*ARRAY-TYPE-RAW-OTHER*")))))))
          (let* ((miricl::*interpreter-only-wasm* nil)
                 (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
            (m:with-interpreter (vm)
              (m:evaluate-string vm "(defparameter *array-type-raw-input* nil) (defparameter *array-type-raw-other* '(array *))")
              (dolist (fixture
                        '((0 "'(array bit (3))" -1)
                          (1 "'(536870910 2 0)" -1)
                          (2 "'(and (array * (* 2)) (array * (1 *)))" -1)
                          (3 "'(array bit (3))" -1)
                          (4 "'(and (array bit) (array *))" -1)
                          (4 "(let ((x (list :literal))) (setf (cdr x) x) (list 'eql x))" -1)
                          (0 "'(array bit (nil))" 0)
                          (1 "'(1 . bad)" 0)
                          (2 "(let ((x (list 'and nil))) (setf (second x) x) x)" 0)
                          (3 "'(array bit (nil))" 0)
                          (4 "(let ((x (list 'and nil))) (setf (second x) x) x)" 0)
                          (5 "nil" 0) (6 "nil" 0)))
                (destructuring-bind (mode source expected) fixture
                  (m:evaluate-string vm (format nil "(progn (setq *array-type-raw-input* ~A) (values))" source))
                  (is (= 1 (wt:instance-call (miricl::interpreter-context vm)
                                             (miricl::interpreter-instance vm)
                                             "array-type-raw-packet" mode expected)))
                  (is (eq t (m:evaluate-string vm "(nth-value 0 (subtypep '(array bit (3)) '(array *)))"))))))))
      (setf (fdefinition 'miricl::array-type-runtime-wat) original))))
