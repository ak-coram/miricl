;;;; Guest text codec.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $source-at (($position i32)) (i32)
  #@(if (global.get $source-generic)
    (then (return (call $stream-character (global.get $reader-stream)
      (i32.sub (local.get $position) (global.get $source-position)) (i32.const 0)))))
  #@(if (result i32) (i32.lt_u (local.get $position) (global.get $source-end))
    (then (array.get $digits (global.get $source) (local.get $position))) (else (i32.const -1))))

(define-runtime-function $source-peek () (i32)
  #@(if (global.get $source-generic)
    (then (return (call $stream-character (global.get $reader-stream) (i32.const 0) (i32.const 0)))))
  #@(if (result i32) (i32.lt_u (global.get $source-position) (global.get $source-end))
    (then (array.get $digits (global.get $source) (global.get $source-position))) (else (i32.const -1))))

(define-runtime-function $source-take () (i32)
  (:locals ($c i32))
  #@(if (global.get $source-generic)
    (then (local.set $c (call $stream-character (global.get $reader-stream) (i32.const 0) (i32.const 1))))
    (else (local.set $c (call $source-peek))
      (if (i32.ne (local.get $c) (i32.const -1))
        (then (global.set $source-position (i32.add (global.get $source-position) (i32.const 1)))))))
  #@(if (i32.eq (local.get $c) (i32.const -1)) (then (global.set $text-status (i32.const 1))))
  #@(local.get $c))

(define-runtime-function $source-advance (($position i32)) ()
  #@(if (i32.eqz (global.get $source-generic))
    (then (global.set $source-position (local.get $position)) (return)))
  #@(block $done (loop $next (br_if $done (i32.ge_u (global.get $source-position) (local.get $position)))
    (br_if $done (i32.eq (call $source-take) (i32.const -1))) (br $next))))

(define-runtime-function $white
    (($c i32))
    (i32)
  #@(i32.or (i32.eq (local.get $c) (i32.const 32))
    (i32.and (i32.ge_u (local.get $c) (i32.const 9)) (i32.le_u (local.get $c) (i32.const 13)))))

(define-runtime-function $delimiter
    (($c i32))
    (i32)
  (:locals ($syntax i32))
  #@(if (global.get $reader-standard-syntax)
    (then (return (i32.or (call $white (local.get $c))
      ,(reduce (lambda (a b) `(i32.or ,a ,b))
        (loop for c in '(-1 40 41 34 39 59 96 44) collect `(i32.eq (local.get $c) (i32.const ,c))))))))
  #@(if (i32.eq (local.get $c) (i32.const -1)) (then (return (i32.const 1))))
  #@(local.set $syntax (call $reader-syntax (local.get $c)))
  #@(i32.or (i32.eq (local.get $syntax) (i32.const 1))
    (i32.and (i32.gt_u (local.get $syntax) (i32.const 3))
      (i32.and (i32.ne (local.get $syntax) (i32.const 35))
        (i32.and (i32.ne (local.get $syntax) (i32.const 129)) (i32.ne (local.get $syntax) (i32.const 131)))))))

(define-runtime-function $upper
    (($c i32))
    (i32)
  #@(if (result i32) (i32.and (i32.ge_u (local.get $c) (i32.const 97)) (i32.le_u (local.get $c) (i32.const 122)))
      (then (i32.sub (local.get $c) (i32.const 32))) (else (local.get $c))))

(define-runtime-function $slice
    (($a :digits) ($start i32) ($length i32))
    (:object)
  (:locals ($b :digits))
  #@(local.set $b (array.new_default $digits (local.get $length)))
  #@(array.copy $digits $digits (local.get $b) (i32.const 0) (local.get $a) (local.get $start) (local.get $length))
  #@(call $text (local.get $b)))

(define-runtime-function $decode-text
    (($start i32) ($length i32))
    (:nullable-object)
  (:locals ($a :digits)
           ($i i32)
           ($n i32)
           ($c i32)
           ($b i32)
           ($need i32)
           ($min i32))
  (wat-fail-when #@(i64.gt_u (i64.add (i64.extend_i32_u (local.get $start)) (i64.extend_i32_u (local.get $length)))
    (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16))) :reader-syntax)
  #@(local.set $a (array.new_default $digits (local.get $length)))
  #@(local.set $i (local.get $start))
  #@(local.set $length (i32.add (local.get $start) (local.get $length)))
  #@(block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
    (local.set $c (i32.load8_u (local.get $i))) (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (local.set $need (i32.const 0)) (local.set $min (i32.const 0))
    (if (i32.ge_u (local.get $c) (i32.const 128))
        (then
          ,(wat-fail-when #@(i32.lt_u (local.get $c) (i32.const 194)) :reader-syntax)
          (if (i32.lt_u (local.get $c) (i32.const 224))
              (then (local.set $need (i32.const 1)) (local.set $min (i32.const 128))
                    (local.set $c (i32.and (local.get $c) (i32.const 31))))
              (else (if (i32.lt_u (local.get $c) (i32.const 240))
                (then (local.set $need (i32.const 2)) (local.set $min (i32.const 2048))
                      (local.set $c (i32.and (local.get $c) (i32.const 15))))
                (else ,(wat-fail-when #@(i32.gt_u (local.get $c) (i32.const 244)) :reader-syntax)
                      (local.set $need (i32.const 3)) (local.set $min (i32.const 65536))
                      (local.set $c (i32.and (local.get $c) (i32.const 7)))))))
          (block $decoded (loop $continuation (br_if $decoded (i32.eqz (local.get $need)))
            ,(wat-fail-when #@(i32.ge_u (local.get $i) (local.get $length)) :reader-syntax)
            (local.set $b (i32.load8_u (local.get $i)))
            ,(wat-fail-when #@(i32.ne (i32.and (local.get $b) (i32.const 192)) (i32.const 128)) :reader-syntax)
            (local.set $c (i32.or (i32.shl (local.get $c) (i32.const 6)) (i32.and (local.get $b) (i32.const 63))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (local.set $need (i32.sub (local.get $need) (i32.const 1))) (br $continuation)))
          ,(wat-fail-when #@(i32.or (i32.lt_u (local.get $c) (local.get $min))
                (i32.or (i32.gt_u (local.get $c) (i32.const 1114111))
                  (i32.and (i32.ge_u (local.get $c) (i32.const 55296)) (i32.le_u (local.get $c) (i32.const 57343))))) :reader-syntax)))
    (array.set $digits (local.get $a) (local.get $n) (local.get $c))
    (local.set $n (i32.add (local.get $n) (i32.const 1))) (br $next)))
  #@(call $slice (local.get $a) (i32.const 0) (local.get $n)))

(define-runtime-function $decode-source (($length i32)) ()
  #@(global.set $source (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (call $decode-text (i32.const 0) (local.get $length))))))
  #@(global.set $source-end (array.len (global.get $source)))
  #@(global.set $reader-stream (ref.null eq))
  #@(global.set $source-generic (i32.const 0)))

(define-runtime-function $emit-byte
    (($c i32))
    ()
  #@(call $reserve (i32.const 1))
  #@(i32.store8 (global.get $cursor) (local.get $c))
  #@(global.set $cursor (i32.add (global.get $cursor) (i32.const 1))))

(define-runtime-function $emit-char
    (($c i32))
    ()
  #@(if (i32.lt_u (local.get $c) (i32.const 128)) (then (call $emit-byte (local.get $c)) (return)))
  #@(if (i32.lt_u (local.get $c) (i32.const 2048))
      (then (call $emit-byte (i32.or (i32.const 192) (i32.shr_u (local.get $c) (i32.const 6))))
            (call $emit-byte (i32.or (i32.const 128) (i32.and (local.get $c) (i32.const 63)))) (return)))
  #@(if (i32.lt_u (local.get $c) (i32.const 65536))
      (then (call $emit-byte (i32.or (i32.const 224) (i32.shr_u (local.get $c) (i32.const 12)))))
      (else (call $emit-byte (i32.or (i32.const 240) (i32.shr_u (local.get $c) (i32.const 18))))
            (call $emit-byte (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $c) (i32.const 12)) (i32.const 63))))))
  #@(call $emit-byte (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $c) (i32.const 6)) (i32.const 63))))
  #@(call $emit-byte (i32.or (i32.const 128) (i32.and (local.get $c) (i32.const 63)))))

(define-runtime-function $emit-literal (($start i32) ($length i32)) ()
  #@(call $reserve (local.get $length))
  #@(memory.init $output-literal-data (global.get $cursor) (local.get $start) (local.get $length))
  #@(global.set $cursor (i32.add (global.get $cursor) (local.get $length))))

(define-runtime-function $print-text
    (($text :nullable-object))
    ()
  (:locals ($i i32)
           ($a :digits))
  #@(local.set $a (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $text)))))
  #@(block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (array.len (local.get $a))))
    (call $emit-char (array.get $digits (local.get $a) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next))))

(define-runtime-section text-codec-wat ()
  #@(global $source (mut (ref $digits)) (array.new_default $digits (i32.const 0)))
  #@(global $source-generic (mut i32) (i32.const 0))
  #@(global $source-end (mut i32) (i32.const 0))
  #@(global $reader-stream (mut (ref null eq)) (ref.null eq))
  #@(global $source-position (mut i32) (i32.const 0))
  #@(global $source-depth (mut i32) (i32.const 0))
  #@(global $source-bq-depth (mut i32) (i32.const 0))
  #@(global $source-suppress (mut i32) (i32.const 0))
  #@(global $text-status (export "text-status") (mut i32) (i32.const 0))
  #@(global $text-output-length (export "text-output-length") (mut i32) (i32.const 0))
  ($source-at) ($source-advance)
  ($source-peek)
  ($source-take)
  ($white)
  ($delimiter)
  ($upper)
  ($slice)
  ($decode-text) ($decode-source)
  ($emit-byte)
  ($emit-char)
  ($emit-literal)
  ($print-text))
