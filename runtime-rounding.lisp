;;;; Real quotient/remainder operations; integer and rational division is exact.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; Modes: FLOOR=0, CEILING=1, TRUNCATE=2, ROUND=3.
(define-runtime-function $rounding-native
    (($a :object) ($b :object) ($mode i32) ($floating i32)) (:object :object)
  (:locals ($an :object) ($bn :object) ($q :object) ($r :object)
           ($kind i32) ($sign i32) ($adjust i32) ($cmp i32) ($value f64))
  #@(if (call $zero (local.get $b)) (then (call $division-error (local.get $a) (local.get $b))))
  #@(local.set $kind (select (call $tag (local.get $a)) (call $tag (local.get $b))
    (i32.gt_u (call $tag (local.get $a)) (call $tag (local.get $b)))))
  #@(if (i32.ge_u (local.get $kind) (i32.const 3))
    (then
      ;; Contagion applies to both operands before quotient and remainder
      ;; arithmetic, including the integer-quotient operations.
      (if (i32.ne (call $tag (local.get $a)) (local.get $kind))
        (then (local.set $a (call $float (local.get $kind) (call $coerce-float (local.get $a) (local.get $kind))))))
      (if (i32.ne (call $tag (local.get $b)) (local.get $kind))
        (then (local.set $b (call $float (local.get $kind) (call $coerce-float (local.get $b) (local.get $kind))))))
      (local.set $value (struct.get $obj $f (call $real-op (i32.const 3) (local.get $a) (local.get $b))))
      (if (i32.eq (local.get $mode) (i32.const 0)) (then (local.set $value (f64.floor (local.get $value)))))
      (if (i32.eq (local.get $mode) (i32.const 1)) (then (local.set $value (f64.ceil (local.get $value)))))
      (if (i32.eq (local.get $mode) (i32.const 2)) (then (local.set $value (f64.trunc (local.get $value)))))
      (if (i32.eq (local.get $mode) (i32.const 3)) (then (local.set $value (f64.nearest (local.get $value)))))
      (local.set $q (call $float (local.get $kind) (local.get $value)))
      (if (i32.eqz (local.get $floating)) (then (local.set $q (call $rational (local.get $q)))))
      (return (local.get $q) (call $real-op (i32.const 1) (local.get $a)
        (call $real-op (i32.const 2) (local.get $q) (local.get $b))))))
  #@(local.set $an (call $numerator (local.get $a)))
  #@(local.set $bn (call $numerator (local.get $b)))
  #@(if (i32.eq (local.get $kind) (i32.const 2))
    (then
      (local.set $an (call $imul (local.get $an) (call $denominator (local.get $b))))
      (local.set $bn (call $imul (local.get $bn) (call $denominator (local.get $a))))))
  #@(local.set $sign (i32.mul (struct.get $obj $n (local.get $an)) (struct.get $obj $n (local.get $bn))))
  #@(local.set $an (call $iabs (local.get $an))) #@(local.set $bn (call $iabs (local.get $bn)))
  #@(call $idiv (local.get $an) (local.get $bn)) #@(local.set $r) #@(local.set $q)
  #@(if (struct.get $obj $n (local.get $r))
    (then
      (if (i32.eq (local.get $mode) (i32.const 0)) (then (local.set $adjust (i32.lt_s (local.get $sign) (i32.const 0)))))
      (if (i32.eq (local.get $mode) (i32.const 1)) (then (local.set $adjust (i32.gt_s (local.get $sign) (i32.const 0)))))
      (if (i32.eq (local.get $mode) (i32.const 3))
        (then
          (local.set $cmp (call $cmpabs (call $imul (local.get $r) (call $int (i32.const 2))) (local.get $bn)))
          (local.set $adjust (i32.or (i32.gt_s (local.get $cmp) (i32.const 0))
            (i32.and (i32.eqz (local.get $cmp)) (i32.and (call $digit (local.get $q) (i32.const 0)) (i32.const 1)))))))
      (if (local.get $adjust) (then (local.set $q (call $iadd (local.get $q) (call $int (i32.const 1))))))))
  #@(if (i32.lt_s (local.get $sign) (i32.const 0)) (then (local.set $q (call $negative (local.get $q)))))
  #@(if (i32.eq (local.get $kind) (i32.const 1))
    (then
      (if (local.get $adjust) (then (local.set $r (call $addabs (local.get $bn) (local.get $r) (i32.const 1)))))
      (if (i32.xor (i32.lt_s (struct.get $obj $n (local.get $a)) (i32.const 0)) (local.get $adjust))
        (then (local.set $r (call $negative (local.get $r))))))
    (else (local.set $r (call $real-op (i32.const 1) (local.get $a)
      (call $real-op (i32.const 2) (local.get $q) (local.get $b))))))
  #@(if (local.get $floating) (then (local.set $q (call $float (i32.const 3) (call $coerce-float (local.get $q) (i32.const 3))))))
  #@(local.get $q) #@(local.get $r))

(define-runtime-function $rounding-apply (($id i32) ($args :nullable-object)) (:nullable-object)
  (:locals ($a :object) ($b :object) ($q :object) ($r :object) ($mode i32) ($floating i32) ($remainder i32))
  #@(local.set $remainder (i32.or (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'mod)))
    (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'rem)))))
  #@(if (local.get $remainder) (then ,(wat-arity 2)) (else ,(wat-arity 1 2)))
  #@(local.set $a (call $real (call $car (local.get $args))))
  #@(local.set $args (call $cdr (local.get $args)))
  #@(local.set $b (if (result (ref $obj)) (ref.is_null (local.get $args))
    (then (call $int (i32.const 1))) (else (call $real (call $car (local.get $args))))))
  (wat-symbol-case #@(local.get $id)
    ((ceiling fceiling) #@(local.set $mode (i32.const 1)))
    ((truncate ftruncate rem) #@(local.set $mode (i32.const 2)))
    ((round fround) #@(local.set $mode (i32.const 3))))
  #@(local.set $floating (i32.le_u (i32.sub (local.get $id) (i32.const ,(runtime-symbol-id 'ffloor))) (i32.const 3)))
  #@(call $rounding-native (local.get $a) (local.get $b) (local.get $mode) (local.get $floating))
  #@(local.set $r) #@(local.set $q)
  #@(if (local.get $remainder) (then (call $clear-values) (return (local.get $r))))
  #@(call $two-values (local.get $q) (local.get $r)))

;; Continued fractions select a simple rational inside an exact rounding
;; interval. A null upper endpoint denotes positive infinity after inversion.
(define-runtime-function $rational-in-interval
    (($a :object) ($b :nullable-object) ($inclusive i32)) (:object)
  (:locals ($p0 :object) ($p1 :object) ($q0 :object) ($q1 :object)
           ($whole :object) ($remainder :object) ($candidate :object)
           ($next-p :object) ($next-q :object) ($next-a :object) ($next-b :nullable-object) ($cmp i32))
  #@(local.set $p0 (call $int (i32.const 0)))
  #@(local.set $p1 (call $int (i32.const 1)))
  #@(local.set $q0 (local.get $p1))
  #@(local.set $q1 (local.get $p0))
  #@(loop $fraction
    (call $idiv (call $numerator (local.get $a)) (call $denominator (local.get $a)))
    (local.set $remainder) (local.set $whole)
    (local.set $candidate (local.get $whole))
    (if (i32.or (i32.eqz (call $zero (local.get $remainder))) (i32.eqz (local.get $inclusive)))
      (then (local.set $candidate (call $iadd (local.get $candidate) (call $int (i32.const 1))))))
    (local.set $cmp (i32.const -1))
    (if (i32.eqz (ref.is_null (local.get $b)))
      (then (local.set $cmp (call $compare (local.get $candidate) (local.get $b)))))
    (if (i32.or (i32.lt_s (local.get $cmp) (i32.const 0))
                (i32.and (i32.eqz (local.get $cmp)) (local.get $inclusive)))
      (then (return (call $ratio
        (call $iadd (call $imul (local.get $p1) (local.get $candidate)) (local.get $p0))
        (call $iadd (call $imul (local.get $q1) (local.get $candidate)) (local.get $q0))))))
    (local.set $next-p (call $iadd (call $imul (local.get $p1) (local.get $whole)) (local.get $p0)))
    (local.set $next-q (call $iadd (call $imul (local.get $q1) (local.get $whole)) (local.get $q0)))
    (local.set $p0 (local.get $p1)) (local.set $p1 (local.get $next-p))
    (local.set $q0 (local.get $q1)) (local.set $q1 (local.get $next-q))
    (local.set $next-a (call $real-op (i32.const 3) (call $int (i32.const 1))
      (call $real-op (i32.const 1) (ref.as_non_null (local.get $b)) (local.get $whole))))
    (local.set $next-b (ref.null $obj))
    (if (i32.eqz (call $zero (local.get $remainder)))
      (then (local.set $next-b (call $real-op (i32.const 3) (call $int (i32.const 1))
        (call $real-op (i32.const 1) (local.get $a) (local.get $whole))))))
    (local.set $a (local.get $next-a)) (local.set $b (local.get $next-b))
    (br $fraction))
  #@(unreachable))

(define-runtime-function $rationalize-native (($x :object)) (:object)
  (:locals ($value :object) ($unit :object) ($lower :object) ($upper :object)
           ($mantissa i64) ($exponent i32) ($precision i32) ($minimum i32) ($lower-divisor i32) ($negative i32))
  #@(if (i32.le_u (call $tag (local.get $x)) (i32.const 2)) (then (return (local.get $x))))
  ;; Integral floats already have denominator one. This path also handles
  ;; signed zero, and keeps integer round-trip loops as cheap as RATIONAL.
  #@(if (f64.eq (struct.get $obj $f (local.get $x)) (f64.trunc (struct.get $obj $f (local.get $x))))
    (then (return (call $rational (local.get $x)))))
  #@(local.set $negative (f64.lt (struct.get $obj $f (local.get $x)) (f64.const 0)))
  #@(local.set $value (call $rational (local.get $x)))
  #@(if (local.get $negative)
    (then (local.set $value (call $real-op (i32.const 1) (call $int (i32.const 0)) (local.get $value)))))
  #@(call $float-parts (local.get $x)) #@(local.set $exponent) #@(local.set $mantissa)
  #@(local.set $precision (select (i32.const 24) (i32.const 53) (i32.eq (call $tag (local.get $x)) (i32.const 3))))
  #@(local.set $minimum (select (i32.const -149) (i32.const -1074) (i32.eq (call $tag (local.get $x)) (i32.const 3))))
  #@(local.set $unit (if (result (ref $obj)) (i32.ge_s (local.get $exponent) (i32.const 0))
    (then (call $pow2 (local.get $exponent)))
    (else (call $ratio (call $int (i32.const 1)) (call $pow2 (i32.sub (i32.const 0) (local.get $exponent)))))))
  ;; Immediately below a normal power of two, the spacing is half as large.
  ;; At the normal/subnormal boundary both adjacent spacings are equal.
  #@(local.set $lower-divisor (select (i32.const 4) (i32.const 2)
    (i32.and (i32.gt_s (local.get $exponent) (local.get $minimum))
      (i64.eq (local.get $mantissa) (i64.shl (i64.const 1)
        (i64.extend_i32_u (i32.sub (local.get $precision) (i32.const 1))))))))
  #@(local.set $lower (call $real-op (i32.const 1) (local.get $value)
    (call $real-op (i32.const 3) (local.get $unit) (call $int (local.get $lower-divisor)))))
  #@(local.set $upper (call $real-op (i32.const 0) (local.get $value)
    (call $real-op (i32.const 3) (local.get $unit) (call $int (i32.const 2)))))
  #@(local.set $value (call $rational-in-interval (local.get $lower) (local.get $upper)
    (i64.eqz (i64.and (local.get $mantissa) (i64.const 1)))))
  #@(if (result (ref $obj)) (local.get $negative)
    (then (call $real-op (i32.const 1) (call $int (i32.const 0)) (local.get $value)))
    (else (local.get $value))))

(define-runtime-section rounding-runtime-wat ()
  ($rounding-native) ($rounding-apply) ($rational-in-interval) ($rationalize-native))
