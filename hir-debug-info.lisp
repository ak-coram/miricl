;;;; Lexical debugger metadata derived from semantic HIR, never source trees.
(in-package :miricl-compiler)

(defun hir-code-debug-sites (function register)
  (let ((sites nil) (indices (make-hash-table :test 'eq)) (count 0))
    (dolist (block (hir-function-blocks function))
      (dolist (instruction (hir-block-instructions block))
        (when (member (hir-instruction-opcode instruction) '(:debug-step :debug-resume))
          (let ((site (first (hir-instruction-attributes instruction))))
            (when site
              (unless (eq (hir-debug-site-owner site) function)
                (hir-code-error site "debug site belongs to another function"))
              (unless (gethash site indices)
                (setf (gethash site indices) (1+ count)) (incf count) (push site sites)))))))
    (labels ((capture (identity)
               (or (position identity (hir-function-captures function))
                   (hir-code-error identity "visible debug binding was not captured")))
             (scope (site)
               (let ((result nil))
                 (dolist (entry (hir-debug-site-variables site))
                   (let* ((binding (cdr entry)) (special (hir-binding-special-p binding))
                          (local (eq (hir-binding-owner binding) function)))
                     (setq result (nconc result
                       (list (cond (special 4) (local 0) (t 1))
                         (cond (special 0) (local (funcall register (hir-binding-cell binding))) (t (capture binding)))
                         (car entry) t)))))
                 (dolist (entry (hir-debug-site-functions site))
                   (let* ((binding (cdr entry)) (local (eq (hir-binding-owner binding) function)))
                     (setq result (nconc result
                       (list (if local 2 3) (if local (funcall register (hir-binding-cell binding)) (capture binding))
                         (car entry) t)))))
                 (dolist (entry (hir-debug-site-targets site))
                   (let* ((target (cdr entry)) (local (eq (hir-target-owner target) function))
                          (tag (consp (car entry))))
                     (setq result (nconc result
                       (list (if tag (if local 7 8) (if local 5 6))
                         (if local (funcall register (hir-target-token target)) (capture target))
                         (hir-target-name target) t)))))
                 (coerce result 'simple-vector))))
      (values
        (coerce (loop for site in (nreverse sites) collect
          (vector (hir-debug-site-kind site) (hir-debug-site-operator site)
            (if (hir-debug-site-value site) (1+ (funcall register (hir-debug-site-value site))) 0)
            (if (hir-debug-site-parent site) (or (gethash (hir-debug-site-parent site) indices)
                                              (hir-code-error site "missing debug parent")) 0)
            (scope site)
            (loop for parent = (hir-debug-site-parent site) then (hir-debug-site-parent parent)
                  while parent count t))) 'simple-vector)
        indices))))
