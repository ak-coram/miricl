;;;; Instruction listings for retained native code, entirely in the Lisp runtime.
(in-package #:miricl-compiler)

(defun native-disassembly-name (bytes position)
  (declare (type vector bytes) (type (unsigned-byte 32) position))
  (multiple-value-bind (length next) (native-read-uleb bytes position)
    ;; Native module/import names are the compiler's ASCII ABI identifiers.
    (values (map 'string #'code-char (subseq bytes next (+ next length))) (+ next length))))

(defun native-disassembly-body (bytes index)
  (declare (type vector bytes) (type (unsigned-byte 32) index))
  (let ((position 8) (imports nil))
    (loop while (< position (length bytes)) do
      (let ((section (aref bytes position)) (size nil))
        (multiple-value-setq (size position) (native-read-uleb bytes (1+ position)))
        (let ((end (+ position size)) (count nil))
          (case section
            (2
             (multiple-value-setq (count position) (native-read-uleb bytes position))
             (dotimes (i count)
               (let ((module nil) (name nil) (kind nil) (ignored nil))
                 (multiple-value-setq (module position) (native-disassembly-name bytes position))
                 (multiple-value-setq (name position) (native-disassembly-name bytes position))
                 (setq kind (aref bytes position)) (incf position)
                 (case kind
                   (0 (push (list module name) imports))
                   (4 (incf position))
                   (otherwise (error "Unexpected native import kind ~D." kind)))
                 (multiple-value-setq (ignored position) (native-read-uleb bytes position)))))
            (10
             (multiple-value-setq (count position) (native-read-uleb bytes position))
             (dotimes (i count)
               (multiple-value-setq (size position) (native-read-uleb bytes position))
               (when (= index (+ i (length imports)))
                 (return-from native-disassembly-body
                   (values (subseq bytes position (+ position size)) (coerce (nreverse imports) 'vector) position)))
               (incf position size))))
          (setq position end))))
    (error "Native function ~D has no retained body." index)))

(defun native-disassembly-target (index imports)
  (declare (type (unsigned-byte 32) index) (type vector imports))
  (if (< index (length imports)) (format nil "$~A" (second (aref imports index)))
      (format nil "$function~D" index)))

(defun native-disassembly-instruction (op bytes imports)
  (declare (type simple-vector op) (type vector bytes imports))
  (let* ((code (native-op-code op)) (argument (native-op-argument op))
         (plain (cdr (assoc code '((#x00 . "unreachable") (#x05 . "else") (#x0b . "end")
           (#x0f . "return") (#x1a . "drop") (#x45 . "i32.eqz") (#x46 . "i32.eq")
           (#x48 . "i32.lt_s") (#x4a . "i32.gt_s") (#x4c . "i32.le_s") (#x4e . "i32.ge_s")
           (#x51 . "i64.eq") (#x52 . "i64.ne")
           (#x53 . "i64.lt_s") (#x55 . "i64.gt_s") (#x57 . "i64.le_s") (#x59 . "i64.ge_s")
           (#x71 . "i32.and") (#x7c . "i64.add") (#x7d . "i64.sub") (#x7e . "i64.mul")
           (#x83 . "i64.and") (#x84 . "i64.or") (#x85 . "i64.xor")
           (#xa7 . "i32.wrap_i64") (#xac . "i64.extend_i32_s") (#xd1 . "ref.is_null")))))
         (indexed (cdr (assoc code '((#x08 . "throw") (#x0c . "br") (#x0d . "br_if")
           (#x20 . "local.get") (#x21 . "local.set") (#x22 . "local.tee") (#x41 . "i32.const") (#x42 . "i64.const"))))))
    (cond (plain plain)
          (indexed (format nil "~A ~D" indexed argument))
          ((member code '(#x02 #x03 #x04))
           (format nil "~A~A" (cdr (assoc code '((2 . "block") (3 . "loop") (4 . "if"))))
             (case argument (#x40 "") (#x6f " (result externref)") (#x7f " (result i32)")
               (otherwise (format nil " (type ~D)" argument)))))
          ((= code #x0e) (format nil "br_table~{ ~D~}" argument))
          ((= code #x10) (format nil "call ~A" (native-disassembly-target argument imports)))
          ((= code #x12) (format nil "return_call ~A" (native-disassembly-target argument imports)))
          ((= code #xd2) (format nil "ref.func ~A" (native-disassembly-target argument imports)))
          ((= code #xd0) "ref.null extern")
          ((= code #x1f)
           (with-output-to-string (out)
             (write-string "try_table" out)
             (let ((position (+ (native-op-start op) 2)) (count nil))
               (multiple-value-setq (count position) (native-read-uleb bytes position))
               (dotimes (i count)
                 (let ((kind (aref bytes position)) (tag nil) (depth nil))
                   (incf position)
                   (when (< kind 2) (multiple-value-setq (tag position) (native-read-uleb bytes position)))
                   (multiple-value-setq (depth position) (native-read-uleb bytes position))
                   (format out " (~A" (nth kind '("catch" "catch_ref" "catch_all" "catch_all_ref")))
                   (when tag (format out " ~D" tag))
                   (format out " ~D)" depth))))))
          ((= code #xfb)
           (let ((position (1+ (native-op-start op))) (subcode nil) (type nil) (field nil))
             (multiple-value-setq (subcode position) (native-read-uleb bytes position))
             (case subcode
               (2 (multiple-value-setq (type position) (native-read-uleb bytes position))
                  (multiple-value-setq (field position) (native-read-uleb bytes position))
                  (format nil "struct.get ~D ~D" type field))
               ((#x14 #x16 #x17)
                (multiple-value-setq (type position) (native-read-sleb bytes position))
                (format nil "~A (ref ~A~A)" (if (= subcode #x14) "ref.test" "ref.cast")
                  (if (= subcode #x17) "null " "") (if (= type -20) "i31" type)))
               (#x1a "any.convert_extern")
               (#x1b "extern.convert_any")
               (#x1c "ref.i31")
               (#x1d "i31.get_s")
               (otherwise (error "Unexpected native GC instruction ~D." subcode)))))
          (t (error "Unexpected native instruction ~D." code)))))

(defun disassemble-native (bytes index)
  (declare (type vector bytes) (type (unsigned-byte 32) index))
  (multiple-value-bind (body imports offset) (native-disassembly-body bytes index)
    ;; Share the optimizer's decoder, including instruction boundaries and
    ;; signed immediates. No recompilation or execution of the target is needed.
    (let ((ops (native-read-ops body)) (position 0) (groups nil) (local 2) (depth 1))
      (format t "; Wasm instructions for function ~D (~D body bytes).~%" index (length body))
      (format t "(func $function~D (param externref externref) (result externref)~%" index)
      (multiple-value-setq (groups position) (native-read-uleb body position))
      (dotimes (i groups)
        (let ((count nil) (type nil))
          (multiple-value-setq (count position) (native-read-uleb body position))
          (setq type (aref body position)) (incf position)
          (when (plusp count)
            (format t "  ;; locals ~D..~D: ~D x ~A~%" local (+ local count -1) count
              (case type (#x7f "i32") (#x6f "externref"))))
          (incf local count)))
      (loop for op across ops for code = (native-op-code op) do
        (when (member code '(#x05 #x0b)) (decf depth))
        (format t "  ~6,'0X: ~A~A~%" (+ offset (native-op-start op))
          (make-string (* 2 (max 0 depth)) :initial-element #\Space)
          (native-disassembly-instruction op body imports))
        (when (member code '(#x02 #x03 #x04 #x05 #x1f)) (incf depth)))
      (write-line ")")))
  nil)
