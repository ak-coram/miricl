        (i32.or (i32.eqz (local.get $even)) (i32.and (call $digit (local.get $q) (i32.const 0)) (i32.const 1)))))
    (then (local.set $q (call $iadd (local.get $q) (call $int (i32.const 1))))))
  #@(local.get $q))

