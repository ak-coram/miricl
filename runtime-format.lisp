  ;; Explicit decimal fields retain their existing round-away tie policy.
  #@(local.set $comparison (call $cmpabs (call $imul (local.get $r) (call $int (i32.const 2))) (local.get $b)))
  #@(if (i32.or (i32.gt_s (local.get $comparison) (i32.const 0))
