;;;; FORMAT's control-string interpreter. All parsing and printing run in WASM.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $format-small (($x :nullable-object)) (i32)
  (wat-fail-when #@(i32.ne (call $tag (local.get $x)) (i32.const 1)) :expected-designator)
  (wat-fail-when #@(i32.gt_u (call $bitlength (ref.as_non_null (local.get $x))) (i32.const 30)) :unsupported)
  #@(i32.mul (struct.get $obj $n (local.get $x))
    (i32.or (call $digit (ref.as_non_null (local.get $x)) (i32.const 0))
      (i32.shl (call $digit (ref.as_non_null (local.get $x)) (i32.const 1)) (i32.const 15)))))

(define-runtime-function $format-param (($params (ref $objects)) ($i i32) ($default i32)) (i32)
  (:locals ($value :nullable-object))
  #@(if (i32.ge_u (local.get $i) (array.len (local.get $params))) (then (return (local.get $default))))
  #@(local.set $value (array.get $objects (local.get $params) (local.get $i)))
  #@(if (ref.is_null (local.get $value)) (then (return (local.get $default))))
  #@(if (result i32) (i32.eq (call $tag (local.get $value)) (i32.const 16))
    (then (struct.get $obj $n (local.get $value))) (else (call $format-small (local.get $value)))))

(define-runtime-function $format-index (($value :nullable-object)) (i32)
  (wat-fail-when #@(i32.ne (call $tag (local.get $value)) (i32.const 1)) :expected-designator)
  #@(if (i32.gt_u (call $bitlength (ref.as_non_null (local.get $value))) (i32.const 30))
    (then (return (i32.const -1))))
  #@(call $format-small (local.get $value)))

(define-runtime-function $format-mincol (($params (ref $objects)) ($i i32)) (i32)
  (:locals ($value :nullable-object))
  #@(if (i32.ge_u (local.get $i) (array.len (local.get $params))) (then (return (i32.const 0))))
  #@(local.set $value (array.get $objects (local.get $params) (local.get $i)))
  #@(if (ref.is_null (local.get $value)) (then (return (i32.const 0))))
  #@(if (i32.eq (call $tag (local.get $value)) (i32.const 1))
    (then (if (i32.le_s (struct.get $obj $n (local.get $value)) (i32.const 0)) (then (return (i32.const 0))))))
  #@(call $format-small (local.get $value)))

;; START points just past ~. SCAN parses syntax without consuming V arguments.
(define-runtime-function $format-parse
    (($digits :digits) ($i i32) ($end i32) ($args :nullable-object) ($scan i32))
    (i32 i32 i32 i32 (ref $objects) :nullable-object i32)
  (:locals ($c i32) ($n i32) ($sign i32) ($slot i32) ($colon i32) ($at i32)
           ($params (ref $objects)) ($grown (ref $objects)) ($x :nullable-object) ($number :nullable-object) ($count i32))
  #@(local.set $params (array.new_default $objects (i32.const 8)))
  #@(block $parameters (loop $next
    ,(wat-fail-when #@(i32.ge_u (local.get $i) (local.get $end)) :malformed-form)
    (local.set $c (call $upper (array.get $digits (local.get $digits) (local.get $i))))
    (br_if $parameters (i32.or (i32.eq (local.get $c) (i32.const 58)) (i32.eq (local.get $c) (i32.const 64))))
    (local.set $n (i32.const -2147483648))
    (local.set $x (ref.null $obj))
    (block $parameter
      (if (i32.eq (local.get $c) (i32.const 44)) (then (br $parameter)))
      (if (i32.eq (local.get $c) (i32.const 39))
        (then (local.set $i (i32.add (local.get $i) (i32.const 1)))
          ,(wat-fail-when #@(i32.ge_u (local.get $i) (local.get $end)) :malformed-form)
          (local.set $n (array.get $digits (local.get $digits) (local.get $i)))
          (local.set $x (call $node (i32.const 16) (local.get $n) (ref.null $obj) (ref.null $obj) (ref.null $obj)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $parameter)))
      (if (i32.eq (local.get $c) (i32.const 35))
        (then (local.set $n (call $length (local.get $args)))
          (local.set $x (call $int (local.get $n)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $parameter)))
      (if (i32.eq (local.get $c) (i32.const 86))
        (then
          (if (i32.eqz (local.get $scan))
            (then ,(wat-fail-when #@(ref.is_null (local.get $args)) :wrong-arity)
              (local.set $x (call $car (local.get $args))) (local.set $args (call $cdr (local.get $args)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $parameter)))
      (local.set $sign (i32.const 1))
      (if (i32.or (i32.eq (local.get $c) (i32.const 43)) (i32.eq (local.get $c) (i32.const 45)))
        (then (local.set $sign (select (i32.const -1) (i32.const 1) (i32.eq (local.get $c) (i32.const 45))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          ,(wat-fail-when #@(i32.ge_u (local.get $i) (local.get $end)) :malformed-form)
          (local.set $c (array.get $digits (local.get $digits) (local.get $i)))
          ,(wat-fail-when #@(i32.or (i32.lt_u (local.get $c) (i32.const 48)) (i32.gt_u (local.get $c) (i32.const 57))) :malformed-form)))
      (br_if $parameters (i32.or (i32.lt_u (local.get $c) (i32.const 48)) (i32.gt_u (local.get $c) (i32.const 57))))
      (local.set $n (i32.const 0))
      (local.set $number (ref.null $obj))
      (block $number-done (loop $number
        (br_if $number-done (i32.ge_u (local.get $i) (local.get $end)))
        (local.set $c (array.get $digits (local.get $digits) (local.get $i)))
        (br_if $number-done (i32.or (i32.lt_u (local.get $c) (i32.const 48)) (i32.gt_u (local.get $c) (i32.const 57))))
        (if (i32.and (ref.is_null (local.get $number)) (i32.le_u (local.get $n) (i32.const 100000000)))
          (then (local.set $n (i32.add (i32.mul (local.get $n) (i32.const 10)) (i32.sub (local.get $c) (i32.const 48)))))
          (else (if (ref.is_null (local.get $number)) (then (local.set $number (call $int (local.get $n)))))
            (local.set $number (call $iadd (call $imul (ref.as_non_null (local.get $number)) (call $int (i32.const 10)))
              (call $int (i32.sub (local.get $c) (i32.const 48)))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $number)))
      (local.set $x (if (result (ref null $obj)) (ref.is_null (local.get $number))
        (then (call $int (i32.mul (local.get $n) (local.get $sign))))
        (else (if (result (ref null $obj)) (i32.lt_s (local.get $sign) (i32.const 0))
          (then (call $negative (ref.as_non_null (local.get $number)))) (else (local.get $number)))))))
    (if (i32.ge_u (local.get $slot) (array.len (local.get $params)))
      (then (local.set $grown (array.new_default $objects (i32.mul (array.len (local.get $params)) (i32.const 2))))
        (array.copy $objects $objects (local.get $grown) (i32.const 0) (local.get $params) (i32.const 0) (array.len (local.get $params)))
        (local.set $params (local.get $grown))))
    (array.set $objects (local.get $params) (local.get $slot) (local.get $x))
    (local.set $count (i32.add (local.get $slot) (i32.const 1)))
    ,(wat-fail-when #@(i32.ge_u (local.get $i) (local.get $end)) :malformed-form)
    (br_if $parameters (i32.ne (array.get $digits (local.get $digits) (local.get $i)) (i32.const 44)))
    (local.set $slot (i32.add (local.get $slot) (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(loop $modifiers
    ,(wat-fail-when #@(i32.ge_u (local.get $i) (local.get $end)) :malformed-form)
    (local.set $c (call $upper (array.get $digits (local.get $digits) (local.get $i))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (if (i32.eq (local.get $c) (i32.const 58))
      (then ,(wat-fail-when #@(local.get $colon) :malformed-form) (local.set $colon (i32.const 1)) (br $modifiers)))
    (if (i32.eq (local.get $c) (i32.const 64))
      (then ,(wat-fail-when #@(local.get $at) :malformed-form) (local.set $at (i32.const 1)) (br $modifiers))))
  #@(local.get $i) #@(local.get $c) #@(local.get $colon) #@(local.get $at) #@(local.get $params) #@(local.get $args) #@(local.get $count))

;; Locate a matching close or a separator at the current nesting depth.
(define-runtime-function $format-close
    (($digits :digits) ($i i32) ($end i32) ($close i32) ($separator i32)) (i32 i32 i32 i32)
  (:locals ($start i32) ($c i32) ($colon i32) ($depth i32))
  #@(block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $end)))
    (local.set $start (local.get $i))
    (local.set $c (array.get $digits (local.get $digits) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (if (i32.eq (local.get $c) (i32.const 126))
      (then
        (call $format-parse (local.get $digits) (local.get $i) (local.get $end) (ref.null $obj) (i32.const 1))
        (drop) (drop) (drop) (drop) (local.set $colon) (local.set $c) (local.set $i)
        (if (i32.eq (local.get $c) (i32.const 47))
          (then (local.set $i (i32.add (call $format-slash-end (local.get $digits) (local.get $i) (local.get $end)) (i32.const 1)))))
        (if (i32.eqz (local.get $depth))
          (then (if (i32.or (i32.eq (local.get $c) (local.get $close))
              (i32.and (local.get $separator) (i32.eq (local.get $c) (i32.const 59))))
            (then (return (local.get $start) (local.get $i) (local.get $c) (local.get $colon))))))
        (if (i32.or (i32.eq (local.get $c) (i32.const 60)) (i32.or (i32.eq (local.get $c) (i32.const 123))
            (i32.or (i32.eq (local.get $c) (i32.const 91)) (i32.eq (local.get $c) (i32.const 40))))
          )
          (then (local.set $depth (i32.add (local.get $depth) (i32.const 1)))))
        (if (i32.or (i32.eq (local.get $c) (i32.const 62)) (i32.or (i32.eq (local.get $c) (i32.const 125))
            (i32.or (i32.eq (local.get $c) (i32.const 93)) (i32.eq (local.get $c) (i32.const 41))))
          )
          (then ,(wat-fail-when #@(i32.eqz (local.get $depth)) :malformed-form)
            (local.set $depth (i32.sub (local.get $depth) (i32.const 1)))))))
    (br $next)))
  (wat-fail :malformed-form)
  #@(unreachable))

(define-runtime-function $format-repeat (($c i32) ($n i32)) ()
  (wat-fail-when #@(i32.lt_s (local.get $n) (i32.const 0)) :malformed-form)
  (wat-fail-when #@(i32.or (i32.gt_u (local.get $c) (i32.const 1114111))
    (i32.and (i32.ge_u (local.get $c) (i32.const 55296)) (i32.le_u (local.get $c) (i32.const 57343)))) :malformed-form)
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $n)))
    (call $emit-char (local.get $c)) (local.set $n (i32.sub (local.get $n) (i32.const 1))) (br $next))))

(define-runtime-function $format-pad (($text :nullable-object) ($width i32) ($pad i32) ($right i32)) ()
  (:locals ($n i32))
  #@(local.set $n (i32.sub (local.get $width) (array.len (struct.get $obj $digits (local.get $text)))))
  #@(if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $n (i32.const 0))))
  #@(if (local.get $right) (then (call $format-repeat (local.get $pad) (local.get $n))))
  #@(call $print-text (local.get $text))
  #@(if (i32.eqz (local.get $right)) (then (call $format-repeat (local.get $pad) (local.get $n)))))

(define-runtime-function $format-aesthetic-radix (($object :nullable-object) ($radix i32)) ()
  (:locals ($saved :nullable-object))
  #@(local.set $saved (global.get $dynamic-variables))
  #@(global.set $dynamic-variables (call $bind (global.get $dynamic-variables)
    (call $symbol (i32.const ,(runtime-symbol-id '*print-base*))) (call $int (local.get $radix))))
  #@(global.set $dynamic-variables (call $bind (global.get $dynamic-variables)
    (call $symbol (i32.const ,(runtime-symbol-id '*print-radix*))) (ref.null $obj)))
  #@(block $failed (try_table (catch $transfer $failed)
    (call $print-aesthetic (local.get $object))
    (global.set $dynamic-variables (local.get $saved)) (return)))
  #@(global.set $dynamic-variables (local.get $saved)) #@(throw $transfer))

(define-runtime-function $format-integer
    (($x :nullable-object) ($radix i32) ($params (ref $objects)) ($offset i32) ($colon i32) ($at i32)) ()
  (:locals ($a :digits) ($i i32) ($n i32) ($interval i32) ($start i32) ($text :nullable-object) ($interval-object :nullable-object))
  (wat-fail-when #@(i32.or (i32.lt_u (local.get $radix) (i32.const 2)) (i32.gt_u (local.get $radix) (i32.const 36))) :malformed-form)
  #@(if (i32.ne (call $tag (local.get $x)) (i32.const 1))
    (then (call $format-aesthetic-radix (local.get $x) (local.get $radix)) (return)))
  #@(local.set $a (ref.as_non_null (struct.get $obj $digits
    (call $integer-text (ref.as_non_null (local.get $x)) (local.get $radix)))))
  #@(local.set $n (array.len (local.get $a)))
  #@(local.set $interval-object (array.get $objects (local.get $params) (i32.add (local.get $offset) (i32.const 3))))
  #@(local.set $interval (i32.const 3))
  #@(if (i32.eqz (ref.is_null (local.get $interval-object)))
    (then (local.set $interval (if (result i32)
      (i32.and (i32.eq (call $tag (local.get $interval-object)) (i32.const 1))
        (i32.gt_s (call $compare (ref.as_non_null (local.get $interval-object)) (call $int (local.get $n))) (i32.const 0)))
      (then (i32.add (local.get $n) (i32.const 1))) (else (call $format-small (local.get $interval-object)))))))
  (wat-fail-when #@(i32.le_s (local.get $interval) (i32.const 0)) :malformed-form)
  #@(local.set $start (global.get $cursor))
  #@(if (i32.lt_s (struct.get $obj $n (local.get $x)) (i32.const 0)) (then (call $emit-char (i32.const 45)))
    (else (if (local.get $at) (then (call $emit-char (i32.const 43))))))
  #@(loop $print
    (call $emit-char (array.get $digits (local.get $a) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (local.set $n (i32.sub (local.get $n) (i32.const 1)))
    (if (i32.and (local.get $colon) (i32.and (i32.ne (local.get $n) (i32.const 0)) (i32.eqz (i32.rem_u (local.get $n) (local.get $interval)))))
      (then (call $emit-char (call $format-param (local.get $params) (i32.add (local.get $offset) (i32.const 2)) (i32.const 44)))))
    (br_if $print (local.get $n)))
  #@(local.set $text (call $decode-text (local.get $start) (i32.sub (global.get $cursor) (local.get $start))))
  #@(global.set $cursor (local.get $start))
  #@(call $format-pad (local.get $text) (call $format-mincol (local.get $params) (local.get $offset))
    (call $format-param (local.get $params) (i32.add (local.get $offset) (i32.const 1)) (i32.const 32)) (i32.const 1)))

;; Reuse the free-format printer's decimal precision and exponent. This keeps
;; default FORMAT output consistent with WRITE without adding a second float
;; conversion algorithm; explicit precision uses exact rational rounding below.
(define-runtime-function $format-real-parts (($x :object)) (:object i32 i32)
  (:locals ($start i32) ($text :nullable-object) ($a :digits) ($i i32) ($c i32)
           ($whole i32) ($point i32) ($count i32) ($first i32) ($last i32) ($exponent i32) ($negative i32))
  #@(if (i32.lt_u (call $tag (local.get $x)) (i32.const 3))
    (then (local.set $x (call $float (i32.const 3) (call $coerce-float (local.get $x) (i32.const 3))))))
  #@(local.set $first (i32.const -1))
  #@(local.set $start (global.get $cursor))
  #@(call $print-float (local.get $x))
  #@(local.set $text (call $decode-text (local.get $start) (i32.sub (global.get $cursor) (local.get $start))))
  #@(global.set $cursor (local.get $start))
  #@(local.set $a (ref.as_non_null (struct.get $obj $digits (local.get $text))))
  #@(block $mantissa (loop $next
    (br_if $mantissa (i32.ge_u (local.get $i) (array.len (local.get $a))))
    (local.set $c (array.get $digits (local.get $a) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (if (i32.eq (local.get $c) (i32.const 45)) (then (br $next)))
    (if (i32.eq (local.get $c) (i32.const 46)) (then (local.set $point (i32.const 1)) (br $next)))
    (br_if $mantissa (i32.gt_u (i32.sub (local.get $c) (i32.const 48)) (i32.const 9)))
    (if (i32.eqz (local.get $point)) (then (local.set $whole (i32.add (local.get $whole) (i32.const 1)))))
    (if (i32.ne (local.get $c) (i32.const 48))
      (then (if (i32.lt_s (local.get $first) (i32.const 0)) (then (local.set $first (local.get $count))))
        (local.set $last (local.get $count))))
    (local.set $count (i32.add (local.get $count) (i32.const 1))) (br $next)))
  #@(block $exponent-done (loop $next
    (br_if $exponent-done (i32.ge_u (local.get $i) (array.len (local.get $a))))
    (local.set $c (array.get $digits (local.get $a) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (if (i32.eq (local.get $c) (i32.const 45)) (then (local.set $negative (i32.const 1)) (br $next)))
    (local.set $exponent (i32.add (i32.mul (local.get $exponent) (i32.const 10)) (i32.sub (local.get $c) (i32.const 48)))) (br $next)))
  #@(if (local.get $negative) (then (local.set $exponent (i32.sub (i32.const 0) (local.get $exponent)))))
  #@(if (i32.lt_s (local.get $first) (i32.const 0))
    (then (return (local.get $x) (i32.const 0) (i32.const 1))))
  #@(local.get $x)
  #@(i32.add (local.get $exponent) (i32.sub (i32.sub (local.get $whole) (i32.const 1)) (local.get $first)))
  #@(i32.add (i32.sub (local.get $last) (local.get $first)) (i32.const 1)))

(define-runtime-function $format-rounded (($x :object) ($scale i32) ($even i32)) (:object)
  (:locals ($a :object) ($b :object) ($q :object) ($r :object) ($comparison i32))
  (wat-fail-when #@(i32.gt_u (i32.add (local.get $scale) (i32.const 2000)) (i32.const 4000)) :unsupported)
  #@(local.set $a (call $rational (local.get $x)))
  #@(local.set $b (call $denominator (local.get $a)))
  #@(local.set $a (call $iabs (call $numerator (local.get $a))))
  #@(if (i32.ge_s (local.get $scale) (i32.const 0))
