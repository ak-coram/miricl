;;;; Target array upgrading rules, without host subtype/representation facts.
(in-package #:miricl-test)
(in-suite :miricl)

(defun array-upgrade-test-metadata (selector object argument)
  (case selector
    (0 (miricl-runtime:check-type-control-value object #'array-upgrade-test-metadata)
       (let ((expanded (or (cdr (assoc object argument :test #'equal)) object)))
         (miricl-runtime:check-type-control-value expanded #'array-upgrade-test-metadata)
         expanded))
    (1 (miricl-runtime:integer-type-query-value object nil (vector 0 nil argument)
                                              #'array-upgrade-test-metadata))
    (2 (miricl-runtime:integer-endpoint-compare-value object argument))
    (3 (list-length object))
    (4 (error 'simple-type-error :datum object :expected-type nil
              :format-control "Malformed type control, reason ~D."
              :format-arguments (list argument)))))

(defun array-upgrade-test-value (type &optional environment)
  (miricl-runtime:upgraded-array-kind-value type environment #'array-upgrade-test-metadata))

(test array-upgrade-port-target-specializations
  (dolist (case '((nil 3) (character 1) (base-char 1) (standard-char 1) (extended-char 3)
                  (bit 2) (t 0) (integer 0) (float 0)
                  ((integer 0 1) 2) ((integer 0 0) 2) ((integer 1 1) 2)
                  ((integer 1 0) 3) ((integer (0) (1)) 3)
                  ((integer (0) 1) 2) ((integer 0 (1)) 2)
                  ((integer 1/2 3/2) 2) ((integer * 1) 0) ((integer 0 *) 0)
                  ((integer -1 1) 0) ((integer 0 2) 0)
                  ((unsigned-byte 0) 2) ((unsigned-byte 1) 2) ((unsigned-byte 2) 0)
                  ((unsigned-byte 100000000000000000000000000000000000) 0)
                  ((signed-byte 1) 0) ((signed-byte 100000000000000000000000000000000) 0)
                  ((mod 1) 2) ((mod 2) 2) ((mod 3) 0)
                  ((member) 3) ((member 0 1 0) 2) ((eql 0) 2) ((eql 1) 2)
                  ((member #\a #\b) 1) ((eql #\a) 1)
                  ((member 0 #\a) 0) ((member 2) 0) ((member nil) 0)
                  ((or) 3) ((or bit character) 0) ((not t) 3) ((not nil) 0)
                  ((satisfies must-not-run) 0)))
    (is (= (second case) (array-upgrade-test-value (first case)))))
  (is (= 2 (array-upgrade-test-value 'local-bit '((local-bit . bit)))))
  (is (= 1 (array-upgrade-test-value '(local-char) '(((local-char) . character))))))

(test array-upgrade-port-malformed-recovery-and-opaque-data
  (dolist (type '((integer 0 1 extra) (signed-byte 1 extra) (unsigned-byte 1 extra)
                  (mod) (mod 1 2) (eql) (eql 0 1) (not) (not t t)
                  (integer 0 . bad) (member 0 . bad) (mod 0) (signed-byte 0)))
    (signals error (array-upgrade-test-value type))
    (is (= 2 (array-upgrade-test-value '(integer 0 1)))))
  (let ((type (list 'member 0)))
    (setf (cdr (cdr type)) (cdr type))
    (signals error (array-upgrade-test-value type)))
  (let ((type (list 'or nil)))
    (setf (second type) type)
    (signals simple-type-error (array-upgrade-test-value type)))
  (let ((value (list :literal)))
    (setf (cdr value) value)
    (is (= 0 (array-upgrade-test-value (list 'eql value))))
    (is (= 0 (array-upgrade-test-value (list 'member value))))
    (is (= 0 (array-upgrade-test-value (list 'opaque-type value)))))
  (let ((type (list 'or nil)))
    (setf (second type) type)
    (signals simple-type-error (array-upgrade-test-value 'expanded-cycle (list (cons 'expanded-cycle type))))))
