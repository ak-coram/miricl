;;;; FIND and POSITION on the current list/string representations.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $find-sequence-native
    (($mode i32) ($item :nullable-object) ($sequence :nullable-object) ($key :nullable-object)
     ($test :nullable-object) ($test-not :nullable-object) ($negate i32)
     ($start :nullable-object) ($end :nullable-object) ($from-end i32) ($position i32)) (:nullable-object)
  (:locals ($length i32) ($first i32) ($stop i32) ($remaining i32) ($index i32) ($i i32)
           ($string i32) ($vector i32) ($code i32) ($needle i32) ($fast-character i32) ($match i32)
           ($scan :nullable-object) ($value :nullable-object) ($function :nullable-object)
           ($buffer (ref null $objects)) ($source (ref null $digits)))
  #@(local.set $length (call $proper-sequence-length (local.get $sequence)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (call $bounded-index (local.get $start) (local.get $stop)))
  #@(local.set $remaining (i32.sub (local.get $stop) (local.get $first)))
  #@(if (i32.eqz (ref.is_null (local.get $key))) (then (local.set $key (call $callable (local.get $key)))))
  #@(local.set $function (call $callable
    (if (result (ref null $obj)) (local.get $mode) (then (local.get $item))
      (else (if (result (ref null $obj)) (local.get $negate)
        (then (local.get $test-not)) (else (local.get $test)))))))
  #@(if (i32.eqz (local.get $remaining)) (then (call $clear-values) (return (ref.null $obj))))
  #@(local.set $string (i32.eq (call $tag (local.get $sequence)) (i32.const 10)))
  #@(if (i32.and (local.get $string) (i32.and (i32.eqz (local.get $mode)) (ref.is_null (local.get $key))))
    (then (local.set $fast-character (call $sequence-character-kind (local.get $function)))
      (if (local.get $fast-character)
        (then (local.set $needle (call $sequence-character-needle (local.get $fast-character) (local.get $item)))))))
  #@(if (local.get $fast-character)
    (then
      (local.set $source (struct.get $obj $digits (local.get $sequence)))
      (local.set $index (call $sequence-character-scan (ref.as_non_null (local.get $source))
        (local.get $first) (local.get $stop) (local.get $needle)
        (i32.eq (local.get $fast-character) (i32.const 3)) (local.get $negate) (local.get $from-end) (i32.const 0)))
      (call $clear-values)
      (if (i32.lt_s (local.get $index) (i32.const 0)) (then (return (ref.null $obj))))
      (if (local.get $position) (then (return (call $int (local.get $index)))))
      (return (call $node (i32.const 16) (array.get $digits (local.get $source) (local.get $index))
        (ref.null $obj) (ref.null $obj) (ref.null $obj)))))
  #@(local.set $vector (i32.and (call $arrayp-native (local.get $sequence)) (i32.eqz (local.get $string))))
  #@(if (i32.eqz (i32.or (local.get $string) (local.get $vector)))
    (then
      (local.set $scan (local.get $sequence))
      (block $skipped (loop $skip (br_if $skipped (i32.eq (local.get $i) (local.get $first)))
        (local.set $scan (call $cdr (local.get $scan)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $skip)))
      (if (local.get $from-end)
        (then (local.set $buffer (call $sequence-list-buffer (local.get $scan) (local.get $remaining)))))))
  #@(local.set $index (select (i32.sub (local.get $stop) (i32.const 1)) (local.get $first) (local.get $from-end)))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $remaining)))
    (if (local.get $string)
      (then (local.set $value (call $node (i32.const 16)
        (array.get $digits (struct.get $obj $digits (local.get $sequence)) (local.get $index))
        (ref.null $obj) (ref.null $obj) (ref.null $obj))))
      (else (local.set $value (if (result (ref null $obj)) (local.get $vector)
        (then (call $sequence-value (local.get $sequence) (local.get $index)))
        (else (call $car (if (result (ref null $obj)) (local.get $from-end)
          (then (array.get $objects (local.get $buffer) (i32.sub (local.get $index) (local.get $first))))
          (else (local.get $scan)))))))))
    (local.set $match (call $sequence-item-match (local.get $mode) (local.get $item)
      (local.get $value) (local.get $key) (local.get $function) (local.get $negate)))
    (if (local.get $match)
      (then
        (call $clear-values)
        (if (local.get $position) (then (return (call $int (local.get $index)))))
        (return (local.get $value))))
    (if (i32.eqz (i32.or (i32.or (local.get $string) (local.get $vector)) (local.get $from-end)))
      (then (local.set $scan (call $cdr (local.get $scan)))))
    (local.set $index (i32.add (local.get $index) (select (i32.const -1) (i32.const 1) (local.get $from-end))))
    (local.set $remaining (i32.sub (local.get $remaining) (i32.const 1))) (br $next)))
  #@(call $clear-values)
  #@(ref.null $obj))

(define-runtime-section sequence-search-runtime-wat ()
  ($find-sequence-native))
