;;;; FIND and POSITION on the current list/string representations.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun $find-sequence-value-cl ()
  (runtime-function-definition '$find-sequence-value-cl
    (wat-fragment (miricl-cross:runtime-kernel-wat '$find-sequence-value-cl 'miricl-runtime:find-sequence-value))))

(define-runtime-function $find-sequence-native
    (($mode i32) ($item :nullable-object) ($sequence :nullable-object) ($key :nullable-object)
     ($test :nullable-object) ($test-not :nullable-object) ($negate i32)
     ($start :nullable-object) ($end :nullable-object) ($from-end i32) ($position i32)) (:nullable-object)
  (:locals ($length i32) ($first i32) ($stop i32) ($remaining i32) ($index i32)
           ($string i32) ($needle i32) ($fast-character i32)
           ($value :nullable-object) ($function :nullable-object) ($source (ref null $digits)))
  #@(local.set $length (call $proper-sequence-length (local.get $sequence)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (call $bounded-index (local.get $start) (local.get $stop)))
  #@(local.set $remaining (i32.sub (local.get $stop) (local.get $first)))
  #@(if (i32.eqz (ref.is_null (local.get $key))) (then (local.set $key (call $callable (local.get $key)))))
  #@(local.set $function (call $callable
    (if (result (ref null eq)) (local.get $mode) (then (local.get $item))
      (else (if (result (ref null eq)) (local.get $negate)
        (then (local.get $test-not)) (else (local.get $test)))))))
  #@(if (i32.eqz (local.get $remaining)) (then (call $clear-values) (return (ref.null eq))))
  #@(local.set $string (i32.eq (call $tag (local.get $sequence)) (i32.const 10)))
  #@(if (i32.and (local.get $string) (i32.and (i32.eqz (local.get $mode)) (ref.is_null (local.get $key))))
    (then (local.set $fast-character (call $sequence-character-kind (local.get $function)))
      (if (local.get $fast-character)
        (then (local.set $needle (call $sequence-character-needle (local.get $fast-character) (local.get $item)))))))
  #@(if (local.get $fast-character)
    (then
      (local.set $source (struct.get $obj $digits (ref.cast (ref $obj) (local.get $sequence))))
      (local.set $index (call $sequence-character-scan (ref.as_non_null (local.get $source))
        (local.get $first) (local.get $stop) (local.get $needle)
        (i32.eq (local.get $fast-character) (i32.const 3)) (local.get $negate) (local.get $from-end) (i32.const 0)))
      (call $clear-values)
      (if (i32.lt_s (local.get $index) (i32.const 0)) (then (return (ref.null eq))))
      (if (local.get $position) (then (return (call $int (local.get $index)))))
      (return (call $node (i32.const 16) (array.get $digits (local.get $source) (local.get $index))
        (ref.null eq) (ref.null eq) (ref.null eq)))))
  #@(local.set $value (call $find-sequence-value-cl (local.get $item) (local.get $sequence) (local.get $function)
    (call $vector-new (array.new_fixed $objects 4 (local.get $key) (call $int (local.get $first))
      (call $int (local.get $stop))
      (call $int (i32.or (local.get $mode) (i32.or (i32.shl (local.get $negate) (i32.const 2))
        (i32.or (i32.shl (local.get $from-end) (i32.const 3)) (i32.shl (local.get $position) (i32.const 4))))))))))
  #@(call $clear-values)
  #@(local.get $value))

(define-runtime-section sequence-search-runtime-wat ()
  ($find-sequence-value-cl) ($find-sequence-native))
