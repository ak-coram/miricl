;;;; Reader labels preserve sharing and repair recursive references before evaluation.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $source-aggregate-p (($x :nullable-object)) (i32)
  #@(i32.or (i32.or (i32.eq (call $tag (local.get $x)) (i32.const 7))
      (i32.eq (call $tag (local.get $x)) (i32.const 23)))
    (i32.le_u (i32.sub (call $tag (local.get $x)) (i32.const 34)) (i32.const 1))))

(define-runtime-function $source-replace-label
    (($root :nullable-object) ($placeholder :nullable-object)) ()
  (:locals ($stack :nullable-object) ($seen :nullable-object) ($value :nullable-object) ($part :nullable-object)
           ($data (ref $objects)) ($storage :nullable-object) ($i i32) ($tag i32))
  #@(local.set $seen (call $node (i32.const 29) (i32.const 0)
    (call $symbol (i32.const ,(runtime-symbol-id 'eq))) (ref.null $obj) (ref.null $obj)))
  #@(local.set $stack (call $cons (local.get $root) (ref.null $obj)))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $stack)))
    (local.set $value (call $car (local.get $stack)))
    (local.set $stack (call $cdr (local.get $stack)))
    (local.set $tag (call $tag (local.get $value)))
    (if (call $source-aggregate-p (local.get $value))
      (then (if (ref.is_null (call $hash-cell-native (local.get $value) (local.get $seen)))
        (then
          (drop (call $puthash-native (local.get $value) (local.get $seen) (ref.null $obj)))
          (if (i32.eq (local.get $tag) (i32.const 23))
            (then (local.set $storage (struct.get $obj $b (local.get $value)))
              (block $slots-done (loop $slots
                (br_if $slots-done (ref.is_null (local.get $storage)))
                (if (i32.eqz (ref.eq (call $car (local.get $storage)) ,(clos-library-reference '%layout)))
                  (then (local.set $part (call $car (call $cdr (local.get $storage))))
                    (if (ref.eq (local.get $part) (local.get $placeholder))
                      (then (struct.set $obj $a (call $cdr (local.get $storage)) (local.get $root)))
                      (else (if (call $source-aggregate-p (local.get $part))
                        (then (local.set $stack (call $cons (local.get $part) (local.get $stack)))))))))
                (local.set $storage (call $cdr (call $cdr (local.get $storage)))) (br $slots)))
              (br $next)))
          (if (i32.eq (local.get $tag) (i32.const 35))
            (then (local.set $stack (call $cons (struct.get $obj $a (local.get $value)) (local.get $stack))) (br $next)))
          (if (i32.eq (local.get $tag) (i32.const 7))
            (then
              ,@(loop for field in '($a $b) collect
                `(block $replaced
                   (local.set $part (struct.get $obj ,field (local.get $value)))
                   (if (ref.eq (local.get $part) (local.get $placeholder))
                     (then (struct.set $obj ,field (local.get $value) (local.get $root)) (br $replaced)))
                   (if (call $source-aggregate-p (local.get $part))
                     (then (local.set $stack (call $cons (local.get $part) (local.get $stack))))))))
            (else
              (local.set $data (call $vector-data (local.get $value))) (local.set $i (i32.const 0))
              (block $scanned (loop $scan (br_if $scanned (i32.eq (local.get $i) (array.len (local.get $data))))
                (local.set $part (array.get $objects (local.get $data) (local.get $i)))
                (if (ref.eq (local.get $part) (local.get $placeholder))
                  (then (array.set $objects (local.get $data) (local.get $i) (local.get $root)))
                  (else (if (call $source-aggregate-p (local.get $part))
                    (then (local.set $stack (call $cons (local.get $part) (local.get $stack)))))))
                (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $scan)))))))))
    (br $next))))

(define-runtime-function $source-label (($number :nullable-object) ($definition i32)) (:nullable-object)
  (:locals ($scan :nullable-object) ($entry :nullable-object) ($placeholder :nullable-object) ($value :nullable-object))
  #@(if (global.get $source-suppress)
    (then (return (if (result (ref null $obj)) (local.get $definition)
      (then (call $source-form)) (else (ref.null $obj))))))
  #@(local.set $scan (global.get $source-labels))
  #@(block $found (loop $find (br_if $found (ref.is_null (local.get $scan)))
    (local.set $entry (call $car (local.get $scan)))
    (if (call $eql (call $car (local.get $entry)) (local.get $number))
      (then (local.set $placeholder (call $cdr (local.get $entry))) (br $found)))
    (local.set $scan (call $cdr (local.get $scan))) (br $find)))
  #@(if (i32.eqz (local.get $definition))
    (then
      ,(wat-fail-when #@(ref.is_null (local.get $placeholder)) :reader-syntax)
      (block $unresolved (loop $alias
        (br_if $unresolved (i32.ne (struct.get $obj $n (local.get $placeholder)) (i32.const -1)))
        (local.set $value (struct.get $obj $a (local.get $placeholder)))
        (if (i32.ne (call $tag (local.get $value)) (i32.const 11)) (then (return (local.get $value))))
        (local.set $placeholder (local.get $value)) (br $alias)))
      (struct.set $obj $n (local.get $placeholder) (i32.const 1))
      (return (local.get $placeholder))))
  (wat-fail-when #@(i32.eqz (ref.is_null (local.get $placeholder))) :reader-syntax)
  #@(local.set $placeholder (call $node (i32.const 11) (i32.const 0) (ref.null $obj) (ref.null $obj) (ref.null $obj)))
  #@(global.set $source-labels (call $cons (call $cons (local.get $number) (local.get $placeholder)) (global.get $source-labels)))
  #@(local.set $value (call $source-form))
  #@(if (global.get $text-status) (then (return (ref.null $obj))))
  (wat-fail-when #@(ref.eq (local.get $value) (local.get $placeholder)) :reader-syntax)
  #@(if (struct.get $obj $n (local.get $placeholder))
    (then (call $source-replace-label (local.get $value) (local.get $placeholder))))
  #@(struct.set $obj $a (local.get $placeholder) (local.get $value))
  #@(struct.set $obj $n (local.get $placeholder) (i32.const -1))
  #@(local.get $value))

(define-runtime-section text-labels-wat ()
  #@(global $source-labels (mut (ref null $obj)) (ref.null $obj))
  ($source-aggregate-p) ($source-replace-label) ($source-label))
