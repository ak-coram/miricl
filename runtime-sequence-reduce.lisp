;;;; Native bounded reduction, retaining callback order and argument identity.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $reduce-combine
    (($function :nullable-object) ($a :nullable-object) ($b :nullable-object)) (:nullable-object)
  (:locals ($id i32))
  #@(local.set $id (i32.sub (call $value-n (local.get $function)) (i32.const 1)))
  ;; Recognize captured native function objects, independently of symbol cells.
  #@(if (i32.and (i32.ge_s (local.get $id) (i32.const ,(runtime-symbol-id '+)))
                 (i32.le_s (local.get $id) (i32.const ,(runtime-symbol-id '/))))
    (then (return (call $op (i32.sub (local.get $id) (i32.const ,(runtime-symbol-id '+)))
      (local.get $a) (local.get $b)))))
  #@(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'cons)))
    (then (return (call $cons (local.get $a) (local.get $b)))))
  ;; A callback can retain its &REST list. Allocate fresh arguments each time.
  #@(call $apply (local.get $function)
    (call $cons (local.get $a) (call $cons (local.get $b) (ref.null eq)))))

(define-runtime-function $reduce-apply (($args :nullable-object)) (:nullable-object)
  (:locals ($function :nullable-object) ($sequence :nullable-object) ($key :nullable-object)
           ($start :nullable-object) ($end :nullable-object) ($initial :nullable-object)
           ($scan :nullable-object) ($keyword :nullable-object) ($value :nullable-object)
           ($result :nullable-object) ($buffer (ref null $objects))
           ($seen i32) ($id i32) ($unknown i32) ($allow i32) ($reverse i32)
           ($length i32) ($first i32) ($stop i32) ($left i32) ($index i32) ($i i32) ($ready i32) ($string i32) ($vector i32))
  (wat-arity 2 2147483647)
  #@(local.set $function (call $car (local.get $args)))
  #@(local.set $sequence (call $car (call $cdr (local.get $args))))
  #@(local.set $scan (call $cdr (call $cdr (local.get $args))))
  #@(block $bound (loop $keys (br_if $bound (ref.is_null (local.get $scan)))
    (local.set $keyword (call $car (local.get $scan)))
    (local.set $scan (call $cdr (local.get $scan)))
    ,(wat-fail-when #@(ref.is_null (local.get $scan)) :wrong-arity)
    (local.set $value (call $car (local.get $scan)))
    (local.set $scan (call $cdr (local.get $scan)))
    (local.set $id (call $id (local.get $keyword)))
    ,(runtime-wat-forms
      (loop for (keyword variable) in '((:key $key) (:start $start) (:end $end)
                                       (:initial-value $initial) (:from-end $reverse) (:allow-other-keys $allow))
        for bit = 1 then (* bit 2) collect
        `(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id keyword)))
          (then
            (if (i32.eqz (i32.and (local.get $seen) (i32.const ,bit)))
              (then (local.set ,variable
                ,(if (member variable '($reverse $allow))
                     '(i32.eqz (ref.is_null (local.get $value))) '(local.get $value)))
                (local.set $seen (i32.or (local.get $seen) (i32.const ,bit)))))
            (br $keys)))))
    (local.set $unknown (i32.const 1)) (br $keys)))
  (wat-fail-when #@(i32.and (local.get $unknown) (i32.eqz (local.get $allow))) :wrong-arity)
  #@(local.set $length (call $proper-sequence-length (local.get $sequence)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (if (result i32) (i32.and (local.get $seen) (i32.const 2))
    (then (call $bounded-index (local.get $start) (local.get $stop))) (else (i32.const 0))))
  #@(local.set $left (i32.sub (local.get $stop) (local.get $first)))
  #@(local.set $function (call $callable (local.get $function)))
  #@(if (i32.eqz (ref.is_null (local.get $key))) (then (local.set $key (call $callable (local.get $key)))))
  #@(local.set $ready (i32.and (local.get $seen) (i32.const 8)))
  #@(local.set $result (local.get $initial))
  #@(if (i32.eqz (local.get $left))
    (then
      (if (i32.eqz (local.get $ready))
        (then (local.set $result (call $apply (local.get $function) (ref.null eq)))))
      (call $clear-values) (return (local.get $result))))
  #@(local.set $string (i32.eq (call $tag (local.get $sequence)) (i32.const 10)))
  #@(local.set $vector (i32.and (call $arrayp-native (local.get $sequence)) (i32.eqz (local.get $string))))
  #@(if (i32.eqz (i32.or (local.get $string) (local.get $vector)))
    (then
      (local.set $scan (local.get $sequence))
      (block $skipped (loop $skip (br_if $skipped (i32.eq (local.get $i) (local.get $first)))
        (local.set $scan (call $cdr (local.get $scan)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $skip)))
      (if (local.get $reverse)
        (then (local.set $buffer (call $sequence-list-buffer (local.get $scan) (local.get $left)))))))
  #@(local.set $index (select (i32.sub (local.get $stop) (i32.const 1)) (local.get $first) (local.get $reverse)))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $left)))
    (local.set $value (if (result (ref null eq)) (local.get $string)
      (then (call $node (i32.const 16)
        (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $sequence))) (local.get $index))
        (ref.null eq) (ref.null eq) (ref.null eq)))
      (else (if (result (ref null eq)) (local.get $vector)
        (then (call $sequence-value (local.get $sequence) (local.get $index)))
        (else (call $car (if (result (ref null eq)) (local.get $reverse)
          (then (array.get $objects (local.get $buffer) (i32.sub (local.get $index) (local.get $first))))
          (else (local.get $scan)))))))))
    (local.set $value (call $sequence-key-value (local.get $key) (local.get $value)))
    (if (local.get $ready)
      (then (local.set $result (if (result (ref null eq)) (local.get $reverse)
        (then (call $reduce-combine (local.get $function) (local.get $value) (local.get $result)))
        (else (call $reduce-combine (local.get $function) (local.get $result) (local.get $value))))))
      (else (local.set $result (local.get $value)) (local.set $ready (i32.const 1))))
    (if (i32.eqz (i32.or (i32.or (local.get $string) (local.get $vector)) (local.get $reverse)))
      (then (local.set $scan (call $cdr (local.get $scan)))))
    (local.set $index (i32.add (local.get $index) (select (i32.const -1) (i32.const 1) (local.get $reverse))))
    (local.set $left (i32.sub (local.get $left) (i32.const 1))) (br $next)))
  #@(call $clear-values)
  #@(local.get $result))

(define-runtime-section sequence-reduce-runtime-wat ()
  ($reduce-combine) ($reduce-apply))
