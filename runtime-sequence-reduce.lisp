;;;; Native bounded reduction, retaining callback order and argument identity.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun $reduce-sequence-cl ()
  (runtime-function-definition '$reduce-sequence-cl
    (wat-fragment (miricl-cross:runtime-kernel-wat '$reduce-sequence-cl 'miricl-runtime:reduce-sequence-value))))

(define-runtime-function $reduce-apply (($args :nullable-object)) (:nullable-object)
  (:locals ($function :nullable-object) ($sequence :nullable-object) ($key :nullable-object)
           ($start :nullable-object) ($end :nullable-object) ($initial :nullable-object)
           ($scan :nullable-object) ($keyword :nullable-object) ($value :nullable-object)
           ($result :nullable-object)
           ($seen i32) ($id i32) ($unknown i32) ($allow i32) ($reverse i32)
           ($length i32) ($first i32) ($stop i32))
  (wat-arity 2 2147483647)
  #@(local.set $function (call $car (local.get $args)))
  #@(local.set $sequence (call $car (call $cdr (local.get $args))))
  #@(local.set $scan (call $cdr (call $cdr (local.get $args))))
  #@(block $bound (loop $keys (br_if $bound (ref.is_null (local.get $scan)))
    (local.set $keyword (call $car (local.get $scan)))
    (local.set $scan (call $cdr (local.get $scan)))
    ,(wat-fail-when #@(ref.is_null (local.get $scan)) :wrong-arity)
    (local.set $value (call $car (local.get $scan)))
    (local.set $scan (call $cdr (local.get $scan)))
    (local.set $id (call $id (local.get $keyword)))
    ,(runtime-wat-forms
      (loop for (keyword variable) in '((:key $key) (:start $start) (:end $end)
                                       (:initial-value $initial) (:from-end $reverse) (:allow-other-keys $allow))
        for bit = 1 then (* bit 2) collect
        `(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id keyword)))
          (then
            (if (i32.eqz (i32.and (local.get $seen) (i32.const ,bit)))
              (then (local.set ,variable
                ,(if (member variable '($reverse $allow))
                     '(i32.eqz (ref.is_null (local.get $value))) '(local.get $value)))
                (local.set $seen (i32.or (local.get $seen) (i32.const ,bit)))))
            (br $keys)))))
    (local.set $unknown (i32.const 1)) (br $keys)))
  (wat-fail-when #@(i32.and (local.get $unknown) (i32.eqz (local.get $allow))) :wrong-arity)
  #@(local.set $length (call $proper-sequence-length (local.get $sequence)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (if (result i32) (i32.and (local.get $seen) (i32.const 2))
    (then (call $bounded-index (local.get $start) (local.get $stop))) (else (i32.const 0))))
  #@(local.set $function (call $callable (local.get $function)))
  #@(if (i32.eqz (ref.is_null (local.get $key))) (then (local.set $key (call $callable (local.get $key)))))
  #@(local.set $result (call $reduce-sequence-cl (local.get $function) (local.get $sequence) (local.get $key)
    (call $vector-new (array.new_fixed $objects 4 (call $int (local.get $first)) (call $int (local.get $stop))
      (local.get $initial)
      (call $int (i32.or (local.get $reverse)
        (i32.shr_u (i32.and (local.get $seen) (i32.const 8)) (i32.const 2))))))))
  #@(call $clear-values)
  #@(local.get $result))

(define-runtime-section sequence-reduce-runtime-wat ()
  ($reduce-sequence-cl) ($reduce-apply))
