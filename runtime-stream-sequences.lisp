;;;; Bulk character stream I/O shares bounded native sequence copying.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; MODE: READ-SEQUENCE=0, WRITE-SEQUENCE=1, WRITE-STRING=2, WRITE-LINE=3.
(define-runtime-function $stream-sequence-arguments
    (($args :nullable-object) ($mode i32)) (:nullable-object :nullable-object i32 i32)
  (:locals ($sequence :nullable-object) ($stream :nullable-object) ($start :nullable-object) ($end :nullable-object)
           ($keyword :nullable-object) ($value :nullable-object) ($seen i32) ($id i32) ($unknown i32) ($allow i32)
           ($length i32) ($first i32) ($stop i32))
  #@(if (i32.lt_u (local.get $mode) (i32.const 2)) (then ,(wat-arity 2 2147483647))
    (else ,(wat-arity 1 2147483647)))
  #@(local.set $sequence (call $car (local.get $args)))
  #@(local.set $args (call $cdr (local.get $args)))
  #@(if (i32.eqz (ref.is_null (local.get $args)))
    (then (local.set $stream (call $car (local.get $args))) (local.set $args (call $cdr (local.get $args)))))
  #@(local.set $start (call $int (i32.const 0)))
  #@(block $bound (loop $keys (br_if $bound (ref.is_null (local.get $args)))
    (local.set $keyword (call $car (local.get $args))) (local.set $args (call $cdr (local.get $args)))
    ,(wat-fail-when #@(ref.is_null (local.get $args)) :wrong-arity)
    (local.set $value (call $car (local.get $args))) (local.set $args (call $cdr (local.get $args)))
    (local.set $id (call $id (local.get $keyword)))
    ,(runtime-wat-forms
      (loop for (key variable) in '((:start $start) (:end $end) (:allow-other-keys $allow))
        for bit = 1 then (* bit 2) collect
        `(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id key)))
          (then (if (i32.eqz (i32.and (local.get $seen) (i32.const ,bit)))
            (then (local.set ,variable ,(if (eq variable '$allow) '(i32.eqz (ref.is_null (local.get $value))) '(local.get $value)))
              (local.set $seen (i32.or (local.get $seen) (i32.const ,bit))))) (br $keys)))))
    (local.set $unknown (i32.const 1)) (br $keys)))
  (wat-fail-when #@(i32.and (local.get $unknown) (i32.eqz (local.get $allow))) :wrong-arity)
  #@(if (i32.and (i32.ge_u (local.get $mode) (i32.const 2)) (i32.eqz (call $stringp-native (local.get $sequence))))
    (then (call $list-type-error (local.get $sequence) (i32.const ,(runtime-symbol-id 'string)))))
  #@(local.set $length (call $proper-sequence-length (local.get $sequence)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (call $bounded-index (local.get $start) (local.get $stop)))
  #@(local.get $sequence) #@(local.get $stream) #@(local.get $first) #@(local.get $stop))

;; Forward overlap must observe characters changed by earlier transfers, as
;; repeated READ-CHAR/WRITE-CHAR would. Ordinary disjoint strings use bulk copy.
(define-runtime-function $stream-forward-overlap
    (($target :nullable-object) ($source :nullable-object) ($to i32) ($from i32) ($count i32)) (i32)
  #@(if (i32.eqz (local.get $count)) (then (return (i32.const 0))))
  #@(block $target-done (loop $target (br_if $target-done (i32.ne (call $tag (local.get $target)) (i32.const 35)))
    (local.set $to (i32.add (local.get $to) (struct.get $array $offset (ref.cast (ref $array) (local.get $target)))))
    (local.set $target (struct.get $obj $a (ref.cast (ref $obj) (local.get $target)))) (br $target)))
  #@(block $source-done (loop $source (br_if $source-done (i32.ne (call $tag (local.get $source)) (i32.const 35)))
    (local.set $from (i32.add (local.get $from) (struct.get $array $offset (ref.cast (ref $array) (local.get $source)))))
    (local.set $source (struct.get $obj $a (ref.cast (ref $obj) (local.get $source)))) (br $source)))
  #@(i32.and (ref.eq (local.get $target) (local.get $source))
    (i32.and (i32.gt_u (local.get $to) (local.get $from))
             (i32.lt_u (local.get $to) (i32.add (local.get $from) (local.get $count))))))

(define-runtime-function $stream-sequence-text
    (($sequence :nullable-object) ($first i32) ($count i32)) (:nullable-object)
  (:locals ($data :digits) ($i i32) ($scan :nullable-object) ($value :nullable-object))
  #@(if (i32.eqz (local.get $count)) (then (return ,(wat-text-literal ""))))
  #@(if (call $stringp-native (local.get $sequence))
    (then
      (if (i32.eq (call $tag (local.get $sequence)) (i32.const 10))
        (then (if (i32.and (i32.eqz (local.get $first))
                    (i32.eq (local.get $count) (array.len (struct.get $obj $digits (ref.cast (ref $obj) (local.get $sequence))))))
          (then (return (local.get $sequence))))))
      (return (call $subsequence-native (local.get $sequence) (call $int (local.get $first))
        (call $int (i32.add (local.get $first) (local.get $count))) (ref.null eq) (i32.const 0)))))
  #@(local.set $data (array.new_default $digits (local.get $count)))
  #@(local.set $scan (local.get $sequence))
  #@(if (i32.eq (call $tag (local.get $sequence)) (i32.const 7))
    (then (block $positioned (loop $skip (br_if $positioned (i32.eq (local.get $i) (local.get $first)))
      (local.set $scan (call $cdr (local.get $scan))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $skip)))))
  #@(local.set $i (i32.const 0))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $count)))
    (local.set $value (if (result (ref null eq)) (i32.eq (call $tag (local.get $sequence)) (i32.const 7))
      (then (call $car (local.get $scan)))
      (else (call $array-raw-element (local.get $sequence) (i32.add (local.get $first) (local.get $i)) (ref.null eq) (i32.const 0)))))
    (array.set $digits (local.get $data) (local.get $i) (call $character-code (local.get $value)))
    (if (i32.eq (call $tag (local.get $sequence)) (i32.const 7)) (then (local.set $scan (call $cdr (local.get $scan)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(call $text (local.get $data)))

;; Binary transfer uses the file element width; character files decode UTF-8
;; once per character. List cursors advance linearly just as vector indices do.
(define-runtime-function $file-sequence
    (($sequence :nullable-object) ($stream :nullable-object) ($first i32) ($stop i32) ($write i32)) (i32)
  (:locals ($scan :nullable-object) ($value :nullable-object) ($index i32) ($list i32) ($binary i32) ($code i32))
  #@(local.set $list (i32.eq (call $tag (local.get $sequence)) (i32.const 7)))
  #@(local.set $binary (if (result i32) (local.get $write) (then (i32.const 1))
    (else (call $stream-binary-p (local.get $stream)))))
  #@(local.set $scan (local.get $sequence))
  #@(if (local.get $list)
    (then (block $positioned (loop $skip (br_if $positioned (i32.eq (local.get $index) (local.get $first)))
      (local.set $scan (call $cdr (local.get $scan)))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $skip)))))
  #@(local.set $index (local.get $first))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $index) (local.get $stop)))
    (if (local.get $write)
      (then
        (local.set $value (if (result (ref null eq)) (local.get $list)
          (then (call $car (local.get $scan)))
          (else (call $array-raw-element (local.get $sequence) (local.get $index) (ref.null eq) (i32.const 0)))))
        (drop (call $file-byte (local.get $stream) (local.get $value) (i32.const 1))))
      (else
        (if (local.get $binary)
          (then (local.set $value (call $stream-byte (local.get $stream)))
            (br_if $done (ref.is_null (local.get $value))))
          (else
            (local.set $code (call $stream-character (local.get $stream) (i32.const 0) (i32.const 1)))
            (br_if $done (i32.eq (local.get $code) (i32.const -1)))
            (local.set $value (call $node (i32.const 16) (local.get $code) (ref.null eq) (ref.null eq) (ref.null eq)))))
        (if (local.get $list)
          (then (struct.set $obj $a (ref.cast (ref $obj) (local.get $scan)) (local.get $value)))
          (else (drop (call $array-raw-element (local.get $sequence) (local.get $index) (local.get $value) (i32.const 1)))))))
    (if (local.get $list) (then (local.set $scan (call $cdr (local.get $scan)))))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next)))
  #@(local.get $index))

(define-runtime-function $write-stream-sequence
    (($sequence :nullable-object) ($stream :nullable-object) ($first i32) ($count i32) ($mode i32)) ()
  (:locals ($target :nullable-object) ($value :nullable-object) ($scan :nullable-object) ($i i32))
  #@(local.set $stream (call $stream-component (local.get $stream) (i32.const 0)))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 43))
    (then
      (local.set $scan (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream))))
      (block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
        (call $write-stream-sequence (local.get $sequence) (call $car (local.get $scan))
          (local.get $first) (local.get $count) (local.get $mode))
        (local.set $scan (call $cdr (local.get $scan))) (br $next)))
      (return)))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 44))
    (then
      (if (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 1))
        (then (drop (call $file-sequence (local.get $sequence) (local.get $stream) (local.get $first)
          (i32.add (local.get $first) (local.get $count)) (i32.const 1))))
        (else (call $write-destination (local.get $stream)
          (call $stream-sequence-text (local.get $sequence) (local.get $first) (local.get $count)))))
      (if (i32.eq (local.get $mode) (i32.const 3))
        (then (call $write-destination (local.get $stream) ,(wat-text-literal (string #\Newline)))))
      (return)))
  #@(drop (call $require-open-output-stream (local.get $stream)))
  #@(local.set $target (struct.get $obj $c (ref.cast (ref $obj) (local.get $stream))))
  #@(if (if (result i32) (i32.and (call $stringp-native (local.get $sequence)) (call $stringp-native (local.get $target)))
        (then (call $stream-forward-overlap (local.get $target) (local.get $sequence)
          (struct.get $array $fill (call $require-fill-pointer (local.get $target))) (local.get $first) (local.get $count)))
        (else (i32.const 0)))
    (then (block $done (loop $copy (br_if $done (i32.eq (local.get $i) (local.get $count)))
      (local.set $value (call $array-raw-element (local.get $sequence) (i32.add (local.get $first) (local.get $i)) (ref.null eq) (i32.const 0)))
      (call $write-destination (local.get $stream) (call $text (array.new_fixed $digits 1 (call $character-code (local.get $value)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy))))
    (else (call $write-destination (local.get $stream)
      (call $stream-sequence-text (local.get $sequence) (local.get $first) (local.get $count)))))
  #@(if (i32.eq (local.get $mode) (i32.const 3))
    (then (call $write-destination (local.get $stream) ,(wat-text-literal (string #\Newline))))))

(define-runtime-function $stream-sequence-apply (($args :nullable-object) ($mode i32)) (:nullable-object)
  (:locals ($sequence :nullable-object) ($stream :nullable-object) ($source :nullable-object)
           ($value :nullable-object) ($first i32) ($stop i32) ($count i32) ($position i32) ($available i32) ($i i32))
  #@(call $stream-sequence-arguments (local.get $args) (local.get $mode))
  #@(local.set $stop) #@(local.set $first) #@(local.set $stream) #@(local.set $sequence)
  #@(local.set $count (i32.sub (local.get $stop) (local.get $first)))
  #@(if (i32.eqz (local.get $mode))
    (then
      (call $require-stream (local.get $stream))
      (local.set $stream (call $input-stream-designator (local.get $stream)))
      (if (i32.ge_u (call $tag (local.get $stream)) (i32.const 44))
        (then (return (call $int (call $file-sequence (local.get $sequence) (local.get $stream)
          (local.get $first) (local.get $stop) (i32.const 0))))))
      (local.set $source (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream))))
      (local.set $position (call $value-n (local.get $stream)))
      (local.set $available (i32.sub (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 1)) (local.get $position)))
      (if (i32.gt_u (local.get $count) (local.get $available)) (then (local.set $count (local.get $available))))
      (if (if (result i32) (call $stringp-native (local.get $sequence))
            (then (call $stream-forward-overlap (local.get $sequence) (local.get $source) (local.get $first) (local.get $position) (local.get $count)))
            (else (i32.const 0)))
        (then (block $done (loop $copy (br_if $done (i32.eq (local.get $i) (local.get $count)))
          (local.set $value (call $array-raw-element (local.get $source) (i32.add (local.get $position) (local.get $i)) (ref.null eq) (i32.const 0)))
          (drop (call $array-raw-element (local.get $sequence) (i32.add (local.get $first) (local.get $i)) (local.get $value) (i32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy))))
        (else (call $copy-sequence-region (local.get $sequence) (local.get $source) (local.get $first) (local.get $position) (local.get $count))))
      (if (local.get $count) (then (call $commit-input-position (local.get $stream)
        (i32.add (local.get $position) (local.get $count)) (i32.sub (i32.add (local.get $position) (local.get $count)) (i32.const 1)))))
      (return (call $int (i32.add (local.get $first) (local.get $count))))))
  #@(if (i32.ge_u (local.get $mode) (i32.const 2))
    (then (local.set $stream (call $output-stream-designator (local.get $stream)))))
  #@(call $write-stream-sequence (local.get $sequence) (local.get $stream)
    (local.get $first) (local.get $count) (local.get $mode))
  #@(local.get $sequence))

(define-runtime-section stream-sequence-runtime-wat ()
  ($stream-sequence-arguments) ($stream-forward-overlap) ($stream-sequence-text)
  ($file-sequence) ($write-stream-sequence) ($stream-sequence-apply))
