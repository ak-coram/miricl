(define-runtime-function $stream-sequence-function (($index i32)) (:nullable-object)
  #@(if (ref.is_null (global.get $stream-sequence-functions))
    (then (global.set $stream-sequence-functions (call $vector-new
      (array.new_fixed $objects 15
        ,@(loop for name in '(length read-byte read-char write-byte write-char write-sequence write-string write-line
                             %%stream-sequence-metadata make-hash-table gethash (setf gethash) remhash eq error)
                for code = (cond ((eq name '%%stream-sequence-metadata)
                                  (+ +clos-primitive-base+ (clos-primitive-op name)))
                                 ((consp name) (- -1 (runtime-symbol-id (second name))))
                                 (t (1+ (runtime-symbol-id name))))
                collect `(call $node (i32.const 8) (i32.const ,code)
                           (ref.null eq) (ref.null eq) (ref.null eq))))))))
  #@(array.get $objects (call $vector-data (global.get $stream-sequence-functions)) (local.get $index)))

