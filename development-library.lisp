(defparameter %compiler-function-type '(or function null))
(defun %compiler-macro-lambda (name params body)
  (let ((whole (gensym)) (environment (gensym)))
    (list 'lambda (list whole environment)
      (list '%%apply
        (list 'function (%destructure-lambda params whole environment
          (apply #'%function-body name body)))
        (list 'if (list 'eq (list 'car whole) (list 'quote 'funcall))
          (list 'cddr whole) (list 'cdr whole))))))
(defmacro define-compiler-macro (name params &body body)
  (%%function-name-symbol name)
  (let ((doc nil) (declarations nil) (scanning t))
    (%%while (and scanning body)
      (cond ((and (not doc) (stringp (car body)) (cdr body)) (setq doc (pop body)))
            ((and (consp (car body)) (eq (caar body) 'declare)) (push (pop body) declarations))
            (t (setq scanning nil))))
    (let ((function (gensym)))
      (list 'let (list (list function
        (list 'function (%compiler-macro-lambda name params (append (reverse declarations) body)))))
        (list '%%function-documentation function doc t)
        (list 'setf (list 'compiler-macro-function (list 'quote name)) function)
        (list 'quote name)))))

(defmacro with-hash-table-iterator ((name table) &body body)
  (let ((state (gensym)))
    (list 'let (list (list state (list '%%hash-iterator-state table)))
      (list* 'macrolet (list (list name nil (list 'quote (list '%%hash-iterator-next state)))) body))))
(defmacro with-package-iterator ((name packages &rest symbol-types) &body body)
  (let ((state (gensym)) (mask 0))
    (unless symbol-types (error 'program-error))
    (dolist (type symbol-types)
      (setq mask (logior mask (case type (:internal 1) (:external 2) (:inherited 4)
                                     (otherwise (error 'program-error))))))
    (list 'let (list (list state (list '%%package-iterator-state packages mask)))
      (list* 'macrolet
        (list (list name nil (list 'quote (list '%%package-iterator-next state)))) body))))

;; This implementation currently defers no compiler diagnostics.
(defmacro with-compilation-unit ((&key override) &body body)
  (list* 'progn override (or body (list nil))))

