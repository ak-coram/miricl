    (if (and params (symbolp params))
        (progn
          (unless (<= (length body) 1) (error 'program-error))
          (list '%install-setf-expander (%quote name)
            (list 'function (list 'lambda (list place environment)
              (list 'declare (list 'ignore environment))
              (list '%short-defsetf (%quote name) (%quote params) place))) (car body)))
        (let ((stores (car body)) (store-names (gensym)) (temps (gensym))
              (parsed (apply #'%function-body name (cdr body))))
          (list '%install-setf-expander (%quote name)
            (list 'function (list 'lambda (list place environment)
              (list '%long-defsetf (%quote name)
                (list 'function (list 'lambda (list store-names temps environment)
                  (list 'destructuring-bind stores store-names
                    (list '%%apply (list 'function
                      (%destructure-lambda params place environment
                        (apply #'%function-body name (cdr body)))) temps))))
                (length stores) (%defsetf-key-start params) place environment)))
            (if (stringp (car parsed)) (car parsed) nil))))))
(defun %modify-function-place (place environment function arguments)
