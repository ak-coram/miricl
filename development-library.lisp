(defun get-setf-expansion (place &optional environment)
  ;; A global SETF expander takes precedence over an ordinary macro expansion.
  ;; Lexical function and macro bindings suppress that global definition.
  (when (and (consp place) (symbolp (car place)))
    (let ((expander (%%setf-expander nil (car place) nil environment)))
      (when expander (return-from get-setf-expansion (funcall expander place environment)))))
  (multiple-value-bind (expanded expandedp) (macroexpand place environment)
    (when expandedp (return-from get-setf-expansion (get-setf-expansion expanded environment))))
  (let ((store (gensym)))
    (if (symbolp place)
      (values nil nil (list store) (list 'setq place store) place)
      (if (eq (car place) 'the)
        (%the-place-expansion place environment)
      (if (eq (car place) 'values)
        (%values-place-expansion (cdr place) environment)
      (if (eq (car place) 'getf)
        (%getf-place-expansion place environment)
      (if (member (car place) '(ldb mask-field))
        (%byte-setf-expansion place environment)
      (if (eq (car place) 'apply)
        (%apply-place-expansion place)
        (let ((temps (%map (lambda (form) (gensym)) (cdr place))))
          (values temps (cdr place) (list store)
            (list* 'funcall (list 'function (list 'setf (car place))) store temps)
            (cons (car place) temps)))))))))))
