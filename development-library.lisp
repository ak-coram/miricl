        ((eq result-type 'character) (character object))
        ((eq result-type 'function)
         (if (and (consp object) (eq (car object) 'lambda))
             (eval (list 'function object))
           (progn
             (when (and (symbolp object) (or (macro-function object) (special-operator-p object)))
               (error 'type-error :datum object :expected-type 'function))
             (fdefinition object))))
        ((and (realp object) (member result-type '(float short-float single-float double-float long-float)))
         (cond ((eq result-type 'float) (float object))
               ((member result-type '(double-float long-float)) (float object 0.0d0))
               (t (float object 0.0))))
        ((and (realp object) (eq result-type 'complex)) (complex object))
        ((%sequence-result-type-p result-type)
         (let ((result (%%sequence-construction 3 (%sequence-result-kind result-type) (list object))))
           (unless (typep result result-type)
             (error 'type-error :datum object :expected-type result-type)) result))
        (t (error 'type-error :datum object :expected-type result-type))))
