;; Resolve macro and LOAD-TIME-VALUE references into compact executable forms.
;; Preserve lexical cells and literal identity when compiling existing closures.
(defun compile (name &optional (definition nil suppliedp))
  (when (and suppliedp (consp definition) (fboundp 'miricl-compiler::compiler-source-form))
    (miricl-compiler::compiler-source-form definition))
  (%%function-name-symbol name)
  (let* ((macro (and (symbolp name) (macro-function name)))
         (function
           (if suppliedp
               (progn
                 (unless (or (functionp definition)
                             (and (consp definition) (eq (car definition) 'lambda)))
                   (error 'type-error :datum definition :expected-type '(or function cons)))
                 (coerce definition 'function))
               (or macro (fdefinition name)))))
    (setq function (if (fboundp 'miricl-compiler::compile-minimal-function)
                       (miricl-compiler::compile-minimal-function function name)
                       (%%compile 0 function)))
    (when name
      (if macro (setf (macro-function name) function)
          (setf (fdefinition name) function)))
    (values (or name function) nil nil)))

;; Show the executable Lisp representation, or a native dispatch entry.
(defun %disassembly-lisp-size (source)
  ;; Measure the serialized code graph without compiling or bootstrapping the
  ;; compiler. This excludes the closure's environment and the FASL container.
  (let ((%fasl-records (make-array 16 :adjustable t :fill-pointer 0))
        (%fasl-seen (make-hash-table :test 'eq))
        (%file-load-values nil) (%file-object-effects nil)
        (%file-object-references nil) (%file-object-barriers nil))
    (%fasl-dump source)
    (length (%%compile 15 (coerce %fasl-records 'simple-vector) 0))))

(defun disassemble (fn)
  (let ((function
          (cond ((functionp fn) fn)
                ((and (consp fn) (eq (car fn) 'lambda)) (compile nil fn))
                (t (%%function-name-symbol fn) (fdefinition fn)))))
    (unless (eq function (%%generic-info function))
      (format t "~&; Generic function ~S~%" (generic-function-name function))
      (setq function (%get function :discriminating-function)))
    ;; Compile a temporary copy, leaving the named definition untouched.
    (unless (compiled-function-p function) (setq function (compile nil function)))
    (let ((code (%%compile 44 function)))
      (when code
        (miricl-compiler::disassemble-hir-code (car code) (cdr code))
        (return-from disassemble nil)))
    (multiple-value-bind (source closure name) (function-lambda-expression function)
      (let ((*print-readably* nil) (*print-circle* t)
            (*print-level* nil) (*print-length* nil))
        (format t "~&~S~%" (if source (list 'interpret source)
                                (list 'native-call (or name function))))
        (let ((size (if source (ignore-errors (%disassembly-lisp-size source))
                        (%%compile 26 function))))
          (cond (source
                 (if size (format t "; Packed Lisp code: ~D bytes (lexical environment excluded).~%" size)
                     (write-line "; Packed Lisp code size unavailable.")))
                (size (format t "; Wasm module: ~D bytes (literal data excluded).~%" size))
                (t (write-line "; Size unavailable for this runtime entry."))))
        (unless source
          (let ((code (%%compile 32 function)))
            ;; Compiler-free images retain the native entry and size display.
            (when (and code (fboundp 'miricl-compiler::disassemble-native))
              (miricl-compiler::disassemble-native (car code) (cdr code)))))
        (when closure (write-line "; Lexical environment retained."))))
    nil))

(defvar %traced-functions nil)
(defvar %trace-active nil)
(defvar %trace-depth 0)

(defun %trace-wrapper (name original)
  (lambda (&rest arguments)
    (if %trace-active
        (%%apply original arguments)
        (let ((depth (let ((%trace-active t)) (1+ %trace-depth))))
          (let ((%trace-active t) (*print-readably* nil) (*print-circle* t))
            (format *trace-output* "~&~D: Enter ~S ~S~%" depth name arguments))
          (let* ((%trace-depth depth)
                 (results (multiple-value-list (%%apply original arguments))))
            ;; Guard internal printing and value restoration too: FORMAT,
            ;; arithmetic, APPLY, and VALUES-LIST may themselves be traced.
            (let ((%trace-active t) (*print-readably* nil) (*print-circle* t))
              (format *trace-output* "~&~D: Return ~S ~S~%" depth name results)
              (values-list results)))))))

(defun %trace-names ()
  (let ((names nil))
    (dolist (entry %traced-functions)
      (when (and (fboundp (car entry))
                 (eq (fdefinition (car entry)) (third entry)))
        (push (car entry) names)))
    (nreverse names)))

(defun %trace-generic-discriminator (gf function)
  (setf (%get gf :untraced-discriminator) function)
  (let ((wrapper (%trace-wrapper (%get gf :trace-name)
                   (lambda (&rest args) (funcall function args)))))
    (lambda (args) (%%apply wrapper args))))

(defun %untrace-one (name)
  (%%function-name-symbol name)
  (let ((entry (assoc name %traced-functions :test #'equal)))
    ;; A definition installed after tracing belongs to the caller.
    (when entry
      (if (fourth entry)
          (let ((gf (second entry)))
            (setf (%get gf :trace-name) nil
                  (%get gf :discriminating-function) (%get gf :untraced-discriminator)
                  (%get gf :untraced-discriminator) nil))
          (when (and (fboundp name) (eq (fdefinition name) (third entry)))
            (setf (fdefinition name) (second entry))))
      (setq %traced-functions (delete entry %traced-functions :test #'eq))))
  name)

(defun %trace-one (name)
  (%%function-name-symbol name)
  (when (and (symbolp name) (or (macro-function name) (special-operator-p name)))
    (error "Cannot trace ~S as a function." name))
  (let ((entry (assoc name %traced-functions :test #'equal))
        (original (fdefinition name)))
    (unless (and entry (eq original (third entry)))
      (%untrace-one name)
      (if (eq original (%%generic-info original))
          (let ((wrapper (%trace-wrapper name original)))
            (setf (fdefinition name) wrapper)
            (push (list name original wrapper) %traced-functions))
          (progn
            (setf (%get original :trace-name) name
                  (%get original :untraced-discriminator) (%get original :discriminating-function))
            (%set-generic-discriminator original (%get original :discriminating-function))
            (push (list name original original t) %traced-functions)))))
  name)

(defmacro trace (&rest names)
  (if names
      (cons 'progn (append (%map (lambda (name) (list '%trace-one (%quote name))) names)
                           (list '(%trace-names))))
      '(%trace-names)))

(defmacro untrace (&rest names)
  (if names
      (cons 'progn (append (%map (lambda (name) (list '%untrace-one (%quote name))) names)
                           (list nil)))
      '(progn (dolist (entry (copy-list %traced-functions)) (%untrace-one (car entry))) nil)))

(defun room (&optional (verbosity :default))
  (unless (member verbosity '(nil :default t))
    (error 'type-error :datum verbosity :expected-type '(member nil :default t)))
  (multiple-value-bind (bytes symbols packages) (%%storage-state)
    (format t "~&Linear memory: ~D bytes (bootstrap data and transfer buffers).~%" bytes)
    (write-line "WasmGC heap: managed by the embedding engine; live byte count unavailable.")
    (when verbosity
      (format t "Symbol identities allocated: ~D.~%" symbols))
    (when (eq verbosity t)
      (format t "Packages: ~D. Class registry entries: ~D.~%" packages (length %classes))))
  (values))

(defun provide (module-name)
  (let ((name (string module-name)))
    (unless (member name *modules* :test #'string=) (push name *modules*))
    name))
(defun require (module-name &optional pathname-list)
  (let ((name (string module-name)))
    (unless (member name *modules* :test #'string=)
      ;; There is no implicit module search path. Explicit files use LOAD's
      ;; source registry and pathname handling, in the supplied order.
      (unless pathname-list (error "No files supplied for module ~S." name))
      (dolist (path (if (listp pathname-list) pathname-list (list pathname-list)))
        (load path)))
    nil))

