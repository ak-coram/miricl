    (dolist (place places)
      (multiple-value-bind (ts fs ss writer reader) (get-setf-expansion place environment)
        (setq temps (append temps ts) forms (append forms fs))
        (push (or (car ss) (gensym)) stores)
        (push (list 'let (mapcar #'list (cdr ss)) writer) writers)
        (push reader readers)))
    (setq stores (reverse stores))
    (values temps forms stores
      (cons 'progn (append (reverse writers) (list (cons 'values stores))))
      (cons 'values (reverse readers)))))
