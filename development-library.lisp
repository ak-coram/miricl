(defmacro psetf (&rest pairs &environment environment)
  (let ((frames nil) (writers nil))
    (%%while pairs
      (unless (cdr pairs) (error 'program-error))
      (multiple-value-bind (temps forms stores writer reader) (get-setf-expansion (car pairs) environment)
        (declare (ignore reader))
        (push (list temps forms stores (cadr pairs)) frames)
        (push writer writers))
      (setq pairs (cddr pairs)))
    (let ((body (cons 'progn (append (reverse writers) (list nil)))))
      (dolist (frame frames body)
        (setq body (list 'let* (mapcar #'list (car frame) (cadr frame))
          (list 'multiple-value-bind (caddr frame) (cadddr frame) body)))))))
(defun %shift-places (places newvalue environment shifting)
  (let ((bindings nil) (stores nil) (readers nil) (writers nil))
    (dolist (place places)
      (multiple-value-bind (temps forms ss writer reader) (get-setf-expansion place environment)
        (setq bindings (append bindings (mapcar #'list temps forms)))
        (push ss stores) (push reader readers) (push writer writers)))
    (setq stores (reverse stores) readers (reverse readers) writers (reverse writers))
    (if shifting
      (let ((old (gensym)))
        (list 'let* (append bindings (list (list old (list 'multiple-value-list (car readers)))))
          (%bind-place-values (mapcar #'list stores (append (cdr readers) (list newvalue)))
            (cons 'progn (append writers (list (list 'values-list old)))))))
      (list 'let* bindings
        (%bind-place-values (mapcar #'list (append (last stores) (butlast stores)) readers)
          (cons 'progn (append writers (list nil))))))))
