(defvar %describe-depth 0)
(defun %describe-default (object stream)
  (format stream "~S~%  Type: ~S~%" object (type-of object))
  (when (symbolp object)
    (when (boundp object) (format stream "  Value: ~S~%" (symbol-value object)))
    (when (fboundp object) (format stream "  Function: ~S~%" (fdefinition object))))
  (when (functionp object)
    (multiple-value-bind (source closure name) (function-lambda-expression object)
      (format stream "  Name: ~S~%  Closure: ~S~%" name closure)
      (when source (format stream "  Lambda: ~S~%" source))))
  nil)
(defgeneric describe-object (object stream))
(defmethod describe-object ((object t) stream) (%describe-default object stream))
(defmethod describe-object ((object standard-object) stream) (%describe-default object stream))
(defun describe (object &optional (stream *standard-output*))
  (setq stream (if (eq stream t) *terminal-io* (or stream *standard-output*)))
  (unless (%output-stream-p stream)
    (error 'type-error :datum stream :expected-type '(satisfies %output-stream-p)))
  (fresh-line stream)
  (if (or (member object %describe-stack :test #'eq) (>= %describe-depth 4))
      (progn (when %describe-stack (write-string "  " stream))
        (write-string "#<Description truncated>" stream) (terpri stream))
      (let ((text
              (let ((%describe-stack (cons object %describe-stack)) (%describe-depth (1+ %describe-depth))
                    (*print-readably* nil) (*print-circle* t) (*print-level* 3) (*print-length* 10))
                (with-output-to-string (buffer) (describe-object object buffer))))
            (start t))
        ;; Each intermediate description contributes one indentation level.
        (dotimes (i (length text))
          (when (and start %describe-stack) (write-string "  " stream))
          (let ((character (char text i)))
            (write-char character stream) (setq start (char= character #\Newline))))))
  (values))

(defun %variable-definition-form (form parameterp)
  (let* ((args (cdr form)) (count (length args)) (name (car args))
         (quoted (list 'quote name)) (forms nil))
    (unless (and (<= (if parameterp 2 1) count 3)
                 (symbolp name) (not (constantp name)))
      (error 'program-error))
    (setq forms (list (list 'declaim (list 'special name))))
    (when (= count 3)
      (unless (stringp (third args))
        (error 'type-error :datum (third args) :expected-type 'string))
      (setq forms (append forms
        (list (list 'setf (list 'documentation quoted (list 'quote 'variable)) (third args))))))
    (when (>= count 2)
      (let ((assignment (list 'setf (list 'symbol-value quoted) (second args))))
        (setq forms (append forms
          (list (if parameterp assignment (list 'unless (list 'boundp quoted) assignment)))))))
    (cons 'progn (append forms (list quoted)))))

(setf (macro-function 'defvar)
  (%%builtin-macro 'defvar (lambda (form environment) (declare (ignore environment)) (%variable-definition-form form nil)))
      (macro-function 'defparameter)
  (%%builtin-macro 'defparameter (lambda (form environment) (declare (ignore environment)) (%variable-definition-form form t)))
      (macro-function 'destructuring-bind)
  (lambda (form environment) (declare (ignore environment))
    (apply '%destructuring-form (cdr form)))
      (macro-function 'in-package)
  (%%builtin-macro 'in-package
    (lambda (form environment) (declare (ignore environment))
      (destructuring-bind (name) (cdr form)
        (list 'eval-when '(:compile-toplevel :load-toplevel :execute)
          (list 'setq '*package* (list 'find-package (list 'quote name))))))))

(setf (macro-function 'defun)
  (%%builtin-macro 'defun
    (lambda (form environment) (declare (ignore environment))
      (destructuring-bind (name params &rest body) (cdr form)
        (%%function-name-symbol name)
        (list 'progn
          (list 'setf (list 'fdefinition (list 'quote name))
            (list 'function (list* 'lambda params (apply '%function-body name body))))
          (list 'quote name)))))
      (macro-function 'defmacro)
  (lambda (form environment) (declare (ignore environment))
    (destructuring-bind (name params &rest body) (cdr form)
      (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
      (list 'eval-when '(:compile-toplevel :load-toplevel :execute)
        (list 'progn
          (list 'setf (list 'macro-function (list 'quote name)) (apply '%macro-lambda name params body))
          (list 'quote name))))))

(setf (macro-function 'multiple-value-bind)
  (%%builtin-macro 'multiple-value-bind
    (lambda (form environment) (declare (ignore environment))
      (destructuring-bind (variables value &rest body) (cdr form)
        (let ((scan variables) (seen nil) (rest (gensym)))
          (%%while scan
            (let ((name (pop scan)))
              (unless (and (symbolp name) (not (constantp name))
                           (not (member name lambda-list-keywords)) (not (member name seen)))
                (error 'program-error))
              (push name seen)))
          (list 'multiple-value-call
            (list 'function
              (list 'lambda (append (list '&optional) variables (list '&rest rest))
                (list 'declare (list 'ignore rest)) (cons 'locally body)))
            value))))))

(setf (macro-function 'setf)
  (%%builtin-macro 'setf
    (lambda (form environment)
      (let ((pairs (cdr form)) (forms nil))
        (%%while pairs
          (let ((place (pop pairs)))
            (unless pairs (error 'program-error))
            (let ((value (pop pairs)))
              (multiple-value-bind (temps values stores writer reader)
                  (get-setf-expansion place environment)
                (declare (ignore reader))
                (push (list 'let* (mapcar #'list temps values)
                        (list 'multiple-value-bind stores value writer)) forms)))))
        (if forms (cons 'progn (reverse forms)) nil)))))

(setf (macro-function 'defconstant)
  (lambda (form environment) (declare (ignore environment))
    (destructuring-bind (name value &optional (documentation nil documentedp)) (cdr form)
      (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
      (when (and documentedp (not (stringp documentation)))
        (error 'type-error :datum documentation :expected-type 'string))
      (list 'eval-when '(:compile-toplevel :load-toplevel :execute)
        (cons 'progn
          (append
            (when documentedp
              (list (list 'setf (list 'documentation (list 'quote name) (list 'quote 'variable)) documentation)))
            (list (list '%%define-constant (list 'quote name) value))))))))

;; The interpreter's native condition frame is also the expansion target.
;; Capturing NAME keeps a copied expander independent of its new macro name.
(defun %condition-form-expander (name minimum maximum)
  (lambda (form environment) (declare (ignore environment))
    (let ((count (length (cdr form))))
      (unless (and (>= count minimum) (or (not maximum) (<= count maximum)))
        (error 'program-error)))
    (list* '%%condition-form name (cdr form))))
(let ((specifications '((define-condition 3 nil) (handler-bind 1 nil) (handler-case 1 nil)
                       (ignore-errors 0 nil) (restart-bind 1 nil) (restart-case 1 nil)
                       (with-simple-restart 1 nil) (with-condition-restarts 2 nil)
                       (assert 1 nil) (check-type 2 3))))
  (%%while specifications
    (let* ((specification (pop specifications)) (name (car specification)))
      (setf (macro-function name)
        (%%builtin-macro name (apply '%condition-form-expander specification))))))

(setf (macro-function 'defpackage)
  (%%builtin-macro 'defpackage
    (lambda (form environment) (declare (ignore environment))
      (destructuring-bind (name &rest options) (cdr form)
        (list 'eval-when '(:compile-toplevel :load-toplevel :execute)
          (list '%%define-package (list 'quote name) (list 'quote options)))))))

(defun %condition-parent-names (type)
  (cond ((and (%classp type) (subtypep type 'condition)) (list (class-name type)))
        ((and (symbolp type) (find-class type nil) (subtypep type 'condition)) (list type))
        ((and (consp type) (eq (car type) 'and))
         (let ((parents nil) (parts (cdr type)))
           (%%while parts (setq parents (append parents (%condition-parent-names (pop parts)))))
           parents))
        ((and (consp type) (eq (car type) 'or))
         (let ((parts (cdr type)))
           (%%while parts
             (let ((part (pop parts)))
               (when (and part (subtypep part 'condition))
                 (return-from %condition-parent-names (%condition-parent-names part)))))
           (error 'program-error)))
        (t (error 'program-error))))
(defun %compound-condition-name (type)
  ;; Subsequent calls find this concrete class during the native subtype scan.
  (let ((name (make-symbol "COMPOUND-CONDITION"))
        (parents (%unique (%condition-parent-names type))))
    (unless parents (error 'program-error))
    (%%eval (list 'define-condition name parents nil))
    name))
