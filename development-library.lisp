(defun %long-defsetf (name writer count key-start place environment)
  (let* ((forms (cdr place)) (temps (%map (lambda (form) (declare (ignore form)) (gensym)) forms))
         (stores (loop repeat count collect (gensym))) (arguments (copy-list temps)))
    (when key-start
      (let ((keys (nthcdr (min key-start (length forms)) forms))
            (names (nthcdr (min key-start (length arguments)) arguments)))
        (%%while keys
          (setf (car names) (car keys))
