;; Macro lambda lists become ordinary closures. Destructuring is expressed
;; using the private argument binder, so dotted destructuring data need not
;; satisfy public APPLY's proper-list requirement. Defaults and supplied-p variables use the same
;; argument binder as ordinary functions.
(defun %function-body (name &rest body)
  (let ((doc nil) (decls nil) (scanning t))
    (%%while (and scanning body)
      (cond ((and (consp (car body)) (eq (caar body) 'declare)) (push (pop body) decls))
            ((and (not doc) (stringp (car body)) (cdr body)) (setq doc (pop body)))
            (t (setq scanning nil))))
    (append (if doc (list doc) nil) (reverse decls)
      (list (list* 'block (if (symbolp name) name (cadr name)) body)))))
(defun %destructure-lambda (params whole environment body &optional type-defaults)
  (let ((ordinary nil) (bindings nil) (prefix nil) (whole-bindings nil) (mode nil))
    (%%while (consp params)
      (let ((spec (pop params)))
        (cond
          ((eq spec '&whole)
           (let ((target (pop params)))
             (if (listp target)
                 (let ((temp (gensym)))
                   (push (list temp whole) prefix)
                   (push (list target temp) whole-bindings))
                 (push (list target whole) prefix))))
          ((eq spec '&environment) (push (list (pop params) environment) prefix))
          ((or (eq spec '&body) (eq spec '&rest)) (push '&rest ordinary) (setq mode '&rest))
          ((%member spec '(&optional &key &aux &allow-other-keys))
           (push spec ordinary) (unless (eq spec '&allow-other-keys) (setq mode spec)))
          (t
           (let* ((compound (and (%member mode '(&optional &key &aux)) (consp spec)))
                  (target (if compound (car spec) spec))
                  (key nil))
             (when (and (eq mode '&key) (consp target))
               (setq key (car target) target (cadr target)))
             ;; A later default can refer to variables introduced by an
             ;; earlier pattern. Bind its raw argument first and defer the
             ;; default until the enclosing destructuring bindings exist.
             (if (and bindings (%member mode '(&optional &key &aux)))
                 (let* ((raw (gensym)) (present (gensym))
                        (init (if (and compound (cdr spec)) (cadr spec)
                                  (if type-defaults (list 'quote '*) nil)))
                        (supplied (and compound (caddr spec))))
                   (push (list target (if (eq mode '&aux) init
                                         (list 'if present raw init))) bindings)
                   (when supplied (push (list supplied present) bindings))
                   (when (and (eq mode '&key) (not key))
                     (setq key (intern (symbol-name target) :keyword)))
                   (setq target raw compound t
                         spec (if (eq mode '&aux) (list raw nil) (list raw nil present))))
                 (when (listp target)
                 (let ((temp (gensym)))
                   (push (list target temp) bindings)
                   (setq target temp))))
             (when key (setq target (list key target)))
             (push (if (and type-defaults (%member mode '(&optional &key)))
                       (cons target (if (and compound (cdr spec)) (cdr spec) (list (list 'quote '*))))
                       (if compound (cons target (cdr spec)) target)) ordinary))))))
    (when params (push '&rest ordinary) (push params ordinary))
    ;; Wrap from right to left so earlier bindings enclose later defaults.
    (%%while bindings
      (let* ((binding (pop bindings)) (target (car binding)) (value (cadr binding)))
        (setq body (list (if (listp target)
          (list '%%apply (list 'function (%destructure-lambda target value environment body type-defaults)) value)
          (list* 'let (list (list target value)) body))))))
    (let ((function (list* 'lambda (reverse ordinary) body)))
      (if prefix
        (let* ((args (gensym)) (call (list '%%apply (list 'function function) args)))
          ;; &WHOLE bindings, including patterns, precede parameter defaults.
          (%%while whole-bindings
            (let ((binding (pop whole-bindings)))
              (setq call (list '%%apply
                (list 'function (%destructure-lambda (car binding) (cadr binding)
                                  environment (list call) type-defaults))
                (cadr binding)))))
          (list 'lambda (list '&rest args)
            (list 'let* (reverse prefix) call)))
        function))))
(defun %macro-lambda (name params &rest body)
  (when (and (null params) (consp body) (null (cdr body))
             (consp (car body)) (eq (caar body) 'quote)
             (consp (cdar body)) (null (cddar body)))
    (return-from %macro-lambda
      (list '%%constant-macro-function (car body))))
  (let ((whole (gensym)) (environment (gensym))
        (parsed (apply #'%function-body name body)) (doc nil))
    (when (and (cdr parsed) (stringp (car parsed))) (setq doc (pop parsed)))
    (list* 'lambda (list whole environment)
      (append (if doc (list doc) nil)
        (list (list '%%apply (list 'function (%destructure-lambda params whole environment parsed))
          (list 'cdr whole)))))))
(defun %deftype-lambda (name params body)
  (let ((whole (gensym)) (environment (gensym)))
    (list 'lambda (list whole environment)
      (list '%%apply
        (list 'function (%destructure-lambda params whole environment
          (apply #'%function-body name body) t)) (list 'cdr whole)))))
(defmacro deftype (name params &body body)
  (let ((documentation nil) (declarations nil) (scanning t))
    (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
    (%%while (and scanning body)
      (cond ((and (not documentation) (stringp (car body)) (cdr body))
             (setq documentation (pop body)))
            ((and (consp (car body)) (eq (caar body) 'declare)) (push (pop body) declarations))
            (t (setq scanning nil))))
    (list '%%derived-type 1 (list 'quote name)
      (list 'function (%deftype-lambda name params (append (reverse declarations) body))) documentation)))
(defun %destructuring-form (params value &rest body)
  (let ((temp (gensym)))
    (list 'let (list (list temp value))
      (list '%%apply (list 'function (%destructure-lambda params temp nil body)) temp))))

