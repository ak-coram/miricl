      (let ((param (pop scan)))
        (cond ((eq param '&optional) nil)
              ((eq param '&rest) (setq rest (pop scan)))
              (t (push (if (symbolp param) param (car param)) arguments)))))
    (append (list 'defmacro name (append (list place '&environment environment) params))
      (if documentation (list documentation) nil)
      (list (list '%modify-function-place place environment (%quote function)
        (if rest (list 'append (cons 'list (reverse arguments)) rest)
            (cons 'list (reverse arguments))))))))
(defun %the-place-expansion (place environment)
  (unless (= (length place) 3) (error 'program-error))
  (multiple-value-bind (temps forms stores writer reader) (get-setf-expansion (caddr place) environment)
    (values temps forms stores
      (list 'multiple-value-bind stores (list 'the (cadr place) (cons 'values stores)) writer)
      (list 'the (cadr place) reader))))
(defun %values-place-expansion (places environment)
