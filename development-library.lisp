    (unless stores (error 'program-error))
    (let ((indicator (gensym)) (default (gensym)) (new (gensym)))
      (values (append temps (list indicator default))
        (append forms (list (caddr place) (cadddr place))) (list new)
        (list 'let (cons (list (car stores) (list '%%property-list-edit reader indicator new nil))
                        (mapcar #'list (cdr stores))) writer new)
