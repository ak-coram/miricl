  (let ((function (cadr place)) (forms (cddr place)) (store (gensym)))
    (unless (and (consp function) (eq (car function) 'function)
                 (symbolp (cadr function)) (= (length function) 2) forms)
      (error 'program-error))
    (let ((temps (%map (lambda (form) (declare (ignore form)) (gensym)) forms)))
      (values temps forms (list store)
        (list* 'apply (list 'function (list 'setf (cadr function))) store temps)
        (list* 'apply function temps)))))
(defun %install-setf-expander (name function &optional (documentation (documentation function 'function)))
  (%%setf-expander t name function nil)
  (setf (get name '%setf-documentation) documentation)
  name)
(defmacro define-setf-expander (name params &body body)
  (list '%install-setf-expander (%quote name)
    (list 'function (apply #'%macro-lambda name params body))))
(defun %short-defsetf (name update place)
