(defun %upgraded-complex-part-type (type environment)
  (setq type (%%derived-type 2 type environment nil))
  (when (%classp type) (setq type (class-name type)))
  (when (and (consp type) (eq (car type) 'eql))
    (unless (realp (cadr type)) (error "Not a real component type: ~S" type))
    (return-from %upgraded-complex-part-type
      (upgraded-complex-part-type (type-of (cadr type)) environment)))
  (when (and (consp type) (member (car type) '(or member)))
    (let ((result nil))
      (dolist (part (cdr type))
        (let ((upgraded (upgraded-complex-part-type
                         (if (eq (car type) 'member) (list 'eql part) part) environment)))
          (when upgraded
            (setq result (cond ((not result) upgraded) ((eq result upgraded) result)
                              ((or (member result '(rational real)) (member upgraded '(rational real))) 'real)
                              (t 'float))))))
      (return-from %upgraded-complex-part-type result)))
  (cond ((subtypep type nil environment) nil)
        ((subtypep type 'rational environment) 'rational)
        ((subtypep type 'single-float environment) 'single-float)
        ((subtypep type 'double-float environment) 'double-float)
        ((subtypep type 'float environment) 'float)
        ((subtypep type 'real environment) 'real)
        (t (error "Not a real component type: ~S" type))))
