;; Portable source pathnames. Filesystem access is confined to mounted sources.
(defun pathnamep (object) (= (%%tag object) 28))
(defun %standard-dispatch-function (code)
  (lambda (stream character argument) (%%reader-dispatch-sub stream code character argument)))
(defun %namestring (object) (if (stringp object) object (namestring (pathname object))))
(defun namestring (object) (%%raw-class (pathname object)))
(defun parse-namestring (thing &optional host (default-pathname *default-pathname-defaults*)
                               &key (start 0) end junk-allowed)
  ;; Mounted source paths use a local, hostless physical namestring syntax.
  ;; Parsing does not merge directory/name/type components from the defaults.
  (declare (ignore junk-allowed))
  (when (and host (not (%logical-host-entry host))) (error 'parse-error))
  (pathname default-pathname)
  (unless (typep start '(integer 0 *))
    (error 'type-error :datum start :expected-type '(integer 0 *)))
  (if (pathnamep thing)
      (values thing start)
      (progn
        (unless (stringp thing)
          (error 'type-error :datum thing :expected-type '(or string pathname)))
        (let ((stop (or end (length thing))))
          (let* ((text (subseq thing start stop))
                 (logical-host (or host (and (typep (pathname default-pathname) 'logical-pathname)
                                            (pathname-host default-pathname)))))
            (values (if logical-host (%parse-logical text logical-host) (pathname text)) stop))))))
(defun %string-slice (string start end)
  (subseq string start end))
(defun %last-char-position (character string)
  (position character string :from-end t))
(defun directory-namestring (path)
  (let* ((p (pathname path)) (string (namestring p)) (logical (typep p 'logical-pathname))
         (start (if logical (1+ (position #\: string)) 0))
         (slash (%last-char-position (if logical #\; #\/) string)))
    (%string-slice string start (if slash (1+ slash) start))))
(defun file-namestring (path)
  (let* ((p (pathname path)) (string (namestring p)) (logical (typep p 'logical-pathname))
         (slash (%last-char-position (if logical #\; #\/) string)))
    (%string-slice string (if slash (1+ slash) (if logical (1+ (position #\: string)) 0)) (length string))))
(defun %pathname-wild-component (string &optional directoryp)
  (cond ((string= string "*") :wild)
        ((and directoryp (string= string "**")) :wild-inferiors) (t string)))
(defun %pathname-component-string (component)
  (cond ((eq component :wild) "*") ((eq component :wild-inferiors) "**") (t component)))
(defun %pathname-name (path)
  (let* ((file (file-namestring path)) (dot (%last-char-position #\. file)))
    (unless (string= file "") (%pathname-wild-component (%string-slice file 0 (or dot (length file)))))))
(defun %pathname-type (path)
  (let* ((file (file-namestring path)) (dot (%last-char-position #\. file)))
    (when dot (%pathname-wild-component (%string-slice file (1+ dot) (length file))))))
(defun %pathname-directory (path)
  (let* ((directory (directory-namestring path)) (parts nil) (start 0))
    (loop for i below (length directory)
      when (eql (char directory i) #\/)
      do (when (> i start) (push (%pathname-wild-component (%string-slice directory start i) t) parts)) (setq start (1+ i)))
    (when (> (length directory) 0)
      (cons (if (eql (char directory 0) #\/) :absolute :relative) (reverse parts)))))
(defun compile-file-pathname (input-file &key (output-file nil output-file-p) &allow-other-keys)
  (let* ((input (merge-pathnames input-file))
         (default (make-pathname :defaults input :type "wasm"
                    :name (or (pathname-name input) (pathname-name *default-pathname-defaults*)))))
    (if output-file-p
        (let ((output (merge-pathnames output-file default)))
          (make-pathname :defaults output
            :name (or (pathname-name output) (pathname-name default))
            :type (or (pathname-type output) (pathname-type default))))
        default)))
(defun probe-file (path)
  (let ((name (%source-path path)))
    (when (wild-pathname-p path) (error 'file-error :pathname path))
    (let ((directory (%%filesystem 4 name nil)))
      (when (or directory (%%source-file-p name))
        (pathname (format nil "/~A~A" name (if (and directory (not (string= name ""))) "/" "")))))))
(defun truename (path) (or (probe-file path) (error 'file-error :pathname path)))
(defun directory (pathspec &key)
  (let ((merged (merge-pathnames pathspec)))
    (let ((pattern (make-pathname :defaults merged
        :name (or (pathname-name merged) (pathname-name *default-pathname-defaults*))
        :type (or (pathname-type merged) (pathname-type *default-pathname-defaults*)))))
      (%%directory (%canonical-path pattern) (string= (file-namestring pattern) "")))))

;; Source paths are portable names in an explicitly mounted virtual filesystem.
(defun %canonical-path (path)
  (when (or (pathnamep path) (and (stringp path) (%logical-string-host path)))
    (setq path (translate-logical-pathname path)))
  (setq path (%namestring path))
  (let ((parts nil) (start 0) (i 0) (size (length path)))
    (%%while (<= i size)
      (when (or (= i size) (eql (char path i) #\/))
        (let ((part (format nil "~{~A~}" (loop for j from start below i collect (char path j)))))
          (cond ((or (string= part "") (string= part ".")))
                ((string= part "..") (if parts (pop parts) (error 'file-error :pathname path)))
                (t (push part parts))))
        (setq start (1+ i)))
      (incf i))
    (format nil "~{~A~^/~}" (reverse parts))))
(defun %source-path (path)
  (cond ((typep path 'file-stream) (%%filesystem 3 path t))
        ((typep path 'synonym-stream) (%source-path (symbol-value (synonym-stream-symbol path))))
        (t (%canonical-path (translate-logical-pathname (merge-pathnames path))))))
(defun %absolute-source-path (path) (pathname (concatenate 'string "/" path)))

(defun %load-options (&key (verbose *load-verbose*) (print *load-print*)
                          (if-does-not-exist t) external-format)
  (list verbose print if-does-not-exist))
(defun %load-message (path verbose)
  (when verbose (format *standard-output* "~&; Loading ~A~%" path)))

;; Stream loading shares READ's native context preservation. In particular a
;; reader macro can recursively LOAD without disturbing the surrounding reader.
(defun %load-stream (stream options)
  (let* ((*package* *package*) (*readtable* *readtable*)
         (*load-pathname* (when (typep stream 'file-stream) (merge-pathnames stream)))
         (*load-truename* (when *load-pathname* (truename stream)))
         (eof (list nil)))
    (%load-message stream (first options))
    (loop for form = (read stream nil eof) until (eq form eof) do
      (let ((value (eval form))) (when (second options) (print value))))
    t))

(defun %featurep (expression)
  (if (symbolp expression) (not (not (member expression *features*)))
    (cond ((eq (car expression) :and) (every #'%featurep (cdr expression)))
          ((eq (car expression) :or) (some #'%featurep (cdr expression)))
          ((eq (car expression) :not)
           (unless (= (length expression) 2) (error 'reader-error))
           (not (%featurep (cadr expression))))
          (t (error 'reader-error)))))

(defvar %debug-default-level 1)
(defvar %safety-default-level 1)
(defparameter %debug-declaration '(declare (optimize (debug 3))))

(defun %optimize-debug-level (qualities inherited)
  ;; DEBUG 2 retains native instructions; DEBUG 3 enables interactive debugging.
  (dolist (quality qualities inherited)
    (let ((name (if (consp quality) (first quality) quality))
          (level (if (consp quality) (second quality) 3)))
      (unless (and (symbolp name) (integerp level) (<= 0 level 3)
                   (or (atom quality) (= (length quality) 2)))
        (error 'program-error))
      (when (eq name 'debug) (setq inherited level)))))

(defun %body-debug-level (body &optional inherited)
  (when (and (stringp (car body)) (cdr body)) (setq body (cdr body)))
  (loop while (and (consp (car body)) (eq (caar body) 'declare)) do
    (dolist (spec (cdar body))
      (when (eq (car spec) 'optimize)
        (setq inherited (%optimize-debug-level (cdr spec) inherited))))
    (setq body (cdr body)))
  inherited)

(defun %optimize-safety-level (qualities inherited)
  ;; The shared validator accepts only ANSI optimization quality levels.
  (%optimize-debug-level qualities 1)
  (dolist (quality qualities inherited)
    (when (eq (if (consp quality) (first quality) quality) 'safety)
      (setq inherited (if (consp quality) (second quality) 3)))))

(defun %debug-form-p (form)
  ;; An interpreted debug region cannot expose a containing native frame.
  ;; Select interpretation for the containing evaluation as well. Quoted data
  ;; is never a request to change evaluation policy.
  (and (consp form) (not (eq (car form) 'quote))
    (if (eq (car form) 'declare) (eql (%body-debug-level (list form)) 3)
        ;; Source trees include dotted destructuring lists and macro data.
        ;; Walk their cons cells without treating an atomic tail as a sequence.
        (loop for tail = form then (cdr tail) while (consp tail)
              thereis (%debug-form-p (car tail))))))

(defun %proclaim-all (specs)
  (%%while specs
    (let ((spec (pop specs)))
      (unless (and (consp spec) (symbolp (car spec)) (list-length spec))
        (error 'program-error))
      (case (car spec)
        ((miricl-compiler:start-block miricl-compiler:end-block)
          (when (and (boundp '%file-compiling) %file-compiling (fboundp '%file-block-declaration))
            (%file-block-declaration spec)))
        (optimize
          (let ((debug (%optimize-debug-level (cdr spec) %debug-default-level))
                (safety (%optimize-safety-level (cdr spec) %safety-default-level)))
            (setq %debug-default-level debug %safety-default-level safety)))
        (special
          (let ((names (cdr spec)))
            (%%while names (%%proclaim-variable (pop names)))))
        (declaration
          (dolist (name (cdr spec))
            (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
            (when (%declaration-type-name-p name) (error 'program-error))
            (setf (get name '%declaration-name) t)))))) nil)

(defun %declaration-type-name-p (name)
  (or (%%derived-type 0 name nil nil) (find-class name nil)
      (nth-value 1 (subtypep name nil))))
(defun %declaration-type-p (name)
  (cond ((or (consp name) (%classp name)) t)
        ((get name '%declaration-name) nil)
        ((%declaration-type-name-p name) t)
        (t (warn "Unknown declaration ~S." name) nil)))

(defun proclaim (declaration-specifier)
  (%proclaim-all (list declaration-specifier)))

(defmacro with-output-to-string ((var &optional (string nil stringp) &key (element-type ''character)) &body body)
  (let* ((declarations nil) (target (and stringp string)) (temp (and target (gensym "STRING-"))))
    (%%while (and (consp (car body)) (eq (caar body) 'declare))
      (push (car body) declarations) (setq body (cdr body)))
    (cons 'let* (cons (if target
        (list (list temp string) (list var (list '%%string-stream 0 element-type temp)))
        (list (list var (list 'make-string-output-stream :element-type element-type))))
      (append (reverse declarations)
        (list (list 'unwind-protect
          (if target (cons 'progn body)
            (list 'progn (cons 'progn body) (list 'get-output-stream-string var)))
          (list 'close var))))))))

(defmacro with-input-from-string ((var string &key (start 0) end (index nil indexp)) &body body)
  (let ((declarations nil))
    (%%while (and (consp (car body)) (eq (caar body) 'declare))
      (push (car body) declarations) (setq body (cdr body)))
    (cons 'let (cons (list (list var (list 'make-string-input-stream string start end)))
      (append (reverse declarations)
        (list (list 'unwind-protect
          (if indexp (list 'multiple-value-prog1 (cons 'progn body)
            (list 'setf index (list '%%input-position var))) (cons 'progn body))
          (list 'close var))))))))

