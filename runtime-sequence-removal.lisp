;;;; Bounded removal for lists and strings, with native matching and copying.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $copy-with-removals
    (($sequence :nullable-object) ($length i32) ($first i32) ($stop i32)
     ($marks :digits) ($removed i32) ($write i32)) (:nullable-object)
  (:locals ($vector i32) ($indexed i32) ($string i32) ($i i32) ($index i32) ($keep i32) ($out i32)
           ($scan :nullable-object) ($next :nullable-object) ($head :nullable-object)
           ($tail :nullable-object) ($cell :nullable-object) ($data (ref null $digits)))
  #@(call $clear-values)
  #@(if (i32.eqz (local.get $removed)) (then (return (local.get $sequence))))
  #@(local.set $string (i32.eq (call $tag (local.get $sequence)) (i32.const 10)))
  #@(local.set $vector (i32.and (call $arrayp-native (local.get $sequence)) (i32.eqz (local.get $string))))
  #@(local.set $indexed (i32.or (local.get $string) (local.get $vector)))
  #@(if (local.get $vector)
    (then (local.set $head (call $sequence-allocate-like (local.get $sequence) (i32.sub (local.get $length) (local.get $removed))))))
  #@(if (local.get $string)
    (then (local.set $data (array.new_default $digits (i32.sub (local.get $length) (local.get $removed))))))
  #@(local.set $scan (local.get $sequence))
  #@(block $done (loop $copy (br_if $done (i32.eq (local.get $i) (local.get $length)))
    (local.set $keep (i32.const 1))
    (if (i32.and (i32.ge_u (local.get $i) (local.get $first)) (i32.lt_u (local.get $i) (local.get $stop)))
      (then (local.set $index (i32.sub (local.get $i) (local.get $first)))
        (local.set $keep (i32.eqz (i32.and
          (array.get $digits (local.get $marks) (i32.shr_u (local.get $index) (i32.const 5)))
          (i32.shl (i32.const 1) (i32.and (local.get $index) (i32.const 31))))))))
    (if (i32.eqz (local.get $indexed)) (then (local.set $next (call $cdr (local.get $scan)))))
    (if (local.get $keep)
      (then
        (if (local.get $string)
          (then (array.set $digits (local.get $data) (local.get $out)
            (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $sequence))) (local.get $i)))
            (local.set $out (i32.add (local.get $out) (i32.const 1))))
          (else (if (local.get $vector)
            (then (drop (call $array-raw-element (local.get $head) (local.get $out)
              (call $sequence-value (local.get $sequence) (local.get $i)) (i32.const 1)))
              (local.set $out (i32.add (local.get $out) (i32.const 1))))
            (else
            (local.set $cell (if (result (ref null eq)) (local.get $write) (then (local.get $scan))
              (else (call $cons (call $car (local.get $scan)) (ref.null eq)))))
            (if (ref.is_null (local.get $tail)) (then (local.set $head (local.get $cell)))
              (else (struct.set $obj $b (ref.cast (ref $obj) (local.get $tail)) (local.get $cell))))
            (local.set $tail (local.get $cell))))))))
    (local.set $scan (local.get $next))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
  #@(if (local.get $vector) (then (return (local.get $head))))
  #@(if (local.get $string) (then (return (call $text (ref.as_non_null (local.get $data))))))
  #@(if (i32.eqz (ref.is_null (local.get $tail))) (then (struct.set $obj $b (ref.cast (ref $obj) (local.get $tail)) (ref.null eq))))
  #@(local.get $head))

;; Apply selected substitutions after matching. The destructive variants only
;; replace CARs or array elements; list spines and displaced storage stay intact.
(define-runtime-function $copy-with-substitutions
    (($sequence :nullable-object) ($first i32) ($stop i32) ($marks :digits)
     ($changed i32) ($write i32) ($new :nullable-object)) (:nullable-object)
  (:locals ($result :nullable-object) ($scan :nullable-object) ($i i32) ($index i32) ($array i32))
  #@(call $clear-values)
  #@(if (i32.eqz (local.get $changed)) (then (return (local.get $sequence))))
  #@(local.set $result (local.get $sequence))
  #@(if (i32.eqz (local.get $write))
    (then (local.set $result (call $subsequence-native (local.get $sequence) (call $int (i32.const 0))
      (ref.null eq) (ref.null eq) (i32.const 0)))))
  #@(local.set $array (call $arrayp-native (local.get $result)))
  #@(local.set $scan (local.get $result))
  #@(if (i32.eqz (local.get $array))
    (then (block $positioned (loop $skip (br_if $positioned (i32.eq (local.get $i) (local.get $first)))
      (local.set $scan (call $cdr (local.get $scan)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $skip)))))
  #@(local.set $i (local.get $first))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $stop)))
    (local.set $index (i32.sub (local.get $i) (local.get $first)))
    (if (i32.and (array.get $digits (local.get $marks) (i32.shr_u (local.get $index) (i32.const 5)))
                (i32.shl (i32.const 1) (i32.and (local.get $index) (i32.const 31))))
      (then
        (if (local.get $array)
          (then (drop (call $array-raw-element (local.get $result) (local.get $i) (local.get $new) (i32.const 1))))
          (else (struct.set $obj $a (ref.cast (ref $obj) (local.get $scan)) (local.get $new))))))
    (if (i32.eqz (local.get $array)) (then (local.set $scan (call $cdr (local.get $scan)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(local.get $result))

(define-runtime-function $remove-sequence-native
    (($mode i32) ($item :nullable-object) ($sequence :nullable-object) ($key :nullable-object)
     ($test :nullable-object) ($test-not :nullable-object) ($negate i32)
     ($start :nullable-object) ($end :nullable-object) ($from-end i32)
     ($count :nullable-object) ($write i32) ($new :nullable-object) ($substitute i32)) (:nullable-object)
  (:locals ($length i32) ($first i32) ($stop i32) ($selected i32) ($limit i32)
           ($reverse i32) ($string i32) ($vector i32) ($remaining i32) ($i i32) ($index i32)
           ($removed i32) ($match i32) ($code i32) ($needle i32) ($fast-character i32)
           ($scan :nullable-object) ($value :nullable-object) ($function :nullable-object)
           ($marks (ref $digits)) ($buffer (ref null $objects)))
  #@(local.set $length (call $proper-sequence-length (local.get $sequence)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (call $bounded-index (local.get $start) (local.get $stop)))
  #@(local.set $selected (i32.sub (local.get $stop) (local.get $first)))
  #@(local.set $limit (local.get $selected))
  #@(if (i32.eqz (ref.is_null (local.get $count)))
    (then
      (if (i32.ne (call $tag (local.get $count)) (i32.const 1))
        (then (call $type-fail (local.get $count)
          (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'or)))
            (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'integer)))
              (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'null))) (ref.null eq))))
          (i32.const ,(runtime-error-code :expected-designator)))))
      (local.set $limit (if (result i32) (i32.lt_s (call $value-n (local.get $count)) (i32.const 0))
        (then (i32.const 0)) (else (call $natural-count (local.get $count)))))
      (if (i32.gt_u (local.get $limit) (local.get $selected)) (then (local.set $limit (local.get $selected))))))
  #@(if (i32.eqz (ref.is_null (local.get $key))) (then (local.set $key (call $callable (local.get $key)))))
  #@(local.set $function (call $callable
    (if (result (ref null eq)) (local.get $mode) (then (local.get $item))
      (else (if (result (ref null eq)) (local.get $negate)
        (then (local.get $test-not)) (else (local.get $test)))))))
  #@(if (i32.eqz (local.get $limit))
    (then (call $clear-values) (return (local.get $sequence))))
  #@(local.set $string (i32.eq (call $tag (local.get $sequence)) (i32.const 10)))
  #@(local.set $reverse (i32.and (local.get $from-end)
    (i32.or (local.get $substitute) (i32.eqz (ref.is_null (local.get $count))))))
  #@(if (i32.and (local.get $string) (i32.and (i32.eqz (local.get $mode)) (ref.is_null (local.get $key))))
    (then (local.set $fast-character (call $sequence-character-kind (local.get $function)))
      (if (local.get $fast-character)
        (then (local.set $needle (call $sequence-character-needle (local.get $fast-character) (local.get $item)))))))
  ;; One bit per selected position; predicates run before DELETE relinks cells.
  #@(local.set $marks (array.new_default $digits (i32.shr_u (i32.add (local.get $selected) (i32.const 31)) (i32.const 5))))
  #@(local.set $vector (i32.and (call $arrayp-native (local.get $sequence)) (i32.eqz (local.get $string))))
  #@(if (i32.eqz (i32.or (local.get $string) (local.get $vector)))
    (then
      (local.set $scan (local.get $sequence))
      (block $skipped (loop $skip (br_if $skipped (i32.eq (local.get $i) (local.get $first)))
        (local.set $scan (call $cdr (local.get $scan)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $skip)))
      (if (local.get $reverse)
        (then (local.set $buffer (call $sequence-list-buffer (local.get $scan) (local.get $selected)))))))
  #@(local.set $index (select (i32.sub (local.get $selected) (i32.const 1)) (i32.const 0) (local.get $reverse)))
  #@(local.set $remaining (local.get $selected))
  #@(block $marked (loop $mark
    (br_if $marked (i32.or (i32.eqz (local.get $remaining)) (i32.eq (local.get $removed) (local.get $limit))))
    (if (local.get $string)
      (then (local.set $code (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $sequence)))
        (i32.add (local.get $first) (local.get $index)))))
      (else (local.set $value (if (result (ref null eq)) (local.get $vector)
        (then (call $sequence-value (local.get $sequence) (i32.add (local.get $first) (local.get $index))))
        (else (call $car (if (result (ref null eq)) (local.get $reverse)
          (then (array.get $objects (local.get $buffer) (local.get $index))) (else (local.get $scan)))))))))
    (if (local.get $fast-character)
      (then
        (if (i32.eq (local.get $fast-character) (i32.const 3))
          (then (local.set $code (call $string-upcase-code (local.get $code)))))
        (local.set $match (i32.eq (local.get $needle) (local.get $code)))
        (local.set $match (i32.xor (local.get $match) (local.get $negate))))
      (else
        (if (local.get $string) (then (local.set $value (call $node (i32.const 16) (local.get $code)
          (ref.null eq) (ref.null eq) (ref.null eq)))))
        (local.set $match (call $sequence-item-match (local.get $mode) (local.get $item)
          (local.get $value) (local.get $key) (local.get $function) (local.get $negate)))))
    (if (local.get $match)
      (then (local.set $i (i32.shr_u (local.get $index) (i32.const 5)))
        (array.set $digits (local.get $marks) (local.get $i)
          (i32.or (array.get $digits (local.get $marks) (local.get $i))
            (i32.shl (i32.const 1) (i32.and (local.get $index) (i32.const 31)))))
        (local.set $removed (i32.add (local.get $removed) (i32.const 1)))))
    (if (i32.eqz (i32.or (i32.or (local.get $string) (local.get $vector)) (local.get $reverse)))
      (then (local.set $scan (call $cdr (local.get $scan)))))
    (local.set $index (i32.add (local.get $index) (select (i32.const -1) (i32.const 1) (local.get $reverse))))
    (local.set $remaining (i32.sub (local.get $remaining) (i32.const 1))) (br $mark)))
  #@(if (local.get $substitute)
    (then (return (call $copy-with-substitutions (local.get $sequence) (local.get $first) (local.get $stop)
      (local.get $marks) (local.get $removed) (local.get $write) (local.get $new)))))
  #@(call $copy-with-removals (local.get $sequence) (local.get $length) (local.get $first) (local.get $stop)
    (local.get $marks) (local.get $removed) (local.get $write)))

(define-runtime-section sequence-removal-runtime-wat ()
  ($copy-with-removals) ($copy-with-substitutions) ($remove-sequence-native))
