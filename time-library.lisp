;;;; Gregorian calendar arithmetic is exact, including bignum years.
;;;; The virtual Lisp environment uses UTC unless an explicit zone is supplied.
(defconstant internal-time-units-per-second 1000)
(defparameter %month-days (vector 0 31 59 90 120 151 181 212 243 273 304 334 365))
(defparameter %leap-month-days (vector 0 31 60 91 121 152 182 213 244 274 305 335 366))
(defun %calendar-months (year)
  (if (and (zerop (mod year 4)) (or (not (zerop (mod year 100))) (zerop (mod year 400))))
      %leap-month-days %month-days))
(defun %days-before-year (year)
  (let ((previous (1- year)))
    (+ (* 365 previous) (floor previous 4) (- (floor previous 100)) (floor previous 400))))
(defun %time-zone-p (zone)
  (and (typep zone '(rational -24 24)) (integerp (* zone 3600))))
(defun %time-zone-seconds (zone)
  (unless (%time-zone-p zone)
    (error 'type-error :datum zone :expected-type '(and (rational -24 24) (satisfies %time-zone-p))))
  (* zone 3600))
(defun %decode-universal-time (time time-zone)
  (check-type time (integer 0 *))
  (multiple-value-bind (days clock) (floor (- time (%time-zone-seconds time-zone)) 86400)
    (let* ((absolute (+ days 693595)) (year (1+ (floor (* absolute 400) 146097)))
           (month 12))
      (loop while (> (%days-before-year year) absolute) do (decf year))
      (loop while (<= (%days-before-year (1+ year)) absolute) do (incf year))
      (let ((day (- absolute (%days-before-year year))) (months (%calendar-months year)))
        (loop while (< day (svref months (1- month))) do (decf month))
        (values (mod clock 60) (mod (floor clock 60) 60) (floor clock 3600)
          (1+ (- day (svref months (1- month)))) month year (mod days 7) nil time-zone)))))
(defun %encode-universal-time (second minute hour date month year time-zone)
  (check-type second (integer 0 59)) (check-type minute (integer 0 59))
  (check-type hour (integer 0 23)) (check-type month (integer 1 12))
  (check-type date (integer 1 31)) (check-type year (integer 0 *))
  (when (< year 100)
    (let ((start (- (nth-value 5 (get-decoded-time)) 50)))
      (setq year (+ start (mod (- year start) 100)))))
  (let ((months (%calendar-months year)))
    (unless (<= date (- (svref months month) (svref months (1- month)))) (error 'error))
    (let ((time (+ (* (+ (- (%days-before-year year) 693595)
                         (svref months (1- month)) (1- date)) 86400)
                   (* hour 3600) (* minute 60) second (%time-zone-seconds time-zone))))
      (when (minusp time) (error 'error)) time)))

(defun decode-universal-time (time &optional (time-zone 0)) (%%calendar 0 time time-zone))
(defun encode-universal-time (second minute hour date month year &optional (time-zone 0))
  (%%calendar 1 (list second minute hour date month year) time-zone))

(defun get-universal-time () (values (floor (%%host-service 0 0))))
(defun get-decoded-time () (decode-universal-time (get-universal-time)))
(defun get-internal-real-time () (values (floor (%%host-service 1 0))))
(defun get-internal-run-time () (values (floor (%%host-service 2 0))))
(defun sleep (seconds)
  (check-type seconds (real 0 *))
  ;; Bound host timer conversions without losing large integer/rational
  ;; durations or repeatedly subtracting below a large float's precision.
  (when (> seconds 86400)
    (setq seconds (rational seconds))
    (loop while (> seconds 86400) do (%%host-service 3 86400000) (decf seconds 86400)))
  (when (plusp seconds) (%%host-service 3 (* seconds 1000))) nil)
(defmacro time (form)
  (let ((real (gensym)) (run (gensym)))
    (list 'let (list (list real '(get-internal-real-time)) (list run '(get-internal-run-time)))
      (list 'multiple-value-prog1 form
        (list 'format '*trace-output* "~&; ~D ms real time, ~D ms run time.~%"
          (list '- '(get-internal-real-time) real) (list '- '(get-internal-run-time) run))))))
