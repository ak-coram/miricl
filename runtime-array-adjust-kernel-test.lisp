;;;; Explicit target storage model; host array upgrading is never a type fact.
(in-package #:miricl-test)
(in-suite :miricl)
(defvar *array-adjust-test-kinds* (make-hash-table :test #'eq))
(defvar *array-adjust-test-parents* (make-hash-table :test #'eq))
(defun array-adjust-test-array (dimensions &key (kind 0) adjustable fill (initial nil))
  (let ((array (make-array dimensions :element-type (case kind (1 'character) (2 'bit) (t t))
                          :adjustable adjustable :fill-pointer fill
                          :initial-element (case kind (1 (or initial #\a)) (2 (or initial 0)) (t initial)))))
    (setf (gethash array *array-adjust-test-kinds*) kind)
    array))
(defun array-adjust-test-metadata (selector object argument)
  (labels ((kind (array) (gethash array *array-adjust-test-kinds* 0))
           (packet (value length)
             (unless (and (simple-vector-p value) (= (length value) length))
               (error 'type-error :datum value :expected-type 'simple-vector)) value))
    (case selector
      ((0 6) (when (= selector 6) (unless (array-has-fill-pointer-p object) (error 'type-error :datum object :expected-type 'vector)))
       (let ((fill (if (array-has-fill-pointer-p object) (fill-pointer object) -1)))
         (if (and (= selector 0) argument) fill
             (vector (kind object) (array-rank object) (adjustable-array-p object) fill))))
      (1 (case object ((character base-char standard-char) 1) (bit 2) ((nil extended-char) 3) (otherwise 0)))
      (2 (unless (arrayp object) (error 'type-error :datum object :expected-type 'array))
         (gethash object *array-adjust-test-parents*))
      (3 (packet argument 8)
         (miricl-runtime:array-adjust-shape-value (svref argument 0) (array-rank object) #'array-adjust-test-metadata)
         (let ((new (make-array (svref argument 0) :element-type (case (kind object) (1 'character) (2 'bit) (t t))
                                :adjustable (adjustable-array-p object) :fill-pointer (svref argument 5)
                                :initial-element (if (logbitp 0 (svref argument 4)) (svref argument 2)
                                                     (case (kind object) (1 #\a) (2 0) (t nil))))))
           (setf (gethash new *array-adjust-test-kinds*) (kind object)) new))
      (4 (packet argument 4)
         (miricl-runtime:copy-sequence-values object (svref argument 0)
           (list (svref argument 1) (svref argument 2) (svref argument 3))) object)
      (5 (miricl-runtime:array-adjust-displacement-check-value object argument #'array-adjust-test-metadata)
         (adjust-array object (array-dimensions argument) :displaced-to argument
                       :fill-pointer (if (array-has-fill-pointer-p object) (fill-pointer argument) nil)) object)
      (7 (setf (fill-pointer object) argument))
      (8 (unless (case (kind object) (1 (characterp argument)) (2 (typep argument 'bit)) (3 nil) (t t))
           (error 'type-error :datum argument :expected-type (case (kind object) (1 'character) (2 'bit) (t nil)))) argument)
      (9 (error 'simple-type-error :datum object :expected-type nil
                :format-control "Array adjustment rejected input (reason ~D)." :format-arguments (list argument)))
      (10 (case (kind object) (1 'character) (2 'bit) (3 nil) (t t)))
      (11 (setf (row-major-aref object (car argument)) (cdr argument)))
      (12 (list-length object)))))

(test array-adjust-port-shape-checks
  (dolist (case '((nil 0 1) (0 1 0) ((2 3) 2 6) ((536870910 2 0) 3 0)))
    (is (= (third case) (miricl-runtime:array-adjust-shape-value (first case) (second case) #'array-adjust-test-metadata))))
  (dolist (dimensions '(nil -1 1/2 (1 . bad) (536870910 2) (536870911 0)))
    (signals error (miricl-runtime:array-adjust-shape-value dimensions 2 #'array-adjust-test-metadata)))
  (let ((dimensions (list 1)))
    (setf (cdr dimensions) dimensions)
    (signals error (miricl-runtime:array-adjust-shape-value dimensions 1 #'array-adjust-test-metadata))))

(test array-adjust-port-coordinate-intersection
  (dolist (shapes '((() ()) ((2) (4)) ((2 3) (3 2)) ((2 3 4) (3 2 5))
                    ((2 0 4) (3 2 5)) ((2 3) (0 4))))
    (let ((old (array-adjust-test-array (first shapes))) (new (array-adjust-test-array (second shapes) :initial :new)))
      (dotimes (i (array-total-size old)) (setf (row-major-aref old i) (list i)))
      (miricl-runtime:array-adjust-copy-value old new #'array-adjust-test-metadata)
      (labels ((visit (coordinates axis)
                 (if (= axis (array-rank new))
                     (if (loop for x in coordinates for bound in (array-dimensions old) always (< x bound))
                         (is (eq (apply #'aref old coordinates) (apply #'aref new coordinates)))
                         (is (eq :new (apply #'aref new coordinates))))
                     (dotimes (i (array-dimension new axis)) (visit (append coordinates (list i)) (1+ axis))))))
        (visit nil 0)))))

(test array-adjust-port-growth-and-fill-order
  (let* ((array (array-adjust-test-array 2 :kind 2 :adjustable t :fill 2 :initial 1))
         (state (vector 4 'bit 0 nil 1 nil nil 0)))
    (is (eq array (miricl-runtime:array-adjust-value array state #'array-adjust-test-metadata)))
    (is (= 2 (fill-pointer array)))
    (is (= 1 (aref array 0)))
    (is (= 0 (aref array 3)))
    (is (= 2 (miricl-runtime:vector-stack-value 1 (list 1 array) #'array-adjust-test-metadata)))
    (is (= 1 (miricl-runtime:vector-stack-value 0 (list array) #'array-adjust-test-metadata)))
    (setf (fill-pointer array) (array-total-size array))
    (let ((size (array-total-size array)))
      (signals type-error (miricl-runtime:vector-stack-value 2 (list :bad array 3) #'array-adjust-test-metadata))
      (is (= size (array-total-size array)))
      (is (= size (fill-pointer array)))
      (is (= size (miricl-runtime:vector-stack-value 2 (list 0 array 3) #'array-adjust-test-metadata)))
      (is (>= (array-total-size array) (+ size 3))))))

(test array-adjust-port-chain-rejection-and-recovery
  (let ((a (array-adjust-test-array 1 :adjustable t)) (b (array-adjust-test-array 1 :adjustable t)))
    (let ((*array-adjust-test-parents* (make-hash-table :test #'eq)))
      (setf (gethash b *array-adjust-test-parents*) a)
      (signals error (miricl-runtime:array-adjust-displacement-check-value a b #'array-adjust-test-metadata))
      (setf (gethash a *array-adjust-test-parents*) b)
      (signals error (miricl-runtime:array-adjust-displacement-check-value (make-array 0) b #'array-adjust-test-metadata))
      (clrhash *array-adjust-test-parents*)
      (is (null (miricl-runtime:array-adjust-displacement-check-value a b #'array-adjust-test-metadata))))))

(test array-adjust-port-fill-after-expansion-effects
  (let ((array (array-adjust-test-array 2 :adjustable t :fill 2)))
    (flet ((metadata (selector object argument)
             (when (= selector 1) (setf (fill-pointer array) 0))
             (array-adjust-test-metadata selector object argument)))
      (is (eq array (miricl-runtime:array-adjust-value array (vector 3 t nil nil 0 nil nil 0) #'metadata)))
      (is (= 0 (fill-pointer array))))))
