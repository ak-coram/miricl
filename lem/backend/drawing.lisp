(in-package #:lem-browser)

(defmacro with-render-errors ((browser) &body body)
  `(handler-case (progn ,@body)
     (error (condition)
       ;; Core display error handlers may log and continue. Preserve a visible
       ;; failed state so a partially drawn frame cannot certify startup.
       (record-failure ,browser :render-line condition)
       (error condition))))

;; A primary method runs inside the core's WITH-DISPLAY-ERROR around method.
;; Observe the original error before that handler logs and returns nonlocally;
;; returning from this handler preserves its condition/restarts and all values.
(defmethod lem:redraw-buffer ((browser browser) (buffer lem:text-buffer) window force)
  (handler-bind ((error (lambda (condition) (record-failure browser :redraw-buffer condition))))
    ;; This primary is inside the core's dynamic per-window background binding.
    ;; Retain it for clear/update calls made outside that drawing extent.
    (setf (view-background-color (lem:window-view window))
          (or (lem:parse-color lem-if:*background-color-of-drawing-window*)
              (lem-if:get-background-color browser)))
    (call-next-method)))

(defun fill-rectangle (context x y width height color)
  (when (and (plusp width) (plusp height))
    (setf (js:property context "fillStyle") (lem:color-to-hex-string color))
    (js:invoke context "fillRect" x y width height)))
(defun draw-cursor (browser view x y width height color &optional true-cursor)
  (when true-cursor (setf (view-cursor-x view) x (view-cursor-y view) y))
  (ecase (browser-cursor-shape browser)
    (:box (fill-rectangle (view-context view) x y width height color))
    (:bar (fill-rectangle (view-context view) x y 2 height color))
    (:underline (fill-rectangle (view-context view) x (+ y height -2) width 2 color))))

(defun drawing-background (browser view attribute)
  (if (and attribute (lem:attribute-reverse attribute))
      (lem:attribute-foreground-color attribute)
      (or (and attribute (lem:parse-color (lem:attribute-background attribute)))
          (view-background browser view))))
(defun drawing-foreground (browser view attribute)
  (if (and attribute (lem:attribute-reverse attribute))
      (or (lem:parse-color (lem:attribute-background attribute)) (view-background browser view))
      (lem:attribute-foreground-color attribute)))

(defmethod lem-if:object-width ((browser browser) object)
  (unsupported (format nil "drawing object ~S" (type-of object))))
(defmethod lem-if:object-height ((browser browser) object)
  (declare (ignore object)) (browser-char-height browser))
(defmethod lem-if:object-width ((browser browser) (object lem-core/display:void-object)) 0)
(defmethod lem-if:object-width ((browser browser) (object lem-core/display:text-object))
  (* (lem:string-width (lem-core/display:text-object-string object)) (browser-char-width browser)))
(defmethod lem-if:object-width ((browser browser) (object lem-core/display:control-character-object))
  (* 2 (browser-char-width browser)))
(defmethod lem-if:object-width ((browser browser) (object lem-core/display:folder-object))
  (* 2 (browser-char-width browser)))
(defmethod lem-if:object-width ((browser browser) (object lem-core/display:emoji-object))
  (* 2 (length (lem-core/display:text-object-string object)) (browser-char-width browser)))
(defmethod lem-if:object-width ((browser browser) (object lem-core/display:eol-cursor-object)) 0)
(defmethod lem-if:object-width ((browser browser) (object lem-core/display:extend-to-eol-object)) 0)

(defgeneric draw-object (browser view object x y height))
(defmethod draw-object ((browser browser) view object x y height)
  (declare (ignore view x y height))
  (unsupported (format nil "drawing object ~S" (type-of object))))
(defmethod draw-object ((browser browser) view (object lem-core/display:void-object) x y height)
  (declare (ignore view x y height)) 0)
(defmethod draw-object ((browser browser) (view browser-view)
                       (object lem-core/display:text-object) x y height)
  (let* ((attribute (lem-core/display:text-object-attribute object))
         (cursor (lem-core::text-object-within-cursor-p object))
         (width (lem-if:object-width browser object))
         (context (view-context view))
         (background (drawing-background browser view attribute))
         (foreground (if (and cursor (eq :box (browser-cursor-shape browser)))
                         (view-background browser view)
                         (drawing-foreground browser view attribute))))
    (fill-rectangle context x y width height
                    (if cursor (view-background browser view) background))
    (when cursor (draw-cursor browser view x y width height background t))
    (setf (js:property context "font")
          (if (and attribute (lem:attribute-bold attribute)) "bold 16px monospace" "16px monospace")
          (js:property context "textBaseline") "alphabetic"
          (js:property context "fillStyle") (lem:color-to-hex-string foreground))
    ;; Position each codepoint on the logical LEM grid, independent of how its
    ;; attribute/cursor split the text run. The core supplies control rendering.
    (loop with position = x
          for character across (lem-core/display:text-object-string object)
          do (js:invoke context "fillText" (string character) position (+ y (browser-ascent browser)))
             (incf position (* (lem:string-width (string character)) (browser-char-width browser))))
    (when (and attribute (lem:attribute-underline attribute))
      (let* ((underline (lem:attribute-underline attribute))
             (color (if (eq underline t) foreground (or (lem:parse-color underline) foreground))))
        (fill-rectangle context x (+ y height -1) width 1 color)))
    width))
(defmethod draw-object ((browser browser) (view browser-view)
                       (object lem-core/display:line-end-object) x y height)
  (call-next-method browser view object
                    (+ x (* (lem-core/display:line-end-object-offset object)
                            (browser-char-width browser))) y height))
(defmethod draw-object ((browser browser) (view browser-view)
                       (object lem-core/display:eol-cursor-object) x y height)
  (draw-cursor browser view x y (browser-char-width browser) height
               (lem-core/display:eol-cursor-object-color object)
               (lem-core/display:eol-cursor-object-true-cursor-p object))
  0)
(defmethod draw-object ((browser browser) (view browser-view)
                       (object lem-core/display:extend-to-eol-object) x y height)
  (fill-rectangle (view-context view) x y (- (view-pixel-width browser view) x) height
                  (lem-core/display:extend-to-eol-object-color object))
  0)
(defun draw-objects (browser view objects x y height)
  (dolist (object objects) (incf x (draw-object browser view object x y height)))
  (values))
(defmethod lem-if:render-line ((browser browser) (view browser-view) x y objects height)
  (with-render-errors (browser)
    (fill-rectangle (view-context view) x y (- (view-pixel-width browser view) x) height
                    (view-background browser view))
    (draw-objects browser view objects x y height)))
(defmethod lem-if:render-line-on-modeline ((browser browser) (view browser-view)
                                          left right attribute height)
  (with-render-errors (browser)
   (let ((y (- (view-pixel-height browser view) height)))
    (fill-rectangle (view-context view) 0 y (view-pixel-width browser view) height
                    (lem:attribute-background-with-reverse attribute))
    (draw-objects browser view left 0 y height)
    (draw-objects browser view right
                  (- (view-pixel-width browser view)
                     (reduce #'+ right :key (lambda (object) (lem-if:object-width browser object))
                             :initial-value 0)) y height))))
(defmethod lem-if:clear-to-end-of-window ((browser browser) (view browser-view) y)
  (fill-rectangle (view-context view) 0 y (view-pixel-width browser view)
                  (- (view-pixel-height browser view) y) (view-background browser view)))
