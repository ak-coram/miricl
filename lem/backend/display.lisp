(in-package #:lem-browser)

(defconstant +canvas-pixel-limit+ (* 32 1024 1024))
(defun backing-pixels (browser columns rows modeline dpr)
  (unless (and (integerp columns) (<= 1 columns 32768)
               (integerp rows) (<= 0 rows 32768))
    (lem:editor-error "Browser frontend: invalid view dimensions ~S x ~S." columns rows))
  (let ((width (max 1 (ceiling (* columns (browser-char-width browser) dpr))))
        (height (max 1 (ceiling (* (+ rows (if modeline 1 0)) (browser-char-height browser) dpr)))))
    (unless (and (<= width 16384) (<= height 16384))
      (lem:editor-error "Browser frontend: canvas dimensions exceed the supported allocation."))
    (* 2 width height)))
(defun check-allocation (browser dpr &optional replacement columns rows modeline)
  (let ((pixels 0))
    (dolist (view (browser-views browser))
      (unless (eq view replacement)
        (incf pixels (backing-pixels browser (view-columns view) (view-body-rows view)
                                    (view-modeline-p view) dpr))))
    (when columns (incf pixels (backing-pixels browser columns rows modeline dpr)))
    (unless (<= pixels +canvas-pixel-limit+)
      (lem:editor-error "Browser frontend: total Canvas allocation exceeds its pixel budget."))))

(defun view-pixel-width (browser view)
  (* (view-columns view) (browser-char-width browser)))
(defun view-pixel-height (browser view)
  (* (+ (view-body-rows view) (if (view-modeline-p view) 1 0))
     (browser-char-height browser)))
(defun check-position (x y)
  (unless (and (integerp x) (<= -32768 x 32768)
               (integerp y) (<= -32768 y 32768))
    (lem:editor-error "Browser frontend: invalid view position.")))
(defun view-background (browser view)
  (or (lem:parse-color lem-if:*background-color-of-drawing-window*)
      (and (lem:floating-window-p (view-window view))
           (lem:parse-color (lem-core::floating-window-background-color (view-window view))))
      (view-background-color view)
      (lem-if:get-background-color browser)))
(defun position-view (browser view)
  ;; LEM's origin already excludes the border. The group occupies the outside
  ;; margin; the Canvas retains exactly its original content coordinates.
  (let* ((cw (browser-char-width browser)) (ch (browser-char-height browser))
         (bx (* (view-border view) cw)) (by (* (view-border view) ch))
         (width (view-pixel-width browser view)) (height (view-pixel-height browser view))
         (group (view-group view)))
    (css group "left" (pixels (- (* (view-x view) cw) bx)))
    (css group "top" (pixels (- (* (view-y view) ch) by)))
    (css group "width" (pixels (+ width (* 2 bx))))
    (css group "height" (pixels (+ height (* 2 by))))
    (css group "background-color" (lem:color-to-hex-string (view-background browser view)))
    (css (view-canvas view) "left" (pixels bx))
    (css (view-canvas view) "top" (pixels by))
    (when (view-edges view)
      (destructuring-bind (top right bottom left) (view-edges view)
        (let ((x (/ bx 2)) (y (/ by 2))
              (vertical-start (if (eq :drop-curtain (view-border-shape view)) 0 (/ by 2)))
              (color (lem:color-to-hex-string (lem-if:get-foreground-color browser))))
          (dolist (edge (view-edges view)) (css edge "background-color" color))
          (dolist (edge (list top bottom))
            (css edge "left" (pixels x)) (css edge "width" (pixels (+ width bx)))
            (css edge "height" "1px"))
          (css top "top" (pixels y))
          (css bottom "top" (pixels (+ height by y)))
          (dolist (edge (list left right))
            (css edge "top" (pixels vertical-start)) (css edge "width" "1px")
            (css edge "height" (pixels (+ height by y (- vertical-start) 1))))
          (css left "left" (pixels x))
          (css right "left" (pixels (+ width bx x))))))))
(defun size-view (browser view)
  (check-allocation browser (browser-dpr browser))
  (let ((width (view-pixel-width browser view))
        (height (view-pixel-height browser view))
        (dpr (browser-dpr browser)))
    (dolist (canvas (list (view-canvas view) (view-backing view)))
      (setf (js:property canvas "width") (max 1 (ceiling (* width dpr)))
            (js:property canvas "height") (max 1 (ceiling (* height dpr)))))
    (css (view-canvas view) "width" (pixels width))
    (css (view-canvas view) "height" (pixels height))
    (js:invoke (view-context view) "setTransform" dpr 0 0 dpr 0 0)
    (fill-rectangle (view-context view) 0 0 width height (view-background browser view))
    (position-view browser view)))
(defun measure-cells (browser)
  (let ((context (js:invoke (element "canvas") "getContext" "2d")))
    (setf (js:property context "font") "16px monospace")
    (let* ((metrics (js:invoke context "measureText" "Mg"))
           (width (/ (js-field metrics "width") 2))
           (ascent (js-field metrics "fontBoundingBoxAscent"))
           (descent (js-field metrics "fontBoundingBoxDescent")))
      (unless (bounded-number-p width 1 128) (error "Invalid browser font width: ~S" width))
      (unless (bounded-number-p ascent 1 128) (setf ascent 16))
      (unless (bounded-number-p descent 0 128) (setf descent 4))
      (setf (browser-char-width browser) (ceiling width)
            (browser-ascent browser) (+ 2 (ceiling ascent))
            (browser-char-height browser) (+ 4 (ceiling ascent) (ceiling descent))))))
(defun resize-browser (browser width height dpr)
  (unless (and (bounded-number-p width 0 32768) (bounded-number-p height 0 32768)
               (bounded-number-p dpr 0.25 8))
    (lem:editor-error "Browser frontend: invalid display size ~S x ~S at scale ~S." width height dpr))
  (let ((columns (max 4 (floor width (browser-char-width browser))))
        (rows (max 3 (floor height (browser-char-height browser)))))
    (unless (<= (backing-pixels browser columns rows nil dpr) +canvas-pixel-limit+)
      (lem:editor-error "Browser frontend: requested display exceeds its Canvas allocation budget.")))
  (check-allocation browser dpr)
  ;; Tiny/hidden containers retain a usable logical frame. Returning to an
  ;; ordinary size takes the same real LEM resize path as other geometry changes.
  (setf (browser-columns browser) (max 4 (floor width (browser-char-width browser)))
        (browser-rows browser) (max 3 (floor height (browser-char-height browser)))
        (browser-dpr browser) dpr)
  (dolist (view (browser-views browser)) (size-view browser view))
  (values))
(defun browser-size (browser)
  (let ((bounds (js:invoke (browser-container browser) "getBoundingClientRect")))
    (values (js-field bounds "width") (js-field bounds "height")
            (js-field (js:global "window") "devicePixelRatio"))))

(defmethod lem-if:invoke ((browser browser) function)
  (setf (browser-container browser)
        (js:invoke (js:global "document") "getElementById" "lem-desktop"))
  (when (js:strict-equal (browser-container browser) js:+null+)
    (error "The browser page has no lem-desktop container."))
  (setf (browser-root browser) (element "div" (browser-container browser)))
  (setf (js:property (browser-root browser) "className") "lem-editor"
        (js:property (browser-root browser) "tabIndex") 0)
  (js:invoke (browser-root browser) "setAttribute" "aria-label" "LEM editor; physical keyboard input")
  (css (browser-root browser) "position" "absolute")
  (css (browser-root browser) "inset" "0")
  (css (browser-root browser) "overflow" "hidden")
  (measure-cells browser)
  (multiple-value-call #'resize-browser browser (browser-size browser))
  (install-input browser)
  (set-state browser :starting)
  ;; Finish fallible DOM setup before starting long-lived Lisp threads.
  (js:invoke (browser-root browser) "focus")
  (with-browser-messenger (browser)
   (setf (browser-editor browser)
        (funcall function nil
                 (lambda (report)
                   ;; This runs before core TEARDOWN. Record identity now; the
                   ;; bridge releases its mapping only after actual thread exit.
                   (setf (browser-frame browser) (lem:get-frame browser))
                   (cond (report
                          (ignore-errors
                            (set-state browser :failed (diagnostic-description report 2048))))
                         ((browser-failure browser) (ignore-errors (set-state browser :failed)))
                         (t (set-state browser :stopping))))))
  (setf (browser-bridge browser)
        (bt2:make-thread (lambda () (bridge-input browser)) :name "LEM browser input")))
  (values))

(defmethod lem-if:get-background-color ((browser browser))
  (lem:parse-color (browser-background browser)))
(defmethod lem-if:get-foreground-color ((browser browser))
  (lem:parse-color (browser-foreground browser)))
(defmethod lem-if:update-background ((browser browser) name)
  (unless (lem:parse-color name) (lem:editor-error "Invalid background color ~S." name))
  (setf (browser-background browser) name))
(defmethod lem-if:update-foreground ((browser browser) name)
  (unless (lem:parse-color name) (lem:editor-error "Invalid foreground color ~S." name))
  (setf (browser-foreground browser) name))
(defmethod lem-if:display-width ((browser browser)) (browser-columns browser))
(defmethod lem-if:display-height ((browser browser)) (browser-rows browser))
(defmethod lem-if:get-char-width ((browser browser)) (browser-char-width browser))
(defmethod lem-if:get-char-height ((browser browser)) (browser-char-height browser))
(defmethod lem-if:display-title ((browser browser)) (browser-title browser))
(defmethod lem-if:set-display-title ((browser browser) title)
  (setf (browser-title browser) title (js:property (js:global "document") "title") title))
(defmethod lem-if:update-cursor-shape ((browser browser) shape)
  (unless (member shape '(:box :bar :underline)) (unsupported (format nil "cursor shape ~S" shape)))
  (setf (browser-cursor-shape browser) shape))
(defmethod lem-if:display-fullscreen-p ((browser browser)) nil)
(defmethod lem-if:set-display-fullscreen-p ((browser browser) value)
  (declare (ignore value)) (unsupported "fullscreen"))
(defmethod lem-if:maximize-frame ((browser browser)) (unsupported "maximizing frames"))
(defmethod lem-if:minimize-frame ((browser browser)) (unsupported "minimizing frames"))
(defmethod lem-if:clipboard-copy ((browser browser) text)
  (declare (ignore text)) (unsupported "clipboard copy"))
(defmethod lem-if:clipboard-paste ((browser browser)) (unsupported "clipboard paste"))
(defmethod lem-if:increase-font-size ((browser browser)) (unsupported "font resizing"))
(defmethod lem-if:decrease-font-size ((browser browser)) (unsupported "font resizing"))
(defmethod lem-if:set-font-size ((browser browser) size)
  (declare (ignore size)) (unsupported "font resizing"))
(defmethod lem-if:set-font-name ((browser browser) name)
  (declare (ignore name)) (unsupported "font selection"))

(defmethod lem-if:make-view ((browser browser) window x y width height modeline)
  (setf (browser-frame browser) (lem:get-frame browser))
  (check-position x y)
  (check-allocation browser (browser-dpr browser) nil width height modeline)
  (let* ((floating (lem:floating-window-p window))
         (border (or (lem:window-border window) 0))
         (shape (when floating (lem:floating-window-border-shape window)))
         (group nil) (front nil) (back nil) (view nil) (completed nil) (failure nil))
    (unless (and (integerp border) (<= 0 border 16) (member shape '(nil :drop-curtain)))
      (lem:editor-error "Browser frontend: unsupported floating border."))
    (unwind-protect
         (handler-bind ((error (lambda (condition)
                                 (unless failure
                                   (setf failure condition)
                                   (record-failure browser :view-construction condition)))))
          (progn
           (setf group (element "div" (browser-root browser))
                 front (element "canvas" group) back (element "canvas"))
           (setf (js:property group "className") (if floating "lem-window lem-floating" "lem-window")
                 (js:property front "className") "lem-view")
           (css group "position" "absolute") (css group "pointer-events" "none")
           (css front "position" "absolute") (css front "pointer-events" "none")
           (let ((edges (when (plusp border)
                          (loop repeat 4 collect
                            (let ((edge (element "div" group)))
                              (setf (js:property edge "className") "lem-border")
                              (css edge "position" "absolute") edge)))))
             (setf view (make-instance 'browser-view :window window :group group :edges edges
                                      :canvas front :backing back :context (js:invoke back "getContext" "2d")
                                      :border border :border-shape shape
                                      :x x :y y :width width :height height :modeline modeline)))
           (size-view browser view)
           (push view (browser-views browser))
           (setf completed t)
           view))
      (unless completed
        ;; A partially constructed view has not entered the registry yet.
        (handler-case
            (if view (lem-if:delete-view browser view)
                (when group (js:invoke group "remove")))
          (error (condition)
            (record-failure browser :partial-view-cleanup condition)
            (unless failure (error condition))))))))
(defmethod lem-if:view-width ((browser browser) (view browser-view)) (view-pixel-width browser view))
(defmethod lem-if:view-height ((browser browser) (view browser-view)) (view-pixel-height browser view))
(defmethod lem-if:delete-view ((browser browser) (view browser-view))
  (invalidate-popup-window browser (view-window view))
  (unwind-protect
       (when (view-group view) (js:invoke (view-group view) "remove"))
    (setf (browser-views browser) (remove view (browser-views browser))
          (view-group view) nil (view-edges view) nil
          (view-canvas view) nil (view-backing view) nil (view-context view) nil))
  (values))
(defmethod lem-if:clear ((browser browser) (view browser-view))
  (fill-rectangle (view-context view) 0 0 (view-pixel-width browser view)
                  (view-pixel-height browser view) (view-background browser view)))
(defmethod lem-if:set-view-size ((browser browser) (view browser-view) width height)
  (check-allocation browser (browser-dpr browser) view width height (view-modeline-p view))
  (let ((old-width (view-columns view)) (old-height (view-body-rows view)))
    (handler-case
        (progn (setf (view-columns view) width (view-body-rows view) height)
               (size-view browser view))
      (error (condition)
        (record-failure browser :view-size condition)
        (setf (view-columns view) old-width (view-body-rows view) old-height)
        ;; Restore the previous allocation if the host accepted only part of
        ;; the update. Retain the original failure, including on restore error.
        (handler-case (size-view browser view)
          (error (restore-error) (record-failure browser :view-size-restore restore-error)))
        (error condition)))))
(defmethod lem-if:set-view-pos ((browser browser) (view browser-view) x y)
  (check-position x y)
  (let ((old-x (view-x view)) (old-y (view-y view)))
    (handler-case
        (progn (setf (view-x view) x (view-y view) y) (position-view browser view))
      (error (condition)
        (record-failure browser :view-position condition)
        (setf (view-x view) old-x (view-y view) old-y)
        (handler-case (position-view browser view)
          (error (restore-error) (record-failure browser :view-position-restore restore-error)))
        (error condition)))))
(defmethod lem-if:update-display ((browser browser))
  ;; Floating frame order is authoritative, including when a later ordinary
  ;; split view was created while a popup was already visible.
  (dolist (view (browser-views browser))
    (css (view-group view) "z-index" "0")
    (position-view browser view))
  (let ((frame (lem:get-frame browser)))
    (when frame
      (loop for window in (lem:frame-floating-windows frame) for layer from 1
            for view = (lem:window-view window)
            when (and (typep view 'browser-view) (view-group view))
              do (css (view-group view) "z-index" (princ-to-string layer)))))
  (dolist (view (browser-views browser))
    ;; Front canvases have device-pixel coordinates; only the backing drawing
    ;; context is scaled. Unchanged rows remain in the backing canvas.
    (let ((context (js:invoke (view-canvas view) "getContext" "2d")))
      (js:invoke context "drawImage" (view-backing view) 0 0)))
  (incf (browser-frames browser))
  (when (eq :starting (browser-state browser)) (set-state browser :ready))
  (values))
