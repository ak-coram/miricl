(defpackage #:lem-browser-tests (:use #:cl) (:export #:check-boundaries #:check-popups))
(in-package #:lem-browser-tests)

(defun rejected-p (function)
  (handler-case (progn (funcall function) nil)
    (error (condition) (plusp (length (princ-to-string condition))))))
(defun check-boundaries ()
  "Check the browser input boundary without creating DOM resources or threads."
  (let ((key (lem-browser::normalized-key "A" nil nil nil t)))
    (assert (string= "A" (lem:key-sym key)))
    (assert (not (lem:key-shift key))))
  (let ((key (lem-browser::normalized-key "ArrowLeft" nil nil nil t)))
    (assert (string= "Left" (lem:key-sym key)))
    (assert (lem:key-shift key)))
  (let ((key (lem-browser::normalized-key "x" t nil nil t)))
    (assert (lem:key-ctrl key))
    (assert (lem:key-shift key)))
  (assert (not (lem-browser::normalized-key "Dead" nil nil nil nil)))
  (assert (rejected-p (lambda () (lem-browser::normalized-key "x" :invalid nil nil nil))))
  (let ((browser (make-instance 'lem-browser:browser)))
    (dolist (record '(nil (:resize "invalid" 20 1) (:resize 20 20 0) (:key "x" t) (:stop :extra)))
      (assert (rejected-p (lambda () (lem-browser::deliver-input browser record)))))
    (let ((record (list :key)))
      (setf (cdr record) record)
      (assert (rejected-p (lambda () (lem-browser::deliver-input browser record)))))
    (let ((columns (lem-if:display-width browser)) (rows (lem-if:display-height browser)))
      (assert (rejected-p (lambda () (lem-browser::resize-browser browser 32768 32768 8))))
      (assert (= columns (lem-if:display-width browser)))
      (assert (= rows (lem-if:display-height browser))))
    (assert (lem-browser::normalized-key "λ" nil nil nil nil)))
  (let ((browser (make-instance 'lem-browser:browser)))
    (loop repeat lem-browser::+inbox-limit+
          do (lem-browser::enqueue-input browser (list :key "x" nil nil nil nil)))
    (lem-browser::request-stop browser)
    (lem-browser::request-stop browser)
    (lem-browser::enqueue-input browser (list :key "late" nil nil nil nil))
    (let ((records (loop for record = (lem-browser::next-input browser)
                         while record collect record)))
      (assert (equal '(:stop) (car (last records))))
      (assert (= 1 (count :stop records :key #'first)))
      (assert (= lem-browser::+inbox-limit+ (count :key records :key #'first)))
      (assert (every (lambda (record) (or (eq :stop (first record)) (string= "x" (second record)))) records))))
  (let ((lem-browser::*last-failure* nil)
        (lem-browser:*browser* (make-instance 'lem-browser:browser)))
    (let ((condition (make-condition 'type-error :datum 3.5 :expected-type 'integer)))
      (assert
       (eq condition
           (handler-case
               (handler-bind ((error (lambda (error)
                                       (lem-browser::record-failure lem-browser:*browser* :boundary error))))
                 (error condition))
             (error (error) error)))))
    (let ((first (getf (lem-browser:editor-status) :failure)))
      (assert (stringp first))
      (assert (search "INTEGER" first))
      (assert (search "datum" first))
      ;; A later exit report/cleanup must not overwrite the primary diagnostic.
      (lem-browser::set-state lem-browser:*browser* :failed "secondary error")
      (lem-browser::cleanup-browser lem-browser:*browser*)
      (setf lem-browser:*browser* nil)
      (assert (eq :failed (getf (lem-browser:editor-status) :state)))
      (assert (string= first (getf (lem-browser:editor-status) :failure)))
      (assert (string= first (getf (lem-browser:editor-status) :last-failure)))))
  (let* ((text (make-string 10000 :initial-element #\x))
         (bounded (lem-browser::diagnostic-description text)))
    (assert (stringp bounded))
    (assert (< (length bounded) (length text))))
  (values t))

(defun check-popups ()
  "Check real public cleanup and browser binding/validation without DOM startup."
  (dolist (timeout '(nil 0 1/2 5 86400))
    (assert (eql timeout (lem-browser::validate-popup-timeout timeout))))
  (dolist (timeout '(-1 86401 #c(1 2) :invalid "2"))
    (assert (rejected-p (lambda () (lem-browser::validate-popup-timeout timeout)))))
  (let ((cyclic (list :invalid)))
    (setf (cdr cyclic) cyclic)
    (assert (rejected-p (lambda () (lem-browser::validate-popup-timeout cyclic)))))
  (assert (rejected-p (lambda () (lem-browser::check-position 1/2 0))))
  (assert (rejected-p (lambda () (lem-browser::check-position 0 40000))))
  (lem-browser::check-position -1 0)
  (let ((bindings bt2:*default-special-bindings*)
        (messenger lem-core/popup-message-interface:*popup-messenger*)
        (browser (make-instance 'lem-browser:browser)))
    (lem:with-implementation browser
      (lem-browser::with-browser-messenger (browser)
        (assert (typep lem-core/popup-message-interface:*popup-messenger*
                       'lem-browser::browser-popup-messenger))
        (assert (eq browser (lem-browser::messenger-browser
                             lem-core/popup-message-interface:*popup-messenger*)))
        (let* ((owned (lem-browser::browser-messenger browser))
               (child (bt2:make-thread
                       (lambda ()
                         (assert (eq browser (lem:implementation)))
                         (assert (eq owned lem-core/popup-message-interface:*popup-messenger*))
                         (assert (eq bt2:*default-special-bindings*
                                     (eval (cdr (assoc 'bt2:*default-special-bindings*
                                                       bt2:*default-special-bindings*)))))
                         t)
                       :name "LEM browser binding check")))
          (loop repeat 200 while (bt2:thread-alive-p child) do (sleep 0.01))
          (assert (not (bt2:thread-alive-p child)))
          (assert (bt2:join-thread child)))
        ;; Inactive ownership is rejected before genuine popup construction.
        (assert (rejected-p (lambda () (lem:display-popup-message "inactive" :timeout nil))))))
    (assert (eq bindings bt2:*default-special-bindings*))
    (assert (eq messenger lem-core/popup-message-interface:*popup-messenger*)))
  (let* ((lem-core::*display-frame-map* (make-hash-table))
         (lem-core::*frames* nil)
         (browser (make-instance 'lem-browser:browser))
         (other (make-instance 'lem-browser:browser)))
    (lem:with-implementation browser
      (let ((frame (lem:make-frame nil)) (other-frame (lem:make-frame nil)))
        (lem:map-frame browser frame) (lem:map-frame other other-frame)
        (assert (eq frame (lem:unmap-frame browser)))
        (assert (null (lem:get-frame browser)))
        (assert (null (lem:unmap-frame browser)))
        (assert (eq other-frame (lem:get-frame other)))
        ;; Cleanup uses the public corrected map API only for its exact frame.
        (lem:map-frame browser frame)
        (setf (lem-browser::browser-frame browser) frame)
        (lem-browser::cleanup-browser browser)
        (lem-browser::cleanup-browser browser)
        (assert (null (lem:get-frame browser)))
        (assert (eq other-frame (lem:get-frame other))))))
  (let* ((browser (make-instance 'lem-browser:browser))
         (entry (lem-browser::make-popup-entry :owner browser :generation
                                               (lem-browser::browser-generation browser))))
    (setf (lem-browser::browser-popups browser) (list entry))
    (lem-browser::request-stop browser)
    (assert (null (lem-browser::browser-popups browser)))
    (assert (null (lem-browser::browser-generation browser)))
    (assert (null (lem-browser::popup-entry-owner entry)))
    (assert (eq :invalid (lem-browser::popup-entry-state entry)))
    (lem-browser::expire-popup-entry entry))
  (values t))
