;;;; Check the real prepared STR system after ASDF has compiled and loaded it.
(defpackage #:lem-browser-str-tests
  (:use #:cl)
  (:export #:check-str))
(in-package #:lem-browser-str-tests)

(defun check-str ()
  (let ((characters
          (loop for code in '(11 133 12288 160)
                for character = (code-char code)
                do (assert (characterp character))
                   (assert (= code (char-code character)))
                collect character)))
    (assert (every #'characterp str:*whitespaces*))
    (dolist (character (append characters (list #\Space #\Newline)))
      (assert (find character str:*whitespaces* :test #'char=))
      (let* ((edge (string character))
             (wrapped (concatenate 'string edge "payload" edge)))
        (assert (string= "payload" (str:trim wrapped)))
        (assert (string= (concatenate 'string "payload" edge)
                         (str:trim-left wrapped)))
        (assert (string= (concatenate 'string edge "payload")
                         (str:trim-right wrapped)))))
    (let* ((edges (coerce characters 'string))
           (interior (concatenate 'string "a" (string (code-char 12288)) "b"))
           (wrapped (concatenate 'string edges interior edges)))
      (assert (string= interior (str:trim wrapped)))
      (assert (str:blankp edges))
      (assert (not (str:blankp wrapped))))
    (assert (string= "payload" (str:trim "++payload++" :char-bag "+")))
    (dolist (trim '(str:trim str:trim-left str:trim-right))
      (assert (null (funcall trim nil))))
    (assert (str:blankp nil))
    ;; Literal separators are independent of the whitespace bag and regex \s.
    (let ((str:*omit-nulls* nil))
      (assert (equal '("a" "" "b") (str:split "." "a..b")))
      (assert (equal '("a" "b") (str:split "." "a..b" :omit-nulls t)))
      (let ((separator (string (code-char 12288))))
        (assert (equal '("a" "b")
                       (str:split separator
                                  (concatenate 'string "a" separator "b"))))))
    t))
