;;;; Service boundary regressions; ANSI covers the MACROEXPAND-1 primitive.
(defpackage #:lem-browser-ide-service-tests
  (:use #:cl)
  (:export #:check-macroexpansion))
(in-package #:lem-browser-ide-service-tests)

(defvar *effects* 0)
(defmacro query-next () '(query-nil))
(defmacro query-nil () nil)
(defmacro query-effect ()
  (incf *effects*)
  '(incf *effects*))
(defmacro query-cycle ()
  (let ((data (list :cycle))) (setf (cdr data) data) data))
(defclass unprintable-expansion () ())
(defmethod print-object ((object unprintable-expansion) stream)
  (declare (ignore object stream))
  (write-string "printer-output")
  (error "query printer failed"))
(defmacro query-unprintable () (make-instance 'unprintable-expansion))

(defun await-request (session request)
  (loop repeat 3000 while (miricl-ide-services:session-worker-alive-p session)
        do (sleep 0.01))
  (assert (not (miricl-ide-services:session-worker-alive-p session)))
  (assert (member (miricl-ide-services:request-state request) '(:ok :error :cancelled)))
  request)
(defun check-macroexpansion ()
  (let ((session (miricl-ide-services:make-session :package (symbol-package 'query-next))))
    (labels ((query (source &optional (state :ok))
               (let ((calls 0))
                 (let ((request (miricl-ide-services:submit
                                 session :macroexpand-1 source :history-p t
                                 :callback (lambda (result) (declare (ignore result)) (incf calls)))))
                   (await-request session request)
                   (assert (eq state (miricl-ide-services:request-state request)))
                   (when (eq state :ok)
                     (assert (= 2 (length (miricl-ide-services:request-values request)))))
                   (assert (= 1 calls))
                   request)))
             (expanded (source expected)
               (let ((values (miricl-ide-services:request-values (query source))))
                 (assert (equal expected (first values)))
                 (assert (second values)))))
      (unwind-protect
           (progn
             (assert (equal '(nil nil) (miricl-ide-services:request-values (query "nil"))))
             (expanded "(query-nil)" nil)
             (expanded "(query-next) ; trailing comment" '(query-nil))
             (setf *effects* 0)
             (expanded "(query-effect)" '(incf *effects*))
             (assert (= 1 *effects*)) ; expansion is displayed, never evaluated
             (dolist (source '("" "; only a comment" "(" "(query-effect) nil"
                               "(query-effect) (" "(query-effect . 1)" "#1=(query-effect . #1#)"))
               (let ((before *effects*))
                 (let ((diagnostic (miricl-ide-services:request-condition (query source :error))))
                   (assert (plusp (length diagnostic)))
                   (when (member source '("(" "(query-effect) (") :test #'string=)
                     (assert (search "reader failed" diagnostic))
                     (assert (search "source prefix:" diagnostic))))
                 (assert (= before *effects*))))
             ;; Exactly-one-form rejection retains the ordinary trailing READ's
             ;; effects while still preventing invocation of the requested macro.
             (let ((before *effects*))
               (query "(query-effect) #.(progn (incf *effects*) :tail)" :error)
               (assert (= (1+ before) *effects*)))
             (let* ((request (query "'( #1=(x . #1#))"))
                    (values (miricl-ide-services:request-values request)))
               (assert (null (second values)))
               (assert (eq 'quote (caar values))))
             (let* ((request (query "(query-cycle)"))
                    (expansion (first (miricl-ide-services:request-values request))))
               (assert (eq expansion (cdr expansion)))
               (assert (second (miricl-ide-services:request-values request)))
               (assert (plusp (length (miricl-ide-services:request-printed-values request)))))
             (let ((request (query "(query-unprintable)" :error)))
               (assert (typep (first (miricl-ide-services:request-values request)) 'unprintable-expansion))
               (assert (second (miricl-ide-services:request-values request)))
               (assert (search "display failed" (miricl-ide-services:request-condition request)))
               (assert (search "printer-output" (miricl-ide-services:request-output request))))
             ;; Query submissions with HISTORY-P do not shift listener history.
             (let ((request (miricl-ide-services:submit session :eval "(list * + /)")))
               (await-request session request)
               (assert (equal '((nil nil nil)) (miricl-ide-services:request-values request))))
             (let ((request (miricl-ide-services:submit session :eval "(+ 40 2)")))
               (await-request session request)
               (assert (equal '(42) (miricl-ide-services:request-values request))))
             t)
        (miricl-ide-services:close-session session)
        (loop repeat 3000 while (miricl-ide-services:session-worker-alive-p session) do (sleep 0.01))
        (assert (not (miricl-ide-services:session-worker-alive-p session)))))))
