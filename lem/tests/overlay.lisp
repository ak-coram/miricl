;;;; Load after the prepared lem-browser/core system; no frontend or DOM needed.
(defpackage #:lem-browser-overlay-tests
  (:use #:cl)
  (:export #:check-overlays))
(in-package #:lem-browser-overlay-tests)

(defclass test-attribute (lem:attribute) ())
(defclass default-overlay (lem-core::overlay)
  ((extra :initarg :extra :reader extra)
   (writer-input :accessor writer-input))
  (:default-initargs :attribute 'lem-core::cursor :extra :default))
(defclass initform-overlay (lem-core::overlay)
  ((lem-core::attribute :initform (lem:make-attribute :bold t))))
(defclass nil-default-overlay (default-overlay) ()
  (:default-initargs :attribute nil))
(defclass nil-initform-overlay (lem-core::overlay)
  ((lem-core::attribute :initform nil)))

;; This extension must dispatch on the caller's value, before normalization.
(defmethod lem:set-overlay-attribute ((value symbol) (overlay default-overlay))
  (setf (writer-input overlay) value)
  (call-next-method))

(defun rejected-p (thunk)
  (handler-case (progn (funcall thunk) nil)
    (error (condition)
      (assert (plusp (length (princ-to-string condition))))
      condition)))

(defun tracked-points (buffer)
  (copy-list (lem/buffer/internal::buffer-points buffer)))

(defun same-points-p (left right)
  (null (set-exclusive-or left right :test #'eq)))

(defun dispose-overlay (overlay)
  ;; Wrapper constructors own their copies, including inserting temporary-overlay
  ;; endpoints which DELETE-OVERLAY intentionally does not release.
  (lem:delete-overlay overlay)
  (lem:delete-point (lem:overlay-start overlay))
  (lem:delete-point (lem:overlay-end overlay)))

(defun check-overlays ()
  "Check typed overlay designators, initialization, dispatch and rejection recovery."
  (let* ((buffer (lem:make-buffer (symbol-name (gensym "overlay-test-")) :temporary t))
         (start (lem:buffer-point buffer))
         (end nil)
         (object (lem:make-attribute :bold t))
         (subobject (make-instance 'test-attribute))
         (unknown (gensym "unknown-attribute-"))
         (nil-name (gensym "nil-attribute-"))
         (bad-name (gensym "bad-attribute-"))
         (counted-name (gensym "counted-attribute-"))
         (calls 0))
    (unwind-protect
         (progn
           (setf (get nil-name 'lem-core::attribute) (lambda () nil)
                 (get bad-name 'lem-core::attribute) (lambda () 17)
                 (get counted-name 'lem-core::attribute)
                 (lambda () (incf calls) object))
           (lem:insert-string start "abcd")
           (setf end (lem:copy-point start :temporary))
           (lem:buffer-start start)
           (labels ((construct (kind attribute &optional temporary)
                      (ecase kind
                        (:overlay (lem:make-overlay end start attribute :temporary temporary))
                        (:endings (lem:make-line-endings-overlay end start attribute
                                                               :text "tail" :offset 2
                                                               :temporary temporary))
                        (:line (lem:make-line-overlay start attribute :temporary temporary))
                        (:cursor (lem-core::make-cursor-overlay start attribute :fake t))))
                    (initargs ()
                      (list :start end :end start :buffer buffer :temporary t))
                    (unchanged-after-rejection (thunk)
                      (let ((before (tracked-points buffer))
                            (line-before (copy-list (lem/buffer/line:line-points
                                                     (lem/buffer/internal:point-line start))))
                            (overlays-before (copy-list (lem:buffer-overlays buffer))))
                        (assert (rejected-p thunk))
                        (assert (same-points-p before (tracked-points buffer)))
                        (assert (same-points-p line-before
                                  (lem/buffer/line:line-points (lem/buffer/internal:point-line start))))
                        (assert (equal overlays-before (lem:buffer-overlays buffer)))
                        (assert (= 0 (lem:point-charpos start)))
                        (assert (= 4 (lem:point-charpos end))))))
             (dolist (kind '(:overlay :endings :line :cursor))
               (dolist (attribute (list 'lem-core::cursor 'lem-core::fake-cursor
                                       object subobject nil-name counted-name))
                 (let* ((before (tracked-points buffer))
                        (previous-calls calls)
                        (overlay (construct kind attribute)))
                   (unwind-protect
                        (progn
                          (assert (typep (lem:overlay-attribute overlay) '(or null lem:attribute)))
                          (when (typep attribute 'lem:attribute)
                            (assert (eq attribute (lem:overlay-attribute overlay))))
                          (when (eq attribute nil-name) (assert (null (lem:overlay-attribute overlay))))
                          (when (eq attribute counted-name)
                            (assert (= (1+ previous-calls) calls))
                            (assert (eq object (lem:overlay-attribute overlay))))
                          (assert (eq buffer (lem:overlay-buffer overlay)))
                          (assert (lem:point<= (lem:overlay-start overlay) (lem:overlay-end overlay)))
                          (assert (eq (not (null (member overlay (lem:buffer-overlays buffer))))
                                      (not (lem-core::overlay-temporary-p overlay))))
                          (case kind
                            ((:overlay :endings)
                             ;; Sorting retains each requested endpoint kind.
                             (assert (eq :left-inserting (lem:point-kind (lem:overlay-start overlay))))
                             (assert (eq :right-inserting (lem:point-kind (lem:overlay-end overlay)))))
                            (:cursor (assert (lem-core::cursor-overlay-fake-p overlay))))
                          (when (eq kind :endings)
                            (assert (string= "tail" (lem-core::line-endings-overlay-text overlay)))
                            (assert (= 2 (lem-core::line-endings-overlay-offset overlay)))))
                     (dispose-overlay overlay))
                   (assert (same-points-p before (tracked-points buffer)))))
               (dolist (bad (list nil unknown 17 "attribute" '(attribute) bad-name))
                 (unchanged-after-rejection (lambda () (construct kind bad)))))
             (dolist (kind '(:overlay :endings))
               (let* ((before (tracked-points buffer))
                      (overlay (construct kind object t)))
                 (unwind-protect
                      (progn
                        (assert (lem-core::overlay-temporary-p overlay))
                        (assert (not (member overlay (lem:buffer-overlays buffer))))
                        (assert (member (lem:overlay-start overlay) (tracked-points buffer)))
                        (assert (member (lem:overlay-end overlay) (tracked-points buffer))))
                   (dispose-overlay overlay))
                 (assert (same-points-p before (tracked-points buffer)))))
             ;; Protect the first owned allocation if the second copy rejects its kind.
             (dolist (kind '(:overlay :endings))
               (dolist (key '(:start-point-kind :end-point-kind))
                 (unchanged-after-rejection
                  (lambda ()
                    (ecase kind
                      (:overlay (apply #'lem:make-overlay start end object (list key :invalid)))
                      (:endings (apply #'lem:make-line-endings-overlay start end object
                                       :text "tail" (list key :invalid))))))))
             (dolist (class '(lem-core::overlay lem-core::line-overlay
                              lem-core::line-endings-overlay lem-core::cursor-overlay))
               (dolist (attribute (list object 'lem-core::cursor))
                 (let ((overlay (apply #'make-instance class :attribute attribute :text "tail" :fake t
                                       :unrecognized :accepted (initargs))))
                   (assert (eq (lem:ensure-attribute attribute) (lem:overlay-attribute overlay)))
                   (assert (eq start (lem:overlay-start overlay)))
                   (assert (eq end (lem:overlay-end overlay)))
                   (assert (null (lem-core::overlay-plist overlay)))
                   (assert (lem-core::overlay-alive-p overlay)))))
             (let* ((args (append (list :attribute counted-name :attribute unknown) (initargs)))
                    (saved (copy-list args)) (previous-calls calls)
                    (overlay (apply #'make-instance 'lem-core::overlay args)))
               (assert (equal saved args))
               (assert (= (1+ previous-calls) calls))
               (assert (eq object (lem:overlay-attribute overlay))))
             (let* ((previous-calls calls)
                    (overlay (apply #'make-instance 'lem-core::overlay
                                    :attribute object :attribute counted-name (initargs))))
               (assert (= previous-calls calls))
               (assert (eq object (lem:overlay-attribute overlay))))
             (assert (rejected-p (lambda () (apply #'make-instance 'lem-core::overlay
                                                  :attribute unknown :attribute object (initargs)))))
             (assert (rejected-p (lambda () (apply #'make-instance 'lem-core::overlay (initargs)))))
             (dolist (class '(nil-default-overlay nil-initform-overlay))
               (assert (rejected-p (lambda () (apply #'make-instance class (initargs))))))
             (let ((overlay (apply #'make-instance 'initform-overlay (initargs))))
               (assert (typep (lem:overlay-attribute overlay) 'lem:attribute)))
             (let ((overlay (apply #'make-instance 'default-overlay :extra :supplied (initargs))))
               (assert (eq :supplied (extra overlay)))
               (assert (eq (lem:ensure-attribute 'lem-core::cursor) (lem:overlay-attribute overlay)))
               (let ((previous-calls calls))
                 (assert (eq object (lem:set-overlay-attribute counted-name overlay)))
                 (assert (= (1+ previous-calls) calls)))
               (assert (eq counted-name (writer-input overlay)))
               (dolist (name '(lem/isearch:isearch-highlight-attribute
                               lem/isearch:isearch-highlight-active-attribute))
                 (assert (eq (lem:ensure-attribute name) (lem:set-overlay-attribute name overlay))))
               (dolist (attribute (list object subobject nil))
                 (assert (eq attribute (lem:set-overlay-attribute attribute overlay)))
                 (assert (eq attribute (lem:overlay-attribute overlay))))
               (lem:set-overlay-attribute object overlay)
               (dolist (bad (list unknown 17 "attribute" bad-name))
                 (assert (rejected-p (lambda () (lem:set-overlay-attribute bad overlay))))
                 (assert (eq object (lem:overlay-attribute overlay))))
               (assert (null (lem:set-overlay-attribute nil-name overlay)))
               (assert (null (lem:overlay-attribute overlay)))
               (assert (eq object (lem:set-overlay-attribute object overlay)))
               ;; MIRICL's checked raw-slot boundary remains independent of writers.
               (assert (typep (rejected-p (lambda () (setf (slot-value overlay 'lem-core::attribute)
                                                          'lem-core::cursor))) 'type-error))
               (assert (eq object (lem:overlay-attribute overlay))))
             (let ((overlay (apply #'make-instance 'default-overlay :attribute subobject (initargs))))
               (assert (eq :default (extra overlay)))
               (assert (eq subobject (lem:overlay-attribute overlay))))
             (let ((overlay (lem-core::make-cursor-overlay* start)))
               (assert (typep (lem:overlay-attribute overlay) '(or null lem:attribute))))
             (lem:insert-string start "λ")
             (assert (string= "λabcd" (lem:buffer-text buffer)))
             t))
      (dolist (name (list nil-name bad-name counted-name)) (remprop name 'lem-core::attribute))
      (lem:clear-overlays buffer)
      (lem:delete-buffer buffer))))
