;;;; Basic contracts for an actual loaded portable IDE MOP facade.
(defpackage #:lem-browser-ide-mop-tests
  (:use #:cl)
  (:export #:check-backend #:check-micros-inspector))
(in-package #:lem-browser-ide-mop-tests)

(defclass sample-base () ())
(defclass sample (sample-base)
  ((documented :initarg :documented :initform 17
               :documentation "Retained IDE sample documentation")
   (undocumented :initform 23)))
(defgeneric sample-function (object))
(defmethod sample-function ((object sample))
  (slot-value object 'documented))
(defvar *extension-calls* 0)

(defun %symbol (name package)
  (or (find-symbol name package) (error "Missing MOP name ~A." name)))
(defun %call (package name &rest arguments)
  (apply (%symbol name package) arguments))
(defun %slot (slots name)
  (or (find name slots :key #'miricl-mop:slot-definition-name)
      (error "Missing sample slot ~S." name)))

(defun %check-boundary ()
  (assert (handler-case (progn (miricl-ide-mop:import-native-mop '(bad . target)) nil)
            (type-error () t)))
  (let* ((target (make-package (symbol-name (gensym "IDE-MOP-COLLISION-")) :use nil))
         (first (intern "CLASS-SLOTS" target))
         (occupied (intern "SLOT-DEFINITION-NAME" target)))
    (unwind-protect
         (progn
           (export (list first occupied) target)
           (setf (fdefinition occupied) (lambda () :occupied))
           (let ((original (fdefinition occupied)))
             (assert (handler-case (progn (miricl-ide-mop:import-native-mop target) nil)
                       (package-error () t)))
             (assert (eq (find-symbol "CLASS-SLOTS" target) first))
             (assert (eq (find-symbol "SLOT-DEFINITION-NAME" target) occupied))
             (assert (eq (fdefinition occupied) original)))
           (fmakunbound occupied)
           (miricl-ide-mop:import-native-mop target)
           (assert (eq (find-symbol "CLASS-SLOTS" target) 'miricl-mop:class-slots))
           (miricl-ide-mop:import-native-mop target))
      (delete-package target))))

(defun check-backend (package)
  (%check-boundary)
  (let ((package (find-package package)))
    (assert package)
    (multiple-value-bind (mapped unsupported)
        (miricl-ide-mop:import-native-mop package)
      (assert (eq mapped package))
      (assert (member "GENERIC-FUNCTION-DECLARATIONS" unsupported :test #'string=)))
    (assert (eq (%symbol "STANDARD-CLASS" package) 'standard-class))
    (assert (eq (%symbol "CLASS-NAME" package) 'class-name))
    (assert (eq (%symbol "METHOD-QUALIFIERS" package) 'method-qualifiers))
    (assert (eq (find-class (%symbol "STANDARD-SLOT-DEFINITION" package))
                (find-class 'miricl-mop:standard-slot-definition)))
    (assert (eq (fdefinition (%symbol "CLASS-SLOTS" package))
                (fdefinition 'miricl-mop:class-slots)))
    (assert (eq (%symbol "SLOT-DEFINITION-DOCUMENTATION" package)
                'miricl-ide-mop:slot-definition-documentation))
    (let* ((class (find-class 'sample))
           (direct (%call package "CLASS-DIRECT-SLOTS" class))
           (documented (%slot direct 'documented))
           (undocumented (%slot direct 'undocumented))
           (gf #'sample-function)
           (method (find-method gf nil (list class))))
      (%call package "FINALIZE-INHERITANCE" class)
      (assert (member (find-class 'sample-base)
                      (%call package "CLASS-PRECEDENCE-LIST" class)))
      (assert (member :documented (%call package "SLOT-DEFINITION-INITARGS" documented)))
      (assert (equal (%call package "SLOT-DEFINITION-DOCUMENTATION" documented)
                     "Retained IDE sample documentation"))
      (assert (null (%call package "SLOT-DEFINITION-DOCUMENTATION" undocumented)))
      (let* ((effective (%slot (%call package "CLASS-SLOTS" class) 'documented))
             (old (documentation effective t)))
        (unwind-protect
             (progn
               (assert (null old))
               (setf (documentation effective t) "Assigned effective documentation")
               (assert (equal (%call package "SLOT-DEFINITION-DOCUMENTATION" effective)
                              "Assigned effective documentation")))
          (setf (documentation effective t) old)))
      (assert (member method (%call package "GENERIC-FUNCTION-METHODS" gf)))
      (assert (eq gf (%call package "METHOD-GENERIC-FUNCTION" method)))
      (assert (member class (%call package "METHOD-SPECIALIZERS" method)))
      (multiple-value-bind (methods definite)
          (%call package "COMPUTE-APPLICABLE-METHODS-USING-CLASSES" gf (list class))
        (assert definite)
        (assert (member method methods)))
      (assert (= (sample-function (make-instance 'sample)) 17))
      ;; A method installed through the imported identity participates in the
      ;; canonical native GF. Remove exactly that new method afterward.
      (let ((method (eval `(defmethod ,(%symbol "CLASS-SLOTS" package) :around
                              ((class (eql (find-class 'sample))))
                            (incf *extension-calls*)
                            (call-next-method))))
            (*extension-calls* 0))
        (unwind-protect
             (progn (miricl-mop:class-slots class) (assert (plusp *extension-calls*)))
          (remove-method #'miricl-mop:class-slots method))))
    (miricl-ide-mop:import-native-mop package)
    t))

(defun check-micros-inspector ()
  "Exercise the real initialized inspector; do not execute its action closures."
  (let* ((package (or (find-package "MICROS") (error "Micros is not loaded.")))
         (reset (%symbol "RESET-INSPECTOR" package))
         (inspect (%symbol "INSPECT-OBJECT" package))
         (slot (%slot (miricl-mop:class-direct-slots (find-class 'sample)) 'documented)))
    (unwind-protect
         (progn
           (funcall reset)
           (let* ((response (funcall inspect slot))
                  (printed (let ((*print-circle* t) (*print-length* 500) (*print-level* 20))
                             (write-to-string response))))
             (assert (search "Name:" printed))
             (assert (search "Documentation:" printed))
             (assert (search "Retained IDE sample documentation" printed))
             t))
      (funcall reset))))
