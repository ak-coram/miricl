;;;; Genuine same-heap provider for the portable Lisp-mode continuation API.
(defpackage #:lem-lisp-mode/connection
  (:use #:cl #:lem-lisp-mode/errors)
  (:export #:current-connection #:*broadcast* #:with-broadcast-connections
           #:connection #:connection-hostname #:connection-port #:connection-package
           #:connection-prompt-string #:connection-features #:connection-command
           #:connection-process #:connection-process-directory #:connection-system-file-patterns
           #:connection-plist #:self-connection-p #:new-connection #:read-message-string
           #:send-message-string #:send-message #:message-waiting-p #:new-request-id
           #:remote-eval-from-string #:remote-eval #:finish-evaluated #:abort-all
           #:request-connection-info #:request-listener-eval #:read-message #:read-all-messages
           #:connection-pid #:connection-implementation-name #:connection-implementation-version
           #:connection-machine-type #:connection-machine-version #:connection-swank-version
           #:connection-value #:ensure-local-connection #:unsupported-operation
           #:submit-local-form #:submit-local-source #:close-local-connection
           #:finalize-local-requests #:local-request #:local-request-service
           #:connection-session #:connection-requests #:connection-live-p))
(in-package #:lem-lisp-mode/connection)

(defvar *connection* nil)
(defvar *broadcast* nil)
(defvar *request-id-counter* 0)
(defclass <connection> () ())
(defclass connection (<connection>)
  ((owner :initarg :owner :reader connection-owner)
   (generation :initarg :generation :reader connection-generation)
   (session :initform (miricl-ide-services:make-session) :reader connection-session)
   (requests :initform nil :accessor connection-requests)
   (package :initform "COMMON-LISP-USER" :accessor connection-package)
   (prompt :initform "COMMON-LISP-USER" :accessor connection-prompt-string)
   (features :initform (copy-list *features*) :accessor connection-features)
   (command :initform nil :accessor connection-command)
   (process :initform nil :accessor connection-process)
   (directory :initform nil :accessor connection-process-directory)
   (patterns :initform nil :accessor connection-system-file-patterns)
   (plist :initform nil :accessor connection-plist)))
(defstruct local-request connection id service source destination tick callback finalizer
  (kind :eval) (active t))
(defun unsupported-operation (operation)
  (lem:editor-error "Local MIRICL Lisp service: ~A is unavailable." operation))
(defgeneric self-connection-p (connection))
(defmethod self-connection-p ((connection <connection>)) nil)
(defmethod self-connection-p ((connection connection)) t)
(defun current-connection () *connection*)
(defun (setf current-connection) (connection) (setf *connection* connection))
(defun connection-hostname (connection) (declare (ignore connection)) "local")
(defun connection-port (connection) (declare (ignore connection)) nil)
(defun connection-pid (connection) (declare (ignore connection)) nil)
(defun connection-implementation-name (connection) (declare (ignore connection)) "MIRICL local")
(defun connection-implementation-version (connection) (declare (ignore connection)) (lisp-implementation-version))
(defun connection-machine-type (connection) (declare (ignore connection)) (machine-type))
(defun connection-machine-version (connection) (declare (ignore connection)) (machine-version))
(defun connection-swank-version (connection) (declare (ignore connection)) nil)
(defgeneric connection-value (connection key))
(defgeneric (setf connection-value) (value connection key))
(defmethod connection-value ((connection connection) key) (getf (connection-plist connection) key))
(defmethod (setf connection-value) (value (connection connection) key)
  (setf (getf (connection-plist connection) key) value))
(defun connection-live-p (connection)
  (and (typep connection 'connection)
       (eq (connection-owner connection) lem-browser:*browser*)
       (connection-generation connection)
       (eq (connection-generation connection)
           (lem-browser::browser-generation (connection-owner connection)))
       (miricl-ide-services:session-live-p (connection-session connection))))
(defun require-editor-thread (browser)
  (unless (and browser (eq (bt2:current-thread) (lem-browser::browser-editor browser)))
    (lem:editor-error "Local Lisp UI requests must run on their owning editor thread.")))
(defun ensure-local-connection ()
  (let ((browser lem-browser:*browser*))
    (require-editor-thread browser)
    (unless (and browser (lem-browser::browser-generation browser)
                 (lem-browser::editor-live-p browser))
      (lem:editor-error "The local Lisp service requires a running browser editor."))
    (let ((connection (lem-browser::browser-services browser)))
      (unless connection
        (setf connection (make-instance 'connection :owner browser
                           :generation (lem-browser::browser-generation browser))
              (lem-browser::browser-services browser) connection)
        (lem-lisp-mode/connections:add-connection connection))
      (unless (connection-live-p connection) (lem:editor-error "The local Lisp session is closing."))
      (setf *connection* connection)
      connection)))
(defmacro with-broadcast-connections ((connection) &body body)
  `(let ((,connection (or (current-connection) (ensure-local-connection)))) ,@body))
(defun new-request-id () (incf *request-id-counter*))
(defun new-connection (hostname port)
  (declare (ignore hostname port)) (unsupported-operation "remote socket connections"))
(defun request-connection-info (connection) connection)
(defun remote-eval (connection form &key continuation thread package request-id)
  (declare (ignore thread))
  (submit-local-form connection form :continuation continuation :package package
                     :request-id request-id))
(defun remote-eval-from-string (connection string &key continuation thread package request-id)
  (declare (ignore connection string continuation thread package request-id))
  (unsupported-operation "remote protocol source strings"))
(defun request-listener-eval (connection string &optional continuation window-width)
  (declare (ignore window-width))
  (submit-local-source connection :eval string :kind :listener :continuation continuation))
(defun finish-evaluated (connection value id)
  (require-editor-thread (connection-owner connection))
  (let ((request (find id (connection-requests connection) :key #'local-request-id)))
    (when (and request (local-request-active request))
      (setf (local-request-active request) nil)
      (let ((callback (local-request-callback request)))
        (setf (local-request-callback request) nil)
        (when callback (funcall callback value))))))
(defun abort-all (connection condition)
  (declare (ignore condition)) (close-local-connection connection))
(defun message-waiting-p (connection &key timeout) (declare (ignore connection timeout)) nil)
(defun read-message-string (connection) (declare (ignore connection)) (unsupported-operation "socket messages"))
(defun read-message (connection) (read-message-string connection))
(defun read-all-messages (connection) (declare (ignore connection)) nil)
(defun send-message (connection message)
  (unless (and (consp message) (eq (first message) :interrupt-thread)
               (consp (cdr message)) (null (cddr message)) (integerp (second message)))
    (unsupported-operation "this protocol message"))
  (let ((request (find (second message) (connection-requests connection) :key #'local-request-id)))
    (when (and request (local-request-service request))
      (miricl-ide-services:cancel (connection-session connection) (local-request-service request))))
  (values))
(defun send-message-string (connection message)
  (declare (ignore message))
  ;; Selected local interrupt commands call the data API directly; no wire
  ;; reader or serialization is used in a same-heap connection.
  (declare (ignore connection)) (unsupported-operation "remote wire messages"))
(defun close-local-connection (connection)
  (miricl-ide-services:close-session (connection-session connection))
  (setf (slot-value connection 'generation) nil)
  (values))
