;;;; Two-pass circularity detection follows the objects actually printed.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $circle-candidate-p (($x :nullable-object)) (i32)
  (:locals ($tag i32))
  #@(local.set $tag (call $tag (local.get $x)))
  #@(if (i32.eq (local.get $tag) (i32.const 6))
    (then (return (ref.is_null (call $symbol-home (local.get $x))))))
  #@(i32.or (i32.or (i32.eq (local.get $tag) (i32.const 7)) (i32.eq (local.get $tag) (i32.const 8)))
    (i32.or (i32.or (i32.eq (local.get $tag) (i32.const 10)) (i32.eq (local.get $tag) (i32.const 23)))
      (i32.le_u (i32.sub (local.get $tag) (i32.const 34)) (i32.const 2)))))

(define-runtime-function $circle-record (($x :nullable-object)) (:nullable-object)
  (:locals ($cell :nullable-object))
  #@(if (i32.eqz (global.get $circle-phase)) (then (return (ref.null eq))))
  #@(local.set $cell (call $hash-cell-native (local.get $x) (global.get $circle-table)))
  #@(if (ref.is_null (local.get $cell)) (then (return (ref.null eq))))
  #@(struct.get $obj $b (ref.cast (ref $obj) (local.get $cell))))

(define-runtime-function $circle-reference (($x :nullable-object)) (i32)
  (:locals ($record :nullable-object) ($label i32))
  #@(if (i32.or (i32.eqz (global.get $circle-phase)) (i32.eqz (call $circle-candidate-p (local.get $x))))
    (then (return (i32.const 0))))
  #@(local.set $record (call $circle-record (local.get $x)))
  #@(if (ref.is_null (local.get $record))
    (then (drop (call $puthash-native (local.get $x) (global.get $circle-table)
      (call $node (i32.const 11) (i32.const 0) (ref.null eq) (ref.null eq) (ref.null eq))))
      (return (i32.const 0))))
  #@(if (i32.eq (global.get $circle-phase) (i32.const 1))
    (then (struct.set $obj $n (ref.cast (ref $obj) (local.get $record)) (i32.const -1)) (return (i32.const 1))))
  #@(local.set $label (call $value-n (local.get $record)))
  #@(if (i32.eqz (local.get $label)) (then (return (i32.const 0))))
  #@(call $emit-char (i32.const 35))
  #@(if (i32.lt_s (local.get $label) (i32.const 0))
    (then
      (global.set $circle-label (i32.add (global.get $circle-label) (i32.const 1)))
      (struct.set $obj $n (ref.cast (ref $obj) (local.get $record)) (global.get $circle-label))
      (call $print-text (call $decimal-text (call $int (global.get $circle-label))))
      (call $emit-char (i32.const 61)) (return (i32.const 0))))
  #@(call $print-text (call $decimal-text (call $int (local.get $label))))
  #@(call $emit-char (i32.const 35))
  #@(i32.const 1))

(define-runtime-function $circle-shared-tail-p (($x :nullable-object)) (i32)
  (:locals ($record :nullable-object))
  #@(if (i32.eqz (global.get $circle-phase)) (then (return (i32.const 0))))
  #@(if (i32.eq (global.get $circle-phase) (i32.const 1))
    (then (return (call $circle-reference (local.get $x)))))
  #@(local.set $record (call $circle-record (local.get $x)))
  #@(if (ref.is_null (local.get $record)) (then (return (i32.const 0))))
  #@(i32.ne (call $value-n (local.get $record)) (i32.const 0)))

(define-runtime-function $circle-root
    (($x :nullable-object) ($depth i32) ($aesthetic i32) ($raw i32) ($stream :nullable-object)) ()
  (:locals ($start i32) ($column i32) ($thrown i32))
  #@(local.set $start (global.get $cursor))
  #@(local.set $column (global.get $format-column))
  #@(global.set $circle-label (i32.const 0))
  #@(global.set $circle-table (call $node (i32.const 29) (i32.const 0)
    (call $symbol (i32.const ,(runtime-symbol-id 'eq))) (ref.null eq) (ref.null eq)))
  #@(global.set $circle-stream (if (result (ref null eq)) (ref.is_null (local.get $stream))
    (then (call $report-stream)) (else (local.get $stream))))
  #@(global.set $circle-phase (i32.const 1))
  #@(block $finished
    (block $failed
      (try_table (catch $transfer $failed)
        (loop $pass
          (if (local.get $raw)
            (then (drop (call $circle-reference (local.get $x)))
              (call $print-default-object (local.get $x) (local.get $depth)))
            (else (if (local.get $aesthetic)
              (then (call $print-aesthetic-depth (local.get $x) (local.get $depth)))
              (else (call $print-object (local.get $x) (local.get $depth))))))
          (br_if $finished (i32.eq (global.get $circle-phase) (i32.const 2)))
          (global.set $cursor (local.get $start)) (global.set $format-column (local.get $column))
          (global.set $circle-phase (i32.const 2)) (br $pass))))
    (local.set $thrown (i32.const 1))
    (if (i32.eq (global.get $circle-phase) (i32.const 1))
      (then (global.set $cursor (local.get $start)) (global.set $format-column (local.get $column)))))
  #@(global.set $circle-phase (i32.const 0))
  #@(global.set $circle-table (ref.null eq))
  #@(global.set $circle-stream (ref.null eq))
  #@(if (local.get $thrown) (then (throw $transfer))))

(define-runtime-function $print-method
    (($function :nullable-object) ($x :nullable-object) ($stream-first i32) ($depth i32)) ()
  (:locals ($stream :nullable-object) ($saved :nullable-object) ($old-depth i32)
           ($dynamic :nullable-object) ($bindings :nullable-object))
  #@(local.set $old-depth (global.get $method-print-depth))
  #@(global.set $method-print-depth (local.get $depth))
  #@(local.set $stream (call $report-stream))
  #@(local.set $dynamic (global.get $dynamic-variables))
  #@(local.set $bindings (call $bind (ref.null eq)
    ,(clos-library-reference '%structure-print-depth) (call $int (local.get $depth))))
  #@(call $activate-bindings (local.get $bindings) (ref.null eq))
  ;; Bit zero selects the pretty printer's stream-first convention. Bit one
  ;; supplies the standard aesthetic printer bindings to user methods.
  #@(if (i32.and (local.get $stream-first) (i32.const 2))
    (then
      (local.set $bindings (call $bind (ref.null eq)
        (call $symbol (i32.const ,(runtime-symbol-id '*print-escape*))) (ref.null eq)))
      (local.set $bindings (call $bind (local.get $bindings)
        (call $symbol (i32.const ,(runtime-symbol-id '*print-readably*))) (ref.null eq)))
      (call $activate-bindings (local.get $bindings) (ref.null eq))))
  #@(local.set $saved (global.get $circle-stream))
  #@(if (global.get $circle-phase) (then (global.set $circle-stream (local.get $stream))))
  #@(block $failed
    (try_table (catch $transfer $failed)
      (drop (call $apply (local.get $function)
        (if (result (ref null eq)) (i32.and (local.get $stream-first) (i32.const 1))
          (then (call $cons (local.get $stream) (call $cons (local.get $x) (ref.null eq))))
          (else (call $cons (local.get $x) (call $cons (local.get $stream) (ref.null eq)))))))
      (global.set $circle-stream (local.get $saved))
      (global.set $dynamic-variables (local.get $dynamic))
      (global.set $method-print-depth (local.get $old-depth))
      (call $print-text (call $report-text (local.get $stream))) (return)))
  #@(global.set $circle-stream (local.get $saved))
  #@(global.set $dynamic-variables (local.get $dynamic))
  #@(global.set $method-print-depth (local.get $old-depth))
  #@(throw $transfer))

(define-runtime-section print-circle-runtime-wat ()
  #@(global $method-print-depth (mut i32) (i32.const 0))
  #@(global $circle-phase (mut i32) (i32.const 0))
  #@(global $circle-label (mut i32) (i32.const 0))
  #@(global $circle-table (mut (ref null eq)) (ref.null eq))
  #@(global $circle-stream (mut (ref null eq)) (ref.null eq))
  ($circle-candidate-p) ($circle-record) ($circle-reference) ($circle-shared-tail-p) ($circle-root) ($print-method))
