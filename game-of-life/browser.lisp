(in-package :life)

;; Browser effects stay at this boundary; the simulation returns new values.
(defvar *canvas* nil)
(defvar *context* nil)
(defvar *timer* nil)
(defvar *stroke* nil)
(defvar *connected* nil)

(defun dom (id) (js:invoke (js:global "document") "getElementById" id))
(defun text (id value) (setf (js:property (dom id) "textContent") value))
(defun number-property (object name) (js:from-js (js:property object name)))

(defun stop ()
  (when *timer* (js:call (js:global "clearInterval") *timer*))
  (setf *timer* nil)
  (text "run" "Run")
  (js:invoke (dom "run") "setAttribute" "aria-pressed" "false"))

(defun report-error (condition)
  (stop)
  (text "status" (format nil "~A" condition))
  (js:invoke (js:property (dom "status") "classList") "add" "error"))

(defun listen (node event function)
  (js:invoke node "addEventListener" event
    (js:callback (lambda (event)
      (handler-case (funcall function event)
        (error (condition) (report-error condition)))
      js:+undefined+))))

(defun render ()
  (when *context*
    (let ((size (/ (number-property *canvas* "width") (world-width *world*))))
      (setf (js:property *context* "fillStyle") "#ffffea")
      (js:invoke *context* "fillRect" 0 0 (number-property *canvas* "width")
                                             (number-property *canvas* "height"))
      (dotimes (y (world-height *world*))
        (dotimes (x (world-width *world*))
          (setf (js:property *context* "fillStyle")
                (if (fset2:contains? (world-cells *world*) (cell-index *world* x y))
                    "#222222" "#eeeecc"))
          (js:invoke *context* "fillRect" (1+ (* x size)) (1+ (* y size)) (- size 2) (- size 2)))))
    (text "generation" (format nil "~4,'0D" (world-generation *world*)))
    (text "population" (format nil "~3,'0D" (fset2:size (world-cells *world*))))
    (text "ascii" (ascii-grid)))
  (values))

(defun tick ()
  (setf *world* (next-generation *world*))
  (render)
  *world*)

(defun toggle-running ()
  (if *timer* (stop)
      (progn
        (text "run" "Pause")
        (js:invoke (dom "run") "setAttribute" "aria-pressed" "true")
        (setf *timer*
          (js:call (js:global "setInterval")
            (js:callback (lambda ()
              (handler-case (tick) (error (condition) (report-error condition)))
              js:+undefined+)) 300)))))

(defun event-cell (event)
  (let* ((box (js:invoke *canvas* "getBoundingClientRect"))
         (x (floor (* (/ (- (number-property event "clientX") (number-property box "left"))
                          (number-property box "width")) (world-width *world*))))
         (y (floor (* (/ (- (number-property event "clientY") (number-property box "top"))
                          (number-property box "height")) (world-height *world*)))))
    (when (and (<= 0 x) (< x (world-width *world*)) (<= 0 y) (< y (world-height *world*)))
      (cons x y))))

(defun begin-stroke (event)
  (when (zerop (number-property event "button"))
    (js:invoke event "preventDefault")
    (stop)
    (let ((cell (event-cell event)))
      (when cell
        (let ((alive (not (fset2:contains? (world-cells *world*)
                                         (cell-index *world* (car cell) (cdr cell))))))
          (setf *stroke* (cons alive cell)
                *world* (paint *world* (car cell) (cdr cell) alive)))
        (js:invoke *canvas* "setPointerCapture" (js:property event "pointerId"))
        (render)))))

(defun continue-stroke (event)
  (let ((cell (and *stroke* (event-cell event))))
    (when cell
      (let* ((previous (cdr *stroke*))
             (dx (- (car cell) (car previous))) (dy (- (cdr cell) (cdr previous)))
             (distance (max (abs dx) (abs dy))))
        ;; Fill the gaps when the pointer crosses several cells between events.
        (loop for i from 1 to distance do
          (setf *world* (paint *world* (+ (car previous) (round (* dx i) distance))
                                      (+ (cdr previous) (round (* dy i) distance))
                                      (car *stroke*))))
        (setf (cdr *stroke*) cell)
        (render)))))

(defun start ()
  (setf *canvas* (dom "grid") *context* (js:invoke *canvas* "getContext" "2d"))
  (unless *connected*
    (listen *canvas* "pointerdown" #'begin-stroke)
    (listen *canvas* "pointermove" #'continue-stroke)
    (dolist (event '("pointerup" "pointercancel" "lostpointercapture"))
      (listen *canvas* event (lambda (event) (declare (ignore event)) (setf *stroke* nil))))
    (listen (dom "run") "click" (lambda (event) (declare (ignore event)) (toggle-running)))
    (listen (dom "step") "click" (lambda (event) (declare (ignore event)) (stop) (tick)))
    (listen (dom "clear") "click"
      (lambda (event) (declare (ignore event))
        (stop) (setf *world* (empty-world (world-width *world*) (world-height *world*))) (render)))
    (let ((buttons (js:invoke (js:global "document") "querySelectorAll" "[data-pattern]")))
      (dotimes (i (number-property buttons "length"))
        (let* ((button (js:invoke buttons "item" i))
               (pattern (if (string= (js:from-js (js:invoke button "getAttribute" "data-pattern"))
                                     "r-pentomino") :r-pentomino :glider)))
          (listen button "click" (lambda (event) (declare (ignore event))
                                   (stop) (setf *world* (seed pattern *world*)) (render))))))
    (listen *canvas* "keydown"
      (lambda (event)
        (let ((key (js:from-js (js:property event "key"))))
          (cond ((string= key " ") (js:invoke event "preventDefault") (toggle-running))
                ((string-equal key "n") (js:invoke event "preventDefault") (stop) (tick))))))
    (setf *connected* t))
  (let ((buttons (js:invoke (js:global "document") "querySelectorAll" "button")))
    (dotimes (i (number-property buttons "length"))
      (setf (js:property (js:invoke buttons "item" i) "disabled") nil)))
  (js:invoke *canvas* "setAttribute" "aria-disabled" "false")
  (text "status" "Ready")
  (render)
  (setf (js:property (js:global) "lifeReady") t)
  (values))
