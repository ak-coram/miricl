set shell := ['bash', '-euo', 'pipefail', '-c']

wasmtime := env('WASMTIME', 'wasmtime')
node := env('NODE', 'node')

repl := quote(wasmtime) + ' run -W stack-switching=y -W max-wasm-stack=16777216 -W async-stack-size=33554432 -S p3=y'

# List application commands. Run `just setup-game-of-life` in the parent first.
default:
    @just --list

# Open http://127.0.0.1:8000/dev.html; optional extra REPL flags follow the ports.
[positional-arguments]
[script('bash', '-euo', 'pipefail')]
dev http='8000' websocket='4006' *options:
    # Quicklisp distributions have different dependency sets. Resolve only
    # directories prepared for this application, and only when starting WASI.
    preopens=(--dir .::.)
    for directory in runtime images quicklisp/*; do
        [[ -d "$directory" ]] || continue
        preopen_target=$({{quote(node)}} -e 'process.stdout.write(require("node:fs").realpathSync(process.argv[1]))' "$directory")
        preopens+=(--dir "$preopen_target::$directory")
    done
    exec {{repl}} "${preopens[@]}" -S inherit-network=y miricl-repl.wasm --dev-server --http-port="$1" --websocket-port="$2" "${@:3}"

# Compile with the precompiled compiler; publish four separate production files.
build:
    {{ quote(node) }} runtime/miricl.js miricl-repl.wasm --optimize game-of-life --native --entry LIFE:START --output build/game-of-life.wasm --report build/retention.txt
    cp index.html runtime/miricl.js images/miricl.wasm build/
    {{ quote(node) }} runtime/version-assets.mjs build index.html miricl.js miricl.wasm game-of-life.wasm
