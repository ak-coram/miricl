;;;; Endian-stable object transport and memory management.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $read32
    ()
    (i32)
  (:locals ($p i32))
  #@(local.set $p (global.get $cursor))
  (wat-fail-when #@(i32.gt_u (i32.add (local.get $p) (i32.const 4)) (global.get $limit)) :malformed-form)
  #@(global.set $cursor (i32.add (local.get $p) (i32.const 4)))
  #@(i32.load (local.get $p)))

;; Function transport handles preserve closure identity across host requests.
(define-runtime-function $function-handle (($x :nullable-object)) (i32)
  (:locals ($scan :nullable-object) ($id i32))
  #@(local.set $scan (global.get $function-objects))
  #@(local.set $id (global.get $next-function))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $id (i32.sub (local.get $id) (i32.const 1)))
    (if (ref.eq (call $car (local.get $scan)) (local.get $x)) (then (return (local.get $id))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(global.set $function-objects (call $cons (local.get $x) (global.get $function-objects)))
  #@(global.set $next-function (i32.add (global.get $next-function) (i32.const 1)))
  #@(i32.sub (global.get $next-function) (i32.const 1)))

(define-runtime-function $function-object (($id i32)) (:nullable-object)
  (:locals ($scan :nullable-object) ($n i32))
  (wat-fail-when #@(i32.ge_u (local.get $id) (global.get $next-function)) :malformed-form)
  #@(local.set $scan (global.get $function-objects))
  #@(local.set $n (i32.sub (i32.sub (global.get $next-function) (local.get $id)) (i32.const 1)))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $n)))
    (local.set $scan (call $cdr (local.get $scan)))
    (local.set $n (i32.sub (local.get $n) (i32.const 1))) (br $next)))
  #@(call $car (local.get $scan)))

(define-runtime-function $read
    ()
    (:nullable-object)
  (:locals ($tag i32)
           ($n i32)
           ($i i32)
           ($length i32)
           ($digits :digits)
           ($a :nullable-object)
           ($b :nullable-object)
           ($head :nullable-object) ($tail :nullable-object) ($cell :nullable-object)
           ($f f64))
  #@(local.set $tag (call $read32))
  #@(if (i32.eqz (local.get $tag)) (then (return (ref.null $obj))))
  #@(if (i32.or (i32.eq (local.get $tag) (i32.const 1)) (i32.eq (local.get $tag) (i32.const 10)))
      (then
        (local.set $n (call $read32)) (local.set $length (call $read32))
        ,(wat-fail-when #@(i32.gt_u (local.get $length) (i32.div_u (i32.sub (global.get $limit) (global.get $cursor)) (i32.const 4))) :malformed-form)
        (local.set $digits (array.new_default $digits (local.get $length)))
        (block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
          (array.set $digits (local.get $digits) (local.get $i) (call $read32))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
        (if (i32.eq (local.get $tag) (i32.const 1))
            (then ,(wat-fail-when #@(i32.eqz (local.get $length)) :malformed-form)
                  (return (call $integer (local.get $n) (local.get $digits)))))
        (return ,(wat-new-object :string
                  :digits #@(local.get $digits)))))
  #@(if (i32.or (i32.eq (local.get $tag) (i32.const 3)) (i32.eq (local.get $tag) (i32.const 4)))
      (then (local.set $i (global.get $cursor)) (drop (call $read32)) (drop (call $read32))
            (return (call $float (local.get $tag) (f64.load (local.get $i))))))
  #@(if (i32.eq (local.get $tag) (i32.const 6)) (then (return (call $symbol-object (call $read32)))))
  #@(if (i32.eq (local.get $tag) (i32.const 12)) (then (return (call $package-by-id (call $read32)))))
  #@(if (i32.eq (local.get $tag) (i32.const 8)) (then (return (call $function-object (call $read32)))))
  #@(if (i32.or (i32.or (i32.or (i32.eq (local.get $tag) (i32.const 28)) (i32.eq (local.get $tag) (i32.const 29)))
                                (i32.le_u (i32.sub (local.get $tag) (i32.const 37)) (i32.const 9)))
        (i32.or (i32.or (i32.or (i32.eq (local.get $tag) (i32.const 22)) (i32.eq (local.get $tag) (i32.const 39))) (i32.eq (local.get $tag) (i32.const 23)))
                 (i32.or (i32.eq (local.get $tag) (i32.const 17)) (i32.eq (local.get $tag) (i32.const 19)))))
      (then (local.set $a (call $function-object (call $read32)))
        ,(wat-fail-when #@(i32.ne (call $tag (local.get $a)) (local.get $tag)) :malformed-form)
        (return (local.get $a))))
  #@(if (i32.eq (local.get $tag) (i32.const 16))
      (then (return (call $node (i32.const 16) (call $read32) (ref.null $obj) (ref.null $obj) (ref.null $obj)))))
  #@(if (i32.eq (local.get $tag) (i32.const 34)) (then (return (call $read-vector))))
  #@(if (i32.eq (local.get $tag) (i32.const 35)) (then (return (call $read-array))))
  #@(if (i32.eq (local.get $tag) (i32.const 36)) (then (return (call $read-bit-vector))))
  #@(if (i32.eq (local.get $tag) (i32.const 7))
    (then
      (block $done (loop $next
        (local.set $cell (call $cons (call $read) (ref.null $obj)))
        (if (ref.is_null (local.get $head)) (then (local.set $head (local.get $cell)))
          (else (struct.set $obj $b (local.get $tail) (local.get $cell))))
        (local.set $tail (local.get $cell))
        (br_if $next (i32.eq (call $read32) (i32.const 7)))
        (global.set $cursor (i32.sub (global.get $cursor) (i32.const 4)))))
      (struct.set $obj $b (local.get $tail) (call $read))
      (return (local.get $head))))
  #@(local.set $a (call $read))
  #@(local.set $b (call $read))
  #@(if (i32.eq (local.get $tag) (i32.const 2))
      (then (return (call $ratio (ref.as_non_null (local.get $a)) (ref.as_non_null (local.get $b))))))
  #@(if (i32.eq (local.get $tag) (i32.const 5))
      (then (return (call $complex (ref.as_non_null (local.get $a)) (ref.as_non_null (local.get $b))))))
  (wat-fail :malformed-form)
  #@(ref.null $obj))

(define-runtime-function $reserve
    (($bytes i32))
    ()
  (:locals ($end i32)
           ($pages i32))
  #@(local.set $end (i32.add (global.get $cursor) (local.get $bytes)))
  (wat-fail-when #@(i32.lt_u (local.get $end) (global.get $cursor)) :allocation)
  #@(local.set $pages (i32.shr_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 16)))
  #@(if (i32.gt_u (local.get $pages) (memory.size))
      (then ,(wat-fail-when #@(i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1)) :allocation))))

(define-runtime-function $write32
    (($n i32))
    ()
  #@(call $reserve (i32.const 4))
  #@(i32.store (global.get $cursor) (local.get $n))
  #@(global.set $cursor (i32.add (global.get $cursor) (i32.const 4))))

(define-runtime-function $write
    (($x :nullable-object))
    ()
  (:locals ($tag i32)
           ($i i32)
           ($n i32))
  #@(loop $write-next
    (local.set $i (i32.const 0))
    (local.set $tag (call $tag (local.get $x)))
    (call $write32 (local.get $tag))
    (if (i32.eqz (local.get $tag)) (then (return)))
    (if (i32.eq (local.get $tag) (i32.const 34)) (then (call $write-vector (local.get $x)) (return)))
    (if (i32.eq (local.get $tag) (i32.const 35)) (then (call $write-array (local.get $x)) (return)))
    (if (i32.eq (local.get $tag) (i32.const 36)) (then (call $write-bit-vector (local.get $x)) (return)))
    (if (i32.or (i32.eq (local.get $tag) (i32.const 1)) (i32.eq (local.get $tag) (i32.const 10)))
        (then
          (call $write32 (struct.get $obj $n (local.get $x)))
          (local.set $n (array.len (struct.get $obj $digits (local.get $x)))) (call $write32 (local.get $n))
          (block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
            (call $write32 (array.get $digits (struct.get $obj $digits (local.get $x)) (local.get $i)))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next))) (return)))
    (if (i32.or (i32.eq (local.get $tag) (i32.const 3)) (i32.eq (local.get $tag) (i32.const 4)))
        (then (call $reserve (i32.const 8)) (f64.store (global.get $cursor) (struct.get $obj $f (local.get $x)))
              (global.set $cursor (i32.add (global.get $cursor) (i32.const 8))) (return)))
    (if (i32.eq (local.get $tag) (i32.const 6))
        (then (call $register-symbol (ref.as_non_null (local.get $x)))
              (call $write32 (struct.get $obj $n (local.get $x)))
              (call $write (call $symbol-name (local.get $x)))
              (call $write (struct.get $obj $b (local.get $x))) (return)))
    (if (i32.or (i32.or (i32.or (i32.eq (local.get $tag) (i32.const 28)) (i32.eq (local.get $tag) (i32.const 29)))
                                  (i32.le_u (i32.sub (local.get $tag) (i32.const 37)) (i32.const 9)))
          (i32.or (i32.or (i32.or (i32.eq (local.get $tag) (i32.const 22)) (i32.eq (local.get $tag) (i32.const 39))) (i32.eq (local.get $tag) (i32.const 23)))
          (i32.or (i32.eq (local.get $tag) (i32.const 8))
            (i32.or (i32.eq (local.get $tag) (i32.const 17)) (i32.eq (local.get $tag) (i32.const 19))))))
        (then (call $write32 (call $function-handle (local.get $x))) (return)))
    (if (i32.eq (local.get $tag) (i32.const 16)) (then (call $write32 (struct.get $obj $n (local.get $x))) (return)))
    (if (i32.eq (local.get $tag) (i32.const 12))
        (then (call $write32 (struct.get $obj $n (local.get $x)))
              (call $write (call $car (struct.get $obj $a (local.get $x)))) (return)))
    (if (i32.or (i32.eq (local.get $tag) (i32.const 2))
        (i32.or (i32.eq (local.get $tag) (i32.const 5)) (i32.eq (local.get $tag) (i32.const 7))))
        (then (call $write (struct.get $obj $a (local.get $x)))
              (local.set $x (struct.get $obj $b (local.get $x))) (br $write-next)))
    ,(wat-fail :unsupported)))

(define-runtime-function $unbound-variable-name (($length i32)) (i32)
  (:export "unbound-variable-name")
  #@(global.set $cursor (i32.const 0))
  #@(call $write32 (i32.const 14))
  #@(call $write (call $cons (call $symbol-object (global.get $unbound-symbol)) (ref.null $obj)))
  #@(global.get $cursor))

(define-runtime-section io-runtime-wat ()
  #@(global $cursor (mut i32) (i32.const 0))
  #@(global $limit (mut i32) (i32.const 0))
  #@(global $function-objects (mut (ref null $obj)) (ref.null $obj))
  #@(global $next-function (mut i32) (i32.const 0))
  ($unbound-variable-name)
  ($function-handle) ($function-object)
  ($read32)
  ($read)
  ($reserve)
  ($write32)
  ($write))

(define-runtime-function $evaluate
    (($length i32))
    (i32)
  (:export "evaluate")
  (:locals ($form :nullable-object)
           ($result :nullable-object))
  #@(global.set $error (i32.const 0))
  #@(global.set $cursor (i32.const 0))
  #@(global.set $limit (local.get $length))
  #@(local.set $form (call $read))
  (wat-fail-when #@(i32.ne (global.get $cursor) (global.get $limit)) :malformed-form)
  #@(local.set $result (call $eval (local.get $form) (ref.null $obj)))
  #@(global.set $cursor (i32.const 0))
  #@(call $write32 (i32.const 14))
  #@(call $write (call $value-list (local.get $result)))
  #@(global.get $cursor))
