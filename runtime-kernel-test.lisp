;;;; Behavioral coverage for compiled Common Lisp runtime kernels.
;;;; The host checks exercise ordinary CL bodies; guest checks exercise their
;;;; checked runtime entry points. No generated-code or inventory assumptions.
(in-package #:miricl-test)
(in-suite :miricl)

(test runtime-kernel-private-argument-validation
  ;; Validation is shared by the CL reporter and native checked-call boundary.
  ;; The native adapter chooses its precise arity condition after a false result.
  (dolist (case (list (list #(1 2) 2 2 t) (list #(1 2) 1 3 t)
                     (list #(1 2) 3 3 nil) (list #(1 2) 0 1 nil)
                     (list #(1 2) 3 -1 nil) (list #(1 2) 0 -1 t)
                     (list '(1 2) 2 2 t) (list '(1 2) 1 1 nil)
                     (list '(1) 2 -1 nil) (list '(1 2 3) 2 -1 t)
                     (list nil 0 0 t) (list nil 1 1 nil)
                     (list #(1) -1 1 nil)))
    (destructuring-bind (arguments minimum maximum valid) case
      (is (eql valid (miricl-runtime:private-arguments-valid-p arguments minimum maximum)))
      (if valid
          (is (null (miricl-runtime:check-private-arguments arguments minimum maximum)))
          (signals program-error
            (miricl-runtime:check-private-arguments arguments minimum maximum)))))
  (m:with-interpreter (vm)
    (dolist (form '("(car)" "(funcall #'car)" "(funcall #'car '(1) '(2))"))
      (is (eq t (m:evaluate-string vm
        (concatenate 'string "(handler-case (progn " form " nil) (program-error () t))")))))
    (is (eql 42 (m:evaluate-string vm "(+ 40 2)")))))

(test runtime-kernel-copy-array-storage
  ;; The shared internal copy also serves ADJUST-ARRAY: its validated region
  ;; can cover physical slots beyond the logical sequence fill pointer.
  (let ((source (make-array 4 :fill-pointer 1 :initial-contents '(11 22 33 44)))
        (target (make-array 6 :fill-pointer 0 :initial-element :new)))
    (miricl-runtime:copy-sequence-values target source '(1 0 4))
    (is (= 0 (fill-pointer target)))
    (is (equal '(:new 11 22 33 44 :new)
               (loop for i below (array-total-size target) collect (row-major-aref target i)))))
  (let ((source (make-array '(2 2) :initial-contents '((1 2) (3 4))))
        (target (make-array '(2 3) :initial-element 0)))
    (miricl-runtime:copy-sequence-values target source '(2 1 3))
    (is (equal '(0 0 2 3 4 0)
               (loop for i below (array-total-size target) collect (row-major-aref target i)))))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let ((bytes (make-array 8 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 2
                                  :initial-contents '(11 22 33 44 55 66 77 88))))
           (adjust-array bytes 16 :initial-element 0)
           (and (= 2 (fill-pointer bytes))
                (= 88 (aref bytes 7)) (= 0 (aref bytes 8))
                (progn (replace bytes #(99 98 97 96))
                       (and (= 99 (aref bytes 0)) (= 98 (aref bytes 1))
                            (= 33 (aref bytes 2))))))"))))))

(defun check-runtime-kernel-form (vm form)
  "Run the same portable success case on the bootstrap host and the target."
  (is (eq t (eval form)) "Host result for ~S" form)
  (let ((source (with-standard-io-syntax
                  (let ((*package* (find-package :miricl-test)))
                    (write-to-string form)))))
    (is (eq t (m:evaluate-string vm source)) "Guest result for ~S" form)))

(test runtime-kernel-integer-kernels
  (let* ((large (ash 1 130))
         (integers (list 0 1 -1 2 -2 31 -31 large (- large) (1+ large))))
    (dolist (a integers)
      (dolist (b integers)
        (is (= (gcd a b) (miricl-runtime:integer-gcd a b)))
        (is (= (lcm a b) (miricl-runtime:integer-lcm-list (list a b)))))
      (dolist (index '(0 1 5 63 130 300))
        (is (eql (logbitp index a) (miricl-runtime:integer-bit-present-p index a))))
      (dolist (size '(0 1 9 70))
        (dolist (position '(0 4 100))
          (let ((spec (byte size position)) (private (cons size position)))
            (is (= (dpb a spec (- large 7))
                   (miricl-runtime:deposit-integer-field a private (- large 7) nil)))
            (is (= (deposit-field a spec (- large 7))
                   (miricl-runtime:deposit-integer-field a private (- large 7) t)))))))
    (dolist (value (list 0 1 2 3 4 15 16 17 (1- large) large (1+ large)))
      (is (= (isqrt value) (miricl-runtime:integer-square-root value))))
    (is (= 1 (miricl-runtime:integer-lcm-list nil)))
    ;; A zero result does not excuse a later non-integer argument.
    (signals type-error (miricl-runtime:integer-lcm-list '(0 :bad)))
    (is (= 6 (miricl-runtime:integer-lcm-list '(2 -3)))))
  (dolist (power '(0 1 7 80 130))
    (let ((value (ash 1 power)))
      (is (miricl-runtime:integer-power-of-two-p value))
      (is (miricl-runtime:integer-power-of-two-p (- value)))
      (is (miricl-runtime:integer-all-ones-p (1- value)))
      (is (miricl-runtime:integer-all-ones-p (- (1- value))))))
  (is (not (miricl-runtime:integer-all-ones-p -6)))
  (is (not (miricl-runtime:integer-power-of-two-p 0)))
  (is (= 3600 (miricl-runtime:calendar-zone-value 1)))
  (is (= -1 (miricl-runtime:calendar-zone-value -1/3600)))
  (signals type-error (miricl-runtime:calendar-zone-value 1/7))
  (is (= 1 (miricl-runtime:calendar-zone-value 1/3600)))
  (dolist (bound '(0 1 -1 3/2 -3/2 (0) (1) (-1) (3/2) (-3/2)))
    (let* ((exclusive (consp bound)) (value (if exclusive (car bound) bound)))
      (is (= (if (and exclusive (integerp value)) (1+ value) (ceiling value))
             (miricl-runtime:integer-interval-bound-value bound t)))
      (is (= (if (and exclusive (integerp value)) (1- value) (floor value))
             (miricl-runtime:integer-interval-bound-value bound nil))))))

(test runtime-kernel-copying-and-array-views
  (let* ((element (list :shared)) (source (list element :b :c))
         (copy (miricl-runtime:copy-subsequence-values source 0 2)))
    (is (equal copy (subseq source 0 2)))
    (is (not (eq copy source)))
    (is (not (eq (cdr copy) (cdr source))))
    (is (eq element (car copy)))
    (setf (second copy) :new)
    (is (eq :b (second source))))
  (dolist (source (list (list 0 1 2 3 4) (vector 0 1 2 3 4)))
    (let ((expected (copy-seq source)))
      (replace expected expected :start1 1 :start2 0 :end2 4)
      (miricl-runtime:copy-sequence-values source source '(1 0 4))
      (is (equalp expected source))))
  (let* ((item (list :shared)) (sources (list (list item :b) (vector :c) nil))
         (list (miricl-runtime:concatenate-sequence-values sources 0))
         (vector (miricl-runtime:concatenate-sequence-values sources 2)))
    (is (equal (list item :b :c) list))
    (is (equalp (vector item :b :c) vector))
    (is (eq item (car list)))
    (is (eq item (aref vector 0)))
    (is (not (eq list (car sources)))))
  (is (equalp #*0110 (miricl-runtime:concatenate-sequence-values
                       (list '(0 1) #*10) 3)))
  (let* ((base (make-array 8 :initial-contents '(0 1 2 3 4 5 6 7)))
         (view (make-array 5 :displaced-to base :displaced-index-offset 2
                            :fill-pointer 3))
         (copy (miricl-runtime:copy-subsequence-values view 0 3)))
    (is (equalp #(2 3 4) copy))
    (is (typep copy 'simple-vector))
    (is (not (adjustable-array-p copy)))
    (is (eq view (miricl-runtime:fill-sequence-values view :x 1 3)))
    (is (equalp #(0 1 2 :x :x 5 6 7) base))
    (is (equalp #(2 3 4) copy)))
  (let* ((base (make-array '(2 3) :initial-contents '((0 1 2) (3 4 5))))
         (view (make-array '(2 2) :displaced-to base :displaced-index-offset 1)))
    (miricl-runtime:fill-array-values view 1 2 :changed)
    (is (equalp #2A((0 1 :changed) (:changed 4 5)) base))
    (is (= 3 (miricl-runtime:array-subscript-value view '(1 1) nil)))
    (is (= -1 (miricl-runtime:array-subscript-value view '(2 0) t)))
    (signals type-error (miricl-runtime:array-subscript-value view '(2 0) nil))
    (signals type-error (miricl-runtime:array-subscript-value view '(2 :bad) t))
    (signals program-error (miricl-runtime:array-subscript-value view '(0) nil))
    (is (= 0 (miricl-runtime:array-subscript-value view '(0 0) nil))))
  (let ((bits (make-array 5 :element-type 'bit :initial-contents '(0 1 1 0 1))))
    (let ((copy (miricl-runtime:reverse-vector-value bits nil)))
      (is (equalp #*10110 copy))
      (is (equal (array-element-type bits) (array-element-type copy)))
      (is (equalp #*01101 bits)))))

(test runtime-kernel-list-boundaries-and-recovery
  (is (= 0 (miricl-runtime:proper-list-count nil)))
  (is (= 3 (miricl-runtime:proper-list-count '(1 2 3))))
  (signals type-error (miricl-runtime:proper-list-count '(1 . :bad)))
  (let ((cycle (list :a :b)))
    (setf (cddr cycle) cycle)
    (signals type-error (miricl-runtime:proper-list-count cycle))
    (signals program-error (miricl-runtime:array-contents-count cycle t))
    (signals type-error (miricl-runtime:spread-call-arguments (list 'list cycle)))
    (is (= 2 (miricl-runtime:proper-list-count '(:a :b)))))
  (let* ((last (list :b :c))
         (spread (miricl-runtime:spread-call-arguments (list 'list :a last))))
    (is (equal '(:a :b :c) spread))
    (is (eq last (cdr spread))))
  (signals type-error (miricl-runtime:spread-call-arguments '(list (1 . :bad))))
  (signals program-error (miricl-runtime:spread-call-arguments '(list)))
  (is (equal '(1 2) (miricl-runtime:spread-call-arguments '(list (1 2)))))
  (let* ((items (list :a :b :c)) (vector (vector :a :b :c)))
    (is (eq (cdr items) (miricl-runtime:rest-argument-values items 1)))
    (is (equal '(:b :c) (miricl-runtime:rest-argument-values vector 1)))
    (is (eq :b (miricl-runtime:argument-value vector 1)))
    (is (null (miricl-runtime:argument-value vector 20)))))

(test runtime-kernel-callbacks-and-tree-budgets
  (let ((calls nil)
        (input (vector '(1 . :left-a) '(3 . :left-b) '(1 . :right-a) '(2 . :right-b)))
        (output (make-array 4)))
    (miricl-runtime:merge-ordering-buffers input output
      (list 0 2 4 nil
            (lambda (item) (push (cdr item) calls) (values (car item) :ignored))
            (lambda (a b) (push (list a b) calls) (values (< a b) :ignored))))
    (is (equal '(:left-a :right-a :right-b :left-b) (map 'list #'cdr output)))
    (is (equal '(:right-a :left-a (1 1) :right-a :left-b (1 3)
                 :right-b :left-b (2 3)) (nreverse calls))))
  (let ((calls nil))
    (is (miricl-runtime:tree-value-equal-p '(1 (2 . 3)) '(1 (2 . 3))
          (lambda (a b) (push (list a b) calls) (values (eql a b) nil)) nil))
    (is (equal '((1 1) (2 2) (3 3) (nil nil)) (nreverse calls))))
  (let* ((part (list :shared)) (source (cons part part))
         (copy (car (miricl-runtime:copy-loop-syntax source 3))))
    (is (equal source copy))
    (is (not (eq (car copy) part)))
    (is (not (eq (car copy) (cdr copy)))))
  (let ((cycle (list :cycle)))
    (setf (cdr cycle) cycle)
    (is (equal '(nil . -1) (miricl-runtime:copy-loop-syntax cycle 8)))
    (signals type-error (miricl-runtime:tree-value-equal-p cycle cycle #'eql nil))
    (is (miricl-runtime:tree-value-equal-p '(1 . 2) '(1 . 2) #'eql nil))))

(test runtime-kernel-symbol-and-text-kernels
  (let* ((original (make-symbol "PORT-COPY")) (value (list :shared))
         (property (list :property)) (function (lambda () :called)))
    (setf (symbol-value original) value (symbol-function original) function
          (symbol-plist original) (list :key property))
    (let ((bare (miricl-runtime:copy-symbol-value original nil nil))
          (copy (miricl-runtime:copy-symbol-value original t function)))
      (is (not (eq original copy))) (is (null (symbol-package copy)))
      (is (string= (symbol-name original) (symbol-name copy)))
      (is (not (boundp bare))) (is (not (fboundp bare)))
      (is (null (symbol-plist bare)))
      (is (eq value (symbol-value copy)))
      (is (eq function (symbol-function copy)))
      (is (not (eq (symbol-plist original) (symbol-plist copy))))
      (is (eq property (get copy :key)))
      (setf (get copy :key) :changed)
      (is (eq property (get original :key)))))
  (let ((text (copy-seq "unchanged")))
    (is (eq text (miricl-runtime:text-designator text)))
    (is (eq text (miricl-runtime:trim-text-value '(#\Space) text 0))))
  (is (string= "x" (miricl-runtime:text-designator #\x)))
  (is (string= "KEYWORD" (miricl-runtime:text-designator :keyword)))
  (signals type-error (miricl-runtime:text-designator 17))
  (signals type-error (miricl-runtime:trim-text-value '(#\Space :bad) " x " 0))
  (let ((prefix (make-array 8 :element-type 'character :initial-contents "prefix__" :fill-pointer 6)))
    (is (string= (format nil "prefix~D" (ash 1 100))
                 (miricl-runtime:generated-symbol-text prefix (ash 1 100)))))
  (dolist (text '("" "abc" "aBc" "  abc  "))
    (is (eql (string= text (string-upcase text))
             (miricl-runtime:text-equal-p text (string-upcase text))))
    (is (miricl-runtime:text-fold-equal-p text (string-upcase text)))))

(test runtime-kernel-format-and-path-kernels
  (let ((large (ash 1 100)))
    (is (= -1 (miricl-runtime:format-index-value large)))
    (is (= large (miricl-runtime:format-comparison-value large)))
    (signals program-error (miricl-runtime:format-parameter-value large 0))
    (is (= 7 (miricl-runtime:format-parameter-value nil 7)))
    (is (= (char-code #\A) (miricl-runtime:format-parameter-value #\A 0)))
    (is (= 0 (miricl-runtime:format-minimum-column (- large))))
    (is (= 100 (miricl-runtime:printer-limit-value nil large 100)))
    (is (= 100 (miricl-runtime:printer-limit-value t :ignored 100)))
    (signals type-error (miricl-runtime:printer-limit-value nil -1 100))
    (is (= 2 (miricl-runtime:printer-limit-value nil 2 100))))
  (is (miricl-runtime:format-escape-value-p nil nil nil nil))
  (is (not (miricl-runtime:format-escape-value-p nil nil nil '(1))))
  (is (miricl-runtime:format-escape-value-p 0 nil nil '(1)))
  (is (miricl-runtime:format-escape-value-p 3 3 nil '(1)))
  (is (miricl-runtime:format-escape-value-p 1 2 3 '(1)))
  (is (not (miricl-runtime:format-escape-value-p 3 2 1 nil)))
  (dolist (case '(("abc" "a*c" t) ("ac" "a*c" t) ("abbc" "a*b*c" t)
                  ("abc" "a*d" nil) ("" "**" t) ("x" "?" nil)))
    (destructuring-bind (text pattern expected) case
      (is (eql expected (miricl-runtime:path-component-value-p text pattern
                        (list 0 (length text) 0 (length pattern)))))))
  (dolist (case '(("a/b/" "**/" t) ("" "**/" t) ("a/b/" "a/*/" t)
                  ("a/b/c/" "a/**/c/" t) ("a/c/" "a/**/c/" t)
                  ("a/b/" "a/c/" nil) ("a/b/c/" "a/*/" nil)))
    (destructuring-bind (text pattern expected) case
      (is (eql expected (miricl-runtime:path-directory-value-p text pattern
                        (list 0 (length text) 0 (length pattern)))))))
  (is (miricl-runtime:path-prefix-value-p "/a" "/a/b"))
  (is (not (miricl-runtime:path-prefix-value-p "/a" "/ab")))
  (is (not (miricl-runtime:path-prefix-value-p "/a" "/a"))))

(test runtime-kernel-source-expansion-and-metadata
  (dolist (form '((and) (or) (and t (values 2 3)) (or nil (values 4 5))
                  (or :first (error "short circuit"))))
    (is (equal (multiple-value-list (eval form))
               (multiple-value-list (eval (miricl-runtime:expand-logical-form form))))))
  (dolist (case '(((when t (values 1 2)) 0) ((unless nil (values 3 4)) 1)
                  ((cond ((values 7 8))) 2) ((cond (nil :bad) (t (values 9 10))) 2)))
    (destructuring-bind (form kind) case
      (is (equal (multiple-value-list (eval form))
                 (multiple-value-list (eval (miricl-runtime:expand-conditional-form form kind)))))))
  (dolist (form '((multiple-value-list (values 1 2 3)) (nth-value 1 (values 1 2 3))))
    (is (equal (eval form) (eval (miricl-runtime:expand-values-form form)))))
  (signals program-error (miricl-runtime:expand-values-form '(nth-value 1)))
  (signals program-error (miricl-runtime:expand-conditional-form '(cond ()) 2))
  (let* ((declaration '(declare (special x))) (remainder '(42))
         (body (cons declaration (cons "Documentation" remainder)))
         (split (miricl-runtime:split-function-documentation body)))
    (is (equal (cons declaration remainder) (car split)))
    (is (eq declaration (caar split)))
    (is (eq remainder (cdar split)))
    (is (string= "Documentation" (cdr split)))
    (let ((blocked (miricl-runtime:function-block-forms 'example (car split))))
      (is (eq declaration (car blocked)))
      (is (equal '(block example 42) (second blocked)))))
  (let* ((only-string (list "A return value"))
         (split (miricl-runtime:split-function-documentation only-string)))
    (is (eq only-string (car split))) (is (null (cdr split))))
  (is (equal '(t . t) (miricl-runtime:cons-type-components 'cons)))
  (is (equal '(integer . string) (miricl-runtime:cons-type-components '(cons integer string))))
  (is (equal '(t . integer) (miricl-runtime:cons-type-components '(cons * integer))))
  (signals program-error (miricl-runtime:cons-type-components '(cons t t t)))
  (is (eq 'real (miricl-runtime:complex-component-type '(complex *))))
  (is (eq 'double-float (miricl-runtime:complex-component-type '(complex double-float))))
  (let ((header (map 'string #'code-char '(0 97 115 109 1 0 0 0))))
    (is (miricl-runtime:compiled-byte-header-p header 8))
    (is (not (miricl-runtime:compiled-byte-header-p header 4))))
  (let ((bytes (map 'string #'code-char '(65 10 195 169 66))))
    (is (= 2 (miricl-runtime:text-position-column bytes 5 5)))
    (is (= 4 (miricl-runtime:text-position-column bytes 5 7))))
  (dolist (value '(0 1)) (is (= value (miricl-runtime:checked-bit-value value))))
  (dolist (value '(0.0 2 -1 :bad)) (signals type-error (miricl-runtime:checked-bit-value value)))
  (let ((vector (make-array 2 :fill-pointer 1)))
    (is (eq vector (miricl-runtime:checked-fill-pointer-value vector))))
  (signals type-error (miricl-runtime:checked-fill-pointer-value #(1 2)))
  (let* ((bits (make-array 4 :element-type 'bit))
         (view (make-array 2 :element-type 'bit :displaced-to bits)))
    (is (eq bits (miricl-runtime:checked-bit-array-value bits t)))
    (is (eq view (miricl-runtime:checked-bit-array-value view nil)))
    (signals type-error (miricl-runtime:checked-bit-array-value view t))))

(test runtime-kernel-public-guest-contracts
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (dolist (form
               '((let ((large (ash 1 100)))
                   (and (= 0 (gcd 0 0)) (= 12 (gcd -36 24)) (= 0 (lcm 0 -3))
                        (= (* 3 large) (lcm (- large) 3))
                        (= (1- large) (isqrt (1- (* large large))))
                        (logbitp 150 -1) (not (logbitp 150 large))
                        (= -1 (dpb -1 (byte 0 100) -1))
                        (= 7 (dpb 7 (byte 3 0) 0))
                        (handler-case (progn (lcm 0 :bad) nil) (type-error () t))
                        (= 6 (lcm 2 -3))))
                 (let* ((item (list :shared)) (source (list item :b :c)) (copy (copy-seq source)))
                   (and (equal source copy) (not (eq source copy))
                        (eq item (car copy)) (not (eq (cdr source) (cdr copy)))
                        (let ((list (list 0 1 2 3 4)) (vector (vector 0 1 2 3 4)))
                          (and (eq list (replace list list :start1 1 :end2 4))
                               (equal '(0 0 1 2 3) list)
                               (eq vector (replace vector vector :start1 1 :end2 4))
                               (equalp #(0 0 1 2 3) vector)))
                        (equal '(a b c d) (concatenate 'list '(a b) #(c d)))
                        (equalp #(a b c d) (concatenate 'vector '(a b) #(c d)))
                        (equalp #*0110 (concatenate 'bit-vector '(0 1) #*10))))
                 (let* ((base (make-array 8 :initial-contents '(0 1 2 3 4 5 6 7)))
                        (view (make-array 5 :displaced-to base :displaced-index-offset 2 :fill-pointer 3))
                        (copy (copy-seq view)))
                   (and (equalp #(2 3 4) copy) (typep copy 'simple-vector)
                        (eq view (fill view :x :start 1))
                        (equalp #(0 1 2 :x :x 5 6 7) base)
                        (equalp #(2 3 4) copy)
                        (equalp #*10110 (reverse #*01101))))
                 (let ((array (make-array '(2 3) :initial-contents '((0 1 2) (3 4 5))))
                       (scalar (make-array nil :initial-element 42)))
                   (and (= 5 (array-row-major-index array 1 2))
                        (array-in-bounds-p array 0 2)
                        (not (array-in-bounds-p array 2 0))
                        (handler-case (progn (aref array 1 -1) nil)
                          (type-error (condition) (eql -1 (type-error-datum condition))))
                        (handler-case (progn (array-row-major-index array 0) nil)
                          (error () t))
                        (= 5 (aref array 1 2)) (= 0 (array-row-major-index scalar))
                        (array-in-bounds-p scalar) (= 42 (aref scalar))))
                 (let* ((source (make-symbol "PORT-COPY")) (value (list :shared))
                        (function (lambda () :called)))
                   (setf (symbol-value source) value (symbol-function source) function
                         (symbol-plist source) (list :key value))
                   (let ((bare (copy-symbol source)) (copy (copy-symbol source t)))
                     (and (not (eq source copy)) (null (symbol-package copy))
                          (string= (symbol-name source) (symbol-name copy))
                          (not (boundp bare)) (not (fboundp bare)) (null (symbol-plist bare))
                          (eq value (symbol-value copy)) (eq function (symbol-function copy))
                          (not (eq (symbol-plist source) (symbol-plist copy)))
                          (eq value (get copy :key))
                          (progn (setf (get copy :key) :changed) (eq value (get source :key))))))
                 (let ((calls nil))
                   (and (tree-equal '(1 (2 . 3)) '(1 (2 . 3))
                          :test (lambda (a b) (push (list a b) calls) (values (eql a b) nil)))
                        (equal '((1 1) (2 2) (3 3) (nil nil)) (nreverse calls))
                        (equal '((1 . :a) (1 . :b) (2 . :c))
                          (stable-sort (list '(1 . :a) '(2 . :c) '(1 . :b)) #'< :key #'car))))
                 (let ((calls nil))
                   (and (equal '(2 3) (multiple-value-list (and t (values 2 3))))
                        (equal '(4 5) (multiple-value-list (or nil (values 4 5))))
                        (equal '(6 7) (multiple-value-list (cond (nil :bad) (t (values 6 7)))))
                        (equal '(8 9) (multiple-value-list (when t (values 8 9))))
                        (equal '(10 11) (multiple-value-list (unless nil (values 10 11))))
                        (= 3 (nth-value 1 (values 2 3 4)))
                        (eq :yes (case (progn (push :key calls) :a) (:a :yes) (otherwise :no)))
                        (equal '(:key) calls)))
                 (let ((path (make-pathname :directory '(:absolute "a" "b" "c") :name "file" :type "lisp")))
                   (and (pathname-match-p path
                          (make-pathname :directory '(:absolute "a" :wild-inferiors) :name :wild :type "lisp"))
                        (not (pathname-match-p path
                               (make-pathname :directory '(:absolute "a" :wild) :name :wild :type "lisp")))
                        (pathname-match-p path
                          (make-pathname :directory '(:absolute "a" "b" "c") :name "file" :type :wild))))
                 (and (string= "abc" (string-trim '(#\Space #\Tab) " abc "))
                      (string= "abc " (string-left-trim " " " abc "))
                      (string= " abc" (string-right-trim " " " abc "))
                      (string= "0017" (format nil "~4,'0D" 17))
                      (string= "a,b,c" (format nil "~{~A~^,~}" '("a" "b" "c")))
                      (string= "yes" (format nil "~:[no~;yes~]" t))
                      (string= "   x" (format nil "~4@A" "x"))
                      (let ((a (gensym 0)) (b (gensym 0)))
                        (and (not (eq a b)) (null (symbol-package a))
                             (string= (symbol-name a) (symbol-name b)))))))
        (check-runtime-kernel-form vm form))
      ;; These malformed structures are outside ANSI success-case contracts.
      ;; MIRICL deliberately rejects them and must remain usable afterwards.
      (is (eq t (m:evaluate-string vm
        "(let ((cycle (list 1 2)))
           (setf (cddr cycle) cycle)
           (and (handler-case (progn (length cycle) nil) (type-error () t))
                (handler-case (progn (apply #'list cycle) nil) (type-error () t))
                (handler-case (progn (subseq '(1 2 3) -1) nil) (type-error () t))
                (handler-case (progn (subseq '(1 2 3) 4) nil) (type-error () t))
                (handler-case (progn (apply #'list '(1 . :bad)) nil) (type-error () t))
                (equal '(1 2 3) (apply #'list 1 '(2 3)))
                (equal '(2 3) (subseq '(1 2 3) 1)) (= 2 (length '(a b)))))"))))))

(test runtime-kernel-target-unicode-folding
  ;; Comparison follows the target's installed canonical case table. Its
  ;; nonreciprocal mappings can vary with the bootstrap host's case data.
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(and (string-equal \"aZ\" \"Az\")
              (let ((text (string (code-char 181)))) (string-equal text text))
              (string-equal (string (code-char 955)) (string (code-char 923)))
              (not (string-equal (string (code-char 955)) (string (code-char 931))))
              (every (lambda (pair)
                       (let ((a (code-char (car pair))) (b (code-char (cadr pair))))
                         (eql (not (null (string-equal (string a) (string b))))
                              (char= (miricl::unicode-char-upcase a)
                                     (miricl::unicode-char-upcase b)))))
                     '((181 924) (962 931))))"))))))
