(define-runtime-function $stringp-native (($x :nullable-object)) (i32)
  #@(i32.and (call $vectorp-native (local.get $x))
    (i32.eq (i32.and (call $array-kind (local.get $x)) (i32.const 1)) (i32.const 1))))

(define-runtime-function $upgraded-array-kind (($type :nullable-object)) (i32)
  (:locals ($expanded :nullable-object) ($scan :nullable-object) ($value :nullable-object)
