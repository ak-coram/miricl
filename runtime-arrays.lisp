  #@(if (i32.eqz (call $vectorp-native (local.get $x)))
    (then (call $list-type-error (local.get $x) (i32.const ,(runtime-symbol-id 'vector)))))
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 35))
    (then (if (i32.ge_s (struct.get $array $fill (ref.cast (ref $array) (local.get $x))) (i32.const 0))
      (then (return (struct.get $array $fill (ref.cast (ref $array) (local.get $x))))))))
