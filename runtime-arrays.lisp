    (ref.null $obj) (ref.null $obj) (ref.null $obj)))

(define-runtime-function $array-element
    (($array :nullable-object) ($index :nullable-object) ($value :nullable-object) ($write i32)) (:nullable-object)
  (:locals ($length i32) ($n i32))
