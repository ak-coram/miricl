;;;; Array storage, shape, and views; simple strings/vectors keep their fast paths.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $arrayp-native (($x :nullable-object)) (i32)
  #@(i32.or (i32.eq (call $tag (local.get $x)) (i32.const 10))
    (i32.le_u (i32.sub (call $tag (local.get $x)) (i32.const 34)) (i32.const 2))))

(define-runtime-function $array-shape (($x :nullable-object)) (:digits)
  #@(struct.get $array $shape (ref.cast (ref $array) (local.get $x))))

(define-runtime-function $array-rank-value (($x :nullable-object)) (i32)
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 35))
    (then (return (array.len (call $array-shape (local.get $x))))))
  #@(if (call $arrayp-native (local.get $x)) (then (return (i32.const 1))))
  #@(call $list-type-error (local.get $x) (i32.const ,(runtime-symbol-id 'array)))
  #@(i32.const 0))

(define-runtime-function $vectorp-native (($x :nullable-object)) (i32)
