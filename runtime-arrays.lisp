    (br_if $resolved (i32.ne (call $tag (local.get $array)) (i32.const 35)))
    (if (i32.eq (call $array-kind (local.get $array)) (i32.const 3))
      (then (call $type-fail (local.get $value) (ref.null $obj) (i32.const ,(runtime-error-code :expected-designator)))))
    (local.set $index (i32.add (local.get $index) (struct.get $array $offset (ref.cast (ref $array) (local.get $array)))))
    (local.set $array (struct.get $obj $a (local.get $array))) (br $resolve)))
  #@(if (i32.eq (call $tag (local.get $array)) (i32.const 34))
    (then
      (if (local.get $write)
        (then (array.set $objects (call $vector-data (local.get $array)) (local.get $index) (local.get $value))
          (return (local.get $value))))
