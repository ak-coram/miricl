    ((integer mod signed-byte unsigned-byte)
      #@(call $integer-type-interval (local.get $type) (i32.const 0))
      #@(local.set $interval) #@(local.set $upper) #@(local.set $lower)
      #@(if (i32.eq (local.get $interval) (i32.const 2)) (then (return (i32.const 3))))
      #@(if (i32.and (i32.eqz (ref.is_null (local.get $lower))) (i32.eqz (ref.is_null (local.get $upper))))
        (then
          (if (i32.gt_s (call $integer-endpoint-compare (ref.as_non_null (local.get $lower))
            (ref.as_non_null (local.get $upper))) (i32.const 0)) (then (return (i32.const 3))))
          (if (i32.and
            (i32.ge_s (call $integer-endpoint-compare (ref.as_non_null (local.get $lower)) (call $int (i32.const 0))) (i32.const 0))
            (i32.le_s (call $integer-endpoint-compare (ref.as_non_null (local.get $upper)) (call $int (i32.const 1))) (i32.const 0)))
            (then (return (i32.const 2))))))
      #@(return (i32.const 0)))
    ((member eql)
      #@(local.set $scan (call $cdr (local.get $type)))
      #@(local.set $kind (i32.const 3))
      #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
        (local.set $value (call $car (local.get $scan)))
        (local.set $candidate (i32.const 0))
        (if (i32.eq (call $tag (local.get $value)) (i32.const 16))
          (then (local.set $candidate (i32.const 1))))
        (if (i32.eq (call $tag (local.get $value)) (i32.const 1))
          (then (if (i32.and (i32.ge_s (struct.get $obj $n (local.get $value)) (i32.const 0))
            (i32.le_u (call $bitlength (ref.as_non_null (local.get $value))) (i32.const 1)))
            (then (local.set $candidate (i32.const 2))))))
        (if (i32.or (i32.eqz (local.get $candidate))
          (i32.and (i32.ne (local.get $kind) (i32.const 3)) (i32.ne (local.get $kind) (local.get $candidate))))
          (then (return (i32.const 0))))
        (local.set $kind (local.get $candidate))
        (local.set $scan (call $cdr (local.get $scan))) (br $next)))
      #@(return (local.get $kind)))
    (or #@(if (ref.is_null (call $cdr (local.get $type))) (then (return (i32.const 3)))))
    (not #@(if (ref.eq (call $car (call $cdr (local.get $type))) (call $symbol (i32.const 1)))
      (then (return (i32.const 3))))))
  #@(i32.const 0))

(define-runtime-function $array-length (($array :nullable-object)) (i32)
  (:locals ($shape :digits) ($i i32) ($length i32))
