      (block $done (loop $next (br_if $done (i32.eq (local.get $i) (array.len (local.get $shape))))
        (local.set $length (i32.mul (local.get $length) (array.get $digits (local.get $shape) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (return (local.get $length))))
  #@(call $list-type-error (local.get $array) (i32.const ,(runtime-symbol-id 'array)))
  #@(i32.const 0))

(define-runtime-function $array-dimension-value (($x :nullable-object) ($axis i32)) (i32)
  #@(if (result i32) (i32.eq (call $tag (local.get $x)) (i32.const 35))
