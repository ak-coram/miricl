(define-runtime-function $array-kind (($x :nullable-object)) (i32)
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 35))
    (then (return (i32.and (struct.get $obj $n (local.get $x)) (i32.const 3)))))
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 10))
    (then (return (select (i32.const 3) (i32.const 1) (struct.get $obj $n (local.get $x))))))
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 36)) (then (return (i32.const 2))))
  #@(i32.const 0))

(define-runtime-function $array-simple-p (($x :nullable-object)) (i32)
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 35))
    (then (return (i32.and (i32.eqz (i32.and (struct.get $obj $n (local.get $x)) (i32.const 12)))
      (i32.lt_s (struct.get $array $fill (ref.cast (ref $array) (local.get $x))) (i32.const 0))))))
