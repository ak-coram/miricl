            (i32.or (i32.and (array.get $digits (local.get $data) (local.get $word)) (i32.xor (local.get $mask) (i32.const -1)))
              (i32.mul (local.get $mask) (local.get $bit)))) (return (local.get $value))))
      (return (call $int (i32.eqz (i32.eqz (i32.and (array.get $digits (local.get $data) (local.get $word)) (local.get $mask))))))))
  #@(if (local.get $write)
    (then (array.set $digits (local.get $data) (local.get $index) (call $character-code (local.get $value)))
      (return (local.get $value))))
