  (wat-new-object :bit-vector :n #@(local.get $length)
    :digits #@(array.new $digits (i32.sub (i32.const 0) (call $bit-value (local.get $initial)))
      (i32.shr_u (i32.add (local.get $length) (i32.const 31)) (i32.const 5)))))

;; Indices here are already bounded. Views resolve against the current target,
;; so later adjustment of a displaced-to array remains visible.
