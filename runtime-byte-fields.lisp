;;;; Byte fields read two's-complement limbs directly, without shifted temporaries.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $byte-component (($spec :nullable-object) ($position i32)) (:nullable-object)
  #@(drop (call $natural-count (call $car (local.get $spec))))
  #@(drop (call $natural-count (call $cdr (local.get $spec))))
  #@(if (result (ref null eq)) (local.get $position)
    (then (call $cdr (local.get $spec))) (else (call $car (local.get $spec)))))

(define-runtime-function $ldb-native
    (($x :nullable-object) ($size :nullable-object) ($position :nullable-object) ($predicate i32)) (:nullable-object)
  (:locals ($value :object) ($digits (ref null $digits)) ($bits i32) ($start i32) ($length i32)
           ($negative i32) ($borrow i32) ($offset i32) ($shift i32) ($i i32) ($n i32)
           ($lo i32) ($hi i32) ($raw i32) ($v i32) ($remaining i32) ($scalar i64))
  #@(local.set $value (call $require-integer (local.get $x)))
  #@(local.set $bits (call $natural-count (local.get $size)))
  #@(local.set $start (call $natural-count (local.get $position)))
  #@(local.set $negative (i32.lt_s (call $value-n (local.get $value)) (i32.const 0)))
  #@(local.set $length (call $bitlength (local.get $value)))
  #@(if (i32.eqz (local.get $negative))
    (then
      (if (i32.ge_u (local.get $start) (local.get $length)) (then (local.set $bits (i32.const 0)))
        (else (local.set $length (i32.sub (local.get $length) (local.get $start)))
          (if (i32.gt_u (local.get $bits) (local.get $length)) (then (local.set $bits (local.get $length))))))))
  #@(if (i32.eqz (local.get $bits))
    (then (return (if (result (ref null eq)) (local.get $predicate)
      (then (ref.null eq)) (else (call $int (i32.const 0)))))))
  #@(if (i32.and (call $scalar-integer-p (local.get $value)) (i32.le_u (local.get $bits) (i32.const 64)))
    (then
      (local.set $scalar (if (result i64) (i32.ge_u (local.get $start) (i32.const 64))
        (then (select (i64.const -1) (i64.const 0) (local.get $negative)))
        (else (i64.shr_s (call $scalar-integer-value (local.get $value)) (i64.extend_i32_u (local.get $start))))))
      (if (i32.lt_u (local.get $bits) (i32.const 64))
        (then (local.set $scalar (i64.and (local.get $scalar)
          (i64.sub (i64.shl (i64.const 1) (i64.extend_i32_u (local.get $bits))) (i64.const 1))))))
      (if (local.get $predicate) (then (return (call $bool (i64.ne (local.get $scalar) (i64.const 0))))))
      (return (call $uint64 (local.get $scalar)))))
  #@(if (i32.and (local.get $predicate) (local.get $negative))
    (then
      (if (i32.ge_u (local.get $start) (local.get $length)) (then (return (call $symbol (i32.const 1)))))
      (if (i32.gt_u (local.get $bits) (i32.sub (local.get $length) (local.get $start)))
        (then (return (call $symbol (i32.const 1)))))))
  (wat-fail-when #@(i32.and (i32.eqz (local.get $predicate)) (i32.gt_u (local.get $bits) (i32.const 536870910))) :allocation)
  #@(local.set $offset (i32.div_u (local.get $start) (i32.const 15)))
  #@(local.set $shift (i32.rem_u (local.get $start) (i32.const 15)))
  #@(local.set $borrow (local.get $negative))
  #@(if (local.get $negative)
    (then
      (block $skipped (loop $skip (br_if $skipped (i32.eq (local.get $i) (local.get $offset)))
        (if (call $digit (local.get $value) (local.get $i)) (then (local.set $borrow (i32.const 0)) (br $skipped)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $skip)))))
  #@(local.set $raw (call $digit (local.get $value) (local.get $offset)))
  #@(local.set $lo (local.get $raw))
  #@(if (local.get $negative)
    (then (local.set $lo (i32.and (i32.xor (i32.sub (local.get $raw) (local.get $borrow)) (i32.const -1)) (i32.const 32767)))
      (local.set $borrow (i32.and (local.get $borrow) (i32.eqz (local.get $raw))))))
  #@(local.set $n (i32.div_u (i32.add (local.get $bits) (i32.const 14)) (i32.const 15)))
  #@(if (i32.eqz (local.get $predicate)) (then (local.set $digits (array.new_default $digits (local.get $n)))))
  #@(local.set $i (i32.const 0))
  #@(local.set $remaining (local.get $bits))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $n)))
    (local.set $raw (call $digit (local.get $value) (i32.add (i32.add (local.get $offset) (local.get $i)) (i32.const 1))))
    (local.set $hi (local.get $raw))
    (if (local.get $negative)
      (then (local.set $hi (i32.and (i32.xor (i32.sub (local.get $raw) (local.get $borrow)) (i32.const -1)) (i32.const 32767)))
        (local.set $borrow (i32.and (local.get $borrow) (i32.eqz (local.get $raw))))))
    (local.set $v (i32.and (i32.or (i32.shr_u (local.get $lo) (local.get $shift))
      (i32.shl (local.get $hi) (i32.sub (i32.const 15) (local.get $shift)))) (i32.const 32767)))
    (if (i32.lt_u (local.get $remaining) (i32.const 15))
      (then (local.set $v (i32.and (local.get $v) (i32.sub (i32.shl (i32.const 1) (local.get $remaining)) (i32.const 1))))))
    (if (local.get $predicate)
      (then (if (local.get $v) (then (return (call $symbol (i32.const 1))))))
      (else (array.set $digits (local.get $digits) (local.get $i) (local.get $v))))
    (local.set $lo (local.get $hi))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (local.set $remaining (i32.sub (local.get $remaining) (i32.const 15))) (br $next)))
  #@(if (result (ref null eq)) (local.get $predicate) (then (ref.null eq))
    (else (call $integer (i32.const 1) (ref.as_non_null (local.get $digits))))))

(define-runtime-function $deposit-native
    (($new :nullable-object) ($spec :nullable-object) ($x :nullable-object) ($aligned i32)) (:nullable-object)
  (:locals ($value :object) ($replacement :object) ($position :object) ($shifted :nullable-object) ($delta :nullable-object)
           ($bits i32) ($start i32) ($mask i32) ($raw i32) ($mask64 i64) ($raw64 i64))
  #@(local.set $value (call $require-integer (local.get $x)))
  #@(local.set $replacement (call $require-integer (local.get $new)))
  #@(local.set $position (ref.as_non_null (call $byte-component (local.get $spec) (i32.const 1))))
  #@(if (i32.eqz (call $value-n (call $car (local.get $spec)))) (then (return (local.get $value))))
  #@(local.set $bits (call $natural-count (call $car (local.get $spec))))
  #@(local.set $start (call $natural-count (local.get $position)))
  ;; Preserve the destination's infinite sign extension. Fields that reach
  ;; bit 63 may create a bignum even when both inputs are scalar integers.
  #@(if (i32.and (i32.le_u (i32.add (local.get $bits) (local.get $start)) (i32.const 63))
        (i32.and (call $scalar-integer-p (local.get $value)) (call $scalar-integer-p (local.get $replacement))))
    (then
      (local.set $mask64 (i64.shl (i64.sub (i64.shl (i64.const 1)
        (i64.extend_i32_u (local.get $bits))) (i64.const 1)) (i64.extend_i32_u (local.get $start))))
      (local.set $raw64 (call $scalar-integer-value (local.get $replacement)))
      (if (i32.eqz (local.get $aligned))
        (then (local.set $raw64 (i64.shl (local.get $raw64) (i64.extend_i32_u (local.get $start))))))
      (return (call $int64 (i64.or (i64.and (call $scalar-integer-value (local.get $value))
        (i64.xor (local.get $mask64) (i64.const -1))) (i64.and (local.get $raw64) (local.get $mask64)))))))
  #@(if (i32.and (i32.le_u (i32.add (local.get $bits) (local.get $start)) (i32.const 30))
    (i32.and (i32.le_u (call $integer-length (ref.as_non_null (local.get $value))) (i32.const 2))
             (i32.le_u (call $integer-length (ref.as_non_null (local.get $replacement))) (i32.const 2))))
    (then
      (local.set $mask (i32.shl (i32.sub (i32.shl (i32.const 1) (local.get $bits)) (i32.const 1)) (local.get $start)))
      (local.set $raw (call $small-integer-value (local.get $replacement)))
      (if (i32.eqz (local.get $aligned)) (then (local.set $raw (i32.shl (local.get $raw) (local.get $start)))))
      (return (call $int (i32.or (i32.and (call $small-integer-value (local.get $value)) (i32.xor (local.get $mask) (i32.const -1)))
                                (i32.and (local.get $raw) (local.get $mask)))))))
  #@(local.set $shifted (call $ash-native (local.get $value) (call $negative (local.get $position))))
  #@(if (local.get $aligned)
    (then (local.set $replacement (ref.as_non_null (call $ash-native (local.get $replacement) (call $negative (local.get $position)))))))
  #@(local.set $delta (call $ldb-native
    (call $boole-native (i32.const 6) (local.get $shifted) (local.get $replacement) (i32.const 0))
    (call $car (local.get $spec)) (call $int (i32.const 0)) (i32.const 0)))
  #@(if (i32.eqz (call $value-n (local.get $delta))) (then (return (local.get $value))))
  #@(call $boole-native (i32.const 6) (local.get $value)
    (call $ash-native (local.get $delta) (local.get $position)) (i32.const 0)))

(define-runtime-section byte-fields-runtime-wat ()
  ($byte-component) ($ldb-native) ($deposit-native))
