  #@(if (i32.eq (call $tag (local.get $source)) (i32.const 10))
    (then (return (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $source))) (local.get $position)))))
  #@(call $value-n (call $array-raw-element (local.get $source) (local.get $position) (ref.null eq) (i32.const 0))))

(define-runtime-function $input-eof
    (($stream :nullable-object) ($error :nullable-object) ($value :nullable-object)) (:nullable-object)
