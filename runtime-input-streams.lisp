  #@(unreachable))

(define-runtime-function $file-unread (($stream :nullable-object) ($code i32)) ()
  (:locals ($last i32) ($position i32) ($actual i32))
  #@(local.set $last (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 3)))
  #@(if (i32.lt_s (local.get $last) (i32.const 0))
