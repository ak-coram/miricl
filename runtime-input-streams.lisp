(define-runtime-function $input-line
    (($stream :nullable-object) ($error :nullable-object) ($value :nullable-object)) (:nullable-object)
  (:locals ($first i32) ($position i32) ($stop i32) ($count i32) ($newline i32) ($source :nullable-object))
  #@(local.set $first (call $value-n (local.get $stream)))
  #@(local.set $position (local.get $first))
  #@(local.set $stop (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 1)))
  #@(if (i32.eq (local.get $position) (local.get $stop))
    (then (return (call $two-values (call $input-eof (local.get $stream) (local.get $error) (local.get $value))
      (call $symbol (i32.const 1))))))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $position) (local.get $stop)))
    (if (i32.eq (call $input-character-code (local.get $stream) (local.get $position)) (i32.const 10))
      (then (local.set $newline (i32.const 1)) (br $done)))
