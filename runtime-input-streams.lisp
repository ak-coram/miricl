(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $commit-input-position (($stream :nullable-object) ($position i32) ($last i32)) ()
  #@(struct.set $obj $n (ref.cast (ref $obj) (local.get $stream)) (local.get $position))
  #@(array.set $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 2) (local.get $last))
  #@(if (ref.eq (local.get $stream) (global.get $reader-stream))
    (then (global.set $source-position (local.get $position)))))

(define-runtime-function $input-stream-error (($stream :nullable-object) ($type i32)) ()
  #@(drop (call $apply (call $symbol (i32.const ,(runtime-symbol-id 'error)))
    (call $cons (call $symbol (local.get $type))
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id :stream)))
        (call $cons (local.get $stream) (ref.null eq))))))
  #@(unreachable))

(define-runtime-function $input-stream-designator (($stream :nullable-object)) (:object)
  #@(if (ref.is_null (local.get $stream))
    (then (local.set $stream (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*standard-input*)))))))
  #@(if (i32.eq (call $id (local.get $stream)) (i32.const 1))
    (then (local.set $stream (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*terminal-io*)))))))
  #@(local.set $stream (call $stream-component (local.get $stream) (i32.const 1)))
  #@(if (i32.and (i32.eq (call $tag (local.get $stream)) (i32.const 39))
      (ref.eq (local.get $stream) (global.get $reader-stream)))
    (then (struct.set $obj $n (ref.cast (ref $obj) (local.get $stream)) (global.get $source-position))))
  #@(ref.as_non_null (local.get $stream)))

(define-runtime-function $make-input-stream
    (($source :nullable-object) ($start :nullable-object) ($end :nullable-object)) (:object)
  (:locals ($first i32) ($stop i32) ($length i32))
  #@(if (i32.eqz (call $stringp-native (local.get $source)))
    (then (call $list-type-error (local.get $source) (i32.const ,(runtime-symbol-id 'string)))))
  #@(local.set $length (call $array-sequence-length (local.get $source)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (call $bounded-index (local.get $start) (local.get $stop)))
  (wat-new-object :input-stream :n #@(local.get $first)
    :digits #@(array.new_fixed $digits 3 (local.get $first) (local.get $stop) (i32.const -1))
    :a #@(local.get $source) :b #@(call $array-kind-type (call $array-kind (local.get $source)))))

(define-runtime-function $input-character-code (($stream :nullable-object) ($position i32)) (i32)
  (:locals ($source :nullable-object))
