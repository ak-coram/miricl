  #@(local.set $count (i32.sub (local.get $position) (local.get $first)))
  #@(local.set $position (i32.add (local.get $position) (local.get $newline)))
  #@(call $commit-input-position (local.get $stream) (local.get $position) (i32.sub (local.get $position) (i32.const 1)))
  #@(local.set $source (call $string-contents (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream)))))
  #@(call $two-values (call $slice (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $source)))) (local.get $first) (local.get $count))
    (call $bool (i32.eqz (local.get $newline)))))

;; The flat string reader retains its bulk path. Other input streams use this
;; character protocol, keeping byte positions private to the file backend.
(define-runtime-function $stream-character-raw (($stream :nullable-object) ($ahead i32) ($take i32)) (i32)
  (:locals ($code i32) ($position i32) ($scan :nullable-object) ($child :nullable-object) ($offset i32))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 44))
    (then (return (call $file-character (local.get $stream) (local.get $ahead) (local.get $take)))))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 46))
    (then
      (local.set $code (call $stream-character (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream))) (local.get $ahead) (local.get $take)))
      (if (i32.and (local.get $take) (i32.ne (local.get $code) (i32.const -1)))
        (then
          (if (i32.eqz (call $value-n (local.get $stream)))
            (then (call $write-destination (struct.get $obj $b (ref.cast (ref $obj) (local.get $stream)))
              (call $text (array.new_fixed $digits 1 (local.get $code))))))
          (struct.set $obj $n (ref.cast (ref $obj) (local.get $stream)) (i32.const 0))))
      (return (local.get $code))))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 45))
    (then
      (local.set $scan (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream))))
      (loop $component
        (if (ref.is_null (local.get $scan)) (then (return (i32.const -1))))
        (local.set $child (call $car (local.get $scan)))
        (local.set $offset (i32.const 0))
        (block $exhausted (loop $look
          (local.set $code (call $stream-character (local.get $child) (local.get $offset) (i32.const 0)))
          (br_if $exhausted (i32.eq (local.get $code) (i32.const -1)))
          (if (i32.eq (local.get $offset) (local.get $ahead))
            (then
              (if (local.get $take)
                (then (local.set $code (call $stream-character (local.get $child) (local.get $offset) (i32.const 1)))
                  (struct.set $obj $b (ref.cast (ref $obj) (local.get $stream)) (local.get $child))))
              (return (local.get $code))))
          (local.set $offset (i32.add (local.get $offset) (i32.const 1))) (br $look)))
        (local.set $ahead (i32.sub (local.get $ahead) (local.get $offset)))
        (if (i32.and (i32.eqz (local.get $offset)) (ref.eq (local.get $scan) (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream)))))
          (then (struct.set $obj $a (ref.cast (ref $obj) (local.get $stream)) (call $cdr (local.get $scan)))))
        (local.set $scan (call $cdr (local.get $scan))) (br $component))))
  #@(local.set $position (i32.add (call $value-n (local.get $stream)) (local.get $ahead)))
  #@(if (i32.ge_u (local.get $position)
      (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 1)))
    (then (return (i32.const -1))))
  #@(local.set $code (call $input-character-code (local.get $stream) (local.get $position)))
  #@(if (local.get $take)
    (then (call $commit-input-position (local.get $stream) (i32.add (local.get $position) (i32.const 1)) (local.get $position))))
  #@(local.get $code))

(define-runtime-function $stream-character (($stream :nullable-object) ($ahead i32) ($take i32)) (i32)
  (:locals ($code i32))
  #@(local.set $stream (call $stream-component (local.get $stream) (i32.const 1)))
  #@(local.set $code (call $stream-character-raw (local.get $stream) (local.get $ahead) (local.get $take)))
  #@(if (i32.and (local.get $take) (i32.ne (local.get $code) (i32.const -1)))
    (then (if (i32.and (ref.eq (local.get $stream) (global.get $reader-stream))
                      (i32.ne (call $tag (local.get $stream)) (i32.const 39)))
      (then (global.set $source-position (i32.add (global.get $source-position) (i32.const 1)))))))
  #@(local.get $code))

(define-runtime-function $stream-unread (($stream :nullable-object) ($code i32)) ()
  (:locals ($last i32) ($child :nullable-object))
  #@(local.set $stream (call $stream-component (local.get $stream) (i32.const 1)))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 44))
    (then (call $file-unread (local.get $stream) (local.get $code)) (return)))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 39))
    (then
      (local.set $last (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 2)))
      (if (i32.or (i32.lt_s (local.get $last) (i32.const 0))
          (i32.ne (call $value-n (local.get $stream)) (i32.add (local.get $last) (i32.const 1))))
        (then (call $input-stream-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream-error)))))
      (if (i32.ne (local.get $code) (call $input-character-code (local.get $stream) (local.get $last)))
        (then (call $input-stream-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream-error)))))
      (call $commit-input-position (local.get $stream) (local.get $last) (i32.const -1)) (return)))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 46))
    (then
      (call $stream-unread (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream))) (local.get $code))
      (struct.set $obj $n (ref.cast (ref $obj) (local.get $stream)) (i32.const 1)))
    (else
