  #@(struct.set $obj $n (ref.cast (ref $obj) (local.get $stream)) (local.get $last))
  #@(local.set $actual (call $file-character (local.get $stream) (i32.const 0) (i32.const 0)))
  #@(if (i32.ne (local.get $actual) (local.get $code))
    (then (struct.set $obj $n (ref.cast (ref $obj) (local.get $stream)) (local.get $position))
