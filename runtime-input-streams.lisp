      (if (ref.is_null (local.get $child))
        (then (call $input-stream-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream-error)))))
      (call $stream-unread (local.get $child) (local.get $code))
      (if (i32.eqz (ref.eq (call $car (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream)))) (local.get $child)))
        (then (struct.set $obj $a (ref.cast (ref $obj) (local.get $stream)) (call $cons (local.get $child) (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream)))))))
      (struct.set $obj $b (ref.cast (ref $obj) (local.get $stream)) (ref.null eq))))
  #@(if (ref.eq (local.get $stream) (global.get $reader-stream))
    (then (global.set $source-position (i32.sub (global.get $source-position) (i32.const 1))))))

(define-runtime-function $stream-byte (($stream :nullable-object)) (:nullable-object)
  (:locals ($value :nullable-object) ($scan :nullable-object))
  #@(local.set $stream (call $stream-component (local.get $stream) (i32.const 1)))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 44))
    (then (return (call $file-byte (local.get $stream) (ref.null eq) (i32.const 0)))))
