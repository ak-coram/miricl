    (($function :nullable-object) ($inputs :nullable-object) ($mode i32) ($output :nullable-object)) (:nullable-object)
  (:locals ($cursors (ref $objects)) ($n i32) ($i i32) ($index i32) ($tag i32) ($limit i32) ($first :nullable-object)
