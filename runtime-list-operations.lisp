      (else (local.set $n (i32.sub (local.get $n) (i32.const 1)))))
    (br $next)))
  #@(local.get $x))

(define-runtime-function $last-native (($x :nullable-object) ($count :nullable-object)) (:nullable-object)
  (:locals ($ahead :nullable-object) ($n i32))
