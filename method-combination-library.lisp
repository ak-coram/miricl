;;;; Declarative method combination. Grouping and form construction are cold.
(defvar %combination-context nil)

(defun method-combination-error (control &rest args)
  (error "Method combination ~S: ~?" %combination-context control args))
(defun invalid-method-error (method control &rest args)
  (error "Invalid method ~S in method combination ~S: ~?" method %combination-context control args))

(defun %compute-long-combination (gf methods options function)
  (let ((%combination-context (list (car options) (generic-function-name gf))))
    (funcall function gf methods (cdr options))))
(defun %define-long-combination (name function documentation)
  (unless (symbolp name) (error 'program-error))
  (setf (get name '%combination) (list nil nil documentation function))
  (incf %dispatch-version) name)

(defun %qualifier-pattern-p (pattern qualifiers)
  (cond ((eq pattern '*) t)
        ((consp pattern)
         (and (consp qualifiers)
              (or (eq (car pattern) '*) (equal (car pattern) (car qualifiers)))
              (%qualifier-pattern-p (cdr pattern) (cdr qualifiers))))
        (t (equal pattern qualifiers))))
(defun %combination-group (remaining patterns predicate order required)
  (unless (member order '(:most-specific-first :most-specific-last))
    (method-combination-error "Invalid method order ~S." order))
  (let ((selected nil) (rest nil) (methods (car remaining)))
    (%%while methods
      (let* ((method (pop methods)) (qualifiers (method-qualifiers method)) (matched nil))
        (if predicate (setq matched (funcall predicate qualifiers))
            (let ((scan patterns))
              (%%while (and scan (not matched))
                (setq matched (%qualifier-pattern-p (pop scan) qualifiers)))))
        (if matched (push method selected) (push method rest))))
    (setf (car remaining) (nreverse rest))
    (when (and required (not selected)) (method-combination-error "A required method group is empty."))
    (if (eq order :most-specific-first) (nreverse selected) selected)))

(defun %combination-parameter (name names)
  (unless (and name (symbolp name) (not (eq name t)) (not (keywordp name)) (not (member name names)))
    (error 'program-error)) name)

;; Each initializer is a closure over the combination's options and definition
;; environment. Earlier argument values are its parameters at effective-method
;; execution time, so initializers run once with ordinary lambda-list scope.
(defun %combination-argument-schema (params)
  (let ((mode :required) (names nil) (schema nil) (restp nil) (keyp nil) (allow nil))
    (when (eq (car params) '&whole)
      (pop params)
      (let ((name (%combination-parameter (pop params) names)))
        (push name names) (push (list 'list :whole (%quote name)) schema)))
    (dolist (spec params)
      (cond ((eq spec '&optional)
             (unless (eq mode :required) (error 'program-error)) (setq mode :optional))
            ((eq spec '&rest)
             (when (or restp keyp (eq mode :aux)) (error 'program-error)) (setq mode :rest restp t))
            ((eq spec '&key)
             (when (or keyp (eq mode :aux) (eq mode :rest)) (error 'program-error))
             (setq mode :key keyp t))
            ((eq spec '&allow-other-keys)
             (unless (and (eq mode :key) (not allow)) (error 'program-error)) (setq allow t))
            ((eq spec '&aux)
             (when (or (eq mode :aux) (eq mode :rest)) (error 'program-error)) (setq mode :aux))
            ((member spec '(&whole &body &environment)) (error 'program-error))
            (t
             (when (or (eq mode :after-rest) (and (eq mode :key) allow)) (error 'program-error))
             (let* ((compound (consp spec)) (variable (if compound (car spec) spec))
                    (alias (and (eq mode :key) (consp variable)))
                    (key (when alias (car variable)))
                    (variable (if (and (eq mode :key) (consp variable)) (cadr variable) variable))
                    (init (if compound (cadr spec) nil))
                    (supplied (and compound (not (eq mode :aux)) (caddr spec)))
                    (initializer (when (member mode '(:optional :key :aux)) (list 'lambda (reverse names) init))))
               (when (and compound
                          (or (member mode '(:required :rest))
                              (> (length spec) (if (eq mode :aux) 2 3)))) (error 'program-error))
               (when (and alias (not (= (length (car spec)) 2)))
                 (error 'program-error))
               (%combination-parameter variable names)
               (when (eq mode :key)
                 (unless alias (setq key (%keyword variable)))
                 (unless (symbolp key) (error 'program-error)))
               (push (list 'list mode (%quote variable) initializer (%quote supplied) (%quote key)) schema)
               (push variable names)
               (when supplied (%combination-parameter supplied names) (push supplied names))
               (when (eq mode :rest) (setq mode :after-rest))))))
    (when (eq mode :rest) (error 'program-error))
    (values (cons 'list (nreverse schema)) (nreverse names))))

(defun %combination-argument-add (name value state)
  (let ((variable (gensym "METHOD-ARG")))
    (setf (car state) (cons (cons name variable) (car state))
          (cadr state) (cons (list variable value) (cadr state))) variable))
(defun %combination-initializer (function state)
  (list* 'funcall (%quote function) (%map 'cdr (reverse (car state)))))
(defun %combination-arguments (gf schema)
  (let* ((profile (%lambda-profile (generic-function-lambda-list gf))) (*gensym-counter* 0)
         (required (car profile)) (optional (cadr profile)) (ri 0) (oi 0)
         (rest (list '%%nthcdr (+ required optional) '%effective-args))
         (state (list nil nil)))
    (dolist (descriptor schema)
      (let* ((mode (car descriptor)) (name (cadr descriptor)) (init (caddr descriptor))
             (supplied (cadddr descriptor)) (key (car (cddddr descriptor)))
             (value nil) (present nil))
        (cond ((eq mode :whole) (setq value '%effective-args))
              ((eq mode :required)
               (when (< ri required) (setq value (list 'nth ri '%effective-args))) (incf ri))
              ((eq mode :optional)
               (setq value (%combination-initializer init state))
               (when (< oi optional)
                 (setq present (list 'consp (list '%%nthcdr (+ required oi) '%effective-args))
                       value (list 'if present (list 'nth (+ required oi) '%effective-args) value)))
               (incf oi))
              ((eq mode :rest) (setq value rest))
              ((eq mode :key)
               (let ((cell (gensym "METHOD-KEY")))
                 (setf (cadr state) (cons (list cell (list '%cell rest (%quote key))) (cadr state)))
                 (setq present (list 'not (list 'null cell))
                       value (list 'if cell (list 'car cell) (%combination-initializer init state)))))
              ((eq mode :aux) (setq value (%combination-initializer init state))))
        (%combination-argument-add name value state)
        (when supplied (%combination-argument-add supplied present state))))
    (list (car state) (nreverse (cadr state)))))

(defun %combination-argument-form (bindings form)
  ;; Private dynamic bindings also remain visible in MAKE-METHOD's null
  ;; lexical environment. No public variable names or global proclamations.
  (let ((names nil) (assignments nil))
    (%%while bindings
      (let ((binding (pop bindings)))
        (push (car binding) names)
        (push (car binding) assignments) (push (cadr binding) assignments)))
    (setq names (nreverse names))
    (if names
        (list 'progv (%quote names) (%quote (make-list (length names)))
          (cons 'setq (nreverse assignments)) form)
        form)))

(defun %expand-long-combination (args)
  (unless (and (>= (length args) 3) (symbolp (car args)) (listp (cadr args)) (listp (caddr args)))
    (error 'program-error))
  (let* ((name (car args)) (params (cadr args)) (groups (caddr args)) (body (cdddr args))
         (gf (gensym)) (methods (gensym)) (options (gensym)) (remaining (gensym))
         (state (gensym)) (result (gensym)) (schema '(list)) (argument-names nil)
         (bindings nil) (declarations nil) (documentation nil) (argumentp nil) (genericp nil))
    (dolist (key '(:arguments :generic-function))
      (when (and (consp (car body)) (eq (caar body) key))
        (let ((option (pop body)))
          (if (eq key :arguments)
              (progn (setq argumentp t)
                (multiple-value-setq (schema argument-names) (%combination-argument-schema (cdr option))))
              (progn (unless (= (length option) 2) (error 'program-error))
                (setq genericp (cadr option)) (%combination-parameter genericp nil))))))
    (when (and (consp (car body)) (member (caar body) '(:arguments :generic-function)))
      (error 'program-error))
    (let ((scanning t))
      (loop while (and scanning body) do
        (cond ((and (consp (car body)) (eq (caar body) 'declare)) (push (pop body) declarations))
              ((and (not documentation) (cdr body) (stringp (car body))) (setq documentation (pop body)))
              (t (setq scanning nil)))))
    (when genericp (push (list genericp gf) bindings))
    (when argumentp
      (push (list state (list '%combination-arguments gf schema)) bindings)
      (dolist (variable argument-names)
        (push (list variable (list 'cdr (list 'assoc (%quote variable) (list 'car state)))) bindings)))
    (push (list remaining (list 'list methods)) bindings)
    (let ((group-names nil))
      (dolist (group groups)
        (unless (and (consp group) (cdr group)) (error 'program-error))
        (let ((variable (%combination-parameter (car group) group-names))
              (tail (cdr group)) (patterns nil) (predicate nil) (order :most-specific-first) (required nil)
              (seen nil))
          (push variable group-names)
          (when (member (car tail) '(:order :required :description)) (error 'program-error))
          (if (and (car tail) (symbolp (car tail)) (not (eq (car tail) '*)))
              (setq predicate (list 'function (pop tail)))
              (loop while (and tail (or (listp (car tail)) (eq (car tail) '*)))
                    do (push (pop tail) patterns)))
          (unless (or predicate patterns) (error 'program-error))
          (loop while tail do
            (let ((key (pop tail)))
              (unless (and tail (member key '(:order :required :description)) (not (member key seen)))
                (error 'program-error))
              (push key seen)
              (case key (:order (setq order (pop tail)))
                        (:required (setq required (not (null (pop tail)))))
                        (:description (pop tail)))))
          (push (list variable (list '%combination-group remaining (%quote (nreverse patterns)) predicate order required)) bindings))))
    (list '%define-long-combination (%quote name)
      (list 'lambda (list gf methods options)
        (list 'apply (cons 'lambda (cons params (append (nreverse declarations)
          (list (list 'let* (nreverse bindings)
            (list 'when (list 'car remaining)
              (list 'invalid-method-error (list 'caar remaining) "No method group matches its qualifiers."))
            (list 'let (list (list result (cons 'progn body)))
              (if argumentp (list '%combination-argument-form (list 'cadr state) result) result))))))) options))
      documentation)))
