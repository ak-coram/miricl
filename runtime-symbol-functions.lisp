;;;; ANSI symbol cells, property lists, and symbol generation.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $require-symbol (($x :nullable-object)) ()
  #@(if (i32.eqz (call $symbolp (local.get $x)))
    (then (call $list-type-error (local.get $x) (i32.const ,(runtime-symbol-id 'symbol))))))

(define-runtime-function $check-variable (($x :nullable-object)) ()
  #@(call $require-symbol (local.get $x))
  (wat-fail-when #@(call $constant-symbol-p (local.get $x)) :malformed-form))

(define-runtime-function $global-binding (($id i32)) (:nullable-object)
  #@(call $symbol-index-get (global.get $value-bindings) (local.get $id)))

(define-runtime-function $register-global-binding (($binding :nullable-object)) ()
  #@(call $symbol-index-set (global.get $value-bindings)
    (call $value-n (local.get $binding)) (local.get $binding)))

(define-runtime-function $constant-symbol-p (($x :nullable-object)) (i32)
  (:locals ($binding :nullable-object))
  #@(if (i32.or (i32.le_u (call $id (local.get $x)) (i32.const 1))
                          (call $keywordp (local.get $x))) (then (return (i32.const 1))))
  #@(local.set $binding (call $global-binding (call $id (local.get $x))))
  #@(if (ref.is_null (local.get $binding)) (then (return (i32.const 0))))
  #@(i32.eqz (ref.is_null (struct.get $obj $b (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding))))))))

(define-runtime-function $define-constant (($name :nullable-object) ($value :nullable-object)) (:nullable-object)
  #@(call $require-symbol (local.get $name))
  #@(if (call $constant-symbol-p (local.get $name))
    (then
      ,(wat-fail-when #@(i32.eqz (call $eql (call $symbol-value (local.get $name)) (local.get $value))) :malformed-form))
    (else
      (drop (call $set-symbol-value (local.get $name) (local.get $value)))
      (struct.set $obj $b (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (call $value-binding (local.get $name)))))
        (call $symbol (i32.const 1)))))
  #@(call $clear-values)
  #@(local.get $name))

(define-runtime-function $install-keyword (($x :nullable-object)) ()
  #@(global.set $variables (call $cons (call $node (i32.const 9) (call $id (local.get $x))
    (call $node (i32.const 11) (i32.const 0) (local.get $x) (call $symbol (i32.const 1)) (ref.null eq))
    (call $symbol (i32.const 1)) (ref.null eq)) (global.get $variables)))
  #@(call $register-global-binding (call $car (global.get $variables))))

(define-runtime-function $clear-binding-cache () ()
  #@(global.set $binding-cache-environment (ref.null eq))
  #@(array.fill $digits (global.get $binding-cache-ids) (i32.const 0) (i32.const -1) (i32.const 32))
  #@(array.fill $objects (global.get $binding-cache-cells) (i32.const 0) (ref.null eq) (i32.const 32)))

;; A binding's cell n=1 means unbound; NIL is an ordinary bound value.
(define-runtime-function $value-binding (($x :nullable-object)) (:nullable-object)
  (:locals ($binding :nullable-object) ($id i32) ($slot i32))
  #@(call $require-symbol (local.get $x))
  #@(local.set $id (call $id (local.get $x)))
  ;; Binding spines are immutable. Cache cells, including absent dynamic
  ;; bindings, while the environment or a validated extension remains active.
  ;; Writes and MAKUNBOUND inspect the cell; global bindings are never cached.
  #@(if (ref.is_null (global.get $dynamic-variables))
    (then (return (call $global-binding (local.get $id)))))
  ;; The newest binding is already a constant-time lookup. In particular,
  ;; reading a freshly rebound special need not evict the caller's cache.
  #@(local.set $binding (struct.get $obj $a (ref.cast (ref $obj) (global.get $dynamic-variables))))
  #@(if (i32.eq (struct.get $obj $n (ref.cast (ref $obj) (local.get $binding))) (local.get $id))
    (then (return (local.get $binding))))
  ;; A single extension preserves every cached lookup except its new head,
  ;; which was handled above. Method contexts can then reuse the caller's
  ;; cache without flushing it on entry and again on return.
  #@(if (i32.eqz (ref.eq (global.get $dynamic-variables) (global.get $binding-cache-environment)))
    (then
      (if (i32.eqz (ref.eq (struct.get $obj $b (ref.cast (ref $obj) (global.get $dynamic-variables)))
            (global.get $binding-cache-environment)))
        (then
          (array.fill $digits (global.get $binding-cache-ids) (i32.const 0) (i32.const -1) (i32.const 32))
          (array.fill $objects (global.get $binding-cache-cells) (i32.const 0) (ref.null eq) (i32.const 32))
          (global.set $binding-cache-environment (global.get $dynamic-variables))))))
  #@(local.set $slot (i32.and (local.get $id) (i32.const 31)))
  #@(if (i32.eq (array.get $digits (global.get $binding-cache-ids) (local.get $slot)) (local.get $id))
    (then (local.set $binding (array.get $objects (global.get $binding-cache-cells) (local.get $slot))))
    (else
      (local.set $binding (call $find (global.get $dynamic-variables) (local.get $id)))
      (array.set $digits (global.get $binding-cache-ids) (local.get $slot) (local.get $id))
      (array.set $objects (global.get $binding-cache-cells) (local.get $slot) (local.get $binding))))
  #@(if (ref.is_null (local.get $binding))
      (then (local.set $binding (call $global-binding (local.get $id)))))
  #@(local.get $binding))

(define-runtime-function $boundp (($x :nullable-object)) (i32)
  (:locals ($binding :nullable-object))
  #@(call $require-symbol (local.get $x))
  #@(if (i32.or (i32.le_u (call $id (local.get $x)) (i32.const 1)) (call $keywordp (local.get $x)))
      (then (return (i32.const 1))))
  #@(if (i32.eq (call $id (local.get $x)) (i32.const ,(runtime-symbol-id '*package*)))
      (then (return (if (result i32) (ref.is_null (global.get $dynamic-package))
        (then (global.get $package-bound))
        (else (i32.eqz (call $value-n (call $car (global.get $dynamic-package)))))))))
  #@(local.set $binding (call $value-binding (local.get $x)))
  #@(if (ref.is_null (local.get $binding)) (then (return (i32.const 0))))
  #@(i32.eqz (call $value-n (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding))))))

(define-runtime-function $symbol-value (($x :nullable-object)) (:nullable-object)
  (:locals ($binding :nullable-object))
  #@(call $require-symbol (local.get $x))
  #@(if (i32.or (i32.le_u (call $id (local.get $x)) (i32.const 1)) (call $keywordp (local.get $x)))
      (then (return (local.get $x))))
  #@(if (i32.eq (call $id (local.get $x)) (i32.const ,(runtime-symbol-id '*package*)))
      (then (return (call $active-package))))
  ;; Find the dynamic/global cell once; BOUNDP followed by VALUE-BINDING
  ;; repeated the same environment traversal for every special-variable read.
  #@(local.set $binding (call $value-binding (local.get $x)))
  #@(if (ref.is_null (local.get $binding))
    (then (return (call $unbound-value (local.get $x)))))
  #@(if (call $value-n (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding))))
    (then (return (call $unbound-value (local.get $x)))))
  #@(call $binding-value (local.get $binding)))

(define-runtime-function $set-symbol-value (($x :nullable-object) ($value :nullable-object)) (:nullable-object)
  (:locals ($binding :nullable-object))
  #@(call $check-variable (local.get $x))
  #@(if (i32.eq (call $id (local.get $x)) (i32.const ,(runtime-symbol-id '*package*)))
      (then (call $set-current-package (call $require-package (local.get $value))) (return (local.get $value))))
  #@(local.set $binding (call $value-binding (local.get $x)))
  #@(if (ref.is_null (local.get $binding))
      (then (global.set $variables (call $bind (global.get $variables) (local.get $x) (local.get $value)))
            (call $register-global-binding (call $car (global.get $variables))))
      (else (call $check-type (local.get $value) (struct.get $obj $b (ref.cast (ref $obj) (local.get $binding))))
            (struct.set $obj $n (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding)))) (i32.const 0))
            (struct.set $obj $a (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding)))) (local.get $value))))
  #@(local.get $value))

(define-runtime-function $makunbound (($x :nullable-object)) (:nullable-object)
  (:locals ($binding :nullable-object))
  #@(call $check-variable (local.get $x))
  #@(if (i32.eq (call $id (local.get $x)) (i32.const ,(runtime-symbol-id '*package*)))
      (then (if (ref.is_null (global.get $dynamic-package)) (then (global.set $package-bound (i32.const 0)))
                (else (struct.set $obj $n (ref.cast (ref $obj) (call $car (global.get $dynamic-package))) (i32.const 1))))
            (return (local.get $x))))
  #@(local.set $binding (call $value-binding (local.get $x)))
  #@(if (i32.eqz (ref.is_null (local.get $binding)))
      (then (struct.set $obj $n (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding)))) (i32.const 1))
            (struct.set $obj $a (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding)))) (ref.null eq))))
  #@(local.get $x))

(define-runtime-function $symbol-plist (($x :nullable-object)) (:nullable-object)
  #@(call $require-symbol (local.get $x))
  #@(if (ref.is_null (local.get $x)) (then (return (global.get $nil-plist))))
  #@(struct.get $obj $c (ref.cast (ref $obj) (local.get $x))))

(define-runtime-function $set-symbol-plist (($x :nullable-object) ($plist :nullable-object)) (:nullable-object)
  #@(call $require-symbol (local.get $x))
  (wat-fail-when #@(i32.rem_u (call $length (local.get $plist)) (i32.const 2)) :malformed-form)
  #@(if (ref.is_null (local.get $x)) (then (global.set $nil-plist (local.get $plist)))
      (else (struct.set $obj $c (ref.cast (ref $obj) (local.get $x)) (local.get $plist))))
  #@(local.get $plist))

;; Return the value cons, so a present property with value NIL is distinguishable.
(define-runtime-function $get-properties-native (($plist :nullable-object) ($indicators :nullable-object)) (:nullable-object)
  (:locals ($key :nullable-object) ($value :nullable-object))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $plist)))
    (local.set $key (call $car (local.get $plist)))
    (local.set $value (call $cdr (local.get $plist)))
    (if (i32.ne (call $tag (local.get $value)) (i32.const 7))
      (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'cons)))))
    (if (call $member-eq (local.get $key) (local.get $indicators))
      (then (return (call $three-values (local.get $key) (call $car (local.get $value)) (local.get $plist)))))
    (local.set $plist (call $cdr (local.get $value))) (br $next)))
  #@(call $three-values (ref.null eq) (ref.null eq) (ref.null eq)))

(define-runtime-function $getf-native
    (($plist :nullable-object) ($indicator :nullable-object) ($default :nullable-object)) (:nullable-object)
  (:locals ($cell :nullable-object))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $plist)))
    (local.set $cell (call $cdr (local.get $plist)))
    (if (i32.ne (call $tag (local.get $cell)) (i32.const 7))
      (then (call $list-type-error (local.get $cell) (i32.const ,(runtime-symbol-id 'cons)))))
    (if (ref.eq (call $car (local.get $plist)) (local.get $indicator))
      (then (return (call $car (local.get $cell)))))
    (local.set $plist (call $cdr (local.get $cell))) (br $next)))
  #@(local.get $default))

(define-runtime-function $property-list-edit
    (($plist :nullable-object) ($indicator :nullable-object) ($value :nullable-object) ($remove i32)) (:nullable-object i32)
  (:locals ($scan :nullable-object) ($cell :nullable-object) ($previous :nullable-object))
  #@(local.set $scan (local.get $plist))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $cell (call $cdr (local.get $scan)))
    (if (i32.ne (call $tag (local.get $cell)) (i32.const 7))
      (then (call $list-type-error (local.get $cell) (i32.const ,(runtime-symbol-id 'cons)))))
    (if (ref.eq (call $car (local.get $scan)) (local.get $indicator))
      (then
        (if (local.get $remove)
          (then
            (if (ref.is_null (local.get $previous))
              (then (local.set $plist (call $cdr (local.get $cell))))
              (else (struct.set $obj $b (ref.cast (ref $obj) (local.get $previous)) (call $cdr (local.get $cell))))))
          (else (struct.set $obj $a (ref.cast (ref $obj) (local.get $cell)) (local.get $value))))
        (return (local.get $plist) (i32.const 1))))
    (local.set $previous (local.get $cell))
    (local.set $scan (call $cdr (local.get $cell))) (br $next)))
  #@(if (i32.eqz (local.get $remove)) (then (local.set $plist
    (call $cons (local.get $indicator) (call $cons (local.get $value) (local.get $plist))))))
  #@(local.get $plist) #@(i32.const 0))

(define-runtime-function $property-list-edit-values
    (($plist :nullable-object) ($indicator :nullable-object) ($value :nullable-object) ($remove i32)) (:nullable-object)
  (:locals ($result :nullable-object) ($found i32))
  #@(call $property-list-edit (local.get $plist) (local.get $indicator) (local.get $value) (local.get $remove))
  #@(local.set $found) #@(local.set $result)
  #@(call $two-values (local.get $result) (call $bool (local.get $found))))

(define-runtime-function $property-cell (($plist :nullable-object) ($key :nullable-object)) (:nullable-object)
  (:locals ($pair (ref null $obj)) ($tail :nullable-object))
  ;; Internal keyword binding must diagnose an odd argument list as a program
  ;; error itself; GETF validates property-list cells in its separate loop.
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $plist)))
    ;; Validate each cons once, then read its fields directly. CLOS metadata
    ;; lookups otherwise repeat public CAR/CDR checks for the same cells.
    (if (i32.ne (call $tag (local.get $plist)) (i32.const 7))
      (then (return (call $car (local.get $plist)))))
    (local.set $pair (ref.cast (ref $obj) (local.get $plist)))
    (if (ref.eq (struct.get $obj $a (local.get $pair)) (local.get $key))
      (then (return (struct.get $obj $b (local.get $pair)))))
    (local.set $tail (struct.get $obj $b (local.get $pair)))
    (br_if $done (ref.is_null (local.get $tail)))
    (if (i32.ne (call $tag (local.get $tail)) (i32.const 7))
      (then (return (call $cdr (local.get $tail)))))
    (local.set $plist (struct.get $obj $b (ref.cast (ref $obj) (local.get $tail)))) (br $next)))
  #@(ref.null eq))

(define-runtime-function $put-property (($x :nullable-object) ($key :nullable-object) ($value :nullable-object)) (:nullable-object)
  (:locals ($cell :nullable-object))
  #@(local.set $cell (call $property-cell (call $symbol-plist (local.get $x)) (local.get $key)))
  #@(if (ref.is_null (local.get $cell))
      (then (drop (call $set-symbol-plist (local.get $x)
        (call $cons (local.get $key) (call $cons (local.get $value) (call $symbol-plist (local.get $x)))))))
      (else (struct.set $obj $a (ref.cast (ref $obj) (local.get $cell)) (local.get $value))))
  #@(local.get $value))

(define-runtime-function $remprop (($x :nullable-object) ($key :nullable-object)) (i32)
  (:locals ($plist :nullable-object) ($previous :nullable-object))
  #@(local.set $plist (call $symbol-plist (local.get $x)))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $plist)))
    (if (ref.eq (call $car (local.get $plist)) (local.get $key))
        (then (if (ref.is_null (local.get $previous))
                  (then (drop (call $set-symbol-plist (local.get $x) (call $cdr (call $cdr (local.get $plist))))))
                  (else (struct.set $obj $b (ref.cast (ref $obj) (local.get $previous)) (call $cdr (call $cdr (local.get $plist))))))
              (return (i32.const 1))))
    (local.set $previous (call $cdr (local.get $plist)))
    (local.set $plist (call $cdr (local.get $previous))) (br $next)))
  #@(i32.const 0))

(define-runtime-function $copy-list (($list :nullable-object)) (:nullable-object)
  #@(if (ref.is_null (local.get $list)) (then (return (ref.null eq))))
  #@(call $cons (call $car (local.get $list)) (call $copy-list (call $cdr (local.get $list)))))

;; Function-name bindings are separate for FOO and (SETF FOO).
(define-runtime-function $function-documentation
    (($function :nullable-object) ($value :nullable-object) ($write i32)) (:nullable-object)
  (:locals ($env :nullable-object) ($marker :nullable-object))
  #@(if (i32.ne (call $tag (local.get $function)) (i32.const 8))
    (then (call $type-fail (local.get $function) (call $symbol (i32.const ,(runtime-symbol-id 'function)))
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(if (local.get $write)
    (then (if (i32.and (i32.eqz (ref.is_null (local.get $value)))
                      (i32.eqz (call $stringp-native (local.get $value))))
      (then (call $type-fail (local.get $value) (call $symbol (i32.const ,(runtime-symbol-id 'string)))
        (i32.const ,(runtime-error-code :expected-designator)))))))
  ;; Closure environments can carry a private non-variable entry. Keeping the
  ;; string with its function avoids retaining obsolete expanders in a table.
  #@(if (call $value-n (local.get $function))
    (then (return (if (result (ref null eq)) (local.get $write)
      (then (local.get $value)) (else (ref.null eq))))))
  #@(local.set $env (struct.get $obj $c (ref.cast (ref $obj) (local.get $function))))
  #@(if (i32.eq (call $tag (local.get $env)) (i32.const 7))
    (then (local.set $marker (call $car (local.get $env)))
      (if (i32.ne (call $tag (local.get $marker)) (i32.const 9)) (then (local.set $marker (ref.null eq)))
        (else (if (i32.ne (call $value-n (local.get $marker)) (i32.const -1))
          (then (local.set $marker (ref.null eq))))))))
  #@(if (i32.eqz (local.get $write))
    (then (return (if (result (ref null eq)) (ref.is_null (local.get $marker))
      (then (ref.null eq)) (else (struct.get $obj $a (ref.cast (ref $obj) (local.get $marker))))))))
  #@(if (ref.is_null (local.get $marker))
    (then (if (i32.eqz (ref.is_null (local.get $value)))
      (then (struct.set $obj $c (ref.cast (ref $obj) (local.get $function))
        (call $cons (call $node (i32.const 9) (i32.const -1) (local.get $value) (ref.null eq) (ref.null eq))
          (local.get $env))))))
    (else (if (ref.is_null (local.get $value))
      (then (struct.set $obj $c (ref.cast (ref $obj) (local.get $function)) (call $cdr (local.get $env))))
      (else (struct.set $obj $a (ref.cast (ref $obj) (local.get $marker)) (local.get $value))))))
  #@(local.get $value))

(define-runtime-function $function-lambda-expression-native (($function :nullable-object)) (:nullable-object)
  (:locals ($body :nullable-object) ($scan :nullable-object) ($doc :nullable-object)
           ($source :nullable-object) ($name :nullable-object) ($closure :nullable-object) ($id i32))
  #@(if (i32.ne (call $tag (local.get $function)) (i32.const 8))
    (then (call $type-fail (local.get $function) (call $symbol (i32.const ,(runtime-symbol-id 'function)))
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(if (ref.test (ref $direct-function) (local.get $function))
    (then (if (i32.ge_u (struct.get $direct-function $mode
            (ref.cast (ref $direct-function) (local.get $function))) (i32.const 17))
      (then (return_call $function-lambda-expression-native
        (struct.get $direct-function $owner (ref.cast (ref $direct-function) (local.get $function))))))))
  #@(if (ref.test (ref $native-function) (local.get $function))
    (then (return (call $three-values (ref.null eq) (call $symbol (i32.const 1))
      (struct.get $obj $c (ref.cast (ref $obj) (local.get $function)))))))
  #@(local.set $id (call $value-n (local.get $function)))
  #@(if (i32.eq (local.get $id) (i32.const 2147483641))
    (then (return (call $three-values
      (ref.null eq)
      (call $bool (i32.ne (array.len (call $vector-data
        (struct.get $obj $b (ref.cast (ref $obj) (local.get $function))))) (i32.const 0)))
      (struct.get $obj $c (ref.cast (ref $obj) (local.get $function)))))))
  #@(local.set $closure (call $symbol (i32.const 1)))
  #@(if (i32.eqz (local.get $id))
    (then
      (local.set $closure (call $bool (i32.eqz (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $function)))))))
      (local.set $body (struct.get $obj $b (ref.cast (ref $obj) (local.get $function))))
      (local.set $scan (local.get $body))
      (block $declarations-done (loop $declarations
        (br_if $declarations-done (i32.ne (call $operator (call $car (local.get $scan)))
          (i32.const ,(runtime-symbol-id 'declare))))
        (local.set $scan (call $cdr (local.get $scan))) (br $declarations)))
      (if (i32.eq (call $operator (call $car (local.get $scan))) (i32.const ,(runtime-symbol-id 'block)))
        (then (local.set $name (call $car (call $cdr (call $car (local.get $scan)))))))
      (local.set $doc (call $function-documentation (local.get $function) (ref.null eq) (i32.const 0)))
      (if (i32.eqz (ref.is_null (local.get $doc)))
        (then (if (ref.is_null (local.get $body))
          (then (local.set $body (call $cons (ref.null eq) (ref.null eq)))))
          (local.set $body (call $cons (local.get $doc) (local.get $body)))))
      (local.set $source (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'lambda)))
        (call $cons (struct.get $obj $a (ref.cast (ref $obj) (local.get $function))) (local.get $body)))))
    (else (if (i32.lt_u (i32.sub (local.get $id) (i32.const 1)) (i32.const ,(length *runtime-symbols*)))
      (then (local.set $name (call $symbol (i32.sub (local.get $id) (i32.const 1))))))))
  #@(call $three-values (local.get $source) (local.get $closure) (local.get $name)))

(define-runtime-function $function-name-symbol (($name :nullable-object)) (:nullable-object)
  (:locals ($rest :nullable-object))
