     ($negate i32) ($from-end i32) ($count-result i32)) (i32)
  (:locals ($index i32) ($step i32) ($left i32) ($code i32) ($count i32))
  #@(local.set $left (i32.sub (local.get $stop) (local.get $first)))
  #@(if (i32.eqz (local.get $left))
    (then (return (select (i32.const 0) (i32.const -1) (local.get $count-result)))))
  #@(local.set $index (select (i32.sub (local.get $stop) (i32.const 1)) (local.get $first) (local.get $from-end)))
  ;; A non-character EQL item cannot match a string element.
  #@(if (i32.lt_s (local.get $needle) (i32.const 0))
    (then
      (if (i32.eqz (local.get $negate))
        (then (return (select (i32.const 0) (i32.const -1) (local.get $count-result)))))
      (return (select (local.get $left) (local.get $index) (local.get $count-result)))))
  #@(local.set $step (select (i32.const -1) (i32.const 1) (local.get $from-end)))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $left)))
    (local.set $code (array.get $digits (local.get $data) (local.get $index)))
    (if (local.get $fold) (then (local.set $code (call $string-upcase-code (local.get $code)))))
    (if (i32.xor (i32.eq (local.get $code) (local.get $needle)) (local.get $negate))
      (then
        (if (i32.eqz (local.get $count-result)) (then (return (local.get $index))))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))))
    (local.set $index (i32.add (local.get $index) (local.get $step)))
    (local.set $left (i32.sub (local.get $left) (i32.const 1))) (br $next)))
  #@(select (local.get $count) (i32.const -1) (local.get $count-result)))

(define-runtime-function $sequence-list-buffer (($cursor :nullable-object) ($count i32)) ((ref $objects))
  (:locals ($buffer (ref $objects)) ($i i32))
