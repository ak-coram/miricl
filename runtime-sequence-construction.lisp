(define-runtime-function $proper-sequence-length (($sequence :nullable-object)) (i32)
  (:locals ($length :nullable-object))
  #@(if (call $arrayp-native (local.get $sequence))
    (then (return (call $array-sequence-length (local.get $sequence)))))
  #@(if (i32.or (ref.is_null (local.get $sequence))
                 (i32.eq (call $tag (local.get $sequence)) (i32.const 7)))
    (then (local.set $length (call $list-length-native (local.get $sequence)))
      (if (i32.eqz (ref.is_null (local.get $length)))
        (then (return (call $natural-count (local.get $length)))))))
  #@(call $type-fail (local.get $sequence)
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'satisfies)))
      (call $cons ,(clos-library-reference '%proper-sequence-p) (ref.null $obj)))
    (i32.const ,(runtime-error-code :expected-designator)))
  #@(i32.const 0))

