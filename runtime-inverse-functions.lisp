;;;; Inverse functions share stable real kernels and ellipse geometry.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $asinh-f64 (($x f64)) (f64)
  (:locals ($a f64))
  #@(local.set $a (f64.abs (local.get $x)))
  #@(if (f64.lt (local.get $a) (f64.const 1e-8)) (then (return (local.get $x))))
  #@(if (f64.gt (local.get $a) (f64.const 1e150))
    (then (return (f64.copysign (f64.add (call $log-f64 (local.get $a))
      (f64.const 0.6931471805599453)) (local.get $x)))))
  #@(f64.copysign (call $log1p-f64 (f64.add (local.get $a)
    (f64.mul (local.get $a) (f64.div (local.get $a)
      (f64.add (f64.const 1) (call $hypotenuse (f64.const 1) (local.get $a))))))) (local.get $x)))

(define-runtime-function $acosh-f64 (($x f64) ($distance f64)) (f64)
  #@(if (f64.gt (local.get $x) (f64.const 1e150))
    (then (return (f64.add (call $log-f64 (local.get $x)) (f64.const 0.6931471805599453)))))
  #@(call $log1p-f64 (f64.add (local.get $distance)
    (f64.mul (f64.sqrt (local.get $distance))
      (f64.sqrt (f64.add (local.get $distance) (f64.const 2)))))))

(define-runtime-function $inverse-real-distance (($number :object)) (f64 i32)
  (:locals ($delta :object) ($distance f64))
  #@(if (i32.le_u (call $tag (local.get $number)) (i32.const 2))
    (then
      (local.set $delta (call $real-op (i32.const 1) (call $real-absolute (local.get $number)) (call $int (i32.const 1))))
      (return (call $coerce-float (local.get $delta) (i32.const 4))
        (struct.get $obj $n (call $numerator (local.get $delta))))))
  #@(local.set $distance (f64.sub (f64.abs (struct.get $obj $f (local.get $number))) (f64.const 1)))
  #@(local.get $distance)
  #@(i32.sub (f64.gt (local.get $distance) (f64.const 0)) (f64.lt (local.get $distance) (f64.const 0))))

;; Return ASIN's real part, ACOS's real part, and ASIN's imaginary part.
;; Computing both angles directly avoids cancellation in PI/2 - ASIN(z).
(define-runtime-function $asin-acos-f64 (($x f64) ($y f64) ($distance f64)) (f64 f64 f64)
  (:locals ($ax f64) ($ay f64) ($r f64) ($s f64) ($u f64) ($v f64)
           ($delta f64) ($d f64) ($a f64) ($sine f64) ($cosine f64) ($imag f64))
  #@(local.set $ax (f64.abs (local.get $x)))
  #@(local.set $ay (f64.abs (local.get $y)))
  #@(if (f64.gt (f64.max (local.get $ax) (local.get $ay)) (f64.const 1e150))
    (then
      (local.set $sine (call $atan2-f64 (local.get $x) (local.get $ay)))
      (local.set $cosine (call $atan2-f64 (local.get $ay) (local.get $x)))
      (local.set $imag (f64.add (call $log-hypot-f64 (local.get $x) (local.get $y))
        (f64.const 0.6931471805599453))))
    (else
      (if (i32.and (f64.gt (local.get $distance) (f64.const 0))
        (f64.lt (local.get $ay) (f64.mul (f64.const 1e-16) (local.get $distance))))
        (then
          (local.set $sine (f64.copysign (f64.const 1.5707963267948966) (local.get $x)))
          (local.set $cosine (select (f64.const 0) (f64.const 3.141592653589793)
            (f64.gt (local.get $x) (f64.const 0))))
          (local.set $imag (call $acosh-f64 (local.get $ax) (local.get $distance))))
        (else
          (local.set $r (call $hypotenuse (f64.add (local.get $ax) (f64.const 1)) (local.get $ay)))
          (local.set $s (call $hypotenuse (local.get $distance) (local.get $ay)))
          (local.set $u (f64.add (local.get $r) (f64.add (local.get $ax) (f64.const 1))))
          (local.set $v (f64.add (local.get $s) (f64.abs (local.get $distance))))
          ;; Hypot(u,y)-|u| is y*(y/(hypot(u,y)+|u|)). It retains
          ;; the small displacement from the branch points without y*y.
          (local.set $delta (f64.mul (local.get $ay) (f64.div (local.get $ay) (local.get $u))))
          (if (f64.ne (local.get $v) (f64.const 0))
            (then (local.set $delta (f64.add (local.get $delta)
              (f64.mul (local.get $ay) (f64.div (local.get $ay) (local.get $v)))))))
          (if (f64.lt (local.get $distance) (f64.const 0))
            (then
              (local.set $d (f64.mul
                (f64.sqrt (f64.add (f64.neg (local.get $distance)) (f64.mul (local.get $delta) (f64.const 0.5))))
                (f64.sqrt (f64.add (f64.add (f64.const 2) (local.get $distance)) (f64.mul (local.get $delta) (f64.const 0.5))))))
              (local.set $a (f64.add (f64.const 1) (f64.mul (local.get $delta) (f64.const 0.5)))))
            (else
              (local.set $d (f64.mul (f64.sqrt (local.get $delta))
                (f64.sqrt (f64.add (local.get $ax) (f64.mul (local.get $delta) (f64.const 0.25))))))
              (local.set $a (f64.add (local.get $ax) (f64.mul (local.get $delta) (f64.const 0.5))))))
          (local.set $sine (call $atan2-f64 (local.get $x) (local.get $d)))
          (local.set $cosine (call $atan2-f64 (local.get $d) (local.get $x)))
          (if (f64.ne (local.get $d) (f64.const 0))
            (then (local.set $imag (call $asinh-f64
              (f64.mul (local.get $ay) (f64.div (local.get $a) (local.get $d)))))))))))
  ;; A real argument selects quadrant II on the negative cut and quadrant IV
  ;; on the positive cut, including complex arguments with zero imaginary part.
  #@(local.set $imag (f64.copysign (local.get $imag)
    (if (result f64) (i32.and (f64.eq (local.get $ay) (f64.const 0)) (f64.gt (local.get $distance) (f64.const 0)))
      (then (f64.neg (local.get $x))) (else (local.get $y)))))
  #@(local.get $sine) #@(local.get $cosine) #@(local.get $imag))

(define-runtime-function $inverse-rational-atanh (($z :object) ($args :nullable-object)) (:object)
  (:locals ($a :object) ($delta :object) ($value f64) ($sign f64))
  #@(local.set $a (call $real-absolute (local.get $z)))
  #@(local.set $delta (call $real-op (i32.const 1) (local.get $a) (call $int (i32.const 1))))
  #@(if (call $zero (local.get $delta))
    (then (call $elementary-error (i32.const ,(runtime-symbol-id 'division-by-zero))
      (i32.const ,(runtime-symbol-id 'atanh)) (local.get $args))))
  #@(local.set $sign (f64.convert_i32_s (struct.get $obj $n (call $numerator (local.get $z)))))
  #@(local.set $value (f64.copysign (f64.mul (f64.const 0.5)
    (f64.sub (call $positive-real-log (call $real-op (i32.const 0) (local.get $a) (call $int (i32.const 1))))
      (call $positive-real-log (call $real-absolute (local.get $delta))))) (local.get $sign)))
  #@(if (i32.gt_s (struct.get $obj $n (call $numerator (local.get $delta))) (i32.const 0))
    (then (return (call $complex (call $float (i32.const 3) (local.get $value))
      (call $float (i32.const 3) (f64.copysign (f64.const 1.5707963267948966) (local.get $sign)))))))
  #@(call $float (i32.const 3) (local.get $value)))

(define-runtime-function $inverse-native (($id i32) ($args :nullable-object)) (:object)
  (:locals ($z :object) ($rotated :object) ($kind i32) ($complex i32) ($side i32)
           ($x f64) ($y f64) ($r f64) ($c f64) ($i f64) ($a f64) ($distance f64))
  #@(local.set $z (call $number (call $car (local.get $args))))
  #@(local.set $kind (call $transcendental-kind (local.get $z)))
  #@(local.set $complex (i32.eq (call $tag (local.get $z)) (i32.const 5)))
  #@(if (i32.and (local.get $complex)
      (i32.and (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'atanh)))
        (i32.le_u (call $tag (call $part (local.get $z) (i32.const 0))) (i32.const 2))))
    (then
      ;; Reuse ATAN's exact rational handling at arbitrarily close poles.
      (local.set $rotated (call $atan-native (call $complex
        (call $negate-number (call $part (local.get $z) (i32.const 1)))
        (call $part (local.get $z) (i32.const 0))) (ref.null $obj) (i32.const 0)))
      (return (call $complex (call $part (local.get $rotated) (i32.const 1))
        (call $negate-number (call $part (local.get $rotated) (i32.const 0)))))))
  #@(local.set $x (call $coerce-float (call $part (local.get $z) (i32.const 0)) (i32.const 4)))
  #@(if (local.get $complex)
    (then (local.set $y (call $coerce-float (call $part (local.get $z) (i32.const 1)) (i32.const 4)))))
  #@(call $inverse-real-distance (call $part (local.get $z) (i32.const 0)))
  #@(local.set $side) #@(local.set $distance)
  #@(if (i32.and (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'atanh)))
    (i32.and (i32.le_u (call $tag (local.get $z)) (i32.const 2)) (f64.eq (f64.abs (local.get $x)) (f64.const 1))))
    (then (return (call $inverse-rational-atanh (local.get $z) (local.get $args)))))
  (wat-symbol-case #@(local.get $id)
    ((asin acos acosh)
      #@(call $asin-acos-f64 (local.get $x) (local.get $y) (local.get $distance))
      #@(local.set $i) #@(local.set $c) #@(local.set $r)
      #@(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'acosh)))
        (then
          (local.set $r (f64.abs (local.get $i)))
          (local.set $i (f64.copysign (local.get $c) (local.get $y)))
          (local.set $complex (i32.or (local.get $complex)
            (i32.or (f64.lt (local.get $x) (f64.const 0)) (i32.lt_s (local.get $side) (i32.const 0))))))
        (else
          (if (i32.and (i32.eqz (local.get $complex)) (i32.gt_s (local.get $side) (i32.const 0)))
            (then (local.set $i (f64.copysign (local.get $i) (f64.neg (local.get $x))))))
          (local.set $complex (i32.or (local.get $complex) (i32.gt_s (local.get $side) (i32.const 0))))
          (if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'acos)))
            (then (local.set $r (local.get $c)) (local.set $i (f64.neg (local.get $i))))))))
    (asinh
      #@(if (local.get $complex)
        (then
          (call $inverse-real-distance (call $part (local.get $z) (i32.const 1)))
          (local.set $side) (local.set $distance)
          (call $asin-acos-f64 (f64.neg (local.get $y)) (local.get $x) (local.get $distance))
          (local.set $r) (drop) (local.set $i) (local.set $i (f64.neg (local.get $i))))
        (else (local.set $r (call $asinh-f64 (local.get $x))))))
    (atanh
      #@(if (local.get $complex)
        (then (call $atan-complex-f64 (f64.neg (local.get $y)) (local.get $x)
            (local.get $distance))
          (local.set $r) (local.set $i) (local.set $i (f64.neg (local.get $i))))
        (else
          (local.set $a (f64.abs (local.get $x)))
          (if (f64.eq (local.get $a) (f64.const 1))
            (then (call $elementary-error (i32.const ,(runtime-symbol-id 'division-by-zero)) (local.get $id) (local.get $args))))
          (if (f64.gt (local.get $a) (f64.const 1))
            (then (local.set $complex (i32.const 1))
              (local.set $r (f64.copysign (f64.mul (f64.const 0.5)
                (call $log1p-f64 (f64.div (f64.const 2) (f64.sub (local.get $a) (f64.const 1))))) (local.get $x)))
              (local.set $i (f64.copysign (f64.const 1.5707963267948966) (local.get $x))))
            (else
              (local.set $r (if (result f64) (f64.lt (local.get $a) (f64.const 1e-8))
                (then (local.get $x))
                (else (f64.copysign (f64.mul (f64.const 0.5)
                  (call $log1p-f64 (f64.div (f64.mul (f64.const 2) (local.get $a))
                    (f64.sub (f64.const 1) (local.get $a))))) (local.get $x)))))))))))
  #@(if (result (ref $obj)) (local.get $complex)
    (then (call $complex (call $elementary-float (local.get $kind) (local.get $r) (local.get $id) (local.get $args))
      (call $elementary-float (local.get $kind) (local.get $i) (local.get $id) (local.get $args))))
    (else (call $elementary-float (local.get $kind) (local.get $r) (local.get $id) (local.get $args)))))

(define-runtime-section inverse-functions-runtime-wat ()
  ($asinh-f64) ($acosh-f64) ($inverse-real-distance) ($asin-acos-f64)
  ($inverse-rational-atanh) ($inverse-native))
