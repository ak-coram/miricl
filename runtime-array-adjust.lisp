;;;; Checked array adjustment, coordinate copying and vector stack operations.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $array-adjust-metadata-function () (:nullable-object)
  #@(if (ref.is_null (global.get $array-adjust-metadata-function))
    (then (global.set $array-adjust-metadata-function
      (call $node (i32.const 8) (i32.const ,(+ +clos-primitive-base+ (clos-primitive-op '%%array-adjust-metadata)))
        (ref.null eq) (ref.null eq) (ref.null eq)))))
  #@(global.get $array-adjust-metadata-function))

(define-runtime-function $array-adjust-metadata-primitive (($op i32) ($args :nullable-object)) (:nullable-object)
  (:locals ($tail :nullable-object))
  #@(local.set $tail (local.get $args))
  (wat-fail-when #@(i32.ne (call $tag (local.get $tail)) (i32.const 7)) :wrong-arity)
  #@(local.set $tail (struct.get $obj $b (ref.cast (ref $obj) (local.get $tail))))
  (wat-fail-when #@(i32.ne (call $tag (local.get $tail)) (i32.const 7)) :wrong-arity)
  #@(local.set $tail (struct.get $obj $b (ref.cast (ref $obj) (local.get $tail))))
  (wat-fail-when #@(i32.ne (call $tag (local.get $tail)) (i32.const 7)) :wrong-arity)
  #@(local.set $tail (struct.get $obj $b (ref.cast (ref $obj) (local.get $tail))))
  (wat-fail-when #@(i32.eqz (ref.is_null (local.get $tail))) :wrong-arity)
  #@(call $array-adjust-metadata-value (call $car (local.get $args))
    (call $car (call $cdr (local.get $args))) (call $car (call $cdr (call $cdr (local.get $args))))))

;; Every public callback packet is checked before raw vector/array fields.
(define-runtime-function $array-adjust-packet (($value :nullable-object) ($length i32)) ((ref $objects))
  #@(if (i32.or (i32.ne (call $tag (local.get $value)) (i32.const 34))
                (i32.eqz (ref.test (ref $vector) (local.get $value))))
    (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'simple-vector)))))
  #@(if (i32.ne (array.len (call $vector-data (local.get $value))) (local.get $length))
    (then (call $type-fail (local.get $value)
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'simple-vector)))
        (call $cons (call $int (local.get $length)) (ref.null eq)))
      (i32.const ,(runtime-error-code :malformed-form)))))
  #@(call $vector-data (local.get $value)))

;; Header validation precedes the shared representation getters.
(define-runtime-function $array-adjust-check (($value :nullable-object)) ()
  #@(if (i32.eqz (call $arrayp-native (local.get $value)))
    (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'array)))))
  #@(if (i32.eq (call $tag (local.get $value)) (i32.const 35))
    (then
      (if (i32.eqz (ref.test (ref $array) (local.get $value)))
        (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'array)))))
      (if (i32.ge_u (array.len (call $array-shape (local.get $value))) (i32.const 256))
        (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'array))))) (return)))
  #@(if (i32.eq (call $tag (local.get $value)) (i32.const 34))
    (then
      (if (i32.eqz (ref.test (ref $vector) (local.get $value)))
        (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'array))))) (return)))
  #@(if (i32.eqz (ref.test (ref $obj) (local.get $value)))
    (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'array)))))
  #@(if (ref.is_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $value))))
    (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'array))))))

(define-runtime-function $array-adjust-info (($array :nullable-object) ($fill-required i32)) (:nullable-object)
  (:locals ($rank i32) ($adjustable i32) ($fill i32))
  #@(call $array-adjust-check (local.get $array))
  #@(local.set $rank (call $array-rank-value (local.get $array)))
  #@(local.set $fill (i32.const -1))
  #@(if (i32.eq (call $tag (local.get $array)) (i32.const 35))
    (then
      ,(wat-fail-when #@(i32.eqz (ref.test (ref $array) (local.get $array))) :malformed-form)
      (local.set $adjustable (i32.and (call $value-n (local.get $array)) (i32.const 4)))
      (local.set $fill (struct.get $array $fill (ref.cast (ref $array) (local.get $array))))))
  #@(if (i32.eq (local.get $fill-required) (i32.const 2)) (then (return (call $int (local.get $fill)))))
  #@(if (local.get $fill-required) (then (drop (call $require-fill-pointer (local.get $array)))))
  #@(call $vector-new (array.new_fixed $objects 4
    (call $int (call $array-kind (local.get $array))) (call $int (local.get $rank))
    (call $bool (local.get $adjustable)) (call $int (local.get $fill)))))

(define-runtime-function $array-adjust-metadata-value
    (($selector :nullable-object) ($object :nullable-object) ($argument :nullable-object)) (:nullable-object)
  (:locals ($code i32) ($wide i64) ($packet (ref $objects)) ($array (ref $array))
           ($source :nullable-object) ($to i32) ($from i32) ($count i32) ($kind i32) ($rank i32))
  #@(if (i32.eqz (call $scalar-integer-p (local.get $selector)))
    (then (call $list-type-error (local.get $selector) (i32.const ,(runtime-symbol-id 'integer)))))
  #@(local.set $wide (call $scalar-integer-value (local.get $selector)))
  #@(if (i64.gt_u (local.get $wide) (i64.const 12))
    (then (call $type-fail (local.get $selector) (ref.null eq) (i32.const ,(runtime-error-code :malformed-form)))))
  #@(local.set $code (i32.wrap_i64 (local.get $wide)))
  #@(call $clear-values)
  #@(if (i32.eqz (local.get $code)) (then (return_call $array-adjust-info (local.get $object)
    (if (result i32) (ref.is_null (local.get $argument)) (then (i32.const 0)) (else (i32.const 2))))))
  #@(if (i32.eq (local.get $code) (i32.const 1))
    (then (return (call $int (call $upgraded-array-kind (local.get $object))))))
  #@(if (i32.eq (local.get $code) (i32.const 2))
    (then
      (call $array-adjust-check (local.get $object))
      (if (i32.eq (call $tag (local.get $object)) (i32.const 35))
        (then
          ,(wat-fail-when #@(i32.eqz (ref.test (ref $array) (local.get $object))) :malformed-form)
          (if (i32.and (call $value-n (local.get $object)) (i32.const 8))
            (then (return (struct.get $obj $a (ref.cast (ref $obj) (local.get $object))))))))
      (return (ref.null eq))))
  #@(if (i32.eq (local.get $code) (i32.const 3))
    (then
      (local.set $packet (call $array-adjust-packet (local.get $argument) (i32.const 8)))
      (call $array-adjust-check (local.get $object))
      (local.set $kind (call $array-kind (local.get $object)))
      (drop (call $array-adjust-shape (array.get $objects (local.get $packet) (i32.const 0))
        (call $array-rank-value (local.get $object))))
      (drop (call $natural-count (array.get $objects (local.get $packet) (i32.const 7))))
      (call $check-type-control-structure (array.get $objects (local.get $packet) (i32.const 1)))
      (if (i32.eqz (ref.is_null (array.get $objects (local.get $packet) (i32.const 6))))
        (then (call $array-adjust-check (array.get $objects (local.get $packet) (i32.const 6)))))
      (local.set $count (call $natural-count (array.get $objects (local.get $packet) (i32.const 4))))
      ,(wat-fail-when #@(i32.gt_u (local.get $count) (i32.const 7)) :malformed-form)
      (return_call $make-array-native
        (array.get $objects (local.get $packet) (i32.const 0)) (local.get $kind)
        (array.get $objects (local.get $packet) (i32.const 2)) (array.get $objects (local.get $packet) (i32.const 3))
        (local.get $count)
        (if (result i32) (i32.eq (call $tag (local.get $object)) (i32.const 35))
          (then (i32.and (call $value-n (local.get $object)) (i32.const 4))) (else (i32.const 0)))
        (array.get $objects (local.get $packet) (i32.const 5))
        (array.get $objects (local.get $packet) (i32.const 6))
        (array.get $objects (local.get $packet) (i32.const 7))
        (array.get $objects (local.get $packet) (i32.const 1)))))
  #@(if (i32.eq (local.get $code) (i32.const 4))
    (then
      (local.set $packet (call $array-adjust-packet (local.get $argument) (i32.const 4)))
      (local.set $source (array.get $objects (local.get $packet) (i32.const 0)))
      (call $array-adjust-check (local.get $object))
      (call $array-adjust-check (local.get $source))
      (local.set $to (call $bounded-index (array.get $objects (local.get $packet) (i32.const 1)) (call $array-length (local.get $object))))
      (local.set $from (call $bounded-index (array.get $objects (local.get $packet) (i32.const 2)) (call $array-length (local.get $source))))
      (local.set $count (call $natural-count (array.get $objects (local.get $packet) (i32.const 3))))
      ,(wat-fail-when #@(i32.or
        (i32.gt_u (local.get $count) (i32.sub (call $array-length (local.get $object)) (local.get $to)))
        (i32.gt_u (local.get $count) (i32.sub (call $array-length (local.get $source)) (local.get $from)))) :malformed-form)
      ,(wat-fail-when #@(i32.ne (call $array-kind (local.get $object)) (call $array-kind (local.get $source))) :malformed-form)
      (call $copy-sequence-region (local.get $object) (local.get $source) (local.get $to) (local.get $from) (local.get $count))
      (return (local.get $object))))
  #@(if (i32.eq (local.get $code) (i32.const 5))
    (then
      (return_call $array-adjust-commit (local.get $object) (local.get $argument))))
  #@(if (i32.eq (local.get $code) (i32.const 6)) (then (return_call $array-adjust-info (local.get $object) (i32.const 1))))
  #@(if (i32.eq (local.get $code) (i32.const 7))
    (then (call $array-adjust-check (local.get $object))
      (local.set $array (call $require-fill-pointer (local.get $object)))
      (local.set $count (call $bounded-index (local.get $argument) (call $array-length (local.get $object))))
      (struct.set $array $fill (local.get $array) (local.get $count)) (return (local.get $argument))))
  #@(if (i32.eq (local.get $code) (i32.const 8))
    (then (call $array-adjust-check (local.get $object))
      (local.set $kind (call $array-kind (local.get $object)))
      (if (i32.eq (local.get $kind) (i32.const 1)) (then (drop (call $character-code (local.get $argument)))))
      (if (i32.eq (local.get $kind) (i32.const 2)) (then (drop (call $bit-value (local.get $argument)))))
      (if (i32.eq (local.get $kind) (i32.const 4)) (then (drop (call $array-fixnum-value (local.get $argument)))))
      (if (i32.eq (local.get $kind) (i32.const 3))
        (then (call $type-fail (local.get $argument) (ref.null eq) (i32.const ,(runtime-error-code :expected-designator)))))
      (return (local.get $argument))))
  #@(if (i32.eq (local.get $code) (i32.const 9))
    (then
      (local.set $count (call $natural-count (local.get $argument)))
      (if (i32.eq (local.get $count) (i32.const 0)) (then (call $type-fail (local.get $object) (ref.null eq) (i32.const ,(runtime-error-code :malformed-form)))))
      (if (i32.eq (local.get $count) (i32.const 1)) (then (call $fail (i32.const ,(runtime-error-code :empty-vector)))))
      (if (i32.eq (local.get $count) (i32.const 2)) (then (call $fail (i32.const ,(runtime-error-code :not-adjustable)))))
      (if (i32.eq (local.get $count) (i32.const 3)) (then (call $type-fail (local.get $object) (ref.null eq) (i32.const ,(runtime-error-code :malformed-form)))))
      (if (i32.eq (local.get $count) (i32.const 4))
        (then (call $type-fail (local.get $object)
          (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'integer))) (call $cons (call $int (i32.const 1)) (ref.null eq)))
          (i32.const ,(runtime-error-code :expected-designator)))))
      (call $fail (i32.const ,(runtime-error-code :malformed-form))) (return (ref.null eq))))
  #@(if (i32.eq (local.get $code) (i32.const 10))
    (then (call $array-adjust-check (local.get $object))
      (return (call $array-kind-type (call $array-kind (local.get $object))))))
  #@(if (i32.eq (local.get $code) (i32.const 12))
    (then (return_call $list-length-native (local.get $object))))
  ;; Selector 11 is a checked single store, never a traversal or growth policy.
  (wat-fail-when #@(i32.ne (call $tag (local.get $argument)) (i32.const 7)) :malformed-form)
  #@(call $array-adjust-check (local.get $object))
  #@(return_call $array-element (local.get $object) (call $car (local.get $argument)) (call $cdr (local.get $argument)) (i32.const 1)))

(define-runtime-function $array-adjust-shape (($dimensions :nullable-object) ($rank i32)) (i32)
  (:locals ($scalar i32) ($scan :nullable-object) ($count :nullable-object)
           ($value :nullable-object) ($wide i64) ($dimension i32) ($total i32) ($overflow i32))
  ;; Check every dimension before the constructor reaches its allocation path.
  #@(if (i32.ge_u (local.get $rank) (i32.const 256))
    (then (call $type-fail (local.get $dimensions) (ref.null eq)
      (i32.const ,(runtime-error-code :malformed-form)))))
  #@(local.set $scalar (i32.eq (call $tag (local.get $dimensions)) (i32.const 1)))
  #@(if (local.get $scalar)
    (then (local.set $count (call $int (i32.const 1))))
    (else (local.set $count (call $list-length-native (local.get $dimensions)))))
  #@(if (ref.is_null (local.get $count))
    (then (drop (call $array-adjust-metadata-value (call $int (i32.const 9))
      (local.get $dimensions) (call $int (i32.const 0))))))
  #@(if (i32.ne (call $natural-count (local.get $count)) (local.get $rank))
    (then (call $type-fail (local.get $dimensions) (ref.null eq)
      (i32.const ,(runtime-error-code :malformed-form)))))
  #@(local.set $scan (local.get $dimensions))
  #@(local.set $total (i32.const 1))
  #@(block $done (loop $next
    (br_if $done (i32.and (i32.eqz (local.get $scalar)) (ref.is_null (local.get $scan))))
    (local.set $value (if (result (ref null eq)) (local.get $scalar)
      (then (local.get $dimensions)) (else (call $car (local.get $scan)))))
    ;; Any valid dimension fits the scalar decoder. Larger bignums and other
    ;; objects fail before unboxing; unsigned comparison also rejects negatives.
    (if (i32.eqz (call $scalar-integer-p (local.get $value)))
      (then (call $type-fail (local.get $value) (ref.null eq)
        (i32.const ,(runtime-error-code :malformed-form)))))
    (local.set $wide (call $scalar-integer-value (local.get $value)))
    (if (i64.gt_u (local.get $wide) (i64.const 536870910))
      (then (call $type-fail (local.get $value) (ref.null eq)
        (i32.const ,(runtime-error-code :malformed-form)))))
    (local.set $dimension (i32.wrap_i64 (local.get $wide)))
    (if (i32.eqz (local.get $dimension))
      (then (local.set $total (i32.const 0)) (local.set $overflow (i32.const 0)))
      (else (if (i32.eqz (local.get $overflow))
        (then (if (i32.gt_u (local.get $total) (i32.div_u (i32.const 536870910) (local.get $dimension)))
          (then (local.set $overflow (i32.const 1)))
          (else (local.set $total (i32.mul (local.get $total) (local.get $dimension)))))))))
    (br_if $done (local.get $scalar))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(if (local.get $overflow)
    (then (drop (call $array-adjust-metadata-value (call $int (i32.const 9))
      (local.get $dimensions) (call $int (i32.const 3))))))
  #@(local.get $total))

(define-runtime-function $array-adjust-next (($array :nullable-object)) (:nullable-object)
  #@(call $array-adjust-check (local.get $array))
  #@(if (i32.eq (call $tag (local.get $array)) (i32.const 35))
    (then (if (i32.and (call $value-n (local.get $array)) (i32.const 8))
      (then (return (struct.get $obj $a (ref.cast (ref $obj) (local.get $array))))))))
  #@(ref.null eq))

(define-runtime-function $array-adjust-chain (($old :nullable-object) ($target :nullable-object)) ()
  (:locals ($slow :nullable-object) ($fast :nullable-object))
  ;; Floyd traversal rejects an existing target cycle as well as a path to OLD.
  #@(local.set $slow (local.get $target)) #@(local.set $fast (local.get $target))
  #@(block $done (loop $next
    (br_if $done (ref.is_null (local.get $fast)))
    (if (ref.eq (local.get $fast) (local.get $old))
      (then (call $type-fail (local.get $target) (ref.null eq)
        (i32.const ,(runtime-error-code :malformed-form)))))
    (local.set $fast (call $array-adjust-next (local.get $fast)))
    (br_if $done (ref.is_null (local.get $fast)))
    (if (ref.eq (local.get $fast) (local.get $old))
      (then (call $type-fail (local.get $target) (ref.null eq)
        (i32.const ,(runtime-error-code :malformed-form)))))
    (local.set $fast (call $array-adjust-next (local.get $fast)))
    (local.set $slow (call $array-adjust-next (local.get $slow)))
    (if (i32.and (i32.eqz (ref.is_null (local.get $fast)))
          (ref.eq (local.get $fast) (local.get $slow)))
      (then (call $type-fail (local.get $target) (ref.null eq)
        (i32.const ,(runtime-error-code :malformed-form)))))
    (br $next))))

(define-runtime-function $array-adjust-commit (($object :nullable-object) ($argument :nullable-object)) (:nullable-object)
  (:locals ($array (ref $array)))
  #@(block (result (ref null eq))
      (call $array-adjust-check (local.get $object))
      (call $array-adjust-check (local.get $argument))
      ,(wat-fail-when #@(i32.eqz (ref.test (ref $array) (local.get $object))) :malformed-form)
      ,(wat-fail-when #@(i32.eqz (ref.test (ref $array) (local.get $argument))) :malformed-form)
      ,(wat-fail-when #@(i32.or (i32.ne (call $tag (local.get $object)) (i32.const 35))
                              (i32.ne (call $tag (local.get $argument)) (i32.const 35))) :malformed-form)
      ,(wat-fail-when #@(i32.or (i32.eqz (i32.and (call $value-n (local.get $object)) (i32.const 4)))
                              (i32.eqz (i32.and (call $value-n (local.get $argument)) (i32.const 4)))) :not-adjustable)
      ,(wat-fail-when #@(i32.ne (call $array-kind (local.get $object)) (call $array-kind (local.get $argument))) :malformed-form)
      ,(wat-fail-when #@(i32.ne (call $array-rank-value (local.get $object)) (call $array-rank-value (local.get $argument))) :malformed-form)
      ;; The callback itself is public: repeat the checked chain boundary before
      ;; committing even if no adjustment worker performed semantic preflight.
      (call $array-adjust-chain (local.get $object) (local.get $argument))
      (local.set $array (ref.cast (ref $array) (local.get $object)))
      (struct.set $obj $n (local.get $array) (call $value-n (local.get $argument)))
      (struct.set $obj $a (local.get $array) (struct.get $obj $a (ref.cast (ref $obj) (local.get $argument))))
      (struct.set $array $shape (local.get $array) (call $array-shape (local.get $argument)))
      (struct.set $array $offset (local.get $array) (struct.get $array $offset (ref.cast (ref $array) (local.get $argument))))
      (struct.set $array $fill (local.get $array) (struct.get $array $fill (ref.cast (ref $array) (local.get $argument))))
      (local.get $object)))

(define-runtime-function $adjust-array-copy
    (($old :nullable-object) ($new :nullable-object) ($axis i32) ($rank i32) ($from i32) ($to i32)) ()
  (:locals ($count i32) ($i i32) ($j i32) ($old-stride i32) ($new-stride i32))
  #@(if (i32.eq (local.get $axis) (local.get $rank))
    (then (drop (call $array-raw-element (local.get $new) (local.get $to)
      (call $array-raw-element (local.get $old) (local.get $from) (ref.null eq) (i32.const 0)) (i32.const 1))) (return)))
  #@(local.set $count (call $array-dimension-value (local.get $old) (local.get $axis)))
  #@(if (i32.gt_u (local.get $count) (call $array-dimension-value (local.get $new) (local.get $axis)))
    (then (local.set $count (call $array-dimension-value (local.get $new) (local.get $axis)))))
  #@(if (i32.eq (i32.add (local.get $axis) (i32.const 1)) (local.get $rank))
    (then (call $copy-sequence-region (local.get $new) (local.get $old) (local.get $to) (local.get $from) (local.get $count)) (return)))
  #@(local.set $old-stride (i32.const 1)) #@(local.set $new-stride (i32.const 1))
  #@(local.set $j (i32.add (local.get $axis) (i32.const 1)))
  #@(block $strided (loop $stride (br_if $strided (i32.eq (local.get $j) (local.get $rank)))
    (local.set $old-stride (i32.mul (local.get $old-stride) (call $array-dimension-value (local.get $old) (local.get $j))))
    (local.set $new-stride (i32.mul (local.get $new-stride) (call $array-dimension-value (local.get $new) (local.get $j))))
    (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $stride)))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $count)))
    (call $adjust-array-copy (local.get $old) (local.get $new) (i32.add (local.get $axis) (i32.const 1))
      (local.get $rank) (local.get $from) (local.get $to))
    (local.set $from (i32.add (local.get $from) (local.get $old-stride)))
    (local.set $to (i32.add (local.get $to) (local.get $new-stride)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next))))

(define-runtime-function $adjust-array-work
    (($old :nullable-object) ($dimensions :nullable-object) ($element :nullable-object)
     ($initial :nullable-object) ($contents :nullable-object) ($supplied i32)
     ($fill :nullable-object) ($displaced :nullable-object) ($offset :nullable-object)) (:nullable-object)
  (:locals ($kind i32) ($rank i32) ($adjustable i32) ($old-fill i32) ($new :nullable-object))
  #@(call $array-adjust-check (local.get $old))
