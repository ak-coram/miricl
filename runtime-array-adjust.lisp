;;;; Preserve intersecting array coordinates and update adjustable views in place.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $adjust-array-copy
    (($old :nullable-object) ($new :nullable-object) ($axis i32) ($rank i32) ($from i32) ($to i32)) ()
  (:locals ($count i32) ($i i32) ($j i32) ($old-stride i32) ($new-stride i32))
  #@(if (i32.eq (local.get $axis) (local.get $rank))
    (then (drop (call $array-raw-element (local.get $new) (local.get $to)
      (call $array-raw-element (local.get $old) (local.get $from) (ref.null eq) (i32.const 0)) (i32.const 1))) (return)))
  #@(local.set $count (call $array-dimension-value (local.get $old) (local.get $axis)))
  #@(if (i32.gt_u (local.get $count) (call $array-dimension-value (local.get $new) (local.get $axis)))
    (then (local.set $count (call $array-dimension-value (local.get $new) (local.get $axis)))))
  #@(if (i32.eq (i32.add (local.get $axis) (i32.const 1)) (local.get $rank))
    (then (call $copy-sequence-region (local.get $new) (local.get $old) (local.get $to) (local.get $from) (local.get $count)) (return)))
  #@(local.set $old-stride (i32.const 1)) #@(local.set $new-stride (i32.const 1))
  #@(local.set $j (i32.add (local.get $axis) (i32.const 1)))
  #@(block $strided (loop $stride (br_if $strided (i32.eq (local.get $j) (local.get $rank)))
    (local.set $old-stride (i32.mul (local.get $old-stride) (call $array-dimension-value (local.get $old) (local.get $j))))
    (local.set $new-stride (i32.mul (local.get $new-stride) (call $array-dimension-value (local.get $new) (local.get $j))))
    (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $stride)))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $count)))
    (call $adjust-array-copy (local.get $old) (local.get $new) (i32.add (local.get $axis) (i32.const 1))
      (local.get $rank) (local.get $from) (local.get $to))
    (local.set $from (i32.add (local.get $from) (local.get $old-stride)))
    (local.set $to (i32.add (local.get $to) (local.get $new-stride)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next))))

(define-runtime-function $adjust-array-native
    (($old :nullable-object) ($dimensions :nullable-object) ($element :nullable-object)
     ($initial :nullable-object) ($contents :nullable-object) ($supplied i32)
     ($fill :nullable-object) ($displaced :nullable-object) ($offset :nullable-object)) (:nullable-object)
  (:locals ($kind i32) ($rank i32) ($adjustable i32) ($old-fill i32) ($new :nullable-object) ($scan :nullable-object))
  #@(local.set $rank (call $array-rank-value (local.get $old)))
  #@(local.set $kind (call $array-kind (local.get $old)))
  (wat-fail-when #@(i32.ne (call $upgraded-array-kind (local.get $element)) (local.get $kind)) :malformed-form)
  #@(local.set $old-fill (i32.const -1))
  #@(if (i32.eq (call $tag (local.get $old)) (i32.const 35))
    (then (local.set $adjustable (i32.ne (i32.and (call $value-n (local.get $old)) (i32.const 4)) (i32.const 0)))
      (local.set $old-fill (struct.get $array $fill (ref.cast (ref $array) (local.get $old))))))
  #@(if (ref.is_null (local.get $fill))
    (then (if (i32.ge_s (local.get $old-fill) (i32.const 0)) (then (local.set $fill (call $int (local.get $old-fill))))))
    (else ,(wat-fail-when #@(i32.lt_s (local.get $old-fill) (i32.const 0)) :malformed-form)))
  ;; Updating an adjustable array must not introduce a displacement cycle.
  #@(if (local.get $adjustable)
    (then (local.set $scan (local.get $displaced))
      (block $acyclic (loop $check
        ,(wat-fail-when #@(ref.eq (local.get $scan) (local.get $old)) :malformed-form)
        (br_if $acyclic (i32.ne (call $tag (local.get $scan)) (i32.const 35)))
        (local.set $scan (struct.get $obj $a (ref.cast (ref $obj) (local.get $scan)))) (br $check)))))
  #@(local.set $new (call $make-array-native (local.get $dimensions) (local.get $kind)
    (local.get $initial) (local.get $contents) (local.get $supplied) (local.get $adjustable)
    (local.get $fill) (local.get $displaced) (local.get $offset) (local.get $element)))
  (wat-fail-when #@(i32.ne (call $array-rank-value (local.get $new)) (local.get $rank)) :malformed-form)
  #@(if (i32.and (i32.ne (local.get $kind) (i32.const 3))
        (i32.and (i32.and (i32.ne (call $array-length (local.get $old)) (i32.const 0))
                         (i32.ne (call $array-length (local.get $new)) (i32.const 0)))
          (i32.and (i32.eqz (i32.and (local.get $supplied) (i32.const 2))) (ref.is_null (local.get $displaced)))))
    (then (call $adjust-array-copy (local.get $old) (local.get $new) (i32.const 0) (local.get $rank) (i32.const 0) (i32.const 0))))
  #@(if (local.get $adjustable)
    (then
      (struct.set $obj $n (ref.cast (ref $obj) (local.get $old)) (call $value-n (local.get $new)))
      (struct.set $obj $a (ref.cast (ref $obj) (local.get $old)) (struct.get $obj $a (ref.cast (ref $obj) (local.get $new))))
      (struct.set $array $shape (ref.cast (ref $array) (local.get $old)) (call $array-shape (local.get $new)))
      (struct.set $array $offset (ref.cast (ref $array) (local.get $old)) (struct.get $array $offset (ref.cast (ref $array) (local.get $new))))
      (struct.set $array $fill (ref.cast (ref $array) (local.get $old)) (struct.get $array $fill (ref.cast (ref $array) (local.get $new))))
      (return (local.get $old))))
  #@(local.get $new))

(define-runtime-function $vector-stack-apply (($id i32) ($args :nullable-object)) (:nullable-object)
  (:locals ($vector (ref $array)) ($array :nullable-object) ($value :nullable-object)
           ($extension :nullable-object) ($fill i32) ($length i32) ($growth i32) ($kind i32))
  #@(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'vector-pop)))
    (then ,(wat-arity 1)
      (local.set $vector (call $require-fill-pointer (call $car (local.get $args))))
      (local.set $fill (struct.get $array $fill (local.get $vector)))
      ,(wat-fail-when #@(i32.eqz (local.get $fill)) :empty-vector)
      (local.set $fill (i32.sub (local.get $fill) (i32.const 1)))
      (struct.set $array $fill (local.get $vector) (local.get $fill))
      (return (call $array-raw-element (local.get $vector) (local.get $fill) (ref.null eq) (i32.const 0)))))
  #@(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'vector-push)))
    (then ,(wat-arity 2)) (else ,(wat-arity 2 3)))
  #@(local.set $value (call $car (local.get $args)))
  #@(local.set $array (call $car (call $cdr (local.get $args))))
  #@(local.set $vector (call $require-fill-pointer (local.get $array)))
  #@(local.set $fill (struct.get $array $fill (local.get $vector)))
  #@(local.set $length (call $array-length (local.get $array)))
  #@(if (i32.and (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'vector-push-extend)))
                (i32.eqz (ref.is_null (call $cdr (call $cdr (local.get $args))))))
    (then (local.set $extension (call $car (call $cdr (call $cdr (local.get $args)))))
      (if (if (result i32) (i32.eq (call $tag (local.get $extension)) (i32.const 1))
            (then (i32.le_s (call $value-n (local.get $extension)) (i32.const 0)))
            (else (i32.const 1)))
        (then (call $type-fail (local.get $extension)
          (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'integer)))
            (call $cons (call $int (i32.const 1)) (ref.null eq)))
          (i32.const ,(runtime-error-code :expected-designator)))))))
  #@(if (i32.eq (local.get $fill) (local.get $length))
    (then
      (if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'vector-push))) (then (return (ref.null eq))))
      ,(wat-fail-when #@(i32.eqz (i32.and (call $value-n (local.get $array)) (i32.const 4))) :not-adjustable)
      (local.set $kind (call $array-kind (local.get $array)))
      ;; Check the new element before any growth can change the vector.
      (if (i32.eq (local.get $kind) (i32.const 1)) (then (drop (call $character-code (local.get $value)))))
      (if (i32.eq (local.get $kind) (i32.const 2)) (then (drop (call $bit-value (local.get $value)))))
      (if (i32.eq (local.get $kind) (i32.const 3))
        (then (call $type-fail (local.get $value) (ref.null eq) (i32.const ,(runtime-error-code :expected-designator)))))
      (local.set $growth (if (result i32) (ref.is_null (local.get $extension))
        (then (select (local.get $length) (i32.const 1) (local.get $length)))
        (else (call $natural-count (local.get $extension)))))
      ,(wat-fail-when #@(i32.gt_u (local.get $growth) (i32.sub (i32.const 536870910) (local.get $length))) :allocation)
      (drop (call $adjust-array-native (local.get $array) (call $int (i32.add (local.get $length) (local.get $growth)))
        (call $array-kind-type (local.get $kind)) (ref.null eq) (ref.null eq) (i32.const 0)
        (ref.null eq) (ref.null eq) (call $int (i32.const 0))))))
  #@(drop (call $array-raw-element (local.get $array) (local.get $fill) (local.get $value) (i32.const 1)))
  #@(struct.set $array $fill (local.get $vector) (i32.add (local.get $fill) (i32.const 1)))
  #@(call $int (local.get $fill)))

(define-runtime-section array-adjust-runtime-wat ()
  ($adjust-array-copy) ($adjust-array-native) ($vector-stack-apply))
