;;;; Complex specialization without borrowing host numeric type relationships.
(in-package #:miricl-test)
(in-suite :miricl)

(defvar *complex-type-test-expansions* 0)
(defun complex-type-test-numeric (a b environment)
  (let ((result (integer-type-test-query a b 1 nil environment)))
    (if (zerop result) (real-type-test-query a b) result)))

(defun complex-type-test-metadata (selector type argument)
  (case selector
    (0 (let ((binding (assoc type argument :test #'equal)))
         (if binding
             (progn (incf *complex-type-test-expansions*)
                    (miricl-runtime:check-type-control-value (cdr binding) #'complex-type-test-metadata)
                    (cdr binding))
             type)))
    (1 (integer-type-test-metadata 2 type nil))
    (2 (complex-type-test-numeric type (car argument) (cdr argument)))
    (3 (list-length type))
    (4 (integer-type-test-metadata 4 type argument))
    (5 (cond ((and (consp type) (eq (car type) 'eql))
              (unless (= (length type) 2) (error 'program-error))
              (let ((value (cadr type)))
                (cond ((rationalp value) 'rational) ((typep value 'single-float) 'single-float)
                      ((typep value 'double-float) 'double-float) (t (error 'type-error :datum type :expected-type 'real)))))
             ((and (consp type) (member (car type) '(or member)))
              (let ((result nil))
                (dolist (part (cdr type))
                  (let ((upgraded (miricl-runtime:upgraded-complex-part-value
                                   (if (eq (car type) 'member) (list 'eql part) part) argument #'complex-type-test-metadata)))
                    (when upgraded
                      (setq result (cond ((not result) upgraded) ((eq result upgraded) result)
                                         ((or (eq result 'rational) (eq result 'real)
                                              (eq upgraded 'rational) (eq upgraded 'real)) 'real)
                                         (t 'float)))))) result))
             (t (error 'simple-type-error :datum type :expected-type 'real))))
    (6 (let ((a (car (complex-type-test-metadata 1 type nil)))
             (b (car (complex-type-test-metadata 1 (car argument) nil))))
         (setq a (or a type) b (or b (car argument)))
         (if (or (eq a b) (null a) (eq b 'real)) 1
             (complex-type-test-numeric a b (cdr argument)))))
    (7 (let ((name (if (and (simple-vector-p type) (= (length type) 2) (eq (svref type 0) :class))
                      (svref type 1) type)))
         (when (member name '(complex number t rational integer float cons symbol))
           (vector name '(complex number t) t))))))

(defun complex-type-test-upgrade (type &optional environment)
  (miricl-runtime:check-type-control-value type #'complex-type-test-metadata)
  (miricl-runtime:upgraded-complex-part-value type environment #'complex-type-test-metadata))
(defun complex-type-test-mask (type &optional environment)
  (miricl-runtime:check-type-control-value type #'complex-type-test-metadata)
  (miricl-runtime:complex-type-mask-value type environment #'complex-type-test-metadata))
(defun complex-type-test-query (a b &optional environment)
  (miricl-runtime:check-type-control-value a #'complex-type-test-metadata)
  (miricl-runtime:check-type-control-value b #'complex-type-test-metadata)
  (miricl-runtime:complex-subtype-query-value a (vector b environment) #'complex-type-test-metadata))

(test complex-type-port-upgrading
  (dolist (case '((nil nil) (integer rational) (ratio rational) (fixnum rational)
                  (bignum rational) (bit rational) (signed-byte rational) (unsigned-byte rational)
                  (short-float single-float) (single-float single-float)
                  (double-float double-float) (long-float double-float) (float float) (real real)
                  ((integer 2 1) nil) ((integer 1 3) rational) ((rational (1) 1) nil)
                  ((single-float 1/3 1/3) nil) ((double-float 1/3 1/3) nil)
                  ((float 16777217 16777217) double-float) ((real 1/3 1/3) rational)
                  ((eql 1) rational) ((eql 1.0) single-float) ((eql 1.0d0) double-float)
                  ((member) nil) ((member 1 2/3) rational) ((member 1.0 1.0d0) float)
                  ((member 1 1.0) real) ((or) nil) ((or integer single-float) real)))
    (is (eq (second case) (complex-type-test-upgrade (first case)))))
  (is (eq 'double-float (complex-type-test-upgrade (vector :class 'long-float))))
  (let ((*complex-type-test-expansions* 0))
    (is (eq 'rational (complex-type-test-upgrade 'local-part '((local-part . (integer 0 3))))))
    (is (= 1 *complex-type-test-expansions*))))

(test complex-type-port-masks-and-proofs
  (dolist (case '((complex 7) ((complex) 7) ((complex *) 7) ((complex nil) 8)
                  ((complex integer) 1) ((complex short-float) 2) ((complex long-float) 4)
                  ((complex float) 6) ((complex real) 7) ((complex (float 16777217 16777217)) 4)
                  (real 0) ((opaque complex) 0)))
    (is (= (second case) (complex-type-test-mask (first case)))))
  (dolist (case '(((complex nil) symbol 1) ((complex integer) (complex rational) 1)
                  ((complex short-float) (complex single-float) 1)
                  ((complex single-float) (complex float) 1)
                  ((complex double-float) (complex single-float) 2)
                  ((complex single-float) (complex (real 0 1)) 2)
                  ((complex (single-float 0 1)) (complex (real 0 2)) 1)
                  ((complex float) (complex real) 1) (complex complex 1)
                  (complex number 1) (complex t 1) (complex atom 1) (complex integer 2)
                  (complex symbol 2) (integer complex 2) (symbol complex 2)
                  ((real 2 1) complex 1) ((real 0 1) complex 2)
                  (complex (opaque) 0) ((opaque) complex 0)))
    (is (= (third case) (complex-type-test-query (first case) (second case)))))
  (is (= 7 (complex-type-test-mask (vector :class 'complex))))
  (is (= 1 (complex-type-test-query (vector :class 'complex) (vector :class 'number))))
  (is (= 1 (complex-type-test-query '(complex local-part) '(complex rational)
                                    '((local-part . (integer 1 2)))))))

(test complex-type-port-malformed-and-recovery
  (dolist (form '((complex real integer) (complex . real) (complex (integer (1 2) 3))))
    (signals error (complex-type-test-mask form)))
  (dolist (form '((eql :bad) (member 1 :bad) (or integer symbol)))
    (signals error (complex-type-test-upgrade form)))
  (let ((type (list 'complex nil)))
    (setf (second type) type)
    (signals simple-type-error (complex-type-test-mask type)))
  (let ((datum (list :literal)))
    (setf (cdr datum) datum)
    (dolist (type (list (list 'complex (list 'member datum)) (list 'complex (list 'eql datum))
                       (list 'complex (list 'opaque datum))))
      (is (eq type (miricl-runtime:check-type-control-value type #'complex-type-test-metadata)))))
  (is (= 1 (complex-type-test-query '(complex integer) '(complex rational))))
  (is (equal '(rational) (multiple-value-list (complex-type-test-upgrade 'integer))))
  (is (equal '(7) (multiple-value-list (complex-type-test-mask 'complex))))
  (is (equal '(1) (multiple-value-list (complex-type-test-query 'complex 'number)))) )

(defun complex-type-test-boundary-wat ()
  (miricl::wat-fragment
    (format nil
      "(func (export ~S) (param $mode i32) (result i32)
        (local $completed i32) (local $ok i32) (local $args (ref null eq))
        (block $failed (try_table (catch $transfer $failed)
          (if (i32.eqz (local.get $mode))
            (then (drop (call $complex-type-metadata-value (call $int (i32.const 8)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 1))
            (then (drop (call $complex-type-metadata-value (call $int64 (i64.const 4294967296)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 2))
            (then (drop (call $complex-type-metadata-value (call $int (i32.const 2)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 3))
            (then (drop (call $complex-type-metadata-primitive (i32.const 0) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 4))
            (then
              (local.set $args (call $cons (ref.null eq) (ref.null eq)))
              (struct.set $obj $b (ref.cast (ref $obj) (local.get $args)) (local.get $args))
              (drop (call $complex-type-metadata-primitive (i32.const 0) (local.get $args)))))
          (local.set $completed (i32.const 1))))
        (local.set $ok (i32.and (i32.eqz (local.get $completed)) (i32.eqz (ref.is_null (global.get $last-condition)))))
        (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
        (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
        (call $clear-values) (local.get $ok))
      (func (export ~S) (param $bad i32) (result i32)
        (local $packet (ref null eq)) (local $completed i32) (local $ok i32)
        (local.set $packet (call $cons (call $int (i32.const 42)) (ref.null eq)))
        (global.set $extra-values (local.get $packet)) (global.set $value-count (i32.const 3))
        (block $failed (try_table (catch $transfer $failed)
          (if (local.get $bad)
            (then (drop (call $complex-type-mask
              (call $cons (call $symbol (i32.const ~D))
                (call $cons (call $symbol (i32.const ~D))
                  (call $cons (call $symbol (i32.const ~D)) (ref.null eq)))) (ref.null eq))))
            (else
              (drop (call $upgraded-complex-part-type (call $symbol (i32.const ~D)) (ref.null eq)))
              (drop (call $complex-type-mask (call $symbol (i32.const ~D)) (ref.null eq)))
              (drop (call $complex-subtypep (call $symbol (i32.const ~D))
                (call $symbol (i32.const ~D)) (ref.null eq)))))
          (local.set $completed (i32.const 1))))
        (local.set $ok (i32.and
          (i32.and (ref.eq (global.get $extra-values) (local.get $packet)) (i32.eq (global.get $value-count) (i32.const 3)))
          (i32.eq (local.get $completed) (i32.eqz (local.get $bad)))))
        (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
        (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
        (call $clear-values) (local.get $ok))"
      "complex-type-checked-service" "complex-type-value-packets"
      (miricl::runtime-symbol-id 'complex) (miricl::runtime-symbol-id 'real) (miricl::runtime-symbol-id 'real)
      (miricl::runtime-symbol-id 'integer) (miricl::runtime-symbol-id 'complex)
      (miricl::runtime-symbol-id 'complex) (miricl::runtime-symbol-id 'number))))

(test complex-type-port-raw-value-packets
  (let ((original (fdefinition 'miricl::complex-type-runtime-wat)))
    (unwind-protect
        (progn
          (setf (fdefinition 'miricl::complex-type-runtime-wat)
            (lambda () (miricl::runtime-wat-sequence (funcall original) (complex-type-test-boundary-wat))))
          (let* ((miricl::*interpreter-only-wasm* nil)
                 (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
            (m:with-interpreter (vm)
              (dolist (mode '(0 1))
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "complex-type-value-packets" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)"))))
              (dolist (mode '(0 1 2 3 4))
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "complex-type-checked-service" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)")))))))
      (setf (fdefinition 'miricl::complex-type-runtime-wat) original))))
