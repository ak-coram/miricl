(defvar *native-compiler-image* nil)
(defvar *compile-evaluations-default* nil)
(defparameter *clos-library*
  (loop for file in '("clos-library.lisp" "method-combination-library.lisp" "development-library.lisp" "pathname-library.lisp"
                                  "logical-pathname-library.lisp" "filesystem-library.lisp" "time-library.lisp" "compiler-library.lisp" "file-compiler-library.lisp" "environment-library.lisp" "pretty-library.lisp" "javascript-library.lisp" "thread-library.lisp" "debugger-library.lisp" "bundle-library.lisp" "fasl-utilities.lisp" "fasl-format.lisp" "whole-program.lisp" "hir.lisp" "wasm-compiler.lisp" "wasm-optimizer.lisp" "wasm-disassembly.lisp" "evaluation-library.lisp") append
    (with-open-file (in (asdf:system-relative-pathname :miricl file))
      (let* ((*package* (find-package :miricl))
             (forms (loop for form = (read in nil :eof) until (eq form :eof)
                      if (and (consp form) (eq (car form) 'in-package))
                        do (setf *package* (find-package (second form)))
                      else collect (lower-runtime-library form))))
        ;; Establish the native package and symbol identities before DEFSTRUCT
        ;; generates accessors. Public exports are declared in PACKAGE.LISP.
        (when (member file '("thread-library.lisp" "debugger-library.lisp" "bundle-library.lisp" "whole-program.lisp" "hir.lisp" "wasm-compiler.lisp" "wasm-optimizer.lisp" "wasm-disassembly.lisp" "fasl-utilities.lisp" "fasl-format.lisp") :test #'equal)
          (let* ((package (find-package (cond ((equal file "thread-library.lisp") :miricl-threads)
                                            ((equal file "debugger-library.lisp") :miricl-debugger)
                                            ((equal file "bundle-library.lisp") :miricl-bundle)
                                            (t :miricl-compiler))))
                 (exports (sort (loop for symbol being the external-symbols of package collect symbol)
                                #'string< :key #'symbol-name))
                 (symbols (union (runtime-library-structure-symbols forms)
                                 (union exports (runtime-library-symbols forms)))))
            (setf forms (list (lower-runtime-library
              `(let ((*package* (find-package ,(package-name package)))) ,@forms))))
            (push (lower-runtime-library
              `(let ((package (or (find-package ,(package-name package))
                                  (make-package ,(package-name package) :use '("CL")))))
                 (shadowing-import ',(remove-if-not
                   (lambda (symbol) (eq (symbol-package symbol) package)) symbols) package)
                 (export ',exports package))) forms)))
        forms))))
(defparameter *clos-library-symbols*
  ;; UNION may share its tail with the primitive list, whose order defines IDs.
  (stable-sort (copy-list (union *clos-primitives* (runtime-library-symbols *clos-library*)))
               #'string< :key #'symbol-name))

(setf *runtime-library-symbol-codes*
  (runtime-library-symbol-codes
    (list (list *loop-library* *loop-library-symbols* 25)
          (list *clos-library* *clos-library-symbols* 24 *loop-library-symbols*))))

(defun clos-library-reference (symbol)
  (let ((id (position symbol *runtime-symbols*)))
    (if id `(call $symbol-object (i32.const ,id))
        `(array.get $objects (global.get $clos-library-symbols)
                    (i32.const ,(or (position symbol *clos-library-symbols*)
                                   (error "Unknown object library symbol ~S" symbol)))))))

(defun clos-library-bytes ()
  (runtime-library-bytes (compiler-image-library-forms) *clos-library-symbols* 24 *loop-library-symbols*))

(defun clos-library-data ()
  (runtime-library-data (clos-library-bytes)))

