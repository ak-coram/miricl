;;;; Guest package tables, visibility, and package operations.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; Package: n identity, a (name . nicknames), b present entries,
;; c metadata (n present count, a use-list, b shadowing symbols, c documentation).
;; Entry: n 1 internal/2 external, a symbol (possibly NIL), c bucket link.
;; Keep the enumeration list while indexing names for reader/INTERN lookups.

(define-runtime-function $active-package
    ()
    (:nullable-object)
  #@(if (i32.eqz (call $boundp (call $symbol (i32.const ,(runtime-symbol-id '*package*)))))
      (then (global.set $unbound-symbol (i32.const ,(runtime-symbol-id '*package*))) ,(wat-fail :unbound-variable)))
  #@(if (result (ref null $obj)) (ref.is_null (global.get $dynamic-package))
      (then (global.get $current-package))
      (else (struct.get $obj $a (call $car (global.get $dynamic-package))))))

(define-runtime-function $set-current-package
    (($p :nullable-object))
    ()
  #@(if (ref.is_null (global.get $dynamic-package)) (then (global.set $current-package (local.get $p)) (global.set $package-bound (i32.const 1)))
      (else (struct.set $obj $n (call $car (global.get $dynamic-package)) (i32.const 0))
            (struct.set $obj $a (call $car (global.get $dynamic-package)) (local.get $p)))))

(define-runtime-function $activate-bindings
    (($env :nullable-object) ($stop :nullable-object))
    ()
  (:locals ($binding :nullable-object))
  #@(if (ref.eq (local.get $env) (local.get $stop)) (then (return)))
  #@(call $activate-bindings (call $cdr (local.get $env)) (local.get $stop))
  #@(local.set $binding (call $car (local.get $env)))
  #@(if (i32.eqz (ref.is_null (struct.get $obj $c (local.get $binding))))
      (then (global.set $dynamic-variables (call $cons (local.get $binding) (global.get $dynamic-variables)))))
  #@(if (i32.eq (struct.get $obj $n (local.get $binding)) (i32.const ,(runtime-symbol-id '*package*)))
      (then (drop (call $require-package (call $binding-value (local.get $binding))))
            (global.set $dynamic-package (call $cons (struct.get $obj $a (local.get $binding)) (global.get $dynamic-package))))))

(define-runtime-function $unwind
    ()
    ()
  (:export "unwind")
  #@(global.set $debug-frames (ref.null $obj))
  #@(global.set $debug-evaluating (i32.const 0))
  #@(global.set $debug-internal (i32.const 0))
  #@(global.set $debug-depth (i32.const 0))
  #@(global.set $debug-step-depth (i32.const -1))
  #@(global.set $backtrace-depth (i32.const 0))
  #@(array.fill $objects (global.get $backtrace-frames) (i32.const 0) (ref.null $obj) (i32.const 64))
  #@(global.set $javascript-depth (i32.const 0))
  #@(global.set $thread-mask (i32.const 0))
  #@(global.set $derived-type-environment (ref.null $obj))
  #@(global.set $dynamic-package (ref.null $obj))
  #@(global.set $dynamic-variables (ref.null $obj))
  #@(global.set $native-environment-cache (ref.null $native-context))
  #@(global.set $format-base (i32.const 0))
  #@(global.set $format-column (i32.const 0))
  #@(global.set $format-stream (ref.null $obj))
  #@(global.set $format-list-stream (ref.null $obj))
  #@(global.set $format-list-state (ref.null $obj))
  #@(global.set $source-labels (ref.null $obj))
  #@(global.set $reader-stream (ref.null $obj))
  #@(global.set $reader-readtable (ref.null $obj))
  #@(global.set $reader-standard-syntax (i32.const 1))
  #@(global.set $reader-object-present (i32.const 1))
  #@(global.set $source-end (array.len (global.get $source)))
  #@(global.set $method-print-depth (i32.const 0))
  #@(global.set $circle-phase (i32.const 0))
  #@(global.set $circle-label (i32.const 0))
  #@(global.set $circle-table (ref.null $obj))
  #@(global.set $circle-stream (ref.null $obj))
  (runtime-wat-forms (loop for name in '($handlers $restarts $restart-associations $catches $targets $transfer-target $transfer-values)
                         collect `(global.set ,name (ref.null $obj)))))

(define-runtime-function $package-by-id
    (($id i32))
    (:nullable-object)
  (:locals ($list :nullable-object)
           ($p :nullable-object))
  #@(local.set $list (global.get $packages))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $list)))
    (local.set $p (call $car (local.get $list)))
    (if (i32.eq (struct.get $obj $n (local.get $p)) (local.get $id)) (then (return (local.get $p))))
    (local.set $list (call $cdr (local.get $list))) (br $next)))
  (wat-fail :invalid-package)
  #@(ref.null $obj))

(define-runtime-function $find-package
    (($name :nullable-object))
    (:nullable-object)
  (:locals ($list :nullable-object)
           ($names :nullable-object)
           ($p :nullable-object))
  #@(if (i32.eq (call $tag (local.get $name)) (i32.const 12)) (then (return (local.get $name))))
  #@(local.set $name (call $string-contents (call $string-designator (local.get $name))))
  #@(local.set $list (global.get $packages))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $list)))
    (local.set $p (call $car (local.get $list))) (local.set $names (struct.get $obj $a (local.get $p)))
    (block $names-done (loop $name (br_if $names-done (ref.is_null (local.get $names)))
      (if (call $string-equal (local.get $name) (call $car (local.get $names))) (then (return (local.get $p))))
      (local.set $names (call $cdr (local.get $names))) (br $name)))
    (local.set $list (call $cdr (local.get $list))) (br $next)))
  #@(ref.null $obj))

(define-runtime-function $require-package
    (($name :nullable-object))
    (:object)
  (:locals ($p :nullable-object))
  #@(local.set $p (call $find-package (local.get $name)))
  (wat-fail-when #@(ref.is_null (local.get $p)) :invalid-package)
  (wat-fail-when #@(ref.is_null (struct.get $obj $a (local.get $p))) :invalid-package)
  #@(ref.as_non_null (local.get $p)))

(define-runtime-function $present
    (($name :nullable-object) ($p :nullable-object))
    (:nullable-object)
  (:locals ($entry :nullable-object) ($table (ref $objects)))
  #@(local.set $table (ref.as_non_null
    (array.get $package-indexes (global.get $package-indexes) (struct.get $obj $n (local.get $p)))))
  #@(local.set $entry (array.get $objects (local.get $table)
    (call $package-name-bucket (local.get $name) (i32.sub (array.len (local.get $table)) (i32.const 1)))))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $entry)))
    (if (call $string-equal (local.get $name) (call $symbol-name (struct.get $obj $a (local.get $entry))))
        (then (return (local.get $entry))))
    (local.set $entry (struct.get $obj $c (local.get $entry))) (br $next)))
  #@(ref.null $obj))

(define-runtime-function $package-name-bucket (($name :nullable-object) ($mask i32)) (i32)
  (:locals ($characters :digits) ($i i32) ($hash i32))
  (wat-fail-when #@(i32.ne (call $tag (local.get $name)) (i32.const 10)) :expected-designator)
  #@(local.set $characters (ref.as_non_null (struct.get $obj $digits (local.get $name))))
  #@(local.set $hash (i32.const -2128831035))
  #@(block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (array.len (local.get $characters))))
    (local.set $hash (i32.mul
      (i32.xor (local.get $hash) (array.get $digits (local.get $characters) (local.get $i)))
      (i32.const 16777619)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(i32.and (local.get $hash) (local.get $mask)))

(define-runtime-function $initialize-package-index (($id i32)) ()
  (:locals ($new (ref $package-indexes)))
  #@(if (i32.ge_u (local.get $id) (array.len (global.get $package-indexes)))
    (then
      (local.set $new (array.new_default $package-indexes
        (i32.mul (i32.add (local.get $id) (i32.const 1)) (i32.const 2))))
      (array.copy $package-indexes $package-indexes (local.get $new) (i32.const 0)
        (global.get $package-indexes) (i32.const 0) (array.len (global.get $package-indexes)))
      (global.set $package-indexes (local.get $new))))
  #@(array.set $package-indexes (global.get $package-indexes) (local.get $id)
    (array.new_default $objects (i32.const 32))))

(define-runtime-function $rehash-package-index (($package :nullable-object) ($size i32)) ()
  (:locals ($table (ref $objects)) ($scan :nullable-object) ($entry :nullable-object) ($bucket i32))
  #@(local.set $table (array.new_default $objects (local.get $size)))
  #@(local.set $scan (struct.get $obj $b (local.get $package)))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $entry (call $car (local.get $scan)))
    (local.set $bucket (call $package-name-bucket (call $symbol-name (struct.get $obj $a (local.get $entry)))
      (i32.sub (local.get $size) (i32.const 1))))
    (struct.set $obj $c (local.get $entry) (array.get $objects (local.get $table) (local.get $bucket)))
    (array.set $objects (local.get $table) (local.get $bucket) (local.get $entry))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(array.set $package-indexes (global.get $package-indexes) (struct.get $obj $n (local.get $package)) (local.get $table)))

(define-runtime-function $inherited
    (($name :nullable-object) ($p :nullable-object))
    (:nullable-object)
  (:locals ($uses :nullable-object)
           ($entry :nullable-object)
           ($found :nullable-object))
  #@(local.set $uses (struct.get $obj $a (struct.get $obj $c (local.get $p))))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $uses)))
    (local.set $entry (call $present (local.get $name) (call $car (local.get $uses))))
    (if (i32.eqz (ref.is_null (local.get $entry)))
        (then (if (i32.eq (struct.get $obj $n (local.get $entry)) (i32.const 2))
                  (then (if (i32.eqz (ref.is_null (local.get $found)))
                            (then ,(wat-fail-when #@(i32.eqz (ref.eq (struct.get $obj $a (local.get $found)) (struct.get $obj $a (local.get $entry)))) :package-conflict)))
                        (local.set $found (local.get $entry))))))
    (local.set $uses (call $cdr (local.get $uses))) (br $next)))
  #@(local.get $found))

(define-runtime-function $accessible
    (($name :nullable-object) ($p :nullable-object))
    (:nullable-object)
  (:locals ($entry :nullable-object))
  #@(local.set $entry (call $present (local.get $name) (local.get $p)))
  #@(if (ref.is_null (local.get $entry)) (then (local.set $entry (call $inherited (local.get $name) (local.get $p)))))
  #@(local.get $entry))

(define-runtime-function $find-symbol
    (($name :nullable-object) ($p :nullable-object))
    (:nullable-object)
  (:locals ($entry :nullable-object))
  #@(local.set $name (call $string-contents (local.get $name)))
  #@(local.set $entry (call $present (local.get $name) (local.get $p)))
  #@(if (i32.eqz (ref.is_null (local.get $entry)))
      (then (return (call $two-values (struct.get $obj $a (local.get $entry))
        (call $symbol (if (result i32) (i32.eq (struct.get $obj $n (local.get $entry)) (i32.const 2))
          (then (i32.const ,(runtime-symbol-id :external))) (else (i32.const ,(runtime-symbol-id :internal)))))))))
  #@(local.set $entry (call $inherited (local.get $name) (local.get $p)))
  #@(if (i32.eqz (ref.is_null (local.get $entry)))
      (then (return (call $two-values (struct.get $obj $a (local.get $entry)) (call $symbol (i32.const ,(runtime-symbol-id :inherited)))))))
  #@(call $two-values (ref.null $obj) (ref.null $obj)))

(define-runtime-function $add-entry
    (($symbol :nullable-object) ($p :nullable-object) ($status i32))
    ()
  (:locals ($entry :object) ($table (ref $objects)) ($bucket i32) ($meta :nullable-object) ($count i32))
  #@(local.set $table (ref.as_non_null
    (array.get $package-indexes (global.get $package-indexes) (struct.get $obj $n (local.get $p)))))
  #@(local.set $bucket (call $package-name-bucket (call $symbol-name (local.get $symbol)) (i32.sub (array.len (local.get $table)) (i32.const 1))))
  #@(local.set $entry (call $node (i32.const 13) (local.get $status) (local.get $symbol)
    (ref.null $obj) (array.get $objects (local.get $table) (local.get $bucket))))
  #@(array.set $objects (local.get $table) (local.get $bucket) (local.get $entry))
  #@(struct.set $obj $b (local.get $p)
    (call $cons (local.get $entry)
                (struct.get $obj $b (local.get $p))))
  #@(local.set $meta (struct.get $obj $c (local.get $p)))
  #@(local.set $count (i32.add (struct.get $obj $n (local.get $meta)) (i32.const 1)))
  #@(struct.set $obj $n (local.get $meta) (local.get $count))
  #@(if (i32.gt_u (local.get $count) (array.len (local.get $table)))
    (then (call $rehash-package-index (local.get $p) (i32.mul (array.len (local.get $table)) (i32.const 2))))))

(define-runtime-function $intern
    (($name :nullable-object) ($p :nullable-object))
    (:nullable-object)
  (:locals ($symbol :nullable-object))
  #@(local.set $name (call $string-contents (local.get $name)))
  #@(local.set $symbol (call $find-symbol (local.get $name) (local.get $p)))
  #@(if (i32.eqz (ref.is_null (call $car (global.get $extra-values)))) (then (return (local.get $symbol))))
  #@(local.set $symbol (call $new-symbol (local.get $name) (local.get $p)))
  #@(call $add-entry (local.get $symbol) (local.get $p)
    (select (i32.const 2) (i32.const 1) (ref.eq (local.get $p) (global.get $keyword-package))))
  #@(call $two-values (local.get $symbol) (ref.null $obj)))

(define-runtime-function $names-available
    (($names :nullable-object) ($p :nullable-object))
    ()
  (:locals ($found :nullable-object))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $names)))
    (local.set $found (call $find-package (call $car (local.get $names))))
    ,(wat-fail-when #@(i32.and (i32.eqz (ref.is_null (local.get $found))) (i32.eqz (ref.eq (local.get $found) (local.get $p)))) :package-conflict)
    (local.set $names (call $cdr (local.get $names))) (br $next))))

(define-runtime-function $name-list
    (($names :nullable-object))
    (:nullable-object)
  #@(if (ref.is_null (local.get $names)) (then (return (ref.null $obj))))
  #@(call $cons (call $string-contents (call $string-designator (call $car (local.get $names)))) (call $name-list (call $cdr (local.get $names)))))

(define-runtime-function $package-cerror (($message :nullable-object) ($package :nullable-object)) ()
  (:locals ($condition :nullable-object))
  #@(local.set $condition (call $make-condition (call $symbol (i32.const ,(runtime-symbol-id 'package-error)))
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id :package)))
      (call $cons (local.get $package) (ref.null $obj)))))
  ;; Keep the host frontend's package error classification after an unhandled
  ;; correctable error, just as for native package validation failures.
  #@(struct.set $obj $n (local.get $condition) (i32.const ,(runtime-error-code :invalid-package)))
  #@(drop (call $condition-apply (i32.const ,(runtime-symbol-id 'cerror))
    (call $cons (local.get $message) (call $cons (local.get $condition) (ref.null $obj))))))

(define-runtime-function $make-package
    (($name :nullable-object) ($nicknames :nullable-object))
    (:object)
  (:locals ($p :object) ($found :nullable-object) ($scan :nullable-object) ($next :nullable-object)
           ($names :nullable-object))
  #@(local.set $names (call $cons (call $string-contents (call $string-designator (local.get $name))) (call $name-list (local.get $nicknames))))
  ;; Continuing a duplicate primary name returns its existing package;
  ;; continuing a duplicate nickname omits that nickname from the new one.
  #@(local.set $found (call $find-package (call $car (local.get $names))))
  #@(if (i32.eqz (ref.is_null (local.get $found)))
    (then (call $package-cerror ,(wat-text-literal "Use the existing package.") (local.get $found))
      (return (ref.as_non_null (local.get $found)))))
  #@(local.set $scan (local.get $names))
  #@(block $done (loop $next
    (local.set $next (call $cdr (local.get $scan)))
    (br_if $done (ref.is_null (local.get $next)))
    (local.set $found (call $find-package (call $car (local.get $next))))
    (if (ref.is_null (local.get $found)) (then (local.set $scan (local.get $next)))
      (else (call $package-cerror ,(wat-text-literal "Omit this nickname.") (local.get $found))
        (struct.set $obj $b (local.get $scan) (call $cdr (local.get $next)))))
    (br $next)))
  #@(local.set $p (call $node (i32.const 12) (global.get $next-package) (local.get $names) (ref.null $obj)
    (call $node (i32.const 15) (i32.const 0) (ref.null $obj) (ref.null $obj) (ref.null $obj))))
  #@(call $initialize-package-index (global.get $next-package))
  #@(global.set $next-package (i32.add (global.get $next-package) (i32.const 1)))
  #@(global.set $packages (call $cons (local.get $p) (global.get $packages)))
  #@(local.get $p))

(define-runtime-function $shadowed
    (($symbol :nullable-object) ($p :nullable-object))
    (i32)
  #@(call $member-eq (local.get $symbol) (struct.get $obj $b (struct.get $obj $c (local.get $p)))))

(define-runtime-function $check-conflict
    (($symbol :nullable-object) ($p :nullable-object))
    ()
  (:locals ($entry :nullable-object))
  #@(local.set $entry (call $accessible (call $symbol-name (local.get $symbol)) (local.get $p)))
  #@(if (i32.eqz (ref.is_null (local.get $entry)))
      (then ,(wat-fail-when #@(i32.and (i32.eqz (ref.eq (local.get $symbol) (struct.get $obj $a (local.get $entry))))
                         (i32.eqz (call $shadowed (struct.get $obj $a (local.get $entry)) (local.get $p)))) :package-conflict))))

(define-runtime-function $use-package
    (($used :nullable-object) ($p :nullable-object))
    ()
  (:locals ($list :nullable-object)
           ($entry :nullable-object)
           ($meta :nullable-object))
  (wat-fail-when #@(i32.or (ref.eq (local.get $p) (global.get $keyword-package))
              (ref.eq (local.get $used) (global.get $keyword-package))) :invalid-package)
  #@(local.set $meta (struct.get $obj $c (local.get $p)))
  #@(if (call $member-eq (local.get $used) (struct.get $obj $a (local.get $meta))) (then (return)))
  #@(local.set $list (struct.get $obj $b (local.get $used)))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $list)))
    (local.set $entry (call $car (local.get $list)))
    (if (i32.eq (struct.get $obj $n (local.get $entry)) (i32.const 2))
        (then (call $check-conflict (struct.get $obj $a (local.get $entry)) (local.get $p))))
    (local.set $list (call $cdr (local.get $list))) (br $next)))
  #@(struct.set $obj $a (local.get $meta) (call $cons (local.get $used) (struct.get $obj $a (local.get $meta)))))

(define-runtime-function $unuse-package
    (($used :nullable-object) ($p :nullable-object))
    ()
  (:locals ($meta :nullable-object))
  #@(local.set $meta (struct.get $obj $c (local.get $p)))
  #@(struct.set $obj $a (local.get $meta) (call $remove-eq (local.get $used) (struct.get $obj $a (local.get $meta)))))

(define-runtime-function $used-by
    (($p :nullable-object))
    (:nullable-object)
  (:locals ($list :nullable-object)
           ($result :nullable-object)
           ($other :nullable-object))
  #@(local.set $list (global.get $packages))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $list)))
    (local.set $other (call $car (local.get $list)))
    (if (call $member-eq (local.get $p) (struct.get $obj $a (struct.get $obj $c (local.get $other))))
        (then (local.set $result (call $cons (local.get $other) (local.get $result)))))
    (local.set $list (call $cdr (local.get $list))) (br $next)))
  #@(local.get $result))

(define-runtime-function $import
    (($symbol :nullable-object) ($p :nullable-object) ($shadow i32))
    ()
  (:locals ($entry :nullable-object)
           ($old :nullable-object)
           ($meta :nullable-object))
  (wat-fail-when #@(i32.eqz (call $symbolp (local.get $symbol))) :expected-designator)
  #@(if (i32.eqz (local.get $shadow))
      (then (local.set $entry (call $accessible (call $symbol-name (local.get $symbol)) (local.get $p)))))
  #@(if (i32.eqz (ref.is_null (local.get $entry)))
      (then (if (i32.eqz (ref.eq (struct.get $obj $a (local.get $entry)) (local.get $symbol)))
                (then (if (i32.eqz (local.get $shadow))
                  (then (call $package-cerror ,(wat-text-literal "Skip this import.") (local.get $p))
                    (return)))))))
  #@(local.set $entry (call $present (call $symbol-name (local.get $symbol)) (local.get $p)))
  #@(if (i32.eqz (ref.is_null (local.get $entry)))
      (then (local.set $old (struct.get $obj $a (local.get $entry)))
            (if (i32.eqz (ref.eq (local.get $old) (local.get $symbol)))
                (then (call $remove-present (local.get $old) (local.get $p)) (local.set $entry (ref.null $obj))))))
  #@(if (ref.is_null (local.get $entry)) (then (call $add-entry (local.get $symbol) (local.get $p) (i32.const 1))))
  #@(if (i32.eq (local.get $shadow) (i32.const 1))
      (then (struct.set $obj $n (call $present (call $symbol-name (local.get $symbol)) (local.get $p)) (i32.const 1))))
  #@(if (ref.is_null (call $symbol-home (local.get $symbol))) (then (call $set-home (local.get $symbol) (local.get $p))))
  #@(if (local.get $shadow)
