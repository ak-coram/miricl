(defun bootstrap-symbol-name-bytes (&optional (symbols *runtime-symbols*) kind-function)
  ;; Every bootstrap name is ASCII. Keep the source spelling in one passive
  ;; byte segment, rather than an I32.CONST instruction for every character.
  ;; Metadata records share a prefix with the previous name. Name-only callers
  ;; retain the original length/name format.
  (let ((bytes (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
        (previous ""))
    (dolist (symbol symbols bytes)
      (when kind-function
        (let ((kind (funcall kind-function symbol)))
          (assert (typep kind '(unsigned-byte 8)))
          (vector-push-extend kind bytes)))
      (let ((name (symbol-name symbol)))
        (assert (< (length name) 256))
        (let ((prefix (if kind-function (or (mismatch previous name) (length name)) 0)))
          (when kind-function (vector-push-extend prefix bytes))
          (vector-push-extend (- (length name) prefix) bytes)
          (loop for index from prefix below (length name) for code = (char-code (char name index)) do
            (assert (< code 128)) (vector-push-extend code bytes)))
        (setf previous name)))))

(defun bootstrap-public-symbol-bytes ()
  (bootstrap-symbol-name-bytes *runtime-symbols*
    (lambda (symbol)
      (logior (cond ((keywordp symbol) 1) ((member symbol *mop-symbols*) 2)
                   ((member symbol *extension-symbols*) 3) (t 0))
        (if (or (member symbol *runtime-special-operators*) (member symbol *runtime-macros*)) 4 0)))))

(defun bootstrap-private-symbol-bytes (symbols &optional primitives)
  (bootstrap-symbol-name-bytes symbols
    (lambda (symbol)
      (let ((primitive (position symbol primitives)))
        (cond (primitive (+ primitive 2)) ((keywordp symbol) 1) (t 0))))))

