;;;; Opaque package entry fixtures test algorithms separately from their ABI.
(in-package #:miricl-test)
(in-suite :miricl)

(defun package-entry-test-field (entry selector ignored)
  (declare (ignore ignored))
  (unless (and (simple-vector-p entry) (= (length entry) 3))
    (error 'type-error :datum entry :expected-type '(simple-vector 3)))
  (case selector (4 (svref entry 0)) (5 (svref entry 2)) (6 (svref entry 1))
    (otherwise (error 'type-error :datum selector :expected-type '(integer 4 6)))))

(test package-entry-hash-kernel
  (dolist (name '("" "ALPHA" "alpha" "NIL" "Αλφα" "🙂"))
    (dolist (mask '(0 31 63 127 1023))
      (let ((expected #x811c9dc5))
        (loop for character across name do
          (setf expected (ldb (byte 32 0) (* (logxor expected (char-code character)) #x1000193))))
        (is (= (logand expected mask) (miricl-runtime:package-name-hash name mask)))))))

(test package-present-entry-kernel
  (let* ((symbol (make-symbol "ALPHA"))
         (nil-entry (vector nil 2 nil))
         (entry (vector symbol 1 nil-entry)))
    (is (eq entry (miricl-runtime:find-present-package-entry "ALPHA" entry #'package-entry-test-field #'symbol-name)))
    (is (eq nil-entry (miricl-runtime:find-present-package-entry "NIL" entry #'package-entry-test-field #'symbol-name)))
    (is (null (miricl-runtime:find-present-package-entry "alpha" entry #'package-entry-test-field #'symbol-name)))
    (is (null (miricl-runtime:find-present-package-entry "MISSING" nil #'package-entry-test-field #'symbol-name)))
    (setf (svref nil-entry 2) entry)
    (signals type-error (miricl-runtime:find-present-package-entry "MISSING" entry #'package-entry-test-field #'symbol-name))
    (setf (svref nil-entry 2) nil)
    (is (eq nil-entry (miricl-runtime:find-present-package-entry "NIL" entry #'package-entry-test-field #'symbol-name)))))

(test package-inherited-entry-kernel
  (let* ((symbol (make-symbol "SHARED")) (other (make-symbol "SHARED"))
         (a (vector symbol 2 nil)) (b (vector symbol 2 nil))
         (c (vector other 2 nil)) (internal (vector other 1 nil)))
    (flet ((present (name package) (declare (ignore name)) package))
      (is (eq b (miricl-runtime:find-inherited-package-entry "SHARED" (list a internal b) #'package-entry-test-field #'present)))
      (is (eql 0 (miricl-runtime:find-inherited-package-entry "SHARED" (list a c) #'package-entry-test-field #'present)))
      (is (null (miricl-runtime:find-inherited-package-entry "SHARED" (list internal) #'package-entry-test-field #'present)))
      (let ((cycle (list a)))
        (setf (cdr cycle) cycle)
        (signals type-error (miricl-runtime:find-inherited-package-entry "SHARED" cycle #'package-entry-test-field #'present))))))

(test package-accessible-entry-kernel
  (let ((calls nil))
    (flet ((present (name package) (declare (ignore name package)) (push :present calls) :entry)
           (inherited (name package) (declare (ignore name package)) (push :inherited calls) :inherited))
      (is (eq :entry (miricl-runtime:find-accessible-package-entry "X" nil #'present #'inherited)))
      (is (equal '(:present) calls)))
    (flet ((present (name package) (declare (ignore name package)) nil)
           (inherited (name package) (declare (ignore name package)) :inherited))
      (is (eq :inherited (miricl-runtime:find-accessible-package-entry "X" nil #'present #'inherited))))))

(test package-entry-shadow-conflict-kernels
  (let ((a (make-symbol "SAME")) (b (make-symbol "SAME")))
    (is (miricl-runtime:package-symbol-shadowed-p a (list a)))
    (is (not (miricl-runtime:package-symbol-shadowed-p b (list a))))
    (is (miricl-runtime:package-symbol-shadowed-p nil (list a nil)))
    (is (not (miricl-runtime:package-entry-conflict-p a a nil)))
    (is (miricl-runtime:package-entry-conflict-p a b nil))
    (is (not (miricl-runtime:package-entry-conflict-p a b (list b)))))
  (let ((cycle (list :x)))
    (setf (cdr cycle) cycle)
    (signals type-error (miricl-runtime:package-symbol-shadowed-p :x cycle))
    (signals type-error (miricl-runtime:package-entry-conflict-p :x :y cycle))))

(test package-entry-raw-multiple-value-contract
  (let ((original (fdefinition 'miricl::package-runtime-wat)))
    (unwind-protect
         (progn
           (setf (fdefinition 'miricl::package-runtime-wat)
                 (lambda ()
                   (miricl::runtime-wat-sequence
                    (funcall original)
                    (miricl::wat-fragment
                     (format nil
                      "(func (export ~S) (param $mode i32) (param $count i32) (result i32)
                         (local $saved (ref null eq))
                         (global.set $extra-values
                           (if (result (ref null eq)) (i32.gt_u (local.get $count) (i32.const 1))
                             (then (call $cons (call $int (i32.const 42)) (ref.null eq)))
                             (else (ref.null eq))))
                         (global.set $value-count (local.get $count))
                         (local.set $saved (global.get $extra-values))
                         (if (i32.eq (local.get $mode) (i32.const 0))
                           (then (drop (call $package-name-bucket ~A (i32.const 31)))))
                         (if (i32.eq (local.get $mode) (i32.const 1))
                           (then (drop (call $present ~A (global.get $cl-package)))))
                         (if (i32.eq (local.get $mode) (i32.const 2))
                           (then (drop (call $inherited ~A (global.get $current-package)))))
                         (if (i32.eq (local.get $mode) (i32.const 3))
                           (then (drop (call $accessible ~A (global.get $current-package)))))
                         (if (i32.eq (local.get $mode) (i32.const 4))
                           (then (drop (call $shadowed (ref.null eq) (global.get $cl-package)))))
                         (if (i32.eq (local.get $mode) (i32.const 5))
                           (then (call $check-conflict (ref.null eq) (global.get $cl-package))))
                         (i32.and (ref.eq (local.get $saved) (global.get $extra-values))
                           (i32.eq (local.get $count) (global.get $value-count))))"
                      "package-entry-values-preserved"
                      (miricl::wat-string (miricl::wat-text-literal "CAR"))
                      (miricl::wat-string (miricl::wat-text-literal "CAR"))
                      (miricl::wat-string (miricl::wat-text-literal "CAR"))
                      (miricl::wat-string (miricl::wat-text-literal "CAR")))))))
           (let* ((miricl::*interpreter-only-wasm* nil)
                  (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
             (m:with-interpreter (vm)
               (dolist (mode '(0 1 2 3 4 5))
                 (dolist (count '(0 1 2 3))
                   (is (= 1 (wt:instance-call (miricl::interpreter-context vm)
                            (miricl::interpreter-instance vm)
                            "package-entry-values-preserved" mode count))))))))
      (setf (fdefinition 'miricl::package-runtime-wat) original))))

(defun package-enumeration-test-fields (node selector ignored)
  (declare (ignore ignored))
  (case selector
    (10 (list-length node))
    ((2 7 9)
     (unless (and (simple-vector-p node) (= (length node) 2))
       (error 'type-error :datum node :expected-type 'simple-vector))
     (case selector (2 (svref node 1)) (7 (svref node 0)) (9 node)))
    ((4 6) (package-entry-test-field node selector nil))
    (otherwise (error 'program-error))))

(defun package-enumeration-test-present (name package)
  (find name (svref package 0) :key (lambda (entry) (symbol-name (svref entry 0))) :test #'string=))

(defun package-enumeration-test-inherited (name package)
  (miricl-runtime:find-inherited-package-entry name (svref package 1)
    #'package-enumeration-test-fields #'package-enumeration-test-present))

(defun package-enumeration-test-callbacks ()
  (vector #'package-enumeration-test-fields #'package-enumeration-test-present
          #'package-enumeration-test-inherited #'symbol-name))

(test package-symbol-enumeration-kernels
  (let* ((x (make-symbol "SHARED")) (y (make-symbol "PRIVATE")) (z (make-symbol "NIL"))
         (a (vector (list (vector x 2 nil) (vector nil 2 nil)) nil))
         (b (vector (list (vector x 2 nil)) nil))
         (p (vector (list (vector y 1 nil)) (list a b)))
         (callbacks (package-enumeration-test-callbacks)))
    (is (equal (list y) (miricl-runtime:collect-package-symbols p nil nil callbacks)))
    (is (null (miricl-runtime:collect-package-symbols p t nil callbacks)))
    (let ((result (miricl-runtime:collect-package-symbols p nil t callbacks)))
      (is (= 3 (length result)))
      (is (member y result)) (is (member x result)) (is (member nil result)))
    (setf (svref p 0) (list (vector z 1 nil) (vector y 1 nil)))
    (let ((result (miricl-runtime:collect-package-symbols p nil t callbacks)))
      (is (= 3 (length result))) (is (member z result))
      (is (not (member nil result))))
    (let ((result (miricl-runtime:collect-all-package-symbols (list a b p) #'package-enumeration-test-fields)))
      (is (= 4 (length result)))
      (dolist (symbol (list nil x y z)) (is (member symbol result))))
    (let ((cycle (list (vector x 2 nil))))
      (setf (cdr cycle) cycle (svref b 0) cycle)
      (signals type-error (miricl-runtime:collect-package-symbols b nil nil callbacks))
      (signals type-error (miricl-runtime:collect-all-package-symbols (list b) #'package-enumeration-test-fields))
      (setf (svref b 0) nil)
      (is (null (miricl-runtime:collect-package-symbols b nil nil callbacks))))))

(test package-symbol-iterator-kernels
  (let* ((x (make-symbol "SHARED")) (y (make-symbol "PRIVATE"))
         (a (vector (list (vector x 2 nil) (vector nil 2 nil)) nil))
         (p (vector (list (vector y 1 nil)) (list a)))
         (callbacks (package-enumeration-test-callbacks)))
    (dolist (mask '(0 1 2 4 3 5 6 7))
      (let ((state (miricl-runtime:make-package-iteration-state (list p) mask callbacks)) (results nil))
        (loop for result = (miricl-runtime:next-package-symbol state) while result do (push result results))
        (is (= (if (logtest 1 mask) 1 0) (count 1 results :key (lambda (entry) (svref entry 1)))))
        (is (= 0 (count 2 results :key (lambda (entry) (svref entry 1)))))
        (is (= (if (logtest 4 mask) 2 0) (count 4 results :key (lambda (entry) (svref entry 1)))))
        (is (every (lambda (entry) (eq p (svref entry 2))) results))
        (is (equal '(nil) (multiple-value-list (miricl-runtime:next-package-symbol state))))))
    (dolist (bad '(nil 42 #(1) #(0 nil nil nil nil 0 nil 0 0 0)))
      (signals error (miricl-runtime:next-package-symbol bad)))
    (let* ((state (miricl-runtime:make-package-iteration-state (list p) 7 callbacks))
           (cycle (list (vector y 1 nil))))
      (setf (cdr cycle) cycle (svref state 2) p (svref state 3) cycle)
      (signals type-error (miricl-runtime:next-package-symbol state))
      (setf (svref state 3) nil)
      (is (miricl-runtime:next-package-symbol state)))))

(test package-global-name-availability-kernel
  (let ((a (list :a)) (b (list :b)))
    (flet ((lookup (name selector index)
             (declare (ignore index))
             (if (= selector 10) (list-length name)
                 (progn
                   (assert (= selector 8))
                   (cond ((string= name "A") a) ((string= name "B") b))))))
      (is (miricl-runtime:package-names-available-p '("FREE" "A") a #'lookup))
      (is (not (miricl-runtime:package-names-available-p '("B") a #'lookup)))
      (is (miricl-runtime:package-names-available-p nil a #'lookup))
      (signals type-error (miricl-runtime:package-names-available-p '("FREE" . :bad) a #'lookup))
      (let ((cycle (list "FREE")))
        (setf (cdr cycle) cycle)
        (signals type-error (miricl-runtime:package-names-available-p cycle a #'lookup)))
      (is (miricl-runtime:package-names-available-p '("FREE") a #'lookup)))))

(test package-enumeration-raw-multiple-value-contract
  (let ((original (fdefinition 'miricl::package-runtime-wat)))
    (unwind-protect
         (progn
           (setf (fdefinition 'miricl::package-runtime-wat)
             (lambda ()
               (miricl::runtime-wat-sequence (funcall original)
                 (miricl::wat-fragment
                   "(func (export \"package-enumeration-values-preserved\") (param $mode i32) (param $count i32) (result i32)
                     (local $saved (ref null eq))
                     (global.set $extra-values (call $cons (call $int (i32.const 42)) (ref.null eq)))
                     (global.set $value-count (local.get $count))
                     (local.set $saved (global.get $extra-values))
                     (if (i32.eq (local.get $mode) (i32.const 0))
                       (then (call $names-available (ref.null eq) (global.get $cl-package))))
                     (if (i32.eq (local.get $mode) (i32.const 1))
                       (then (drop (call $package-symbols (global.get $cl-package) (i32.const 0) (i32.const 0)))))
                     (if (i32.eq (local.get $mode) (i32.const 2))
                       (then (drop (call $all-symbols))))
                     (if (i32.eq (local.get $mode) (i32.const 3))
                       (then (drop (call $package-iterator-state (ref.null eq) (i32.const 7)))))
                     (i32.and (ref.eq (local.get $saved) (global.get $extra-values))
                       (i32.eq (local.get $count) (global.get $value-count))))"))))
           (let* ((miricl::*interpreter-only-wasm* nil)
                  (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
             (m:with-interpreter (vm)
               (dolist (mode '(0 1 2 3))
                 (dolist (count '(0 1 2 3))
                   (is (= 1 (wt:instance-call (miricl::interpreter-context vm)
                     (miricl::interpreter-instance vm) "package-enumeration-values-preserved" mode count))))))))
      (setf (fdefinition 'miricl::package-runtime-wat) original))))
