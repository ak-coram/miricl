  #@(if (i32.and (i32.eqz (local.get $depth)) (i32.eqz (global.get $circle-phase)))
    (then (if (i32.eqz (ref.is_null (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*print-circle*))))))
      (then (call $circle-root (local.get $x) (local.get $depth) (i32.const 1) (i32.const 0) (ref.null $obj)) (return)))))
  #@(if (call $circle-reference (local.get $x)) (then (return)))
  #@(if (call $print-pretty-object (local.get $x) (local.get $depth)) (then (return)))
  #@(if (call $symbolp (local.get $x))
    (then (call $print-name-characters (call $symbol-name (local.get $x)) (i32.const 0)) (return)))
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 7))
    (then (call $print-list (local.get $x) (local.get $depth) (i32.const 1)) (return)))
  #@(if (call $stringp-native (local.get $x))
    (then (call $print-text (call $string-contents (local.get $x))) (return)))
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 34))
    (then (call $print-vector (local.get $x) (local.get $depth) (i32.const 1)) (return)))
  #@(if (call $arrayp-native (local.get $x))
    (then (call $print-array (local.get $x) (local.get $depth) (i32.const 1)) (return)))
  #@(if (i32.or (i32.or (i32.eq (call $tag (local.get $x)) (i32.const 17))
                       (i32.eq (call $tag (local.get $x)) (i32.const 23)))
      (if (result i32) (i32.eq (call $tag (local.get $x)) (i32.const 8))
        (then (i32.eq (struct.get $obj $n (local.get $x)) (i32.const 2147483645))) (else (i32.const 0))))
    (then (call $print-method (call $symbol (i32.const ,(runtime-symbol-id 'print-object)))
      (local.get $x) (i32.const 2) (local.get $depth)) (return)))
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 16)) (then (call $emit-char (struct.get $obj $n (local.get $x))) (return)))
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 19))
      (then
        (local.set $report (call $car (call $property-cell (call $cdr (struct.get $obj $c (local.get $x)))
          (call $symbol (i32.const ,(runtime-symbol-id :report-function))))))
        (if (i32.eq (call $tag (local.get $report)) (i32.const 10))
            (then (call $print-text (local.get $report)) (return)))
        (if (i32.eqz (ref.is_null (local.get $report)))
          (then (local.set $stream (call $report-stream))
            (drop (call $apply (local.get $report) (call $cons (local.get $stream) (ref.null $obj))))
            (call $print-text (call $report-text (local.get $stream))) (return)))))
  #@(call $print-object (local.get $x) (local.get $depth)))

(define-runtime-function $print-aesthetic (($x :nullable-object)) ()
  (:locals ($saved :nullable-object))
  #@(local.set $saved (global.get $dynamic-variables))
  (apply #'runtime-wat-sequence (loop for name in '(*print-escape* *print-readably*) collect
    #@(if (i32.eqz (ref.is_null (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id name))))))
      (then (global.set $dynamic-variables (call $bind (global.get $dynamic-variables)
        (call $symbol (i32.const ,(runtime-symbol-id name))) (ref.null $obj)))))))
  #@(if (ref.eq (local.get $saved) (global.get $dynamic-variables))
    (then (call $print-aesthetic-depth (local.get $x) (i32.const 0)) (return)))
  #@(block $failed
    (try_table (catch $transfer $failed)
      (call $print-aesthetic-depth (local.get $x) (i32.const 0))
      (global.set $dynamic-variables (local.get $saved)) (return)))
  #@(global.set $dynamic-variables (local.get $saved))
  #@(throw $transfer))

(define-runtime-function $print-format (($control :nullable-object) ($args :nullable-object)) (:nullable-object)
  (:locals ($digits :digits) ($stream :nullable-object))
