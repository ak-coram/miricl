  #@(if (i32.eq (local.get $op) (i32.const 1)) (then (local.set $result (call $report-text (local.get $stream)))))
  #@(struct.set $text-stream $length (local.get $value) (i32.const 0))
  #@(struct.set $obj $n (local.get $stream) (i32.const 0))
