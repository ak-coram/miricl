  #@(i32.eq (call $id (struct.get $obj $c (local.get $stream))) (i32.const 1)))

(define-runtime-function $output-stream-designator (($stream :nullable-object)) (:nullable-object)
  #@(if (ref.is_null (local.get $stream))
    (then (return (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*standard-output*)))))))
  #@(if (i32.eq (call $id (local.get $stream)) (i32.const 1))
    (then (return (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*terminal-io*)))))))
  #@(local.get $stream))

(define-runtime-function $report-stream () (:nullable-object)
  #@(struct.new $text-stream (call $allocate-object-tag (i32.const 22)) (i32.const 0) (f64.const 0)
    (ref.null $digits) (ref.null $obj) (call $symbol (i32.const ,(runtime-symbol-id 'character))) (ref.null $obj)
    (array.new_default $digits (i32.const 32)) (i32.const 0) (i32.const 0)))

(define-runtime-function $require-output-stream (($stream :nullable-object)) ((ref $text-stream))
  #@(if (i32.ne (call $tag (local.get $stream)) (i32.const 22))
    (then (call $type-fail (local.get $stream)
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'satisfies)))
        (call $cons ,(clos-library-reference '%output-stream-p) (ref.null $obj)))
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(ref.cast (ref $text-stream) (local.get $stream)))

(define-runtime-function $require-open-output-stream (($stream :nullable-object)) ((ref $text-stream))
  (:locals ($value (ref $text-stream)))
  #@(local.set $value (call $require-output-stream (local.get $stream)))
  #@(if (struct.get $text-stream $closed (local.get $value))
    (then (drop (call $apply (call $symbol (i32.const ,(runtime-symbol-id 'error)))
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'stream-error)))
        (call $cons (call $symbol (i32.const ,(runtime-symbol-id :stream)))
          (call $cons (local.get $stream) (ref.null $obj)))))) (unreachable)))
  #@(local.get $value))

;; The buffer capacity is independent of the text length and output column.
;; Materialize only its occupied prefix when a callback finishes or output is
;; requested; appending many short writes then copies O(n) characters in total.
(define-runtime-function $report-text (($stream :nullable-object)) (:nullable-object)
  (:locals ($value (ref $text-stream)) ($text :nullable-object))
  #@(local.set $value (call $require-output-stream (local.get $stream)))
  #@(local.set $text (call $slice (struct.get $text-stream $data (local.get $value))
    (i32.const 0) (struct.get $text-stream $length (local.get $value))))
  #@(if (ref.is_null (struct.get $obj $b (local.get $stream)))
    (then (struct.set $obj $n (local.get $text) (i32.const 1))))
  #@(local.get $text))

(define-runtime-function $report-write (($stream :nullable-object) ($text :nullable-object)) ()
  (:locals ($a :digits) ($b :digits) ($result :digits) ($n i32) ($i i32) ($column i32)
           ($length i32) ($required i32) ($capacity i32) ($value (ref $text-stream)))
  #@(local.set $value (call $require-open-output-stream (local.get $stream)))
  #@(local.set $text (call $string-contents (local.get $text)))
  #@(local.set $a (struct.get $text-stream $data (local.get $value)))
  #@(local.set $b (ref.as_non_null (struct.get $obj $digits (local.get $text))))
  #@(local.set $length (array.len (local.get $b)))
  #@(if (i32.eqz (local.get $length)) (then (return)))
  #@(if (ref.is_null (struct.get $obj $b (local.get $stream)))
    (then (call $type-fail (call $node (i32.const 16) (array.get $digits (local.get $b) (i32.const 0))
      (ref.null $obj) (ref.null $obj) (ref.null $obj)) (ref.null $obj) (i32.const ,(runtime-error-code :expected-designator)))))
  #@(if (i32.eqz (ref.is_null (struct.get $obj $c (local.get $stream))))
    (then (call $append-stream-string (struct.get $obj $c (local.get $stream)) (local.get $text)))
    (else
      (local.set $n (struct.get $text-stream $length (local.get $value)))
      ,(wat-fail-when #@(i32.gt_u (local.get $length) (i32.sub (i32.const 536870910) (local.get $n))) :allocation)
      (local.set $required (i32.add (local.get $n) (local.get $length)))
      (local.set $capacity (array.len (local.get $a)))
      (if (i32.gt_u (local.get $required) (local.get $capacity))
        (then
          (local.set $capacity (i32.add (local.get $capacity) (local.get $capacity)))
          (if (i32.gt_u (local.get $required) (local.get $capacity)) (then (local.set $capacity (local.get $required))))
          (if (i32.gt_u (local.get $capacity) (i32.const 536870910)) (then (local.set $capacity (i32.const 536870910))))
          (local.set $result (array.new_default $digits (local.get $capacity)))
          (array.copy $digits $digits (local.get $result) (i32.const 0) (local.get $a) (i32.const 0) (local.get $n))
          (local.set $a (local.get $result))
          (struct.set $text-stream $data (local.get $value) (local.get $a))))
      (array.copy $digits $digits (local.get $a) (local.get $n) (local.get $b) (i32.const 0) (local.get $length))
      (struct.set $text-stream $length (local.get $value) (local.get $required))))
  #@(local.set $column (struct.get $obj $n (local.get $stream)))
  #@(block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
    (local.set $column (if (result i32) (i32.eq (array.get $digits (local.get $b) (local.get $i)) (i32.const 10))
      (then (i32.const 0)) (else (i32.add (local.get $column) (i32.const 1)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(struct.set $obj $n (local.get $stream) (local.get $column)))

(define-runtime-function $append-stream-string (($target :nullable-object) ($text :nullable-object)) ()
  (:locals ($array (ref $array)) ($fill i32) ($length i32) ($required i32) ($growth i32))
  #@(local.set $array (call $require-fill-pointer (local.get $target)))
  #@(local.set $fill (struct.get $array $fill (local.get $array)))
  #@(local.set $length (call $array-length (local.get $target)))
  #@(local.set $required (array.len (struct.get $obj $digits (local.get $text))))
  (wat-fail-when #@(i32.gt_u (local.get $required) (i32.sub (i32.const 536870910) (local.get $fill))) :allocation)
  #@(local.set $required (i32.add (local.get $fill) (local.get $required)))
  #@(if (i32.gt_u (local.get $required) (local.get $length))
    (then ,(wat-fail-when #@(i32.eqz (i32.and (struct.get $obj $n (local.get $target)) (i32.const 4))) :not-adjustable)
      (local.set $growth (i32.add (local.get $length) (local.get $length)))
      (if (i32.gt_u (local.get $required) (local.get $growth)) (then (local.set $growth (local.get $required))))
      (if (i32.gt_u (local.get $growth) (i32.const 536870910)) (then (local.set $growth (i32.const 536870910))))
      (drop (call $adjust-array-native (local.get $target) (call $int (local.get $growth))
        (call $array-kind-type (call $array-kind (local.get $target))) (ref.null $obj) (ref.null $obj)
        (i32.const 0) (ref.null $obj) (ref.null $obj) (call $int (i32.const 0))))))
  #@(call $copy-sequence-region (local.get $target) (local.get $text) (local.get $fill)
    (i32.const 0) (i32.sub (local.get $required) (local.get $fill)))
  #@(struct.set $array $fill (local.get $array) (local.get $required)))

(define-runtime-function $string-stream-operation
    (($op i32) ($stream :nullable-object) ($target :nullable-object)) (:nullable-object)
  (:locals ($value (ref $text-stream)) ($result :nullable-object) ($scan :nullable-object) ($kind i32) ($index i32) ($column i32))
  #@(if (i32.eqz (local.get $op))
    (then
      (if (i32.eqz (ref.is_null (local.get $target)))
        (then (if (i32.eqz (call $stringp-native (local.get $target)))
          (then (call $list-type-error (local.get $target) (i32.const ,(runtime-symbol-id 'string)))))
          (drop (call $require-fill-pointer (local.get $target)))
          (local.set $stream (call $array-kind-type (call $array-kind (local.get $target))))))
      (local.set $kind (call $upgraded-array-kind (local.get $stream)))
      ,(wat-fail-when #@(i32.and (i32.ne (local.get $kind) (i32.const 1)) (i32.ne (local.get $kind) (i32.const 3))) :expected-designator)
      (local.set $value (ref.cast (ref $text-stream) (call $report-stream)))
      (struct.set $obj $b (local.get $value) (call $array-kind-type (local.get $kind)))
      (struct.set $obj $c (local.get $value) (local.get $target))
      (if (i32.eqz (ref.is_null (local.get $target)))
        (then (local.set $index (call $array-sequence-length (local.get $target)))
          (block $line-start (loop $column
            (br_if $line-start (i32.eqz (local.get $index)))
            (local.set $index (i32.sub (local.get $index) (i32.const 1)))
            (br_if $line-start (i32.eq (call $character-code (call $sequence-value (local.get $target) (local.get $index))) (i32.const 10)))
            (local.set $column (i32.add (local.get $column) (i32.const 1))) (br $column)))
          (struct.set $obj $n (local.get $value) (local.get $column))))
      (return (local.get $value))))
  #@(if (i32.and (i32.ge_u (local.get $op) (i32.const 2)) (i32.le_u (local.get $op) (i32.const 4)))
    (then
      (call $require-stream (local.get $stream))
      (if (i32.eq (local.get $op) (i32.const 3)) (then (return (call $bool (call $stream-open-p (local.get $stream))))))
      (if (i32.eq (local.get $op) (i32.const 4)) (then (return (call $stream-element-type-native (local.get $stream)))))
      (if (i32.eq (call $tag (local.get $stream)) (i32.const 44))
        (then (call $close-file-native (local.get $stream) (i32.eqz (ref.is_null (local.get $target))))
          (return (call $symbol (i32.const 1)))))
      (if (i32.eq (call $tag (local.get $stream)) (i32.const 22))
        (then (struct.set $text-stream $closed (ref.cast (ref $text-stream) (local.get $stream)) (i32.const 1)))
        (else (struct.set $obj $c (local.get $stream) (call $symbol (i32.const 1)))))
      (return (call $symbol (i32.const 1)))))
  #@(if (i32.ge_u (local.get $op) (i32.const 5))
    (then (local.set $stream (call $stream-component
      (call $output-stream-designator (local.get $stream)) (i32.const 0))))
    (else (if (i32.ne (call $tag (local.get $stream)) (i32.const 22))
      (then (call $list-type-error (local.get $stream) (i32.const ,(runtime-symbol-id 'string-stream)))))))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 43))
    (then
      (local.set $scan (struct.get $obj $a (local.get $stream)))
      (block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
        (drop (call $string-stream-operation (local.get $op) (call $car (local.get $scan)) (ref.null $obj)))
        (local.set $scan (call $cdr (local.get $scan))) (br $next)))
      (return (ref.null $obj))))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 44))
    (then (call $flush-source-file (struct.get $obj $a (struct.get $obj $a (local.get $stream))))
      (return (ref.null $obj))))
  #@(local.set $value (call $require-output-stream (local.get $stream)))
  #@(if (call $console-stream-p (local.get $stream))
    (then (if (i32.eq (local.get $op) (i32.const 1))
      (then (call $list-type-error (local.get $stream) (i32.const ,(runtime-symbol-id 'string-stream)))))
      (drop (call $require-open-output-stream (local.get $stream)))
      (if (i32.eq (local.get $op) (i32.const 5)) (then (global.set $standard-output (ref.null $obj))))
      (return (ref.null $obj))))
  #@(drop (call $require-open-output-stream (local.get $stream)))
