  #@(local.set $digits (ref.as_non_null (struct.get $obj $digits (local.get $control))))
  #@(call $format-run (local.get $digits) (i32.const 0) (array.len (local.get $digits)) (local.get $args) (ref.null $obj) (local.get $args))
  #@(drop))

(define-runtime-function $render-text-body
