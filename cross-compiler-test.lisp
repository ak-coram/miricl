(in-package #:miricl-test)
(in-suite :miricl)

(defun check-cross-module (bytes)
  (wt:with-engine (engine)
    (let ((module (wt:compile-module engine (coerce bytes '(simple-array (unsigned-byte 8) (*))))))
      (unwind-protect (is (not (cffi:null-pointer-p module)))
        (wt::wasmtime-module-delete module)))))

(test host-cross-compilation
  (let ((state miricl-compiler::*compiler-state*) (*cross-effect* nil))
    (declare (special *cross-effect*))
    (check-cross-module
      (miricl-cross:compile-lambda
        '(lambda (object) (declare (optimize (safety 0)) (inline car))
           (setq *cross-effect* t) (car (the cons object)))
        :global-specials '(*cross-effect*)))
    (is (null *cross-effect*))
    (is (eq state miricl-compiler::*compiler-state*)))
  (let ((helper (gensym "CROSS-HELPER-")) (entry (gensym "CROSS-ENTRY-")))
    (check-cross-module
      (miricl-cross:compile-module
        `((defun ,helper (object) (car object))
          (defun ,entry (object) (,helper object))) :entry-points (list entry)))
    (is (not (fboundp helper))) (is (not (fboundp entry))))
  ;; Standard host macros can expand to implementation-private functions.
  (signals miricl-compiler::compiler-input-error
    (miricl-cross:compile-lambda '(lambda (object) (setf (slot-value object 'value) 42))))
  (let ((*cross-effect* nil))
    (declare (special *cross-effect*))
    (signals miricl-compiler::compiler-input-error
      (miricl-cross:compile-lambda '(lambda () (load-time-value (setq *cross-effect* t)))))
    (is (null *cross-effect*))
    (check-cross-module
      (miricl-cross:compile-lambda '(lambda () (load-time-value (+ 40 2)))
        :load-time-evaluator (lambda (form) (declare (ignore form)) 42))))
  (let ((bad (list 'lambda '(object) nil)))
    (setf (third bad) bad)
    (signals miricl-compiler::compiler-input-error (miricl-cross:compile-lambda bad)))
  (check-cross-module (miricl-cross:compile-lambda '(lambda (object) object))))

(test runtime-kernel-cache-after-host-reload
  (miricl-cross:runtime-kernel-wat 'miricl::$property-cell 'miricl-runtime:property-cell)
  (let ((original (fdefinition 'miricl-compiler:emit-native-module)) (called nil))
    (unwind-protect
        (progn
          (setf (fdefinition 'miricl-compiler:emit-native-module)
            (lambda (&rest arguments) (setq called t) (apply original arguments)))
          (miricl-cross:runtime-kernel-wat 'miricl::$property-cell 'miricl-runtime:property-cell)
          (is (eq t called)))
      (setf (fdefinition 'miricl-compiler:emit-native-module) original))))

(test canonical-inline-analysis-and-lowering
  ;; Model a definition changing after analysis selected its INLINE body.
  ;; The same emission must retain that body, while a fresh emission must
  ;; see the replacement. Do not redefine the host's own CONSP function.
  (let ((original (fdefinition 'miricl-compiler::compiler-primitive))
        (selected nil)
        (source '(lambda (x) (declare (optimize (safety 0) (debug 0)) (inline consp car))
                   (if (consp x) (car x) nil))))
    (labels ((imports (bytes)
               (nth-value 1 (miricl-compiler::native-disassembly-body bytes
                 (miricl-cross::kernel-export-index bytes "entry")))))
      (unwind-protect
          (progn
            (setf (fdefinition 'miricl-compiler::compiler-primitive)
              (lambda (operation &rest arguments)
                (if (and (= operation 19) (eq (first arguments) 'consp))
                    (values (if selected 0
                                (progn (setq selected t)
                                  (miricl-compiler::native-canonical-builtin-code 'consp))) t)
                    (apply original operation arguments))))
            (let ((bytes (miricl-cross:compile-lambda source)))
              (check-cross-module bytes)
              (is (not (find "native-function-reference" (imports bytes) :key #'second :test #'equal))))
            (let ((bytes (miricl-cross:compile-lambda source)))
              (check-cross-module bytes)
              (is (not (null (find "native-function-reference" (imports bytes) :key #'second :test #'equal))))))
        (setf (fdefinition 'miricl-compiler::compiler-primitive) original)))))

(test compiled-runtime-kernels
  ;; Execute the replacement in the compiler-less image as well as on SBCL /
  ;; the other host CLs. These checks exercise identity, mutation and recovery.
  (let* ((items (list :first 1 :second 2 :first 3)) (tail (cdr items)))
    (is (eq tail (miricl-runtime:property-cell items :first)))
    (rplaca (miricl-runtime:property-cell items :second) 42)
    (is (= 42 (getf items :second)))
    (is (null (miricl-runtime:property-cell '(:odd) :missing)))
    (signals type-error (miricl-runtime:property-cell '(:first 1 . 7) :missing)))
  (let ((object (list :identity)))
    (is (eq t (miricl-runtime:member-eq object (list nil object))))
    (is (null (miricl-runtime:member-eq (copy-list object) (list object))))
    (is (null (miricl-runtime:member-eq object nil)))
    (signals type-error (miricl-runtime:member-eq object (cons nil 7))))
  (is (eq t (miricl-runtime:list-eq '(1 2) (list 1 2))))
  (is (null (miricl-runtime:list-eq '(1 2) '(1 3))))
  (is (null (miricl-runtime:list-eq nil 7)))
  (signals type-error (miricl-runtime:list-eq 7 nil))
  (signals type-error (miricl-runtime:list-eq '(1 . 7) '(1)))
  (signals type-error (miricl-runtime:list-eq '(1 2) '(1 . 7)))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((cell (symbol-function (miricl-compiler::compiler-primitive 10 1 \"%CELL\")))
                (items (list :first 1 :second 2 :first 3)))
           (and (eq (funcall cell items :first) (cdr items))
                (progn (rplaca (funcall cell items :second) 42) (= (getf items :second) 42))
                (null (funcall cell nil :missing))
                (null (funcall cell '(:odd) :missing))
                (null (funcall cell '(:odd) :odd))
                (eql (funcall cell '(:odd . 7) :odd) 7)
                (handler-case (progn (funcall cell '(:first 1 . 7) :missing) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (handler-case (progn (funcall cell '(:first . 7) :missing) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (= (car (funcall cell items :second)) 42)))")))
      (is (eq t (m:evaluate-string vm
        "(let ((same (symbol-function (miricl-compiler::compiler-primitive 10 1 \"%LIST-EQ\"))))
           (and (eq t (funcall same '(1 2) (list 1 2)))
                (null (funcall same '(1 2) '(1 3)))
                (null (funcall same nil 7))
                (null (funcall same '(1) '(1 . 7)))
                (handler-case (progn (funcall same 7 nil) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (handler-case (progn (funcall same '(1 . 7) '(1)) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (handler-case (progn (funcall same '(1 2) '(1 . 7)) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (funcall same '(3) '(3))))"))))))

(test compiled-runtime-reversal
  (let* ((tail (list :tail)) (items (list (list :shared) :second))
         (copy (miricl-runtime:reverse-copy-onto items tail)))
    (is (equal copy (list :second (first items) :tail)))
    (is (eq (second copy) (first items)))
    (is (eq (cddr copy) tail))
    (is (not (eq (cdr copy) items)))
    (is (equal items '((:shared) :second))))
  (let* ((first (list :first :second)) (last (cdr first))
         (tail (list :tail)) (result (miricl-runtime:reverse-mutate-onto first tail)))
    (is (eq result last)) (is (eq (cdr result) first)) (is (eq (cdr first) tail)))
  (is (eq :tail (miricl-runtime:reverse-copy-onto nil :tail)))
  (is (eq :tail (miricl-runtime:reverse-mutate-onto nil :tail)))
  (signals type-error (miricl-runtime:reverse-copy-onto '(1 . 7) nil))
  (signals type-error (miricl-runtime:reverse-mutate-onto (cons 1 7) nil))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((tail (list :tail)) (items (list (list :shared) :second))
                 (copy (revappend items tail)))
           (and (equal copy (list :second (first items) :tail))
                (eq (second copy) (first items)) (eq (cddr copy) tail)
                (not (eq (cdr copy) items)) (equal items '((:shared) :second))))")))
      (is (eq t (m:evaluate-string vm
        "(let* ((first (list :first :second)) (last (cdr first))
                 (tail (list :tail)) (result (nreconc first tail)))
           (and (eq result last) (eq (cdr result) first) (eq (cdr first) tail)
                (eq (revappend nil :tail) :tail) (eq (nreconc nil :tail) :tail)))")))
      (is (eq t (m:evaluate-string vm
        "(and (handler-case (progn (revappend (cons 1 7) nil) nil)
                 (type-error (condition) (eql (type-error-datum condition) 7)))
              (handler-case (progn (nreconc (cons 1 7) nil) nil)
                 (type-error (condition) (eql (type-error-datum condition) 7)))
              (equal (revappend (list 1 2) :tail) '(2 1 . :tail))
              (equal (nreconc (list 1 2) :tail) '(2 1 . :tail)))"))))))

(test compiled-runtime-list-tails
  (let* ((items (list* :first :second :end)) (tail (cdr items)))
    (is (eq tail (miricl-runtime:last-bounded items 1)))
    (is (eq items (miricl-runtime:last-bounded items 2)))
    (is (eq items (miricl-runtime:last-bounded items #x7fffffff)))
    (is (eq :end (miricl-runtime:last-bounded items 0)))
    (is (null (miricl-runtime:last-bounded nil 0))))
  (let* ((item (list :shared)) (terminator (vector :end))
         (items (list* item :second terminator))
         (copy (miricl-runtime:copy-before-tail items :absent)))
    (is (not (eq copy items)))
    (is (not (eq (cdr copy) (cdr items))))
    (is (eq item (car copy)))
    (is (eq terminator (cddr copy)))
    (is (equal (list item) (miricl-runtime:copy-before-tail items (cdr items))))
    (is (equal (list item :second) (miricl-runtime:copy-before-tail items terminator)))
    (is (null (miricl-runtime:copy-before-tail items items))))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((item (list :shared)) (terminator (vector :end))
                 (items (list* item :second terminator)) (tail (cdr items))
                 (copy (ldiff items :absent)))
           (and (eq (last items) tail) (eq (last items 2) items)
                (eq (last items (ash 1 100)) items) (eq (last items 0) terminator)
                (null (last nil 0)) (null (last nil (ash 1 100)))
                (not (eq copy items)) (not (eq (cdr copy) tail))
                (eq (car copy) item) (eq (cddr copy) terminator)
                (equal (ldiff items tail) (list item))
                (equal (ldiff items terminator) (list item :second))
                (null (ldiff items items))
                (tailp tail items) (tailp terminator items)
                (not (tailp (copy-list tail) items))))")))
      (is (eq t (m:evaluate-string vm
        "(and (handler-case (progn (last 7) nil)
                 (type-error (c) (eql (type-error-datum c) 7)))
              (handler-case (progn (last '(1) -1) nil)
                 (type-error (c) (eql (type-error-datum c) -1)))
              (handler-case (progn (last '(1) :bad) nil)
                 (type-error (c) (eq (type-error-datum c) :bad)))
              (handler-case (progn (ldiff 7 7) nil)
                 (type-error (c) (eql (type-error-datum c) 7)))
              (handler-case (progn (tailp 7 7) nil)
                 (type-error (c) (eql (type-error-datum c) 7)))
              (equal (last '(1 2 3) 2) '(2 3))
              (equal (ldiff '(1 2 . :tail) :tail) '(1 2)))"))))))

(test compiled-runtime-butlast
  (dolist (count '(0 1 2 5 #x7fffffff))
    (let* ((shared (list :shared)) (items (list* shared :second :third :tail))
           ;; CLHS's zero-count dotted-list description and its LDIFF/LAST
           ;; equivalence disagree. Preserve MIRICL's existing truncation
           ;; interpretation; SBCL preserves the dotted atom in this case.
           (expected (if (zerop count) (list shared :second :third) (butlast items count)))
           (copy (miricl-runtime:copy-butlast-bounded items count))
           (input (copy-list items))
           (truncated (miricl-runtime:truncate-butlast-bounded input count)))
      (is (equal expected copy)) (is (equal expected truncated))
      (is (equal items (list* shared :second :third :tail)))
      (if expected
          (progn (is (not (eq copy items))) (is (eq (car copy) shared))
                 (is (eq truncated input)))
          (is (equal input items)))))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((shared (list :shared)) (items (list* shared :second :third :tail))
                 (copy (butlast items 0)))
           (and (equal copy (list shared :second :third)) (not (eq copy items))
                (not (eq (cdr copy) (cdr items))) (eq (car copy) shared)
                (eq (cdddr items) :tail)
                (equal (multiple-value-list (butlast items 1)) (list (list shared :second)))
                (null (butlast items (ash 1 100)))))")))
      (is (eq t (m:evaluate-string vm
        "(let* ((items (list* :first :second :third :tail))
                 (second (cdr items)) (removed (cddr items))
                 (result (nbutlast items 1)))
           (and (eq result items) (eq (cdr result) second) (null (cdr second))
                (equal result '(:first :second)) (equal removed '(:third . :tail))))")))
      (is (eq t (m:evaluate-string vm
        "(let* ((items (list* :first :second :tail)) (end (cdr items)))
           (and (eq items (nbutlast items 0)) (eq end (cdr items)) (null (cdr end))
                (equal items '(:first :second))))")))
      (is (eq t (m:evaluate-string vm
        "(let* ((items (list* :first :second :tail)) (tail (cdr items)))
           (and (null (nbutlast items 2)) (eq tail (cdr items)) (eq (cdr tail) :tail)
                (null (nbutlast items (ash 1 100))) (eq (cdr tail) :tail)
                (null (butlast nil 0)) (null (nbutlast nil 0))))")))
      (is (eq t (m:evaluate-string vm
        "(and
          (every (lambda (function)
            (and (handler-case (progn (funcall function 7) nil)
                   (type-error (c) (eql (type-error-datum c) 7)))
                 (every (lambda (count)
                   (handler-case (progn (funcall function (list 1 2) count) nil)
                     (type-error (c) (eql (type-error-datum c) count))))
                   '(-1 :bad 1/2 0.0)))) (list #'butlast #'nbutlast))
          (equal (butlast '(1 2 3)) '(1 2))
          (equal (nbutlast (list 1 2 3)) '(1 2)))"))))))
