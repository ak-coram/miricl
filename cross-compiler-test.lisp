(in-package #:miricl-test)
(in-suite :miricl)

(defun check-cross-module (bytes)
  (wt:with-engine (engine)
    (let ((module (wt:compile-module engine (coerce bytes '(simple-array (unsigned-byte 8) (*))))))
      (unwind-protect (is (not (cffi:null-pointer-p module)))
        (wt::wasmtime-module-delete module)))))

(test host-cross-compilation
  (let ((state miricl-compiler::*compiler-state*) (*cross-effect* nil))
    (declare (special *cross-effect*))
    (check-cross-module
      (miricl-cross:compile-lambda
        '(lambda (object) (declare (optimize (safety 0)) (inline car))
           (setq *cross-effect* t) (car (the cons object)))
        :global-specials '(*cross-effect*)))
    (is (null *cross-effect*))
    (is (eq state miricl-compiler::*compiler-state*)))
  (let ((helper (gensym "CROSS-HELPER-")) (entry (gensym "CROSS-ENTRY-")))
    (check-cross-module
      (miricl-cross:compile-module
        `((defun ,helper (object) (car object))
          (defun ,entry (object) (,helper object))) :entry-points (list entry)))
    (is (not (fboundp helper))) (is (not (fboundp entry))))
  ;; Standard host macros can expand to implementation-private functions.
  (signals miricl-compiler::compiler-input-error
    (miricl-cross:compile-lambda '(lambda (object) (setf (slot-value object 'value) 42))))
  (let ((*cross-effect* nil))
    (declare (special *cross-effect*))
    (signals miricl-compiler::compiler-input-error
      (miricl-cross:compile-lambda '(lambda () (load-time-value (setq *cross-effect* t)))))
    (is (null *cross-effect*))
    (check-cross-module
      (miricl-cross:compile-lambda '(lambda () (load-time-value (+ 40 2)))
        :load-time-evaluator (lambda (form) (declare (ignore form)) 42))))
  (let ((bad (list 'lambda '(object) nil)))
    (setf (third bad) bad)
    (signals miricl-compiler::compiler-input-error (miricl-cross:compile-lambda bad)))
  (check-cross-module (miricl-cross:compile-lambda '(lambda (object) object))))

(test runtime-kernel-cache-after-host-reload
  (dolist (name '(miricl-compiler:emit-native-module miricl-cross::kernel-worker-wat
                 miricl-cross::kernel-literal-plan))
    (miricl-cross:runtime-kernel-wat 'miricl::$property-cell 'miricl-runtime:property-cell)
    (let ((original (fdefinition name)) (called nil))
      (unwind-protect
          (progn
            (setf (fdefinition name)
              (lambda (&rest arguments) (setq called t) (apply original arguments)))
            (miricl-cross:runtime-kernel-wat 'miricl::$property-cell 'miricl-runtime:property-cell)
            (is (eq t called) "Reloaded ~S was bypassed." name))
        (setf (fdefinition name) original)))))

(defun kernel-test-svset (value vector index)
  (setf (svref vector index) value))

(test runtime-kernel-portable-vector-store
  (let* ((source '(setf (svref (progn (push :vector calls) vector)
                              (progn (push :index calls) 0))
                       (progn (push :value calls) 42)))
         (expanded (miricl-cross::kernel-macroexpand-hook
                     (lambda (&rest args) (declare (ignore args))
                       (error "Target store invoked the host SETF expander.")) source nil))
         ;; Supply a portable host operation for the target-only setter entry.
         ;; In particular, CCL need not expose a (SETF SVREF) function.
         (portable (subst '(function kernel-test-svset) '(function (setf svref)) expanded :test #'equal))
         (function (compile nil `(lambda ()
                     (let ((calls nil) (vector (vector nil)))
                       (let ((result ,portable))
                         (list result vector (nreverse calls))))))))
    (is (equalp '(42 #(42) (:vector :index :value)) (funcall function))))
  (signals miricl-compiler::compiler-input-error
    (miricl-cross:compile-lambda '(lambda (x) (setf (slot-value x 'slot) 42))
      :macroexpand-hook #'miricl-cross::kernel-macroexpand-hook)))

(defun kernel-test-setter-function (name)
  ;; Portable host stand-ins for the target setter ABI. A host need not expose
  ;; every standard SETF place as a callable (SETF accessor) function.
  (cond
    ((equal name '(setf elt)) (lambda (value sequence index) (setf (elt sequence index) value)))
    ((equal name '(setf char)) (lambda (value string index) (setf (char string index) value)))
    ((equal name '(setf row-major-aref))
     (lambda (value array index) (setf (row-major-aref array index) value)))
    ((equal name '(setf gethash)) (lambda (value key table) (setf (gethash key table) value)))
    ((equal name '(setf symbol-value)) (lambda (value symbol) (setf (symbol-value symbol) value)))
    ((equal name '(setf symbol-plist)) (lambda (value symbol) (setf (symbol-plist symbol) value)))
    ((equal name '(setf symbol-function)) (lambda (value symbol) (setf (symbol-function symbol) value)))
    (t (error "Unexpected target setter: ~S" name))))

(defun kernel-test-store-result (source object value observation)
  (let* ((expanded (miricl-cross::kernel-macroexpand-hook
                    (lambda (&rest args) (declare (ignore args))
                      (error "Target store invoked the host SETF expander.")) source nil))
         (portable (subst 'kernel-test-setter-function 'fdefinition expanded)))
    (funcall (compile nil `(lambda (object value)
                            (let ((calls nil))
                              (let ((result (multiple-value-list ,portable)))
                                (list result ,observation (nreverse calls)))))) object value)))

(test runtime-kernel-portable-sequence-and-hash-stores
  (dolist (accessor '(elt char row-major-aref))
    (let* ((object (case accessor
                     (elt (vector :old)) (char (copy-seq "a"))
                     (row-major-aref (make-array '(1 1) :initial-element :old))))
           (value (if (eq accessor 'char) #\Z (list :stored)))
           (source `(setf (,accessor (progn (push :object calls) object)
                                    (progn (push :index calls) 0))
                          (progn (push :value calls) (values value :discarded))))
           (result (kernel-test-store-result source object value `(,accessor object 0))))
      (is (equal (list value) (first result)))
      (is (eql value (second result)))
      (is (equal '(:object :index :value) (third result)))))
  (let* ((table (make-hash-table)) (value (list :stored))
         (result (kernel-test-store-result
                   '(setf (gethash (progn (push :key calls) :key)
                                  (progn (push :table calls) object))
                          (progn (push :value calls) (values value :discarded)))
                   table value '(gethash :key object))))
    (is (equal (list value) (first result)))
    (is (eq value (second result)))
    (is (equal '(:key :table :value) (third result)))
    (multiple-value-bind (stored present-p) (gethash :key table)
      (is (eq value stored)) (is (not (null present-p))))))

(test runtime-kernel-portable-symbol-stores
  (dolist (accessor '(symbol-value symbol-plist symbol-function))
    (let* ((symbol (make-symbol "KERNEL-STORE"))
           (value (if (eq accessor 'symbol-function) (lambda () :stored) (list :key :stored)))
           (result (kernel-test-store-result
                     `(setf (,accessor (progn (push :symbol calls) object))
                            (progn (push :value calls) (values value :discarded)))
                     symbol value `(,accessor object))))
      (is (equal (list value) (first result)))
      (is (eq value (second result)))
      (is (equal '(:symbol :value) (third result)))
      (is (null (symbol-package symbol)))
      (when (eq accessor 'symbol-function) (is (eq :stored (funcall symbol)))))))

(test runtime-kernel-simple-vector-p-adapter
  ;; Execute the linked predicate against the core's tag representation. This
  ;; checks both branches without constructing a complete interpreter image.
  (let* ((miricl-compiler::*compiler-state* :interpreted)
         (unit (miricl-compiler:compile-to-hir
                 '(lambda (object) (declare (optimize (safety 0) (debug 0))
                                           (inline simple-vector-p))
                    (simple-vector-p object))))
         (bytes (miricl-compiler:emit-native-module unit :entries (miricl-compiler:hir-unit-functions unit)))
         (index (miricl-cross::kernel-export-index bytes "direct-entry0-1"))
         (worker (miricl-cross::kernel-worker-wat bytes index "$predicate" 1 :truth nil))
         (module (wt:wat-to-wasm
                   (format nil "(module
                     (type $obj (struct (field i32)))
                     (func $tag (param (ref null eq)) (result i32)
                       local.get 0 ref.test (ref $obj)
                       if (result i32)
                         local.get 0 ref.cast (ref $obj) struct.get $obj 0
                       else i32.const 1 end)
                     (func $bool (param i32) (result (ref null eq))
                       local.get 0 if (result (ref null eq))
                         i32.const 1 ref.i31 else ref.null eq end)
                     ~A
                     (func (export ~S) (result i32)
                       i32.const 34 struct.new $obj call $predicate)
                     (func (export ~S) (result i32)
                       i32.const 10 struct.new $obj call $predicate)
                     (func (export ~S) (result i32)
                       i32.const 7 ref.i31 call $predicate)
                     (func (export ~S) (result i32)
                       ref.null eq call $predicate))"
                     worker "vector" "string" "integer" "nil"))))
    (wt:with-engine (engine)
      (wt:with-store ((store context) engine)
        (let ((compiled (wt:compile-module engine module)))
          (unwind-protect
              (wt:with-instance (instance context compiled)
                (is (= 1 (wt:instance-call context instance "vector")))
                (dolist (name '("string" "integer" "nil"))
                  (is (= 0 (wt:instance-call context instance name)))))
            (wt::wasmtime-module-delete compiled)))))))

(test runtime-kernel-hidden-arguments
  ;; A read after the first instruction or inside a branch is still an ABI
  ;; dependency. Establish CFG edges before querying entry liveness.
  (dolist (parameter '(0 4))
    (let* ((bytes (wt:wat-to-wasm
                    (format nil "(module (func (export ~S)
                      (param externref externref externref externref externref) (result externref)
                      local.get 1 ref.is_null if local.get ~D drop end ref.null extern))"
                      "worker" parameter)))
           (index (miricl-cross::kernel-export-index bytes "worker")))
      (signals error (miricl-cross::kernel-worker-wat bytes index "$invalid" 1 :object nil))))
  (let* ((bytes (wt:wat-to-wasm
                  "(module (func (export \"worker\")
                    (param externref externref externref externref externref) (result externref)
                    local.get 1 ref.is_null if ref.null extern drop end local.get 1))"))
         (index (miricl-cross::kernel-export-index bytes "worker")))
    (is (stringp (miricl-cross::kernel-worker-wat bytes index "$valid" 1 :object nil)))))

(test runtime-kernel-scalar-literals
  ;; Pooled scalar constants must survive closure-free linkage exactly,
  ;; including endpoints outside the immediate integer representation.
  (let* ((bytes (wt:wat-to-wasm
                  "(module
                     (import \"miricl\" \"native-literal\" (func (param externref i32) (result externref)))
                     (func (export \"worker\")
                       (param externref externref externref externref externref) (result externref)
                       local.get 0 i32.const 0 call 0))"))
         (index (miricl-cross::kernel-export-index bytes "worker")))
    (dolist (value '(-9223372036854775808 -2147483648 2147483647 2147483648 9223372036854775807))
      (let* ((worker (miricl-cross::kernel-worker-wat bytes index "$constant" 0 :object nil (vector value)))
             (module (wt:wat-to-wasm
                       (format nil "(module
                         (type $box (struct (field i64)))
                         (func $int64 (param i64) (result (ref null eq)) local.get 0 struct.new $box)
                         ~A
                         (func (export \"probe\") (result i64)
                           call $constant ref.cast (ref $box) struct.get $box 0))" worker))))
        (wt:with-engine (engine)
          (wt:with-store ((store context) engine)
            (let ((compiled (wt:compile-module engine module)))
              (unwind-protect
                  (wt:with-instance (instance context compiled)
                    (is (= value (wt:instance-call context instance "probe"))))
                (wt::wasmtime-module-delete compiled)))))))
    (dolist (value (list (ash 1 64) "requires a literal graph"))
      (signals error (miricl-cross::kernel-worker-wat bytes index "$invalid" 0 :object nil (vector value))))))

(test canonical-inline-analysis-and-lowering
  ;; Model a definition changing after analysis selected its INLINE body.
  ;; The same emission must retain that body, while a fresh emission must
  ;; see the replacement. Do not redefine the host's own CONSP function.
  (let ((original (fdefinition 'miricl-compiler::compiler-primitive))
        (selected nil)
        (source '(lambda (x) (declare (optimize (safety 0) (debug 0)) (inline consp car))
                   (if (consp x) (car x) nil))))
    (labels ((imports (bytes)
               (nth-value 1 (miricl-compiler::native-disassembly-body bytes
                 (miricl-cross::kernel-export-index bytes "entry")))))
      (unwind-protect
          (progn
            (setf (fdefinition 'miricl-compiler::compiler-primitive)
              (lambda (operation &rest arguments)
                (if (and (= operation 19) (eq (first arguments) 'consp))
                    (values (if selected 0
                                (progn (setq selected t)
                                  (miricl-compiler::native-canonical-builtin-code 'consp))) t)
                    (apply original operation arguments))))
            (let ((bytes (miricl-cross:compile-lambda source)))
              (check-cross-module bytes)
              (is (not (find "native-function-reference" (imports bytes) :key #'second :test #'equal))))
            (let ((bytes (miricl-cross:compile-lambda source)))
              (check-cross-module bytes)
              (is (not (null (find "native-function-reference" (imports bytes) :key #'second :test #'equal))))))
        (setf (fdefinition 'miricl-compiler::compiler-primitive) original)))))

(test noncanonical-inline-runtime-primitives
  ;; Replacing SYMBOLP/MAKE-ARRAY while invoking a compiler that depends on
  ;; them can break its runtime helpers. Isolate the definition-selection
  ;; query instead, and still compile/validate the entire resulting module.
  (dolist (case '((symbolp (lambda (x) (declare (inline symbolp)) (symbolp x)))
                 (make-array (lambda (n) (declare (fixnum n) (inline make-array)) (make-array n)))
                 (make-string (lambda (n) (declare (fixnum n) (inline make-string)) (make-string n)))
                 (list-length (lambda (x) (declare (inline list-length)) (list-length x)))))
    (let ((name (first case)) (source (second case))
          (original (fdefinition 'miricl-compiler::compiler-primitive)))
      (unwind-protect
          (progn
            (setf (fdefinition 'miricl-compiler::compiler-primitive)
              (lambda (operation &rest arguments)
                (if (and (= operation 19) (equal (first arguments) name))
                    (values 0 t)
                    (apply original operation arguments))))
            (let* ((bytes (miricl-cross:compile-lambda source))
                   (imports (nth-value 1 (miricl-compiler::native-disassembly-body bytes
                              (miricl-cross::kernel-export-index bytes "entry")))))
              (check-cross-module bytes)
              (is (not (null (find "native-function-reference" imports :key #'second :test #'equal))))))
        (setf (fdefinition 'miricl-compiler::compiler-primitive) original)))))

(test compiled-runtime-kernels
  ;; Execute the replacement in the compiler-less image as well as on SBCL /
  ;; the other host CLs. These checks exercise identity, mutation and recovery.
  (let* ((items (list :first 1 :second 2 :first 3)) (tail (cdr items)))
    (is (eq tail (miricl-runtime:property-cell items :first)))
    (rplaca (miricl-runtime:property-cell items :second) 42)
    (is (= 42 (getf items :second)))
    (is (null (miricl-runtime:property-cell '(:odd) :missing)))
    (signals type-error (miricl-runtime:property-cell '(:first 1 . 7) :missing)))
  (let ((object (list :identity)))
    (is (eq t (miricl-runtime:member-eq object (list nil object))))
    (is (null (miricl-runtime:member-eq (copy-list object) (list object))))
    (is (null (miricl-runtime:member-eq object nil)))
    (signals type-error (miricl-runtime:member-eq object (cons nil 7))))
  (is (eq t (miricl-runtime:list-eq '(1 2) (list 1 2))))
  (is (null (miricl-runtime:list-eq '(1 2) '(1 3))))
  (is (null (miricl-runtime:list-eq nil 7)))
  (signals type-error (miricl-runtime:list-eq 7 nil))
  (signals type-error (miricl-runtime:list-eq '(1 . 7) '(1)))
  (signals type-error (miricl-runtime:list-eq '(1 2) '(1 . 7)))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((cell (symbol-function (miricl-compiler::compiler-primitive 10 1 \"%CELL\")))
                (items (list :first 1 :second 2 :first 3)))
           (and (eq (funcall cell items :first) (cdr items))
                (progn (rplaca (funcall cell items :second) 42) (= (getf items :second) 42))
                (null (funcall cell nil :missing))
                (null (funcall cell '(:odd) :missing))
                (null (funcall cell '(:odd) :odd))
                (eql (funcall cell '(:odd . 7) :odd) 7)
                (handler-case (progn (funcall cell '(:first 1 . 7) :missing) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (handler-case (progn (funcall cell '(:first . 7) :missing) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (= (car (funcall cell items :second)) 42)))")))
      (is (eq t (m:evaluate-string vm
        "(let ((same (symbol-function (miricl-compiler::compiler-primitive 10 1 \"%LIST-EQ\"))))
           (and (eq t (funcall same '(1 2) (list 1 2)))
                (null (funcall same '(1 2) '(1 3)))
                (null (funcall same nil 7))
                (null (funcall same '(1) '(1 . 7)))
                (handler-case (progn (funcall same 7 nil) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (handler-case (progn (funcall same '(1 . 7) '(1)) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (handler-case (progn (funcall same '(1 2) '(1 . 7)) nil)
                  (type-error (condition) (eql (type-error-datum condition) 7)))
                (funcall same '(3) '(3))))"))))))

(test compiled-runtime-private-spines
  (let* ((shared (list :shared)) (items (list shared :second))
         (copy (miricl-runtime:copy-proper-list items)))
    (is (equal copy items)) (is (not (eq copy items)))
    (is (not (eq (cdr copy) (cdr items)))) (is (eq shared (car copy)))
    (is (null (miricl-runtime:copy-proper-list nil))))
  (dolist (bad '(7 (1 . 7)))
    (signals type-error (miricl-runtime:copy-proper-list bad)))
  (let* ((shared (list :shared)) (items (list :first shared :third shared))
         (tail (cddr items)) (removed (miricl-runtime:remove-first-eq shared items)))
    (is (equal removed (list :first :third shared)))
    (is (not (eq removed items))) (is (eq (cdr removed) tail))
    (is (eq (miricl-runtime:remove-first-eq :first items) (cdr items)))
    (is (equal items (list :first shared :third shared)))
    (let ((copy (miricl-runtime:remove-first-eq :absent items)))
      (is (equal copy items)) (is (not (eq copy items)))
      (is (not (eq (cdr copy) (cdr items)))))
    (is (eq :tail (miricl-runtime:remove-first-eq :first '(:first . :tail)))))
  (is (null (miricl-runtime:remove-first-eq :absent nil)))
  (signals type-error (miricl-runtime:remove-first-eq :absent '(:first . 7)))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((shared (list :shared)) (symbol (make-symbol \"SPINE\"))
                 (plist (list :first shared :second :value)))
           (setf (symbol-plist symbol) plist)
           (let* ((copy (copy-symbol symbol t)) (copied (symbol-plist copy)))
             (and (equal copied plist) (not (eq copied plist))
                  (not (eq (cdr copied) (cdr plist))) (eq (getf copied :first) shared)
                  (progn (setf (getf copied :second) :changed)
                         (eq (getf plist :second) :value)))))")))
      (is (eq t (m:evaluate-string vm
        "(let* ((package (make-package \"RUNTIME-SPINES\" :use nil))
                 (first (intern \"FIRST\" package)) (middle (intern \"MIDDLE\" package))
                 (last (intern \"LAST\" package)))
           (unwind-protect
               (and (export (list first middle last) package)
                    (unexport middle package)
                    (eq (nth-value 1 (find-symbol \"MIDDLE\" package)) :internal)
                    (unintern middle package) (null (find-symbol \"MIDDLE\" package))
                    (eq (find-symbol \"FIRST\" package) first)
                    (eq (find-symbol \"LAST\" package) last)
                    (eq (nth-value 1 (find-symbol \"LAST\" package)) :external))
             (delete-package package)))"))))))

(test compiled-runtime-nthcdr
  (let* ((tail (list :third)) (items (list* :first :second tail)))
    (is (eq items (miricl-runtime:nthcdr-bounded 0 items)))
    (is (eq tail (miricl-runtime:nthcdr-bounded 2 items)))
    (is (null (miricl-runtime:nthcdr-bounded 4 items))))
  (let ((items (cons :first :tail)))
    (is (eq :tail (miricl-runtime:nthcdr-bounded 1 items)))
    (signals type-error (miricl-runtime:nthcdr-bounded 2 items)))
  (let ((items (list :first :second)))
    (setf (cddr items) items)
    (is (eq items (miricl-runtime:nthcdr-bounded 1000 items))))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((tail (list :third)) (items (list* :first :second tail)))
           (and (eq items (nthcdr 0 items)) (eq tail (nthcdr 2 items))
                (null (nthcdr 4 items)) (null (nthcdr (ash 1 100) items))
                (equal (multiple-value-list (nthcdr 2 items)) (list tail))
                (eq :tail (nthcdr 1 (cons :first :tail)))))")))
      (is (eq t (m:evaluate-string vm
        "(let ((items (list :first :second)))
           (setf (cddr items) items) (eq items (nthcdr 1000 items)))")))
      (is (eq t (m:evaluate-string vm
        "(and (handler-case (progn (nthcdr 2 (cons :first :tail)) nil)
                 (type-error (c) (eq (type-error-datum c) :tail)))
              (every (lambda (bad) (handler-case (progn (nthcdr bad nil) nil)
                                    (type-error () t))) '(-1 :bad 1.5))
              (equal (nthcdr 1 '(1 2 3)) '(2 3)))"))))))

(test compiled-runtime-tail-and-list-boundaries
  (let* ((tail (list :second :third)) (items (cons :first tail)))
    (is (eq t (miricl-runtime:tail-member-p items items)))
    (is (eq t (miricl-runtime:tail-member-p items tail)))
    (is (eq t (miricl-runtime:tail-member-p items nil)))
    (is (null (miricl-runtime:tail-member-p items (copy-list tail))))
    (is (eq items (miricl-runtime:ensure-list items))))
  (let* ((number (ash 1 100)) (items (cons :first number)))
    (is (eq t (miricl-runtime:tail-member-p items (+ number 0))))
    (is (null (miricl-runtime:tail-member-p items nil))))
  (let ((items (list :first :second)))
    (setf (cddr items) items)
    (is (eq t (miricl-runtime:tail-member-p items (cdr items)))))
  (is (null (miricl-runtime:ensure-list nil)))
  (let* ((object (vector :shared)) (first (miricl-runtime:ensure-list object))
         (second (miricl-runtime:ensure-list object)))
    (is (equal first second)) (is (not (eq first second)))
    (is (eq object (car first))) (is (null (cdr first))))
  (let ((miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
    (m:with-interpreter (vm)
      (is (eq t (m:evaluate-string vm
        "(let* ((tail (list :second :third)) (items (cons :first tail))
                 (number (ash 1 100)) (dotted (cons :first number)))
           (and (tailp items items) (tailp tail items) (tailp nil items)
                (not (tailp (copy-list tail) items)) (not (tailp :first items))
                (tailp (+ (ash 1 99) (ash 1 99)) dotted) (not (tailp nil dotted))
                (equal (multiple-value-list (tailp tail items)) '(t))
                (let ((cycle (list :a :b)))
                  (setf (cddr cycle) cycle) (tailp (cdr cycle) cycle))))")))
      (is (eq t (m:evaluate-string vm
        "(and (handler-case (progn (tailp nil 7) nil)
                 (type-error (condition) (= (type-error-datum condition) 7)))
              (tailp nil '(1 2)))")))
      ;; Package operations use the internal helper with NIL, single symbols
      ;; and list arguments. Validate sharing/creation through the host above.
      (is (eq t (m:evaluate-string vm
