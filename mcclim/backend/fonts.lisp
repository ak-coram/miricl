(in-package #:mcclim-browser)

(defun browser-font (style)
  (let* ((family (text-style-family style)) (face (text-style-face style))
         (bold (or (eq face :bold) (and (listp face) (member :bold face))))
         (italic (or (eq face :italic) (and (listp face) (member :italic face)))))
    (format nil "~A ~A ~Dpx ~A" (if italic "italic" "normal") (if bold "bold" "normal")
      (climi::normalize-font-size (text-style-size style))
      (case family (:fix "monospace") (:serif "serif") (:sans-serif "sans-serif")
        (otherwise (if (stringp family) (format nil "~S" family) "monospace"))))))
(defmethod text-style-mapping ((port browser-font-port) (style text-style) &optional character-set)
  (declare (ignore character-set))
  (or (gethash style (climi::port-text-style-mappings port)) (browser-font style)))
(defmethod (setf text-style-mapping) (mapping (port browser-font-port) (style text-style) &optional character-set)
  (declare (ignore character-set))
  (setf (gethash style (climi::port-text-style-mappings port)) mapping))
(defun measure-browser-text (medium string text-style)
  (let* ((style (merge-text-styles text-style (medium-merged-text-style medium)))
         (context (or (measure-context (port medium))
                      (setf (measure-context (port medium)) (js:invoke (element "canvas") "getContext" "2d")))))
    (setf (js:property context "font") (text-style-mapping (port medium) style))
    (js:invoke context "measureText" string)))
(defun metric (metrics field fallback)
  (let ((value (js-field metrics field))) (if (numberp value) value fallback)))
(defmethod text-style-ascent (style (medium browser-font-medium))
  (climi::with-port-locked ((port medium))
    (ceiling (metric (measure-browser-text medium "Mg" style) "fontBoundingBoxAscent" 12))))
(defmethod text-style-descent (style (medium browser-font-medium))
  (climi::with-port-locked ((port medium))
    (ceiling (metric (measure-browser-text medium "Mg" style) "fontBoundingBoxDescent" 4))))
(defmethod text-style-height (style (medium browser-font-medium))
  (+ (text-style-ascent style medium) (text-style-descent style medium)))
(defmethod text-style-character-width (style (medium browser-font-medium) character)
  (climi::with-port-locked ((port medium))
    (metric (measure-browser-text medium (string character) style) "width" 0)))
(defmethod text-style-width (style (medium browser-font-medium))
  (text-style-character-width style medium #\m))
(defmethod text-size ((medium browser-font-medium) string &key text-style (start 0) end)
  (climi::with-port-locked ((port medium))
    (let* ((text (subseq (string string) start end))
           (metrics (measure-browser-text medium text text-style))
           (width (metric metrics "width" 0))
           (ascent (text-style-ascent text-style medium))
           (descent (text-style-descent text-style medium)))
      (values width (+ ascent descent) width 0 ascent))))
(defmethod text-bounding-rectangle* ((medium browser-font-medium) string &key text-style (start 0) end)
  (climi::with-port-locked ((port medium))
    (let* ((text (subseq (string string) start end)) (metrics (measure-browser-text medium text text-style)))
      (values (- (metric metrics "actualBoundingBoxLeft" 0))
              (- (metric metrics "actualBoundingBoxAscent" 0))
              (metric metrics "actualBoundingBoxRight" 0)
              (metric metrics "actualBoundingBoxDescent" 0)
              (metric metrics "width" 0) 0))))
(defmethod medium-draw-text* ((medium browser-medium) string x y start end align-x align-y toward-x toward-y transform-glyphs)
  (let ((text (subseq (string string) start end)))
    (with-canvas (context medium)
      (let ((style (medium-merged-text-style medium)))
        (setf (js:property context "font") (text-style-mapping (port medium) style)
              (js:property context "textBaseline") "alphabetic")
        (multiple-value-bind (xmin ymin xmax ymax) (text-bounding-rectangle* medium text)
          (let ((dx (ecase align-x ((:baseline) 0) (:left (- xmin)) (:center (- (/ (+ xmin xmax) 2))) (:right (- xmax))))
                (dy (ecase align-y ((:baseline) 0) (:top (- ymin)) (:center (- (/ (+ ymin ymax) 2))) (:bottom (- ymax)))))
            (canvas-transform context (climi::draw-text-transformation* medium x y toward-x toward-y transform-glyphs) "transform")
            (js:invoke context "fillText" text dx dy)))))))
