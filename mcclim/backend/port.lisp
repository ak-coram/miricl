(in-package #:mcclim-browser)

(defmethod find-port-type ((type (eql :browser)))
  (values 'browser-port 'identity))
(defmethod initialize-instance :after ((port browser-port) &key (container-id "mcclim-desktop"))
  (let* ((document (js:global "document"))
         (found (js:invoke document "getElementById" container-id))
         (root (if (js:strict-equal found js:+null+)
                   (element "div" (js:property document "body")) found)))
    (setf (js:property root "id") container-id
          (slot-value (port-pointer port) 'climi::port) port
          (slot-value port 'root) root)
    (css root "position" "relative")
    (css root "overflow" "hidden")
    (when (< (js-field root "clientHeight") 100) (css root "height" "90vh"))
    (make-graft port)
    (restart-port port)))

(defmethod make-graft ((port browser-port) &key (orientation :default) (units :device))
  (make-instance 'browser-graft :port port :orientation orientation :units units
    :mirror (make-instance 'browser-mirror :element (browser-root port) :canvas nil)))
(defun graft-size (graft orientation units)
  (let ((size (js-field (browser-root (port graft))
                       (if (eq orientation :horizontal) "clientWidth" "clientHeight"))))
    (ecase units (:device size) (:inches (/ size 96))
      (:millimeters (* (/ size 96) 25.4)) (:screen-sized 1))))
(defmethod graft-width ((graft browser-graft) &key (units :device))
  (graft-size graft :horizontal units))
(defmethod graft-height ((graft browser-graft) &key (units :device))
  (graft-size graft :vertical units))
(defmethod make-medium ((port browser-port) sheet)
  (make-instance 'browser-medium :port port :sheet sheet))
(defmethod make-frame-manager ((port browser-port))
  (make-instance 'browser-frame-manager :port port))
(defmethod find-concrete-pane-class ((manager browser-frame-manager) type &optional errorp)
  (declare (ignore type errorp))
  (let ((class (call-next-method)))
    (if (and class (subtypep class 'climi::top-level-sheet-pane)
             (not (subtypep class 'mirrored-sheet-mixin)))
        (let ((name (intern (format nil "MIRRORED-~A-~A"
                            (package-name (symbol-package (class-name class))) (class-name class))
                          '#:mcclim-browser)))
          (or (find-class name nil)
              (c2mop:ensure-class name :direct-superclasses (list (find-class 'mirrored-sheet-mixin) class))))
        class)))

(defmethod realize-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (let* ((parent (sheet-mirror (sheet-parent sheet)))
         (container (element "div" (mirror-element parent)))
         (front (element "canvas" container))
         (canvas (element "canvas"))
         (mirror (make-instance 'browser-mirror :element container :canvas canvas :front-canvas front)))
    (setf (js:property container "className") "mcclim-window"
          (js:property front "tabIndex") 0)
    (css container "position" "absolute")
    (css container "overflow" "hidden")
    (css front "display" "block")
    (css front "outline" "none")
    (css front "touch-action" "none")
    (install-input-handlers port sheet mirror)
    (when (and (typep sheet 'climi::top-level-sheet-mixin)
               (not (typep sheet 'climi::unmanaged-sheet-mixin)))
      (install-window-controls port sheet mirror))
    (unless (sheet-enabled-p sheet) (css container "display" "none"))
    mirror))
(defun apply-mirror-geometry (port sheet region)
  (let ((mirror (sheet-direct-mirror sheet)))
    (when mirror
      (multiple-value-bind (left top right bottom) (bounding-rectangle* region)
        (let ((width (max 1 (ceiling (- right left)))) (height (max 1 (ceiling (- bottom top)))))
          (setf (mirror-x mirror) left (mirror-y mirror) top)
          (css (mirror-element mirror) "left" (pixels left))
          (css (mirror-element mirror) "top" (pixels (- top (mirror-decoration-height mirror))))
          (unless (and (= width (mirror-width mirror)) (= height (mirror-height mirror)))
            (setf (mirror-width mirror) width (mirror-height mirror) height
                  (js:property (mirror-canvas mirror) "width") width
                  (js:property (mirror-canvas mirror) "height") height)
            (when (mirror-front-canvas mirror)
              (setf (js:property (mirror-front-canvas mirror) "width") width
                    (js:property (mirror-front-canvas mirror) "height") height))
            (enqueue-browser-event port (list :repaint sheet width height)))))))
  (bounding-rectangle* region))
(defmethod set-mirror-geometry ((port browser-port) sheet region)
  (apply-mirror-geometry port sheet region))
(defmethod put-mirror-geometry ((port browser-port) sheet region)
  (apply-mirror-geometry port sheet region))
(defmethod set-mirror-name ((port browser-port) sheet name)
  (let ((mirror (sheet-direct-mirror sheet)))
    (when (and mirror (mirror-title mirror))
      (setf (js:property (mirror-title mirror) "textContent") (princ-to-string name)))))
(defmethod destroy-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (let ((mirror (sheet-direct-mirror sheet)))
    (when mirror (js:invoke (mirror-element mirror) "remove"))))
(defmethod enable-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (let ((mirror (sheet-direct-mirror sheet)))
    (when mirror
      (css (mirror-element mirror) "display" "block")
      (raise-mirror port sheet)
      (enqueue-browser-event port (list :repaint sheet (mirror-width mirror) (mirror-height mirror))))))
(defmethod disable-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (let ((mirror (sheet-direct-mirror sheet)))
    (when mirror (css (mirror-element mirror) "display" "none"))))
(defmethod raise-mirror ((port browser-port) (sheet basic-sheet))
  (let ((mirror (sheet-direct-mirror sheet)))
    (when mirror (css (mirror-element mirror) "z-index" (format nil "~D" (incf (browser-stack port)))))))
(defmethod bury-mirror ((port browser-port) (sheet basic-sheet))
  (let ((mirror (sheet-direct-mirror sheet)))
    (when mirror (css (mirror-element mirror) "z-index" "0"))))
(defmethod shrink-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (disable-mirror port sheet))
(defmethod set-sheet-pointer-cursor ((port browser-port) sheet cursor)
  (let ((mirror (sheet-mirror sheet)))
    (when mirror
      (css (mirror-element mirror) "cursor"
        (case cursor (:ibeam "text") (:busy "wait") (:move "move") (:cross "crosshair")
          ((:hand :pointer) "pointer") (otherwise "default"))))))
(defmethod port-modifier-state ((port browser-port)) (browser-modifiers port))
(defmethod pointer-position ((pointer browser-pointer))
  (values (browser-pointer-x pointer) (browser-pointer-y pointer)))
(defmethod pointer-button-state ((pointer browser-pointer)) (browser-pointer-buttons pointer))
(defmethod port-grab-pointer ((port browser-port) pointer sheet &key multiple-window)
  (declare (ignore pointer sheet multiple-window)) t)
(defmethod port-ungrab-pointer ((port browser-port) pointer sheet)
  (declare (ignore pointer sheet)) t)

(setf climi::*default-server-path* '(:browser)
      climi::*server-path-search-order* '(:browser))
