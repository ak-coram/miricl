;;;; Gray stream protocol for the McCLIM image. Native streams retain their
;;;; original implementations; McCLIM streams use the portable protocol.
(defpackage #:trivial-gray-streams
  (:use #:cl)
  (:export #:fundamental-stream #:fundamental-input-stream #:fundamental-output-stream
           #:fundamental-character-stream #:fundamental-binary-stream
           #:fundamental-character-input-stream #:fundamental-character-output-stream
           #:fundamental-binary-input-stream #:fundamental-binary-output-stream
           #:stream-read-char #:stream-unread-char #:stream-read-char-no-hang
           #:stream-peek-char #:stream-listen #:stream-read-line #:stream-clear-input
           #:stream-write-char #:stream-line-column #:stream-start-line-p
           #:stream-write-string #:stream-terpri #:stream-fresh-line
           #:stream-finish-output #:stream-force-output #:stream-clear-output
           #:stream-advance-to-column #:stream-read-byte #:stream-write-byte
           #:stream-read-sequence #:stream-write-sequence #:stream-file-position))
(in-package #:trivial-gray-streams)
(defclass fundamental-stream () ((open-p :initform t :accessor %open-p)))
(defclass fundamental-input-stream (fundamental-stream) ())
(defclass fundamental-output-stream (fundamental-stream) ())
(defclass fundamental-character-stream (fundamental-stream) ())
(defclass fundamental-binary-stream (fundamental-stream) ())
(defclass fundamental-character-input-stream (fundamental-input-stream fundamental-character-stream) ())
(defclass fundamental-character-output-stream (fundamental-output-stream fundamental-character-stream) ())
(defclass fundamental-binary-input-stream (fundamental-input-stream fundamental-binary-stream) ())
(defclass fundamental-binary-output-stream (fundamental-output-stream fundamental-binary-stream) ())
(defgeneric stream-read-char (stream))
(defgeneric stream-unread-char (stream character))
(defgeneric stream-read-char-no-hang (stream))
(defgeneric stream-peek-char (stream))
(defgeneric stream-listen (stream))
(defgeneric stream-read-line (stream))
(defgeneric stream-clear-input (stream))
(defgeneric stream-write-char (stream character))
(defgeneric stream-line-column (stream))
(defgeneric stream-start-line-p (stream))
(defgeneric stream-write-string (stream string &optional start end))
(defgeneric stream-terpri (stream))
(defgeneric stream-fresh-line (stream))
(defgeneric stream-finish-output (stream))
(defgeneric stream-force-output (stream))
(defgeneric stream-clear-output (stream))
(defgeneric stream-advance-to-column (stream column))
(defgeneric stream-read-byte (stream))
(defgeneric stream-write-byte (stream byte))
(defgeneric stream-read-sequence (stream sequence start end &key &allow-other-keys))
(defgeneric stream-write-sequence (stream sequence start end &key &allow-other-keys))
(defgeneric stream-file-position (stream))
(defgeneric (setf stream-file-position) (position stream))
(defmethod stream-read-char-no-hang ((stream fundamental-input-stream)) (stream-read-char stream))
(defmethod stream-peek-char ((stream fundamental-input-stream))
  (let ((char (stream-read-char stream)))
    (unless (eq char :eof) (stream-unread-char stream char)) char))
(defmethod stream-read-line ((stream fundamental-input-stream))
  (let ((chars (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
    (loop for char = (stream-read-char stream)
          do (cond ((eq char :eof) (return (values chars t)))
                   ((char= char #\Newline) (return (values chars nil)))
                   (t (vector-push-extend char chars))))))
(defmethod stream-line-column ((stream fundamental-output-stream)) nil)
(defmethod stream-start-line-p ((stream fundamental-output-stream)) (eql (stream-line-column stream) 0))
(defmethod stream-write-string ((stream fundamental-output-stream) string &optional (start 0) end)
  (loop for i from start below (or end (length string)) do (stream-write-char stream (char string i))) string)
(defmethod stream-terpri ((stream fundamental-output-stream)) (stream-write-char stream #\Newline) nil)
(defmethod stream-fresh-line ((stream fundamental-output-stream))
  (unless (stream-start-line-p stream) (stream-terpri stream) t))
(defmethod stream-finish-output ((stream fundamental-output-stream)) nil)
(defmethod stream-force-output ((stream fundamental-output-stream)) nil)
(defmethod stream-clear-output ((stream fundamental-output-stream)) nil)
(defmethod stream-clear-input ((stream fundamental-input-stream)) nil)
(defmethod stream-advance-to-column ((stream fundamental-output-stream) column)
  (let ((current (stream-line-column stream)))
    (when current (loop repeat (max 0 (- column current)) do (stream-write-char stream #\Space)) t)))

(defpackage #:mcclim-streams
  (:use #:cl #:trivial-gray-streams)
  (:shadow #:streamp #:input-stream-p #:output-stream-p #:open-stream-p
           #:stream-element-type #:close #:format #:write-string #:write-line
           #:write-char #:terpri #:fresh-line #:finish-output #:force-output
           #:clear-output #:read-char #:read-char-no-hang #:unread-char #:listen
           #:clear-input #:read-line #:write #:prin1 #:princ #:print #:pprint)
  (:export #:streamp #:input-stream-p #:output-stream-p #:open-stream-p
           #:stream-element-type #:close #:format #:write-string #:write-line
           #:write-char #:terpri #:fresh-line #:finish-output #:force-output
           #:clear-output #:read-char #:read-char-no-hang #:unread-char #:listen
           #:clear-input #:read-line #:write #:prin1 #:princ #:print #:pprint))
(in-package #:mcclim-streams)
(defgeneric streamp (stream)
  (:method ((stream t)) (cl:streamp stream))
  (:method ((stream fundamental-stream)) t))
(defgeneric input-stream-p (stream)
  (:method ((stream t)) (cl:input-stream-p stream))
  (:method ((stream fundamental-stream)) (typep stream 'fundamental-input-stream)))
(defgeneric output-stream-p (stream)
  (:method ((stream t)) (cl:output-stream-p stream))
  (:method ((stream fundamental-stream)) (typep stream 'fundamental-output-stream)))
(defgeneric open-stream-p (stream)
  (:method ((stream t)) (cl:open-stream-p stream))
  (:method ((stream fundamental-stream)) (trivial-gray-streams::%open-p stream)))
(defgeneric stream-element-type (stream)
  (:method ((stream t)) (cl:stream-element-type stream))
  (:method ((stream fundamental-character-stream)) 'character)
  (:method ((stream fundamental-binary-stream)) '(unsigned-byte 8)))
(defgeneric close (stream &key abort)
  (:method ((stream t) &key abort) (cl:close stream :abort abort))
  (:method ((stream fundamental-stream) &key abort)
    (declare (ignore abort)) (setf (trivial-gray-streams::%open-p stream) nil) t))
(defun %output (stream) (cond ((null stream) *standard-output*) ((eq stream t) *terminal-io*) (t stream)))
(defun %input (stream) (cond ((null stream) *standard-input*) ((eq stream t) *terminal-io*) (t stream)))
(defun %bounds (sequence start end)
  (unless (and (integerp start) (<= 0 start) (or (null end) (integerp end))
               (<= start (or end (length sequence)) (length sequence)))
    (error "Invalid stream sequence bounds ~S, ~S for ~S." start end sequence))
  (or end (length sequence)))
(defun write-string (string &optional stream &key (start 0) end)
  (check-type string string)
  (let ((stream (%output stream)) (end (%bounds string start end)))
    (if (typep stream 'fundamental-stream) (stream-write-string stream string start end)
        (cl:write-string string stream :start start :end end))) string)
(defun write-char (char &optional stream)
  (check-type char character)
  (let ((stream (%output stream)))
    (if (typep stream 'fundamental-stream) (stream-write-char stream char) (cl:write-char char stream))) char)
(defun write-line (string &optional stream &key (start 0) end)
  (write-string string stream :start start :end end) (terpri stream) string)
(defun format (destination control &rest arguments)
  (let ((stream (if (eq destination t) *standard-output* destination)))
    (if (typep stream 'fundamental-stream)
        (progn (write-string (apply #'cl:format nil control arguments) stream) nil)
        (apply #'cl:format destination control arguments))))
(defun write (object &key (array *print-array*) (base *print-base*)
                         (case *print-case*) (circle *print-circle*)
                         (escape *print-escape*) (gensym *print-gensym*)
                         (length *print-length*) (level *print-level*)
                         (lines *print-lines*) (miser-width *print-miser-width*)
                         (pprint-dispatch *print-pprint-dispatch*)
                         (pretty *print-pretty*) (radix *print-radix*)
                         (readably *print-readably*) (right-margin *print-right-margin*)
                         stream)
  (let* ((stream (%output stream))
         (gray-p (typep stream 'fundamental-stream))
         (destination (if gray-p (make-string-output-stream) stream)))
    (cl:write object :stream destination :array array :base base :case case
              :circle circle :escape escape :gensym gensym :length length
              :level level :lines lines :miser-width miser-width
              :pprint-dispatch pprint-dispatch :pretty pretty :radix radix
              :readably readably :right-margin right-margin)
    (when gray-p (write-string (get-output-stream-string destination) stream))
    object))
(defun prin1 (object &optional stream)
  (write object :stream stream :escape t))
(defun princ (object &optional stream)
  (write object :stream stream :escape nil :readably nil))
(defun print (object &optional stream)
  (let ((stream (%output stream)))
    (terpri stream)
    (prin1 object stream)
    (write-char #\Space stream))
  object)
(defun pprint (object &optional stream)
  (let ((stream (%output stream)))
    (terpri stream)
    (write object :stream stream :escape t :pretty t))
  (values))
(macrolet ((forward (name gray)
             `(defun ,name (&optional stream)
                (let ((stream (%output stream)))
                  (if (typep stream 'fundamental-stream) (,gray stream) (, (find-symbol (symbol-name name) "CL") stream))))))
  (forward terpri stream-terpri)
  (forward fresh-line stream-fresh-line)
  (forward finish-output stream-finish-output)
  (forward force-output stream-force-output)
  (forward clear-output stream-clear-output))
(defun %eof (value errorp eof-value stream)
  (if (eq value :eof)
      (if errorp (error 'end-of-file :stream stream) eof-value) value))
(defun read-char (&optional stream (eof-error-p t) eof-value recursive-p)
  (let ((stream (%input stream)))
    (if (typep stream 'fundamental-stream)
        (%eof (stream-read-char stream) eof-error-p eof-value stream)
        (cl:read-char stream eof-error-p eof-value recursive-p))))
(defun read-char-no-hang (&optional stream (eof-error-p t) eof-value recursive-p)
  (let ((stream (%input stream)))
    (if (typep stream 'fundamental-stream)
        (%eof (stream-read-char-no-hang stream) eof-error-p eof-value stream)
        (cl:read-char-no-hang stream eof-error-p eof-value recursive-p))))
(defun unread-char (char &optional stream)
  (check-type char character)
  (let ((stream (%input stream)))
    (if (typep stream 'fundamental-stream) (stream-unread-char stream char) (cl:unread-char char stream))) nil)
(defun listen (&optional stream)
  (let ((stream (%input stream)))
    (if (typep stream 'fundamental-stream) (stream-listen stream) (cl:listen stream))))
(defun clear-input (&optional stream)
  (let ((stream (%input stream)))
    (if (typep stream 'fundamental-stream) (stream-clear-input stream) (cl:clear-input stream))) nil)
(defun read-line (&optional stream (eof-error-p t) eof-value recursive-p)
  (let ((stream (%input stream)))
    (if (typep stream 'fundamental-stream)
        (multiple-value-bind (line eofp) (stream-read-line stream)
          (values (if (and eofp (zerop (length line))) (%eof :eof eof-error-p eof-value stream) line) eofp))
        (cl:read-line stream eof-error-p eof-value recursive-p))))
(in-package #:cl-user)
