;;;; Accuracy, float formats, exact inputs, and branch cuts for native math.
(in-package #:miricl-test)
(in-suite :miricl)

(defun check-transcendental-result (expected result &optional (ulps 8) context)
  (let* ((prototype (realpart expected))
         ;; TYPE-OF can include value bounds (CCL does this for complex
         ;; floats). Check the format independently of the rounding tolerance.
         (format (if (typep prototype 'double-float) 'double-float 'single-float))
         (type (if (complexp expected) `(complex ,format) format))
         (epsilon (if (typep prototype 'double-float) double-float-epsilon single-float-epsilon)))
    (is (typep result type))
    (dolist (imaginary '(nil t))
      (let* ((a (if imaginary (imagpart expected) (realpart expected)))
             (b (if imaginary (imagpart result) (realpart result)))
             (tolerance (* ulps epsilon (max (if (complexp expected) (abs expected) (abs a))
                                             least-positive-normalized-double-float))))
        (is (<= (abs (- a b)) tolerance) "Expected ~S, received ~S" expected result)
        (when (and (floatp a) (zerop a) (zerop b))
          (is (eq (float-negative-bit-p a) (float-negative-bit-p b))
              "Signed zero in ~S: expected ~S, received ~S" context expected result))))))

(defun reference-phase (number)
  ;; Determine axis quadrants explicitly: ECL's PHASE mishandles negative
  ;; reals and its ATAN ignores the signs when both arguments are zero.
  (flet ((negativep (x) (if (floatp x) (float-negative-bit-p x) (minusp x))))
    (let* ((x (realpart number)) (y (imagpart number))
           (prototype (if (floatp x) x 1.0)))
      (cond ((realp number) (float (if (negativep x) pi 0) prototype))
            ((zerop y) (float-sign y (float (if (negativep x) pi 0) prototype)))
            (t (atan y x))))))

(test native-elementary-functions
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (prototype '(1.0 1d0))
      (dolist (operator '(sin cos tan cis exp sinh cosh tanh))
        (dolist (x (append (list (float 0 prototype) (float -0d0 prototype))
                          (loop for i from -100 to 100 collect (float (/ i 17) prototype))))
          ;; CIS is COS+i*SIN, including the sign of SIN's zero. ECL loses
          ;; that sign in its direct CIS implementation.
          (check-transcendental-result (if (eq operator 'cis) (complex (cos x) (sin x))
                                         (funcall operator x))
                                       (m:evaluate vm `(,operator ,x)) 16 `(,operator ,x))))
      (dolist (x (mapcar (lambda (n) (float n prototype))
                        '(-3 -1 -1/4 -0d0 0 1/4 1 3)))
        (dolist (y (mapcar (lambda (n) (float n prototype))
                          '(-3 -1 -1/4 -0d0 0 1/4 1 3)))
          (dolist (operator '(sin cos tan exp sinh cosh tanh))
            (let ((z (complex x y)))
              (check-transcendental-result (funcall operator z) (m:evaluate vm `(,operator ,z)) 32))))))
    (dolist (operator '(sin cos tan cis exp sinh cosh tanh))
      (dolist (x '(-3 -1 -1/3 0 1/3 1 3))
        (check-transcendental-result (funcall operator x) (m:evaluate vm `(,operator ,x)) 16))
      (dolist (form `((,operator) (,operator 1 2)))
        (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
      (dolist (x '(nil a #\a "1"))
        (is (eq t (m:evaluate vm `(handler-case (,operator ',x) (type-error () t))))))
      (is (= 1 (m:evaluate vm `(length (multiple-value-list (,operator (values 1d0 2))))))))
    (is (eq t (m:evaluate vm '(handler-case (cis #c(1 2)) (type-error () t)))))))

(test native-trigonometric-range-reduction
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (prototype '(1.0 1d0))
      (let* ((double (typep prototype 'double-float))
             (small (if double least-positive-double-float least-positive-single-float))
             (large (if double most-positive-double-float most-positive-single-float)))
        (dolist (x (append (list small large)
                          (loop for exponent from (if double -1022 -126) to (if double 1023 127)
                                by (if double 17 3)
                                append (loop for mantissa in '(1 5/4 3/2 7/4)
                                             collect (scale-float (float mantissa prototype) exponent)))))
          (dolist (sign '(1 -1))
            (dolist (operator '(sin cos tan cis))
              (let ((x (* sign x)))
                (check-transcendental-result (funcall operator x) (m:evaluate vm `(,operator ,x)) 32)))))
        (dolist (n '(1 2 3 7 31 127 1023 65535 655359))
          (let ((center (float (* n (/ pi 2)) prototype)))
            (dolist (delta (list 0 (* center (if double double-float-epsilon single-float-epsilon))
                                (- (* center (if double double-float-epsilon single-float-epsilon)))))
              (let ((x (+ center delta)))
                (dolist (operator '(sin cos tan))
                  (check-transcendental-result (funcall operator x) (m:evaluate vm `(,operator ,x)) 32))))))))))

(test native-exponential-extremes
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (x '(-744d0 -700d0 -100d0 -20d0 -1d-20 1d-20 20d0 100d0 700d0 709d0))
      (check-transcendental-result (exp x) (m:evaluate vm `(exp ,x)) 16))
    (dolist (x '(-710d0 -700d0 -20d0 -1d-100 1d-100 20d0 700d0 710d0))
      (dolist (operator '(sinh cosh tanh))
        (check-transcendental-result (funcall operator x) (m:evaluate vm `(,operator ,x)) 16)))
    (dolist (source
      '("(handler-case (exp 1000d0)
           (floating-point-overflow (c)
             (and (eq 'exp (arithmetic-error-operation c))
                  (equal '(1000d0) (arithmetic-error-operands c)))))"
        "(handler-case (exp 100.0) (floating-point-overflow () t))"
        "(handler-case (sinh 1000d0) (floating-point-overflow () t))"
        "(handler-case (cosh -1000d0) (floating-point-overflow () t))"
        "(= 1d0 (tanh 1d300))" "(= -1d0 (tanh -1d300))"
        "(handler-case (exp -1000d0) (floating-point-underflow () t))"
        "(handler-case (exp -200.0) (floating-point-underflow () t))"
        "(handler-case (exp #c(-1000d0 1d0)) (floating-point-underflow () t))"))
      (is (eq t (m:evaluate-string vm source))))))

(test native-general-powers
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (base '(-8 -2 -1/3 1/3 2 4 8 -2.0 2.0 -2d0 2d0 #c(1 2) #c(1.0 -2.0) #c(-1d0 2d0)))
      (dolist (power '(1/3 -1/3 1/2 -1/2 0.25 0.5 -1.5 0.25d0 0.5d0 -1.5d0
                      #c(1 1) #c(1.0 0.5) #c(-0.5d0 1d0)))
        (check-transcendental-result (expt base power) (m:evaluate vm `(expt ,base ,power)) 64)))
    (dolist (form '((< 0 (realpart (expt -8 1/3)))
                    (= 1 (length (multiple-value-list (expt 2 1/3))))
                    (handler-case (expt 0 -1/2) (arithmetic-error () t))))
      (is (eq t (m:evaluate vm form))))))

(test native-floating-integer-powers
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (prototype '(1.0 1d0))
      (dolist (base '(-8 -2 -3/2 -1 -1/2 -1/10 1/10 1/2 1 3/2 2 8))
        (loop for n from -15 to 15 do
          (let ((x (float base prototype)))
            (check-transcendental-result (expt x n) (m:evaluate vm `(expt ,x ,n)) 64))))
      (let ((large (if (typep prototype 'double-float) most-positive-double-float most-positive-single-float))
            (small (if (typep prototype 'double-float) least-positive-double-float least-positive-single-float)))
        (dolist (pair (list (list large 2 'floating-point-overflow)
                           (list small 2 'floating-point-underflow)
                           (list small -2 'floating-point-overflow)))
          (destructuring-bind (base power condition) pair
            (is (eq t (m:evaluate vm `(handler-case (expt ,base ,power)
              (,condition (c) (and (eq 'expt (arithmetic-error-operation c))
                                  (equal '(,base ,power) (arithmetic-error-operands c))))))))))))
    (dolist (source '("(handler-case (expt 0d0 -2) (division-by-zero () t))"
                      "(handler-case (expt (scale-float 1d0 -1024) -1) (floating-point-overflow () t))"
                      "(= 1d0 (expt -1d0 (expt 2 100)))"
                      "(= -1d0 (expt -1d0 (1+ (expt 2 100))))"
                      "(= 0d0 (expt 0d0 123))"))
      (is (eq t (m:evaluate-string vm source))))))

(test native-inverse-functions
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (prototype '(1.0 1d0))
      (dolist (operator '(asin acos asinh acosh atanh))
        (dolist (value '(-3 -2 -1 -999/1000 -1/2 -0d0 0 1/2 999/1000 1 2 3))
          (let ((x (float value prototype)))
            (unless (and (eq operator 'atanh) (= (abs x) 1))
              (let ((expected (funcall operator x)))
                ;; Use the specified sides of the real cuts independently
                ;; of the host's branch choices and zero signs.
                (when (and (member operator '(asin acos)) (> (abs x) 1))
                  (setq expected (complex (realpart expected)
                    (float-sign (if (eq operator 'asin) (- x) x) (abs (imagpart expected))))))
                (when (and (eq operator 'atanh) (> (abs x) 1))
                  (setq expected (complex (realpart expected)
                                          (float-sign x (abs (imagpart expected))))))
                (when (and (eq operator 'acosh) (<= -1 x) (< x 1))
                  (setq expected (complex (float 0 prototype) (imagpart expected))))
                (check-transcendental-result expected (m:evaluate vm `(,operator ,x)) 32 `(,operator ,x))))))
        (dolist (x (mapcar (lambda (n) (float n prototype)) '(-3 -1 -1/2 -0d0 0 1/2 1 3)))
          (dolist (y (mapcar (lambda (n) (float n prototype)) '(-3 -1 -1/2 -0d0 0 1/2 1 3)))
            (unless (or (and (member operator '(asin acos atanh)) (zerop y) (>= (abs x) 1))
                        (and (eq operator 'asinh) (zerop x) (> (abs y) 1))
                        (and (eq operator 'acosh) (zerop y) (< x 1)))
              (let ((z (complex x y)))
                (let ((expected (funcall operator z)))
                  ;; Some hosts erase these zero signs. The local derivative
                  ;; preserves them for ASIN/ASINH and reverses them for ACOS.
                  (cond ((and (eq operator 'asin) (zerop y))
                         (setq expected (complex (realpart expected) y)))
                        ((and (eq operator 'acos) (zerop y))
                         (setq expected (complex (realpart expected) (- y))))
                        ((and (eq operator 'asinh) (zerop x))
                         (setq expected (complex x (imagpart expected)))))
                  (check-transcendental-result expected (m:evaluate vm `(,operator ,z)) 32 `(,operator ,z)))))))))
    (dolist (operator '(asin acos asinh acosh atanh))
      (dolist (form `((,operator) (,operator 0 1)))
        (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
      (dolist (value '(nil a #\a "1"))
        (is (eq t (m:evaluate vm `(handler-case (,operator ',value) (type-error () t))))))
      (is (= 1 (m:evaluate vm `(length (multiple-value-list (,operator (values 0d0 2))))))))
    (dolist (value '(1 -1 1.0 -1.0 1d0 -1d0 #c(1d0 0d0) #c(-1d0 0d0)))
      (is (eq t (m:evaluate vm `(handler-case (atanh ,value) (arithmetic-error () t))))))))

(test native-inverse-extremes
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (value '(1d-300 1d-100 1d-20))
      (let* ((z (complex 1d0 value))
             (root (sqrt value))
             (sine (m:evaluate vm `(asin ,z)))
             (cosine (m:evaluate vm `(acos ,z))))
        (is (<= (abs (- (imagpart sine) root)) (* 16 double-float-epsilon root)))
        (check-transcendental-result (complex root (- root)) cosine 16)))
    (dolist (value (list least-positive-double-float 1d-300 -1d-300))
      (dolist (operator '(asin asinh atanh))
        (is (eql value (m:evaluate vm `(,operator ,value))))))
    (let ((tiny least-positive-double-float))
      (is (equal (complex tiny tiny) (m:evaluate vm `(asin (complex ,tiny ,tiny))))))
    (dolist (x '(1d300 -1d300))
      (dolist (y '(1d300 -1d300))
        (let* ((magnitude (+ (log (sqrt 2d0)) (log 1d300) (log 2d0)))
               (expected (complex (atan x (abs y)) (float-sign y magnitude))))
          (check-transcendental-result expected (m:evaluate vm `(asin (complex ,x ,y)))))))
    (dolist (form
      '((let ((result (asin 2d0))) (and (= (realpart result) (/ pi 2)) (minusp (imagpart result))))
        (let ((result (asin -2d0))) (and (= (realpart result) (- (/ pi 2))) (plusp (imagpart result))))
        (let ((result (atanh 2d0))) (and (plusp (realpart result)) (plusp (imagpart result))))
        (let ((result (atanh -2d0))) (and (minusp (realpart result)) (minusp (imagpart result))))
        (let ((result (acosh #c(-2d0 -0d0)))) (and (plusp (realpart result)) (minusp (imagpart result))))))
      (is (eq t (m:evaluate vm form))))))

(test native-inverse-rational-boundaries
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (bits '(60 80 150 300 1000 2000))
      (let* ((delta (expt 2 (- bits)))
             (inside (- 1 delta)) (outside (+ 1 delta))
             (root (float (* (sqrt 2d0) (scale-float 1d0 (- (/ bits 2)))) 1.0))
             (logarithm (float (* 0.5d0 (1+ bits) (log 2d0)) 1.0)))
        (check-transcendental-result root (m:evaluate vm `(acos ,inside)) 16)
        (check-transcendental-result root (m:evaluate vm `(acosh ,outside)) 16)
        (check-transcendental-result (complex 0.0 root) (m:evaluate vm `(acos ,outside)) 16)
        (check-transcendental-result (complex 0.0 root) (m:evaluate vm `(acosh ,inside)) 16)
        (check-transcendental-result logarithm (m:evaluate vm `(atanh ,inside)) 16)
        (check-transcendental-result (complex logarithm (float (/ pi 2) 1.0))
                                     (m:evaluate vm `(atanh ,outside)) 16)
        (let* ((z (complex inside (* delta delta)))
               (result (m:evaluate vm `(acos ,z))))
          (check-transcendental-result (complex root (float-sign -1.0 0.0)) result 16)
          (when (< bits 100)
            (let ((expected (- (float (/ (* delta delta)
                                       (* (sqrt 2d0) (scale-float 1d0 (- (/ bits 2))))) 1.0))))
              (is (<= (abs (- (imagpart result) expected))
                      (* 16 single-float-epsilon (abs expected)))))))
        (when (>= bits 1000)
          (check-transcendental-result (complex logarithm 0.0)
            (m:evaluate vm `(atanh (complex ,inside ,(* delta delta)))) 16))))))

(test native-phase-and-log
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (prototype '(1.0 1d0))
      (let* ((double (typep prototype 'double-float))
             (small (if double least-positive-double-float least-positive-single-float))
             (large (if double most-positive-double-float most-positive-single-float))
             (samples (append (list small large)
                              (loop for exponent from (if double -1022 -126)
                                    to (if double 1023 127) by (if double 19 3)
                                    append (loop for mantissa in '(1 5/4 3/2 7/4)
                                                 collect (scale-float (float mantissa prototype) exponent)))
                              (loop for i from 1 to 100 collect (float (/ i 31) prototype)))))
        (dolist (x samples)
          (dolist (sign '(1 -1))
            (let ((z (* sign x)))
              (check-transcendental-result (log z) (m:evaluate vm `(log ,z)))
              (check-transcendental-result (reference-phase z) (m:evaluate vm `(phase ,z))))))
        (dolist (x (list (float 0 prototype) (float -0.0d0 prototype)
                        (float 1 prototype) (float -1 prototype) small (- small) large (- large)))
          (dolist (y (list (float 0 prototype) (float -0.0d0 prototype)
                          (float 1 prototype) (float -1 prototype) small (- small) large (- large)))
            (let ((z (complex x y)))
              (check-transcendental-result (reference-phase z) (m:evaluate vm `(phase ,z)))
              (unless (zerop z)
                ;; Avoid host complex LOG's overflowing maximum or inaccurate
                ;; subnormal magnitude calculation by scaling equal components.
                (let ((expected (if (and (= (abs x) (abs y))
                                        (or (= (abs x) large) (= (abs x) small)))
                                    (complex (+ (log (abs x)) (float (* 0.5d0 (log 2d0)) prototype))
                                             (reference-phase z))
                                    (log z))))
                  (check-transcendental-result expected (m:evaluate vm `(log ,z)) 16))))))))
    (dolist (x '(1 2 3 1/2 3/7 -1 -2 -3 -1/2 -3/7 #c(3 4) #c(-3 4) #c(-3 -4) #c(3 -4)))
      (check-transcendental-result (reference-phase x) (m:evaluate vm `(phase ,x)))
      (check-transcendental-result (log x) (m:evaluate vm `(log ,x))))
    (dolist (exponent '(2000 5000 -2000 -5000))
      (let ((x (expt 2 exponent)))
        (check-transcendental-result (float (* exponent (log 2d0)) 1.0) (m:evaluate vm `(log ,x)))
        (check-transcendental-result (float (* exponent (log 2d0)) 1.0)
                                     (realpart (m:evaluate vm `(log ,(- x)))))))
    (let ((huge (expt 2 5000)))
      (dolist (scale (list huge (/ huge)))
        (dolist (x '(-3 -1 0 1 3))
          (dolist (y '(-3 -1 1 3))
            (check-transcendental-result (reference-phase (complex x y))
              (m:evaluate vm `(phase ,(complex (* scale x) (* scale y)))))))))
    ;; LOG1P must retain the real logarithm when 1+y^2 rounds to one.
    (let* ((z #c(1d0 1d-100)) (result (m:evaluate vm `(log ,z))))
      (check-transcendental-result #c(5d-201 1d-100) result))
    (dolist (exponent '(25 54 100 149))
      (dolist (sign '(1 -1))
        (let ((x (+ 1 (* sign (expt 2 (- exponent))))))
          ;; LOG(1+d) differs from d by at most d^2/2 here, below the
          ;; single-float tolerance. ECL rounds X to 1 before taking LOG.
          (check-transcendental-result (float (- x 1) 1.0) (m:evaluate vm `(log ,x))))))
    (dolist (z '(#c(0.6d0 0.8d0) #c(0.8d0 0.6d0) #c(-0.6d0 0.8d0)
                 #c(3/5 4/5) #c(1/2 1/2)))
      ;; Compare components independently here: the real component may be
      ;; tiny even though the complex result's imaginary part is about one.
      (let* ((expected (log z)) (result (m:evaluate vm `(log ,z)))
             (delta (- (+ (expt (rational (realpart z)) 2)
                          (expt (rational (imagpart z)) 2)) 1))
             ;; For |delta| < 2^-52, log(1+delta)/2 differs from delta/2
             ;; below our rounding tolerance. SBCL loses accuracy here too.
             (real (if (< (abs delta) (expt 2 -52))
                       (float (/ delta 2) (realpart expected)) (realpart expected))))
        (check-transcendental-result real (realpart result))
        (check-transcendental-result (imagpart expected) (imagpart result))))
    (dolist (arguments '((100 10) (100d0 10) (8 2) (3 0) (3d0 0) (#c(3 1) 0)
                         (#c(0 1) #c(0 -1)) (#c(-16 16) #c(2 2)) (-4 2) (4 -2)))
      (check-transcendental-result (apply #'log arguments) (m:evaluate vm `(log ,@arguments)) 32))
    (dolist (function '(log phase))
      (dolist (value '(nil t "x" #\a (1)))
        (is (eq t (m:evaluate vm `(handler-case (,function ',value) (type-error () t))))))
      (is (eq t (m:evaluate vm `(handler-case (,function) (program-error () t))))))
    (is (eq t (m:evaluate vm '(handler-case (log 1 2 3) (program-error () t)))))
    (is (eq t (m:evaluate vm '(handler-case (phase 1 2) (program-error () t)))))
    (is (equal '(0.0) (m:evaluate vm '(multiple-value-list (log (values 1 99))))))))

(test native-atan
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (prototype '(1.0 1d0))
      (let* ((double (typep prototype 'double-float))
             (small (if double least-positive-double-float least-positive-single-float))
             (large (if double most-positive-double-float most-positive-single-float)))
        (dolist (x (append (list (float 0 prototype) (float -0.0d0 prototype) (float small prototype) large)
                          (loop for i from -100 to 100 collect (float (/ i 31) prototype))))
          (check-transcendental-result (atan x) (m:evaluate vm `(atan ,x))))
        (let ((components (mapcar (lambda (x) (float x prototype))
                                 '(-2 -5/4 -1 -1/2 -1/8 -0.0d0 0 1/8 1/2 1 5/4 2))))
          (dolist (x components)
            (dolist (y components)
              (check-transcendental-result (atan y x) (m:evaluate vm `(atan ,y ,x)))
              (unless (and (zerop x) (= (abs y) 1))
                (let* ((z (complex x y)) (expected (atan z)))
                  ;; Preserve the analytic function's zero signs on the
                  ;; axes, which ECL's complex ATAN can erase.
                  (when (and (zerop x) (< (abs y) 1))
                    (setq expected (complex x (if (zerop y) y (imagpart expected)))))
                  (when (zerop y)
                    (setq expected (complex (realpart expected) y)))
                  (check-transcendental-result expected (m:evaluate vm `(atan ,z)) 16 `(atan ,z)))))))
        (dolist (sign '(1 -1))
          (let* ((x (* sign (if double least-positive-double-float least-positive-single-float)))
                 (z (complex x prototype))
                 (expected (complex (float (* sign (/ pi 4)) prototype)
                                    (float (* 0.5d0 (- (log 2d0) (log (abs (float x 1d0))))) prototype))))
            (check-transcendental-result expected (m:evaluate vm `(atan ,z)))))
        (dolist (x (list large (- large)))
          (dolist (y (list prototype (- prototype) large (- large)))
            (let* ((z (complex x y))
                   (den (+ (expt (rational x) 2) (expt (rational y) 2)))
                   (expected (complex (float (* (signum x) (/ pi 2)) prototype)
                                      (float (/ (rational y) den) prototype))))
              (check-transcendental-result expected (m:evaluate vm `(atan ,z))))))))
    (dolist (x '(-3 -1 -1/3 0 1/3 1 3))
      (check-transcendental-result (atan x) (m:evaluate vm `(atan ,x)))
      (dolist (y '(-3 -1 -1/3 1/3 1 3))
        (let* ((z (complex x y)) (expected (unless (and (zerop x) (= (abs y) 1)) (atan z))))
          (when expected
            (when (and (zerop x) (> (abs y) 1))
              (setf expected (complex (float (* (- (signum y)) (/ pi 2)) 1.0) (imagpart expected))))
            ;; Exact zero approaches the interior imaginary axis with +0 real
            ;; part; CCL's rational path can return -0 for negative Y.
            (when (and (zerop x) (< (abs y) 1))
              (setf expected (complex 0.0 (imagpart expected))))
            (check-transcendental-result expected (m:evaluate vm `(atan ,z)) 16)))))
    (dolist (exponent '(54 100 1000 5000))
      (dolist (sign '(1 -1))
        (let* ((delta (expt 2 (- exponent))) (y (+ 1 delta))
               (expected (complex (float (* (- sign) (/ pi 2)) 1.0)
                                  (float (* sign 0.5d0 (+ (* exponent (log 2d0)) (log 2d0))) 1.0))))
          ;; A tiny exact offset from i must not be rounded to the pole.
          (check-transcendental-result expected
            (m:evaluate vm `(atan ,(complex 0 (* sign y)))) 32))))
    (dolist (exponent '(2000 5000))
      (let ((x (expt 2 exponent)))
        (check-transcendental-result (float (/ pi 2) 1.0) (m:evaluate vm `(atan ,x)))
        (check-transcendental-result #c(1.5707964 0.0) (m:evaluate vm `(atan ,(complex x x))))))
    (dolist (form '((atan) (atan 1 2 3)))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
    (dolist (form '((atan nil) (atan "x") (atan #c(1 2) 1) (atan 1 #c(1 2)) (atan 1 nil)))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))
    (is (equal '(0.0) (m:evaluate vm '(multiple-value-list (atan (values 0 99))))))))
