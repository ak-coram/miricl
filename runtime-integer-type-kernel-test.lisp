;;;; Integer interval kernel regression coverage.
(in-package #:miricl-test)
(in-suite :miricl)

(defun integer-type-test-metadata (selector object environment)
  (case selector
    (0 (let ((expanded (or (cdr (assoc object environment :test #'equal)) object)))
         (miricl-runtime:check-type-control-value expanded #'integer-type-test-metadata)
         expanded))
    (2 (if (and (simple-vector-p object) (= (length object) 2) (eq (svref object 0) :class))
           (cons (svref object 1) t)))
    (3 (list-length object))
    (4 (error 'simple-type-error :datum object :expected-type nil
              :format-control "Malformed type control."))))

(defun integer-type-test-query (a b mode &optional coverage environment)
  (miricl-runtime:check-type-control-value a #'integer-type-test-metadata)
  (if (= mode 1) (miricl-runtime:check-type-control-value b #'integer-type-test-metadata))
  (miricl-runtime:integer-type-query-value a b (vector mode coverage environment) #'integer-type-test-metadata))

(test integer-type-port-symbolic-endpoints
  (loop for exponent from 0 to 80 do
    (dolist (sign '(-1 1))
      (dolist (ones '(nil t))
        (let* ((endpoint (miricl-runtime:integer-power-endpoint-value exponent sign ones))
               (number (* sign (if ones (1- (ash 1 exponent)) (ash 1 exponent)))))
          (is (= (integer-length (abs number)) (miricl-runtime:integer-endpoint-width-value endpoint)))
          (dolist (delta '(-2 -1 0 1 2))
            (let ((other (+ number delta)))
              (is (= (signum (- number other)) (miricl-runtime:integer-endpoint-compare-value endpoint other)))
              (is (= (signum (- other number)) (miricl-runtime:integer-endpoint-compare-value other endpoint)))))))))
  (dolist (exponent '(1 2 63 64 65 100000000000000000000000000000000000000))
    (dolist (sign '(-1 1))
      (let ((power (miricl-runtime:integer-power-endpoint-value exponent sign nil))
            (ones (miricl-runtime:integer-power-endpoint-value (1+ exponent) sign t)))
        (is (= (- sign) (miricl-runtime:integer-endpoint-compare-value power ones)))
        (is (= sign (miricl-runtime:integer-endpoint-compare-value ones power)))))))

(test integer-type-port-intervals-and-proofs
  (dolist (case '((integer #(nil nil 1)) (fixnum #(-9223372036854775808 9223372036854775807 1))
                  (bit #(0 1 1)) ((mod 1) #(0 0 1)) ((integer (0) (3)) #(1 2 1))
                  ((integer 1/2 7/2) #(1 3 1)) ((unsigned-byte 0) #(0 0 1))
                  ((signed-byte 1) #(-1 0 1)) ((and integer (real 1/2 7/2)) #(1 3 1))
                  ((and (and integer) (and (integer 1 5) (integer 2 4))) #(2 4 1))
                  ((and integer (satisfies opaque)) #(nil nil 0))
                  ((and integer nil (satisfies opaque)) #(nil nil 2))
                  ((and (integer 5 9) (integer 1 3) (satisfies opaque)) #(nil nil 2))
                  ((and real rational) #(nil nil 0)) ((and) #(nil nil 0))))
    (is (equalp (second case) (integer-type-test-query (first case) nil 0))))
  (dolist (case '(((integer 1 3) (integer 0 4) 1) ((integer 0 4) (integer 1 3) 2)
                  ((integer 2 1) nil 1) ((integer 0 0) float 2)
                  ((unsigned-byte 63) fixnum 1) ((unsigned-byte 64) fixnum 2)
                  ((signed-byte 64) fixnum 1) ((signed-byte 65) fixnum 2)
                  ((integer 9223372036854775808 *) bignum 1)
                  ((integer * -9223372036854775809) bignum 1)
                  ((integer -9223372036854775808 -9223372036854775808) bignum 2)
                  ((integer 9223372036854775807 9223372036854775807) bignum 2)
                  ((integer 0 *) bignum 2)
                  ((unsigned-byte 100000000000000000000000000000000000000)
                   (signed-byte 100000000000000000000000000000000000001) 1)
                  ((unsigned-byte 100000000000000000000000000000000000000)
                   (signed-byte 100000000000000000000000000000000000000) 2)
                  ((and integer (real (0) (3))) (integer 1 2) 1)
                  (integer (satisfies opaque) 0) ((satisfies opaque) integer 0)))
    (is (= (third case) (integer-type-test-query (first case) (second case) 1))))
  (is (equalp #(0 1 1) (integer-type-test-query (vector :class 'bit) nil 0)))
  (is (= 1 (integer-type-test-query '(integer 9223372036854775808 *) (vector :class 'bignum) 1)))
  (is (equalp #(2 3 1) (integer-type-test-query 'local-integer nil 0 nil '((local-integer . (integer 2 3)))))))

(test integer-type-port-malformed-recovery
  (dolist (form '((signed-byte 0) (signed-byte -1) (unsigned-byte -1) (mod 0) (mod -1)
                  (signed-byte nil) (unsigned-byte 1/2) (mod *) (integer (1 2) 3)))
    (signals error (integer-type-test-query form nil 0)))
  (let ((control (list 'and 'integer nil)))
    (setf (third control) control)
    (signals simple-type-error (integer-type-test-query control nil 0)))
  (let ((control (list 'and 'integer)))
    (setf (cdr (cdr control)) (cdr control))
    (signals simple-type-error (integer-type-test-query control nil 0)))
  (let ((bound (list 1)))
    (setf (cdr bound) bound)
    (signals simple-type-error (integer-type-test-query (list 'integer bound '*) nil 0)))
  (let ((datum (list :literal)))
    (setf (cdr datum) datum)
    (dolist (type (list (list 'member datum) (list 'eql datum) (list 'opaque datum)))
      (is (eq type (miricl-runtime:check-type-control-value type #'integer-type-test-metadata)))))
  (is (= 1 (integer-type-test-query '(integer 2 3) 'integer 1))))

(test integer-type-port-raw-value-packets
  (let ((original (fdefinition 'miricl::integer-type-runtime-wat)))
    (unwind-protect
        (progn
          (setf (fdefinition 'miricl::integer-type-runtime-wat)
            (lambda ()
              (miricl::runtime-wat-sequence (funcall original)
                (miricl::wat-fragment
                  (format nil
                    "(func (export ~S) (param $mode i32) (result i32)
                       (local $packet (ref null eq)) (local $endpoint (ref eq))
                       (local $caught i32) (local $ok i32)
                       (local.set $packet (call $cons (call $int (i32.const 42)) (ref.null eq)))
                       (global.set $extra-values (local.get $packet))
                       (global.set $value-count (i32.const 3))
                       (block $failed (try_table (catch $transfer $failed)
                         (if (i32.eqz (local.get $mode))
                           (then
                             (local.set $endpoint (call $integer-power-endpoint (call $int (i32.const 64)) (i32.const 1) (i32.const 1)))
                             (drop (call $integer-endpoint-width (local.get $endpoint)))
                             (drop (call $integer-endpoint-compare (local.get $endpoint) (call $int (i32.const 1))))
                             (call $integer-type-interval (call $symbol (i32.const ~D)) (i32.const 0) (ref.null eq))
                             (drop) (drop) (drop))
                           (else
                             (call $integer-type-interval
                               (call $cons (call $symbol (i32.const ~D))
                                 (call $cons (call $int (i32.const -1)) (ref.null eq)))
                               (i32.const 0) (ref.null eq))
                             (drop) (drop) (drop)))
                         (local.set $caught (i32.const 1))))
                       (local.set $ok (i32.and
                         (i32.and (ref.eq (global.get $extra-values) (local.get $packet))
                           (i32.eq (global.get $value-count) (i32.const 3)))
                         (if (result i32) (local.get $mode)
                           (then (i32.and (i32.eqz (local.get $caught))
                             (call $typep (global.get $last-condition) (call $symbol (i32.const ~D)))))
                           (else (local.get $caught)))))
                       (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
                       (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
                       (call $clear-values) (local.get $ok))"
                    "integer-type-value-packets" (miricl::runtime-symbol-id 'integer)
                    (miricl::runtime-symbol-id 'unsigned-byte) (miricl::runtime-symbol-id 'type-error))))))
          (let* ((miricl::*interpreter-only-wasm* nil)
                 (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
            (m:with-interpreter (vm)
              (dolist (mode '(0 1))
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "integer-type-value-packets" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)")))))))
      (setf (fdefinition 'miricl::integer-type-runtime-wat) original))))
