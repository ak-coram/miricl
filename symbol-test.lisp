(in-package #:miricl-test)
(in-suite :miricl)

(test symbol-error-data-and-string-prefixes
  (m:with-interpreter (vm)
    (dolist (function '(symbol-name symbol-package symbol-value symbol-plist boundp
                        makunbound special-operator-p copy-symbol))
      (dolist (datum '(17 #\Space "bad" (setf car) #(1 2)))
        (is (eq t (m:evaluate vm
          `(let ((datum ',datum))
             (handler-case (,function datum)
               (type-error (condition)
                 (and (eq datum (type-error-datum condition))
                      (equal (type-error-expected-type condition) 'symbol))))))))))
    (dolist (form '((get 17 :key) (remprop 17 :key) (set 17 nil)
                    (setf (get 17 :key) nil) (setf (symbol-plist 17) nil)))
      (is (equal '(17 symbol) (m:evaluate vm
        `(handler-case ,form (type-error (condition)
           (list (type-error-datum condition) (type-error-expected-type condition))))))))
    (dolist (datum '(nil t -1 1.5 #\x (1 2)))
      (is (eq t (m:evaluate vm
        `(let ((datum ',datum) (*gensym-counter* 123))
           (and (handler-case (gensym datum)
                  (type-error (condition)
                    (and (eq datum (type-error-datum condition))
                         (not (typep datum (type-error-expected-type condition))))))
                (= *gensym-counter* 123)))))))
    (dolist (prefix '((make-array 8 :element-type 'character :initial-contents "Pre-tail" :fill-pointer 3)
                      (make-array 3 :element-type 'character :displaced-to "!Pre!" :displaced-index-offset 1)))
      (is (equal '("Pre42" 43) (m:evaluate vm
        `(let ((*gensym-counter* 42))
           (list (symbol-name (gensym ,prefix)) *gensym-counter*)))))
      (is (eq t (m:evaluate vm
        `(let* ((prefix ,prefix) (symbol (gentemp prefix)))
           (and (string= (subseq (symbol-name symbol) 0 3) "Pre")
                (eq (symbol-package symbol) *package*)
                (not (boundp symbol)) (not (fboundp symbol))))))))
    (is (eq t (m:evaluate-string vm
      "(and (special-operator-p 'multiple-value-call)
            (special-operator-p 'multiple-value-prog1))")))))

(test symbol-values-and-keywords
  (m:with-interpreter (vm)
    (is (equal '(t nil t t t nil)
      (m:evaluate-string vm "(list (boundp nil) (symbol-value nil) (boundp t)
        (eq :key (symbol-value :key)) (typep :key 'keyword) (typep 'key 'keyword))")))
    (m:evaluate-string vm "(setq s (make-symbol \"Fresh\"))")
    (is (equal '("Fresh" nil nil nil nil)
      (m:evaluate-string vm "(list (symbol-name s) (symbol-package s) (boundp s) (fboundp s) (symbol-plist s))")))
    (is (null (m:evaluate-string vm "(set s nil)")))
    (is (eq t (m:evaluate-string vm "(boundp s)")))
    (m:evaluate-string vm "(makunbound s)")
    (signals m:interpreter-unbound-variable (m:evaluate-string vm "(symbol-value s)"))
    (is (null (m:evaluate-string vm "(boundp s)")))
    (m:evaluate-string vm "(setq value-test 10)")
    (is (equal '(20 10 30 20)
      (m:evaluate-string vm "(let ((value-test 20))
        (list value-test (symbol-value 'value-test) (set 'value-test 30) value-test))")))
    (is (= 30 (m:evaluate-string vm "value-test")))
    (handler-case (m:evaluate-string vm "(symbol-value (make-symbol \"ERROR-NAME\"))")
      (m:interpreter-unbound-variable (condition)
        (is (m:guest-symbol-p (cell-error-name condition)))
        (is (string= "ERROR-NAME" (m:guest-symbol-name (cell-error-name condition))))))
    (is (equal '(nil t) (m:evaluate-string vm
      "(let ((*package* *package*)) (makunbound '*package*)
         (list (boundp '*package*) (progn (set '*package* (find-package :cl-user)) (boundp '*package*))))")))
    (m:evaluate-string vm "(setq k :detached-keyword) (unintern k :keyword)")
    (is (equal '(nil t t) (m:evaluate-string vm "(list (keywordp k) (boundp k) (eq k (symbol-value k)))")))
    (signals m:interpreter-error (m:evaluate-string vm "(set k 1)"))
    (dolist (source '("(set nil 1)" "(set t 1)" "(set :key 1)" "(makunbound :key)"
                      "(boundp 42)" "(symbol-name 42)" "(make-symbol 'x)"
                      "(copy-symbol 1)" "(symbol-plist 1)" "(symbol-value 1)" "(setf (symbol-plist 'x) 42)"))
      (signals m:interpreter-error (m:evaluate-string vm source)))))

(test symbol-properties
  (m:with-interpreter (vm)
    (is (null (m:evaluate-string vm "(symbol-plist 'properties)")))
    (is (= 17 (m:evaluate-string vm "(get 'properties :missing 17)")))
    (m:evaluate-string vm "(setf (get 'properties :a) 1 (get 'properties :b) nil (get 'properties :c) 3)")
    (is (equal '(1 nil 3 17)
      (m:evaluate-string vm "(list (get 'properties :a) (get 'properties :b 17)
        (get 'properties :c) (get 'properties :absent 17))")))
    (is (eq t (m:evaluate-string vm "(remprop 'properties :b)")))
    (is (eq t (m:evaluate-string vm "(remprop 'properties :c)")))
    (is (eq t (m:evaluate-string vm "(remprop 'properties :a)")))
    (is (null (m:evaluate-string vm "(remprop 'properties :a)")))
    (is (null (m:evaluate-string vm "(symbol-plist 'properties)")))
    ;; Only the first occurrence is changed or removed, and existing conses survive.
    (m:evaluate-string vm "(setf (symbol-plist 'properties) (list :a 1 :a 2 :b 3))
                           (setq saved-plist (symbol-plist 'properties))
                           (setf (get 'properties :a) 4)")
    (is (eq t (m:evaluate-string vm "(eq saved-plist (symbol-plist 'properties))")))
    (is (= 4 (m:evaluate-string vm "(car (cdr saved-plist))")))
    (m:evaluate-string vm "(remprop 'properties :a)")
    (is (= 2 (m:evaluate-string vm "(get 'properties :a)")))
    (m:evaluate-string vm "(setf (get nil :property) 99 (get :key :property) 88)")
    (is (equal '(99 88) (m:evaluate-string vm "(list (get nil :property) (get :key :property))")))
    ;; Place subforms, including GET's default, are evaluated once, before the value.
    (is (equal '(1234 1234)
      (m:evaluate-string vm "(let ((n 0))
        (setf (get (progn (setq n (+ (* n 10) 1)) 'properties)
                   (progn (setq n (+ (* n 10) 2)) :order)
                   (progn (setq n (+ (* n 10) 3)) nil))
              (progn (setq n (+ (* n 10) 4)) n))
        (list n (get 'properties :order)))")))))

(test symbol-function-cells
  (m:with-interpreter (vm)
    (is (eq t (m:evaluate-string vm "(functionp (symbol-function 'car))")))
    (is (eq t (m:evaluate-string vm "(typep #'car 'function)")))
    (is (null (m:evaluate-string vm "(functionp 'car)")))
    (is (eq t (m:evaluate-string vm "(eq #'car (symbol-function 'car))")))
    (is (= 42 (m:evaluate-string vm "(funcall (symbol-function '+) 20 22)")))
    (let ((function (m:evaluate-string vm "#'car")))
      (is (m:guest-function-p function))
      (is (eq function (m:evaluate-string vm "(symbol-function 'car)")))
      (is (= 42 (m:evaluate vm `(funcall ,function '(42))))))
    (m:evaluate-string vm "(setf (symbol-function 'my-function) #'car)
                           (setq saved-function (symbol-function 'my-function))
                           (fmakunbound 'my-function)")
    (is (null (m:evaluate-string vm "(fboundp 'my-function)")))
    (signals m:interpreter-error (m:evaluate-string vm "(my-function '(1))"))
    (signals m:interpreter-error (m:evaluate-string vm "(symbol-function 'my-function)"))
    (is (= 7 (m:evaluate-string vm "(funcall saved-function '(7))")))
    (m:evaluate-string vm "(setf (fdefinition 'my-function) #'cdr)")
    (is (equal '(2 3) (m:evaluate-string vm "(my-function '(1 2 3))")))
    (is (= 9 (m:evaluate-string vm "(funcall #'(setf symbol-value) 9 'setter-test)")))
    (is (= 9 (m:evaluate-string vm "setter-test")))
    (is (eq t (m:evaluate-string vm "(fboundp '(setf get))")))
    (m:evaluate-string vm "(defun (setf custom) (value object) (set object value))")
    (is (= 13 (m:evaluate-string vm "(setf (custom 'setter-test) 13)")))
    (is (= 13 (m:evaluate-string vm "setter-test")))
    (is (equal '(t t t nil)
      (m:evaluate-string vm "(list (fboundp 'if) (fboundp 'defun) (special-operator-p 'if) (special-operator-p 'defun))")))
    (dolist (source '("(setf (symbol-function 'bad) 'car)" "(symbol-function 1)"
                      "(fdefinition '(bad name))" "(symbol-function 'undefined)" "#'undefined"))
      (signals m:interpreter-error (m:evaluate-string vm source)))))

(test symbol-copying
  (m:with-interpreter (vm)
    (m:evaluate-string vm "(set 'original 21) (setf (symbol-function 'original) #'car)
      (setf (get 'original :property) (list 1 2))
      (setq bare (copy-symbol 'original) copied (copy-symbol 'original t))")
    (is (equal '(nil nil nil nil nil "ORIGINAL")
      (m:evaluate-string vm "(list (eq bare 'original) (symbol-package bare) (boundp bare)
        (fboundp bare) (symbol-plist bare) (symbol-name bare))")))
    (is (equal '(21 5 t nil t)
      (m:evaluate-string vm "(list (symbol-value copied) (funcall copied '(5))
        (eq (symbol-function copied) (symbol-function 'original))
        (eq (symbol-plist copied) (symbol-plist 'original))
        (eq (get copied :property) (get 'original :property)))")))
    (m:evaluate-string vm "(set copied 22) (setf (get copied :property) 3)")
    (is (equal '(21 (1 2)) (m:evaluate-string vm "(list (symbol-value 'original) (get 'original :property))")))
    (is (equal '(nil t nil t)
      (m:evaluate-string vm "(let ((s (copy-symbol :key t)))
        (list (keywordp s) (boundp s) (symbol-package s) (eq (symbol-value s) :key)))")))))

(test symbol-generators
  (m:with-interpreter (vm)
    (is (equal '("G0" "X1" 2 "G99" 2)
      (m:evaluate-string vm "(list (symbol-name (gensym)) (symbol-name (gensym \"X\"))
        *gensym-counter* (symbol-name (gensym 99)) *gensym-counter*)")))
    (is (equal '("G123456789012345678901234567890" 123456789012345678901234567891)
      (m:evaluate-string vm "(let ((*gensym-counter* 123456789012345678901234567890))
        (list (symbol-name (gensym)) *gensym-counter*))")))
    (is (= 2 (m:evaluate-string vm "*gensym-counter*")))
    (is (null (m:evaluate-string vm "(eq (gensym 3) (gensym 3))")))
    (is (equal '(nil nil nil nil)
      (m:evaluate-string vm "(let ((s (gensym)))
        (list (symbol-package s) (boundp s) (fboundp s) (symbol-plist s)))")))
    (m:evaluate-string vm "(defun next-symbol-name () (symbol-name (gensym)))")
    (is (equal '("G10" 11)
      (m:evaluate-string vm "(let ((*gensym-counter* 10)) (list (next-symbol-name) *gensym-counter*))")))
    (signals m:interpreter-error (m:evaluate-string vm "(let ((*gensym-counter* 10)) (/ 1 0))"))
    (is (= 3 (m:evaluate-string vm "*gensym-counter*")))
    (m:evaluate-string vm "(defpackage :generated-source (:use) (:export :t0))
                           (defpackage :generated (:use :generated-source) (:intern :t1))")
    (is (equal '("T2" "GENERATED" nil nil nil)
      (m:evaluate-string vm "(let ((s (gentemp \"T\" :generated)))
        (list (symbol-name s) (package-name (symbol-package s)) (boundp s) (fboundp s) (symbol-plist s)))")))
    (is (equal '(t t) (m:evaluate-string vm "(let ((s (gentemp \"K\" :keyword))) (list (keywordp s) (eq s (symbol-value s))))")))
    (is (= 1 (length (multiple-value-list (m:evaluate-string vm "(gentemp)")))))
    (dolist (source '("(gensym nil)" "(gensym -1)" "(gensym 1/2)" "(gensym 1 2)"
                      "(gentemp nil)" "(gentemp \"X\" :missing)"
                      "(let ((*gensym-counter* -1)) (gensym))"))
      (signals m:interpreter-error (m:evaluate-string vm source)))))

(test symbol-dynamic-values
  (m:with-interpreter (vm)
    (m:evaluate-string vm "(defvar *special* 1) (defvar *special* 99)
      (defun read-special () *special*)")
    (is (= 1 (m:evaluate-string vm "*special*")))
    (is (equal '(2 2 3 3 nil)
      (m:evaluate-string vm "(let ((*special* 2))
        (list (read-special) (symbol-value '*special*) (set '*special* 3)
          (read-special) (progn (makunbound '*special*) (boundp '*special*))))")))
    (is (= 1 (m:evaluate-string vm "*special*")))
    (m:evaluate-string vm "(defparameter *special* 4) (setq declared 10)
      (defun read-declared () (declare (special declared)) declared)")
    (is (= 4 (m:evaluate-string vm "*special*")))
    (is (equal '(20 20 20)
      (m:evaluate-string vm "(let ((declared 20)) (declare (special declared))
        (list declared (symbol-value 'declared) (read-declared)))")))
    (is (equal '(10 30)
      (m:evaluate-string vm "(let ((declared 30)) (list (locally (declare (special declared)) declared) declared))")))
    (is (equal '(20 20) (m:evaluate-string vm
      "(let* ((declared 20) (observed (read-declared))) (declare (special declared)) (list declared observed))")))
    ;; A closure captures lexical cells, while special values follow its caller.
    (m:evaluate-string vm "(setq closure (let ((*special* 99)) (function (lambda () *special*))))")
    (is (= 4 (m:evaluate-string vm "(funcall closure)")))
    (signals m:interpreter-error (m:evaluate-string vm "(let ((*special* 8)) (symbol-value (make-symbol \"UNBOUND\")))"))
    (is (= 4 (m:evaluate-string vm "*special*")))))

(test native-get-properties
  (m:with-interpreter (vm)
    (dolist (form
      '((multiple-value-list (get-properties nil nil))
        (multiple-value-list (get-properties '(a 1 b 2 a 3) '(b a)))
        (multiple-value-list (get-properties '(nil nil a 1) '(nil)))
        (multiple-value-list (get-properties '(a nil b 2) '(a)))
        (multiple-value-list (get-properties '(a 1 b 2) '(missing)))
        (let* ((key (copy-seq "key")) (plist (list key 1)))
          (list (multiple-value-list (get-properties plist (list (copy-seq key))))
                (multiple-value-list (get-properties plist (list key)))))
        (let ((plist (list 'a 1 'b 2)))
          (multiple-value-bind (key value tail) (get-properties plist '(b a))
            (list key value (eq tail plist) plist)))
        (let ((count 0))
          (list (multiple-value-list (get-properties (progn (incf count) '(a 1))
            (progn (incf count) '(a)))) count))))
      (is (equal (eval form) (m:evaluate vm form)) "Property mismatch for ~S" form))
    (dolist (form '((get-properties) (get-properties nil) (get-properties nil nil nil)))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
    (dolist (form '((get-properties '(a 1 b 2) '(x . y))
                    (get-properties '(a 1 b 2 . c) '(x))
                    (get-properties '(a 1 b . c) '(x))))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))))

(test property-list-places
  (m:with-interpreter (vm)
    (dolist (form
      '((let ((x nil)) (list (setf (getf x :a) 1) (getf x :a) (length x)))
        (let ((x (list :a 1 :a 2 :b 3)))
          (list (setf (getf x :a 99) 4) x))
        (let ((x nil)) (list (incf (getf x :a 19)) (getf x :a)))
        (let ((x (list :a (list 1)))) (list (push 2 (getf x :a)) (getf x :a)))
        (let ((x (list nil nil))) (list (getf x nil 9) (setf (getf x nil) 3) (getf x nil)))
        (let ((x nil) (i 0))
          (list (setf (getf x (progn (incf i) :a) (incf i)) (incf i)) i x))
        (let ((x (vector nil)) (i 0))
          (list (setf (getf (aref x (progn (incf i) 0)) (progn (incf i) :a) (incf i))
                      (incf i)) i (aref x 0)))
        (let ((x (list :a 1 :b 2)))
          (list (rotatef (getf x :a) (getf x :b)) x))
        (let ((x (list :a 1 :b 2)))
          (list (psetf (getf x :a) (getf x :b) (getf x :b) (getf x :a)) x))
        (let ((x (list :a 1 :b 2))) (list (shiftf (getf x :a) (getf x :b) 3) x))
        (let ((x nil)) (list (setf (getf (getf x :outer) :inner) 17) (getf (getf x :outer) :inner)))
        (let ((x (list :a 1)))
          (list (setf (getf x :a (progn (setq x (list :b 2)) 0)) 3) (getf x :a) (getf x :b)))
        (let ((x nil)) (list (remf x :a) x))
        (let ((x (list :a 1 :a 2 :b 3))) (list (remf x :a) x (remf x :missing) x))
        (let ((x (list :a 1 :b 2))) (list (remf x :b) x))
        (let ((x (list :a 1))) (list (remf x (progn (setq x (list :b 2)) :a)) x))
        (let ((x (vector (list :a 1 :b 2))) (i 0))
          (list (remf (aref x (progn (incf i) 0)) (progn (incf i) :b)) i (aref x 0)))
        (let ((x (list :a (list :b 2))))
          (list (remf (getf x :a) :b) (getf x :a)))
        (let ((x nil)) (multiple-value-list (setf (getf x :a) (values 1 2))))
        (let ((x (list :a 1))) (multiple-value-list (remf x :a)))))
      (is (equalp (eval form) (m:evaluate vm form)) "Property place mismatch for ~S" form))
    (dolist (form '((remf) (remf x) (remf x y z) (setf (getf x) 1) (setf (getf x :a 1 2) 3)
                    (member nil nil :test) (adjoin 1 nil :key) (make-list 1 :initial-element)
                    (string-upcase "ab" :start)
                    (flet ((f (&key a) a)) (f :a))))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
    (dolist (form '((getf '(a . b) 'c) (getf '(a 1 . b) 'c)
                    (let ((x '(a . b))) (setf (getf x :c) 1))
                    (let ((x '(a . b))) (remf x :c))))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))))

(test native-pushnew-places
  (m:with-interpreter (vm)
    (dolist (form
      '((let ((x nil)) (list (pushnew 1 x) x))
        (let ((x (list 1 2))) (list (pushnew 1 x) x))
        (let ((x (list 1 2))) (list (pushnew 3 x) x))
        (let ((x (list (list 1 2)))) (list (pushnew (list 1 3) x :key #'car) x))
        (let ((x (list (list 1 2)))) (list (pushnew (list 2 3) x :test #'equal) x))
        (let ((x (list 1 2))) (list (pushnew 3 x :test-not #'/=) x))
        (let ((x (list 1 2))) (list (pushnew 3 x :key nil) x))
        (let ((x nil)) (list (pushnew 1 (getf x :a)) (getf x :a)))
        (let ((x (vector nil nil nil nil)) (i 0))
          (list (pushnew (incf i) (aref x (incf i)) :test (progn (incf i) #'eql)) i x))
        (let ((x (list 1 2))) (list (pushnew (progn (setq x (list 3 4)) 5) x) x))
        (let ((x (list 1 2)))
          (list (pushnew 3 x :test (progn (setq x (list 4 5)) #'eql)) x))
        (let ((x (list 1))) (list (pushnew 2 x :key nil :key #'1+) x))
        (let ((x nil)) (multiple-value-list (pushnew (values 1 2) x)))))
      (is (equalp (eval form) (m:evaluate vm form)) "PUSHNEW mismatch for ~S" form))
    (dolist (form '((pushnew) (pushnew 1) (let ((x nil)) (pushnew 1 x :bad))
                    (let ((x nil)) (pushnew 1 x :bad 1))
                    (let ((x '(1 2))) (pushnew 1 x :test #'identity))))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
    (is (eq t (m:evaluate vm '(let ((x 17)) (handler-case (pushnew 1 x) (type-error () t))))))))

(test function-definition-names-and-operators
  (m:with-interpreter (vm)
    (dolist (name (remove-duplicates (append m::*runtime-special-operators* m::*runtime-macros*)))
      (is (eq t (m:evaluate vm `(and (fboundp ',name)
        (progn (fdefinition ',name) t) (progn (symbol-function ',name) t))))
          "Registered operator has no readable definition: ~S" name)
      (is (eq (not (null (member name m::*runtime-special-operators*)))
              (m:evaluate vm `(not (null (special-operator-p ',name)))))))
    (dolist (function '(fdefinition fboundp fmakunbound))
      (dolist (name '(17 1/2 "bad" #(1 2) (setf) (setf . bad) (setf bad . tail)
                     (setf bad extra) (setf 17) (other bad)))
        (is (eq t (m:evaluate vm
          `(handler-case (,function ',name)
             (type-error (c) (and (equalp (type-error-datum c) ',name)
               (not (typep (type-error-datum c) (type-error-expected-type c)))))))))))
    (is (eq t (m:evaluate vm
      '(let ((name (list 'setf)))
         (setf (cdr name) name)
         (handler-case (fdefinition name) (type-error (c) (eq name (type-error-datum c))))))))
    (is (eq t (m:evaluate-string vm "(defmacro definition-macro () 17)
      (and (fboundp 'definition-macro) (progn (fdefinition 'definition-macro) t)
        (progn (fmakunbound 'definition-macro) (not (fboundp 'definition-macro))))")))
    (is (equal '(t t t nil) (m:evaluate-string vm
      "(list (eq #'car (fdefinition 'car)) (functionp (fdefinition '(setf car)))
             (fboundp '(setf car)) (special-operator-p 'car))")))))
