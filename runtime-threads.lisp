;;;; One shared Lisp heap with stackful green threads. Host adapters only
;;;; suspend/resume native Wasm stacks; scheduling and Lisp state live here.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defparameter *thread-state*
  (append
    (loop for name in '($extra-values $dynamic-package $dynamic-variables $handlers $restarts
                       $restart-associations $catches $targets $transfer-target
                       $transfer-values $transfer-function $last-condition $undefined-name
                       $derived-type-environment $format-stream $format-list-stream
                       $format-list-state $source-labels $reader-stream $reader-readtable $warnings)
          collect (list name '(ref null $obj) '(ref.null $obj)))
    (loop for name in '($error $unbound-symbol $backtrace-depth $backtrace-saved-depth
                       $cursor $limit $loop-expansion-slot $source-generic $source-end $source-position
                       $source-depth $source-bq-depth $source-suppress $text-status
                       $text-output-length $format-base $format-column $method-print-depth
                       $circle-phase $circle-label $javascript-depth $thread-mask)
          collect (list name 'i32 '(i32.const 0)))
    '(($value-count i32 (i32.const 1))
      ($reader-standard-syntax i32 (i32.const 1))
      ($reader-object-present i32 (i32.const 1))
      ($circle-table (ref null $obj) (ref.null $obj))
      ($circle-stream (ref null $obj) (ref.null $obj))
      ($source (ref $digits) (array.new_default $digits (i32.const 0)))
      ($backtrace-frames (ref $objects) (array.new_default $objects (i32.const 64)))
      ($backtrace-saved (ref $objects) (array.new_default $objects (i32.const 64))))))

(defun thread-context-constructor (fresh)
  `(struct.new $thread-context
     ,@(loop for (name type initial) in *thread-state* collect
       (if fresh initial `(global.get ,name)))))

(define-runtime-function $thread-find (($id i32)) ((ref $green-thread))
  (:locals ($scan :nullable-object) ($thread (ref $green-thread)))
  #@(local.set $scan (global.get $threads))
  (wat-list-loop ($scan)
    #@(local.set $thread (ref.cast (ref $green-thread) (call $car (local.get $scan))))
    #@(if (i32.eq (struct.get $obj $n (local.get $thread)) (local.get $id))
      (then (return (local.get $thread)))))
  (wat-fail :unsupported)
  #@(unreachable))

(define-runtime-function $thread-create (($function :nullable-object)) ((ref $green-thread))
  (:locals ($thread (ref $green-thread)) ($id i32))
  #@(if (ref.is_null (global.get $thread-free-ids))
    (then (local.set $id (global.get $next-thread))
      (global.set $next-thread (i32.add (global.get $next-thread) (i32.const 1))))
    (else (local.set $id (call $natural-count (call $car (global.get $thread-free-ids))))
      (global.set $thread-free-ids (call $cdr (global.get $thread-free-ids)))))
  #@(local.set $thread (struct.new $green-thread (i32.const 48)
    (local.get $id) (f64.const -1) (ref.null $digits)
    (local.get $function) (ref.null $obj) (ref.null $obj)
    (i32.const 0) ,(thread-context-constructor t) (i32.const 0) (i32.const 0)
    (i32.const 0) (ref.null $obj) (ref.null $obj) (f64.const -1) (i32.const 0)))
  #@(global.set $threads (call $cons (local.get $thread) (global.get $threads)))
  #@(local.get $thread))

(define-runtime-function $thread-current () ((ref $green-thread))
  #@(if (ref.is_null (global.get $current-thread))
    (then (global.set $current-thread (call $thread-create (ref.null $obj)))))
  #@(ref.as_non_null (global.get $current-thread)))

(define-runtime-function $thread-free-scratch (($thread (ref $green-thread))) ()
  #@(if (struct.get $green-thread $capacity (local.get $thread))
    (then
      (global.set $thread-free-blocks (struct.new $thread-scratch-block
        (struct.get $green-thread $memory-offset (local.get $thread))
        (struct.get $green-thread $capacity (local.get $thread)) (global.get $thread-free-blocks)))
      (struct.set $green-thread $capacity (local.get $thread) (i32.const 0))
      (struct.set $green-thread $memory-bytes (local.get $thread) (i32.const 0)))))

(define-runtime-function $thread-allocate-scratch (($thread (ref $green-thread)) ($pages i32)) ()
  (:locals ($scan (ref null $thread-scratch-block)) ($previous (ref null $thread-scratch-block)) ($offset i32))
  #@(local.set $scan (global.get $thread-free-blocks))
  #@(block $done (loop $find
    (br_if $done (ref.is_null (local.get $scan)))
    (if (i32.ge_u (struct.get $thread-scratch-block $capacity (local.get $scan)) (local.get $pages))
      (then
        (if (ref.is_null (local.get $previous))
          (then (global.set $thread-free-blocks (struct.get $thread-scratch-block $next (local.get $scan))))
          (else (struct.set $thread-scratch-block $next (local.get $previous)
            (struct.get $thread-scratch-block $next (local.get $scan)))))
        (call $thread-free-scratch (local.get $thread))
        (struct.set $green-thread $memory-offset (local.get $thread) (struct.get $thread-scratch-block $offset (local.get $scan)))
        (struct.set $green-thread $capacity (local.get $thread) (struct.get $thread-scratch-block $capacity (local.get $scan)))
        (return)))
    (local.set $previous (local.get $scan))
    (local.set $scan (struct.get $thread-scratch-block $next (local.get $scan))) (br $find)))
  #@(local.set $offset (memory.grow $thread-memory (local.get $pages)))
  (wat-fail-when #@(i32.eq (local.get $offset) (i32.const -1)) :allocation)
  #@(call $thread-free-scratch (local.get $thread))
  #@(struct.set $green-thread $memory-offset (local.get $thread) (i32.shl (local.get $offset) (i32.const 16)))
  #@(struct.set $green-thread $capacity (local.get $thread) (local.get $pages)))

(define-runtime-function $thread-save () ()
  (:export-raw "thread-save")
  (:locals ($thread (ref $green-thread)) ($pages i32) ($bytes i32))
  #@(local.set $thread (call $thread-current))
  #@(struct.set $green-thread $context (local.get $thread) ,(thread-context-constructor nil))
  ;; Linear memory is transport/reader/printer scratch, not the Lisp heap.
  ;; Capacity can remain huge after mounting a file. Only the output prefix
  ;; and the current binary input extent are live across a Lisp safepoint.
  ;; Keep their offsets, but never copy unused capacity on a context switch.
  #@(local.set $bytes (select (global.get $cursor) (global.get $limit)
    (i32.gt_u (global.get $cursor) (global.get $limit))))
  #@(local.set $pages (i32.shr_u (i32.add (local.get $bytes) (i32.const 65535)) (i32.const 16)))
  #@(if (i32.gt_u (local.get $pages) (struct.get $green-thread $capacity (local.get $thread)))
    (then (call $thread-allocate-scratch (local.get $thread) (local.get $pages))))
  #@(struct.set $green-thread $memory-bytes (local.get $thread) (local.get $bytes))
  #@(memory.copy $thread-memory 0 (struct.get $green-thread $memory-offset (local.get $thread))
    (i32.const 0) (local.get $bytes)))

(define-runtime-function $thread-enter (($id i32)) ()
  (:export-raw "thread-enter")
  (:locals ($thread (ref $green-thread)) ($context (ref $thread-context)))
  #@(local.set $thread (call $thread-find (local.get $id)))
  #@(global.set $current-thread (local.get $thread))
  #@(local.set $context (ref.as_non_null (struct.get $green-thread $context (local.get $thread))))
  (runtime-wat-forms
    (loop for (name type initial) in *thread-state* for i from 0 collect
      `(global.set ,name (struct.get $thread-context ,i (local.get $context)))))
  #@(memory.copy 0 $thread-memory (i32.const 0)
    (struct.get $green-thread $memory-offset (local.get $thread))
    (struct.get $green-thread $memory-bytes (local.get $thread)))
  #@(global.set $thread-budget (i32.const 2048))
  ;; Poll cheaply between clock samples, and yield by elapsed time rather than
  ;; taking a host round trip every few microseconds of native execution.
  #@(global.set $thread-slice-deadline
    (f64.add (call $host-service (i32.const 1) (f64.const 0)) (f64.const 8)))
  #@(global.set $thread-pending (struct.get $green-thread $interrupts (local.get $thread))))

(define-runtime-function $thread-switch () ()
  (wat-fail-when #@(i32.or (i32.eqz (global.get $thread-active))
    (ref.is_null (table.get $thread-services (i32.const 0)))) :unsupported)
  (wat-fail-when #@(global.get $javascript-depth) :unsupported)
  #@(call $thread-save)
  #@(call_indirect $thread-services (type $thread-service-type) (i32.const 0)))

(define-runtime-function $thread-checkpoint () ()
  (:locals ($thread (ref $green-thread)) ($pending :nullable-object)
           ($values :nullable-object) ($count i32))
  #@(if (i32.or (i32.eqz (global.get $thread-active))
      (i32.or (global.get $thread-mask) (global.get $javascript-depth))) (then (return)))
  #@(global.set $thread-budget (i32.sub (global.get $thread-budget) (i32.const 1)))
  #@(if (i32.and (i32.gt_s (global.get $thread-budget) (i32.const 0))
      (ref.is_null (global.get $thread-pending))) (then (return)))
  #@(local.set $values (global.get $extra-values))
  #@(local.set $count (global.get $value-count))
  #@(local.set $thread (call $thread-current))
  #@(if (i32.or (i32.eqz (struct.get $green-thread $started (local.get $thread)))
      (i32.eq (struct.get $green-thread $state (local.get $thread)) (i32.const 2))) (then (return)))
  #@(local.set $pending (struct.get $green-thread $interrupts (local.get $thread)))
  #@(if (i32.eqz (ref.is_null (local.get $pending)))
    (then
      (struct.set $green-thread $interrupts (local.get $thread) (call $cdr (local.get $pending)))
      (global.set $thread-pending (call $cdr (local.get $pending)))
      (drop (call $apply (call $car (local.get $pending)) (ref.null $obj)))))
  #@(if (i32.le_s (global.get $thread-budget) (i32.const 0))
    (then
      (global.set $thread-budget (i32.const 2048))
      (if (f64.ge (call $host-service (i32.const 1) (f64.const 0)) (global.get $thread-slice-deadline))
        (then (call $thread-switch)))))
  #@(global.set $extra-values (local.get $values))
  #@(global.set $value-count (local.get $count)))

(define-runtime-function $thread-park (($milliseconds f64)) ()
  (:locals ($thread (ref $green-thread)) ($mask i32))
  #@(local.set $thread (call $thread-current))
  #@(struct.set $green-thread $state (local.get $thread) (i32.const 1))
  #@(struct.set $green-thread $deadline (local.get $thread)
    (if (result f64) (f64.lt (local.get $milliseconds) (f64.const 0)) (then (f64.const -1))
      (else (f64.add (call $host-service (i32.const 1) (f64.const 0)) (local.get $milliseconds)))))
  #@(call $thread-switch)
  ;; Deliver interrupts after a blocking wait, before rechecking its predicate.
  #@(local.set $mask (global.get $thread-mask))
  #@(global.set $thread-mask (i32.const 0))
  #@(call $thread-checkpoint)
  #@(global.set $thread-mask (local.get $mask)))

(define-runtime-function $thread-next () (i32)
  (:export-raw "thread-next")
  (:locals ($pass i32) ($scan :nullable-object) ($thread (ref $green-thread)) ($now f64))
  #@(local.set $now (call $host-service (i32.const 1) (f64.const 0)))
  #@(local.set $scan (global.get $thread-scan))
  #@(loop $next
    (if (ref.is_null (local.get $scan))
      (then (if (local.get $pass) (then (return (i32.const -1))))
        (local.set $pass (i32.const 1)) (local.set $scan (global.get $threads))
        (if (ref.is_null (local.get $scan)) (then (return (i32.const -1))))))
    (local.set $thread (ref.cast (ref $green-thread) (call $car (local.get $scan))))
    (local.set $scan (call $cdr (local.get $scan)))
    (if (i32.and (i32.eq (struct.get $green-thread $state (local.get $thread)) (i32.const 1))
        (i32.and (f64.ge (struct.get $green-thread $deadline (local.get $thread)) (f64.const 0))
          (f64.le (struct.get $green-thread $deadline (local.get $thread)) (local.get $now))))
      (then (struct.set $green-thread $state (local.get $thread) (i32.const 0))))
    (if (i32.eqz (struct.get $green-thread $state (local.get $thread)))
      (then (global.set $thread-scan (local.get $scan))
        (return (struct.get $obj $n (local.get $thread))))) (br $next))
  #@(unreachable))

(define-runtime-function $thread-delay () (f64)
  (:export-raw "thread-delay")
  (:locals ($scan :nullable-object) ($thread (ref $green-thread)) ($delay f64) ($time f64) ($now f64))
  #@(local.set $delay (f64.const -1))
  #@(local.set $now (call $host-service (i32.const 1) (f64.const 0)))
  #@(local.set $scan (global.get $threads))
  (wat-list-loop ($scan)
    #@(local.set $thread (ref.cast (ref $green-thread) (call $car (local.get $scan))))
    #@(if (i32.eqz (struct.get $green-thread $state (local.get $thread))) (then (return (f64.const 0))))
    #@(if (i32.eq (struct.get $green-thread $state (local.get $thread)) (i32.const 1))
      (then (local.set $time (struct.get $green-thread $deadline (local.get $thread)))
        (if (f64.ge (local.get $time) (f64.const 0))
          (then (local.set $time (f64.max (f64.const 0) (f64.sub (local.get $time) (local.get $now))))
            (if (i32.or (f64.lt (local.get $delay) (f64.const 0)) (f64.lt (local.get $time) (local.get $delay)))
              (then (local.set $delay (local.get $time)))))))))
  #@(local.get $delay))

(define-runtime-function $thread-run (($id i32)) ()
  (:export-raw "thread-run")
  (:locals ($thread (ref $green-thread)))
  #@(local.set $thread (call $thread-find (local.get $id)))
  #@(drop (call $apply (struct.get $obj $a (local.get $thread)) (ref.null $obj)))
  #@(struct.set $green-thread $state (local.get $thread) (i32.const 2)))

(define-runtime-function $thread-failed (($id i32)) ()
  (:export-raw "thread-failed")
  #@(global.set $error (i32.const 0))
  #@(drop (call $apply ,(clos-library-reference 'miricl-threads::%host-failed)
    (call $cons (struct.get $green-thread $public (call $thread-find (local.get $id))) (ref.null $obj)))))

(define-runtime-function $thread-id () (i32)
  (:export-raw "thread-current-id")
  #@(struct.get $obj $n (call $thread-current)))

(define-runtime-function $thread-main-state (($state i32)) ()
  (:export-raw "thread-main-state")
  #@(struct.set $green-thread $state (call $thread-find (i32.const 0)) (local.get $state))
  #@(struct.set $green-thread $deadline (call $thread-find (i32.const 0)) (f64.const -1)))

(define-runtime-function $thread-retire (($id i32)) ()
  (:export-raw "thread-retire")
  (:locals ($scan :nullable-object) ($previous :nullable-object) ($thread (ref $green-thread)))
  #@(local.set $thread (call $thread-find (local.get $id)))
  #@(call $thread-free-scratch (local.get $thread))
  #@(global.set $thread-free-ids (call $cons (call $int (local.get $id)) (global.get $thread-free-ids)))
  #@(struct.set $green-thread $context (local.get $thread) (ref.null $thread-context))
  #@(struct.set $obj $a (local.get $thread) (ref.null $obj))
  #@(struct.set $green-thread $interrupts (local.get $thread) (ref.null $obj))
  #@(local.set $scan (global.get $threads))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (if (i32.eq (struct.get $obj $n (call $car (local.get $scan))) (local.get $id))
      (then
        (if (ref.is_null (local.get $previous)) (then (global.set $threads (call $cdr (local.get $scan))))
          (else (struct.set $obj $b (local.get $previous) (call $cdr (local.get $scan)))))
        (if (ref.eq (global.get $thread-scan) (local.get $scan))
          (then (global.set $thread-scan (call $cdr (local.get $scan)))))
        (return)))
    (local.set $previous (local.get $scan)) (local.set $scan (call $cdr (local.get $scan))) (br $next))))

(define-runtime-function $thread-operation (($operation i32) ($a :nullable-object) ($b :nullable-object)) (:nullable-object)
  (:locals ($thread (ref $green-thread)) ($old i32) ($scan :nullable-object) ($result :nullable-object))
  #@(if (i32.eq (local.get $operation) (i32.const 0)) (then (return (call $thread-current))))
  #@(if (i32.eq (local.get $operation) (i32.const 16))
    (then (struct.set $green-thread $started (call $thread-current) (i32.const 1))
      (return (ref.null $obj))))
  #@(if (i32.eq (local.get $operation) (i32.const 14))
    (then (return (call $bool (global.get $thread-active)))))
  #@(if (i32.eq (local.get $operation) (i32.const 1))
    (then (return (call $thread-create (local.get $a)))))
  #@(if (i32.eq (local.get $operation) (i32.const 4))
    (then (call $thread-switch) (return (ref.null $obj))))
  #@(if (i32.eq (local.get $operation) (i32.const 5))
    (then (call $thread-park (if (result f64) (ref.is_null (local.get $a)) (then (f64.const -1))
      (else (f64.mul (call $coerce-float (ref.as_non_null (local.get $a)) (i32.const 4)) (f64.const 1000)))))
      (return (ref.null $obj))))
  #@(if (i32.eq (local.get $operation) (i32.const 13))
    (then (local.set $old (global.get $thread-mask))
      (global.set $thread-mask (call $natural-count (local.get $a)))
      (return (call $int (local.get $old)))))
  #@(if (i32.eq (local.get $operation) (i32.const 11))
    (then (local.set $scan (global.get $threads))
      (loop $all
        (if (ref.is_null (local.get $scan)) (then (return (local.get $result))))
        (local.set $thread (ref.cast (ref $green-thread) (call $car (local.get $scan))))
        (if (i32.lt_u (struct.get $green-thread $state (local.get $thread)) (i32.const 2))
          (then (local.set $result (call $cons (struct.get $green-thread $public (local.get $thread)) (local.get $result)))))
        (local.set $scan (call $cdr (local.get $scan))) (br $all))))
  #@(local.set $thread (ref.cast (ref $green-thread) (local.get $a)))
  #@(if (i32.eq (local.get $operation) (i32.const 2))
    (then (struct.set $green-thread $public (local.get $thread) (local.get $b))
      (if (i32.eqz (struct.get $obj $n (local.get $thread)))
        (then (struct.set $green-thread $started (local.get $thread) (i32.const 1))))
      (return (local.get $b))))
  #@(if (i32.eq (local.get $operation) (i32.const 3))
    (then (return (struct.get $green-thread $public (local.get $thread)))))
  #@(if (i32.eq (local.get $operation) (i32.const 6))
    (then (if (i32.eq (struct.get $green-thread $state (local.get $thread)) (i32.const 1))
      (then (struct.set $green-thread $state (local.get $thread) (i32.const 0))))
      (return (ref.null $obj))))
  #@(if (i32.eq (local.get $operation) (i32.const 7))
    (then (return (call $bool (i32.lt_u (struct.get $green-thread $state (local.get $thread)) (i32.const 2))))))
  #@(if (i32.eq (local.get $operation) (i32.const 8))
    (then (struct.set $green-thread $state (local.get $thread) (i32.const 2))
      (struct.set $obj $b (local.get $thread) (call $car (local.get $b)))
      (struct.set $obj $c (local.get $thread) (call $cdr (local.get $b)))
      (return (ref.null $obj))))
  #@(if (i32.eq (local.get $operation) (i32.const 9))
    (then (return (struct.get $obj $b (local.get $thread)))))
  #@(if (i32.eq (local.get $operation) (i32.const 10))
    (then (return (struct.get $obj $c (local.get $thread)))))
  #@(if (i32.eq (local.get $operation) (i32.const 12))
    (then
      (struct.set $green-thread $interrupts (local.get $thread)
        (call $cons (local.get $b) (struct.get $green-thread $interrupts (local.get $thread))))
      (if (ref.eq (local.get $thread) (global.get $current-thread))
        (then (global.set $thread-pending (struct.get $green-thread $interrupts (local.get $thread)))))
      (if (i32.eq (struct.get $green-thread $state (local.get $thread)) (i32.const 1))
        (then (struct.set $green-thread $state (local.get $thread) (i32.const 0))))
      (return (ref.null $obj))))
  #@(if (i32.eq (local.get $operation) (i32.const 15))
    (then (return (call $int (struct.get $obj $n (local.get $thread))))))
  (wat-fail :unsupported)
  #@(ref.null $obj))

(define-runtime-section thread-runtime-wat ()
  (runtime-wat-forms (list `(type $thread-context (struct
    ,@(loop for (name type initial) in *thread-state* collect
      `(field ,type))))))
  #@(type $green-thread (sub final $obj (struct
    (field $tag i32) (field $n (mut i32)) (field $f f64) (field $digits (ref null $digits))
    (field $a (mut (ref null $obj))) (field $b (mut (ref null $obj))) (field $c (mut (ref null $obj)))
    (field $state (mut i32)) (field $context (mut (ref null $thread-context)))
    (field $memory-offset (mut i32)) (field $capacity (mut i32)) (field $memory-bytes (mut i32))
    (field $public (mut (ref null $obj))) (field $interrupts (mut (ref null $obj))) (field $deadline (mut f64)) (field $started (mut i32)))))
  #@(type $thread-scratch-block (struct (field $offset i32) (field $capacity i32)
    (field $next (mut (ref null $thread-scratch-block)))))
  #@(global $thread-free-blocks (mut (ref null $thread-scratch-block)) (ref.null $thread-scratch-block))
  #@(type $thread-service-type (func))
  #@(table $thread-services (export "thread-services") 1 1 funcref)
  #@(memory $thread-memory (export "thread-scratch-memory") 0)
  #@(global $threads (mut (ref null $obj)) (ref.null $obj))
  #@(global $thread-scan (mut (ref null $obj)) (ref.null $obj))
  #@(global $current-thread (mut (ref null $green-thread)) (ref.null $green-thread))
  #@(global $next-thread (mut i32) (i32.const 0))
  #@(global $thread-free-ids (mut (ref null $obj)) (ref.null $obj))
  #@(global $thread-active (export "thread-active") (mut i32) (i32.const 0))
  #@(global $thread-mask (mut i32) (i32.const 0))
  #@(global $thread-budget (mut i32) (i32.const 2048))
  ;; Derived from the current thread on entry, never restored from a stale
  ;; saved context: another thread can enqueue an interrupt while it sleeps.
  #@(global $thread-pending (mut (ref null $obj)) (ref.null $obj))
  #@(global $thread-slice-deadline (mut f64) (f64.const 0))
