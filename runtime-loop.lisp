;;;; LOOP expansion is a private Common Lisp library executed inside WASM.
(in-package #:miricl)

(defparameter *loop-library*
  (mapcar #'lower-runtime-library
   '((defparameter %tokens nil)
     (defparameter %bindings nil)
     (defparameter %steps nil)
     (defparameter %initial nil)
     (defparameter %final nil)
     (defparameter %body nil)
     (defparameter %accumulators nil)
     (defparameter %result nil)
     (defparameter %result-mode nil)
     (defparameter %name nil)
     (defparameter %it nil)
     (defparameter %variables nil)
     (defparameter %parallel nil)
     (defun %word (x text)
       (and (symbolp x) x (string= (symbol-name x) text)))
     (defun %peek (text) (%word (car %tokens) text))
     (defun %take ()
       (unless %tokens (error 'program-error))
       (pop %tokens))
     (defun %accept (text)
       (if (%peek text) (progn (%take) t) nil))
     (defun %bind (name init)
       (unless (and name (symbolp name)) (error 'program-error))
       (let ((scan %variables))
         (%%while scan
           (when (eq name (car scan)) (error 'program-error))
           (setq scan (cdr scan))))
       (push name %variables)
       (push (list name init) %bindings)
       name)
     (defun %stop (test)
       (list 'if test (list 'return-from '%finish nil)))
     (defun %forms ()
       (let ((forms nil))
         (%%while (and %tokens (typep (car %tokens) 'cons))
           (push (%take) forms))
         (unless forms (error 'program-error))
         (cons 'progn (reverse forms))))
     (defun %pattern (pattern expr init) (%typed-pattern pattern expr init nil))
     (defun %typed-pattern (pattern expr init type)
       (cond ((null pattern) nil)
             ((symbolp pattern)
              (let ((value (if type (list 'the type expr) expr)))
                (if init (%bind pattern value)
                    (push (list 'setq pattern value) %body))))
             ((typep pattern 'cons)
              (let ((temp (gensym)))
                (if init (%bind temp expr)
                    (progn (%bind temp nil) (push (list 'setq temp expr) %body)))
                (%typed-pattern (car pattern) (list 'car temp) init (if (consp type) (car type) type))
                (%typed-pattern (cdr pattern) (list 'cdr temp) init (if (consp type) (cdr type) type))))
             (t (error 'program-error))))
     (defun %last-cell (items)
       (%%while (consp (cdr items)) (setq items (cdr items)))
       items)
     (defun %default-value (type)
       (if (consp type) (%default-value (car type))
       (cond ((or (%word type "FLOAT") (%word type "SHORT-FLOAT") (%word type "SINGLE-FLOAT")) 0.0)
             ((or (%word type "DOUBLE-FLOAT") (%word type "LONG-FLOAT")) 0d0)
             ((or (%word type "INTEGER") (%word type "FIXNUM") (%word type "NUMBER")
                  (%word type "REAL") (%word type "RATIONAL")) 0)
             (t nil))))
     (defun %default-pattern (pattern type)
       (if (consp pattern)
           (list 'cons (%default-pattern (car pattern) (if (consp type) (car type) type))
                       (%default-pattern (cdr pattern) (if (consp type) (cdr type) type)))
           (if pattern (%default-value type) nil)))
     (defun %binding-names (bindings)
       (if bindings (cons (car (car bindings)) (%binding-names (cdr bindings))) nil))
     (defun %self-bindings (names)
       (if names (cons (list (car names) (car names)) (%self-bindings (cdr names))) nil))
     (defun %unpack-bindings (names pack)
       (if names
           (cons (list (car names) (list 'car pack))
                 (%unpack-bindings (cdr names) (list 'cdr pack))) nil))
     (defun %unpack-setq (names pack)
       (if names
           (cons (car names) (cons (list 'car pack)
                 (%unpack-setq (cdr names) (list 'cdr pack)))) nil))
     (defun %with-driver ()
       (let ((var (%take)) (type nil))
         (if (%accept "OF-TYPE") (setq type (%take))
             (when (and %tokens (not (%peek "="))
                        (or (%peek "INTEGER") (%peek "FIXNUM") (%peek "FLOAT")
                            (%peek "SINGLE-FLOAT") (%peek "DOUBLE-FLOAT") (%peek "T")))
               (setq type (%take))))
         (let ((init (if (%accept "=") (%take) (%default-pattern var type))))
           (if var (%typed-pattern var init t type) (%bind (gensym) init)))))
     ;; WITH/AND initializes in parallel; FOR/AND initializes sequentially.
     ;; All next values in an AND group are computed before assignment.
     (defun %driver-group (parser)
       (let ((groups nil) (more t) (%parallel nil))
         ;; An AND group computes its next values in parallel. Probe the
         ;; first driver without retaining its generated bindings or forms.
         (when (eq parser '%driver)
           (let ((tokens %tokens) (variables %variables))
             (let ((%bindings nil) (%steps nil) (%body nil))
               (funcall parser)
               (setq %parallel (%peek "AND")))
             (setq %tokens tokens %variables variables)))
         (%%while more
           (let ((%bindings nil) (%steps nil))
             (funcall parser)
             (push (list (reverse %bindings) (reverse %steps)) groups))
           (setq more (%accept "AND")))
         (setq groups (reverse groups))
         (if (not (cdr groups))
             (progn
               (setq %bindings (append (reverse (car (car groups))) %bindings))
               (setq %steps (append (reverse (cadr (car groups))) %steps)))
             (let ((init-packs nil) (unpacked nil) (step-packs nil) (assignments nil))
               (%%while groups
                 (let* ((group (pop groups)) (bindings (car group))
                        (names (%binding-names bindings))
                        (pack (gensym)) (step-pack (gensym)))
                   (if (eq parser '%driver)
                       (setq init-packs (append (reverse bindings) init-packs))
                       (progn
                         (push (list pack (cons 'let* (cons bindings (list (cons 'list names))))) init-packs)
                         (setq unpacked (append unpacked (%unpack-bindings names pack)))))
                   (push (list step-pack (cons 'let (cons (%self-bindings names)
                               (append (cadr group) (list (cons 'list names)))))) step-packs)
                   (setq assignments (append assignments (%unpack-setq names step-pack)))))
               (setq %bindings (append (reverse (append (reverse init-packs) unpacked)) %bindings))
               (push (list 'let* (reverse step-packs) (cons 'setq assignments)) %steps)))))
     (defun %driver ()
       (let* ((var (%take)) (kind nil) (type nil))
         (when (%accept "OF-TYPE") (setq type (%take)))
         (when (and (not type)
                    (or (%peek "INTEGER") (%peek "FIXNUM") (%peek "FLOAT")
                        (%peek "SINGLE-FLOAT") (%peek "DOUBLE-FLOAT")
                        (%peek "NUMBER") (%peek "T")))
           (setq type (%take)))
         (setq kind (%take))
         (cond
           ((or (%word kind "IN") (%word kind "ON"))
            (let* ((seq (%bind (gensym) (%take)))
                   (by (if (%accept "BY") (%bind (gensym) (%take)) nil))
                   (expr (if (%word kind "IN") (list 'car seq) seq)))
              (%pattern var expr t)
              (push (%stop (if (%word kind "IN") (list 'endp seq)
                              (list 'not (list 'typep seq (list 'quote 'cons))))) %body)
              (%typed-pattern var expr nil type)
              (let ((step (list 'setq seq (if by (list 'funcall by seq) (list 'cdr seq)))))
                (if (%word kind "ON")
                    (let ((%body nil))
                      (%pattern var seq nil)
                      (push (cons 'progn (cons step (reverse %body))) %steps))
                    (push step %steps)))))
           ((%word kind "ACROSS")
            (let* ((seq (%bind (gensym) (%take)))
                   (index (%bind (gensym) 0))
                   (size (%bind (gensym) (list 'length seq))))
              (%pattern var nil t)
              (push (%stop (list '>= index size)) %body)
              (%typed-pattern var (list 'elt seq index) nil type)
              (push (list 'setq index (list '1+ index)) %steps)))
           ((%word kind "BEING") (%iterator-driver var type))
           ((%word kind "=")
            (let* ((init (%take)) (next (if (%accept "THEN") (%take) init)))
              (when type (setq init (list 'the type init) next (list 'the type next)))
              (if %parallel
                  (progn
                    (%pattern var init t)
                    ;; Destructuring uses fresh temporaries, once per step.
                    (let ((%body nil))
                      (%pattern var next nil)
                      (push (cons 'progn (reverse %body)) %steps)))
                  ;; Earlier sequential drivers must test termination before
                  ;; evaluating this assignment, including the first iteration.
                  (let ((first (%bind (gensym) t)))
                    (%pattern var nil t)
                    (%pattern var (list 'if first init next) nil)
                    (push (list 'setq first nil) %body)))))
           ((or (%word kind "FROM") (%word kind "UPFROM") (%word kind "DOWNFROM")
                (%word kind "TO") (%word kind "UPTO") (%word kind "BELOW")
                (%word kind "DOWNTO") (%word kind "ABOVE") (%word kind "BY"))
            (unless var (setq var (gensym)))
            (let ((start nil) (limit nil) (bound nil) (direction nil) (down nil) (by nil))
              ;; Evaluate subclauses once, in source order, before binding VAR.
              (%%while kind
                (cond
                  ((or (%word kind "FROM") (%word kind "UPFROM") (%word kind "DOWNFROM"))
                   (when start (error 'program-error))
                   (setq start (%bind (gensym) (list 'the (if type type 'number) (%take)))))
                  ((%word kind "BY")
                   (when by (error 'program-error))
                   (setq by (%bind (gensym) (list 'the '(real (0)) (%take)))))
                  (t
                   (when bound (error 'program-error))
                   (setq bound kind limit (%bind (gensym) (list 'the 'real (%take))))))
                (let ((next-direction
                        (cond ((or (%word kind "DOWNFROM") (%word kind "DOWNTO") (%word kind "ABOVE")) -1)
                              ((or (%word kind "UPFROM") (%word kind "UPTO") (%word kind "BELOW")) 1)
                              (t nil))))
                  (when next-direction
                    (when (and direction (/= direction next-direction)) (error 'program-error))
                    (setq direction next-direction)))
                (setq kind (if (or (%peek "FROM") (%peek "UPFROM") (%peek "DOWNFROM")
                                   (%peek "TO") (%peek "UPTO") (%peek "BELOW")
                                   (%peek "DOWNTO") (%peek "ABOVE") (%peek "BY")) (%take) nil)))
              (setq down (eql direction -1))
              (when (and down (not start)) (error 'program-error))
              (%bind var (if start start 0))
              (unless by (setq by 1))
              (when bound
                (push (%stop (list (cond ((%word bound "BELOW") '>=)
                                        ((%word bound "ABOVE") '<=)
                                        (down '<) (t '>)) var limit)) %body))
              (let ((next (list (if down '- '+) var by)))
                (push (if bound
                    (list '%%arithmetic-step var by limit
                      (+ (if down 1 0) (if (or (%word bound "BELOW") (%word bound "ABOVE")) 2 0)) type)
                    (list 'setq var (if type (list 'the type next) next))) %steps))))
           (t (error 'program-error)))))
     (defun %iterator-driver (var type)
       (unless (or (%accept "EACH") (%accept "THE")) (error 'program-error))
       (let* ((kind (%take))
              (keyp (or (%word kind "HASH-KEY") (%word kind "HASH-KEYS")))
              (hashp (or keyp (%word kind "HASH-VALUE") (%word kind "HASH-VALUES")))
              (allp (or (%word kind "SYMBOL") (%word kind "SYMBOLS")))
              (presentp (or (%word kind "PRESENT-SYMBOL") (%word kind "PRESENT-SYMBOLS")))
              (externalp (or (%word kind "EXTERNAL-SYMBOL") (%word kind "EXTERNAL-SYMBOLS")))
              (source (if (or (%accept "IN") (%accept "OF")) (%take)
                          (if hashp (error 'program-error) '*package*)))
              (next (gensym))
              (iterator (%bind (gensym)
                (list (if hashp 'with-hash-table-iterator 'with-package-iterator)
                  (append (list next source)
                    (if hashp nil
                      (cond (allp '(:internal :external :inherited))
                            (presentp '(:internal :external))
                            (externalp '(:external)) (t (error 'program-error)))))
                  (list 'function (list 'lambda nil (list next))))))
              (key (%bind (gensym) nil)) (value (%bind (gensym) nil)) (more (%bind (gensym) nil))
              (advance (list 'multiple-value-setq (list more key value) (list 'funcall iterator))))
         (%bind (gensym) advance)
         (%pattern var (if (and hashp (not keyp)) value key) t)
         (push (%stop (list 'not more)) %body)
         (%typed-pattern var (if (and hashp (not keyp)) value key) nil type)
         (when (%accept "USING")
           (let ((spec (%take)))
             (unless (and hashp (consp spec) (= (length spec) 2)
                          (%word (car spec) (if keyp "HASH-VALUE" "HASH-KEY")))
               (error 'program-error))
             (%pattern (cadr spec) (if keyp value key) t)
             (%pattern (cadr spec) (if keyp value key) nil)))
         (push advance %steps)))
     (defun %accumulator (var family)
       (let ((scan %accumulators) (found nil))
         (%%while scan
           (when (eq var (car (car scan))) (setq found (car scan)))
           (setq scan (cdr scan)))
         (when found
           (unless (string= family (cadr found)) (error 'program-error)))
         (unless found
           (setq found (list var family (%bind (gensym) nil)))
           (%bind var (if (string= family "NUMBER") 0 nil))
           (push found %accumulators))
         found))
     (defun %value (expr)
       (if (and %it (%word expr "IT")) %it expr))
     (defun %action ()
       (let ((kind (%take)) (expr nil))
         (cond
           ((or (%word kind "DO") (%word kind "DOING")) (%forms))
           ((%word kind "RETURN") (list 'return-from %name (%value (%take))))
           ((or (%word kind "WHILE") (%word kind "UNTIL"))
            (setq expr (%take))
            (%stop (if (%word kind "WHILE") (list 'not expr) expr)))
           ((or (%word kind "WHEN") (%word kind "UNLESS") (%word kind "IF"))
            (let* ((test (%take)) (%it (gensym))
                   (yes (list (%action))) (no nil))
              (%%while (%accept "AND") (let ((%it nil)) (push (%action) yes)))
              (when (%accept "ELSE")
                (push (%action) no)
                (%%while (%accept "AND") (let ((%it nil)) (push (%action) no))))
              (%accept "END")
              (list 'let (list (list %it test))
                    (list 'if (if (%word kind "UNLESS") (list 'not %it) %it)
                          (cons 'progn (reverse yes)) (cons 'progn (reverse no))))))
           ((or (%word kind "ALWAYS") (%word kind "NEVER") (%word kind "THEREIS"))
            (setq expr (%value (%take)))
            (let ((mode (if (%word kind "THEREIS") "THEREIS" "BOOLEAN")))
              (when (and %result-mode (not (string= mode %result-mode))) (error 'program-error))
              (setq %result-mode mode))
            (setq %result (if (%word kind "THEREIS") nil t))
            (let ((temp (gensym)))
              (list 'let (list (list temp expr))
                    (list 'if (cond ((%word kind "ALWAYS") (list 'not temp))
                                    (t temp))
                          (list 'return-from %name (if (%word kind "THEREIS") temp nil))))))
           ((or (%word kind "COLLECT") (%word kind "COLLECTING")
                (%word kind "APPEND") (%word kind "APPENDING")
                (%word kind "NCONC") (%word kind "NCONCING")
                (%word kind "SUM") (%word kind "SUMMING")
                (%word kind "COUNT") (%word kind "COUNTING")
                (%word kind "MINIMIZE") (%word kind "MINIMIZING")
                (%word kind "MAXIMIZE") (%word kind "MAXIMIZING"))
            (setq expr (%value (%take)))
            (let* ((named (%accept "INTO"))
                   (var (if named (%take) '%implicit))
                   (collect (or (%word kind "COLLECT") (%word kind "COLLECTING")))
                   (appendp (or (%word kind "APPEND") (%word kind "APPENDING")))
                   (listp (or collect appendp (%word kind "NCONC") (%word kind "NCONCING")))
                   (countp (or (%word kind "COUNT") (%word kind "COUNTING")))
                   (minp (or (%word kind "MINIMIZE") (%word kind "MINIMIZING")))
                   (maxp (or (%word kind "MAXIMIZE") (%word kind "MAXIMIZING")))
                   (family (cond (listp "LIST") ((or minp maxp) "MINMAX") (t "NUMBER")))
                   (record (%accumulator var family)) (temp (gensym)) (acc-type nil))
              (when (or (%accept "OF-TYPE") (%peek "FIXNUM") (%peek "INTEGER")
                        (%peek "FLOAT") (%peek "SHORT-FLOAT") (%peek "SINGLE-FLOAT")
                        (%peek "DOUBLE-FLOAT") (%peek "LONG-FLOAT"))
                (setq acc-type (%take)))
              (when (and acc-type (string= family "NUMBER"))
                (rplaca (cdr (assoc var %bindings)) (or (%default-value acc-type) 0)))
              (unless named
                (when (and %result-mode (not (string= family %result-mode))) (error 'program-error))
                (setq %result-mode family)
                (setq %result var))
              (cond
                (listp
                 (let ((tail (caddr record)))
                   (list 'let (list (list temp (cond (collect (list 'list expr))
                                                    (appendp (list 'copy-list expr)) (t expr))))
                         (list 'if temp
                               (list 'progn
                                     (list 'if var (list 'rplacd tail temp) (list 'setq var temp))
                                     (list 'setq tail (list '%last-cell temp)))))))
                ((or minp maxp)
                 (list 'let (list (list temp expr))
                       (list 'if (list 'or (list 'not var) (list (if minp '< '>) temp var))
                             (list 'setq var (if acc-type (list 'the acc-type temp) temp)))))
                (countp (list 'if expr (list 'setq var
                          (if acc-type (list 'the acc-type (list '1+ var)) (list '1+ var)))))
                (t (list 'setq var (if acc-type (list 'the acc-type (list '+ var expr)) (list '+ var expr)))))))
           (t (error 'program-error)))))
     (defun %expand-loop (tokens)
       (let ((%tokens tokens) (%bindings nil) (%steps nil) (%initial nil)
             (%final nil) (%body nil) (%accumulators nil) (%result nil) (%result-mode nil)
             (%name nil) (%it nil) (%variables nil) (*gensym-counter* 0))
         (if (or (not tokens) (typep (car tokens) 'cons))
             (list 'block nil (cons '%%while (cons t tokens)))
             (progn
               (when (%accept "NAMED") (setq %name (%take)))
               (%%while %tokens
                 (cond
                   ((or (%accept "FOR") (%accept "AS")) (%driver-group '%driver))
                   ((%accept "WITH")
                    (%driver-group '%with-driver))
                   ((%accept "REPEAT")
                    (let* ((value (gensym))
                           (n (%bind (gensym)
                              (list 'let (list (list value (%take)))
                                (list 'the 'integer (list 'if (list 'plusp value) value 0))))))
                      (push (%stop (list '<= n 0)) %body)
                      (push (list 'setq n (list '1- n)) %steps)))
                   ((%accept "INITIALLY") (push (%forms) %initial))
                   ((%accept "FINALLY") (push (%forms) %final))
                   (t (push (%action) %body))))
               (let ((scan %accumulators))
                 (%%while scan
                   (let* ((record (car scan)) (var (car record)) (family (cadr record)))
                     (when (string= family "MINMAX")
                       (setq %final (append %final (list (list 'if (list 'not var) (list 'setq var 0)))))))
                   (setq scan (cdr scan))))
               (list 'block %name
                     (cons 'let* (cons (reverse %bindings)
                       (append (reverse %initial)
                         (list (list 'block '%finish
                           (cons '%%while (cons t (append (reverse %body) (reverse %steps))))))
                         (reverse %final) (list %result))))))))))))

(defparameter *loop-library-symbols*
  (stable-sort (append '(%%list-test %%list-accumulate %%case-form %%numeric-collect %%parallel-place-form %%arithmetic-step)
                      (runtime-library-symbols *loop-library*)) #'string< :key #'symbol-name))

(defun loop-library-reference (symbol)
  `(array.get $objects (global.get $loop-library-symbols)
              (i32.const ,(position symbol *loop-library-symbols*))))

(defun loop-library-bytes ()
  (runtime-library-bytes *loop-library* *loop-library-symbols* 25))

(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $initialize-loop () ()
  (:locals ($names (ref $bootstrap-bytes)))
  #@(local.set $names (array.new_data $bootstrap-bytes $loop-name-data
    (i32.const 0) (i32.const ,(length (bootstrap-private-symbol-bytes *loop-library-symbols*)))))
  #@(data.drop $loop-name-data)
  #@(global.set $loop-library-symbols (call $bootstrap-private-symbols
    (local.get $names) (i32.const ,(length *loop-library-symbols*))))
  #@(global.set $cursor (i32.const 0))
  #@(global.set $limit (i32.const ,(length (loop-library-bytes))))
  #@(call $reserve (global.get $limit))
  #@(memory.init $loop-library-data (i32.const 0) (i32.const 0) (global.get $limit))
  #@(data.drop $loop-library-data)
  #@(block $done (loop $next
    (br_if $done (i32.ge_u (global.get $cursor) (global.get $limit)))
    (drop (call $eval (call $read-library-literal) (ref.null $obj))) (br $next)))
  #@(call $clear-values))

(define-runtime-function $loop-word-p (($word :nullable-object) ($text :nullable-object)) (i32)
  #@(if (i32.eqz (call $symbolp (local.get $word))) (then (return (i32.const 0))))
  #@(call $string-equal (call $symbol-name (local.get $word)) (local.get $text)))

;; Bound both retention and snapshot recursion. The expansion depends on the
;; source syntax, while lexical bindings are resolved each time it is evaluated.
(define-runtime-function $loop-source-copy (($source :nullable-object) ($budget i32)) (:nullable-object i32)
  (:locals ($a :nullable-object) ($b :nullable-object))
  #@(if (i32.ne (call $tag (local.get $source)) (i32.const 7))
    (then (return (local.get $source) (local.get $budget))))
  #@(if (i32.eqz (local.get $budget)) (then (return (ref.null $obj) (i32.const -1))))
  #@(call $loop-source-copy (call $car (local.get $source)) (i32.sub (local.get $budget) (i32.const 1)))
  #@(local.set $budget) #@(local.set $a)
  #@(if (i32.lt_s (local.get $budget) (i32.const 0)) (then (return (ref.null $obj) (local.get $budget))))
  #@(call $loop-source-copy (call $cdr (local.get $source)) (local.get $budget))
  #@(local.set $budget) #@(local.set $b)
  #@(if (i32.lt_s (local.get $budget) (i32.const 0)) (then (return (ref.null $obj) (local.get $budget))))
  #@(call $cons (local.get $a) (local.get $b)) #@(local.get $budget))

(define-runtime-function $loop-source-equal (($a :nullable-object) ($b :nullable-object)) (i32)
  #@(loop $tail
    (if (ref.eq (local.get $a) (local.get $b)) (then (return (i32.const 1))))
    (if (i32.or (i32.ne (call $tag (local.get $a)) (i32.const 7)) (i32.ne (call $tag (local.get $b)) (i32.const 7)))
      (then (return (i32.const 0))))
    (if (i32.eqz (call $loop-source-equal (call $car (local.get $a)) (call $car (local.get $b))))
      (then (return (i32.const 0))))
    (local.set $a (call $cdr (local.get $a))) (local.set $b (call $cdr (local.get $b))) (br $tail))
  #@(unreachable))

(define-runtime-function $cached-loop-expansion (($args :nullable-object)) (:nullable-object)
  (:locals ($i i32) ($budget i32) ($entry :nullable-object) ($snapshot :nullable-object) ($expanded :nullable-object))
  #@(block $miss (loop $find (br_if $miss (i32.eq (local.get $i) (i32.const 32)))
    (local.set $entry (array.get $objects (global.get $loop-expansions) (local.get $i)))
    (if (i32.eqz (ref.is_null (local.get $entry)))
      (then (if (ref.eq (struct.get $obj $a (local.get $entry)) (local.get $args))
        (then
          (if (call $loop-source-equal (local.get $args) (struct.get $obj $b (local.get $entry)))
            (then (return (struct.get $obj $c (local.get $entry)))))
          (br $miss)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $find)))
  #@(call $loop-source-copy (local.get $args) (i32.const 256))
  #@(local.set $budget) #@(local.set $snapshot)
  #@(local.set $expanded (call $apply ,(loop-library-reference '%expand-loop)
    (call $cons (local.get $args) (ref.null $obj))))
  #@(if (i32.ge_s (local.get $budget) (i32.const 0))
    (then
      (if (i32.eq (local.get $i) (i32.const 32))
        (then (local.set $i (global.get $loop-expansion-slot))
