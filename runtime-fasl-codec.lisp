;;;; Binary codecs operate on FASL descriptions, not application objects.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $fasl-byte (($value i32)) ()
  #@(call $reserve (i32.const 1))
  #@(i32.store8 (global.get $cursor) (local.get $value))
  #@(global.set $cursor (i32.add (global.get $cursor) (i32.const 1))))

(define-runtime-function $fasl-uleb (($value i32)) ()
  #@(loop $next
    (call $fasl-byte (i32.or (i32.and (local.get $value) (i32.const 127))
      (select (i32.const 128) (i32.const 0) (i32.gt_u (local.get $value) (i32.const 127)))))
    (local.set $value (i32.shr_u (local.get $value) (i32.const 7)))
    (br_if $next (local.get $value))))

(define-runtime-function $fasl-uleb-size (($value i32)) (i32)
  (:locals ($size i32))
  #@(local.set $size (i32.const 1))
  #@(block $done (loop $next (br_if $done (i32.le_u (local.get $value) (i32.const 127)))
    (local.set $value (i32.shr_u (local.get $value) (i32.const 7)))
    (local.set $size (i32.add (local.get $size) (i32.const 1))) (br $next)))
  #@(local.get $size))

(define-runtime-function $fasl-text-bytes (($text :nullable-object) ($skip i32)) ()
  (:locals ($chars :digits) ($start i32) ($size i32) ($width i32) ($i i32))
  #@(local.set $chars (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $text)))))
  #@(local.set $start (global.get $cursor))
  #@(call $reserve (i32.const 5))
  #@(global.set $cursor (i32.add (global.get $cursor) (i32.const 5)))
  #@(local.set $i (local.get $skip))
  #@(block $done (loop $text (br_if $done (i32.eq (local.get $i) (array.len (local.get $chars))))
    (call $emit-char (array.get $digits (local.get $chars) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $text)))
  #@(local.set $size (i32.sub (global.get $cursor) (i32.add (local.get $start) (i32.const 5))))
  #@(local.set $width (call $fasl-uleb-size (local.get $size)))
  #@(memory.copy (i32.add (local.get $start) (local.get $width)) (i32.add (local.get $start) (i32.const 5)) (local.get $size))
  #@(global.set $cursor (i32.sub (global.get $cursor) (i32.sub (i32.const 5) (local.get $width))))
  #@(local.set $i (i32.const 0))
  #@(loop $patch
    (i32.store8 (i32.add (local.get $start) (local.get $i))
      (i32.or (i32.and (local.get $size) (i32.const 127))
        (select (i32.const 128) (i32.const 0) (i32.lt_u (i32.add (local.get $i) (i32.const 1)) (local.get $width)))))
    (local.set $size (i32.shr_u (local.get $size) (i32.const 7)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $patch (i32.lt_u (local.get $i) (local.get $width)))))

(define-runtime-function $fasl-encode-value
    (($value :nullable-object) ($strings :nullable-object) ($depth i32)) ()
  (:locals ($tag i32) ($n i32) ($i i32) ($index i32) ($prefix i32) ($prefix-bytes i32) ($c i32)
           ($table :nullable-object) ($last :nullable-object) ($chars :digits) ($previous :digits)
           ($cell :nullable-object) ($data (ref $objects)) ($bytes i32) ($latin1 i32)
           ($use-prefix i32) ($prefix-start i32))
  (wat-fail-when #@(i32.gt_u (local.get $depth) (i32.const 64)) :reader-syntax)
  #@(if (ref.is_null (local.get $value)) (then (call $fasl-byte (i32.const 0)) (return)))
  #@(if (ref.eq (local.get $value) (call $symbol (i32.const 1)))
    (then (call $fasl-byte (i32.const 6)) (return)))
  #@(local.set $tag (call $tag (local.get $value)))
  #@(if (i32.eq (local.get $tag) (i32.const 1))
    (then
      ,(wat-fail-when #@(i32.gt_u (call $bitlength (ref.as_non_null (local.get $value)))
        (i32.const 31)) :reader-syntax)
      (local.set $n (call $natural-count (call $iabs (ref.as_non_null (local.get $value)))))
      (call $fasl-byte (select (i32.const 2) (i32.const 1)
        (i32.lt_s (call $value-n (local.get $value)) (i32.const 0))))
      (call $fasl-uleb (local.get $n)) (return)))
  #@(if (i32.eq (local.get $tag) (i32.const 10))
    (then
      (local.set $table (call $car (local.get $strings)))
      (local.set $cell (call $hash-cell-native (local.get $value) (local.get $table)))
      (if (i32.eqz (ref.is_null (local.get $cell)))
        (then (call $fasl-byte (i32.const 4))
          (call $fasl-uleb (call $natural-count (call $cdr (local.get $cell)))) (return)))
      (local.set $index (call $value-n (local.get $table)))
      (drop (call $puthash-native (local.get $value) (local.get $table) (call $int (local.get $index))))
      (local.set $last (call $cdr (local.get $strings)))
      (local.set $chars (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $value)))))
      (if (i32.eqz (ref.is_null (local.get $last)))
        (then
          (local.set $previous (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $last)))))
          (block $prefix-done (loop $prefix-next
            (br_if $prefix-done (i32.or (i32.eq (local.get $prefix) (array.len (local.get $chars)))
              (i32.eq (local.get $prefix) (array.len (local.get $previous)))))
            (local.set $c (array.get $digits (local.get $chars) (local.get $prefix)))
            (br_if $prefix-done (i32.ne (local.get $c) (array.get $digits (local.get $previous) (local.get $prefix))))
            (local.set $prefix-bytes (i32.add (local.get $prefix-bytes)
              (if (result i32) (i32.lt_u (local.get $c) (i32.const 128)) (then (i32.const 1))
                (else (if (result i32) (i32.lt_u (local.get $c) (i32.const 2048)) (then (i32.const 2))
                  (else (select (i32.const 3) (i32.const 4) (i32.lt_u (local.get $c) (i32.const 65536)))))))))
            (local.set $prefix (i32.add (local.get $prefix) (i32.const 1))) (br $prefix-next)))))
      (local.set $use-prefix (i32.gt_u (local.get $prefix-bytes)
        (i32.add (call $fasl-uleb-size (i32.sub (local.get $index) (i32.const 1))) (call $fasl-uleb-size (local.get $prefix)))))
      (block $string-done
        (block $raw
          (if (local.get $use-prefix)
            (then
              (local.set $prefix-start (global.get $cursor))
              (call $fasl-byte (i32.const 9))
              (call $fasl-uleb (i32.sub (local.get $index) (i32.const 1))) (call $fasl-uleb (local.get $prefix))
              (call $fasl-text-bytes (local.get $value) (local.get $prefix))
              ;; The character count is a lower bound on raw byte length.
              ;; ASCII strings cannot pass this gate, avoiding a second scan.
              (br_if $string-done (i32.gt_u
                (i32.add (i32.const 1) (i32.add (call $fasl-uleb-size (array.len (local.get $chars))) (array.len (local.get $chars))))
                (i32.sub (global.get $cursor) (local.get $prefix-start)))))
            (else (local.set $prefix (i32.const 0))))
          (local.set $latin1 (i32.const 1))
          (block $scan-done (loop $scan
            (br_if $scan-done (i32.eq (local.get $i) (array.len (local.get $chars))))
            (local.set $c (array.get $digits (local.get $chars) (local.get $i)))
            (if (i32.gt_u (local.get $c) (i32.const 255))
              (then (local.set $latin1 (i32.const 0)) (br $scan-done)))
            (local.set $bytes (i32.or (local.get $bytes) (local.get $c)))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $scan)))
          (if (i32.and (local.get $latin1) (i32.ge_u (local.get $bytes) (i32.const 128)))
            (then
              (if (local.get $use-prefix) (then (global.set $cursor (local.get $prefix-start))))
              (br $raw)))
          (br_if $string-done (local.get $use-prefix))
          (call $fasl-byte (i32.const 3))
          (call $fasl-text-bytes (local.get $value) (i32.const 0))
          (br $string-done))
        (call $fasl-byte (i32.const 11)) (call $fasl-uleb (array.len (local.get $chars)))
        (call $reserve (array.len (local.get $chars)))
        (local.set $i (i32.const 0))
        (block $copy-done (loop $copy
          (br_if $copy-done (i32.eq (local.get $i) (array.len (local.get $chars))))
          (i32.store8 (i32.add (global.get $cursor) (local.get $i))
            (array.get $digits (local.get $chars) (local.get $i)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
        (global.set $cursor (i32.add (global.get $cursor) (array.len (local.get $chars)))))
      (struct.set $obj $b (ref.cast (ref $obj) (local.get $strings)) (local.get $value))
      (return)))
  #@(if (call $keywordp (local.get $value))
    (then (call $fasl-byte (i32.const 5))
      (call $fasl-encode-value (call $symbol-name (local.get $value))
        (local.get $strings) (i32.add (local.get $depth) (i32.const 1))) (return)))
  #@(if (i32.eq (local.get $tag) (i32.const 7))
    (then
      (local.set $cell (call $list-length-native (local.get $value)))
      ,(wat-fail-when #@(ref.is_null (local.get $cell)) :reader-syntax)
      (call $fasl-byte (i32.const 7)) (call $fasl-uleb (call $natural-count (local.get $cell)))
      (loop $items
        (call $fasl-encode-value (call $car (local.get $value))
          (local.get $strings) (i32.add (local.get $depth) (i32.const 1)))
        (local.set $value (call $cdr (local.get $value)))
        (br_if $items (i32.eqz (ref.is_null (local.get $value))))) (return)))
  (wat-fail-when #@(i32.ne (local.get $tag) (i32.const 34)) :reader-syntax)
  #@(local.set $data (call $vector-data (local.get $value)))
  #@(call $fasl-byte (i32.const 8))
  #@(call $fasl-uleb (array.len (local.get $data)))
  #@(block $done (loop $items (br_if $done (i32.eq (local.get $i) (array.len (local.get $data))))
    (call $fasl-encode-value (array.get $objects (local.get $data) (local.get $i))
      (local.get $strings) (i32.add (local.get $depth) (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $items))))

(define-runtime-function $fasl-compact-cons-p (($record :nullable-object)) (i32)
  (:locals ($tail :nullable-object))
  #@(if (i32.ne (call $natural-count (call $car (local.get $record))) (i32.const 5)) (then (return (i32.const 0))))
  #@(if (i32.ne (call $natural-count (call $list-length-native (local.get $record))) (i32.const 4)) (then (return (i32.const 0))))
  #@(local.set $tail (call $cdr (local.get $record)))
  #@(i32.and (i32.le_u (call $natural-count (call $car (local.get $tail))) (i32.const 1073741823))
    (i32.and (i32.le_u (call $natural-count (call $car (call $cdr (local.get $tail)))) (i32.const 1073741823))
      (i32.le_u (call $natural-count (call $car (call $cdr (call $cdr (local.get $tail)))) ) (i32.const 2)))))

(define-runtime-function $fasl-write-edge (($child i32) ($id i32)) ()
  (:locals ($encoded i32) ($delta i32) ($relative i32))
  #@(local.set $encoded (i32.shl (local.get $child) (i32.const 1)))
  #@(local.set $delta (i32.sub (local.get $child) (local.get $id)))
  #@(if (i32.le_u (i32.add (local.get $delta) (i32.const 536870911)) (i32.const 1073741822))
    (then
      (local.set $relative (i32.or (i32.const 1) (i32.shl
        (i32.xor (i32.shl (local.get $delta) (i32.const 1)) (i32.shr_s (local.get $delta) (i32.const 31))) (i32.const 1))))
      (if (i32.lt_u (local.get $relative) (local.get $encoded)) (then (local.set $encoded (local.get $relative))))))
  #@(call $fasl-uleb (local.get $encoded)))

(define-runtime-function $fasl-encode-records
    (($value :nullable-object) ($base i32) ($strings :nullable-object)) ()
  (:locals ($records (ref $objects)) ($i i32) ($id i32) ($kind i32) ($flags i32)
           ($left i32) ($right i32) ($run i32) ($scan i32) ($end i32) ($packed i32) ($bitmap i32) ($delta i32)
           ($domain i32) ($namespace i32) ($previous-namespace i32) ($package :nullable-object) ($previous-package :nullable-object)
           ($record :nullable-object) ($tail :nullable-object) ($candidate :nullable-object) ($last :nullable-object))
  #@(local.set $records (call $vector-data (local.get $value)))
  #@(call $fasl-byte (i32.const 10))
  #@(call $fasl-uleb (local.get $base))
  #@(call $fasl-uleb (array.len (local.get $records)))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (array.len (local.get $records))))
    (local.set $id (i32.add (local.get $base) (local.get $i)))
    (local.set $record (array.get $objects (local.get $records) (local.get $i)))
    (local.set $kind (call $natural-count (call $car (local.get $record))))
    (local.set $tail (call $cdr (local.get $record)))
    (local.set $run (i32.const 1))
    (block $encoded
      (if (i32.eqz (local.get $kind)) (then (call $fasl-byte (i32.const 1)) (br $encoded)))
      (if (i32.eq (local.get $kind) (i32.const 11))
        (then
          (call $fasl-byte (i32.const 13))
          (call $fasl-uleb (call $natural-count (call $car (local.get $tail))))
          (call $fasl-uleb (call $natural-count (call $car (call $cdr (local.get $tail)))))
          (local.set $tail (call $car (call $cdr (call $cdr (local.get $tail)))))
          (local.set $last (call $list-length-native (local.get $tail)))
          ,(wat-fail-when #@(ref.is_null (local.get $last)) :reader-syntax)
          (call $fasl-uleb (call $natural-count (local.get $last)))
          (block $slots-done (loop $slots
            (br_if $slots-done (ref.is_null (local.get $tail)))
            (local.set $candidate (call $car (local.get $tail)))
            (if (call $object-equal (local.get $candidate) (call $int (i32.const -1)))
              (then (call $fasl-uleb (i32.const 0)))
              (else
                (local.set $left (call $natural-count (local.get $candidate)))
                ,(wat-fail-when #@(i32.gt_u (local.get $left) (i32.const 2147483646)) :reader-syntax)
                (call $fasl-uleb (i32.add (local.get $left) (i32.const 1)))))
            (local.set $tail (call $cdr (local.get $tail))) (br $slots)))
          (br $encoded)))
      (if (i32.or (i32.eq (local.get $kind) (i32.const 1)) (i32.eq (local.get $kind) (i32.const 3)))
        (then (call $fasl-byte (i32.add (local.get $kind) (i32.const 1)))
          (call $fasl-encode-value (call $car (local.get $tail)) (local.get $strings) (i32.const 1)) (br $encoded)))
      (if (i32.eq (local.get $kind) (i32.const 2))
        (then (call $fasl-byte (i32.const 3))
          (call $fasl-uleb (call $natural-count (call $car (local.get $tail)))) (br $encoded)))
      (if (i32.eq (local.get $kind) (i32.const 4))
        (then
          (local.set $package (call $car (call $cdr (local.get $tail))))
          (local.set $namespace (call $natural-count (call $car (call $cdr (call $cdr (local.get $tail))))))
          (if (i32.and (local.get $domain) (i32.and (i32.eq (local.get $namespace) (local.get $previous-namespace))
            (call $object-equal (local.get $package) (local.get $previous-package))))
            (then (call $fasl-byte (i32.const 12))
              (call $fasl-encode-value (call $car (local.get $tail)) (local.get $strings) (i32.const 1)))
            (else (call $fasl-byte (i32.const 5))
              (call $fasl-encode-value (call $car (local.get $tail)) (local.get $strings) (i32.const 1))
              (call $fasl-encode-value (local.get $package) (local.get $strings) (i32.const 1))
              (call $fasl-uleb (local.get $namespace))))
          (local.set $domain (i32.const 1))
          (local.set $previous-package (local.get $package))
          (local.set $previous-namespace (local.get $namespace))
          (br $encoded)))
      (if (call $fasl-compact-cons-p (local.get $record))
        (then
          (local.set $flags (call $natural-count (call $car (call $cdr (call $cdr (local.get $tail))))))
          (local.set $last (local.get $record))
          (block $spine (loop $extend
            (local.set $scan (i32.add (local.get $i) (local.get $run)))
            (br_if $spine (i32.eq (local.get $scan) (array.len (local.get $records))))
            (br_if $spine (i32.ne (call $natural-count (call $car (call $cdr (call $cdr (local.get $last)))))
              (i32.add (local.get $base) (local.get $scan))))
            (local.set $candidate (array.get $objects (local.get $records) (local.get $scan)))
            (br_if $spine (i32.eqz (call $fasl-compact-cons-p (local.get $candidate))))
            (br_if $spine (call $natural-count (call $car (call $cdr (call $cdr (call $cdr (local.get $candidate)))))))
            (local.set $last (local.get $candidate))
            (local.set $run (i32.add (local.get $run) (i32.const 1))) (br $extend)))
          (local.set $right (call $natural-count (call $car (call $cdr (call $cdr (local.get $last))))))
          (local.set $packed (i32.and (i32.le_u (local.get $run) (i32.const 5)) (i32.eqz (local.get $right))))
          (local.set $bitmap (i32.const 0))
          (local.set $end (i32.add (local.get $i) (local.get $run)))
          (if (local.get $packed)
            (then
              (local.set $scan (local.get $i))
              (loop $modes
                (local.set $left (call $natural-count (call $car (call $cdr
                  (array.get $objects (local.get $records) (local.get $scan))))))
                (local.set $delta (i32.sub (local.get $left) (i32.add (local.get $base) (local.get $scan))))
                (local.set $delta (i32.xor (i32.shl (local.get $delta) (i32.const 1)) (i32.shr_s (local.get $delta) (i32.const 31))))
                (if (i32.lt_u (local.get $delta) (local.get $left))
                  (then (local.set $bitmap (i32.or (local.get $bitmap)
                    (i32.shl (i32.const 1) (i32.sub (local.get $scan) (local.get $i)))))))
                (local.set $scan (i32.add (local.get $scan) (i32.const 1))) (br_if $modes (i32.lt_u (local.get $scan) (local.get $end))))
              (call $fasl-byte (i32.add (i32.add (i32.const 10)
                (i32.mul (i32.add (i32.const 3) (local.get $flags)) (i32.shl (i32.const 1) (local.get $run)))) (local.get $bitmap))))
            (else
              (if (i32.and (i32.eqz (local.get $right)) (i32.le_u (local.get $run) (i32.const 16)))
                (then (call $fasl-byte (i32.add (i32.add (i32.const 196) (i32.mul (local.get $flags) (i32.const 11))) (local.get $run))))
                (else (call $fasl-byte (i32.add (select (i32.const 9) (i32.const 6) (i32.eqz (local.get $right))) (local.get $flags)))
                  (call $fasl-uleb (local.get $run))))))
          (local.set $scan (local.get $i))
          (local.set $end (i32.add (local.get $i) (local.get $run)))
          (loop $cars
            (local.set $candidate (array.get $objects (local.get $records) (local.get $scan)))
            (local.set $left (call $natural-count (call $car (call $cdr (local.get $candidate)))))
            (if (local.get $packed)
              (then
                (local.set $delta (i32.sub (local.get $left) (i32.add (local.get $base) (local.get $scan))))
                (local.set $delta (i32.xor (i32.shl (local.get $delta) (i32.const 1)) (i32.shr_s (local.get $delta) (i32.const 31))))
                (call $fasl-uleb (select (local.get $delta) (local.get $left) (i32.lt_u (local.get $delta) (local.get $left)))))
              (else (call $fasl-write-edge (local.get $left) (i32.add (local.get $base) (local.get $scan)))))
            (local.set $scan (i32.add (local.get $scan) (i32.const 1)))
            (br_if $cars (i32.lt_u (local.get $scan) (local.get $end))))
          (if (local.get $right)
            (then (call $fasl-write-edge (local.get $right)
              (i32.sub (i32.add (local.get $base) (local.get $end)) (i32.const 1)))))
          (br $encoded)))
      (call $fasl-byte (i32.const 0))
      (call $fasl-encode-value (local.get $record) (local.get $strings) (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (local.get $run))) (br $next))))

(define-runtime-function $fasl-encode (($value :nullable-object) ($base :nullable-object)) (:nullable-object)
  (:locals ($start i32) ($size i32) ($i i32) ($bytes (ref $objects)) ($strings :nullable-object))
  #@(local.set $start (global.get $cursor))
  #@(local.set $strings (call $cons (call $make-hash-table-object (call $symbol (i32.const ,(runtime-symbol-id 'equal)))
    (ref.null eq) (ref.null eq) (ref.null eq)) (ref.null eq)))
  #@(if (ref.is_null (local.get $base))
    (then (call $fasl-encode-value (local.get $value) (local.get $strings) (i32.const 0)))
    (else (call $fasl-encode-records (local.get $value) (call $natural-count (local.get $base)) (local.get $strings))))
  #@(local.set $size (i32.sub (global.get $cursor) (local.get $start)))
  #@(local.set $bytes (array.new_default $objects (local.get $size)))
  #@(block $done (loop $copy (br_if $done (i32.eq (local.get $i) (local.get $size)))
