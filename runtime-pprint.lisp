  #@(local.set $original (call $car (call $cdr (call $cdr (local.get $state)))))
  #@(if (i32.and (i32.eqz (ref.is_null (local.get $original)))
        (i32.and (i32.eqz (ref.is_null (local.get $args))) (i32.ne (call $tag (local.get $args)) (i32.const 7))))
    (then (local.set $stop (i32.const 1))))
  #@(if (i32.and (i32.eqz (local.get $stop))
        (ref.is_null (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*print-readably*))))))
    (then (local.set $limit (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*print-length*)))))
      (if (i32.eqz (ref.is_null (local.get $limit)))
        (then (if (i32.ge_s (call $compare (ref.as_non_null (local.get $count)) (ref.as_non_null (local.get $limit))) (i32.const 0))
          (then (local.set $stop (i32.const 2))))))))
