  #@(if (local.get $stop)
    (then (if (local.get $flush) (then (call $format-flush)))
      (if (i32.eq (local.get $stop) (i32.const 2))
        (then (call $write-destination (local.get $stream) ,(wat-text-literal "...")))
        (else (call $write-destination (local.get $stream) ,(wat-text-literal ". "))
          (drop (call $write-object-native (local.get $args) (local.get $stream) (i32.const 0)))))
      (return (ref.null eq) (ref.null eq) (i32.const 1))))
