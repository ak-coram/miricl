(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $require-pprint-table (($table :nullable-object)) (:object)
  #@(if (i32.ne (call $tag (local.get $table)) (i32.const 38))
    (then (call $type-fail (local.get $table)
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'satisfies)))
        (call $cons ,(clos-library-reference '%pprint-table-p) (ref.null eq)))
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(ref.as_non_null (local.get $table)))

(define-runtime-function $pprint-initial-table () (:object)
  (wat-new-object :pprint-table :a
    #@(call $cons (call $node (i32.const 13) (i32.const 1)
      (call $symbol (i32.const ,(runtime-symbol-id 'cons)))
      (call $fdefinition ,(clos-library-reference '%pprint-default)) (ref.null eq)) (ref.null eq))))

(define-runtime-function $pprint-entry (($object :nullable-object) ($table :nullable-object)) (:nullable-object)
  (:locals ($scan :nullable-object) ($entry :nullable-object) ($best :nullable-object) ($better i32))
  #@(local.set $scan (struct.get $obj $a (ref.cast (ref $obj) (call $require-pprint-table (local.get $table)))))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $entry (call $car (local.get $scan)))
    (if (call $typep (local.get $object) (struct.get $obj $a (ref.cast (ref $obj) (local.get $entry))))
      (then
        (local.set $better (ref.is_null (local.get $best)))
        (if (i32.eqz (local.get $better))
          (then
            (if (i32.ne (call $value-n (local.get $entry)) (call $value-n (local.get $best)))
              (then (local.set $better (i32.eqz (call $value-n (local.get $entry)))))
              (else (if (i32.eqz (call $value-n (local.get $entry)))
                (then (local.set $better (i32.gt_s (call $compare (struct.get $obj $c (ref.cast (ref $obj) (local.get $entry)))
                  (struct.get $obj $c (ref.cast (ref $obj) (local.get $best)))) (i32.const 0)))))))))
        (if (local.get $better) (then (local.set $best (local.get $entry))))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(local.get $best))

