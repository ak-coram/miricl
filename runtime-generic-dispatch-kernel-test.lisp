;;;; Explicit checked target service model; no host CLOS representation contract.
(in-package #:miricl-test)
(in-suite :miricl)
(defvar *generic-dispatch-test-permitted* nil)
(defvar *generic-dispatch-test-version* 3)
(defvar *generic-dispatch-test-fallback* nil)
(defvar *generic-dispatch-test-calls* nil)
(defun generic-dispatch-test-metadata (selector object extra)
  (declare (ignore extra))
  (case selector
    (0 (or (miricl-runtime:list-length-or-cycle object)
           (error 'type-error :datum object :expected-type 'list)))
    (1 (unless (typep object '(simple-vector 1))
         (error 'type-error :datum object :expected-type '(simple-vector 1))) (svref object 0))
    (2 (svref object 0))
    (3 *generic-dispatch-test-permitted*)
    (4 (svref object 1))
    (5 *generic-dispatch-test-version*)
    (6 (push object *generic-dispatch-test-calls*) *generic-dispatch-test-fallback*)
    (7 (unless (typep object '(simple-vector 7))
         (error 'type-error :datum object :expected-type '(simple-vector 7)))
       (let ((mode (svref object 6)))
         (unless (and (typep mode '(integer 0 8191)) (<= (logand mode 7) 4)
                      (= (logand (ash mode -8) 15)
                         (logand (ash mode -8) (logand (ash mode -4) 15))))
           (error 'type-error :datum mode :expected-type '(integer 0 8191)))))
    (9 (unless (typep object '(integer 0 4))
         (error 'type-error :datum object :expected-type '(integer 0 4))))
    (10 (unless (consp object) (error 'type-error :datum object :expected-type 'cons)))
    (otherwise (error 'program-error))))

(test generic-dispatch-eql-identity-and-values
  (let* ((datum (list :same)) (a (vector datum)) (b (vector 3)) (c (vector 3.0))
         (specializers (list a b c)))
    (is (eq a (miricl-runtime:dispatch-eql-key-value datum specializers #'generic-dispatch-test-metadata)))
    (is (null (miricl-runtime:dispatch-eql-key-value (copy-list datum) specializers #'generic-dispatch-test-metadata)))
    (is (eq b (miricl-runtime:dispatch-eql-key-value 3 specializers #'generic-dispatch-test-metadata)))
    (is (eq c (miricl-runtime:dispatch-eql-key-value 3.0 specializers #'generic-dispatch-test-metadata)))
    (setf (svref b 0) 4)
    (is (null (miricl-runtime:dispatch-eql-key-value 3 specializers #'generic-dispatch-test-metadata)))
    (is (equal (list b) (multiple-value-list
      (miricl-runtime:dispatch-eql-key-value 4 specializers #'generic-dispatch-test-metadata))))))

(test generic-dispatch-fixed-arity-recognition
  (dolist (parameters '(nil (a) (a b) (a b c) (a b c d)))
    (is (miricl-runtime:generic-fixed-arity-value parameters (length parameters) #'generic-dispatch-test-metadata))
    (unless (= (length parameters) 4)
      (is (null (miricl-runtime:generic-fixed-arity-value parameters (1+ (length parameters)) #'generic-dispatch-test-metadata)))))
  (dolist (bad '((a &optional) (&rest) (&key) (&allow-other-keys) (&aux) (&whole) (&environment) (&body)
                 (7) (a . b) (a b c d e)))
    (is (null (miricl-runtime:generic-fixed-arity-value bad (min 4 (if (listp bad) 2 1)) #'generic-dispatch-test-metadata))))
  (let ((cycle (list 'a))) (setf (cdr cycle) cycle)
    (is (null (miricl-runtime:generic-fixed-arity-value cycle 4 #'generic-dispatch-test-metadata))))
  (dolist (count '(-1 5 1.0 nil 4294967296))
    (signals type-error (miricl-runtime:generic-fixed-arity-value nil count #'generic-dispatch-test-metadata))))

(test generic-dispatch-cache-proof-invalidation
  (let* ((generic (vector nil (cons 3 :yes))) (*generic-dispatch-test-calls* nil)
         (*generic-dispatch-test-permitted* nil) (*generic-dispatch-test-version* 3)
         (*generic-dispatch-test-fallback* nil))
    (is (miricl-runtime:generic-cache-permitted-value generic #'generic-dispatch-test-metadata))
    (is (null *generic-dispatch-test-calls*))
    (setf (cdr (svref generic 1)) nil)
    (is (null (miricl-runtime:generic-cache-permitted-value generic #'generic-dispatch-test-metadata)))
    (is (null *generic-dispatch-test-calls*))
    (setq *generic-dispatch-test-version* 4 *generic-dispatch-test-fallback* :allowed)
    (is (miricl-runtime:generic-cache-permitted-value generic #'generic-dispatch-test-metadata))
    (is (equal (list generic) *generic-dispatch-test-calls*))
    (setq *generic-dispatch-test-permitted* t *generic-dispatch-test-calls* nil)
    (setf (svref generic 1) :malformed)
    (is (miricl-runtime:generic-cache-permitted-value generic #'generic-dispatch-test-metadata))
    (is (null *generic-dispatch-test-calls*))
    (setq *generic-dispatch-test-permitted* nil)
    (signals type-error (miricl-runtime:generic-cache-permitted-value generic #'generic-dispatch-test-metadata))
    (setf (svref generic 1) nil)
    (is (equal '(t) (multiple-value-list
      (miricl-runtime:generic-cache-permitted-value generic #'generic-dispatch-test-metadata))))))

(test generic-dispatch-key-order-and-mutable-profile
  (let* ((a (vector :a)) (b (vector :b)) (c (vector :c)) (d (vector :d))
         (specializer (vector :second))
         (profile (list nil (list specializer) nil nil)) (generic (vector profile nil))
         (state (vector generic '(:first :second :third :fourth) a b c d (+ 4 240 512)))
         (key (list d c specializer b a)))
    (is (miricl-runtime:generic-key-match-value key state #'generic-dispatch-test-metadata))
    (is (null (miricl-runtime:generic-key-match-value (reverse key) state #'generic-dispatch-test-metadata)))
    (is (null (miricl-runtime:generic-key-match-value (cdr key) state #'generic-dispatch-test-metadata)))
    (is (null (miricl-runtime:generic-key-match-value (append key '(extra)) state #'generic-dispatch-test-metadata)))
    (setf (svref specializer 0) :changed)
    (is (null (miricl-runtime:generic-key-match-value key state #'generic-dispatch-test-metadata)))
    (is (miricl-runtime:generic-key-match-value (list d c nil b a) state #'generic-dispatch-test-metadata))
    (setf (svref specializer 0) :second (second profile) nil)
    (is (miricl-runtime:generic-key-match-value (list d c nil b a) state #'generic-dispatch-test-metadata))
    (setf (svref state 6) (+ 4 64))
    (is (equal '(t) (multiple-value-list
      (miricl-runtime:generic-key-match-value (list c) state #'generic-dispatch-test-metadata))))
    (setf (svref state 6) 8)
    (is (miricl-runtime:generic-key-match-value nil state #'generic-dispatch-test-metadata))
    (is (null (miricl-runtime:generic-key-match-value '(extra) state #'generic-dispatch-test-metadata)))))

(test generic-dispatch-malformed-and-recovery
  (let* ((state (vector nil '(1) :class nil nil nil 17)) (cycle (list :class)))
    (setf (cdr cycle) cycle)
    (dolist (bad (list 7 '(:class . bad) cycle))
      (signals type-error (miricl-runtime:generic-key-match-value bad state #'generic-dispatch-test-metadata))
      (signals type-error (miricl-runtime:dispatch-eql-key-value 1 bad #'generic-dispatch-test-metadata)))
    (dolist (bad-state '(nil #(nil) #(nil nil nil nil nil nil 5) #(nil nil nil nil nil nil 257)
                        #(nil nil nil nil nil nil -1) #(nil nil nil nil nil nil 8192)))
      (signals type-error (miricl-runtime:generic-key-match-value nil bad-state #'generic-dispatch-test-metadata)))
    (setf (svref state 1) cycle)
    (signals type-error (miricl-runtime:generic-key-match-value '(:class) state #'generic-dispatch-test-metadata))
    (setf (svref state 1) '(1))
    (is (miricl-runtime:generic-key-match-value '(:class) state #'generic-dispatch-test-metadata))
    (signals type-error (miricl-runtime:dispatch-eql-key-value 1 '(bad) #'generic-dispatch-test-metadata))
    (let* ((generic (vector nil nil))
           (eql-state (vector generic '(1) :class nil nil nil 273)))
      (is (null (miricl-runtime:generic-key-match-value '(nil :class) eql-state #'generic-dispatch-test-metadata)))
      (setf (svref generic 0) cycle)
      (signals type-error (miricl-runtime:generic-key-match-value '(nil :class) eql-state #'generic-dispatch-test-metadata))
      (setf (svref generic 0) (list cycle))
      (signals type-error (miricl-runtime:generic-key-match-value '(nil :class) eql-state #'generic-dispatch-test-metadata)))))

(defun generic-dispatch-boundary-wat ()
  (miricl::wat-fragment
    (format nil
      "(func (export ~S) (param $mode i32) (result i32)
        (local $completed i32) (local $ok i32) (local $object (ref null eq))
        (block $failed (try_table (catch $transfer $failed)
          (if (i32.eqz (local.get $mode))
            (then (drop (call $generic-dispatch-metadata-value (call $int (i32.const 11)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 1))
            (then (drop (call $generic-dispatch-metadata-value (call $int64 (i64.const 4294967296)) (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 2))
            (then (local.set $object (call $cons (ref.null eq) (ref.null eq)))
              (struct.set $obj $b (ref.cast (ref $obj) (local.get $object)) (local.get $object))
              (drop (call $generic-dispatch-metadata-value (call $int (i32.const 0)) (local.get $object) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 3))
            (then (drop (call $generic-dispatch-metadata-value (call $int (i32.const 1)) (call $int (i32.const 9)) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 4))
            (then (drop (call $generic-dispatch-metadata-value (call $int (i32.const 2))
              (call $node (i32.const 8) (i32.const 2147483645) (ref.null eq) (ref.null eq) (ref.null eq)) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 5))
            (then (drop (call $generic-dispatch-metadata-value (call $int (i32.const 7))
              (call $vector-new (array.new_default $objects (i32.const 1))) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 6))
            (then (drop (call $generic-dispatch-metadata-value (call $int (i32.const 7))
              (call $vector-new (array.new_fixed $objects 7 (ref.null eq) (ref.null eq) (ref.null eq)
                (ref.null eq) (ref.null eq) (ref.null eq) (call $int (i32.const 5)))) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 7))
            (then (drop (call $generic-dispatch-metadata-value (call $int (i32.const 9))
              (call $int64 (i64.const 4294967296)) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 8))
            (then (drop (call $generic-dispatch-metadata-value (call $int (i32.const 10)) (call $int (i32.const 9)) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 9))
            (then (local.set $object (call $cons (ref.null eq) (ref.null eq)))
              (struct.set $obj $b (ref.cast (ref $obj) (local.get $object)) (local.get $object))
              (drop (call $generic-dispatch-metadata-call (local.get $object)))))
          (local.set $completed (i32.const 1))))
        (local.set $ok (i32.and (i32.eqz (local.get $completed)) (i32.eqz (ref.is_null (global.get $last-condition)))))
        (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
        (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
        (call $clear-values) (local.get $ok))
      (func (export ~S) (param $mode i32) (result i32)
        (local $packet (ref null eq)) (local $completed i32) (local $ok i32)
        (local.set $packet (call $cons (call $int (i32.const 42)) (ref.null eq)))
        (global.set $extra-values (local.get $packet)) (global.set $value-count (i32.const 3))
        (block $failed (try_table (catch $transfer $failed)
          (if (i32.eqz (local.get $mode))
            (then (drop (call $dispatch-eql-key (ref.null eq) (ref.null eq)))))
          (if (i32.eq (local.get $mode) (i32.const 1))
            (then (drop (call $generic-fixed-arity-p (ref.null eq) (i32.const 0)))))
          (if (i32.eq (local.get $mode) (i32.const 2))
            (then (drop (call $generic-key-match (ref.null eq) (ref.null eq) (ref.null eq)
              (ref.null eq) (ref.null eq) (ref.null eq) (ref.null eq) (i32.const 8)))))
          (if (i32.eq (local.get $mode) (i32.const 3))
            (then (drop (call $generic-cache-permitted-p (call $fdefinition (call $symbol (i32.const ~D)))))))
          (if (i32.eq (local.get $mode) (i32.const 4))
            (then (drop (call $dispatch-eql-key (ref.null eq) (call $int (i32.const 7))))))
          (if (i32.eq (local.get $mode) (i32.const 5))
            (then (drop (call $generic-fixed-arity-p (ref.null eq) (i32.const 5)))))
          (if (i32.eq (local.get $mode) (i32.const 6))
            (then (drop (call $generic-key-match (call $int (i32.const 7)) (ref.null eq) (ref.null eq)
              (ref.null eq) (ref.null eq) (ref.null eq) (ref.null eq) (i32.const 17)))))
          (local.set $completed (i32.const 1))))
        (local.set $ok (i32.and
          (i32.and (ref.eq (global.get $extra-values) (local.get $packet)) (i32.eq (global.get $value-count) (i32.const 3)))
          (i32.eq (local.get $completed) (i32.lt_u (local.get $mode) (i32.const 4)))))
        (global.set $error (i32.const 0)) (global.set $last-condition (ref.null eq))
        (global.set $transfer-target (ref.null eq)) (global.set $transfer-values (ref.null eq))
        (call $clear-values) (local.get $ok))"
      "test-generic-dispatch-boundary" "test-generic-dispatch-packets" (miricl::runtime-symbol-id 'make-instance))))

(test generic-dispatch-raw-boundaries-and-packets
  (let ((original (fdefinition 'miricl::generic-functions-runtime-wat)))
    (unwind-protect
        (progn
          (setf (fdefinition 'miricl::generic-functions-runtime-wat)
            (lambda () (miricl::runtime-wat-sequence (funcall original) (generic-dispatch-boundary-wat))))
          (let* ((miricl::*interpreter-only-wasm* nil)
                 (miricl::*interpreter-wasm* (m:interpreter-wasm :compiler nil)))
            (m:with-interpreter (vm)
              (dotimes (mode 10)
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "test-generic-dispatch-boundary" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)"))))
              (dotimes (mode 7)
                (is (= 1 (wt:instance-call (miricl::interpreter-context vm) (miricl::interpreter-instance vm)
                                           "test-generic-dispatch-packets" mode)))
                (is (= 42 (m:evaluate-string vm "(+ 20 22)")))))))
      (setf (fdefinition 'miricl::generic-functions-runtime-wat) original))))
