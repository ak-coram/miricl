;;;; Native array construction, shape, storage, and displaced views.
(in-package #:miricl-test)
(in-suite :miricl)

(test fill-pointer-error-type-specifiers
  (m:with-interpreter (vm)
    (dolist (object '(nil t 17 #\a "abc" #(1 2) #2A((1 2))))
      (is (eq t (m:evaluate vm `(let ((object ',object)) (handler-case (fill-pointer object)
        (type-error (condition)
          (let ((expected (type-error-expected-type condition)))
            (and (eq (type-error-datum condition) object)
                 (not (typep object expected))
                 (typep (make-array 2 :fill-pointer 0) expected))))))))))))

(test native-array-adjustment
  (m:with-interpreter (vm :fuel 1000000000)
    (dolist (kind '(t character bit))
      (dolist (adjustable '(nil t))
        (dolist (sizes '((0 4) (4 0) (3 7) (7 3) ((2 3) (3 4))
                         ((3 4) (2 3)) ((2 0 3) (3 2 4)) (nil nil)))
          (let* ((initial (case kind (character #\λ) (bit 1) (t 7)))
                 (new (case kind (character #\Z) (bit 0) (t 9)))
                 (form `(let* ((a (funcall (symbol-function 'make-array) ',(first sizes) :element-type ',kind
                                              :initial-element ',initial :adjustable ,adjustable))
                               (b (funcall (symbol-function 'adjust-array) a ',(second sizes) :initial-element ',new)))
                          (list (eq a b) (array-dimensions a) (array-dimensions b)
                                (loop for i below (array-total-size b) collect (row-major-aref b i))))))
            (is (equalp (eval form) (m:evaluate vm form)) "Adjustment mismatch: ~S" form)))))
    (dolist (form
      '((let* ((a (funcall (symbol-function 'make-array) '(2 3) :initial-contents '((1 2 3) (4 5 6)) :adjustable t))
               (b (funcall (symbol-function 'adjust-array) a '(3 4) :initial-element 0)))
          (list (eq a b) b))
        (let* ((a (make-array 4 :initial-element 7 :adjustable t :fill-pointer 2))
               (b (adjust-array a 6 :initial-element 9)))
          (list (eq a b) (fill-pointer a) (array-total-size a) (coerce a 'list) (aref a 5)))
        (let ((a (make-array 4 :initial-element 7 :adjustable t :fill-pointer 2)))
          (adjust-array a 6 :fill-pointer t :initial-element 9) (coerce a 'list))
        (let ((a (make-array 4 :initial-element 7 :adjustable t :fill-pointer 2)))
          (adjust-array a 1 :fill-pointer 0) (list (length a) (array-total-size a)))
        (let* ((a (make-array 3 :initial-contents '(1 2 3) :adjustable t))
               (view (make-array 2 :displaced-to a :displaced-index-offset 1)))
          (adjust-array a 5 :initial-contents '(5 6 7 8 9)) (coerce view 'list))
        (let* ((source (vector 1 2 3 4 5))
               (a (make-array 3 :adjustable t :displaced-to source :displaced-index-offset 1)))
          (adjust-array a 4 :initial-element 9)
          (list (array-displacement a) (coerce a 'list) (coerce source 'list)))
        (let* ((source (vector 1 2 3 4 5))
               (a (make-array 3 :adjustable t :initial-element 9)))
          (adjust-array a 2 :displaced-to source :displaced-index-offset 2)
          (list (eq source (array-displacement a)) (coerce a 'list)))
        (let ((a (make-array '(1000000 0 3) :adjustable t)))
          (adjust-array a '(1000000 2 0)) (array-total-size a))))
      (is (equalp (eval form) (m:evaluate vm form)) "Adjustment mismatch: ~S" form))))

(test native-vector-stack-operations
  (m:with-interpreter (vm :fuel 1000000000)
    (dolist (kind '(t character bit))
      (dolist (capacity '(0 1 3 31 32 33))
        (dolist (extension '(nil 1 7 33))
          (let* ((item (case kind (character #\λ) (bit 1) (t '(1 2))))
                 (form `(let* ((a (make-array ,capacity :element-type ',kind :fill-pointer 0 :adjustable t))
                               (indices (loop for i below 70 collect
                                 (vector-push-extend ',item a ,@(when extension (list extension)))))
                               (contents (coerce a 'list))
                               (popped (loop for i below 70 collect (vector-pop a))))
                          (list indices contents popped (fill-pointer a)))))
            (is (equalp (eval form) (m:evaluate vm form)) "Vector stack mismatch: ~S" form)))))
    (dolist (form
      '((let ((a (make-array 2 :fill-pointer 0 :initial-element nil)))
          (list (vector-push 1 a) (vector-push 2 a) (vector-push 3 a)
                (fill-pointer a) (vector-pop a) (aref a 1) (vector-push 4 a) (coerce a 'list)))
        (let ((a (make-array 3 :fill-pointer 0 :element-type 'bit :initial-element 0)))
          (list (vector-push 1 a) (vector-pop a) (aref a 0) (fill-pointer a)))
        (let* ((backing (vector 1 2 3 4))
               (a (make-array 2 :fill-pointer 0 :adjustable t :displaced-to backing :displaced-index-offset 1)))
          (list (funcall (symbol-function 'vector-push) 8 a)
                (funcall (symbol-function 'vector-push) 9 a)
                (funcall (symbol-function 'vector-push-extend) 7 a)
                (coerce a 'list) backing (array-displacement a)))
        (let ((a (make-array 0 :element-type 'character :fill-pointer 0)))
          (list (vector-push #\X a) (fill-pointer a)))
        (let ((a (make-array 2 :fill-pointer 0)))
          (list (vector-push-extend 7 a) (vector-pop a) (fill-pointer a)))
        (let ((a (make-array 1 :fill-pointer 0)))
          (multiple-value-list (vector-push-extend 7 a)))))
      (is (equalp (eval form) (m:evaluate vm form))))
    (dolist (source '("(vector-pop (make-array 0 :fill-pointer 0))"
                      "(vector-push-extend 1 (make-array 0 :fill-pointer 0))"
                      "(vector-push 1 #(1 2))" "(vector-push-extend 1 #(1 2))"
                      "(vector-pop #(1 2))"
                      "(adjust-array (make-array 2) 4 :fill-pointer 0)"
                      "(let ((a (make-array 2 :adjustable t))) (adjust-array a 2 :displaced-to a))"
                      "(let* ((a (make-array 2 :adjustable t)) (b (make-array 2 :displaced-to a))) (adjust-array a 2 :displaced-to b))"))
      (is (eq t (m:evaluate-string vm (concatenate 'string "(handler-case " source " (error () t))")))))
    (dolist (extension '(nil 0 -1 1.5 a))
      (is (eq t (m:evaluate vm `(handler-case
          (vector-push-extend 1 (make-array 2 :fill-pointer 0) ',extension)
        (type-error () t))))))
    (is (equal '(t 0 0) (m:evaluate vm
      '(let ((a (make-array 0 :fill-pointer 0 :adjustable t :element-type 'bit)))
         (list (handler-case (vector-push-extend 2 a) (type-error () t))
               (array-total-size a) (fill-pointer a))))))))

(test native-array-construction
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (dimensions '(nil 0 1 3 (2 3) (2 0 3) (0 3) (1 2 3)))
      (dolist (adjustable '(nil t))
        (let ((form `(let ((a (make-array ',dimensions :initial-element 7 :adjustable ,adjustable)))
                       (list (arrayp a) (vectorp a) (array-rank a) (array-dimensions a)
                             (array-total-size a) (adjustable-array-p a) (array-has-fill-pointer-p a)
                             (typep a 'array) (typep a 'simple-array)
                             (loop for i below (array-total-size a) collect (row-major-aref a i))))))
          (is (equalp (eval form) (m:evaluate vm form)) "Array shape mismatch for ~S" form))))
    (dolist (form
      '((make-array 3 :initial-contents '(1 2 3))
        (make-array '(2 2) :initial-contents '((1 2) (3 4)))
        (make-array nil :initial-contents '(1 2))
        (make-array '(2 2) :element-type 'character :initial-contents '("aλ" "🙂Z"))
        (make-array '(2 3) :element-type 'bit :initial-contents '((0 1 0) (1 0 1)))
        (make-array 33 :element-type 'bit :initial-element 1)
        (let ((a (make-array nil :initial-element 7))) (list (aref a) (setf (aref a) 9) (row-major-aref a 0)))
        (let ((a (make-array '(2 3) :initial-element 0)))
          (list (setf (aref a 1 2) 42) (aref a 1 2) (row-major-aref a 5)
                (array-row-major-index a 1 2) (array-in-bounds-p a -1 1) (array-in-bounds-p a 1 2)))
        (let ((a (make-array '(2 3) :initial-element nil)) (seen nil))
          (list (setf (aref (progn (push 1 seen) a) (progn (push 2 seen) 1) (progn (push 3 seen) 2))
                      (progn (push 4 seen) :done)) (aref a 1 2) (reverse seen)))
        (let ((a (make-array 5 :fill-pointer 2 :adjustable t :initial-element 9)))
          (list (array-total-size a) (fill-pointer a) (setf (fill-pointer a) 4)
                (aref a 4) (array-has-fill-pointer-p a) (adjustable-array-p a)
                (typep a '(vector t 5)) (typep a 'simple-vector)))
        (let* ((a (make-array 6 :initial-contents '(0 1 2 3 4 5)))
               (b (make-array 3 :displaced-to a :displaced-index-offset 2))
               (c (make-array 2 :displaced-to b :displaced-index-offset 1)))
          (list (aref b 0) (setf (aref c 0) 99) (aref a 3)
                (eq a (nth-value 0 (array-displacement b)))
                (eq b (nth-value 0 (array-displacement c)))
                (nth-value 1 (array-displacement b)) (nth-value 1 (array-displacement c))))
        (multiple-value-list (array-displacement (vector 1 2)))
        (let ((a (make-array '(2 3) :initial-element nil)))
          (list (typep a '(array * 2)) (typep a '(array t (2 3)))
                (typep a '(simple-array integer (* 3))) (typep a '(array * (2 4)))
                (typep a 'vector) (typep a 'sequence)))
        (typep (make-array 1 :element-type 'bit :initial-element 0) '(simple-bit-vector 1))
        (typep (make-array 1 :element-type 'character :initial-element #\a :fill-pointer 0) 'simple-string)))
      (is (equalp (eval form) (m:evaluate vm form)) "Array mismatch for ~S" form))
    (dolist (literal (list #0a(1 2) #2a((1 2) (3 4)) #*010110 #2a((#\a #\λ) (#\🙂 #\Z))))
      (is (equalp literal (m:evaluate vm literal))))))

(test native-array-sequences
  (m:with-interpreter (vm :fuel 1000000000)
    (dolist (type '(t character bit))
      (dolist (adjustable '(nil t))
        (dolist (fill '(nil 0 2 t))
          (let* ((contents (case type (character '(#\a #\λ #\🙂 #\Z)) (bit '(0 1 0 1)) (t '(1 2 1 3))))
                 (item (second contents))
                 (make `(funcall (symbol-function 'make-array) 4 :element-type ',type :initial-contents ',contents
                                     :adjustable ,adjustable :fill-pointer ,fill)))
            (dolist (expression `((copy-seq a) (reverse a) (nreverse a)
                                 (subseq a 0) (remove ',item a) (remove-duplicates a)
                                 (fill a ',item) (replace a (copy-seq a))
                                 (map 'list #'identity a) (coerce a 'vector)
                                 (concatenate 'list a) (concatenate 'vector a)))
              (let ((form `(let ((a ,make)) ,expression)))
                ;; ECL 26.5.5 NREVERSE on a zero-length fill-pointer vector
                ;; can return an invalid host object. REVERSE has the same
                ;; element result; the guest still exercises NREVERSE.
                (is (equalp (eval `(let ((a ,make))
                                    ,(if (eq (car expression) 'nreverse) '(reverse a) expression)))
                            (m:evaluate vm form)) "Array sequence mismatch for ~S" form)))
            (let ((form `(let ((a ,make))
                           (list (length a) (count ',item a) (find ',item a) (position ',item a)
                                 (every #'identity a) (some #'identity a)))))
              (is (equalp (eval form) (m:evaluate vm form))))))))
    (dolist (form
      '((make-sequence 'bit-vector 6 :initial-element 1)
        (map 'bit-vector (lambda (x) (if (oddp x) 1 0)) #(1 2 3 4))
        (concatenate 'bit-vector #*01 #*101) (coerce #(0 1 1) 'bit-vector)
        (let ((a (copy-seq #*010110))) (list (setf (bit a 1) 0) (setf (sbit a 4) 0) a))
        (let ((a (make-array 5 :fill-pointer 2 :initial-element 0)))
          (list (setf (elt a 1) 9) (elt a 1) (aref a 3) (length a)))
        (let ((a (make-array 5 :element-type 'character :initial-contents "abcde" :fill-pointer 2)))
          (list (char a 4) (setf (char a 4) #\Z) (stringp a) (simple-string-p a)
                (string= a "ab") (string-upcase a) (nstring-upcase a) (char a 4)))
        (let* ((a (make-array 6 :initial-contents '(1 2 3 4 5 6)))
               (b (make-array 3 :displaced-to a :displaced-index-offset 2 :fill-pointer 2)))
          (list (copy-seq b) (reverse b) (fill b 9) (coerce a 'list)))
        (let* ((a (make-array 6 :element-type 'character :initial-contents "aλ🙂def"))
               (b (make-array 3 :element-type 'character :displaced-to a :displaced-index-offset 1 :fill-pointer 2)))
          (list (copy-seq b) (string b) (nstring-upcase b) (coerce a 'list)))
        (let ((a (copy-seq #*010110))) (list (replace a a :start1 2) a))
        (let ((a (make-array 50 :element-type 'bit :initial-element 0)))
          (fill a 1 :start 3 :end 36) (list (count 1 a) (bit a 2) (bit a 3) (bit a 35) (bit a 36)))
        (let ((a (list 1 2))) (list (setf (elt a 1) 7) a))
        (multiple-value-list (setf (elt (vector 1) 0) (values 9 10)))))
      (is (equalp (eval form) (m:evaluate vm form)) "Array accessor mismatch for ~S" form))))

(test native-array-equality-and-hashing
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (make-a '((make-array 3 :initial-contents '(0 1 0))
                     (make-array 3 :element-type 'bit :initial-contents '(0 1 0))
                     (make-array 5 :initial-contents '(0.0 1 0 8 9) :fill-pointer 3)
                     (make-array '(1 3) :initial-contents '((0 1 0)))
                     (make-array '(1 3) :element-type 'bit :initial-contents '((0 1 0)))
                     (make-array 3 :element-type 'character :initial-contents "aλ🙂")
                     (make-array 5 :element-type 'character :initial-contents "AΛ🙂ZZ" :fill-pointer 3)
                     (make-array 3 :initial-contents '(#\A #\Λ #\🙂))
                     (make-array 0)))
      (dolist (make-b '((make-array 3 :initial-contents '(0 1.0 0))
                       (make-array 3 :element-type 'bit :initial-contents '(0 1 0))
                       (make-array '(1 3) :initial-contents '((0 1 0)))
                       (make-array '(1 3) :element-type 'bit :initial-contents '((0 1 0)))
                       (make-array 3 :element-type 'character :initial-contents "aλ🙂")
                       (make-array 5 :element-type 'character :initial-contents "AΛ🙂ZZ" :fill-pointer 3)
                       (make-array 3 :initial-contents '(#\A #\Λ #\🙂))
                       (vector) (make-array 0)))
        (dolist (test '(equal equalp))
          (let ((form `(let ((a ,make-a) (b ,make-b)) (,test a b))))
            (is (eq (eval form) (m:evaluate vm form)) "Array equality mismatch for ~S" form)))))
    (dolist (form
      '((let ((h (make-hash-table :test 'equalp)))
          (setf (gethash #*010 h) 42) (list (gethash #(0.0 1 0) h) (hash-table-count h)))
        (let ((h (make-hash-table :test 'equal)))
          (setf (gethash #*010 h) 42) (gethash (make-array 4 :element-type 'bit :initial-contents '(0 1 0 1) :fill-pointer 3) h))
        (let ((h (make-hash-table :test 'equal)))
          (setf (gethash "ab" h) 42) (gethash (make-array 3 :element-type 'character :initial-contents "abZ" :fill-pointer 2) h))
        (let ((h (make-hash-table :test 'equalp)))
          (setf (gethash #2a((0 1) (1 0)) h) 42)
          (gethash (make-array '(2 2) :element-type 'bit :initial-contents '((0 1) (1 0))) h))
        (let ((a (make-array 0 :element-type 'bit)))
          (let ((h (make-hash-table :test 'equalp))) (setf (gethash a h) 42) (gethash "" h)))
        (let* ((a (make-array '(1 1) :initial-element 1)) (hash (sxhash (list a))))
          (setf (aref a 0 0) 99) (= hash (sxhash (list a))))
        (let ((a (make-array 3 :element-type 'bit :initial-contents '(0 1 0) :fill-pointer 2)))
          (= (sxhash a) (sxhash #*01)))
        (let ((a (make-array '(1 1) :initial-element nil)))
          (setf (aref a 0 0) a) (typep (sxhash a) 'fixnum))))
      (is (equalp (eval form) (m:evaluate vm form)) "Array hashing mismatch for ~S" form))))

(test native-array-keywords-and-errors
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (form
      '((make-array 2 :initial-element 3 :initial-element 9)
        (make-array 2 :element-type t :element-type 'bit :initial-element 3)
        (make-array 2 :initial-element 3 :unknown 9 :allow-other-keys t)
        (make-array 2 :initial-element 3 :allow-other-keys t :allow-other-keys nil :unknown 9)
        (let ((a (vector 1 2 3)))
          (list (aref (make-array 2 :displaced-to a :displaced-index-offset 0 :displaced-index-offset 1) 0)))
        (let ((a (make-array '(2 2) :element-type 'bit :initial-element 0)))
          (list (setf (sbit a 1 1) 1) (sbit a 1 1) (bit a 1 1)))
        (multiple-value-list (make-array 0))
        (multiple-value-list (setf (fill-pointer (make-array 2 :fill-pointer 1)) (values 2 99)))))
      (is (equalp (eval form) (m:evaluate vm form))))
    (dolist (source '("(make-array)" "(make-array 2 :initial-element)" "(make-array 2 :unknown 1)"
                      "(make-array 2 :allow-other-keys nil :allow-other-keys t :unknown 1)"
                      "(make-array 2 :initial-element 1 :initial-contents '(1 2))"
                      "(make-array 2 :displaced-to #(1 2) :initial-element 1)"
                      "(make-array 2 :displaced-index-offset 0)" "(aref #2a((1)) 0)"
                      "(setf (aref #2a((1)) 0) 2)" "(bit #*1)" "(setf (sbit #*1) 0)"))
      (is (eq t (m:evaluate-string vm (concatenate 'string
        "(handler-case " source " (program-error () t))")))))
    (dolist (source '("(make-array -1)" "(make-array 1.0)" "(make-array '(1 -1))"
                      "(make-array 2 :fill-pointer 3)" "(make-array 2 :fill-pointer -1)"
                      "(setf (fill-pointer #(1 2)) 1)" "(fill-pointer #(1 2))"
                      "(sbit (make-array 1 :element-type 'bit :adjustable t) 0)"
                      "(bit #(1) 0)" "(setf (bit #*1 0) 2)" "(elt #(1) 1)"
                      "(elt '(1) 1)" "(setf (elt #(1) 1) 2)"))
      (is (eq t (m:evaluate-string vm (concatenate 'string
        "(handler-case " source " (type-error () t))")))))
    ;; STRING is the union of arrays specialized to subtypes of CHARACTER;
    ;; NIL is a subtype too. This deliberately differs from SBCL's NIL arrays.
    (is (equal '(t t t t t) (m:evaluate vm
      '(let ((s (make-array 0 :element-type nil)))
         (list (stringp s) (simple-string-p s) (typep s 'string)
               (typep s '(simple-array nil (0))) (equal s ""))))))
    (is (eq t (m:evaluate vm '(stringp (make-string 0 :element-type nil)))))
    (is (= 42 (m:evaluate vm
      '(let ((h (make-hash-table :test 'equal)))
         (setf (gethash (make-array 0 :element-type nil) h) 42) (gethash "" h)))))))
