;;;; Guest text number.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $digit-value
    (($c i32))
    (i32)
  #@(if (i32.and (i32.ge_u (local.get $c) (i32.const 48)) (i32.le_u (local.get $c) (i32.const 57)))
      (then (return (i32.sub (local.get $c) (i32.const 48)))))
  #@(local.set $c (call $upper (local.get $c)))
  #@(if (i32.and (i32.ge_u (local.get $c) (i32.const 65)) (i32.le_u (local.get $c) (i32.const 90)))
      (then (return (i32.sub (local.get $c) (i32.const 55)))))
  #@(i32.const 99))

(define-runtime-function $power
    (($base i32) ($n i32))
    (:object)
  (:locals ($a :object)
           ($b :object))
  #@(local.set $a (call $int (i32.const 1)))
  #@(local.set $b (call $int (local.get $base)))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $n)))
    (if (i32.and (local.get $n) (i32.const 1)) (then (local.set $a (call $imul (local.get $a) (local.get $b)))))
    (local.set $n (i32.shr_u (local.get $n) (i32.const 1)))
    (if (local.get $n) (then (local.set $b (call $imul (local.get $b) (local.get $b))))) (br $next)))
  #@(local.get $a))

(define-runtime-function $reader-float-kind () (i32)
  (:locals ($format :nullable-object))
  #@(local.set $format (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*read-default-float-format*)))))
  (wat-symbol-case #@(call $id (local.get $format))
    ((short-float single-float) #@(return (i32.const 3)))
    ((double-float long-float) #@(return (i32.const 4))))
  #@(call $type-fail (local.get $format)
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'member)))
      ,(reduce (lambda (name tail) `(call $cons (call $symbol (i32.const ,(runtime-symbol-id name))) ,tail))
        '(short-float single-float double-float long-float) :from-end t :initial-value '(ref.null $obj)))
    (i32.const ,(runtime-error-code :expected-designator)))
  #@(i32.const 3))

(define-runtime-function $read-token-number (($a :digits) ($n i32) ($base i32)) (:nullable-object)
  (:locals ($radix i32) ($value :nullable-object) ($setting :nullable-object))
  #@(if (local.get $base)
    (then (local.set $value (call $parse-number (local.get $a) (local.get $n) (local.get $base)))
      (if (i32.eqz (ref.is_null (local.get $value)))
        (then ,(wat-fail-when #@(i32.gt_u (i32.sub (call $tag (local.get $value)) (i32.const 1)) (i32.const 1)) :reader-syntax)))
      (return (local.get $value))))
  #@(local.set $setting (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*read-base*)))))
  #@(local.set $radix (call $bounded-index (local.get $setting) (i32.const 36)))
  #@(if (i32.lt_u (local.get $radix) (i32.const 2))
    (then (call $type-fail (local.get $setting)
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'integer)))
        (call $cons (call $int (i32.const 2)) (call $cons (call $int (i32.const 36)) (ref.null $obj))))
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(local.set $value (call $parse-number (local.get $a) (local.get $n) (local.get $radix)))
  #@(if (i32.and (ref.is_null (local.get $value)) (i32.ne (local.get $radix) (i32.const 10)))
    (then (local.set $value (call $parse-number (local.get $a) (local.get $n) (i32.const 10)))
      (if (i32.or (i32.eq (call $tag (local.get $value)) (i32.const 3))
                  (i32.eq (call $tag (local.get $value)) (i32.const 4))) (then (return (local.get $value))))
      (if (i32.and (i32.eq (call $tag (local.get $value)) (i32.const 1))
            (i32.eq (array.get $digits (local.get $a) (i32.sub (local.get $n) (i32.const 1))) (i32.const 46)))
        (then (return (local.get $value))))
      (return (ref.null $obj))))
  #@(local.get $value))

(define-runtime-function $try-small-reader-integer (($a :digits) ($n i32) ($base i32)) (:nullable-object)
  (:locals ($i i32) ($first i32) ($code i32) ($digit i32) ($negative i32) ($magnitude i64))
  #@(if (i32.eqz (local.get $n)) (then (return (ref.null $obj))))
  #@(local.set $code (array.get $digits (local.get $a) (i32.const 0)))
  #@(if (i32.or (i32.eq (local.get $code) (i32.const 43)) (i32.eq (local.get $code) (i32.const 45)))
    (then (local.set $i (i32.const 1)) (local.set $negative (i32.eq (local.get $code) (i32.const 45)))))
  #@(local.set $first (local.get $i))
  #@(if (i32.eq (local.get $i) (local.get $n)) (then (return (ref.null $obj))))
  #@(block $done (loop $next
    (br_if $done (i32.eq (local.get $i) (local.get $n)))
    (local.set $code (array.get $digits (local.get $a) (local.get $i)))
    (if (i32.and (i32.eq (local.get $base) (i32.const 10))
        (i32.and (i32.eq (local.get $code) (i32.const 46))
          (i32.and (i32.gt_u (local.get $i) (local.get $first))
            (i32.eq (i32.add (local.get $i) (i32.const 1)) (local.get $n))))) (then (br $done)))
    (local.set $digit (call $digit-value (local.get $code)))
    (if (i32.ge_u (local.get $digit) (local.get $base)) (then (return (ref.null $obj))))
    (local.set $magnitude (i64.add (i64.mul (local.get $magnitude) (i64.extend_i32_u (local.get $base)))
      (i64.extend_i32_u (local.get $digit))))
    (if (i64.gt_u (local.get $magnitude) (i64.add (i64.const 2147483647) (i64.extend_i32_u (local.get $negative))))
      (then (return (ref.null $obj))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(call $int (if (result i32) (local.get $negative)
    (then (i32.sub (i32.const 0) (i32.wrap_i64 (local.get $magnitude)))) (else (i32.wrap_i64 (local.get $magnitude))))))

;; The standard syntax path can recognize ordinary small integers directly in
;; the source, avoiding a temporary token buffer and string. On any uncertainty
;; leave the source position untouched and let the full token reader decide.
(define-runtime-function $source-small-integer () (:nullable-object)
  (:locals ($position i32) ($first i32) ($code i32) ($digit i32) ($negative i32) ($base i32)
           ($setting :nullable-object) ($magnitude i64))
  #@(if (i32.or (global.get $source-suppress) (global.get $source-generic))
    (then (return (ref.null $obj))))
  #@(local.set $setting (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*read-base*)))))
  #@(local.set $base (call $bounded-index (local.get $setting) (i32.const 36)))
  #@(if (i32.lt_u (local.get $base) (i32.const 2)) (then (return (ref.null $obj))))
  #@(local.set $position (global.get $source-position))
  #@(local.set $code (call $source-peek))
  #@(if (i32.or (i32.eq (local.get $code) (i32.const 43)) (i32.eq (local.get $code) (i32.const 45)))
    (then (local.set $negative (i32.eq (local.get $code) (i32.const 45)))
      (local.set $position (i32.add (local.get $position) (i32.const 1)))))
  #@(local.set $first (local.get $position))
  #@(block $done (loop $next
    (local.set $code (if (result i32) (i32.eq (local.get $position) (global.get $source-end))
      (then (i32.const -1)) (else (array.get $digits (global.get $source) (local.get $position)))))
    (if (call $delimiter (local.get $code)) (then (br $done)))
    (if (i32.and (i32.eq (local.get $base) (i32.const 10))
        (i32.and (i32.eq (local.get $code) (i32.const 46)) (i32.gt_u (local.get $position) (local.get $first))))
      (then (local.set $position (i32.add (local.get $position) (i32.const 1)))
        (if (i32.eq (local.get $position) (global.get $source-end)) (then (br $done)))
        (if (call $delimiter (array.get $digits (global.get $source) (local.get $position))) (then (br $done)))
        (return (ref.null $obj))))
    (local.set $digit (call $digit-value (local.get $code)))
    (if (i32.ge_u (local.get $digit) (local.get $base)) (then (return (ref.null $obj))))
    (local.set $magnitude (i64.add (i64.mul (local.get $magnitude) (i64.extend_i32_u (local.get $base)))
      (i64.extend_i32_u (local.get $digit))))
    (if (i64.gt_u (local.get $magnitude) (i64.add (i64.const 2147483647) (i64.extend_i32_u (local.get $negative))))
      (then (return (ref.null $obj))))
    (local.set $position (i32.add (local.get $position) (i32.const 1))) (br $next)))
  #@(if (i32.eq (local.get $position) (local.get $first)) (then (return (ref.null $obj))))
  #@(global.set $source-position (local.get $position))
  #@(call $int (if (result i32) (local.get $negative)
    (then (i32.sub (i32.const 0) (i32.wrap_i64 (local.get $magnitude)))) (else (i32.wrap_i64 (local.get $magnitude))))))

(define-runtime-function $parse-number
    (($a :digits) ($n i32) ($base i32))
    (:nullable-object)
  (:locals ($i i32)
           ($c i32)
           ($sign i32)
           ($digits i32)
           ($dot i32)
           ($fraction i32)
           ($slash i32)
           ($kind i32)
           ($exponent i32)
           ($exp-sign i32)
           ($exp-digits i32)
           ($value :object)
           ($numerator :object)
           ($scale :object)
           ($f f64) ($small :nullable-object))
  #@(local.set $small (call $try-small-reader-integer (local.get $a) (local.get $n) (local.get $base)))
  #@(if (i32.eqz (ref.is_null (local.get $small))) (then (return (local.get $small))))
  #@(if (i32.eqz (local.get $n)) (then (return (ref.null $obj))))
  #@(local.set $sign (i32.const 1))
  #@(local.set $exp-sign (i32.const 1))
  #@(local.set $c (array.get $digits (local.get $a) (i32.const 0)))
  #@(if (i32.or (i32.eq (local.get $c) (i32.const 43)) (i32.eq (local.get $c) (i32.const 45)))
      (then (local.set $i (i32.const 1))
            (if (i32.eq (local.get $c) (i32.const 45)) (then (local.set $sign (i32.const -1))))))
  #@(local.set $value (call $int (i32.const 0)))
  #@(local.set $numerator (local.get $value))
  #@(block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $c (array.get $digits (local.get $a) (local.get $i)))
    (if (i32.lt_u (call $digit-value (local.get $c)) (local.get $base))
        (then (local.set $value (call $iadd (call $imul (local.get $value) (call $int (local.get $base)))
                                          (call $int (call $digit-value (local.get $c)))))
              (local.set $digits (i32.add (local.get $digits) (i32.const 1)))
              (if (local.get $dot) (then (local.set $fraction (i32.add (local.get $fraction) (i32.const 1))))))
        (else
          (if (i32.and (i32.eq (local.get $c) (i32.const 47))
                (i32.and (i32.ne (local.get $digits) (i32.const 0)) (i32.eqz (i32.or (local.get $slash) (local.get $dot)))))
              (then (local.set $slash (i32.const 1)) (local.set $numerator (local.get $value))
                    (local.set $value (call $int (i32.const 0))) (local.set $digits (i32.const 0)))
              (else
                (if (i32.and (i32.eq (local.get $base) (i32.const 10))
                      (i32.and (i32.eq (local.get $c) (i32.const 46)) (i32.eqz (i32.or (local.get $slash) (local.get $dot)))))
                    (then (local.set $dot (i32.const 1)))
                    (else
                      (local.set $c (call $upper (local.get $c)))
                      (if (i32.eqz (i32.and (i32.eq (local.get $base) (i32.const 10))
                            (i32.and (i32.ne (local.get $digits) (i32.const 0)) (i32.eqz (local.get $slash)))))
                          (then (return (ref.null $obj))))
                      (if ,(reduce (lambda (a b) `(i32.and ,a ,b))
                              (loop for c in '(69 83 70 68 76)
                                    collect `(i32.ne (local.get $c) (i32.const ,c))))
                          (then (return (ref.null $obj))))
                      (local.set $kind (select (i32.const 4) (i32.const 3)
                        (i32.or (i32.eq (local.get $c) (i32.const 68)) (i32.eq (local.get $c) (i32.const 76)))))
                      (if (i32.eq (local.get $c) (i32.const 69)) (then (local.set $kind (call $reader-float-kind))))
                      (local.set $i (i32.add (local.get $i) (i32.const 1)))
                      (if (i32.lt_u (local.get $i) (local.get $n))
                          (then (local.set $c (array.get $digits (local.get $a) (local.get $i)))
                                (if (i32.or (i32.eq (local.get $c) (i32.const 43)) (i32.eq (local.get $c) (i32.const 45)))
                                    (then (local.set $exp-sign (select (i32.const -1) (i32.const 1) (i32.eq (local.get $c) (i32.const 45))))
                                          (local.set $i (i32.add (local.get $i) (i32.const 1)))))))
                      (block $exp-done (loop $exp (br_if $exp-done (i32.ge_u (local.get $i) (local.get $n)))
                        (local.set $c (call $digit-value (array.get $digits (local.get $a) (local.get $i))))
                        (if (i32.ge_u (local.get $c) (i32.const 10)) (then (return (ref.null $obj))))
                        ;; Bound work before allocating powers for a decimal exponent.
                        ,(wat-fail-when #@(i32.gt_u (local.get $exponent) (i32.const 1000)) :reader-syntax)
                        (local.set $exponent (i32.add (i32.mul (local.get $exponent) (i32.const 10)) (local.get $c)))
                        ,(wat-fail-when #@(i32.gt_u (local.get $exponent) (i32.const 10000)) :reader-syntax)
                        (local.set $exp-digits (i32.add (local.get $exp-digits) (i32.const 1)))
                        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $exp)))
                      (if (i32.eqz (local.get $exp-digits)) (then (return (ref.null $obj))))
                      (br $done)))))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(if (i32.eqz (local.get $digits)) (then (return (ref.null $obj))))
  #@(if (local.get $slash)
      (then ,(wat-fail-when #@(i32.eqz (struct.get $obj $n (local.get $value))) :reader-syntax)
            (if (i32.lt_s (local.get $sign) (i32.const 0)) (then (local.set $numerator (call $negative (local.get $numerator)))))
            (return (call $ratio (local.get $numerator) (local.get $value)))))
  #@(if (i32.and (local.get $dot) (i32.ne (local.get $fraction) (i32.const 0)))
      (then (if (i32.eqz (local.get $kind)) (then (local.set $kind (call $reader-float-kind))))))
  #@(if (local.get $kind)
      (then (local.set $exponent (i32.sub (i32.mul (local.get $exponent) (local.get $exp-sign)) (local.get $fraction)))
            (local.set $scale (call $power (i32.const 10)
              (select (local.get $exponent) (i32.sub (i32.const 0) (local.get $exponent)) (i32.ge_s (local.get $exponent) (i32.const 0)))))
            (local.set $value (if (result (ref $obj)) (i32.ge_s (local.get $exponent) (i32.const 0))
              (then (call $imul (local.get $value) (local.get $scale))) (else (call $ratio (local.get $value) (local.get $scale)))))
            (local.set $f (call $coerce-float (local.get $value) (local.get $kind)))
            (return (call $float (local.get $kind) (f64.mul (local.get $f) (f64.convert_i32_s (local.get $sign)))))))
  #@(if (result (ref $obj)) (i32.lt_s (local.get $sign) (i32.const 0))
      (then (call $negative (local.get $value))) (else (local.get $value))))

(define-runtime-function $parse-integer-apply (($args :nullable-object)) (:nullable-object)
  (:locals ($string :nullable-object) ($scan :nullable-object) ($value :nullable-object)
           ($start :nullable-object) ($end :nullable-object) ($radix :nullable-object)
           ($junk :nullable-object) ($data :digits) ($integer :object)
           ($id i32) ($seen i32) ($unknown i32) ($allow i32) ($base i32)
           ($i i32) ($stop i32) ($first i32) ($negative i32) ($code i32) ($digit i32)
           ($chunk i32) ($scale i32) ($threshold i32))
  (wat-fail-when #@(ref.is_null (local.get $args)) :wrong-arity)
  #@(local.set $string (call $string-contents (call $car (local.get $args))))
  #@(local.set $data (ref.as_non_null (struct.get $obj $digits (local.get $string))))
  #@(local.set $scan (call $cdr (local.get $args)))
  #@(block $bound (loop $keys (br_if $bound (ref.is_null (local.get $scan)))
    (local.set $id (call $id (call $car (local.get $scan))))
    (local.set $scan (call $cdr (local.get $scan)))
    ,(wat-fail-when #@(ref.is_null (local.get $scan)) :wrong-arity)
    (local.set $value (call $car (local.get $scan)))
    (local.set $scan (call $cdr (local.get $scan)))
    ,(runtime-wat-forms
      (loop for keyword in '(:start :end :radix :junk-allowed :allow-other-keys)
            for variable in '($start $end $radix $junk $allow) for bit = 1 then (* bit 2) collect
        `(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id keyword)))
          (then
            (if (i32.eqz (i32.and (local.get $seen) (i32.const ,bit)))
              (then (local.set ,variable ,(if (eq variable '$allow)
                '(i32.eqz (ref.is_null (local.get $value))) '(local.get $value)))
                (local.set $seen (i32.or (local.get $seen) (i32.const ,bit)))))
            (br $keys)))))
    (local.set $unknown (i32.const 1)) (br $keys)))
  (wat-fail-when #@(i32.and (local.get $unknown) (i32.eqz (local.get $allow))) :wrong-arity)
  #@(local.set $stop (array.len (local.get $data)))
  #@(if (i32.eqz (ref.is_null (local.get $end)))
    (then (local.set $stop (call $bounded-index (local.get $end) (local.get $stop)))))
  #@(if (i32.and (local.get $seen) (i32.const 1))
    (then (local.set $i (call $bounded-index (local.get $start) (local.get $stop)))))
  #@(local.set $base (i32.const 10))
  #@(if (i32.and (local.get $seen) (i32.const 4))
    (then
      (if (i32.eq (call $tag (local.get $radix)) (i32.const 1))
        (then (if (i32.and (i32.ge_s (struct.get $obj $n (local.get $radix)) (i32.const 0))
          (i32.le_u (call $bitlength (ref.as_non_null (local.get $radix))) (i32.const 6)))
          (then (local.set $base (call $digit (ref.as_non_null (local.get $radix)) (i32.const 0))))
          (else (local.set $base (i32.const 0)))))
        (else (local.set $base (i32.const 0))))
      (if (i32.or (i32.lt_u (local.get $base) (i32.const 2)) (i32.gt_u (local.get $base) (i32.const 36)))
        (then (call $type-fail (local.get $radix)
          (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'integer)))
            (call $cons (call $int (i32.const 2)) (call $cons (call $int (i32.const 36)) (ref.null $obj))))
          (i32.const ,(runtime-error-code :expected-designator)))))))
  #@(block $nonwhite (loop $white
    (br_if $nonwhite (i32.eq (local.get $i) (local.get $stop)))
    (br_if $nonwhite (i32.eqz (call $white (array.get $digits (local.get $data) (local.get $i)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $white)))
  #@(if (i32.lt_u (local.get $i) (local.get $stop))
    (then
      (local.set $code (array.get $digits (local.get $data) (local.get $i)))
      (if (i32.or (i32.eq (local.get $code) (i32.const 43)) (i32.eq (local.get $code) (i32.const 45)))
        (then (local.set $negative (i32.eq (local.get $code) (i32.const 45)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))))))
  #@(local.set $first (local.get $i))
  #@(local.set $scale (i32.const 1))
  #@(local.set $threshold (i32.div_u (i32.const 1073741823) (local.get $base)))
  #@(local.set $integer (call $int (i32.const 0)))
  #@(block $digits-done (loop $digits
    (br_if $digits-done (i32.eq (local.get $i) (local.get $stop)))
    (local.set $digit (call $character-digit-weight (array.get $digits (local.get $data) (local.get $i))))
    (br_if $digits-done (i32.ge_u (local.get $digit) (local.get $base)))
    ;; Keep common short integers unboxed until complete; big integers need
    ;; just one multiply/add per radix-dependent chunk rather than per digit.
    (if (i32.gt_u (local.get $scale) (local.get $threshold))
      (then
        (local.set $integer (call $iadd (call $imul (local.get $integer) (call $int (local.get $scale)))
          (call $int (local.get $chunk))))
        (local.set $chunk (i32.const 0)) (local.set $scale (i32.const 1))))
    (local.set $chunk (i32.add (i32.mul (local.get $chunk) (local.get $base)) (local.get $digit)))
    (local.set $scale (i32.mul (local.get $scale) (local.get $base)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $digits)))
  #@(local.set $value (if (result (ref null $obj)) (i32.ne (local.get $i) (local.get $first))
    (then
      (if (result (ref $obj)) (i32.eqz (struct.get $obj $n (local.get $integer)))
        (then (call $int (local.get $chunk)))
        (else (call $iadd (call $imul (local.get $integer) (call $int (local.get $scale)))
          (call $int (local.get $chunk))))))
    (else (ref.null $obj))))
  #@(if (ref.is_null (local.get $junk))
    (then
      (block $trailing-done (loop $trailing
        (br_if $trailing-done (i32.eq (local.get $i) (local.get $stop)))
        (br_if $trailing-done (i32.eqz (call $white (array.get $digits (local.get $data) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $trailing)))
      (if (i32.or (ref.is_null (local.get $value)) (i32.ne (local.get $i) (local.get $stop)))
        (then
          (local.set $value (call $make-condition
            (call $symbol (i32.const ,(runtime-symbol-id 'parse-error))) (ref.null $obj)))
          (struct.set $obj $n (local.get $value) (i32.const ,(runtime-error-code :reader-syntax)))
          (call $signal-condition (local.get $value))
          (call $debug-condition (local.get $value))))))
  #@(if (i32.and (local.get $negative) (i32.eqz (ref.is_null (local.get $value))))
    (then (local.set $value (call $negative (ref.as_non_null (local.get $value))))))
