;;;; Global derived types retain their defining lexical environments.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $check-type-name (($name :nullable-object)) ()
  (wat-fail-when #@(i32.eqz (ref.is_null (call $car (call $property-cell
    (call $symbol-plist (local.get $name)) ,(clos-library-reference '%declaration-name))))) :malformed-type))

(define-runtime-function $derived-type-binding (($name :nullable-object)) (:nullable-object)
  (:locals ($id i32))
  #@(local.set $id (call $id (local.get $name)))
  #@(if (i32.lt_s (local.get $id) (global.get $derived-type-first)) (then (return (ref.null $obj))))
  #@(call $symbol-index-get (global.get $derived-types) (local.get $id)))

(define-runtime-function $expand-derived-type (($type :nullable-object) ($environment :nullable-object)) (:nullable-object)
  (:locals ($name :nullable-object) ($binding :nullable-object) ($form :nullable-object))
  #@(loop $expand
    (local.set $name (if (result (ref null $obj)) (i32.eq (call $tag (local.get $type)) (i32.const 7))
      (then (call $car (local.get $type))) (else (local.get $type))))
    (local.set $binding (call $derived-type-binding (local.get $name)))
    (if (ref.is_null (local.get $binding)) (then (return (local.get $type))))
    (local.set $form (if (result (ref null $obj)) (call $symbolp (local.get $type))
      (then (call $cons (local.get $type) (ref.null $obj))) (else (local.get $type))))
    (local.set $type (call $apply (struct.get $obj $b (local.get $binding))
      (call $cons (local.get $form) (call $cons (local.get $environment) (ref.null $obj)))))
    (call $clear-values) (br $expand))
  #@(unreachable))

(define-runtime-function $derived-type-operation
    (($op i32) ($name :nullable-object) ($value :nullable-object) ($documentation :nullable-object)) (:nullable-object)
  (:locals ($binding :nullable-object) ($id i32))
  #@(if (i32.eq (local.get $op) (i32.const 2))
    (then (return (call $expand-derived-type (local.get $name) (local.get $value)))))
  #@(local.set $binding (call $derived-type-binding (local.get $name)))
  #@(if (i32.eqz (local.get $op))
    (then (return (if (result (ref null $obj)) (ref.is_null (local.get $binding))
      (then (ref.null $obj)) (else (struct.get $obj $b (local.get $binding)))))))
  #@(if (i32.ge_u (local.get $op) (i32.const 3))
    (then
      (if (ref.is_null (local.get $binding)) (then (return (ref.null $obj))))
      (if (i32.eq (local.get $op) (i32.const 4)) (then (struct.set $obj $c (local.get $binding) (local.get $value))))
      (return (struct.get $obj $c (local.get $binding)))))
  #@(if (i32.eqz (call $symbolp (local.get $name)))
    (then (call $list-type-error (local.get $name) (i32.const ,(runtime-symbol-id 'symbol)))))
  #@(call $check-type-name (local.get $name))
  #@(local.set $id (call $id (local.get $name)))
  #@(if (ref.is_null (local.get $binding))
    (then (local.set $binding (call $node (i32.const 9) (local.get $id)
      (local.get $name) (local.get $value) (local.get $documentation))))
    (else (struct.set $obj $b (local.get $binding) (local.get $value))
      (struct.set $obj $c (local.get $binding) (local.get $documentation))))
  #@(call $symbol-index-set (global.get $derived-types) (local.get $id) (local.get $binding))
  #@(if (i32.lt_s (local.get $id) (global.get $derived-type-first)) (then (global.set $derived-type-first (local.get $id))))
  #@(local.get $name))

(define-runtime-function $typep-environment
    (($object :nullable-object) ($type :nullable-object) ($environment :nullable-object)) (i32)
  (:locals ($saved :nullable-object) ($result i32))
  #@(if (ref.eq (local.get $environment) (global.get $derived-type-environment))
    (then (return (call $typep (local.get $object) (local.get $type)))))
  #@(local.set $saved (global.get $derived-type-environment))
  #@(global.set $derived-type-environment (local.get $environment))
  #@(block $failed
    (try_table (catch $transfer $failed)
      (local.set $result (call $typep (local.get $object) (local.get $type)))
      (global.set $derived-type-environment (local.get $saved)) (return (local.get $result))))
  #@(global.set $derived-type-environment (local.get $saved))
  #@(throw $transfer))

(define-runtime-section derived-type-runtime-wat ()
  #@(global $derived-types (ref $symbol-index) ,(empty-symbol-index-wat))
  #@(global $derived-type-first (mut i32) (i32.const 2147483647))
  #@(global $derived-type-environment (mut (ref null $obj)) (ref.null $obj))
  ($check-type-name) ($derived-type-binding) ($expand-derived-type) ($derived-type-operation) ($typep-environment))
