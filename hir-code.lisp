;;;; Compact executable HIR shared by the interpreter and portable FASLs.
;;;; This is an internal representation, rebuilt with the runtime.
(in-package :miricl-compiler)

(defvar *fasl-code-format* :source)

;; Opcode, input count bounds, integer attribute count, result present,
;; optional terminator flag. Fixed-arity variants share their operation name.
;; All operands are register numbers; variable input counts occur only on
;; calls, value groups, lists and closures. Integers use unsigned LEB128.
(defparameter *hir-code-operations*
  (coerce '((:constant 0 0 1 t) (:argument 0 0 1 t) (:rest-argument 0 0 1 t)
    (:check-arguments 0 0 2 nil) (:truth 1 1 0 t)
    (:function-reference 0 0 1 t) (:global-read 1 1 1 t)
    (:global-write 2 2 1 t) (:dynamic-bind 2 2 1 t)
    (:environment-restore 1 1 0 nil) (:values 0 nil 0 t)
    (:values-list 1 1 0 t) (:list 0 nil 0 t) (:value-ref 1 1 1 t)
    (:cell-new 1 1 0 t) (:cell-read 1 1 0 t) (:cell-write 2 2 0 t)
    (:primary 1 1 0 t) (:call 2 nil 0 t) (:capture 0 0 1 t)
    (:closure 0 nil 1 t) (:check-apply-list 1 1 0 nil)
    (:check-apply-arguments 1 1 1 nil) (:checked-argument 1 1 1 t)
    (:block-enter 1 1 1 t) (:block-environment 1 1 0 t)
    (:control-call 4 nil 1 t) (:restart-signal 2 nil 1 t)
    (:multiple-value-call 2 nil 0 t)
    (:branch 1 1 2 nil t) (:jump 0 1 1 nil t) (:return 1 1 0 nil t)
    (:block-return 2 3 1 nil t) (:throw 3 3 0 nil t) (:unreachable 0 0 0 nil t)
    (:function-reference-inline 0 0 1 t) (:function-reference-notinline 0 0 1 t)
    (:call-primary 2 nil 0 t) (:checked-jump 0 1 1 nil t)
    (:call-primary 2 2 0 t) (:call-primary 3 3 0 t)
    (:call-primary 4 4 0 t) (:call-primary 5 5 0 t)
    (:call-primary 6 6 0 t)) 'simple-vector))

(defun hir-code-error (object reason)
  (error 'hir-code-input-error :datum object :reason reason))

(defun read-hir-code-instruction (code pc scratch)
  (multiple-value-bind (next native) (compiler-primitive 45 code pc scratch)
    (if native next (read-hir-code-instruction-lisp code pc scratch))))

(defun read-hir-code-instruction-lisp (code pc scratch)
  ;; Host bootstrap fallback for the shared Wasm reader. Target consumers use
  ;; the same runtime decoder, including the interpreter's execution loop.
  (declare (optimize (safety 3)))
  (unless (and (typep code 'simple-string) (typep pc '(unsigned-byte 31))
               (simple-vector-p scratch) (>= (length scratch) 6))
    (hir-code-error code "invalid HIR decoder arguments"))
  (let ((end (length code)))
    (labels ((octet ()
               (when (>= pc end) (hir-code-error pc "truncated HIR operand"))
               (let ((byte (char-code (char code pc))))
                 (incf pc) (when (> byte 255) (hir-code-error byte "HIR operand exceeds one byte")) byte))
             (word ()
               (let ((value 0))
                 (loop for shift from 0 below 35 by 7 for byte = (octet) do
                   (when (and (= shift 28) (>= byte 8)) (hir-code-error byte "HIR operand exceeds 31 bits"))
                   (setq value (logior value (ash (logand byte 127) shift)))
                   (when (< byte 128) (return-from word value)))
                 (hir-code-error pc "unterminated HIR operand"))))
      (let* ((header (octet)) (opcode (logand header 63)))
        (unless (< opcode (length *hir-code-operations*)) (hir-code-error opcode "unknown HIR opcode"))
        (let* ((spec (svref *hir-code-operations* opcode))
               (output (if (fifth spec) (1+ (word)) 0))
               (count (if (eql (second spec) (third spec)) (second spec) (word))))
          (unless (and (<= count (- end pc)) (<= count (- (length scratch) 6)))
            (hir-code-error count "truncated HIR inputs or insufficient decoder storage"))
          (unless (and (<= (second spec) count) (or (null (third spec)) (<= count (third spec))))
            (hir-code-error count "invalid HIR operand count"))
          (setf (svref scratch 0) opcode (svref scratch 1) (ash header -6)
                (svref scratch 2) output (svref scratch 3) count (svref scratch 4) 0 (svref scratch 5) 0)
          (dotimes (i count) (setf (svref scratch (+ 6 i)) (word)))
          (when (plusp (fourth spec)) (setf (svref scratch 4) (word)))
          (when (> (fourth spec) 1) (setf (svref scratch 5) (word)))
          pc)))))

(defun pack-hir-blocks (blocks)
  ;; One raw byte string avoids a FASL object record, array descriptor and
  ;; element-reference list for every tiny basic block.
  (let ((bytes (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
    (labels ((word (n)
               (loop (vector-push-extend (code-char (logior (logand n 127) (if (> n 127) 128 0))) bytes)
                 (setq n (ash n -7)) (when (zerop n) (return)))))
      (word (length blocks))
      (loop for block across blocks do
        (word (svref block 0)) (word (svref block 1)) (word (length (svref block 2)))
        (loop for byte across (svref block 2) do (vector-push-extend byte bytes))))
    (coerce bytes 'simple-string)))

(defun unpack-hir-blocks (bytes)
  (multiple-value-bind (blocks native) (compiler-primitive 46 bytes)
    (if native blocks (unpack-hir-blocks-lisp bytes))))

(defun unpack-hir-blocks-lisp (bytes)
  (declare (optimize (safety 3)))
  (let ((pc 0) (end (length bytes)))
    (labels ((word ()
               (let ((value 0))
                 (loop for shift from 0 below 35 by 7 do
                   (when (>= pc end) (hir-code-error bytes "truncated block table"))
                   (let ((byte (char-code (char bytes pc))))
                     (incf pc)
                     (unless (and (< byte 256) (or (< shift 28) (< byte 8)))
                       (hir-code-error byte "block table operand exceeds 31 bits"))
                     (setq value (logior value (ash (logand byte 127) shift)))
                     (when (< byte 128) (return-from word value))))
                 (hir-code-error bytes "unterminated block table operand"))))
      (let ((count (word)))
        (when (> count (floor (- end pc) 3)) (hir-code-error count "block count exceeds encoded table"))
        (let ((blocks (make-array count)))
          (dotimes (i count)
            (let ((parameter (word)) (environment (word)) (length (word)))
              (when (> length (- end pc)) (hir-code-error length "truncated block code"))
              (setf (svref blocks i) (vector parameter environment (subseq bytes pc (+ pc length))))
              (incf pc length)))
          (unless (= pc end) (hir-code-error bytes "trailing block table data"))
          blocks)))))

(defun copy-hir-debug-info (info registers captures)
  (declare (optimize (safety 3)))
  (when (null info) (return-from copy-hir-debug-info (vector (vector) (vector))))
  (unless (and (simple-vector-p info) (= (length info) 2)
               (simple-vector-p (svref info 0)) (zerop (mod (length (svref info 0)) 3))
               (simple-vector-p (svref info 1)) (= (length (svref info 1)) (* captures 2)))
    (hir-code-error info "invalid binding debug table"))
  (labels ((name (object kind)
             (unless (or (symbolp object) (and (= kind 2) (integerp object))
                         (and (= kind 1) (consp object) (eq (car object) 'setf)
                              (consp (cdr object)) (symbolp (second object)) (null (cddr object))))
               (hir-code-error object "invalid debug binding name"))
             (if (consp object) (list 'setf (second object)) object)))
    (let ((bindings (copy-seq (svref info 0))) (closed (copy-seq (svref info 1))))
      (loop for i from 0 below (length bindings) by 3 do
        (unless (and (typep (svref bindings i) '(unsigned-byte 31)) (< (svref bindings i) registers)
                     (member (svref bindings (+ i 2)) '(0 1 2 3)))
          (hir-code-error bindings "invalid debug cell register or namespace"))
        (setf (svref bindings (1+ i)) (name (svref bindings (1+ i)) (mod (svref bindings (+ i 2)) 2))))
      (loop for i from 0 below (length closed) by 2 do
        (unless (member (svref closed (1+ i)) '(0 1 2)) (hir-code-error closed "invalid capture debug namespace"))
        (setf (svref closed i) (name (svref closed i) (svref closed (1+ i)))))
      (vector bindings closed))))

(defun copy-hir-parameters (parameters)
  (declare (optimize (safety 3)))
  (let ((seen (make-hash-table :test 'eq)) (result nil))
    (loop while parameters do
      (unless (consp parameters) (hir-code-error parameters "dotted parameter metadata"))
      (when (gethash parameters seen) (hir-code-error parameters "circular parameter metadata"))
      (setf (gethash parameters seen) t)
      (unless (symbolp (car parameters)) (hir-code-error (car parameters) "expected a parameter name"))
      (push (pop parameters) result))
    (nreverse result)))

(define-condition hir-code-input-error (program-error)
  ((datum :initarg :datum :reader hir-code-error-datum)
   (reason :initarg :reason :reader hir-code-error-reason))
  (:report (lambda (condition stream)
    ;; Do not invoke user printers or dump an entire corrupt code string.
    (let ((datum (hir-code-error-datum condition)))
      (format stream "Invalid executable HIR: ~A. Input: ~A"
        (hir-code-error-reason condition)
        (cond ((integerp datum) (if (< (integer-length datum) 64) datum "<large integer>"))
              ((stringp datum) (subseq datum 0 (min 80 (length datum))))
              ((simple-vector-p datum) "<vector>")
              ((null datum) "NIL") (t "<object>")))))))

(defun validate-hir-code (payload)
  ;; Never retain caller-owned executable containers. Literal objects are
  ;; intentionally shared, just as quoted objects in ordinary compiled code.
  ;; Register values remain checked at representation-sensitive VM operations;
  ;; a forged instruction cannot turn an arbitrary Lisp value into a context.
  (declare (optimize (safety 3)))
  (unless (and (simple-vector-p payload) (= (length payload) 2)
               (simple-vector-p (svref payload 0)) (simple-vector-p (svref payload 1))
               (plusp (length (svref payload 1))))
    (hir-code-error payload "expected literal and function vectors"))
  (let* ((literals (copy-seq (svref payload 0))) (functions (svref payload 1))
         (copy (make-array (length functions))))
    (unless (and (simple-vector-p (svref functions 0)) (= (length (svref functions 0)) 9)
                 (eql (svref (svref functions 0) 4) 0))
      (hir-code-error payload "root function must have no captures"))
    (dotimes (fi (length functions))
      (let ((function (svref functions fi)))
        ;; name, register count, entry environment, entry block, capture count,
        ;; blocks, source lambda, declared types. Blocks contain a parameter+1,
        ;; environment+1 and byte string. Types never authorize unchecked VM use.
        (unless (and (simple-vector-p function) (= (length function) 9)
                     (every (lambda (n) (typep n '(unsigned-byte 31))) (subseq function 1 5))
                     (plusp (svref function 1))
                     (< (svref function 2) (svref function 1))
                     (typep (svref function 5) 'simple-string)
                     (simple-vector-p (svref function 7)) (evenp (length (svref function 7))))
          (hir-code-error function "invalid function descriptor"))
        (let* ((registers (svref function 1)) (blocks (unpack-hir-blocks (svref function 5)))
               (block-copy blocks) (bytes 0) (max-inputs 0) (targets nil) (single-calls 0))
          (unless (< (svref function 3) (length blocks)) (hir-code-error function "entry block out of range"))
          (loop for i from 0 below (length (svref function 7)) by 2 do
            (let ((register (svref (svref function 7) i)))
              (unless (and (typep register '(unsigned-byte 31)) (< register registers))
                (hir-code-error register "type annotation register out of range"))))
          (dotimes (bi (length blocks))
            (let ((block (svref blocks bi)))
              (unless (and (simple-vector-p block) (= (length block) 3)
                           (typep (svref block 0) '(unsigned-byte 31)) (<= (svref block 0) registers)
                           (typep (svref block 1) '(unsigned-byte 31)) (<= (svref block 1) registers)
                           (typep (svref block 2) 'simple-string))
                (hir-code-error block "invalid block descriptor"))
              (incf bytes (length (svref block 2)))))
          (when (> registers (+ bytes (length blocks) 1))
            (hir-code-error registers "register count exceeds encoded program"))
          (dotimes (bi (length blocks))
            (let* ((code (svref (svref block-copy bi) 2)) (pc 0) (end (length code)) (terminated nil)
                   (scratch (make-array (+ 6 (length code)) :initial-element 0)))
              (labels ((bounded (n limit reason)
                         (unless (< n limit) (hir-code-error n reason)) n))
                (loop while (< pc end) do
                  (when terminated (hir-code-error code "instructions after terminator"))
                  (setq pc (read-hir-code-instruction code pc scratch))
                  (let* ((opcode (svref scratch 0)) (spec (svref *hir-code-operations* opcode))
                         (output (svref scratch 2)) (count (svref scratch 3)))
                    (unless (and (<= (second spec) count)
                                 (or (null (third spec)) (<= count (third spec)))
                                 (<= output registers) (eq (not (zerop output)) (not (null (fifth spec)))))
                      (hir-code-error code "invalid operand count or destination"))
                    (setq max-inputs (max max-inputs count))
                    (when (eq (first spec) :call-primary) (incf single-calls))
                    ;; A count is bounded by bytes remaining before looping.
                    (dotimes (i count) (bounded (svref scratch (+ i 6)) registers "register out of range"))
                    (let ((a (when (plusp (fourth spec)) (svref scratch 4)))
                          (b (when (> (fourth spec) 1) (svref scratch 5))))
                      (case (first spec)
                        ((:constant :function-reference :function-reference-inline :function-reference-notinline
                          :global-read :global-write :dynamic-bind)
                         (bounded a (length literals) "literal out of range")
                         (when (member (first spec) '(:global-read :global-write :dynamic-bind))
                           (unless (symbolp (svref literals a)) (hir-code-error a "expected symbol literal"))))
                        (:capture (bounded a (svref function 4) "capture out of range"))
                        (:closure
                         (bounded a (length functions) "function out of range")
                         (let ((child (svref functions a)))
                           (unless (and (simple-vector-p child) (= (length child) 9)
                                        (eql count (svref child 4)))
                             (hir-code-error child "closure capture count mismatch"))))
                        ((:branch :jump :checked-jump :block-enter)
                         (bounded a (length blocks) "block out of range")
                         (when b (bounded b (length blocks) "block out of range"))
                         (when (= opcode 24) (push (1- output) targets) (push a targets)))
                        (:block-return (when (plusp a) (bounded (1- a) (length blocks) "block out of range")))
                        (:check-arguments
                         (unless (or (zerop b) (> b a)) (hir-code-error a "invalid argument limits")))
                        (:control-call
                         (unless (and (<= 0 a 7)
                                      (case a
                                        ((0 3) (= count 4))
                                        ((1 2) (evenp (- count 4)))
                                        ((4 5) (zerop (mod (- count 4) 3)))
                                        ((6 7) (= count 6))))
                           (hir-code-error a "invalid control operation or operands")))
                        (:restart-signal
                         (unless (and (<= 0 a 3) (>= count (if (= a 3) 4 3)))
                           (hir-code-error a "invalid restart operation or operands"))))
                      (when (sixth spec) (setq terminated t)))))
                (unless terminated (hir-code-error code "block has no terminator")))))
          (setf (svref copy fi) (vector (svref function 0) registers (svref function 2)
            (svref function 3) (svref function 4) block-copy
            (copy-hir-debug-info (svref function 6) registers (svref function 4))
            max-inputs (coerce (nreverse targets) 'simple-vector) (copy-seq (svref function 7))
            (copy-hir-parameters (svref function 8)) single-calls)))))
    (vector literals copy)))

(defun load-hir-code (payload)
  ;; The primitive also validates direct calls, before creating a callable.
  (miricl::%%hir-function payload))

(defun copy-hir-code (payload)
  ;; Export a fresh wire representation, never the VM's executable containers.
  (declare (optimize (safety 3)))
  (vector (copy-seq (svref payload 0))
    (map 'vector (lambda (function)
      (vector (svref function 0) (svref function 1) (svref function 2) (svref function 3)
        (svref function 4)
        (pack-hir-blocks (svref function 5))
        (copy-hir-debug-info (svref function 6) (svref function 1) (svref function 4))
        (copy-seq (svref function 9)) (copy-list (svref function 10)))) (svref payload 1))))

(defun disassemble-hir-code (payload &optional (index 0))
  "Print executable HIR without requiring the compiler or retained source."
  (declare (optimize (safety 3)))
  (let* ((payload (validate-hir-code payload)) (functions (svref payload 1)))
    (unless (and (typep index '(unsigned-byte 31)) (< index (length functions)))
      (hir-code-error index "disassembly function out of range"))
    (let* ((function (svref functions index)) (literals (svref payload 0)) (blocks (svref function 5))
           (names (make-array (svref function 1) :initial-element nil))
           (types (make-array (svref function 1) :initial-element t))
           (bindings (svref (svref function 6) 0)) (captures (svref (svref function 6) 1))
           (scratch (make-array (+ 6 (svref function 7)) :initial-element 0))
           (*print-readably* nil) (*print-circle* t) (*print-level* 4) (*print-length* 8))
      (loop for i from 0 below (length bindings) by 3 do
        (setf (svref names (svref bindings i)) (svref bindings (1+ i))))
      (loop for i from 0 below (length (svref function 9)) by 2 do
        (setf (svref types (svref (svref function 9) i)) (svref (svref function 9) (1+ i))))
      (labels ((register (id)
                 (if (svref names id) (format nil "%~D[~S]" id (svref names id)) (format nil "%~D" id)))
               (literal (id) (svref literals id)))
        (format t "~&; HIR function ~S (#~D), ~D registers, entry B~D~%"
          (or (svref function 0) 'lambda) index (length names) (svref function 3))
        (loop for i from 0 below (length captures) by 2 do
          (format t "; Capture ~D: ~S~%" (floor i 2) (svref captures i)))
        (dotimes (bi (length blocks))
          (let* ((block (svref blocks bi)) (code (svref block 2)) (pc 0))
            (format t "~&B~D" bi)
            (when (plusp (svref block 0)) (format t " (~A)" (register (1- (svref block 0)))))
            (format t ":~%")
            (loop while (< pc (length code)) do
              (setq pc (read-hir-code-instruction code pc scratch))
              (let* ((opcode (svref scratch 0)) (spec (svref *hir-code-operations* opcode))
                     (operation (first spec)) (output (svref scratch 2)) (count (svref scratch 3))
                     (a (svref scratch 4)) (b (svref scratch 5))
                     (inputs (loop for i below count collect (svref scratch (+ i 6)))))
                (when (and (eq operation :cell-read) (svref names (first inputs)))
                  (setf (svref names (1- output)) (svref names (first inputs))))
                (when (and (eq operation :capture) (< (* a 2) (length captures)))
                  (setf (svref names (1- output)) (svref captures (* a 2))))
                (write-string "  ")
                (when (plusp output) (format t "~A <- " (register (1- output))))
                (case operation
                  (:branch (format t "if ~A then B~D else B~D" (register (first inputs)) a b))
                  ((:jump :checked-jump) (format t "jump B~D~{ ~A~}" a (mapcar #'register inputs)))
                  (:constant (format t "constant ~S" (literal a)))
                  ((:function-reference :function-reference-inline :function-reference-notinline)
                   (format t "function ~S" (literal a)))
                  ((:global-read :global-write :dynamic-bind)
                   (format t "~A ~S~{ ~A~}" (string-downcase (symbol-name operation)) (literal a)
                     (mapcar #'register inputs)))
                  (:closure (format t "closure F~D~{ ~A~}" a (mapcar #'register inputs)))
                  (:capture (format t "capture ~D~@[ [~S]~]" a
                    (and (< (* a 2) (length captures)) (svref captures (* a 2)))))
                  (otherwise
                   (format t "~A~{ ~A~}" (string-downcase (symbol-name operation)) (mapcar #'register inputs))
                   (when (plusp (fourth spec)) (format t " (~D~@[, ~D~])" a (when (> (fourth spec) 1) b)))))
                (when (and (plusp output) (not (eq (svref types (1- output)) t)))
                  (format t " : ~S" (svref types (1- output))))
                (terpri)))))
        nil))))
