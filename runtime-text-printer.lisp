    (then (i32.const 101)) (else (select (i32.const 102) (i32.const 100)
      (i32.eq (call $tag (local.get $x)) (i32.const 3))))))
  #@(local.set $f (struct.get $obj $f (ref.cast (ref $obj) (local.get $x))))
  #@(if (i64.eq (i64.and (i64.reinterpret_f64 (local.get $f)) (i64.const 9218868437227405312))
                 (i64.const 9218868437227405312))
    (then
      (call $require-printable-readably (local.get $x))
