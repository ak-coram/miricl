  #@(local.set $digits (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $text)))))
  #@(local.set $precision (array.len (local.get $digits)))
  #@(block $trimmed (loop $trim
    (br_if $trimmed (i32.le_u (local.get $precision) (i32.const 1)))
    (br_if $trimmed (i32.ne (array.get $digits (local.get $digits) (i32.sub (local.get $precision) (i32.const 1))) (i32.const 48)))
    (local.set $precision (i32.sub (local.get $precision) (i32.const 1))) (br $trim)))
  #@(if (i32.and (i32.ge_s (local.get $e) (i32.const -3)) (i32.lt_s (local.get $e) (i32.const 7)))
    (then
