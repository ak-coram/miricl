      (local.set $active (call $integer-length (ref.as_non_null (local.get $x))))
      (local.set $work (array.new_default $digits (local.get $active)))
      (array.copy $digits $digits (local.get $work) (i32.const 0)
        (struct.get $obj $digits (ref.cast (ref $obj) (local.get $x))) (i32.const 0) (local.get $active))
      (local.set $divisor (local.get $base)) (local.set $chunk (i32.const 1))
      (block $power-done (loop $power
        (br_if $power-done (i32.gt_u (local.get $divisor) (i32.div_u (i32.const -1) (local.get $base))))
        (local.set $divisor (i32.mul (local.get $divisor) (local.get $base)))
        (local.set $chunk (i32.add (local.get $chunk) (i32.const 1))) (br $power)))
      (local.set $wide-divisor (i64.extend_i32_u (local.get $divisor)))
      (loop $chunks
        (local.set $r (i32.const 0)) (local.set $i (local.get $active))
        (block $divided (loop $divide (br_if $divided (i32.eqz (local.get $i)))
          (local.set $i (i32.sub (local.get $i) (i32.const 1)))
          (local.set $wide (i64.or (i64.shl (i64.extend_i32_u (local.get $r)) (i64.const 15))
            (i64.extend_i32_u (array.get $digits (local.get $work) (local.get $i)))))
          (array.set $digits (local.get $work) (local.get $i)
            (i32.wrap_i64 (i64.div_u (local.get $wide) (local.get $wide-divisor))))
          (local.set $r (i32.wrap_i64 (i64.rem_u (local.get $wide) (local.get $wide-divisor)))) (br $divide)))
        (block $trimmed (loop $trim (br_if $trimmed (i32.eqz (local.get $active)))
          (br_if $trimmed (array.get $digits (local.get $work) (i32.sub (local.get $active) (i32.const 1))))
          (local.set $active (i32.sub (local.get $active) (i32.const 1))) (br $trim)))
        (local.set $j (i32.const 0))
        (loop $chunk-digits
          (local.set $c (i32.rem_u (local.get $r) (local.get $base)))
          (array.set $digits (local.get $a) (local.get $n)
            (i32.add (local.get $c) (select (i32.const 48) (i32.const 55) (i32.lt_u (local.get $c) (i32.const 10)))))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))
          (local.set $r (i32.div_u (local.get $r) (local.get $base)))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br_if $chunk-digits (i32.and (i32.lt_u (local.get $j) (local.get $chunk))
            (i32.ne (i32.or (local.get $active) (local.get $r)) (i32.const 0)))))
        (br_if $chunks (local.get $active))))))
  #@(local.set $i (i32.const 0))
  #@(block $done (loop $reverse (br_if $done (i32.ge_u (local.get $i) (i32.div_u (local.get $n) (i32.const 2))))
    (local.set $c (array.get $digits (local.get $a) (local.get $i)))
    (local.set $r (i32.sub (i32.sub (local.get $n) (local.get $i)) (i32.const 1)))
    (array.set $digits (local.get $a) (local.get $i) (array.get $digits (local.get $a) (local.get $r)))
    (array.set $digits (local.get $a) (local.get $r) (local.get $c))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $reverse)))
  #@(if (i32.eq (local.get $n) (array.len (local.get $a))) (then (return (call $text (local.get $a)))))
  #@(call $slice (local.get $a) (i32.const 0) (local.get $n)))

(define-runtime-function $decimal-text (($x :object)) (:object)
  #@(call $integer-text (local.get $x) (i32.const 10)))

(define-runtime-function $print-small-integer (($value i64) ($base i32)) ()
  (:locals ($quotient i64) ($digit i32))
  #@(local.set $quotient (i64.div_u (local.get $value) (i64.extend_i32_u (local.get $base))))
  #@(if (i64.ne (local.get $quotient) (i64.const 0))
    (then (call $print-small-integer (local.get $quotient) (local.get $base))))
  #@(local.set $digit (i32.wrap_i64 (i64.rem_u (local.get $value) (i64.extend_i32_u (local.get $base)))))
  #@(call $emit-char (i32.add (local.get $digit)
    (select (i32.const 48) (i32.const 55) (i32.lt_u (local.get $digit) (i32.const 10))))))

(define-runtime-function $print-integer-base (($x :object) ($base i32)) ()
  (:locals ($i i32) ($value i64))
  #@(if (i32.lt_s (call $value-n (local.get $x)) (i32.const 0)) (then (call $emit-char (i32.const 45))))
  #@(if (i32.gt_u (call $bitlength (local.get $x)) (i32.const 64))
    (then (call $print-text (call $integer-text (local.get $x) (local.get $base))) (return)))
  #@(local.set $i (call $integer-length (ref.as_non_null (local.get $x))))
  #@(block $loaded (loop $load (br_if $loaded (i32.eqz (local.get $i)))
    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
    (local.set $value (i64.or (i64.shl (local.get $value) (i64.const 15))
      (i64.extend_i32_u (call $digit (local.get $x) (local.get $i))))) (br $load)))
  #@(call $print-small-integer (local.get $value) (local.get $base)))

(define-runtime-function $print-rational (($x :object)) ()
  (:locals ($base i32) ($radix i32) ($ratio i32) ($numerator :object))
  #@(local.set $base (call $natural-count
    (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*print-base*))))))
  (wat-fail-when #@(i32.or (i32.lt_u (local.get $base) (i32.const 2)) (i32.gt_u (local.get $base) (i32.const 36))) :expected-designator)
  #@(local.set $radix (i32.eqz (ref.is_null
    (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*print-radix*)))))))
  #@(local.set $ratio (i32.eq (call $tag (local.get $x)) (i32.const 2)))
  #@(if (i32.and (local.get $radix) (i32.or (local.get $ratio) (i32.ne (local.get $base) (i32.const 10))))
    (then (call $emit-char (i32.const 35))
      (if (i32.eq (local.get $base) (i32.const 2)) (then (call $emit-char (i32.const 98)))
        (else (if (i32.eq (local.get $base) (i32.const 8)) (then (call $emit-char (i32.const 111)))
          (else (if (i32.eq (local.get $base) (i32.const 16)) (then (call $emit-char (i32.const 120)))
            (else (call $print-integer (call $int (local.get $base))) (call $emit-char (i32.const 114))))))))))
  #@(local.set $numerator (if (result (ref eq)) (local.get $ratio)
    (then (ref.as_non_null (struct.get $obj $a (ref.cast (ref $obj) (local.get $x))))) (else (local.get $x))))
  #@(call $print-integer-base (local.get $numerator) (local.get $base))
  #@(if (local.get $ratio)
    (then (call $emit-char (i32.const 47))
      (call $print-integer-base (ref.as_non_null (struct.get $obj $b (ref.cast (ref $obj) (local.get $x)))) (local.get $base))))
  #@(if (i32.and (local.get $radix) (i32.and (i32.eqz (local.get $ratio)) (i32.eq (local.get $base) (i32.const 10))))
    (then (call $emit-char (i32.const 46)))))

(define-runtime-function $print-integer (($x :object)) ()
  #@(call $print-integer-base (local.get $x) (i32.const 10)))

(define-runtime-function $decimal-compare
    (($a :object) ($b :object) ($e i32))
    (i32)
  #@(if (result i32) (i32.ge_s (local.get $e) (i32.const 0))
      (then (call $cmpabs (local.get $a) (call $imul (local.get $b) (call $power (i32.const 10) (local.get $e)))))
      (else (call $cmpabs (call $imul (local.get $a) (call $power (i32.const 10) (i32.sub (i32.const 0) (local.get $e)))) (local.get $b)))))

(define-runtime-function $print-float
    (($x :object))
