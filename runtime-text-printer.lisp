  #@(local.set $b (call $denominator (local.get $a)))
  #@(local.set $a (call $iabs (call $numerator (local.get $a))))
  #@(block $big-done (loop $big (br_if $big-done (f64.lt (local.get $f) (f64.const 10)))
    (local.set $f (f64.div (local.get $f) (f64.const 10))) (local.set $e (i32.add (local.get $e) (i32.const 1))) (br $big)))
  #@(block $small-done (loop $small (br_if $small-done (f64.ge (local.get $f) (f64.const 1)))
    (local.set $f (f64.mul (local.get $f) (f64.const 10))) (local.set $e (i32.sub (local.get $e) (i32.const 1))) (br $small)))
  #@(if (i32.lt_s (call $decimal-compare (local.get $a) (local.get $b) (local.get $e)) (i32.const 0))
      (then (local.set $e (i32.sub (local.get $e) (i32.const 1))))
      (else (if (i32.ge_s (call $decimal-compare (local.get $a) (local.get $b) (i32.add (local.get $e) (i32.const 1))) (i32.const 0))
