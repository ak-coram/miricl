;;;; Guest text printer.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $small-div
    (($x :object) ($divisor i32))
    (:object i32)
  (:locals ($a :digits)
           ($i i32)
           ($v i32)
           ($r i32))
  #@(local.set $i (call $integer-length (ref.as_non_null (local.get $x))))
  #@(local.set $a (array.new_default $digits (local.get $i)))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $i)))
    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
    (local.set $v (i32.add (i32.shl (local.get $r) (i32.const 15)) (call $digit (local.get $x) (local.get $i))))
    (array.set $digits (local.get $a) (local.get $i) (i32.div_u (local.get $v) (local.get $divisor)))
    (local.set $r (i32.rem_u (local.get $v) (local.get $divisor))) (br $next)))
  #@(call $integer (i32.const 1) (local.get $a))
  #@(local.get $r))

(define-runtime-function $integer-text (($x :object) ($base i32)) (:object)
  (:locals ($a :digits) ($work :digits) ($n i32) ($r i32) ($i i32) ($c i32)
           ($active i32) ($divisor i32) ($chunk i32) ($j i32) ($small i64)
           ($bits i32) ($shift i32) ($offset i32) ($wide i64) ($wide-divisor i64))
  #@(local.set $bits (call $bitlength (local.get $x)))
  #@(local.set $shift (i32.sub (i32.const 31) (i32.clz (local.get $base))))
  #@(local.set $a (array.new_default $digits (i32.add (i32.div_u
    (i32.add (local.get $bits) (i32.sub (local.get $shift) (i32.const 1))) (local.get $shift))
    (i32.eqz (local.get $bits)))))
  #@(if (i32.le_u (call $bitlength (local.get $x)) (i32.const 64))
    (then
      (local.set $i (call $integer-length (ref.as_non_null (local.get $x))))
      (block $loaded (loop $load (br_if $loaded (i32.eqz (local.get $i)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (local.set $small (i64.or (i64.shl (local.get $small) (i64.const 15))
          (i64.extend_i32_u (call $digit (local.get $x) (local.get $i))))) (br $load)))
      (loop $small-digits
        (local.set $r (i32.wrap_i64 (i64.rem_u (local.get $small) (i64.extend_i32_u (local.get $base)))))
        (array.set $digits (local.get $a) (local.get $n)
          (i32.add (local.get $r) (select (i32.const 48) (i32.const 55) (i32.lt_u (local.get $r) (i32.const 10)))))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $small (i64.div_u (local.get $small) (i64.extend_i32_u (local.get $base))))
        (br_if $small-digits (i64.ne (local.get $small) (i64.const 0)))))
    (else
      (block $converted
      ;; Power-of-two bases need only linear bit extraction, without a work
      ;; array or repeated division of the whole integer.
      (if (i32.eqz (i32.and (local.get $base) (i32.sub (local.get $base) (i32.const 1))))
        (then
          (loop $binary-digits
            (local.set $i (i32.div_u (local.get $offset) (i32.const 15)))
            (local.set $j (i32.rem_u (local.get $offset) (i32.const 15)))
            (local.set $c (i32.and (i32.or
              (i32.shr_u (call $digit (local.get $x) (local.get $i)) (local.get $j))
              (i32.shl (call $digit (local.get $x) (i32.add (local.get $i) (i32.const 1)))
                (i32.sub (i32.const 15) (local.get $j)))) (i32.sub (local.get $base) (i32.const 1))))
            (array.set $digits (local.get $a) (local.get $n)
              (i32.add (local.get $c) (select (i32.const 48) (i32.const 55) (i32.lt_u (local.get $c) (i32.const 10)))))
            (local.set $n (i32.add (local.get $n) (i32.const 1)))
            (local.set $offset (i32.add (local.get $offset) (local.get $shift)))
            (br_if $binary-digits (i32.lt_u (local.get $offset) (local.get $bits))))
          (br $converted)))
