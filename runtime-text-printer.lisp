  ;; Small integral floats use ordinary decimal notation. This avoids the
  ;; rational/power rounding path for common counters while preserving the
  ;; float type under a different reader default, including signed zero.
  #@(if (i32.and (f64.lt (local.get $f) (f64.const 10000000))
                 (f64.eq (local.get $f) (f64.trunc (local.get $f))))
    (then (call $print-small-integer (i64.trunc_f64_u (local.get $f)) (i32.const 10))
      ,(emit-text ".0")
