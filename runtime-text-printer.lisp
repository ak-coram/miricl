    (local.set $candidate (if (result (ref eq)) (i32.ge_s (local.get $scale) (i32.const 0))
      (then (call $ratio (local.get $q) (call $power (i32.const 10) (local.get $scale))))
      (else (call $imul (local.get $q) (call $power (i32.const 10) (i32.sub (i32.const 0) (local.get $scale)))))))
