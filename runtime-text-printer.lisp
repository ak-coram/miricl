            (br_if $digits-done (i32.and (i32.ge_u (local.get $i) (local.get $precision)) (i32.gt_s (local.get $i) (local.get $e))))
            (if (i32.eq (local.get $i) (i32.add (local.get $e) (i32.const 1))) (then (call $emit-char (i32.const 46))))
            (call $emit-char (if (result i32) (i32.lt_u (local.get $i) (local.get $precision))
              (then (array.get $digits (local.get $digits) (local.get $i))) (else (i32.const 48))))
