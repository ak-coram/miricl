;;;; Optional host services preserve the standalone core's empty import list.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $host-service (($operation i32) ($argument f64)) (f64)
  (:locals ($result f64))
  (wat-fail-when #@(ref.is_null (table.get $host-services (i32.const 0))) :unsupported)
  #@(local.set $result (call_indirect $host-services (type $host-service-type)
    (local.get $operation) (local.get $argument) (i32.const 0)))
  (wat-fail-when #@(f64.lt (local.get $result) (f64.const 0)) :unsupported)
  #@(local.get $result))

(define-runtime-function $host-service-object (($operation :nullable-object) ($argument :nullable-object)) (:nullable-object)
  #@(call $float (i32.const 4) (call $host-service (call $natural-count (local.get $operation))
    (call $coerce-float (call $real (local.get $argument)) (i32.const 4)))))

(define-runtime-function $calendar-part (($value :nullable-object) ($min i32) ($max i32)) (i32)
  (:locals ($number i32))
  #@(block $invalid
    (br_if $invalid (i32.ne (call $tag (local.get $value)) (i32.const 1)))
    (br_if $invalid (i32.or (i32.lt_s (struct.get $obj $n (local.get $value)) (i32.const 0))
      (i32.gt_u (call $bitlength (ref.as_non_null (local.get $value))) (i32.const 31))))
    (local.set $number (call $natural-count (local.get $value)))
    (br_if $invalid (i32.or (i32.lt_s (local.get $number) (local.get $min))
      (i32.gt_s (local.get $number) (local.get $max))))
    (return (local.get $number)))
  #@(call $type-fail (local.get $value)
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'integer)))
      (call $cons (call $int (local.get $min)) (call $cons (call $int (local.get $max)) (ref.null $obj))))
    (i32.const ,(runtime-error-code :expected-designator)))
  #@(unreachable))

(define-runtime-function $calendar-year-days (($year i32)) (i64)
  (:locals ($y i64))
  #@(local.set $y (i64.extend_i32_s (i32.sub (local.get $year) (i32.const 1))))
  #@(i64.add (i64.sub (i64.add (i64.mul (local.get $y) (i64.const 365))
    (i64.div_s (local.get $y) (i64.const 4))) (i64.div_s (local.get $y) (i64.const 100)))
    (i64.div_s (local.get $y) (i64.const 400))))

(define-runtime-function $calendar-month-days (($year i32) ($month i32)) (i32)
  #@(i32.add (array.get $digits (global.get $calendar-months) (i32.sub (local.get $month) (i32.const 1)))
    (i32.and (i32.gt_u (local.get $month) (i32.const 2))
      (i32.and (i32.eqz (i32.rem_u (local.get $year) (i32.const 4)))
        (i32.or (i32.ne (i32.rem_u (local.get $year) (i32.const 100)) (i32.const 0))
          (i32.eqz (i32.rem_u (local.get $year) (i32.const 400))))))))

(define-runtime-function $calendar-zone (($zone :nullable-object)) (i32)
  (:locals ($seconds :object))
  #@(block $invalid
    (br_if $invalid (i32.or (i32.lt_u (call $tag (local.get $zone)) (i32.const 1))
      (i32.gt_u (call $tag (local.get $zone)) (i32.const 2))))
    (br_if $invalid (i32.or (i32.lt_s (call $compare (local.get $zone) (call $int (i32.const -24))) (i32.const 0))
      (i32.gt_s (call $compare (local.get $zone) (call $int (i32.const 24))) (i32.const 0))))
    (local.set $seconds (call $real-op (i32.const 2) (ref.as_non_null (local.get $zone)) (call $int (i32.const 3600))))
    (br_if $invalid (i32.ne (call $tag (local.get $seconds)) (i32.const 1)))
    (return (i32.trunc_f64_s (call $coerce-float (local.get $seconds) (i32.const 4)))))
  #@(drop (call $apply ,(clos-library-reference '%time-zone-seconds) (call $cons (local.get $zone) (ref.null $obj))))
  #@(unreachable))

(define-runtime-function $calendar-native (($operation i32) ($value :nullable-object) ($zone :nullable-object)) (:nullable-object)
  (:locals ($offset i32) ($seconds i32) ($minutes i32) ($hours i32) ($date i32) ($month i32) ($year i32)
           ($time i64) ($days i64) ($absolute i64) ($clock i32) ($day i32) ($year-object :nullable-object) ($scan :nullable-object))
  #@(local.set $offset (call $calendar-zone (local.get $zone)))
  #@(if (i32.eqz (local.get $operation))
    (then
      (if (i32.ne (call $tag (local.get $value)) (i32.const 1))
        (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'unsigned-byte)))))
      (if (i32.lt_s (struct.get $obj $n (local.get $value)) (i32.const 0))
        (then (call $list-type-error (local.get $value) (i32.const ,(runtime-symbol-id 'unsigned-byte)))))
      (if (i32.gt_u (call $bitlength (ref.as_non_null (local.get $value))) (i32.const 53))
        (then (return (call $apply ,(clos-library-reference '%decode-universal-time)
          (call $cons (local.get $value) (call $cons (local.get $zone) (ref.null $obj)))))))
      (local.set $time (i64.sub (i64.trunc_f64_s (call $coerce-float (ref.as_non_null (local.get $value)) (i32.const 4)))
        (i64.extend_i32_s (local.get $offset))))
      (local.set $days (i64.div_s (i64.sub (local.get $time)
        (select (i64.const 86399) (i64.const 0) (i64.lt_s (local.get $time) (i64.const 0)))) (i64.const 86400)))
      (local.set $clock (i32.wrap_i64 (i64.sub (local.get $time) (i64.mul (local.get $days) (i64.const 86400)))))
      (local.set $absolute (i64.add (local.get $days) (i64.const 693595)))
      (local.set $year (i32.add (i32.wrap_i64 (i64.div_s (i64.mul (local.get $absolute) (i64.const 400))
        (i64.const 146097))) (i32.const 1)))
      (loop $earlier (if (i64.gt_s (call $calendar-year-days (local.get $year)) (local.get $absolute))
        (then (local.set $year (i32.sub (local.get $year) (i32.const 1))) (br $earlier))))
      (loop $later (if (i64.le_s (call $calendar-year-days (i32.add (local.get $year) (i32.const 1))) (local.get $absolute))
        (then (local.set $year (i32.add (local.get $year) (i32.const 1))) (br $later))))
      (local.set $day (i32.wrap_i64 (i64.sub (local.get $absolute) (call $calendar-year-days (local.get $year)))))
      (local.set $month (i32.const 12))
      (loop $month (if (i32.lt_s (local.get $day) (call $calendar-month-days (local.get $year) (local.get $month)))
        (then (local.set $month (i32.sub (local.get $month) (i32.const 1))) (br $month))))
      (local.set $date (i32.add (i32.sub (local.get $day)
        (call $calendar-month-days (local.get $year) (local.get $month))) (i32.const 1)))
      (local.set $day (i32.wrap_i64 (i64.rem_s (i64.add (local.get $days) (i64.const 7)) (i64.const 7))))
      (global.set $extra-values (call $cons (call $int (i32.rem_u (i32.div_u (local.get $clock) (i32.const 60)) (i32.const 60)))
        (call $cons (call $int (i32.div_u (local.get $clock) (i32.const 3600)))
          (call $cons (call $int (local.get $date)) (call $cons (call $int (local.get $month))
            (call $cons (call $int (local.get $year)) (call $cons (call $int (local.get $day))
              (call $cons (ref.null $obj) (call $cons (local.get $zone) (ref.null $obj))))))))))
      (global.set $value-count (i32.const 9))
      (return (call $int (i32.rem_u (local.get $clock) (i32.const 60))))))
  ;; Bignum and two-digit years use the exact, general calendar path.
  #@(local.set $year-object (call $car (call $nthcdr-native (call $int (i32.const 5)) (local.get $value))))
  #@(block $ordinary
    (br_if $ordinary (i32.ne (call $tag (local.get $year-object)) (i32.const 1)))
    (br_if $ordinary (i32.or (i32.lt_s (struct.get $obj $n (local.get $year-object)) (i32.const 0))
      (i32.gt_u (call $bitlength (ref.as_non_null (local.get $year-object))) (i32.const 26))))
    (local.set $year (call $natural-count (local.get $year-object)))
    (br_if $ordinary (i32.lt_u (local.get $year) (i32.const 100)))
    (local.set $scan (local.get $value))
    ,(runtime-wat-forms (loop for (name min max) in '(($seconds 0 59) ($minutes 0 59) ($hours 0 23) ($date 1 31) ($month 1 12)) append
      `((local.set ,name (call $calendar-part (call $car (local.get $scan)) (i32.const ,min) (i32.const ,max)))
        (local.set $scan (call $cdr (local.get $scan))))))
    (if (i32.gt_u (local.get $date) (i32.sub (call $calendar-month-days (local.get $year) (i32.add (local.get $month) (i32.const 1)))
        (call $calendar-month-days (local.get $year) (local.get $month)))) (then (br $ordinary)))
    (local.set $days (i64.add (i64.sub (call $calendar-year-days (local.get $year)) (i64.const 693595))
      (i64.extend_i32_s (i32.add (call $calendar-month-days (local.get $year) (local.get $month))
        (i32.sub (local.get $date) (i32.const 1))))))
    (local.set $time (i64.add (i64.mul (local.get $days) (i64.const 86400))
      (i64.extend_i32_s (i32.add (local.get $seconds) (i32.add (local.get $offset)
        (i32.add (i32.mul (local.get $minutes) (i32.const 60)) (i32.mul (local.get $hours) (i32.const 3600))))))))
    (if (i64.lt_s (local.get $time) (i64.const 0)) (then (br $ordinary)))
    (call $clear-values)
    (return (call $uint64 (local.get $time))))
  #@(call $apply ,(clos-library-reference '%encode-universal-time)
    (call $reverse-onto (call $reverse-onto (local.get $value) (ref.null $obj) (i32.const 0))
      (call $cons (local.get $zone) (ref.null $obj)) (i32.const 1))))

(define-runtime-section time-runtime-wat ()
  #@(type $host-service-type (func (param i32 f64) (result f64)))
  #@(table $host-services (export "host-services") 1 1 funcref)
  #@(global $calendar-months (ref $digits) (array.new_fixed $digits 13
    (i32.const 0) (i32.const 31) (i32.const 59) (i32.const 90) (i32.const 120) (i32.const 151)
    (i32.const 181) (i32.const 212) (i32.const 243) (i32.const 273) (i32.const 304) (i32.const 334) (i32.const 365)))
  ($host-service) ($host-service-object) ($calendar-part) ($calendar-year-days) ($calendar-month-days) ($calendar-zone) ($calendar-native))
