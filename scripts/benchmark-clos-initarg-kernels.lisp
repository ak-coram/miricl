;;;; Host operations adapt real SBCL MOP metadata to the target service API.
(in-package #:cl-user)
(defun clos-initarg-benchmark-metadata (selector object extra)
  (declare (optimize (speed 3) (safety 0) (debug 0)))
  (case selector
    (0 (sb-mop:class-finalized-p object))
    (1 (sb-mop:finalize-inheritance object))
    (3 (sb-mop:class-slots object))
    (5 (sb-mop:slot-definition-initargs object))
    (9 (or (miricl-runtime:list-length-or-cycle object)
           (error 'type-error :datum object :expected-type 'list)))
    (10 (let ((size (clos-initarg-benchmark-metadata 9 object nil)))
          (if (oddp size) (error 'program-error) size)))
    (11 (class-of object))
    (12 (error 'type-error :datum object :expected-type 'list))
    (15 (fdefinition object))
    (16 (compute-applicable-methods object extra))
    (17 (sb-mop:method-lambda-list object))
    (18 (intern (symbol-name object) :keyword))
    (19 (unless (or (cdr extra) (getf object :allow-other-keys))
          (loop for scan on object by #'cddr for key = (car scan) do
            (unless (or (eq key :allow-other-keys) (member key (car extra))) (error 'program-error)))) nil)
    (20 (unless (typep object '(simple-vector 3))
          (error 'type-error :datum object :expected-type '(simple-vector 3))) object)
    (21 (symbolp object))
    (22 (let ((class (if (symbolp object) (find-class object) object)))
          (check-type class class) class))
    (23 (when (or (typep object 'built-in-class) (eq object (find-class 'built-in-class))) (error 'error)) (class-of object))
    (24 (allocate-instance object))
    (25 nil)
    (26 (error "The benchmark fixtures do not allocate funcallable objects."))
    (27 (and (symbolp object) object (not (eq object t)) (not (keywordp object))))))
(defparameter *clos-initarg-metadata* #'clos-initarg-benchmark-metadata)
(setf miricl-port-bench:*cases*
  (append (remove-if (lambda (case) (search "clos-initarg/" (first case))) miricl-port-bench:*cases*)
    '(("clos-initarg/slot-keys" clos-check-initargs-value
       (progn (defclass clos-initarg-bench-slots ()
                ((a :initarg :a :initarg :alias) (b :initarg :b) (c :initarg :c)))
         (let ((object (make-instance 'clos-initarg-bench-slots)))
           (list object '(:alias 1 :b 2 :c 3) (vector nil nil nil) *clos-initarg-metadata*))) :calls 5000)
      ("clos-initarg/initialize-methods" clos-check-initargs-value
       (progn (defclass clos-initarg-bench-methods () ((a :initarg :a)))
         (defmethod initialize-instance :after ((object clos-initarg-bench-methods) &key extra ((:explicit local) nil))
           (declare (ignore extra local)) nil)
         (list (make-instance 'clos-initarg-bench-methods) '(:a 1 :extra 2 :explicit nil)
               (vector '(initialize-instance) t nil) *clos-initarg-metadata*)) :calls 2000)
      ("clos-initarg/all-method-contexts" clos-check-initargs-value
       (progn (defclass clos-initarg-bench-methods () ((a :initarg :a)))
         (defmethod initialize-instance :after ((object clos-initarg-bench-methods) &key extra ((:explicit local) nil))
           (declare (ignore extra local)) nil)
         (list (make-instance 'clos-initarg-bench-methods) '(:a 1 :extra 2 :explicit nil)
               (vector '(initialize-instance shared-initialize allocate-instance) t nil) *clos-initarg-metadata*)) :calls 1000)
      ("clos-initarg/allocate-empty" clos-allocate-instance-value
       (progn (defclass clos-initarg-bench-empty () ())
         (let ((class (find-class 'clos-initarg-bench-empty)))
           (funcall *clos-initarg-metadata* 1 class nil)
           (list class *clos-initarg-metadata*))) :calls 5000)
      ("clos-initarg/allocate-slots" clos-allocate-instance-value
       (progn (defclass clos-initarg-bench-allocation () ((a) (b) (c) (d) (e) (f)))
         (let ((class (find-class 'clos-initarg-bench-allocation)))
           (funcall *clos-initarg-metadata* 1 class nil)
           (list class *clos-initarg-metadata*))) :calls 3000))))

(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)
(defun clos-initarg-diagnostic-wat ()
  (runtime-function-definition '$test-clos-initarg-install
    (wat-fragment #@(func $test-clos-initarg-install (export "test-clos-initarg-install")
      (drop (call $set-symbol-value
        (call $intern ,(wat-text-literal "*CLOS-INITARG-METADATA*") (global.get $current-package))
        (call $clos-initarg-metadata-function)))))))
(in-package #:miricl-port-bench)
(defparameter *clos-initarg-names* '("clos-check-initargs-value" "clos-allocate-instance-value"))
(defun write-clos-initarg-benchmark (path &key catalog wat-path)
  (let ((original (fdefinition 'miricl::$clos-initarg-metadata-function)))
    (unwind-protect
         (progn
           (setf (fdefinition 'miricl::$clos-initarg-metadata-function)
             (lambda () (miricl::runtime-wat-sequence (funcall original) (miricl::clos-initarg-diagnostic-wat))))
           (write-benchmark-image path :catalog catalog :wat-path wat-path :names *clos-initarg-names*))
      (setf (fdefinition 'miricl::$clos-initarg-metadata-function) original))))
