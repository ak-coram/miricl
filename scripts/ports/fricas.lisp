;;;; Host services for FriCAS running in MIRICL's private guest filesystem.
(in-package "FRICAS-LISP")

;; Upstream's unsupported-Lisp branch leaves this macro undefined. Socket
;; services belong to its native terminal/graphics front ends; the browser
;; front end communicates with its worker instead.
(defmacro fricas-foreign-call (name c-name return-type &rest arguments)
  (declare (ignore return-type))
  `(defun ,name ,(mapcar #'car arguments)
     (declare (ignore ,@(mapcar #'car arguments)))
     (error "Native FriCAS service ~A is unavailable in this environment." ,c-name)))

(defun |miricl-host-services| ()
  ;; Upstream defines these helpers only for its named Lisp implementations.
  (setf (symbol-function 'boot::bpiname)
    (lambda (function)
      (cond ((symbolp function) function)
            ((functionp function)
             (let ((name (nth-value 2 (function-lambda-expression function))))
               (if (and name (symbolp name) (fboundp name)) name function))))))
  ;; Consume the canonical lazy parser stream iteratively. Native FriCAS
  ;; compilers eliminate this driver's tail recursion; interpreter BLOCK
  ;; frames otherwise accumulate across every command in a batch/input file.
  (setf (symbol-function 'boot::|intloopProcess|)
    (lambda (step interactive stream)
      (loop until (boot::|StreamNull| stream) do
        (let* ((item (car stream)) (lines (first item)) (tree (second item)))
          (if (boot::|pfAbSynOp?| tree 'boot::|command|)
              (progn
                (when interactive (boot::|setCurrentLine| (boot::|tokPart| tree)))
                (boot::|InterpExecuteSpadSystemCommand| (boot::|tokPart| tree)))
              (setq step (boot::|intloopSpadProcess| step lines tree interactive))))
        (setq stream (cdr stream)))
      step))
  (setf (symbol-function 'boot::reclaim) (lambda () nil))
  (setf (symbol-function '|getEnv|)
    (lambda (name)
      (cond ((string= name "FRICAS") "/fricas")
            ((string= name "DAASE") "/fricas")
            ((string= name "HOME") "/home")
            ((string= name "TMPDIR") "/tmp")
            (t nil))))
  (setf (symbol-function '|get_current_directory|)
    (lambda () (let ((name (namestring *default-pathname-defaults*)))
                 (if (string= name "/") name (string-right-trim "/" name)))))
  (setf (symbol-function '|trim_directory_name|)
    (lambda (name) (if (> (length name) 1) (string-right-trim "/" name) name)))
  (setf (symbol-function '|pad_directory_name|)
    (lambda (name) (concatenate 'string (string-right-trim "/" name) "/")))
  (setf (symbol-function 'chdir)
    (lambda (name)
      (let ((directory (probe-file (|pad_directory_name| name))))
        (when directory (setq *default-pathname-defaults* directory) t))))
  (setf (symbol-function '|fricas_probe_file0|) #'probe-file)
  (setf (symbol-function '|file_kind|)
    (lambda (name)
      (let ((file (probe-file name)))
        (cond ((null file) -1) ((null (pathname-name file)) 1) (t 0)))))
  (setf (symbol-function '|makedir|)
    (lambda (name)
      (ensure-directories-exist (concatenate 'string (|pad_directory_name| name) ".directory-probe"))
      0))
  (setf (symbol-function '|writablep|)
    (lambda (name need-directory)
      (let ((kind (|file_kind| name)))
        (cond ((= kind -1) -1)
              ((or (and (= kind 0) (zerop need-directory))
                   (and (= kind 1) (not (zerop need-directory)))) 1)
              (t 0)))))
  (setf (symbol-function '|getCLArgs|) (lambda () nil))
  (setf (symbol-function '|load_quietly|)
    (lambda (name)
      (let* ((binary (pathname name))
             (source (make-pathname :type "lsp" :defaults binary)))
        (unless (probe-file binary)
          (when (probe-file source) (compile-file source :output-file binary)))
        (load binary))))
  (setf (symbol-function '|exit_with_status|) (lambda (code) (throw 'miricl-fricas-quit code))))
