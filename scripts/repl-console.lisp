;;;; The development command's terminal is another view of the browser REPL.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun repl-console-wat ()
  (let ((wat #@(functions
    ;; The ninth buffer pair belongs to stdin/stdout, not a TCP client.
    (global $console-eof (mut i32) (i32.const 0))
    (data (i32.const 18000) "[Browser connected]\0a")
    (data (i32.const 18100) "[Browser disconnected; waiting for a browser]\0a")
    (data (i32.const 18200) "[No browser connected; input discarded]\0a")
    (data (i32.const 18300) "WebSocket: ws://127.0.0.1:")
    (data (i32.const 18350) "TCP REPL: 127.0.0.1:")
    (data (i32.const 18400) "HTTP: http://127.0.0.1:")
    (data (i32.const 18450) "/repl\0a") (data (i32.const 18460) "/\0a")
    (data (i32.const 18470) "\0a")
    (func $console-port (param $port i32)
      (local $p i32)
      (local.set $p (i32.const 6020))
      (loop $digits
        (local.set $p (i32.sub (local.get $p) (i32.const 1)))
        (i32.store8 (local.get $p) (i32.add (i32.rem_u (local.get $port) (i32.const 10)) (i32.const 48)))
        (local.set $port (i32.div_u (local.get $port) (i32.const 10))) (br_if $digits (local.get $port)))
      (call $queue (i32.const 5120) (local.get $p) (i32.sub (i32.const 6020) (local.get $p))))
    (func $console-start
      (local $pair i64)
      (i32.store (i32.const 5120) (i32.const 10))
      (call $stdin (i32.const 0))
      (i32.store (i32.const 5128) (i32.load (i32.const 0)))
      (i32.store (i32.const 5136) (i32.load (i32.const 4)))
      (local.set $pair (call $new-stream))
      (i32.store (i32.const 5132) (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
      (i32.store (i32.const 5140) (call $stdout (i32.wrap_i64 (local.get $pair))))
      (call $join (i32.load (i32.const 5128)) (global.get $set))
      (call $join (i32.load (i32.const 5132)) (global.get $set))
      (call $queue (i32.const 5120) (i32.const 18300) (i32.const 26))
      (call $console-port (global.get $websocket-port)) (call $queue (i32.const 5120) (i32.const 18450) (i32.const 6))
      (if (global.get $tcp-enabled)
        (then (call $queue (i32.const 5120) (i32.const 18350) (i32.const 20))
          (call $console-port (global.get $tcp-port)) (call $queue (i32.const 5120) (i32.const 18470) (i32.const 1))))
      (if (global.get $dev-server)
        (then (call $queue (i32.const 5120) (i32.const 18400) (i32.const 23))
          (call $console-port (global.get $http-port)) (call $queue (i32.const 5120) (i32.const 18460) (i32.const 2))))
      (call $queue (i32.const 5120) (i32.const 620) (i32.const 37)))
    (func $console-input (param $r i32)
      (local $n i32)
      (local.set $n (i32.shr_u (local.get $r) (i32.const 4)))
      (if (local.get $n)
        (then (if (global.get $browser)
          (then (call $frame (global.get $browser) (i32.const 2) (call $input (i32.const 5120)) (local.get $n)))
          (else (call $queue (i32.const 5120) (i32.const 18200) (i32.const 40))))))
      (if (i32.and (local.get $r) (i32.const 15)) (then (global.set $console-eof (i32.const 1)))))
    (func $console-output (param $r i32)
      (i32.store (i32.const 5160) (i32.add (i32.load (i32.const 5160)) (i32.shr_u (local.get $r) (i32.const 4))))
      (if (i32.and (local.get $r) (i32.const 15)) (then (i32.store (i32.const 5120) (i32.const 0)))))
    (func $console-pump
      (local $r i32)
      (if (i32.eqz (i32.load (i32.const 5120))) (then return))
      (if (i32.eqz (i32.or (global.get $console-eof) (i32.load (i32.const 5144))))
        (then
          (local.set $r (call $read (i32.load (i32.const 5128)) (call $input (i32.const 5120)) (i32.const 16384)))
          (if (i32.eq (local.get $r) (i32.const -1)) (then (i32.store (i32.const 5144) (i32.const 1)))
            (else (call $console-input (local.get $r)) (global.set $again (i32.const 1))))))
      (if (i32.and (i32.eqz (i32.load (i32.const 5148))) (i32.lt_u (i32.load (i32.const 5160)) (i32.load (i32.const 5156))))
        (then
          (local.set $r (call $write (i32.load (i32.const 5132))
            (i32.add (call $output (i32.const 5120)) (i32.load (i32.const 5160)))
            (i32.sub (i32.load (i32.const 5156)) (i32.load (i32.const 5160)))))
          (if (i32.eq (local.get $r) (i32.const -1)) (then (i32.store (i32.const 5148) (i32.const 1)))
            (else (call $console-output (local.get $r)) (global.set $again (i32.const 1))))))))))
    (wat-fragment (subseq wat 11 (1- (length wat))))))
