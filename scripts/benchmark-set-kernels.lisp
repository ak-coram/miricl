(in-package :cl-user)
(setf miricl-port-bench:*cases*
      '(("duplicates/keys-list" duplicate-sequence-keys (list (list 1 2 1 3 2) nil 0 5) :calls 100000)
        ("duplicates/keys-keyed" duplicate-sequence-keys (list (list (list 1) (list 2) (list 1) (list 3)) #'car 0 4) :calls 100000)
        ("duplicates/keys-vector" duplicate-sequence-keys (list #(1 2 1 3 2) nil 0 5) :calls 100000)
        ("duplicates/keys-string" duplicate-sequence-keys (list "aλ🙂aλ" #'char-code 0 5) :calls 100000)
        ("duplicates/mark-hash" mark-duplicate-values (list #(1 2 1 3 2) (make-array 5 :element-type 'bit :initial-element 0) #'eql #(nil nil eql)) :calls 20000)
        ("duplicates/mark-general" mark-duplicate-values (list #(1 2 3 4 5) (make-array 5 :element-type 'bit :initial-element 0) #'eql #(nil nil nil)) :calls 100000)
        ("duplicates/mark-reverse" mark-duplicate-values (list #(1 2 3 4 5) (make-array 5 :element-type 'bit :initial-element 0) #'eql #(nil t nil)) :calls 100000)
        ("duplicates/mark-negated" mark-duplicate-values (list #(1 2 3 4 5) (make-array 5 :element-type 'bit :initial-element 0) #'/= #(t nil nil)) :calls 100000)
        ("sets/adjoin" list-set-values (list 4 '(1 2 3) nil (vector 0 #'eql nil nil)) :calls 100000)
        ("sets/subset" list-set-values (list '(1 2 3) '(3 2 1) nil (vector 1 #'eql nil nil)) :calls 100000)
        ("sets/intersection" list-set-values (list '(1 2 3) '(2 3 4) nil (vector 2 #'eql nil nil)) :calls 100000)
        ("sets/difference-keyed" list-set-values (list '((1 . a) (2 . b) (3 . c)) '((2 . x) (3 . y)) #'car (vector 3 #'eql nil nil)) :calls 100000)
        ("sets/union-negated" list-set-values (list '(1 2 3) '(2 3 4) nil (vector 4 nil #'/= nil)) :calls 100000)
        ("sets/hash-intersection" list-set-values (list (loop for i below 64 collect i) (loop for i from 32 below 96 collect i) nil (vector 2 #'eql nil 'eql)) :calls 5000)))
