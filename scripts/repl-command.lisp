;;;; WASI 0.3 command: local REPL by default, explicit browser/HTTP/TCP modes.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun repl-command-wat ()
  (let* ((relay (repl-bridge-wat))
         (imports (subseq relay (length "(component ") (search "(core module $storage" relay))))
    #@(component
      ,(wat-fragment imports)
      ,(repl-terminal-imports-wat)
      (import "wasi:cli/environment@0.3.0" (instance $environment
        (type $strings (list string)) (export "get-arguments" (func (result $strings)))))
      (component $relay ,(wat-fragment (subseq relay (length "(component ") (1- (length relay)))))
      (core module $storage
        (memory (export "memory") 1)
        ,(repl-terminal-facade-wat)
        ,(repl-filesystem-allocator-wat))
      (core instance $storage (instantiate $storage))
      (alias core export $storage "memory" (core memory $memory))
      (alias core export $storage "realloc" (core func $realloc))
      (type $exit (result))
      (core func $arguments (canon lower (func $environment "get-arguments") (memory $memory) (realloc $realloc)))
      (core func $new-set (canon waitable-set.new)) (core func $join (canon waitable.join))
      (core func $drop-task (canon subtask.drop)) (core func $return (canon task.return (result $exit)))
      ;; The same native interpreter supplies the default local terminal REPL.
      (core module $interpreter)
      ,(repl-terminal-instance-wat)
      ,(repl-compiler-instance-wat)
      (instance $relay (instantiate $relay
        (with "wasi:sockets/types@0.3.0" (instance $sockets))
        (with "wasi:filesystem/types@0.3.0" (instance $filesystem))
        (with "wasi:filesystem/preopens@0.3.0" (instance $preopens))
        (with "wasi:cli/stdin@0.3.0" (instance $console-stdin))
        (with "wasi:cli/stdout@0.3.0" (instance $console-stdout))
        (with "wasi:cli/exit@0.3.0" (instance $cli-exit))
        (with "compile" (func $compiler))))
      (alias export $relay "wasi:cli/run@0.3.0" (instance $relay-cli))
      (core func $configure (canon lower (func $relay "configure")))
      (core func $run (canon lower (func $relay-cli "run") async (memory $memory)))
      ,(repl-command-driver-wat)
      (core instance $driver (instantiate $driver (with "" (instance
        (export "memory" (memory $memory)) (export "arguments" (func $arguments))
        (export "realloc" (func $realloc))
        (export "configure" (func $configure)) (export "run" (func $run))
        (export "local-start" (func $local-start)) (export "local-callback" (func $local-callback))
        (export "new-set" (func $new-set)) (export "join" (func $join))
        (export "drop-task" (func $drop-task)) (export "return" (func $return))))))
      (func $run async (result $exit)
        (canon lift (core func $driver "run") async (callback (core func $driver "callback"))))
      (instance $cli (export "run" (func $run)))
      (export "wasi:cli/run@0.3.0" (instance $cli)))))

(defun repl-compiler-instance-wat ()
  (let ((wat #@(component
    (alias core export $interpreter "compiler-request" (core func $compiler-request))
    ;; A separate canonical memory keeps compiler scratch/output independent
    ;; of the relay's client buffers. Calls compile but never execute user code.
    (core module $compiler
      (import "" "memory" (memory $target 1))
      (import "" "initialize" (func $initialize))
      (import "" "buffer" (func $buffer (param i32) (result i32)))
      (import "" "request" (func $request (param i32 i32) (result i64)))
      (memory $memory (export "memory") 33)
      (func (export "realloc") (param i32 i32 i32 i32) (result i32)
        (if (i32.gt_u (local.get 3) (i32.const 1048562)) (then unreachable)) (i32.const 16))
      (func (export "compile") (param $p i32) (param $n i32) (result i32)
        (local $target i32) (local $result i64) (local $size i32)
        (call $initialize)
        (local.set $target (call $buffer (local.get $n)))
        (memory.copy $target $memory (local.get $target) (local.get $p) (local.get $n))
        (local.set $result (call $request (local.get $target) (local.get $n)))
        (local.set $size (i32.wrap_i64 (i64.shr_u (local.get $result) (i64.const 32))))
        (if (i32.gt_u (local.get $size) (i32.const 1048562)) (then unreachable))
        (memory.copy $memory $target (i32.const 1048592) (i32.wrap_i64 (local.get $result)) (local.get $size))
        (i32.store $memory (i32.const 0) (i32.const 1048592))
        (i32.store $memory (i32.const 4) (local.get $size)) (i32.const 0)))
    (core instance $compiler (instantiate $compiler (with "" (instance
      (export "memory" (memory $terminal-memory)) (export "initialize" (func $initialize))
      (export "buffer" (func $buffer)) (export "request" (func $compiler-request))))))
    (alias core export $compiler "memory" (core memory $compiler-memory))
    (alias core export $compiler "realloc" (core func $compiler-realloc))
    (func $compiler (param "request" string) (result string)
      (canon lift (core func $compiler "compile") (memory $compiler-memory) (realloc $compiler-realloc))))))
    (wat-fragment (subseq wat 11 (1- (length wat))))))

(defun repl-command-wasm (interpreter)
  (component-with-core-module (wt:wat-to-wasm (repl-command-wat)) 1 interpreter))

(defun component-with-core-module (component index core)
  (let ((out (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
        (position 8) (module-index 0) (replaced nil))
    (labels ((copy-bytes (bytes start end)
               (loop for i from start below end do (vector-push-extend (aref bytes i) out)))
             (read-u32 ()
               (loop with n = 0 for shift from 0 by 7 for b = (aref component position)
                     do (incf position) (setf n (logior n (ash (logand b 127) shift)))
                     when (< b 128) return n))
             (write-u32 (n)
               (loop (vector-push-extend (logior (logand n 127) (if (> n 127) 128 0)) out)
                     (setf n (ash n -7)) (when (zerop n) (return)))))
      (copy-bytes component 0 8)
      (loop while (< position (length component))
            for start = position for id = (aref component position)
            for size = (progn (incf position) (read-u32)) for end = (+ position size)
            do (if (and (= id 1) (= module-index index))
                   (progn (vector-push-extend 1 out) (write-u32 (length core))
                          (copy-bytes core 0 (length core)) (setf replaced t))
                   (copy-bytes component start end))
               (when (= id 1) (incf module-index)) (setf position end))
      (unless replaced (error "Missing embedded interpreter module."))
      out)))

(defun repl-command-driver-wat ()
  (wat-fragment #@(core module $driver
    (import "" "memory" (memory 1))
    (import "" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
    (import "" "arguments" (func $arguments (param i32)))
    (import "" "configure" (func $configure (param i32 i32)))
    (import "" "run" (func $run (param i32) (result i32)))
    (import "" "local-start" (func $local-start (result i32)))
    (import "" "local-callback" (func $local-callback (param i32 i32 i32) (result i32)))
    (import "" "new-set" (func $new-set (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (import "" "return" (func $return (param i32)))
    (global $set (mut i32) (i32.const 0))
    (global $local (mut i32) (i32.const 0))
    (data (i32.const 128) "--repl-bridge")
    (data (i32.const 160) "--dev-server")
    (data (i32.const 192) "--browser-repl")
    (data (i32.const 224) "--tcp-port")
    (data (i32.const 256) "--websocket-port")
    (data (i32.const 288) "--http-port")
    (data (i32.const 320) "--bundle")
    (data (i32.const 352) "--output")
    (data (i32.const 384) "--optimize")
    (data (i32.const 416) "--entry")
    (data (i32.const 448) "--keep")
    (data (i32.const 480) "--report")
    (data (i32.const 512) "--no-strip")
    (func $equal (param $p i32) (param $n i32) (param $text i32) (param $size i32) (result i32)
      (local $i i32)
      (if (i32.ne (local.get $n) (local.get $size)) (then (return (i32.const 0))))
      (block $done (loop $bytes
        (br_if $done (i32.ge_u (local.get $i) (local.get $size)))
        (if (i32.ne (i32.load8_u (i32.add (local.get $p) (local.get $i)))
                   (i32.load8_u (i32.add (local.get $text) (local.get $i)))) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $bytes))) (i32.const 1))
    (func $option (param $p i32) (param $n i32) (param $name i32) (param $size i32) (result i32)
      (if (i32.lt_u (local.get $n) (local.get $size)) (then (return (i32.const 0))))
      (if (i32.eqz (call $equal (local.get $p) (local.get $size) (local.get $name) (local.get $size))) (then (return (i32.const 0))))
      (i32.or (i32.eq (local.get $n) (local.get $size))
        (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $size))) (i32.const 61))))
    (func $port (param $p i32) (param $n i32) (result i32)
      (local $i i32) (local $ch i32) (local $port i32)
      (if (i32.or (i32.eqz (local.get $n)) (i32.gt_u (local.get $n) (i32.const 5))) (then unreachable))
      (loop $digits
        (local.set $ch (i32.load8_u (i32.add (local.get $p) (local.get $i))))
        (if (i32.or (i32.lt_u (local.get $ch) (i32.const 48)) (i32.gt_u (local.get $ch) (i32.const 57))) (then unreachable))
        (local.set $port (i32.add (i32.mul (local.get $port) (i32.const 10)) (i32.sub (local.get $ch) (i32.const 48))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $digits (i32.lt_u (local.get $i) (local.get $n))))
      (if (i32.or (i32.eqz (local.get $port)) (i32.gt_u (local.get $port) (i32.const 65535))) (then unreachable))
      (local.get $port))
    (func (export "run") (result i32)
      (local $i i32) (local $entry i32) (local $p i32) (local $n i32)
      (local $mode i32) (local $kind i32) (local $size i32) (local $r i32)
      (local $option i32)
      (global.set $set (call $new-set)) (call $arguments (i32.const 0))
      (block $end (loop $args
        (br_if $end (i32.ge_u (local.get $i) (i32.load (i32.const 4))))
        (local.set $entry (i32.add (i32.load (i32.const 0)) (i32.mul (local.get $i) (i32.const 8))))
        (local.set $p (i32.load (local.get $entry))) (local.set $n (i32.load offset=4 (local.get $entry)))
        (if (call $equal (local.get $p) (local.get $n) (i32.const 128) (i32.const 13))
          (then (local.set $mode (i32.or (local.get $mode) (i32.const 2)))))
        (if (call $equal (local.get $p) (local.get $n) (i32.const 160) (i32.const 12))
          (then (local.set $mode (i32.or (local.get $mode) (i32.const 1)))))
        (if (call $equal (local.get $p) (local.get $n) (i32.const 192) (i32.const 14))
          (then (local.set $mode (i32.or (local.get $mode) (i32.const 4)))))
        (if (call $equal (local.get $p) (local.get $n) (i32.const 512) (i32.const 10))
          (then (i32.store (i32.const 2076) (i32.const 1))))
        (local.set $kind (i32.const 0))
        (if (call $option (local.get $p) (local.get $n) (i32.const 224) (i32.const 10))
          (then (local.set $kind (i32.const 1)) (local.set $size (i32.const 10))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 256) (i32.const 16))
          (then (local.set $kind (i32.const 2)) (local.set $size (i32.const 16))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 288) (i32.const 11))
          (then (local.set $kind (i32.const 3)) (local.set $size (i32.const 11))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 320) (i32.const 8))
          (then (local.set $kind (i32.const 4)) (local.set $size (i32.const 8))
            (i32.store (i32.const 2068) (i32.const 1))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 352) (i32.const 8))
          (then (local.set $kind (i32.const 5)) (local.set $size (i32.const 8))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 384) (i32.const 10))
          (then (local.set $kind (i32.const 4)) (local.set $size (i32.const 10))
            (i32.store (i32.const 2064) (i32.const 1))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 416) (i32.const 7))
          (then (local.set $kind (i32.const 6)) (local.set $size (i32.const 7))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 448) (i32.const 6))
          (then (local.set $kind (i32.const 7)) (local.set $size (i32.const 6))))
        (if (call $option (local.get $p) (local.get $n) (i32.const 480) (i32.const 8))
          (then (local.set $kind (i32.const 8)) (local.set $size (i32.const 8))))
        (if (local.get $kind)
          (then
            (if (i32.eq (local.get $n) (local.get $size))
              (then
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (if (i32.ge_u (local.get $i) (i32.load (i32.const 4))) (then unreachable))
                (local.set $entry (i32.add (i32.load (i32.const 0)) (i32.mul (local.get $i) (i32.const 8))))
                (local.set $p (i32.load (local.get $entry))) (local.set $n (i32.load offset=4 (local.get $entry))))
              (else (local.set $p (i32.add (local.get $p) (i32.add (local.get $size) (i32.const 1))))
                (local.set $n (i32.sub (local.get $n) (i32.add (local.get $size) (i32.const 1))))))
            (if (i32.le_u (local.get $kind) (i32.const 3))
              (then (call $configure (local.get $kind) (call $port (local.get $p) (local.get $n))))
              (else
                (if (i32.eqz (local.get $n)) (then unreachable))
                (if (i32.le_u (local.get $kind) (i32.const 5))
                  (then
                    (i32.store (i32.add (i32.const 2048) (i32.mul (i32.sub (local.get $kind) (i32.const 4)) (i32.const 8))) (local.get $p))
                    (i32.store (i32.add (i32.const 2052) (i32.mul (i32.sub (local.get $kind) (i32.const 4)) (i32.const 8))) (local.get $n)))
                  (else
                    (local.set $option (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 16)))
                    (i32.store (local.get $option) (local.get $kind))
                    (i32.store offset=4 (local.get $option) (local.get $p))
                    (i32.store offset=8 (local.get $option) (local.get $n))
                    (i32.store offset=12 (local.get $option) (i32.load (i32.const 2072)))
                    (i32.store (i32.const 2072) (local.get $option))))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $args)))
      (if (i32.and (i32.load (i32.const 2048)) (local.get $mode)) (then unreachable))
      (if (i32.and (i32.load (i32.const 2056)) (i32.eqz (i32.load (i32.const 2048)))) (then unreachable))
      (if (i32.and (i32.load (i32.const 2072)) (i32.eqz (i32.load (i32.const 2064)))) (then unreachable))
      (if (i32.and (i32.load (i32.const 2076)) (i32.eqz (i32.load (i32.const 2064)))) (then unreachable))
      (if (i32.and (i32.load (i32.const 2064)) (i32.load (i32.const 2068))) (then unreachable))
      (if (i32.eqz (local.get $mode))
        (then (global.set $local (i32.const 1)) (return (call $local-start))))
      (call $configure (i32.const 0) (local.get $mode))
      (local.set $r (call $run (i32.const 16)))
      (if (i32.shr_u (local.get $r) (i32.const 4))
        (then (call $join (i32.shr_u (local.get $r) (i32.const 4)) (global.get $set))))
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func (export "callback") (param $event i32) (param $handle i32) (param $r i32) (result i32)
      (if (global.get $local)
        (then (return (call $local-callback (local.get $event) (local.get $handle) (local.get $r)))))
      (if (i32.eq (local.get $r) (i32.const 2))
        (then (call $drop-task (local.get $handle)) (call $return (i32.const 0)) (return (i32.const 0))))
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4)))))))
