(defun write-access-kernel-benchmark (path)
  (let ((names '($read-list-path $write-list-path $pop-argument-cl $bounded-index-cl
                 $check-keyword-pairs $list-cursor-buffer $property-value $nthcdr-general $check-generic-arguments))
        (wrappers '($bench-read-path $bench-write-path $bench-pop-argument $bench-bounded-index
                    $bench-keywords $bench-cursor-buffer $bench-property-value $bench-nthcdr-general $bench-generic-arguments)))
    (let ((originals (mapcar #'symbol-function names)) (*interpreter-only-wasm* nil))
      (unwind-protect
          (progn
            (loop for name in names for original in originals for wrapper in wrappers do
              (let ((generator original) (benchmark wrapper))
                (setf (symbol-function name)
                  (lambda () (runtime-wat-sequence (funcall generator) (funcall benchmark))))))
            (write-interpreter-wasm path :compiler nil))
        (loop for name in names for original in originals do (setf (symbol-function name) original))))))
