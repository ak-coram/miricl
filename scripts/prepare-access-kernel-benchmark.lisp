  #@(local.set $allowed (call $cons (call $symbol (i32.const ,(runtime-symbol-id :key))) (ref.null eq)))
  #@(local.set $n (local.get $size))
  #@(block $built (loop $make (br_if $built (i32.eqz (local.get $n)))
    (local.set $n (i32.sub (local.get $n) (i32.const 1)))
    (local.set $items (call $cons (call $symbol (i32.const ,(runtime-symbol-id :key)))
      (call $cons (ref.null eq) (local.get $items)))) (br $make)))
  #@(block $done (loop $run (br_if $done (i32.eqz (local.get $count)))
