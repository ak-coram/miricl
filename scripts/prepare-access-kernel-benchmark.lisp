;;;; Load in the persistent MIRICL host REPL; diagnostic exports stay out of production.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $bench-read-path (($count i32) ($size i32)) (i32)
  (:export-raw "bench-read-path")
  (:locals ($items :nullable-object) ($result :nullable-object) ($n i32) ($code i32))
  #@(local.set $n (local.get $size))
  #@(block $built (loop $make (br_if $built (i32.eqz (local.get $n)))
    (local.set $n (i32.sub (local.get $n) (i32.const 1)))
    (local.set $items (call $cons (call $int (local.get $n)) (local.get $items))) (br $make)))
  #@(local.set $code (i32.sub (i32.shl (i32.const 3) (i32.sub (local.get $size) (i32.const 1))) (i32.const 1)))
  #@(block $done (loop $run (br_if $done (i32.eqz (local.get $count)))
    (local.set $result (call $read-list-path (local.get $items) (call $int (local.get $code))))
    (local.set $count (i32.sub (local.get $count) (i32.const 1))) (br $run)))
  #@(call $natural-count (local.get $result)))

