(define-runtime-function $bench-pop-argument (($count i32) ($size i32)) (i32)
  (:export-raw "bench-pop-argument")
  (:locals ($items :nullable-object) ($box :nullable-object) ($result :nullable-object))
  #@(if (local.get $size) (then (local.set $items (call $cons (call $int (local.get $size)) (ref.null eq)))))
  #@(local.set $box (call $cons (local.get $items) (ref.null eq)))
  #@(block $done (loop $run (br_if $done (i32.eqz (local.get $count)))
    (struct.set $obj $a (ref.cast (ref $obj) (local.get $box)) (local.get $items))
    (local.set $result (call $pop-argument-cl (local.get $box) (ref.null eq)))
    (local.set $count (i32.sub (local.get $count) (i32.const 1))) (br $run)))
  #@(if (result i32) (ref.is_null (local.get $result)) (then (i32.const 0))
    (else (call $natural-count (local.get $result)))))

