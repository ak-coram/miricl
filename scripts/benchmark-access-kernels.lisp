;;;; Load after MIRICL in the persistent SBCL REPL; then (benchmark-access-kernels PATH).
(in-package #:cl-user)
(defmacro define-access-driver (name parameters setup call &optional after)
  `(defun ,name (count size)
     (declare (type fixnum count size) (optimize (safety 0) (debug 0)))
     (let ,parameters
       ,@setup
       (let ((result nil))
         (dotimes (i count) (setq result ,call))
         ,(or after 'result)))))
(define-access-driver run-read-path ((items (loop for i below size collect i)) (code (1- (ash 3 (1- size)))))
  () (miricl-runtime:read-list-path items code))
(define-access-driver run-write-path ((items (make-list size)) (code (1- (ash 3 (1- size)))))
  () (miricl-runtime:write-list-path items code size))
(define-access-driver run-pop-argument ((items (if (zerop size) nil (list size))) (box (list nil)))
  () (progn (rplaca box items) (miricl-runtime:pop-argument-box box nil)) (or result 0))
(define-access-driver run-bounded-index () () (miricl-runtime:bounded-index-value size 1024))
(define-access-driver run-keywords ((items (loop repeat size append (list :key nil))) (allowed (list :key)))
  () (miricl-runtime:check-keyword-pairs items allowed nil) (if (null result) 1 0))
(define-access-driver run-cursor-buffer ((items (make-list size)))
  () (miricl-runtime:list-cursor-buffer items size) (length result))
(define-access-driver run-property-value ((items (loop for i below size append (list i i))) (key (1- size)))
  () (miricl-runtime:property-value items key 99))
(define-access-driver run-nthcdr-general ((items (make-list size)) (big (ash 1 100)))
  () (miricl-runtime:nthcdr-general big items) (if (null result) 1 0))
(define-access-driver run-generic-arguments ((items (make-list size)) (params (make-list size :initial-element 'list)))
  () (miricl-runtime:check-generic-arguments params items) (if (null result) 1 0))
(defun access-kernel-cases ()
  (list (list "read-path" #'run-read-path '(1 4 10) 2000000 #'1-)
        (list "write-path" #'run-write-path '(1 4 10) 2000000 #'identity)
        (list "pop-argument" #'run-pop-argument '(0 1) 2000000 #'identity)
        (list "bounded-index" #'run-bounded-index '(0 512 1024) 2000000 #'identity)
        (list "keywords" #'run-keywords '(0 1 8 64) 500000 (constantly 1))
        (list "cursor-buffer" #'run-cursor-buffer '(0 1 8 64 512) 100000 #'identity)
        (list "property-value" #'run-property-value '(0 1 8 64) 500000 (lambda (size) (if (zerop size) 99 (1- size))))
        (list "nthcdr-general" #'run-nthcdr-general '(0 1 8 64) 100000 (constantly 1))
        (list "generic-arguments" #'run-generic-arguments '(0 1 8 64) 500000 (constantly 1))))
(defun benchmark-access-kernels (path)
  (dolist (spec (access-kernel-cases))
    (destructuring-bind (name run sizes count expected) spec
      (declare (ignore name))
      (dolist (size sizes)
        (dotimes (warm 4) (assert (= (funcall expected size) (funcall run (min count 20000) size)))))))
  (with-open-file (out path :direction :output :if-exists :supersede)
    (write-string "[" out)
    (let ((first t))
      (dolist (spec (access-kernel-cases))
        (destructuring-bind (name run sizes count expected) spec
          (dolist (size sizes)
            (let* ((count (if (and (equal name "cursor-buffer") (< size 64)) 1000000 count))
                   (samples (loop repeat 5 collect
                             (let ((start (get-internal-real-time)))
                               (assert (= (funcall expected size) (funcall run count size)))
                               (* 1000d0 (/ (- (get-internal-real-time) start) internal-time-units-per-second))))))
              (unless first (write-char #\, out)) (setq first nil)
              (format out "{~S:~S,~S:~D,~S:~D,~S:~,3F,~S:[~{~,3F~^,~}]}"
                "kernel" name "size" size "count" count "milliseconds" (third (sort (copy-list samples) #'<))
                "samples" samples))))))
    (write-string "]" out))
  path)
(defun disassemble-access-kernels (path)
  (with-open-file (*standard-output* path :direction :output :if-exists :supersede)
    (dolist (name '(miricl-runtime:read-list-path miricl-runtime:write-list-path
                   miricl-runtime:pop-argument-box miricl-runtime:bounded-index-value
                   miricl-runtime:check-keyword-pairs miricl-runtime:list-cursor-buffer
                   miricl-runtime:property-value miricl-runtime:nthcdr-general miricl-runtime:check-generic-arguments))
      (format t "~%~S~%" name) (disassemble name))))
