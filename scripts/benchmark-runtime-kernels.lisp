(in-package #:miricl-port-bench)

(defun entry-symbol (case)
  (or (find-symbol (symbol-name (second case)) :miricl-runtime)
      (error "Unknown runtime kernel ~S" (second case))))
(defun setup-form (case) (third case))
(defun setup-arguments (case) (eval (setup-form case)))
(defun calls (case) (getf (cdddr case) :calls 1000000))
(defun selected-cases (names)
  (remove-if-not (lambda (case) (or (null names) (member (first case) names :test #'equal)
                                  (member (string-downcase (symbol-name (second case))) names :test #'equal)))
                 *cases*))
(defun driver-name (entry) (intern (format nil "DRIVER-~A" (symbol-name entry)) :miricl-port-bench))
(defun install-driver (entry arity)
  (let ((arguments (loop for i below arity collect (gensym (format nil "ARG~D" i)))))
    (compile (driver-name entry)
      `(lambda (count fixture)
         (declare (type fixnum count) (optimize (speed 3) (safety 0) (debug 0))
                  (notinline ,entry))
         (let ,(loop for arg in arguments for index from 0 collect `(,arg (nth ,index fixture)))
           (let ((sum 0))
             (declare (type fixnum sum))
             (dotimes (i count sum)
               (when (,entry ,@arguments) (incf sum)))))))))

(defun smoke-test-fixtures (&key names)
  (dolist (case (selected-cases names))
    (let* ((entry (entry-symbol case))
           (fixture (setup-arguments case))
           (truth (not (null (apply entry (setup-arguments case))))))
      (format t "Checking ~A~%" (first case)) (finish-output)
      (install-driver entry (length fixture))
      (assert (= (funcall (driver-name entry) 20 fixture) (if truth 20 0)))))
  t)

(defun json-string (value out)
  (write-char #\" out)
  (loop for char across value do
    (case char (#\" (write-string "\\\"" out)) (#\\ (write-string "\\\\" out))
      (#\Newline (write-string "\\n" out)) (#\Return (write-string "\\r" out))
      (#\Tab (write-string "\\t" out))
      (otherwise (if (< (char-code char) 32) (format out "\\u~4,'0X" (char-code char)) (write-char char out)))))
  (write-char #\" out))
(defun source-string (form)
  (let ((*package* (find-package :cl-user)) (*print-case* :downcase) (*print-pretty* nil)
        ;; SBCL's readable printer emits implementation-specific Unicode names
        ;; even for #\a. Ordinary escaped printing keeps portable #\a syntax.
        (*print-readably* nil) (*print-escape* t))
    (prin1-to-string form)))
(defun export-name (entry) (format nil "bench-port-~(~A~)" (symbol-name entry)))

(defun kernel-calls ()
  "Discover the actual runtime workers and their result ABI, never guess names."
  (let ((found (make-hash-table :test #'eq)))
    (labels ((visit (form)
               (when (consp form)
                 (if (eq (car form) 'miricl-cross:runtime-kernel-wat)
                     (let ((arguments (mapcar (lambda (x) (if (and (consp x) (eq (car x) 'quote)) (second x) x)) (cdr form))))
                       (setf (gethash (second arguments) found) arguments))
                     (progn (visit (car form)) (visit (cdr form)))))))
      (dolist (file (remove-if (lambda (path) (search "-test" (pathname-name path)))
                              (directory (merge-pathnames "runtime-*.lisp" *root*))))
        (let ((*package* (find-package :miricl)) (*read-eval* nil)
              (*readtable* (named-readtables:find-readtable :miricl-wat)))
          (with-open-file (in file)
            (loop for form = (read in nil in) until (eq form in) do (visit form))))))
    found))

(defun write-benchmark-catalog (path &key names)
  (let ((workers (kernel-calls)))
    (ensure-directories-exist path)
    (with-open-file (out path :direction :output :if-exists :supersede)
      (write-string "{\"schemaVersion\":1,\"cases\":[" out)
      (loop for case in (selected-cases names) for first = t then nil do
        (let* ((entry (entry-symbol case)) (fixture (setup-arguments case))
               (truth (not (null (apply entry fixture)))))
          (unless (gethash entry workers) (error "No linked runtime worker for ~S" entry))
          (unless first (write-char #\, out))
          (write-string "{\"name\":" out) (json-string (first case) out)
          (write-string ",\"entry\":" out) (json-string (string-downcase (symbol-name entry)) out)
          (write-string ",\"export\":" out) (json-string (export-name entry) out)
          (write-string ",\"setup\":" out) (json-string (source-string (setup-form case)) out)
          (format out ",\"arity\":~D,\"count\":~D,\"truth\":~D}" (length fixture) (calls case) (if truth 1 0))))
      (write-string "]}" out))))

(defun wrapper-wat (entry worker arity truth)
  (with-output-to-string (out)
    (format out "(func $~A (export ~S) (param $count i32) (result i32)~%" (export-name entry) (export-name entry))
    (write-line "(local $fixture (ref null eq)) (local $sum i32)" out)
    (dotimes (i arity) (format out "(local $a~D (ref null eq))~%" i))
    (format out "(local.set $fixture (call $symbol-value (call $intern ~A (call $find-package ~A))))~%"
            (miricl::wat-string (miricl::wat-text-literal "*RUNTIME-PORT-BENCH-ARGUMENTS*"))
            (miricl::wat-string (miricl::wat-text-literal "COMMON-LISP-USER")))
    (dotimes (i arity)
      (format out "(local.set $a~D (call $car (local.get $fixture)))~%(local.set $fixture (call $cdr (local.get $fixture)))~%" i))
    (write-line "(block $done (loop $run (br_if $done (i32.eqz (local.get $count)))" out)
    (write-string "(local.set $sum (i32.add (local.get $sum) " out)
    (unless truth (write-string "(i32.eqz (ref.is_null " out))
    (format out "(call ~(~A~)" worker)
    (dotimes (i arity) (format out " (local.get $a~D)" i))
    (write-string (if truth ")))" ")))))") out) (terpri out)
    (write-line "(local.set $count (i32.sub (local.get $count) (i32.const 1))) (br $run))) (local.get $sum))" out)))

(defun write-benchmark-image (path &key names catalog wat-path)
  "Temporarily add diagnostic loops; no benchmark exports enter production images."
  (let ((workers (kernel-calls)) (originals nil) (done (make-hash-table :test #'eq)))
    (unwind-protect
         (progn
           (dolist (case (selected-cases names))
             (let* ((entry (entry-symbol case)) (args (gethash entry workers)) (worker (first args)))
               (unless args (error "No runtime worker for ~S" entry))
               (unless (gethash entry done)
                 (setf (gethash entry done) t)
                 (let* ((original (symbol-function worker))
                        (text (wrapper-wat entry worker (length (setup-arguments case))
                                          (eq (getf (cddr args) :result) :truth)))
                        (name (intern (format nil "$~A" (string-upcase (export-name entry))) :miricl)))
                   (push (cons worker original) originals)
                   (setf (symbol-function worker)
                         (lambda ()
                           (miricl::runtime-wat-sequence (funcall original)
                             (miricl::runtime-function-definition name (miricl::wat-fragment text)))))))))
           (let ((miricl::*interpreter-only-wasm* nil))
             (miricl:write-interpreter-wasm path :compiler nil))
           (when catalog (write-benchmark-catalog catalog :names names))
           (when wat-path (disassemble-kernels nil :names names :wat-path wat-path)))
      (dolist (pair originals) (setf (symbol-function (car pair)) (cdr pair))))))

(defun disassemble-kernels (path &key names wat-path)
  "SBCL DISASSEMBLE and linked WAT for the actual workers used by the runtime."
  (let ((entries (remove-duplicates (mapcar #'entry-symbol (selected-cases names))))
        (workers (kernel-calls)))
    (when path
      (ensure-directories-exist path)
      (with-open-file (*standard-output* path :direction :output :if-exists :supersede)
        (dolist (entry entries) (format t "~%;;;; ~S~%" entry) (disassemble entry))))
    (when wat-path
      (ensure-directories-exist wat-path)
      (with-open-file (out wat-path :direction :output :if-exists :supersede)
        (dolist (entry entries)
          (format out "~%;; ~S~%~A~%" entry (apply #'miricl-cross:runtime-kernel-wat (gethash entry workers))))))))

(defun wall-ticks ()
  ;; SBCL's cached GET-INTERNAL-REAL-TIME clock has millisecond granularity.
  ;; GET-TIME-OF-DAY supplies microseconds for these sub-millisecond samples.
  #+sbcl (multiple-value-bind (seconds microseconds) (sb-ext:get-time-of-day)
           (+ (* seconds 1000000) microseconds))
  #-sbcl (get-internal-real-time))
(defun wall-ticks-per-second () #+sbcl 1000000 #-sbcl internal-time-units-per-second)

(defun disassemble-emitted-kernels (path &key names)
  "Use DISASSEMBLE-NATIVE on exactly the emitted bytes/index passed to linkage."
  (let ((original (fdefinition 'miricl-cross::kernel-worker-wat))
        (workers (kernel-calls))
        (miricl-cross::*kernel-cache* (make-hash-table :test #'equal)))
    (ensure-directories-exist path)
    (with-open-file (*standard-output* path :direction :output :if-exists :supersede)
      (unwind-protect
           (progn
             (setf (fdefinition 'miricl-cross::kernel-worker-wat)
               (lambda (bytes index name arity result interruptible &optional (literals #()))
                 (format t "~%;;;; ~S (actual emitted worker index ~D)~%" name index)
                 (miricl-compiler::disassemble-native bytes index)
                 (funcall original bytes index name arity result interruptible literals)))
             (dolist (entry (remove-duplicates (mapcar #'entry-symbol (selected-cases names))))
               (apply #'miricl-cross:runtime-kernel-wat (gethash entry workers))))
        (setf (fdefinition 'miricl-cross::kernel-worker-wat) original)))))

(defun benchmark-sbcl (path &key names (scale 1d0) (samples 5) (warmups 4))
  (assert (and (> scale 0) (>= samples 1) (>= warmups 1)))
  (let ((cases (selected-cases names)))
    (dolist (case cases) (install-driver (entry-symbol case) (length (setup-arguments case))))
    ;; Warm EVERY fixture/branch with separate drivers before collecting samples.
    (dolist (case cases)
      (dotimes (i warmups)
        (funcall (driver-name (entry-symbol case)) (min 20000 (max 1 (round (* scale (calls case))))) (setup-arguments case))))
    (ensure-directories-exist path)
    (with-open-file (out path :direction :output :if-exists :supersede)
      (format out "{\"schemaVersion\":1,\"runtime\":\"sbcl\",\"version\":") (json-string (lisp-implementation-version) out)
      (format out ",\"clockResolutionMicroseconds\":~,6F" (/ 1000000d0 (wall-ticks-per-second)))
      (write-string ",\"timer\":" out)
      (json-string #+sbcl "sb-ext:get-time-of-day" #-sbcl "get-internal-real-time" out)
      (format out ",\"warmups\":~D,\"sampleCount\":~D,\"scale\":~,6F" warmups samples scale)
      (write-string ",\"results\":[" out)
      (loop for case in cases for first = t then nil do
        (let* ((entry (entry-symbol case)) (count (max 1 (round (* scale (calls case)))))
               (_checked (assert (<= count #x7fffffff)))
               (truth (not (null (apply entry (setup-arguments case)))))
               (durations
                 (loop repeat samples collect
                   (let* ((fixture (setup-arguments case)) (start (wall-ticks))
                          (sum (funcall (driver-name entry) count fixture))
                          (end (wall-ticks)))
                     (assert (= sum (if truth count 0)))
                     (assert (>= end start) () "Wall clock moved backwards; repeat the benchmark.")
                     (* 1000d0 (/ (- end start) (wall-ticks-per-second))))))
               (median (nth (floor samples 2) (sort (copy-list durations) #'<))))
          (declare (ignore _checked))
          (format t "~A: ~,3F ns/call (~D calls)~%" (first case) (/ (* median 1d6) count) count)
          (unless first (write-char #\, out))
          (write-string "{\"name\":" out) (json-string (first case) out)
          (write-string ",\"entry\":" out) (json-string (string-downcase (symbol-name entry)) out)
          (format out ",\"count\":~D,\"milliseconds\":~,6F,\"samples\":[~{~,6F~^,~}]}" count median durations)))
      (write-string "]}" out))))
