;;;; Load once after MIRICL in a persistent SBCL REPL. Reload this file freely.
;;;; See benchmark-runtime-kernels.md for the full diagnostic workflow.
(defpackage #:miricl-port-bench
  (:use #:cl)
  (:export #:write-benchmark-image #:write-benchmark-catalog
           #:benchmark-sbcl #:disassemble-kernels #:disassemble-emitted-kernels #:*cases*))
(in-package #:miricl-port-bench)

(defparameter *root*
  (uiop:pathname-parent-directory-pathname
   (uiop:pathname-directory-pathname *load-truename*)))

;; Each setup returns the arguments to one actual runtime worker. Setups run
;; outside timing, before EVERY sample. Mutable fixtures remain stable across
;; calls (fill/copy), or alternate between equivalent states (vector reverse).
;; This is a throughput benchmark, not a semantic regression suite. Results are
;; consumed through their truth value; the semantic suite checks full values.
;; Counts deliberately differ for allocating and small nonallocating kernels.
(in-package #:cl-user)
