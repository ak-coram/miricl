          (i32.store (local.get $p) (local.get $kind))
          (i32.store offset=4 (local.get $p) (i32.load8_u offset=64 (local.get $p)))
          (i64.store offset=8 (local.get $p) (i64.load offset=72 (local.get $p)))
          (i64.store offset=16 (local.get $p) (i64.load offset=32 (local.get $p)))
          (call $queue (local.get $c) (local.get $p) (i32.const 24))
          (i32.store (local.get $c) (i32.const 5)) return))
      (if (i32.eq (i32.load offset=120 (local.get $c)) (i32.const 3))
        (then (call $file-directory (i32.load offset=108 (local.get $c)) (i32.const 0)))
        (else (call $file-read (i32.load offset=108 (local.get $c)) (i64.const 0) (i32.const 0))))
      (i32.store offset=52 (local.get $c) (i32.load (i32.const 0)))
      (i32.store offset=56 (local.get $c) (i32.load (i32.const 4)))
      (call $join (i32.load offset=52 (local.get $c)) (global.get $set))
      (i32.store (local.get $c) (select (i32.const 9) (i32.const 8)
        (i32.eq (i32.load offset=120 (local.get $c)) (i32.const 3)))))
    (func $filesystem-directory-result (param $c i32) (param $r i32)
      (local $p i32) (local $name i32) (local $length i32)
      (i32.store offset=60 (local.get $c) (i32.const 0))
      (local.set $p (i32.add (call $input (local.get $c)) (i32.const 42000)))
