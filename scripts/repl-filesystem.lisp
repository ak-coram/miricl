      (call $queue (local.get $c) (local.get $p) (i32.sub (local.get $end) (local.get $p))))
    (func $filesystem-free-variant (param $p i32) (param $kind i32)
      (if (i32.and (i32.eq (i32.load8_u (local.get $p)) (local.get $kind)) (i32.load8_u offset=4 (local.get $p)))
        (then (drop (call $realloc (i32.load offset=8 (local.get $p)) (i32.load offset=12 (local.get $p)) (i32.const 1) (i32.const 0))))))
    (func $filesystem-request (param $c i32) (param $path i32) (param $size i32)
      (local $kind i32) (local $host i64) (local $p i32) (local $n i32) (local $i i32) (local $ok i32)
      (i32.store offset=116 (local.get $c) (local.get $size))
      (if (i32.lt_u (local.get $size) (i32.const 19)) (then return))
      (if (call $equal (local.get $path) (i32.const 19400) (i32.const 19)) (then (local.set $kind (i32.const 1))))
      (if (call $equal (local.get $path) (i32.const 19432) (i32.const 19)) (then (local.set $kind (i32.const 2))))
      (if (call $equal (local.get $path) (i32.const 19464) (i32.const 19)) (then (local.set $kind (i32.const 3))))
      (if (i32.eqz (local.get $kind)) (then return))
