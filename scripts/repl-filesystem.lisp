      (local.set $host (call $header (call $input (local.get $c)) (i32.load offset=32 (local.get $c)) (i32.const 19500) (i32.const 4)))
      (local.set $p (i32.wrap_i64 (local.get $host)))
      (local.set $n (i32.wrap_i64 (i64.shr_u (local.get $host) (i64.const 32))))
      (block $end (loop $host
        (br_if $end (i32.ge_u (local.get $i) (local.get $n)))
        (br_if $end (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 58)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $host)))
      (local.set $ok (i32.or
        (i32.and (i32.eq (local.get $i) (i32.const 9)) (call $equal (local.get $p) (i32.const 19510) (i32.const 9)))
        (i32.and (i32.eq (local.get $i) (i32.const 9)) (call $equal (local.get $p) (i32.const 19530) (i32.const 9)))))
      (local.set $host (call $header (call $input (local.get $c)) (i32.load offset=32 (local.get $c)) (i32.const 16530) (i32.const 6)))
