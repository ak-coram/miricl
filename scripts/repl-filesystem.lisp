              (i32.store offset=28 (local.get $p) (local.get $length))
              (call $queue (local.get $c) (i32.add (local.get $p) (i32.const 24)) (i32.const 8))
              (call $queue (local.get $c) (local.get $name) (local.get $length))))
          (drop (call $realloc (local.get $name) (local.get $length) (i32.const 1) (i32.const 0)))
