        (then (call $http-error (local.get $c) (i32.const 19700) (i32.const 96)) return))
      (call $mime (local.get $c))
      (if (i32.load offset=112 (local.get $c)) (then (i32.store (local.get $c) (i32.const 5)) return))
      (if (i32.eq (i32.load offset=120 (local.get $c)) (i32.const 1))
        (then
