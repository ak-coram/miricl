;;;; Binary metadata and directory endpoints for the browser's dev filesystem.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun repl-filesystem-allocator-wat ()
  ;; Canonical directory streams allocate names. Free them after serialization
  ;; so repeated ASDF scans don't exhaust the relay's canonical heap.
  (let ((wat #@(allocator
    (global $heap (mut i32) (i32.const 32768))
    (global $free (mut i32) (i32.const 0))
    (func $realloc (export "realloc") (param $old i32) (param $old-size i32)
      (param $align i32) (param $size i32) (result i32)
      (local $p i32) (local $previous i32) (local $capacity i32)
      (if (i32.eqz (local.get $size))
        (then
          (if (local.get $old)
            (then (i32.store (i32.sub (local.get $old) (i32.const 12)) (global.get $free))
              (global.set $free (local.get $old)))) (return (i32.const 0))))
      (if (i32.gt_u (local.get $align) (i32.const 16)) (then unreachable))
      (local.set $capacity (i32.and (i32.add (local.get $size) (i32.const 15)) (i32.const -16)))
      (local.set $p (global.get $free))
      (block $found (loop $scan
        (br_if $found (i32.eqz (local.get $p)))
        (if (i32.ge_u (i32.load (i32.sub (local.get $p) (i32.const 16))) (local.get $capacity))
          (then
            (if (local.get $previous)
              (then (i32.store (i32.sub (local.get $previous) (i32.const 12)) (i32.load (i32.sub (local.get $p) (i32.const 12)))))
              (else (global.set $free (i32.load (i32.sub (local.get $p) (i32.const 12))))))
            (br $found)))
        (local.set $previous (local.get $p))
        (local.set $p (i32.load (i32.sub (local.get $p) (i32.const 12)))) (br $scan)))
      (if (i32.eqz (local.get $p))
        (then
          (local.set $p (i32.add (global.get $heap) (i32.const 16)))
          (global.set $heap (i32.add (local.get $p) (local.get $capacity)))
          (if (i32.gt_u (global.get $heap) (i32.const 65536)) (then unreachable))
          (i32.store (i32.sub (local.get $p) (i32.const 16)) (local.get $capacity))))
      (if (local.get $old)
        (then
          (memory.copy (local.get $p) (local.get $old)
            (select (local.get $old-size) (local.get $size) (i32.lt_u (local.get $old-size) (local.get $size))))
          (drop (call $realloc (local.get $old) (local.get $old-size) (local.get $align) (i32.const 0)))))
      (local.get $p)))))
    (wat-fragment (subseq wat 11 (1- (length wat))))))

(defun repl-filesystem-wat ()
  (let ((wat #@(functions
    (data (i32.const 19400) "__miricl__/fs/stat/")
