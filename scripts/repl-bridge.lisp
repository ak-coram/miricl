(defun wasm-with-custom-section (wasm name payload)
  (let ((section (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (labels ((u32 (n into)
               (loop (vector-push-extend (logior (logand n 127) (if (> n 127) 128 0)) into)
                     (setf n (ash n -7)) (when (zerop n) (return)))))
      (u32 (length name) section)
      (loop for ch across name do (vector-push-extend (char-code ch) section))
      (loop for byte across payload do (vector-push-extend byte section))
      (let ((out (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
        (loop for byte across wasm do (vector-push-extend byte out))
        (vector-push-extend 0 out) (u32 (length section) out)
        (loop for byte across section do (vector-push-extend byte out))
        out))))
