;;;; Shared native keyword binding for counting, searching, and removal.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; FAMILY: COUNT=0, FIND/POSITION=1, REMOVE/DELETE=2, duplicates=3, substitution=4.
(define-runtime-function $sequence-operation-apply
    (($args :nullable-object) ($family i32) ($mode i32) ($result-kind i32)) (:nullable-object)
  (:locals ($item :nullable-object) ($sequence :nullable-object) ($scan :nullable-object)
           ($keyword :nullable-object) ($value :nullable-object) ($key :nullable-object)
           ($test :nullable-object) ($test-not :nullable-object) ($start :nullable-object)
           ($end :nullable-object) ($from-end :nullable-object) ($count :nullable-object)
           ($new :nullable-object) ($id i32) ($seen i32) ($unknown i32) ($allow i32) ($negate i32))
  #@(if (i32.eq (local.get $family) (i32.const 4))
    (then
      ,(wat-fail-when #@(ref.is_null (local.get $args)) :wrong-arity)
      (local.set $new (call $car (local.get $args)))
      (local.set $args (call $cdr (local.get $args)))))
  (wat-fail-when #@(ref.is_null (local.get $args)) :wrong-arity)
  #@(local.set $item (call $car (local.get $args)))
  #@(local.set $scan (call $cdr (local.get $args)))
  #@(if (i32.eq (local.get $family) (i32.const 3))
    (then (local.set $sequence (local.get $item)))
    (else
      ,(wat-fail-when #@(ref.is_null (local.get $scan)) :wrong-arity)
      (local.set $sequence (call $car (local.get $scan)))
      (local.set $scan (call $cdr (local.get $scan)))))
  #@(block $bound (loop $keys (br_if $bound (ref.is_null (local.get $scan)))
    (local.set $keyword (call $car (local.get $scan)))
    (local.set $scan (call $cdr (local.get $scan)))
    ,(wat-fail-when #@(ref.is_null (local.get $scan)) :wrong-arity)
    (local.set $value (call $car (local.get $scan)))
    (local.set $scan (call $cdr (local.get $scan)))
    (local.set $id (call $id (local.get $keyword)))
    ,(runtime-wat-forms
      (loop for (keyword variable enabled) in
        '((:key $key nil) (:test $test (i32.eqz (local.get $mode)))
          (:test-not $test-not (i32.eqz (local.get $mode))) (:start $start nil)
          (:end $end nil) (:from-end $from-end nil)
          (:count $count (i32.or (i32.eq (local.get $family) (i32.const 2)) (i32.eq (local.get $family) (i32.const 4))))
          (:allow-other-keys $allow nil))
        for bit = 1 then (* bit 2) collect
        `(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id keyword)))
          (then
            ,@(when enabled
              `((if (i32.eqz ,enabled)
                  (then (local.set $unknown (i32.const 1)) (br $keys)))))
            (if (i32.eqz (i32.and (local.get $seen) (i32.const ,bit)))
              (then (local.set ,variable
                      ,(if (eq variable '$allow)
                           '(i32.eqz (ref.is_null (local.get $value))) '(local.get $value)))
                (local.set $seen (i32.or (local.get $seen) (i32.const ,bit)))))
            (br $keys)))))
    (local.set $unknown (i32.const 1)) (br $keys)))
  (wat-fail-when #@(i32.and (local.get $unknown) (i32.eqz (local.get $allow))) :wrong-arity)
  (wat-fail-when #@(i32.eq (i32.and (local.get $seen) (i32.const 6)) (i32.const 6)) :wrong-arity)
  #@(local.set $negate (i32.ne (i32.and (local.get $seen) (i32.const 4)) (i32.const 0)))
  #@(if (i32.eqz (i32.and (local.get $seen) (i32.const 2)))
    (then (local.set $test (call $fdefinition (call $symbol (i32.const ,(runtime-symbol-id 'eql)))))))
  #@(if (i32.eqz (i32.and (local.get $seen) (i32.const 8)))
    (then (local.set $start (call $int (i32.const 0)))))
  #@(if (i32.eqz (local.get $family))
    (then (return (call $count-sequence-native (local.get $mode) (local.get $item) (local.get $sequence)
      (local.get $key) (local.get $test) (local.get $test-not) (local.get $start) (local.get $end)
      (local.get $from-end) (local.get $negate)))))
  #@(if (i32.eq (local.get $family) (i32.const 1))
    (then (return (call $find-sequence-native (local.get $mode) (local.get $item) (local.get $sequence)
      (local.get $key) (local.get $test) (local.get $test-not) (local.get $negate)
      (local.get $start) (local.get $end) (i32.eqz (ref.is_null (local.get $from-end))) (local.get $result-kind)))))
  #@(if (i32.eq (local.get $family) (i32.const 3))
    (then (return (call $remove-duplicates-native (local.get $sequence) (local.get $key)
      (local.get $test) (local.get $test-not) (local.get $negate)
      (local.get $start) (local.get $end) (i32.eqz (ref.is_null (local.get $from-end))) (local.get $result-kind)))))
  #@(call $remove-sequence-native (local.get $mode) (local.get $item) (local.get $sequence)
    (local.get $key) (local.get $test) (local.get $test-not) (local.get $negate)
    (local.get $start) (local.get $end) (i32.eqz (ref.is_null (local.get $from-end)))
    (local.get $count) (local.get $result-kind) (local.get $new)
    (i32.eq (local.get $family) (i32.const 4))))

(define-runtime-section sequence-binding-runtime-wat ()
  ($sequence-operation-apply))
