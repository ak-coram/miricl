;;;; Indexed binary FASL units. Chunk addresses are relative to the payload,
;;;; independent of a bundle's outer Wasm sections. Object references remain
;;;; unit-local IDs; moving a chunk never changes literal identity.
(in-package :miricl-compiler)

(defconstant +fasl-block-size+ 256)
(defvar *binary-strings* nil)
(defvar *binary-last-string* nil)
(defvar *binary-limit* nil)

(defun write-u32 (value stream)
  (unless (typep value '(unsigned-byte 32)) (error "FASL offset exceeds 32 bits."))
  (dotimes (i 4) (write-byte (ldb (byte 8 (* i 8)) value) stream)))

(defun read-u32 (stream)
  (loop for shift from 0 below 32 by 8 sum (ash (read-byte stream) shift)))

(defun write-padded-uleb (value stream)
  (dotimes (i 5)
    (write-byte (logior (logand value 127) (if (< i 4) 128 0)) stream)
    (setq value (ash value -7))))

(defun binary-byte (stream)
  (when (>= (file-position stream) *binary-limit*) (error "Truncated binary FASL value."))
  (read-byte stream))

(defun binary-uleb (stream)
  (loop with value = 0 for shift from 0 below 35 by 7 for byte = (binary-byte stream) do
    (when (and (= shift 28) (> byte 7)) (error "Binary FASL integer exceeds its range."))
    (setq value (logior value (ash (logand byte 127) shift)))
    (when (< byte 128) (return-from binary-uleb value)))
  (error "Invalid binary FASL integer."))

(defun uleb-size (value)
  (max 1 (ceiling (integer-length value) 7)))

(defun encode-value (value stream &optional (depth 0))
  ;; Only FASL descriptions are encoded here. Actual Lisp objects, including
  ;; cyclic constants, already have stable object records and integer edges.
  (when (> depth 64) (error "Binary FASL description is too deeply nested."))
  (cond
    ((null value) (write-byte 0 stream))
    ((eq value t) (write-byte 6 stream))
    ((integerp value)
     (unless (<= (- #x7fffffff) value #x7fffffff) (error "Binary FASL integer exceeds its range."))
     (write-byte (if (minusp value) 2 1) stream) (write-uleb (abs value) stream))
    ((stringp value)
     (multiple-value-bind (index found) (gethash value *binary-strings*)
       (if found (progn (write-byte 4 stream) (write-uleb index stream))
           (let* ((bytes (utf8-bytes value)) (prefix 0)
                  (index (hash-table-count *binary-strings*)))
             (when *binary-last-string*
               (loop while (and (< prefix (length value)) (< prefix (length *binary-last-string*))
                                (char= (char value prefix) (char *binary-last-string* prefix))) do (incf prefix)))
             (let* ((prefix-bytes (length (utf8-bytes (subseq value 0 prefix))))
                    (prefix-header (+ (uleb-size (1- index)) (uleb-size prefix)))
                    (suffix-bytes (- (length bytes) prefix-bytes))
                    (latin1 (and (> (length bytes) (length value))
                      (every (lambda (character) (< (char-code character) 256)) value)))
                    (use-prefix (and (plusp prefix) (> prefix-bytes prefix-header)
                      (or (not latin1)
                          (< (+ prefix-header (uleb-size suffix-bytes) suffix-bytes)
                             (+ (uleb-size (length value)) (length value)))))))
               (if use-prefix
                   (progn (write-byte 9 stream) (write-uleb (1- index) stream) (write-uleb prefix stream)
                     (write-uleb (- (length bytes) prefix-bytes) stream) (write-sequence bytes stream :start prefix-bytes))
                   ;; Byte-valued strings include native modules. Preserve
                   ;; their characters directly instead of expanding every
                   ;; high byte into two UTF-8 bytes.
                   (if latin1
                       (progn (write-byte 11 stream) (write-uleb (length value) stream)
                         (loop for character across value do (write-byte (char-code character) stream)))
                       (progn (write-byte 3 stream) (write-uleb (length bytes) stream) (write-sequence bytes stream)))))
             (setf (gethash value *binary-strings*) index *binary-last-string* value)))))
    ((keywordp value) (write-byte 5 stream) (encode-value (symbol-name value) stream (1+ depth)))
    ((consp value)
     (let ((length (list-length value)))
       (unless length (error "Circular FASL description."))
       (write-byte 7 stream) (write-uleb length stream)
       (dolist (item value) (encode-value item stream (1+ depth)))))
    ((typep value 'simple-vector)
     (write-byte 8 stream) (write-uleb (length value) stream)
     (loop for item across value do (encode-value item stream (1+ depth))))
    (t (error "Unsupported binary FASL description: ~S." value))))

(defun decode-value (stream &optional (depth 0))
  (when (> depth 64) (error "Binary FASL description is too deeply nested."))
  (let ((tag (binary-byte stream)))
   (case tag
    (0 nil) (1 (binary-uleb stream)) (2 (- (binary-uleb stream)))
    ((3 9 11)
     (let ((base nil) (prefix 0))
       (when (= tag 9)
         (let ((index (binary-uleb stream)))
           (unless (< index (length *binary-strings*)) (error "Invalid FASL string prefix reference."))
           (setq base (aref *binary-strings* index) prefix (binary-uleb stream))
           (unless (<= prefix (length base)) (error "Invalid FASL string prefix length."))))
       (let* ((size (binary-uleb stream)) (end (+ (file-position stream) size)))
         (when (> end *binary-limit*) (error "Truncated binary FASL string."))
         (let ((text (if (= tag 11)
                         (let ((text (make-string size)))
                           (dotimes (i size text) (setf (char text i) (code-char (binary-byte stream)))))
                         (payload-text stream end))))
           (file-position stream end)
           (when base (setq text (concatenate 'string (subseq base 0 prefix) text)))
           (vector-push-extend text *binary-strings*) text))))
    (4 (let ((index (binary-uleb stream)))
         (unless (< index (length *binary-strings*)) (error "Invalid binary FASL string reference."))
         (aref *binary-strings* index)))
    (5 (let ((name (decode-value stream (1+ depth))))
         (unless (stringp name) (error "Invalid binary FASL keyword."))
         (intern name "KEYWORD")))
    (6 t)
    ((7 8) (error "Internal binary FASL sequence decoder mismatch."))
    (otherwise (error "Unknown binary FASL value tag.")))))

(defun decode-sequence-value (stream &optional (depth 0))
  ;; The portable reader uses the same tagged grammar as the native codec.
  (when (> depth 64) (error "Binary FASL description is too deeply nested."))
  (let* ((start (file-position stream)) (tag (binary-byte stream)))
    (when (= tag 10) (return-from decode-sequence-value (decode-record-block stream depth)))
    (if (member tag '(7 8))
        (let ((size (binary-uleb stream)))
          (when (> size (- *binary-limit* (file-position stream)))
            (error "Invalid binary FASL sequence length."))
          (if (= tag 7)
              (loop repeat size collect (decode-sequence-value stream (1+ depth)))
              (let ((result (make-array size)))
                (dotimes (i size) (setf (aref result i) (decode-sequence-value stream (1+ depth)))) result)))
        (progn (file-position stream start)
               (if (= tag 5)
                   (progn (binary-byte stream)
                          (let ((name (decode-sequence-value stream (1+ depth))))
                            (unless (stringp name) (error "Invalid binary FASL keyword."))
                            (intern name "KEYWORD")))
                   (decode-value stream depth))))))

(defun compact-cons-record-p (record)
  (and (= (first record) 5) (= (length record) 4) (<= 0 (fourth record) 2)
       (<= 0 (second record) #x3fffffff) (<= 0 (third record) #x3fffffff)))

(defun record-edge-delta (child id)
  (let ((delta (- child id))) (if (minusp delta) (1- (* -2 delta)) (* 2 delta))))

(defun encode-record-edge (child id stream &optional (mode 0))
  ;; An even word is an absolute ID; an odd word holds a zigzag delta. Common
  ;; pooled atoms and nearby subexpressions both get short references.
  (let ((delta (record-edge-delta child id)))
    (write-uleb (case mode (1 child) (2 delta) (otherwise (min (* 2 child) (1+ (* 2 delta))))) stream)))

(defun decode-record-edge (stream id &optional (mode 0))
  (let* ((encoded (binary-uleb stream))
         (value (if (zerop mode) (ash encoded -1) encoded))
         (relative (if (zerop mode) (oddp encoded) (= mode 2)))
         (child (if relative (+ id (if (oddp value) (- (1+ (ash value -1))) (ash value -1))) value)))
    (unless (<= 0 child #x7fffffff) (error "Invalid FASL reference."))
    child))

(defun encode-record-block (records base stream)
  ;; A run reconstructs exactly the same individual cons records and IDs. Its
  ;; internal CDR edges are implicit; CAR edges and the last CDR remain explicit.
  ;; Runs never cross an independently addressable record block.
  (write-byte 10 stream) (write-uleb base stream) (write-uleb (length records) stream)
  (loop with i = 0 with last-package = nil with last-namespace = nil while (< i (length records)) do
   (let* ((record (aref records i)) (id (+ base i)) (run 1) (bitmap nil) (zero-tail nil))
    (case (first record)
      (0 (write-byte 1 stream))
      (1 (write-byte 2 stream) (encode-value (second record) stream))
      (2 (write-byte 3 stream) (write-uleb (second record) stream))
      (3 (write-byte 4 stream) (encode-value (second record) stream))
      (4 (if (and (equal (third record) last-package) (eql (fourth record) last-namespace))
             (progn (write-byte 12 stream) (encode-value (second record) stream))
             (progn (write-byte 5 stream) (encode-value (second record) stream)
               (encode-value (third record) stream) (write-uleb (fourth record) stream)))
         (setq last-package (third record) last-namespace (fourth record)))
      (11
       (write-byte 13 stream)
       (write-uleb (second record) stream) (write-uleb (third record) stream)
       (write-uleb (length (fourth record)) stream)
       (dolist (reference (fourth record))
         (unless (and (integerp reference) (<= -1 reference #x7ffffffe))
           (error "Invalid saved slot reference."))
         ;; Zero denotes an unbound slot; NIL has its own nonnegative ID.
         (write-uleb (1+ reference) stream)))
      (otherwise
       (if (compact-cons-record-p record)
           (progn
             (loop while (and (< (+ i run) (length records))
                              (= (third (aref records (+ i run -1))) (+ id run))
                              (compact-cons-record-p (aref records (+ i run)))
                              (zerop (fourth (aref records (+ i run))))) do (incf run))
             (setq zero-tail (zerop (third (aref records (+ i run -1)))))
             (when (and zero-tail (<= run 5))
               (setq bitmap 0)
               (dotimes (j run)
                 (let ((child (second (aref records (+ i j)))))
                   (when (< (record-edge-delta child (+ id j)) child)
                     (setq bitmap (logior bitmap (ash 1 j)))))))
             (cond (bitmap (write-byte (+ 10 (* (+ 3 (fourth record)) (ash 1 run)) bitmap) stream))
                   ((and zero-tail (<= run 16)) (write-byte (+ 202 (* 11 (fourth record)) (- run 6)) stream))
                   (t (write-byte (+ (if zero-tail 9 6) (fourth record)) stream) (write-uleb run stream)))
             (dotimes (j run)
               (encode-record-edge (second (aref records (+ i j))) (+ id j) stream
                 (if bitmap (if (logbitp j bitmap) 2 1) 0)))
             (unless zero-tail
               (encode-record-edge (third (aref records (+ i run -1))) (+ id run -1) stream)))
           (progn (write-byte 0 stream) (encode-value record stream)))))
    (incf i run))))

(defun list-run-parameters (tag stream)
  (cond ((<= 6 tag 11) (values (binary-uleb stream) (- tag (if (>= tag 9) 9 6)) nil (>= tag 9)))
        ((>= tag 202) (values (+ 6 (mod (- tag 202) 11)) (floor (- tag 202) 11) nil t))
        (t (let* ((run (1- (integer-length (floor (- tag 10) 3))))
                  (stride (ash 1 run)) (info (- tag (+ 10 (* 3 stride)))))
             (values run (floor info stride) (logand info (1- stride)) t)))))

(defun decode-record-block (stream depth)
  (let* ((base (binary-uleb stream)) (count (binary-uleb stream)) (result nil)
         (last-package nil) (last-namespace nil))
    (unless (and (<= (+ base count) #x7fffffff)
                 (<= count (- *binary-limit* (file-position stream))))
      (error "Invalid binary FASL record block."))
    (setq result (make-array count))
    (loop with i = 0 while (< i count) do
      (let ((tag (binary-byte stream)))
        (if (or (<= 6 tag 11) (<= 16 tag 234))
            (multiple-value-bind (run flags bitmap zero-tail) (list-run-parameters tag stream)
              (unless (<= 1 run (- count i)) (error "Invalid FASL list run."))
              ;; Read CARs first, then the last CDR, matching the run grammar.
              (dotimes (j run)
                (setf (aref result (+ i j))
                  (list 5 (decode-record-edge stream (+ base i j) (if bitmap (if (logbitp j bitmap) 2 1) 0))
                    (+ base i j 1) (if (zerop j) flags 0))))
              (setf (third (aref result (+ i run -1)))
                (if zero-tail 0 (decode-record-edge stream (+ base i run -1))))
              (incf i run))
            (progn
              (setf (aref result i)
               (case tag
            (0 (decode-sequence-value stream (1+ depth)))
            (1 '(0))
            ((2 4) (list (if (= tag 2) 1 3) (decode-sequence-value stream (1+ depth))))
            (3 (list 2 (binary-uleb stream)))
            (13
             (let ((class (binary-uleb stream)) (names (binary-uleb stream))
                   (size (binary-uleb stream)))
               (unless (<= size (- *binary-limit* (file-position stream)))
                 (error "Invalid saved slot count."))
               (list 11 class names
                 (loop repeat size for reference = (binary-uleb stream) collect
                   (if (<= reference #x7fffffff) (1- reference)
                       (error "Invalid saved slot reference."))))))
            ((5 12)
             (let ((name (decode-sequence-value stream (1+ depth))))
               (if (= tag 5)
                   (setq last-package (decode-sequence-value stream (1+ depth)) last-namespace (binary-uleb stream))
                   (unless last-namespace (error "Missing FASL symbol domain.")))
               (list 4 name last-package last-namespace)))
                (otherwise (error "Unknown binary FASL record opcode."))))
              (incf i)))))
    result))

(defun write-binary-chunk (value stream &optional record-base)
  (multiple-value-bind (bytes native) (compiler-primitive 15 value record-base)
    (when native (write-sequence bytes stream) (return-from write-binary-chunk (length bytes))))
  (let ((*binary-strings* (make-hash-table :test 'equal)) (*binary-last-string* nil) (start (file-position stream)))
    (if record-base (encode-record-block value record-base stream) (encode-value value stream))
    (- (file-position stream) start)))

(defun read-binary-chunk (stream start end)
  (multiple-value-bind (value native) (compiler-primitive 16 stream start end)
    (when native (return-from read-binary-chunk value)))
  (let ((*binary-strings* (make-array 16 :adjustable t :fill-pointer 0)) (*binary-limit* end))
    (file-position stream start)
    (let ((value (decode-sequence-value stream)))
      (unless (= (file-position stream) end) (error "Trailing binary FASL chunk data.")) value)))

(defun definition-directory (metadata)
  (when metadata
    (let ((groups (make-hash-table)) (result nil))
      (dolist (entry (third metadata))
        (let* ((descriptor (second entry)) (group (first descriptor)) (node (gethash group groups)))
          (unless node
            (setq node (list (second descriptor) (third descriptor) (fourth descriptor) nil))
            (setf (gethash group groups) node) (push node result))
          (when (fourth descriptor) (setf (third node) t))
          (push (first entry) (fourth node))))
      (list (second metadata) (nreverse result)))))

(defun write-indexed-unit (stream roots records &key metadata definitions)
  (let* ((blocks (ceiling (length records) +fasl-block-size+))
         (chunks (+ 1 blocks (if metadata 1 0) (if (or definitions metadata) 1 0)))
         (section (file-position stream)) (payload (+ section 18))
         (directory (+ payload 20)) (entries nil) (end 0))
    ;; A fixed-width, legal Wasm ULEB reserves the section length for patching.
    (write-byte 0 stream) (write-padded-uleb 0 stream) (write-byte 11 stream)
    (loop for character across "miricl.fasl" do (write-byte (char-code character) stream))
    (dolist (byte '(77 73 82 70)) (write-byte byte stream))
    ;; Advertise byte-valued strings (bit 2) and dense slots (bit 1), so older
    ;; readers reject unsupported units before executing any initializer.
    (write-u32 (logior 4 (if metadata 1 0) (if (find 11 records :key #'first) 2 0)) stream)
    (write-u32 (length records) stream)
    (write-u32 chunks stream) (write-u32 +fasl-block-size+ stream)
    (dotimes (i (* chunks 16)) (write-byte 0 stream))
    (flet ((chunk (kind key value &optional record-base)
             (let ((start (file-position stream)))
               (write-binary-chunk value stream record-base)
               (push (list kind key (- start payload) (- (file-position stream) start)) entries))))
      (chunk 1 0 roots)
      (when metadata (chunk 2 0 metadata))
      (when (or definitions metadata) (chunk 4 0 (or definitions (definition-directory metadata))))
      (dotimes (block blocks)
        (let ((start (* block +fasl-block-size+)))
          (chunk 3 block (subseq records start (min (length records) (+ start +fasl-block-size+))) start))))
    (setq end (file-position stream))
    (file-position stream directory)
    (dolist (entry (nreverse entries)) (dolist (value entry) (write-u32 value stream)))
    (file-position stream (1+ section)) (write-padded-uleb (- end section 6) stream)
    (file-position stream end)
    (- end section)))

(defun read-indexed-directory (stream start end)
  (file-position stream start)
  (unless (>= (- end start) 20) (error "Truncated binary FASL header."))
  (dolist (byte '(77 73 82 70))
    (unless (= byte (read-byte stream)) (error "Invalid binary FASL magic.")))
  (let ((flags (read-u32 stream)) (records (read-u32 stream))
        (count (read-u32 stream)) (block-size (read-u32 stream)) (entries nil))
    (unless (and (<= flags 7) (= block-size +fasl-block-size+)
                 (<= records #x7fffffff) (<= count (floor (- end start 20) 16))
                 (<= records (- end start 20 (* count 16))))
      (error "Unsupported binary FASL header."))
    (let ((minimum (+ 20 (* count 16))) (last (+ 20 (* count 16))))
      (dotimes (i count)
        (let ((kind (read-u32 stream)) (key (read-u32 stream))
              (offset (read-u32 stream)) (size (read-u32 stream)))
          (unless (and (>= offset minimum) (>= offset last) (> size 0) (<= (+ offset size) (- end start)))
            (error "Overlapping or out-of-range binary FASL chunk."))
          (setq last (+ offset size))
          (push (list kind key (+ start offset) (+ start offset size)) entries)))
      (unless (= last (- end start)) (error "Trailing binary FASL unit data.")))
    (values records (nreverse entries) flags)))

(defun read-indexed-payload (stream start end metadata-p &optional (records-p t))
  (multiple-value-bind (count entries flags) (read-indexed-directory stream start end)
    (let ((roots nil) (rootp nil) (metadata nil) (records (and records-p (make-array count)))
          (blocks (make-hash-table)) (metap nil) (definitionsp nil))
      (dolist (entry entries)
        (destructuring-bind (kind key first last) entry
          (case kind
            (1 (when (or rootp (/= key 0)) (error "Duplicate binary FASL roots."))
               (setq rootp t roots (read-binary-chunk stream first last)))
            (2 (when (or metap (/= key 0)) (error "Duplicate binary FASL metadata."))
               (setq metap t)
               (when metadata-p (setq metadata (read-binary-chunk stream first last))))
            (3 (let ((offset (* key +fasl-block-size+)))
                 (when (or (gethash key blocks) (>= offset count)) (error "Invalid binary FASL record block."))
                 (setf (gethash key blocks) t)
                 (when records-p
                  (let ((block (read-binary-chunk stream first last)))
                   (unless (and (typep block 'simple-vector)
                                (= (length block) (min +fasl-block-size+ (- count offset))))
                     (error "Invalid binary FASL record block size."))
                   (replace records block :start1 offset)))))
            (4 (when (or definitionsp (/= key 0)) (error "Duplicate binary FASL definition directory."))
               (setq definitionsp t))
            (otherwise (error "Unsupported binary FASL chunk kind ~D." kind)))))
      (unless (and rootp (listp roots) (eq metap (logbitp 0 flags))
                   (= (hash-table-count blocks) (ceiling count +fasl-block-size+)))
        (error "Missing binary FASL roots or records."))
      (values (list roots records metadata) count))))

(defun read-unit-payload (stream end &key metadata (records t))
  (read-indexed-payload stream (file-position stream) end metadata records))
