;;;; Buffered file streams over the portable mounted filesystem.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; A registry entry is (canonical-name . cached-source), with its spare C field
;; holding a byte buffer. The buffer reuses the existing growable stream layout.
;; Its specialized cons layout also carries an optional modification timestamp.
;; An open stream owns a private descriptor (entry, original pathname, rollback
;; entry), a byte cursor, and five integers: flags, element bytes, sign, last
;; character position, and output column. Ordinary string streams stay unchanged.

(define-runtime-function $file-time () (f64)
  ;; An unattached clock leaves the modification date unknown, as ANSI permits.
  #@(if (result f64) (ref.is_null (table.get $host-services (i32.const 0)))
    (then (f64.const -1))
    (else (call_indirect $host-services (type $host-service-type)
      (i32.const 0) (f64.const 0) (i32.const 0)))))

(define-runtime-function $new-source-file (($path :nullable-object) ($text :nullable-object)) (:nullable-object)
  #@(struct.new $source-entry (i32.const 7) (i32.const 0) (f64.const 0) (ref.null $digits)
    (local.get $path) (local.get $text) (ref.null eq) (call $file-time)))

(define-runtime-function $touch-source-file (($entry :nullable-object)) ()
  #@(struct.set $source-entry $modified (ref.cast (ref $source-entry) (local.get $entry)) (call $file-time))
  #@(struct.set $obj $n (ref.cast (ref $obj) (local.get $entry)) (i32.const 0)))

(define-runtime-function $flush-source-file (($entry :nullable-object)) ()
  #@(if (call $value-n (local.get $entry)) (then (call $touch-source-file (local.get $entry)))))

(define-runtime-function $file-error (($path :nullable-object)) ()
  #@(drop (call $apply (call $symbol (i32.const ,(runtime-symbol-id 'error)))
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'file-error)))
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id :pathname)))
        (call $cons (local.get $path) (ref.null eq))))))
  #@(unreachable))

(define-runtime-function $file-type-error (($stream :nullable-object) ($binary i32)) ()
  #@(call $type-fail (local.get $stream)
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'satisfies)))
      (call $cons (if (result (ref null eq)) (local.get $binary)
        (then ,(clos-library-reference '%binary-file-stream-p))
        (else ,(clos-library-reference '%character-file-stream-p))) (ref.null eq)))
    (i32.const ,(runtime-error-code :expected-designator)))
  #@(unreachable))

(define-runtime-function $file-buffer (($entry :nullable-object)) ((ref $text-stream))
  (:locals ($buffer (ref $text-stream)) ($start i32) ($length i32) ($i i32) ($data :digits))
  #@(if (i32.eqz (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $entry)))))
    (then (return (ref.cast (ref $text-stream) (struct.get $obj $c (ref.cast (ref $obj) (local.get $entry)))))))
  #@(local.set $buffer (ref.cast (ref $text-stream) (call $report-stream)))
  #@(if (i32.eqz (ref.is_null (struct.get $obj $b (ref.cast (ref $obj) (local.get $entry)))))
    (then
      (local.set $start (global.get $cursor))
      (call $print-text (struct.get $obj $b (ref.cast (ref $obj) (local.get $entry))))
      (local.set $length (i32.sub (global.get $cursor) (local.get $start)))
      (global.set $cursor (local.get $start))
      (local.set $data (array.new_default $digits (local.get $length)))
      (block $done (loop $copy (br_if $done (i32.eq (local.get $i) (local.get $length)))
        (array.set $digits (local.get $data) (local.get $i) (i32.load8_u (i32.add (local.get $start) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
      (struct.set $text-stream $data (local.get $buffer) (local.get $data))
      (struct.set $text-stream $length (local.get $buffer) (local.get $length))))
  #@(struct.set $obj $c (ref.cast (ref $obj) (local.get $entry)) (local.get $buffer))
  #@(local.get $buffer))

(defun $compiled-file-p-cl ()
  (runtime-function-definition '$compiled-file-p-cl
    (wat-fragment (miricl-cross:runtime-kernel-wat '$compiled-file-p-cl 'miricl-runtime:compiled-byte-header-p :result :truth))))

(define-runtime-function $compiled-file-p (($entry :nullable-object)) (i32)
  (:locals ($buffer (ref $text-stream)) ($data :digits) ($length i32) ($source :nullable-object))
  #@(local.set $source (struct.get $obj $b (ref.cast (ref $obj) (local.get $entry))))
  #@(local.set $data (if (result (ref $digits)) (ref.is_null (local.get $source))
    (then (local.set $buffer (call $file-buffer (local.get $entry)))
      (local.set $length (struct.get $text-stream $length (local.get $buffer)))
      (struct.get $text-stream $data (local.get $buffer)))
    (else (local.set $length (array.len (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $source))))))
      (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $source)))))))
  #@(call $compiled-file-p-cl (call $text (local.get $data)) (call $int (local.get $length))))

(define-runtime-function $compiled-source (($stream :nullable-object) ($start :nullable-object) ($end :nullable-object)) (:nullable-object)
  (:locals ($buffer (ref $text-stream)) ($data :digits) ($first i32) ($last i32) ($size i32) ($i i32))
  #@(local.set $buffer (call $file-buffer (struct.get $obj $a (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream)))))))
  #@(local.set $data (struct.get $text-stream $data (local.get $buffer)))
  #@(local.set $first (call $natural-count (local.get $start)))
  #@(local.set $last (call $natural-count (local.get $end)))
  (wat-fail-when #@(i32.or (i32.lt_u (local.get $last) (local.get $first))
    (i32.gt_u (local.get $last) (struct.get $text-stream $length (local.get $buffer)))) :reader-syntax)
  #@(local.set $size (i32.sub (local.get $last) (local.get $first)))
  #@(call $reserve (local.get $size))
  #@(block $done (loop $copy
    (br_if $done (i32.eq (local.get $i) (local.get $size)))
    (i32.store8 (i32.add (global.get $cursor) (local.get $i))
      (array.get $digits (local.get $data) (i32.add (local.get $first) (local.get $i))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
  #@(call $decode-text (global.get $cursor) (local.get $size)))

(define-runtime-function $file-source (($entry :nullable-object)) (:nullable-object)
  (:locals ($buffer (ref $text-stream)) ($data :digits) ($start i32) ($length i32) ($i i32) ($text :nullable-object))
  #@(local.set $text (struct.get $obj $b (ref.cast (ref $obj) (local.get $entry))))
  #@(if (i32.eqz (ref.is_null (local.get $text))) (then (return (local.get $text))))
  #@(local.set $buffer (call $file-buffer (local.get $entry)))
  #@(local.set $length (struct.get $text-stream $length (local.get $buffer)))
  #@(local.set $data (struct.get $text-stream $data (local.get $buffer)))
  #@(local.set $start (global.get $cursor))
  #@(call $reserve (local.get $length))
  #@(block $done (loop $copy (br_if $done (i32.eq (local.get $i) (local.get $length)))
    (i32.store8 (i32.add (local.get $start) (local.get $i)) (array.get $digits (local.get $data) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
  #@(local.set $text (call $decode-text (local.get $start) (local.get $length)))
  #@(struct.set $obj $b (ref.cast (ref $obj) (local.get $entry)) (local.get $text))
  #@(local.get $text))

(define-runtime-function $file-grow (($buffer (ref $text-stream)) ($required i32)) (:digits)
  (:locals ($data :digits) ($new :digits) ($capacity i32))
  (wat-fail-when #@(i32.gt_u (local.get $required) (i32.const 536870910)) :allocation)
  #@(local.set $data (struct.get $text-stream $data (local.get $buffer)))
  #@(local.set $capacity (array.len (local.get $data)))
  #@(if (i32.gt_u (local.get $required) (local.get $capacity))
    (then
      (local.set $capacity (i32.mul (local.get $capacity) (i32.const 2)))
      (if (i32.lt_u (local.get $capacity) (local.get $required)) (then (local.set $capacity (local.get $required))))
      (if (i32.gt_u (local.get $capacity) (i32.const 536870910)) (then (local.set $capacity (i32.const 536870910))))
      (local.set $new (array.new_default $digits (local.get $capacity)))
      (array.copy $digits $digits (local.get $new) (i32.const 0) (local.get $data) (i32.const 0)
        (struct.get $text-stream $length (local.get $buffer)))
      (local.set $data (local.get $new))
      (struct.set $text-stream $data (local.get $buffer) (local.get $data))))
  #@(if (i32.gt_u (local.get $required) (struct.get $text-stream $length (local.get $buffer)))
    (then (struct.set $text-stream $length (local.get $buffer) (local.get $required))))
  #@(local.get $data))

(define-runtime-function $file-unlink (($entry :nullable-object)) ()
  (:locals ($scan :nullable-object) ($previous :nullable-object))
  #@(local.set $scan (global.get $source-files))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (if (ref.eq (call $car (local.get $scan)) (local.get $entry))
      (then
        (if (ref.is_null (local.get $previous)) (then (global.set $source-files (call $cdr (local.get $scan))))
          (else (struct.set $obj $b (ref.cast (ref $obj) (local.get $previous)) (call $cdr (local.get $scan)))))
        (return)))
    (local.set $previous (local.get $scan)) (local.set $scan (call $cdr (local.get $scan))) (br $next))))

;; Deleted read-through files stay hidden in the overlay. A later local write
;; takes precedence; no deletion or rename mutates the host source tree.
(define-runtime-function $source-deleted-p (($path :nullable-object)) (i32)
  (:locals ($scan :nullable-object))
  #@(local.set $scan (global.get $source-deleted))
  (wat-list-loop ($scan)
    #@(if (call $string-equal (local.get $path) (call $car (local.get $scan)))
      (then (return (i32.const 1)))))
  #@(i32.const 0))

;; Explicit empty directories are separate from files; mounted file paths also
;; imply their parents. No directory objects or new GC layouts are required.
(defun $source-path-prefix-cl ()
  (runtime-function-definition '$source-path-prefix-cl
    (wat-fragment (miricl-cross:runtime-kernel-wat '$source-path-prefix-cl 'miricl-runtime:path-prefix-value-p :result :truth))))

(define-runtime-function $source-path-prefix (($path :nullable-object) ($candidate :nullable-object)) (i32)
  #@(call $source-path-prefix-cl (local.get $path) (local.get $candidate)))

(define-runtime-function $source-directory-p (($path :nullable-object)) (i32)
  (:locals ($scan :nullable-object) ($candidate :nullable-object))
  #@(if (i32.eqz (array.len (struct.get $obj $digits (ref.cast (ref $obj) (local.get $path))))) (then (return (i32.const 1))))
  #@(local.set $scan (global.get $source-directories))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $candidate (call $car (local.get $scan)))
    (if (i32.or (call $string-equal (local.get $path) (local.get $candidate))
                (call $source-path-prefix (local.get $path) (local.get $candidate))) (then (return (i32.const 1))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(local.set $scan (global.get $source-files))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (if (call $source-path-prefix (local.get $path) (call $car (call $car (local.get $scan))))
      (then (return (i32.const 1))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(if (i32.eqz (ref.is_null (call $local-source-file (local.get $path)))) (then (return (i32.const 0))))
  #@(if (call $source-deleted-p (local.get $path)) (then (return (i32.const 0))))
  #@(call $eql (call $car (call $host-file (i32.const 0) (local.get $path))) (call $int (i32.const 2))))

(define-runtime-function $source-directory-delete (($path :nullable-object)) ()
  (:locals ($scan :nullable-object) ($previous :nullable-object) ($candidate :nullable-object))
  #@(if (i32.eqz (array.len (struct.get $obj $digits (ref.cast (ref $obj) (local.get $path))))) (then (call $file-error (local.get $path))))
  #@(local.set $scan (global.get $source-files))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (if (call $source-path-prefix (local.get $path) (call $car (call $car (local.get $scan))))
      (then (call $file-error (local.get $path))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(local.set $scan (global.get $source-directories))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $candidate (call $car (local.get $scan)))
    (if (call $source-path-prefix (local.get $path) (local.get $candidate)) (then (call $file-error (local.get $path))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(local.set $scan (global.get $source-directories))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (if (call $string-equal (local.get $path) (call $car (local.get $scan)))
      (then
        (if (ref.is_null (local.get $previous)) (then (global.set $source-directories (call $cdr (local.get $scan))))
          (else (struct.set $obj $b (ref.cast (ref $obj) (local.get $previous)) (call $cdr (local.get $scan)))))
        (return)))
    (local.set $previous (local.get $scan)) (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(call $file-error (local.get $path)))

(define-runtime-function $filesystem-native (($mode i32) ($path :nullable-object) ($value :nullable-object)) (:nullable-object)
  (:locals ($entry :nullable-object) ($date f64))
  #@(if (i32.eq (local.get $mode) (i32.const 7))
    (then (return (call $host-file (i32.const 3) (local.get $path)))))
  #@(if (i32.eq (local.get $mode) (i32.const 6))
    (then
      (local.set $entry (call $local-source-file (local.get $path)))
      (if (ref.is_null (local.get $entry))
        (then
          (if (call $source-deleted-p (local.get $path)) (then (return (ref.null eq))))
          (return (call $cdr (call $host-file (i32.const 0) (local.get $path))))))
      ;; Unflushed output has no committed modification date yet.
      (if (call $value-n (local.get $entry)) (then (return (ref.null eq))))
      (local.set $date (struct.get $source-entry $modified (ref.cast (ref $source-entry) (local.get $entry))))
      (return (if (result (ref null eq)) (f64.lt (local.get $date) (f64.const 0))
        (then (ref.null eq)) (else (call $float (i32.const 4) (local.get $date)))))))
  #@(if (i32.eq (local.get $mode) (i32.const 3))
    (then
      (if (i32.ne (call $tag (local.get $path)) (i32.const 44))
        (then (call $list-type-error (local.get $path) (i32.const ,(runtime-symbol-id 'file-stream)))))
      (if (i32.eqz (ref.is_null (local.get $value)))
        (then (return (call $car (struct.get $obj $a (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $path)))))))))
      (return (struct.get $obj $b (ref.cast (ref $obj) (struct.get $obj $a (ref.cast (ref $obj) (local.get $path))))))))
  #@(if (i32.ge_u (local.get $mode) (i32.const 4))
    (then
      (if (call $source-directory-p (local.get $path))
        (then (return (call $bool (i32.eq (local.get $mode) (i32.const 4))))))
      (if (i32.eq (local.get $mode) (i32.const 4)) (then (return (ref.null eq))))
      (if (i32.eqz (ref.is_null (call $source-file (local.get $path)))) (then (call $file-error (local.get $path))))
      (global.set $source-directories (call $cons (local.get $path) (global.get $source-directories)))
      (return (call $symbol (i32.const 1)))))
  #@(if (i32.eqz (local.get $mode)) (then (return (call $source-file (local.get $path)))))
  #@(local.set $entry (call $source-file (local.get $path)))
  #@(if (ref.is_null (local.get $entry))
    (then
      (if (i32.eq (local.get $mode) (i32.const 1))
        (then (call $source-directory-delete (local.get $path)) (return (call $symbol (i32.const 1)))))
      (call $file-error (local.get $path))))
  #@(if (i32.eq (local.get $mode) (i32.const 1))
    (then (call $file-unlink (local.get $entry)))
    (else
      (if (i32.eqz (ref.is_null (call $source-file (local.get $value)))) (then (call $file-error (local.get $value))))
      (call $file-unlink (local.get $entry))
      (struct.set $obj $a (ref.cast (ref $obj) (local.get $entry)) (local.get $value))
      (global.set $source-files (call $cons (local.get $entry) (global.get $source-files)))))
  #@(global.set $source-deleted (call $cons (local.get $path) (global.get $source-deleted)))
  #@(call $symbol (i32.const 1)))

(define-runtime-function $open-file-native
    (($path :nullable-object) ($pathname :nullable-object) ($direction i32) ($exists i32) ($missing i32)
     ($type :nullable-object) ($width i32) ($signed i32)) (:nullable-object)
  (:locals ($entry :nullable-object) ($old :nullable-object) ($stream :nullable-object) ($flags i32) ($backup :nullable-object))
  #@(if (call $source-directory-p (local.get $path)) (then (call $file-error (local.get $pathname))))
  #@(local.set $entry (call $source-file (local.get $path)))
  #@(local.set $flags (local.get $direction))
  #@(if (ref.is_null (local.get $entry))
    (then
      (if (i32.eqz (local.get $missing)) (then (return (ref.null eq))))
      (if (i32.eq (local.get $missing) (i32.const 1)) (then (call $file-error (local.get $pathname))))
      (local.set $flags (i32.or (local.get $flags) (i32.const 4)))))
  #@(if (i32.and (local.get $direction) (i32.const 2))
    (then
      (if (i32.eqz (ref.is_null (local.get $entry)))
        (then
          (if (i32.eqz (local.get $exists)) (then (return (ref.null eq))))
          (if (i32.eq (local.get $exists) (i32.const 1)) (then (call $file-error (local.get $pathname))))
          ;; Materialize a private overlay before mutating a host-backed file.
          (if (ref.is_null (call $local-source-file (local.get $path)))
            (then (global.set $source-files (call $cons (local.get $entry) (global.get $source-files)))))
          (if (i32.ge_u (local.get $exists) (i32.const 4))
            (then
              (local.set $old (local.get $entry))
              (call $file-unlink (local.get $entry))
              (if (i32.eq (local.get $exists) (i32.const 5))
                (then
                  (local.set $backup (call $apply ,(clos-library-reference '%file-backup-name)
                    (call $cons (local.get $path) (ref.null eq))))
                  (struct.set $obj $a (ref.cast (ref $obj) (local.get $entry)) (local.get $backup))
                  (global.set $source-files (call $cons (local.get $entry) (global.get $source-files)))))
              (local.set $entry (ref.null eq))
              (local.set $flags (i32.or (local.get $flags) (i32.const 4)))))))))
  #@(if (ref.is_null (local.get $entry))
    (then
      (local.set $entry (call $new-source-file (local.get $path) (ref.null eq)))
      (global.set $source-files (call $cons (local.get $entry) (global.get $source-files)))))
  #@(local.set $stream ,(wat-new-object :file-stream
    :digits #@(array.new_fixed $digits 5 (local.get $flags) (local.get $width) (local.get $signed) (i32.const -1) (i32.const 0))
    :a #@(call $node (i32.const 11) (i32.const 0) (local.get $entry) (local.get $pathname) (local.get $old))
    :b #@(local.get $type)))
  #@(if (i32.and (i32.ne (i32.and (local.get $direction) (i32.const 2)) (i32.const 0)) (i32.eq (local.get $exists) (i32.const 3)))
    (then (struct.set $obj $n (ref.cast (ref $obj) (local.get $stream)) (struct.get $text-stream $length (call $file-buffer (local.get $entry))))))
  #@(if (i32.eqz (local.get $direction)) (then (struct.set $obj $c (ref.cast (ref $obj) (local.get $stream)) (call $symbol (i32.const 1)))))
  #@(local.get $stream))

(define-runtime-function $close-file-native (($stream :nullable-object) ($abort i32)) ()
  (:locals ($descriptor :nullable-object) ($entry :nullable-object) ($old :nullable-object))
  #@(if (i32.eqz (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $stream))))) (then (return)))
  #@(local.set $descriptor (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream))))
  #@(local.set $entry (struct.get $obj $a (ref.cast (ref $obj) (local.get $descriptor))))
  #@(if (i32.and (local.get $abort)
      (i32.eq (i32.and (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 0)) (i32.const 6)) (i32.const 6)))
    (then
      (if (ref.eq (call $local-source-file (struct.get $obj $a (ref.cast (ref $obj) (local.get $entry)))) (local.get $entry))
        (then
          (call $file-unlink (local.get $entry))
          (local.set $old (struct.get $obj $c (ref.cast (ref $obj) (local.get $descriptor))))
          (if (i32.eqz (ref.is_null (local.get $old)))
            (then
              (call $file-unlink (local.get $old))
              (struct.set $obj $a (ref.cast (ref $obj) (local.get $old)) (struct.get $obj $a (ref.cast (ref $obj) (local.get $entry))))
              (global.set $source-files (call $cons (local.get $old) (global.get $source-files)))))))))
  #@(call $flush-source-file (local.get $entry))
  #@(struct.set $obj $c (ref.cast (ref $obj) (local.get $stream)) (call $symbol (i32.const 1))))

(define-runtime-function $file-write-text (($stream :nullable-object) ($text :nullable-object)) ()
  (:locals ($entry :nullable-object) ($buffer (ref $text-stream)) ($data :digits)
           ($start i32) ($length i32) ($position i32) ($i i32) ($column i32) ($c i32))
