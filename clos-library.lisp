      (let* ((slot (pop slots)) (name (slot-definition-name slot))
             (keys (slot-definition-initargs slot)) (cell nil))
        (let ((scan initargs))
          (%%while (and scan (not cell))
            (when (%member (car scan) keys) (setq cell (cdr scan)))
            (setq scan (cddr scan))))
        (cond (cell (setf (slot-value-using-class class object slot) (car cell)))
              ((and (or (eq slot-names t) (%member name slot-names))
                    (not (slot-boundp-using-class class object slot)) (slot-definition-initfunction slot))
               (setf (slot-value-using-class class object slot) (funcall (slot-definition-initfunction slot)))))))) object)
(defun initialize-instance (object &rest initargs) (apply 'shared-initialize object t initargs))
