         (previous-storage (%%allocate (class-of object) (%%raw-slots storage)))
         (previous (if (eq storage object) previous-storage (%%make-generic previous-storage)))
         (fresh (allocate-instance new-class)) (slots (class-slots new-class)))
    (%%while slots
      (let* ((slot (pop slots)) (name (slot-definition-name slot)))
        (when (and (eq (slot-definition-allocation slot) :instance)
                   (slot-exists-p previous name) (slot-boundp previous name))
          (setf (%get fresh name) (slot-value previous name)))))
    ;; Function objects keep their callable identity and dispatch metadata;
    ;; user slots still follow CHANGE-CLASS's ordinary copying rules.
    (unless (eq storage object)
      (let ((scan (%%raw-slots storage)))
        (%%while scan
          (let ((name (pop scan)) (value (pop scan)))
            (unless (or (eq name '%layout) (slot-exists-p previous name))
              (setf (%get fresh name) value))))))
    (%%set-raw-class storage new-class) (%%set-raw-slots storage (%%raw-slots (%%generic-info fresh)))
    (apply 'update-instance-for-different-class previous object initargs)) object)

(defun ensure-class (name &rest initargs)
