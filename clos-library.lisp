    (unless %booting (%set-generic-discriminator gf (compute-discriminating-function gf))) gf))
(defun find-method (gf qualifiers specializers &optional (errorp t))
  (let ((scan (%get gf :methods)) (found nil))
    (unless (= (length specializers) (length (%required (%get gf :lambda-list)))) (error 'error))
    (setq specializers (%map (lambda (specializer)
      (if (consp specializer)
          (if (and (eq (car specializer) 'eql) (= (length specializer) 2))
              (intern-eql-specializer (cadr specializer)) (error 'error))
          specializer)) specializers))
