;;;; Guest Lisp, embedded as object literals; never evaluated by the host.
;;;; Private names are uninterned in the guest. Public MOP names use MIRICL-MOP.
(defparameter %unbound (gensym))
(defparameter %next-context nil)
(defparameter %booting t)
(defparameter %classes nil)
(defparameter %eql-specializers nil)
(defparameter %dispatch-version 0)
(defparameter %cache-permitted t)

(defun %remove (item items)
  ;; A generic function can have thousands of methods. Keep removal on the
  ;; native sequence traversal instead of recursing through the guest stack.
  (%%remove-sequence 0 item items nil #'eq nil nil 0 nil nil nil nil))
(defun (setf %get) (value object key) (%%put object key value))
(defun %quote (x) (list 'quote x))
(defun %map (fn items)
  (if items (cons (funcall fn (car items)) (%map fn (cdr items))) nil))
(defun %flatmap (fn items)
  (if items (append (funcall fn (car items)) (%flatmap fn (cdr items))) nil))
(defun %position (item items)
  (if items (if (eq item (car items)) 0 (1+ (%position item (cdr items)))) 1000000))
(defun %unique (items)
  (if items (cons (car items) (%unique (%remove (car items) (cdr items)))) nil))
(defun %keyword (name) (intern (symbol-name name) "KEYWORD"))
(defun %required (params)
  (if (or (not params) (%member (car params) '(&optional &rest &key &allow-other-keys &aux)))
      nil (cons (car params) (%required (cdr params)))))
(defun %normalize-lambda (params body)
  (let ((*gensym-counter* 0)) (%normalize-lambda-1 params body)))
(defun %normalize-lambda-1 (params body)
  (let* ((args (gensym)) (box (gensym)) (bindings (list (list box (list 'list args))))
         (mode nil) (names nil) (keys nil) (keyargs nil) (allow nil) (restp nil) (declarations nil))
    (when (and (cdr body) (stringp (car body))) (setq body (cdr body)))
    (%%while (and body (= (%%tag (car body)) 7) (eq (car (car body)) 'declare))
      (push (pop body) declarations))
    (%%while params
      (let ((spec (pop params)))
        (cond
          ((eq spec '&optional) (when mode (error 'program-error)) (setq mode '&optional))
          ((eq spec '&rest)
           (when (or restp (eq mode '&key) (eq mode '&aux)) (error 'program-error))
           (let ((name (pop params)))
             (unless (and name (symbolp name)) (error 'program-error))
             (push name names) (push (list name (list 'car box)) bindings))
           (setq restp t mode '&rest))
          ((eq spec '&key)
           (when (or (eq mode '&key) (eq mode '&aux)) (error 'program-error))
           (setq mode '&key keyargs (gensym))
           (push (list keyargs (list 'car box)) bindings))
          ((eq spec '&allow-other-keys)
           (unless (eq mode '&key) (error 'program-error)) (setq allow t))
          ((eq spec '&aux) (setq mode '&aux))
          (t
           (when (eq mode '&rest) (error 'program-error))
           (let* ((compound (not (symbolp spec)))
                  (var (if compound (car spec) spec))
                  (init (if compound (cadr spec) nil))
                  (supplied (if compound (caddr spec) nil)) (present (gensym)) (key nil))
             (when (eq mode '&key)
               (if (symbolp var) (setq key (%keyword var))
                   (setq key (car var) var (cadr var)))
               (push key keys))
             ;; &AUX is sequential LET* binding, so it may shadow parameters
             ;; and earlier auxiliaries. Actual parameters remain unique.
             (unless (and var (symbolp var) (or (eq mode '&aux) (not (%member var names))))
               (error 'program-error))
             (push var names)
             (when supplied
               (when (%member supplied names) (error 'program-error)) (push supplied names))
             (cond
               ((eq mode '&aux) (push (list var init) bindings))
               ((eq mode '&key)
                (push (list present (list '%cell keyargs (%quote key))) bindings)
                (push (list var (list 'if present (list 'car present) init)) bindings)
                (when supplied (push (list supplied (list 'not (list 'not present))) bindings)))
               ((eq mode '&optional)
                (push (list present (list 'car box)) bindings)
                (push (list var (list 'if present (list '%pop-arg box nil) init)) bindings)
                (when supplied (push (list supplied (list 'not (list 'not present))) bindings)))
               (t (when compound (error 'program-error))
                  (push (list var (list '%pop-arg box t)) bindings))))))))
    (list (list '&rest args)
      (list (cons 'let* (cons (reverse bindings)
        (append (reverse declarations)
          (if keyargs (list (list '%check-keys keyargs (%quote keys) allow))
              (unless restp (list (list 'if (list 'car box) (list 'error (%quote 'program-error))))))
          body)))))))

(defun %condition-slots (class info)
  (%map (lambda (spec)
    (let* ((name (if (symbolp spec) spec (car spec)))
           (options (if (symbolp spec) nil (cdr spec))) (init (%cell options :initform))
           (plist (list :name name :type (or (car (%cell options :type)) t)
             :allocation :instance :initargs nil :readers nil :writers nil)) (scan options))
      (%%while scan
        (when (eq (car scan) :initarg)
          (setq plist (append (list :initargs (cons (cadr scan) (car (%cell plist :initargs)))) plist)))
        (when (%member (car scan) '(:reader :accessor))
          (setf (car (%cell plist :readers)) (cons (cadr scan) (car (%cell plist :readers)))))
        (when (%member (car scan) '(:writer :accessor))
          (setf (car (%cell plist :writers))
            (cons (if (eq (car scan) :accessor) (list 'setf (cadr scan)) (cadr scan))
                  (car (%cell plist :writers)))))
        (setq scan (cddr scan)))
      (when init
        (let ((form (car init)))
          (setq plist (append (list :initform
            (if (and (consp form) (eq (car form) '%compiled-condition-init)) (cadr form) form)
            :initfunction (%%condition-init info form)) plist))))
      (%make-slot class plist t))) (%%raw-slots info)))
(defun find-class (name &optional (errorp t) environment)
  (let ((class (%%named-class name)))
    (unless class
      (let ((info (%%condition-info name)))
        (when info
          (setq class (%boot-class name
            (%map (lambda (parent) (find-class parent)) (%%raw-class info))
            (find-class 'standard-class)))
          (setf (%get class :condition) t (%get class :native-condition-info) info)
          (setf (%get class :direct-slots) (%condition-slots class info))
          (finalize-inheritance class))))
    (if (or class (not errorp)) class (error 'error))))
(defun (setf find-class) (new name &optional errorp environment)
  (unless (or (not new) (%classp new)) (error 'type-error :datum new :expected-type 'class))
  (%%set-named-class name new) new)
(defun class-name (class) (%get class :name))
(defun (setf class-name) (name class) (setf (%get class :name) name))
(defun class-direct-superclasses (class) (%get class :direct-superclasses))
(defun class-direct-subclasses (class) (%get class :direct-subclasses))
(defun class-direct-slots (class) (%get class :direct-slots))
(defun class-slots (class)
  (unless (class-finalized-p class) (finalize-inheritance class)) (%get class :slots))
(defun class-precedence-list (class)
  (unless (class-finalized-p class) (finalize-inheritance class)) (%get class :cpl))
(defun class-finalized-p (class) (%get class :finalized))
(defun %ancestors (class seen)
  (unless (%member class seen)
    (push class seen)
    (let ((scan (class-direct-superclasses class)))
      (%%while scan (setq seen (%ancestors (pop scan) seen)))) ) seen)
(defun %constraints (classes)
  (%flatmap (lambda (class)
    (let ((supers (class-direct-superclasses class)))
      (cons (cons class supers)
        (if supers (list supers) nil)))) classes))
(defun %eligible (candidate remaining constraints)
  (let ((ok t) (scan constraints))
    (%%while scan
      (let ((chain (pop scan)))
        (%%while (cdr chain)
          (when (and (%member (car chain) remaining) (%member candidate (cdr chain)))
            (setq ok nil))
          (setq chain (cdr chain))))) ok))
(defun compute-class-precedence-list (class)
  ;; ANSI topological sort with the most recently selected direct-superclass tie break.
  (let* ((remaining (reverse (%ancestors class nil)))
         (constraints (%constraints remaining)) (result nil))
    (%%while remaining
      (let ((scan remaining) (eligible nil) (chosen nil))
        (%%while scan
          (let ((candidate (pop scan)))
            (when (%eligible candidate remaining constraints) (push candidate eligible))))
        (unless eligible (error 'error))
        (if (not (cdr eligible)) (setq chosen (car eligible))
            (let ((recent result))
              (%%while (and recent (not chosen))
                (let ((parents (class-direct-superclasses (pop recent))))
                  (%%while (and parents (not chosen))
                    (when (%member (car parents) eligible) (setq chosen (car parents)))
                    (setq parents (cdr parents)))))))
        (unless chosen (setq chosen (car (reverse eligible))))
        (push chosen result) (setq remaining (%remove chosen remaining))))
    (reverse result)))
(defun %cpl (class)
  (unless (%get class :finalized) (finalize-inheritance class)) (%get class :cpl))
(defun %subclassp (class superclass) (%%class-subclass-p class superclass))
(defun %boot-class (name supers metaclass)
  (let ((class (%%allocate metaclass (list :name name :class-metaobject t
      :direct-superclasses supers :direct-subclasses nil :direct-slots nil :slots nil :finalized t))))
    (%%set-named-class name class)
    (push class %classes)
    (setf (%get class :cpl) (compute-class-precedence-list class))
    (let ((scan supers))
      (%%while scan (add-direct-subclass (pop scan) class))) class))
(defun add-direct-subclass (super sub)
  (unless (%member sub (%get super :direct-subclasses))
    (setf (%get super :direct-subclasses) (cons sub (%get super :direct-subclasses)))) nil)
(defun remove-direct-subclass (super sub)
  (setf (%get super :direct-subclasses) (%remove sub (%get super :direct-subclasses))) nil)
(defun %instancep (object class) (%%instance-type-p object class))
(defun type-of (object)
  (cond ((compiled-function-p object) 'compiled-function)
        ((eq object t) 'boolean)
        ((keywordp object) 'keyword)
        ((and (characterp object) (standard-char-p object)) 'standard-char)
        ((integerp object) (list 'integer object object))
        ((arrayp object)
         (list (if (typep object 'simple-array) 'simple-array 'array)
               (array-element-type object) (array-dimensions object)))
        (t (let* ((class (class-of object)) (name (class-name class)))
             (if (and name (eq (find-class name nil) class)) name class)))))
(defun %same-type-p (a b)
  ;; EQUAL must not conflate distinct objects denoted by EQL or MEMBER types.
  (cond ((eql a b) t)
        ((and (consp a) (consp b))
         (if (and (eq (car a) (car b)) (%member (car a) '(eql member)))
             (let ((x (cdr a)) (y (cdr b)))
               (%%while (and x y (eql (car x) (car y))) (setq x (cdr x) y (cdr y)))
               (and (null x) (null y)))
             (and (%same-type-p (car a) (car b)) (%same-type-p (cdr a) (cdr b)))))
        (t nil)))
(defun %uncertain-type-p (type)
  ;; A finite type may be tested directly only when TYPEP understands its
  ;; target. Unknown standard facilities keep an uncertain SUBTYPEP result.
  (if (symbolp type)
      (not (or (null type) (find-class type nil)
               (%member type '(atom boolean keyword compiled-function standard-char base-char extended-char
                               bit signed-byte unsigned-byte mod simple-array simple-vector simple-string
                               base-string simple-base-string simple-bit-vector))))
  (and (consp type)
       (or (%member (car type) '(satisfies function values))
           (unless (%member (car type) '(eql member))
             (let ((scan (cdr type)) (found nil))
               (%%while (and scan (not found))
                 (setq found (%uncertain-type-p (pop scan)))) found))))))
(defun %finite-type-members (type)
  (when (%classp type) (setq type (class-name type)))
  (cond ((eq type 'null) (values (list nil) t))
        ((eq type 'boolean) (values (list nil t) t))
        ((and (consp type) (eq (car type) 'eql)) (values (list (cadr type)) t))
        ((and (consp type) (eq (car type) 'member)) (values (cdr type) t))
        (t (values nil nil))))
(defun %cons-type-parts (type)
  (when (%classp type) (setq type (class-name type)))
  (cond ((eq type 'cons) (list t t))
        ((and (consp type) (eq (car type) 'cons))
         (when (> (length type) 3) (error 'error))
         (list (if (and (cdr type) (not (eq (cadr type) '*))) (cadr type) t)
               (if (and (cddr type) (not (eq (caddr type) '*))) (caddr type) t)))))
(defun %cons-subtypep (a b environment)
  (unless (or (and (consp a) (eq (car a) 'cons))
              (and (consp b) (eq (car b) 'cons)))
    (return-from %cons-subtypep (values nil nil)))
  (let ((parts (%cons-type-parts a)) (other (%cons-type-parts b)))
    (when parts
      (multiple-value-bind (empty-car known-car) (subtypep (car parts) nil environment)
        (multiple-value-bind (empty-cdr known-cdr) (subtypep (cadr parts) nil environment)
          (when (or empty-car empty-cdr) (return-from %cons-subtypep (values t t)))
          (let ((inhabited (and known-car known-cdr)))
            (if other
                (multiple-value-bind (car-sub car-known) (subtypep (car parts) (car other) environment)
                  (multiple-value-bind (cdr-sub cdr-known) (subtypep (cadr parts) (cadr other) environment)
                    (cond ((and car-sub cdr-sub) (return-from %cons-subtypep (values t t)))
                          ((and inhabited (or (and car-known (not car-sub))
                                              (and cdr-known (not cdr-sub))))
                           (return-from %cons-subtypep (values nil t))))))
                (multiple-value-bind (sub known) (subtypep 'cons b environment)
                  (when (or sub (and known inhabited))
                    (return-from %cons-subtypep (values sub t)))))))))
    (when (and other (not parts))
      (multiple-value-bind (sub known) (subtypep a 'cons environment)
        (when (and known (not sub)) (return-from %cons-subtypep (values nil t)))))
    (values nil nil)))
(defun %subtype-components (parts other environment reversed all)
  (let ((certain t))
    (%%while parts
      (let ((part (pop parts)))
        (multiple-value-bind (sub known)
            (if reversed (subtypep other part environment) (subtypep part other environment))
          (if all
              (cond ((and known (not sub)) (return-from %subtype-components (values nil t)))
                    ((not known) (setq certain nil)))
              (when sub (return-from %subtype-components (values t t)))))))
    (if all (values certain certain) (values nil nil))))
(defun %class-logical-type-p (type)
  (cond ((or (null type) (%classp type)) t)
        ((symbolp type) (not (null (find-class type nil))))
        ((and (consp type) (%member (car type) '(and or)))
         (let ((parts (cdr type)))
           (%%while parts
             (unless (%class-logical-type-p (pop parts)) (return-from %class-logical-type-p nil))) t))
        (t nil)))
(defun %logical-class-subtypep (a b environment)
  ;; The existing numeric, array, finite, and cons proof paths own their
  ;; parameterized types. Compose only class relationships here.
  (unless (and (%class-logical-type-p a) (%class-logical-type-p b))
    (return-from %logical-class-subtypep (values nil nil)))
  (cond ((and (consp a) (eq (car a) 'or))
         (%subtype-components (cdr a) b environment nil t))
        ((and (consp b) (eq (car b) 'and))
         (%subtype-components (cdr b) a environment t t))
        ((and (consp b) (eq (car b) 'or))
         (%subtype-components (cdr b) a environment t nil))
        ((and (consp a) (eq (car a) 'and))
         (%subtype-components (cdr a) b environment nil nil))
        (t (values nil nil))))
(defun %subtypep-general (a b environment)
  (block subtypep
  ;; BASE-CHAR spans the character repertoire in this implementation.
  (when (eq a 'base-char) (setq a 'character))
  (when (eq b 'base-char) (setq b 'character))
  (when (eq a 'extended-char) (setq a nil))
  (when (eq b 'extended-char) (setq b nil))
  (when (or (eq b t) (not a) (%same-type-p a b))
    (return-from subtypep (values t t)))
  (multiple-value-bind (members finite) (%finite-type-members a)
    (when finite
      (unless members (return-from subtypep (values t t)))
      (when (%uncertain-type-p b) (return-from subtypep (values nil nil)))
      (%%while members
        (unless (typep (pop members) b environment) (return-from subtypep (values nil t))))
      (return-from subtypep (values t t))))
  (when (and (eq a 'compiled-function)
             (or (eq b 'function) (eq b 'atom) (eq b (find-class 'function))))
    (return-from subtypep (values t t)))
  (when (and (eq a 'compiled-function) (null b))
    (return-from subtypep (values nil t)))
  (when (and (eq b 'compiled-function)
             (or (eq a 'function) (eq a (find-class 'function))))
    (return-from subtypep (values nil t)))
  (let ((ca (if (%classp a) a (and (symbolp a) (find-class a nil))))
        (cb (if (%classp b) b (and (symbolp b) (find-class b nil)))))
    (when (and ca cb) (return-from subtypep (values (%subclassp ca cb) t)))
    (when (and ca (null b)) (return-from subtypep (values nil t)))
    (when (and ca (eq b 'atom))
      (return-from subtypep (values (not (%subclassp (find-class 'cons) ca)) t)))
    (when (and cb (eq a 'atom))
      (return-from subtypep (values (eq cb (find-class t)) t)))
    (when (and cb (%member a '(keyword standard-char)))
      (return-from subtypep
        (values (%subclassp (find-class (if (eq a 'keyword) 'symbol 'character)) cb) t)))
    (when (and ca (%member b '(keyword standard-char boolean)))
      (return-from subtypep (values nil t)))
    (when (and (%member a '(keyword standard-char)) (eq b 'atom))
      (return-from subtypep (values t t)))
    (when (and (%member a '(atom keyword standard-char))
               (or (null b) (%member b '(keyword standard-char boolean))))
      (return-from subtypep (values nil t))))
  (multiple-value-bind (sub known) (%logical-class-subtypep a b environment)
    (when known (return-from subtypep (values sub t))))
  (%cons-subtypep a b environment)))

(defun slot-definition-name (slot) (%get slot :name))
(defun slot-definition-allocation (slot) (%get slot :allocation))
(defun slot-definition-initargs (slot) (%get slot :initargs))
(defun slot-definition-initform (slot) (%get slot :initform))
(defun slot-definition-initfunction (slot) (%get slot :initfunction))
(defun slot-definition-type (slot) (%get slot :type))
(defun slot-definition-readers (slot) (%get slot :readers))
(defun slot-definition-writers (slot) (%get slot :writers))
(defun slot-definition-location (slot) (%get slot :location))
(defun direct-slot-definition-class (class &rest initargs) (find-class 'standard-direct-slot-definition))
(defun effective-slot-definition-class (class &rest initargs) (find-class 'standard-effective-slot-definition))
(defun validate-superclass (class superclass)
  (or (eq (class-name superclass) 'standard-object)
      (and (eq (class-of class) (find-class 'structure-class))
           (eq (class-name superclass) 'structure-object))
      (eq (class-of class) (class-of superclass))
      (%subclassp (class-of class) (find-class 'standard-class))))
(defun %make-slot (class plist direct)
  (let* ((name-cell (%cell plist :name)) (name (car name-cell))
         (allocation (if (%cell plist :allocation) (car (%cell plist :allocation)) :instance))
         (meta (if direct (apply 'direct-slot-definition-class class plist)
                   (apply 'effective-slot-definition-class class plist)))
         (slot (%%allocate meta nil)))
    (unless (and name-cell (symbolp name)
                 (or (and name (not (keywordp name)))
                     (eq (class-of class) (find-class 'structure-class)))) (error 'program-error))
    (unless (%member allocation '(:instance :class)) (error 'program-error))
    (%%set-raw-slots slot (append plist (list :allocation allocation :type t)))
    (setf (%get slot :owner) class)
    (unless %booting (apply 'initialize-instance slot plist))
    slot))
(defun compute-effective-slot-definition (class name direct-slots)
  (let* ((first (car direct-slots))
         (slot (%make-slot class (list :name name :allocation (slot-definition-allocation first)
           :type (slot-definition-type first)) nil))
         (scan direct-slots) (init nil) (initargs nil) (readers nil) (writers nil) (types nil))
    (%%while scan
      (let ((d (pop scan)))
        (when (and (not init) (slot-definition-initfunction d)) (setq init d))
        (push (slot-definition-type d) types)
        (setq initargs (append initargs (slot-definition-initargs d))
              readers (append readers (slot-definition-readers d))
              writers (append writers (slot-definition-writers d)))))
    (setf (%get slot :owner) (%get first :owner)
          (%get slot :initargs) (%unique initargs)
          (%get slot :readers) (%unique readers) (%get slot :writers) (%unique writers)
          (%get slot :type) (if (cdr types) (cons 'and (reverse types)) (car types)))
    (when init (setf (%get slot :initfunction) (slot-definition-initfunction init)
                    (%get slot :initform) (slot-definition-initform init))) slot))
(defun compute-slots (class)
  (let ((cpl (%get class :cpl)) (all nil) (names nil) (result nil) (index 0))
    (%%while cpl (setq all (append all (class-direct-slots (pop cpl)))))
    (setq names (%unique (%map 'slot-definition-name all)))
    (%%while names
      (let* ((name (pop names)) (scan all) (matching nil) (slot nil))
        (%%while scan
          (let ((direct (pop scan)))
            (when (eq name (slot-definition-name direct)) (push direct matching))))
        (setq slot (compute-effective-slot-definition class name (reverse matching)))
        (when (eq (slot-definition-allocation slot) :instance)
          (setf (%get slot :location) index) (incf index))
        (push slot result))) (reverse result)))
(defun finalize-inheritance (class)
  (when (%get class :finalizing) (error 'error))
  (when (eq (class-name (class-of class)) 'forward-referenced-class) (error 'error))
  (setf (%get class :finalizing) t)
  (unwind-protect
    (progn
      (let ((supers (class-direct-superclasses class)))
        (%%while supers
          (unless (class-finalized-p (car supers)) (finalize-inheritance (car supers)))
          (setq supers (cdr supers))))
      (setf (%get class :cpl) (compute-class-precedence-list class))
      (setf (%get class :slots) (compute-slots class)
            (%get class :empty-layout) (make-symbol "EMPTY-LAYOUT")
            (%get class :finalized) t)
      (let ((slots (%get class :slots)))
        (%%while slots
          (let* ((slot (pop slots)) (owner (%get slot :owner)) (name (slot-definition-name slot)))
            (when (and (eq (slot-definition-allocation slot) :class)
                       (not (%cell (%get owner :shared-slots) name)))
              (setf (%get owner :shared-slots)
                (append (%get owner :shared-slots)
                  (list name (if (slot-definition-initfunction slot)
                    (funcall (slot-definition-initfunction slot)) %unbound)))))))))
    (setf (%get class :finalizing) nil)) class)
(defun %invalidate-class (class)
  (setf (%get class :finalized) nil)
  (let ((subs (class-direct-subclasses class)))
    (%%while subs (%invalidate-class (pop subs)))) class)
(defun make-instances-obsolete (class)
  (incf %dispatch-version)
  (%invalidate-class (if (symbolp class) (find-class class) class)))

(defun %ensure-layout-general (object)
  (when (= (%%tag object) 23)
    (let* ((class (class-of object))
           (layout (or (class-slots class) (%get class :empty-layout)))
           (old (%get object '%layout)))
      (when (and (%cell (%%raw-slots object) '%layout) (not (eq layout old)))
        (let ((added nil) (discarded nil) (values nil)
              (scan (if (consp old) old nil)) (old-storage (%%raw-slots object)))
          (%%while scan
            (let* ((slot (pop scan)) (name (slot-definition-name slot))
                   (cell (%cell old-storage name)))
              (when (and (eq (slot-definition-allocation slot) :instance)
                         (or (not (%find-slot class name))
                             (eq (slot-definition-allocation (%find-slot class name)) :class)))
                (push name discarded)
                (when (and cell (not (eq (car cell) %unbound)))
                  (setq values (append values (list name (car cell)))))
                (let ((new nil) (rest (%%raw-slots object)))
                  (%%while rest
                    (unless (eq (car rest) name) (setq new (append new (list (car rest) (cadr rest)))))
                    (setq rest (cddr rest)))
                  (%%set-raw-slots object new)))))
          (setq scan (if (consp layout) layout nil))
          (%%while scan
            (let ((slot (pop scan)))
              (when (and (eq (slot-definition-allocation slot) :instance)
                         (not (%cell (%%raw-slots (%%generic-info object)) (slot-definition-name slot))))
