    (%%while slots
      (let ((slot (pop slots)))
        (unless (slot-exists-p previous (slot-definition-name slot)) (push (slot-definition-name slot) new))))
    (%check-initargs current initargs '(update-instance-for-different-class shared-initialize) new previous)
