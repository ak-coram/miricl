          (%get gf :method-class) method-class (%get gf :argument-precedence-order) order
          (%get gf :method-combination-name) combination
          (%get gf :method-combination) (%%allocate (find-class 'method-combination) (list :name combination)))
    (when (%cell initargs :documentation)
      (setf (%get gf :documentation) (car (%cell initargs :documentation))))
