(defun %lambda-profile (ll)
  (let ((mode nil) (required 0) (optional 0) (restp nil) (keyp nil) (keys nil) (allow nil))
    (%%while ll
      (let ((param (pop ll)))
        (cond ((eq param '&optional) (setq mode '&optional))
              ((eq param '&rest) (setq restp t mode '&rest) (pop ll))
              ((eq param '&key) (setq keyp t mode '&key))
              ((eq param '&allow-other-keys) (setq allow t))
              ((eq param '&aux) (setq mode '&aux))
              ((eq mode '&optional) (incf optional))
              ((eq mode '&key)
               (push (if (symbolp param) (%keyword param)
                         (if (symbolp (car param)) (%keyword (car param)) (car (car param)))) keys))
              ((not mode) (incf required)))))
