  (when (eq (class-of class) (find-class 'built-in-class)) (error 'error))
  (let* ((slots (class-slots class))
         (storage (list '%layout (or slots (%get class :empty-layout)))))
    (%%while slots
      (when (eq (slot-definition-allocation (car slots)) :instance)
        (setq storage (append storage (list (slot-definition-name (car slots)) %unbound))))
      (setq slots (cdr slots)))
    (let ((object (%%allocate class storage)))
      (if (or (%subclassp class (find-class 'generic-function))
              (%subclassp (class-of class) (find-class 'funcallable-standard-class)))
