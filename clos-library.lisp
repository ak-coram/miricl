    (%%while slots (setq allowed (append allowed (slot-definition-initargs (pop slots)))))
    ;; Methods participating in initialization may accept additional keyword arguments.
    (%%while names
        (let* ((name (pop names)) (gf (fdefinition name))
               (methods (%compute-applicable gf
                 (cond ((eq name 'allocate-instance) (cons (class-of object) args))
                       ((eq name 'update-instance-for-different-class) (cons previous (cons object args)))
                       ((eq name 'shared-initialize) (cons object (cons slot-names args)))
                       (t (cons object args))))))
          (%%while methods
            (let ((ll (method-lambda-list (pop methods))))
              (when (%member '&allow-other-keys ll) (setq allow t))
              (setq allowed (append (%nth 4 (%lambda-profile ll)) allowed))))))
    (%check-keys args allowed allow)))
(defun make-instance (class &rest initargs)
