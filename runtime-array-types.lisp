;;;; Array subtype proofs use actual storage kinds and immutable shape lists.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; Flags: low four bits select actual array kinds (T, CHARACTER, BIT, NIL),
;; bit 4 requires a simple array, bit 5 is empty, and bit 6 is universal.
;; Rank -1 and a null shape denote unrestricted rank/dimensions respectively.
;; Non-null shape lists share the input type's spine without modifying it.
(define-runtime-function $array-type-info (($type :nullable-object) ($env :nullable-object)) (i32 i32 :nullable-object)
  (:locals ($name :nullable-object) ($class :nullable-object) ($args :nullable-object)
           ($element :nullable-object) ($dimensions :nullable-object) ($shape :nullable-object)
           ($flags i32) ($rank i32) ($vector i32))
  #@(local.set $type (call $expand-derived-type (local.get $type) (local.get $env)))
  #@(if (ref.is_null (local.get $type)) (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
  #@(if (i32.eq (call $operator (local.get $type)) (i32.const ,(runtime-symbol-id 'and)))
    (then (return (call $array-intersection-info (local.get $type) (local.get $env)))))
  #@(local.set $rank (i32.const -1))
  #@(local.set $name (local.get $type))
  #@(if (i32.eq (call $tag (local.get $type)) (i32.const 7))
    (then (local.set $name (call $car (local.get $type))) (local.set $args (call $cdr (local.get $type))))
    (else (local.set $class (call $subtype-class (local.get $type)))
      (if (i32.eqz (ref.is_null (local.get $class)))
        (then (local.set $name (call $car (call $property-cell (struct.get $obj $b (ref.cast (ref $obj) (local.get $class)))
          ,(clos-library-reference :name))))))))
  (wat-symbol-case #@(call $id (local.get $name))
    ((t) #@(return (i32.const 64) (i32.const -1) (ref.null eq)))
    (array #@(local.set $flags (i32.const 15)))
    (simple-array #@(local.set $flags (i32.const 31)))
    (vector #@(local.set $flags (i32.const 15)) #@(local.set $vector (i32.const 1)))
    (simple-vector #@(local.set $flags (i32.const 17)) #@(local.set $vector (i32.const 2)))
    (string #@(local.set $flags (i32.const 10)) #@(local.set $vector (i32.const 2)))
    (simple-string #@(local.set $flags (i32.const 26)) #@(local.set $vector (i32.const 2)))
    (base-string #@(local.set $flags (i32.const 2)) #@(local.set $vector (i32.const 2)))
    (simple-base-string #@(local.set $flags (i32.const 18)) #@(local.set $vector (i32.const 2)))
    (bit-vector #@(local.set $flags (i32.const 4)) #@(local.set $vector (i32.const 2)))
    (simple-bit-vector #@(local.set $flags (i32.const 20)) #@(local.set $vector (i32.const 2))))
  #@(if (i32.eqz (local.get $flags)) (then (return (i32.const 0) (i32.const -1) (ref.null eq))))
  #@(if (local.get $vector) (then (local.set $rank (i32.const 1))))
  #@(if (i32.eq (local.get $vector) (i32.const 2))
    (then (call $arity (local.get $args) (i32.const 0) (i32.const 1))
      (local.set $shape (local.get $args)))
    (else
      (call $arity (local.get $args) (i32.const 0) (i32.const 2))
      (if (i32.eqz (ref.is_null (local.get $args)))
        (then (local.set $element (call $car (local.get $args)))
          (if (i32.ne (call $id (local.get $element)) (i32.const ,(runtime-symbol-id '*)))
            (then (local.set $flags (i32.or (i32.and (local.get $flags) (i32.const 16))
              (i32.shl (i32.const 1) (call $upgraded-array-kind
                (call $expand-derived-type (local.get $element) (local.get $env))))))))))
      (if (local.get $vector)
        (then (local.set $shape (call $cdr (local.get $args))))
        (else (if (i32.eqz (ref.is_null (call $cdr (local.get $args))))
          (then
            (local.set $dimensions (call $car (call $cdr (local.get $args))))
            (if (i32.ne (call $id (local.get $dimensions)) (i32.const ,(runtime-symbol-id '*)))
              (then
                (if (i32.eq (call $tag (local.get $dimensions)) (i32.const 1))
                  (then
                    (if (i32.lt_s (call $value-n (local.get $dimensions)) (i32.const 0))
                      (then (return (i32.const 0) (i32.const -1) (ref.null eq))))
                    (if (i32.gt_u (call $bitlength (ref.as_non_null (local.get $dimensions))) (i32.const 8))
                      (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
                    (local.set $rank (call $natural-count (local.get $dimensions))))
                  (else (local.set $shape (local.get $dimensions)) (local.set $rank (i32.const 0))))))))))))
  #@(call $array-shape-info (local.get $flags) (local.get $rank) (local.get $shape)))

(define-runtime-function $array-shape-info (($flags i32) ($rank i32) ($shape :nullable-object)) (i32 i32 :nullable-object)
  (:locals ($scan :nullable-object) ($axis :nullable-object)
           ($size i32) ($count i32) ($product i32) ($overflow i32) ($wild i32))
  #@(if (i32.ge_s (local.get $rank) (i32.const 256))
    (then (return (i32.const 32) (local.get $rank) (ref.null eq))))
  #@(if (i32.eqz (ref.is_null (local.get $shape)))
    (then
      (local.set $scan (local.get $shape)) (local.set $product (i32.const 1))
      (block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
        (if (i32.ne (call $tag (local.get $scan)) (i32.const 7))
          (then (return (i32.const 0) (i32.const -1) (ref.null eq))))
        (local.set $axis (call $car (local.get $scan)))
        (if (i32.eq (call $id (local.get $axis)) (i32.const ,(runtime-symbol-id '*)))
          (then (local.set $wild (i32.const 1)))
          (else
            (if (i32.ne (call $tag (local.get $axis)) (i32.const 1))
              (then (return (i32.const 0) (i32.const -1) (ref.null eq))))
            (if (i32.lt_s (call $value-n (local.get $axis)) (i32.const 0))
              (then (return (i32.const 0) (i32.const -1) (ref.null eq))))
            (if (i32.gt_u (call $bitlength (ref.as_non_null (local.get $axis))) (i32.const 29))
              (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
            (local.set $size (call $natural-count (local.get $axis)))
            (if (i32.ge_u (local.get $size) (i32.const 536870911))
              (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
            (if (i32.eqz (local.get $size))
              (then (local.set $product (i32.const 0)) (local.set $overflow (i32.const 0)))
              (else (if (i32.eqz (local.get $overflow))
                (then (if (i32.gt_u (local.get $product) (i32.div_u (i32.const 536870910) (local.get $size)))
                  (then (local.set $overflow (i32.const 1)))
                  (else (local.set $product (i32.mul (local.get $product) (local.get $size)))))))))))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (if (i32.ge_u (local.get $count) (i32.const 256))
          (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
        (local.set $scan (call $cdr (local.get $scan))) (br $next)))
      (local.set $rank (local.get $count))
      (if (i32.and (local.get $overflow) (i32.eqz (local.get $wild)))
        (then (return (i32.const 32) (local.get $rank) (ref.null eq))))))
  #@(local.get $flags) #@(local.get $rank) #@(local.get $shape))

(define-runtime-function $array-intersection-info (($type :nullable-object) ($env :nullable-object)) (i32 i32 :nullable-object)
  (:locals ($scan :nullable-object) ($shape :nullable-object) ($next-shape :nullable-object)
           ($left :nullable-object) ($right :nullable-object) ($x :nullable-object) ($y :nullable-object)
           ($merged :nullable-object) ($tail :nullable-object) ($cell :nullable-object)
           ($flags i32) ($rank i32) ($next-flags i32) ($next-rank i32) ($seen i32) ($unknown i32))
  #@(local.set $scan (call $cdr (local.get $type)))
  #@(local.set $flags (i32.const 15)) #@(local.set $rank (i32.const -1))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (call $array-type-info (call $car (local.get $scan)) (local.get $env))
    (local.set $next-shape) (local.set $next-rank) (local.set $next-flags)
    (if (i32.eq (local.get $next-flags) (i32.const 32))
      (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
    (if (i32.eqz (local.get $next-flags)) (then (local.set $unknown (i32.const 1)))
      (else (if (i32.ne (local.get $next-flags) (i32.const 64))
        (then
          (local.set $seen (i32.const 1))
          (local.set $flags (i32.or (i32.and (i32.and (local.get $flags) (local.get $next-flags)) (i32.const 15))
            (i32.and (i32.or (local.get $flags) (local.get $next-flags)) (i32.const 16))))
          (if (i32.eqz (i32.and (local.get $flags) (i32.const 15)))
            (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
          (if (i32.and (i32.and (i32.ge_s (local.get $rank) (i32.const 0))
                               (i32.ge_s (local.get $next-rank) (i32.const 0)))
                       (i32.ne (local.get $rank) (local.get $next-rank)))
            (then (return (i32.const 32) (i32.const -1) (ref.null eq))))
          (if (i32.lt_s (local.get $rank) (i32.const 0)) (then (local.set $rank (local.get $next-rank))))
          (if (ref.is_null (local.get $shape)) (then (local.set $shape (local.get $next-shape)))
            (else (if (i32.eqz (ref.is_null (local.get $next-shape)))
              (then
                (local.set $left (local.get $shape)) (local.set $right (local.get $next-shape))
                (local.set $merged (ref.null eq)) (local.set $tail (ref.null eq))
                (block $merged (loop $axis (br_if $merged (ref.is_null (local.get $left)))
                  (local.set $x (call $car (local.get $left))) (local.set $y (call $car (local.get $right)))
                  (if (i32.eq (call $id (local.get $x)) (i32.const ,(runtime-symbol-id '*)))
                    (then (local.set $x (local.get $y)))
                    (else (if (i32.and
                      (i32.ne (call $id (local.get $y)) (i32.const ,(runtime-symbol-id '*)))
                      (i32.eqz (call $eql (local.get $x) (local.get $y))))
                      (then (return (i32.const 32) (i32.const -1) (ref.null eq))))))
                  (local.set $cell (call $cons (local.get $x) (ref.null eq)))
                  (if (ref.is_null (local.get $tail)) (then (local.set $merged (local.get $cell)))
                    (else (struct.set $obj $b (ref.cast (ref $obj) (local.get $tail)) (local.get $cell))))
                  (local.set $tail (local.get $cell))
                  (local.set $left (call $cdr (local.get $left))) (local.set $right (call $cdr (local.get $right)))
                  (br $axis)))
                (local.set $shape (local.get $merged))))))))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(if (local.get $unknown) (then (return (i32.const 0) (i32.const -1) (ref.null eq))))
  #@(if (i32.eqz (local.get $seen)) (then (return (i32.const 64) (i32.const -1) (ref.null eq))))
  #@(call $array-shape-info (local.get $flags) (local.get $rank) (local.get $shape)))

(define-runtime-function $array-subtypep (($a :nullable-object) ($b :nullable-object) ($env :nullable-object)) (i32)
  (:locals ($af i32) ($bf i32) ($ar i32) ($br i32) ($as :nullable-object) ($bs :nullable-object)
           ($axis :nullable-object) ($name :nullable-object) ($class :nullable-object))
  #@(call $array-type-info (local.get $a) (local.get $env))
  #@(local.set $as) #@(local.set $ar) #@(local.set $af)
  #@(if (i32.eq (local.get $af) (i32.const 32)) (then (return (i32.const 1))))
  #@(call $array-type-info (local.get $b) (local.get $env))
  #@(local.set $bs) #@(local.set $br) #@(local.set $bf)
  #@(if (i32.eq (local.get $bf) (i32.const 64)) (then (return (i32.const 1))))
  #@(if (i32.and (i32.eq (local.get $af) (i32.const 64)) (i32.ne (local.get $bf) (i32.const 0)))
    (then (return (i32.const 2))))
  #@(if (i32.and (i32.ne (local.get $af) (i32.const 0)) (i32.ne (local.get $bf) (i32.const 0)))
    (then
      (if (i32.eq (local.get $bf) (i32.const 32)) (then (return (i32.const 2))))
      (if (i32.ne (i32.and (i32.and (local.get $af) (i32.const 15)) (local.get $bf))
                  (i32.and (local.get $af) (i32.const 15)))
        (then (return (i32.const 2))))
      ;; A simple source is included in the corresponding general array type.
      ;; Element kind and simplicity are independent constraints.
      (if (i32.and (i32.ne (i32.and (local.get $bf) (i32.const 16)) (i32.const 0))
        (i32.eqz (i32.and (local.get $af) (i32.const 16)))) (then (return (i32.const 2))))
      (if (i32.ge_s (local.get $br) (i32.const 0))
        (then (if (i32.ne (local.get $ar) (local.get $br)) (then (return (i32.const 2))))))
      (block $done (loop $axis (br_if $done (ref.is_null (local.get $bs)))
        (local.set $axis (call $car (local.get $bs)))
        (if (i32.ne (call $id (local.get $axis)) (i32.const ,(runtime-symbol-id '*)))
          (then
            (if (ref.is_null (local.get $as)) (then (return (i32.const 2))))
            (if (i32.eqz (call $eql (call $car (local.get $as)) (local.get $axis)))
              (then (return (i32.const 2))))))
        (local.set $as (call $cdr (local.get $as))) (local.set $bs (call $cdr (local.get $bs))) (br $axis)))
      (return (i32.const 1))))
  #@(if (local.get $af)
    (then
      (local.set $name (local.get $b))
      (local.set $class (call $subtype-class (local.get $b)))
      (if (i32.eqz (ref.is_null (local.get $class)))
        (then (local.set $name (call $car (call $property-cell (struct.get $obj $b (ref.cast (ref $obj) (local.get $class)))
          ,(clos-library-reference :name))))))
      (if (i32.eq (call $id (local.get $name)) (i32.const 1)) (then (return (i32.const 1))))
      (if (i32.eq (call $id (local.get $name)) (i32.const ,(runtime-symbol-id 'atom)))
        (then (return (select (i32.const 2) (i32.const 1) (i32.eq (local.get $af) (i32.const 64))))))
      (if (i32.eq (call $id (local.get $name)) (i32.const ,(runtime-symbol-id 'sequence)))
        (then (return (select (i32.const 1) (i32.const 2) (i32.eq (local.get $ar) (i32.const 1))))))
      (if (i32.eqz (ref.is_null (local.get $class)))
        (then (if (i32.eqz (ref.is_null (call $car (call $property-cell (struct.get $obj $b (ref.cast (ref $obj) (local.get $class)))
          ,(clos-library-reference :finalized))))) (then (return (i32.const 2))))))
      (if (i32.eq (call $tag (local.get $name)) (i32.const 7))
        (then (local.set $name (call $car (local.get $name)))))
      ,(wat-symbol-case #@(call $id (local.get $name))
         ((boolean keyword standard-char base-char extended-char bit signed-byte unsigned-byte
            compiled-function integer mod rational ratio float real single-float double-float short-float long-float
            complex cons function eql member)
           #@(return (i32.const 2))))))
  #@(if (local.get $bf)
    (then
      (local.set $class (call $subtype-class (local.get $a)))
      (if (i32.eqz (ref.is_null (local.get $class)))
        (then (if (i32.eqz (ref.is_null (call $car (call $property-cell (struct.get $obj $b (ref.cast (ref $obj) (local.get $class)))
          ,(clos-library-reference :finalized))))) (then (return (i32.const 2))))))))
  #@(i32.const 0))

(define-runtime-section array-type-runtime-wat ()
  ($array-type-info) ($array-shape-info) ($array-intersection-info) ($array-subtypep))
