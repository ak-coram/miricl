;;;; Interpreter debugging. Native code carries no debugger instrumentation.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun debug-protected-call (expression cleanup)
  (runtime-wat-sequence
    #@(block $returned
      (block $thrown
        (try_table (catch $transfer $thrown)
          (local.set $result ,(runtime-wat-sequence expression)) (br $returned)))
      (local.set $thrown (i32.const 1)))
    cleanup
    #@(if (local.get $thrown) (then (throw $transfer)))
    #@(local.get $result)))

(define-runtime-function $debug-declarations (($specs :nullable-object) ($level i32)) (i32)
  (:locals ($spec :nullable-object) ($value :nullable-object))
  #@(if (i32.eqz (global.get $debug-ready)) (then (return (local.get $level))))
  (wat-list-loop ($specs)
    #@(local.set $spec (call $car (local.get $specs)))
    #@(if (i32.eq (call $operator (local.get $spec)) (i32.const ,(runtime-symbol-id 'optimize)))
      (then
        (local.set $value (call $apply ,(clos-library-reference '%optimize-debug-level)
          (call $cons (call $cdr (local.get $spec))
            (call $cons (if (result (ref null $obj)) (i32.lt_s (local.get $level) (i32.const 0))
              (then (ref.null $obj)) (else (call $int (local.get $level)))) (ref.null $obj)))))
        (if (i32.eqz (ref.is_null (local.get $value)))
          (then (local.set $level (call $natural-count (local.get $value))))))))
  #@(local.get $level))

(define-runtime-function $debug-closure-body (($body :nullable-object) ($env :nullable-object)) (:nullable-object)
  (:locals ($scan :nullable-object) ($binding :nullable-object) ($level i32))
  #@(if (i32.eqz (global.get $debug-ready)) (then (return (local.get $body))))
  #@(local.set $level (i32.const -1))
  #@(local.set $scan (local.get $body))
  #@(block $done (loop $next
    (br_if $done (i32.ne (call $operator (call $car (local.get $scan))) (i32.const ,(runtime-symbol-id 'declare))))
    (local.set $level (call $debug-declarations (call $cdr (call $car (local.get $scan))) (local.get $level)))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(if (i32.ge_s (local.get $level) (i32.const 0)) (then (return (local.get $body))))
  #@(local.set $binding (call $find (local.get $env) (call $id ,(clos-library-reference '%debug-level))))
  #@(if (ref.is_null (local.get $binding))
    (then
      (if (i32.eqz (call $boundp ,(clos-library-reference '%debug-default-level))) (then (return (local.get $body))))
      (local.set $level (call $natural-count (call $symbol-value ,(clos-library-reference '%debug-default-level)))))
    (else (local.set $level (call $natural-count (call $binding-value (local.get $binding))))))
  #@(if (i32.ne (local.get $level) (i32.const 3)) (then (return (local.get $body))))
  ;; Capture the lexical policy, sharing the existing executable body.
  #@(call $cons (call $symbol-value ,(clos-library-reference '%debug-declaration)) (local.get $body)))

(define-runtime-function $debug-body
    (($body :nullable-object) ($env :nullable-object) ($stop :nullable-object) ($level i32)) (:nullable-object)
  (:locals ($saved :nullable-object) ($enabled i32) ($frame :nullable-object)
           ($name :nullable-object) ($result :nullable-object) ($thrown i32))
  #@(local.set $saved (global.get $debug-frames))
  #@(local.set $enabled (global.get $debug-evaluating))
  #@(local.set $env (call $bind (local.get $env) ,(clos-library-reference '%debug-level) (call $int (local.get $level))))
  #@(global.set $debug-evaluating (i32.eq (local.get $level) (i32.const 3)))
  #@(if (global.get $debug-evaluating)
    (then
      (local.set $name (if (result (ref null $obj)) (global.get $backtrace-depth)
        (then (call $backtrace-name (array.get $objects (global.get $backtrace-frames)
          (i32.and (i32.sub (global.get $backtrace-depth) (i32.const 1)) (i32.const 63)))))
        (else (call $symbol (i32.const ,(runtime-symbol-id 'eval))))))
      (local.set $frame (call $vector-from-list
        (call $cons (local.get $name) (call $cons (ref.null $obj)
          (call $cons (local.get $env) (call $cons (call $int (global.get $debug-depth))
            (call $cons (ref.null $obj) (call $cons (call $int (global.get $backtrace-depth)) (ref.null $obj))))))) (i32.const 6)))
      (global.set $debug-frames (call $cons (local.get $frame) (global.get $debug-frames)))))
  (debug-protected-call #@(call $body (local.get $body) (local.get $env) (local.get $stop))
    #@(block (global.set $debug-frames (local.get $saved)) (global.set $debug-evaluating (local.get $enabled)))))

(define-runtime-function $eval (($form :nullable-object) ($env :nullable-object)) (:nullable-object)
  #@(if (global.get $debug-evaluating)
    (then (return_call $debug-eval (local.get $form) (local.get $env))))
  #@(return_call $eval0 (local.get $form) (local.get $env)))

(define-runtime-function $debug-eval (($form :nullable-object) ($env :nullable-object)) (:nullable-object)
  (:locals ($frame (ref $objects)) ($form0 :nullable-object) ($env0 :nullable-object)
           ($result :nullable-object) ($thrown i32) ($depth i32) ($entry :nullable-object))
  #@(local.set $frame (call $vector-data (call $car (global.get $debug-frames))))
  #@(local.set $form0 (array.get $objects (local.get $frame) (i32.const 1)))
  #@(local.set $env0 (array.get $objects (local.get $frame) (i32.const 2)))
  #@(local.set $depth (global.get $debug-depth))
  #@(global.set $debug-depth (i32.add (local.get $depth) (i32.const 1)))
  #@(array.set $objects (local.get $frame) (i32.const 1) (local.get $form))
  #@(array.set $objects (local.get $frame) (i32.const 2) (local.get $env))
  #@(local.set $entry (call $bool (ref.is_null (array.get $objects (local.get $frame) (i32.const 4)))))
  #@(array.set $objects (local.get $frame) (i32.const 4) (call $symbol (i32.const 1)))
  (debug-protected-call
    #@(block (result (ref null $obj))
      (drop (call $apply ,(clos-library-reference 'miricl-debugger::%before-form)
        (call $cons (call $car (global.get $debug-frames)) (call $cons (local.get $entry) (ref.null $obj)))))
      (call $eval0 (local.get $form) (local.get $env)))
    #@(block
      (array.set $objects (local.get $frame) (i32.const 1) (local.get $form0))
      (array.set $objects (local.get $frame) (i32.const 2) (local.get $env0))
      (global.set $debug-depth (local.get $depth)))))

(define-runtime-function $apply (($name :nullable-object) ($args :nullable-object)) (:nullable-object)
  #@(if (global.get $debug-evaluating)
    (then (return_call $debug-apply (local.get $name) (local.get $args))))
  #@(return_call $apply0 (local.get $name) (local.get $args)))

(define-runtime-function $debug-apply (($name :nullable-object) ($args :nullable-object)) (:nullable-object)
  (:locals ($result :nullable-object) ($thrown i32))
  ;; Callees select their own lexical policy. Debugger/library/native calls do
  ;; not inherit stepping dynamically from their interpreted caller.
  #@(global.set $debug-evaluating (i32.const 0))
  (debug-protected-call #@(call $apply0 (local.get $name) (local.get $args))
    #@(global.set $debug-evaluating (i32.const 1))))

(define-runtime-function $debug-stack-string () (:nullable-object)
  (:locals ($cursor i32) ($i i32) ($bytes (ref $digits)) ($text :nullable-object))
  ;; Diagnostic formatting shares the transport scratch buffer. Preserve output
  ;; already produced by the stopped application before formatting the trace.
  #@(local.set $cursor (global.get $cursor))
  #@(local.set $bytes (array.new_default $digits (local.get $cursor)))
  #@(block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (local.get $cursor)))
    (array.set $digits (local.get $bytes) (local.get $i) (i32.load8_u (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(global.set $cursor (i32.const 0))
  #@(call $print-backtrace)
  #@(local.set $text (call $decode-text (i32.const 0) (global.get $cursor)))
  #@(local.set $i (i32.const 0))
  #@(block $done (loop $next (br_if $done (i32.ge_u (local.get $i) (local.get $cursor)))
    (i32.store8 (local.get $i) (array.get $digits (local.get $bytes) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(global.set $cursor (local.get $cursor))
  #@(local.get $text))

(define-runtime-function $debug-operation (($args :nullable-object)) (:nullable-object)
  (:locals ($op i32) ($a :nullable-object) ($b :nullable-object) ($env :nullable-object)
           ($binding :nullable-object) ($result :nullable-object) ($seen :nullable-object) ($name :nullable-object))
  (wat-arity 1 3)
  #@(local.set $op (call $natural-count (call $car (local.get $args))))
  #@(local.set $a (call $car (call $cdr (local.get $args))))
  #@(local.set $b (call $car (call $cdr (call $cdr (local.get $args)))))
  #@(if (i32.eqz (local.get $op)) (then (return (call $copy-spine (global.get $debug-frames) (i32.const 0)))))
  #@(if (i32.eq (local.get $op) (i32.const 3))
    (then (return_call $debug-stack-string)))
  #@(if (i32.eq (local.get $op) (i32.const 4))
    (then (global.set $debug-step-depth
      (if (result i32) (ref.is_null (local.get $a)) (then (i32.const -1))
        (else (i32.sub (call $natural-count (local.get $a)) (i32.const 2))))) (return (ref.null $obj))))
  #@(if (i32.eq (local.get $op) (i32.const 5))
    (then (return (call $bool (i32.or (i32.eq (global.get $debug-step-depth) (i32.const -2))
      (i32.and (i32.ge_s (global.get $debug-step-depth) (i32.const 0))
        (i32.le_s (global.get $debug-depth) (global.get $debug-step-depth))))))))
  #@(if (i32.eq (local.get $op) (i32.const 6)) (then (return (call $int (global.get $debug-depth)))))
  #@(if (i32.eq (local.get $op) (i32.const 8)) (then (return (call $int (global.get $backtrace-saved-depth)))))
  #@(if (i32.eq (local.get $op) (i32.const 9)) (then (return (call $int (call $thread-id)))))
  #@(if (i32.eq (local.get $op) (i32.const 10))
    (then (global.set $debug-internal (i32.eqz (ref.is_null (local.get $a)))) (return (ref.null $obj))))
  #@(if (i32.eq (local.get $op) (i32.const 11))
    (then (return (call $bool (i32.and (global.get $debug-connected) (i32.eqz (global.get $debug-internal)))))))
  #@(if (i32.or (i32.eq (local.get $op) (i32.const 12)) (i32.eq (local.get $op) (i32.const 13)))
    (then
      (if (ref.is_null (table.get $debug-terminal-services (i32.const 0))) (then ,(wat-fail :unsupported)))
      (return (call_indirect $debug-terminal-services (type $debug-terminal-service-type)
        (i32.sub (local.get $op) (i32.const 12)) (local.get $a) (i32.const 0)))))
  #@(if (i32.eqz (call $member-eq (local.get $a) (global.get $debug-frames))) (then ,(wat-fail :control-error)))
  #@(local.set $env (array.get $objects (call $vector-data (local.get $a)) (i32.const 2)))
  #@(if (i32.eq (local.get $op) (i32.const 1)) (then (return_call $eval (local.get $b) (local.get $env))))
  #@(if (i32.eq (local.get $op) (i32.const 2))
    (then
      (block $done (loop $next (br_if $done (ref.is_null (local.get $env)))
        (local.set $binding (call $car (local.get $env)))
        (if (i32.and (i32.eq (call $tag (local.get $binding)) (i32.const 9))
                    (i32.and (i32.ge_s (struct.get $obj $n (local.get $binding)) (i32.const 0))
                      (i32.eqz (ref.is_null (struct.get $obj $a (local.get $binding))))))
          (then
            (local.set $name (struct.get $obj $c (struct.get $obj $a (local.get $binding))))
            (if (i32.and (i32.eqz (call $member-eq (local.get $name) (local.get $seen)))
                        (i32.ne (call $id (local.get $name)) (call $id ,(clos-library-reference '%debug-level))))
              (then
                (local.set $seen (call $cons (local.get $name) (local.get $seen)))
                (if (ref.is_null (struct.get $obj $c (local.get $binding)))
                  (then (local.set $result (call $cons
                    (call $cons (local.get $name) (call $binding-value (local.get $binding))) (local.get $result)))))))))
        (local.set $env (call $cdr (local.get $env))) (br $next)))
      (return (call $reverse-onto (local.get $result) (ref.null $obj) (i32.const 1)))))
  (wat-fail :unsupported)
  #@(ref.null $obj))

(define-runtime-section debugger-runtime-wat ()
  #@(type $debug-terminal-service-type (func (param i32 (ref null $obj)) (result (ref null $obj))))
  #@(table $debug-terminal-services 1 1 funcref)
  #@(global $debug-ready (mut i32) (i32.const 0))
  #@(global $debug-connected (export "debugger-connected") (mut i32) (i32.const 0))
  #@(global $debug-evaluating (mut i32) (i32.const 0))
  #@(global $debug-internal (mut i32) (i32.const 0))
  #@(global $debug-depth (mut i32) (i32.const 0))
  #@(global $debug-step-depth (mut i32) (i32.const -1))
  #@(global $debug-frames (mut (ref null $obj)) (ref.null $obj))
  ($debug-declarations) ($debug-closure-body) ($debug-body) ($eval) ($debug-eval)
  ($apply) ($debug-apply) ($debug-stack-string) ($debug-operation))
