;;;; MIRICL host support for FLOAT-FEATURES, using native Wasm reinterpretations.
(in-package :float-features)
(defun single-float-bits (x) (check-type x single-float) (miricl:float-bits x))
(defun double-float-bits (x) (check-type x double-float) (miricl:float-bits x))
(defun bits-single-float (bits)
  (miricl:bits-float (logand #xffffffff bits) 0f0))
(defun bits-double-float (bits)
  (miricl:bits-float (logand #xffffffffffffffff bits) 0d0))
(defun short-float-bits (x) (single-float-bits x))
(defun long-float-bits (x) (double-float-bits x))
(defun bits-short-float (x) (bits-single-float x))
(defun bits-long-float (x) (bits-double-float x))
(defun float-nan-p (x)
  (let* ((bits (miricl:float-bits x))
         (exponent (if (typep x 'single-float) #x7f800000 #x7ff0000000000000))
         (fraction (if (typep x 'single-float) #x7fffff #xfffffffffffff)))
    (and (= (logand bits exponent) exponent) (not (zerop (logand bits fraction))))))
(defun float-infinity-p (x)
  (let ((bits (miricl:float-bits x)))
    (if (typep x 'single-float)
        (= (logand bits #x7fffffff) #x7f800000)
        (= (logand bits #x7fffffffffffffff) #x7ff0000000000000))))
(defmacro with-float-traps-masked (traps &body body)
  (declare (ignore traps))
  `(let ((miricl:*trap-floating-point-underflow* nil)) ,@body))
(defmacro with-rounding-mode (mode &body body)
  (if (eq mode :nearest) `(progn ,@body)
    `(error "Wasm floating-point arithmetic supports round-to-nearest only.")))
