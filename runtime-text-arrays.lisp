;;;; Sharpsign readers for bit vectors and arrays.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $source-bit-vector (($size :nullable-object)) (:nullable-object)
  (:locals ($start i32) ($count i32) ($length i32) ($last i32) ($i i32) ($c i32) ($bars i32)
           ($result :nullable-object) ($bits :digits))
  #@(local.set $start (global.get $source-position))
  #@(local.set $bits (if (result (ref $digits)) (global.get $source-generic)
    (then (local.set $start (i32.const 0)) (call $reader-buffer (i32.const 0)))
    (else (global.get $source))))
  #@(block $scanned (loop $scan
    (local.set $c (call $source-peek))
    (if (i32.eq (local.get $c) (i32.const -1))
      (then (if (local.get $bars) (then (global.set $text-status (i32.const 1)))) (br $scanned)))
    (br_if $scanned (i32.and (i32.eqz (local.get $bars)) (call $delimiter (local.get $c))))
    (drop (call $source-take))
    (if (global.get $source-suppress)
      (then
        (if (i32.eq (local.get $c) (i32.const 124)) (then (local.set $bars (i32.eqz (local.get $bars)))))
        (if (i32.eq (local.get $c) (i32.const 92)) (then (drop (call $source-take))))
        (br_if $scanned (global.get $text-status)) (br $scan)))
    ,(wat-fail-when #@(i32.gt_u (i32.sub (local.get $c) (i32.const 48)) (i32.const 1)) :reader-syntax)
    (local.set $last (i32.sub (local.get $c) (i32.const 48)))
    (if (global.get $source-generic)
      (then
        (if (i32.eq (local.get $count) (array.len (local.get $bits)))
          (then (local.set $bits (call $grow-reader-buffer (local.get $bits)))))
        (array.set $digits (local.get $bits) (local.get $count) (local.get $c))))
    (local.set $count (i32.add (local.get $count) (i32.const 1))) (br $scan)))
  #@(if (i32.or (global.get $text-status) (global.get $source-suppress)) (then (return (ref.null $obj))))
  #@(local.set $length (local.get $count))
  #@(if (i32.eqz (ref.is_null (local.get $size)))
    (then
      (local.set $length (call $natural-count (local.get $size)))
      ,(wat-fail-when #@(i32.or (i32.gt_u (local.get $length) (i32.const 536870910))
        (i32.or (i32.lt_u (local.get $length) (local.get $count))
          (i32.and (i32.ne (local.get $length) (i32.const 0)) (i32.eqz (local.get $count))))) :reader-syntax)))
  #@(local.set $result (call $make-bit-vector (local.get $length) (call $int (local.get $last))))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $count)))
    (drop (call $array-raw-element (local.get $result) (local.get $i)
      (call $int (i32.sub (array.get $digits (local.get $bits) (i32.add (local.get $start) (local.get $i))) (i32.const 48)))
      (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(local.get $result))

(define-runtime-function $source-array (($rank-object :nullable-object)) (:nullable-object)
  (:locals ($contents :nullable-object) ($cursor :nullable-object) ($dimensions :nullable-object)
           ($axis i32) ($rank i32) ($length i32) ($zero i32))
  #@(local.set $contents (call $source-form))
  #@(if (i32.or (global.get $text-status) (global.get $source-suppress)) (then (return (ref.null $obj))))
  (wat-fail-when #@(ref.is_null (local.get $rank-object)) :reader-syntax)
  #@(local.set $rank (call $natural-count (local.get $rank-object)))
  (wat-fail-when #@(i32.ge_u (local.get $rank) (i32.const 256)) :reader-syntax)
  #@(local.set $cursor (local.get $contents))
  #@(block $shaped (loop $shape (br_if $shaped (i32.eq (local.get $axis) (local.get $rank)))
    (if (i32.eqz (local.get $zero))
      (then
        ,(wat-fail-when #@(i32.eqz (i32.or (call $vectorp-native (local.get $cursor))
          (i32.or (ref.is_null (local.get $cursor)) (i32.eq (call $tag (local.get $cursor)) (i32.const 7))))) :reader-syntax)
        (local.set $length (call $array-contents-length (local.get $cursor) (i32.const 1)))
        (if (i32.eqz (local.get $length)) (then (local.set $zero (i32.const 1)))
          (else (local.set $cursor (call $sequence-value (local.get $cursor) (i32.const 0)))))))
    (local.set $dimensions (call $cons (call $int (local.get $length)) (local.get $dimensions)))
    (local.set $axis (i32.add (local.get $axis) (i32.const 1))) (br $shape)))
  #@(local.set $dimensions (call $reverse-onto (local.get $dimensions) (ref.null $obj) (i32.const 1)))
  #@(call $make-array-native (local.get $dimensions) (i32.const 0) (ref.null $obj) (local.get $contents)
    (i32.const 6) (i32.const 0) (ref.null $obj) (ref.null $obj) (call $int (i32.const 0))
    (call $symbol (i32.const 1))))

(define-runtime-section text-arrays-wat ()
  ($source-bit-vector) ($source-array))
