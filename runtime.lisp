;;;; Compose one WasmGC module from the runtime subsystems.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun interpreter-wat (&key wasi (compiler t))
  (let* ((*include-compiler* compiler)
         (*native-compiler-image* (and compiler *native-compiler-image*))
         (*clos-library* (if compiler *clos-library* *interpreter-library*))
         (*clos-library-symbols* (if compiler *clos-library-symbols*
            (stable-sort (copy-list (union *clos-primitives* (runtime-library-symbols *clos-library*)))
                         #'string< :key #'symbol-name)))
         (*runtime-library-symbol-codes* (if compiler *runtime-library-symbol-codes*
            (runtime-library-symbol-codes
              (list (list *loop-library* *loop-library-symbols* 25)
                    (list *clos-library* *clos-library-symbols* 24 *loop-library-symbols*)))))
         (*core-types* nil)
         (*core-roots* nil)
         (*wat-declaration-hook* (unless wasi #'core-wat-declaration))
         (*compile-evaluations-default* (and *native-compiler-image* (not wasi) t))
        (*runtime-function-definitions*
          (make-array 0 :adjustable t :fill-pointer 0))
        (*runtime-output-literals* (make-hash-table :test 'equal))
        (*runtime-output-bytes* (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    #@(module
      ,@(when wasi (list (wasi-imports-wat)))
      ,(object-runtime-wat :wasi wasi)
      ,(vector-runtime-wat)
      ,(array-runtime-wat)
      ,(bit-array-runtime-wat)
      ,(array-adjust-runtime-wat)
      ,(readtable-runtime-wat)
      ,(pprint-runtime-wat)
      ,(print-circle-runtime-wat)
      ,(list-runtime-wat)
      ,(list-utilities-runtime-wat)
      ,(integer-runtime-wat)
      ,(rational-runtime-wat)
      ,(float-runtime-wat)
      ,(float-properties-runtime-wat)
      ,(numeric-runtime-wat)
      ,(transcendental-runtime-wat)
      ,(elementary-functions-runtime-wat)
      ,(inverse-functions-runtime-wat)
      ,(integer-bits-runtime-wat)
      ,(byte-fields-runtime-wat)
      ,(hash-runtime-wat)
      ,(string-runtime-wat)
      ,(character-runtime-wat)
      ,(symbol-runtime-wat)
      ,(symbol-functions-runtime-wat)
      ,(equality-runtime-wat)
      ,(values-runtime-wat)
      ,(package-runtime-wat)
      ,(type-runtime-wat)
      ,(derived-type-runtime-wat)
      ,(integer-type-runtime-wat)
      ,(real-type-runtime-wat)
      ,(array-type-runtime-wat)
      ,(complex-type-runtime-wat)
      ,(environment-runtime-wat)
      ,(condition-runtime-wat)
      ,(backtrace-runtime-wat)
      ,(debugger-runtime-wat)
      ,(eval-runtime-wat)
      ,(loop-runtime-wat)
      ,(clos-runtime-wat)
      ,(generic-functions-runtime-wat)
      ,(development-runtime-wat)
      ,(fasl-codec-runtime-wat)
      ,(native-code-runtime-wat)
      ,(native-optimizer-runtime-wat)
      ,(sequence-runtime-wat)
      ,(list-operations-runtime-wat)
      ,(sequence-construction-runtime-wat)
      ,(sequence-removal-runtime-wat)
      ,(sequence-duplicates-runtime-wat)
      ,(sequence-search-runtime-wat)
      ,(sequence-comparison-runtime-wat)
      ,(sequence-ordering-runtime-wat)
      ,(rounding-runtime-wat)
      ,(random-runtime-wat)
      ,(sequence-binding-runtime-wat)
      ,(tree-operations-runtime-wat)
      ,(sequence-reduce-runtime-wat)
      ,(apply-runtime-wat)
      ,(io-runtime-wat)
      ,(text-runtime-wat)
      ,(format-runtime-wat)
      ,(reporting-runtime-wat)
      ,(input-stream-runtime-wat)
      ,(stream-sequence-runtime-wat)
      ,(constructed-stream-runtime-wat)
      ,(file-runtime-wat)
      ,(file-host-runtime-wat)
      ,(time-runtime-wat)
      ,(javascript-runtime-wat)
      ,(thread-runtime-wat)
      ,@(when wasi (list (wasi-repl-wat)))
      ,($evaluate)
      ,@(when wasi (list (thread-native-wat)))
      ,@(unless wasi (list (core-image-runtime-wat)))
      (data $output-literal-data ,(runtime-library-data *runtime-output-bytes*))
      ;; Use the same layout in both images, leaving room for the two raw
      ;; function declarations and the five optional WASI imports.
      ,(runtime-function-layout *runtime-function-definitions*
                                :reserved-functions 7)
      ,(wat-fragment (if *native-compiler-image* (first *native-compiler-image*) "")))))
