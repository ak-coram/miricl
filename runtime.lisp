;;;; Compose one WasmGC module from the runtime subsystems.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun compact-bootstrap-package-forms (forms)
  ;; READ-CLOS-LIBRARY establishes every file's private identities before its
  ;; macros run. Subsequent files often repeat those same imports and exports.
  ;; Keep each symbol's first installation, including generated record names;
  ;; neither the private symbol table nor its identities change. Match only
  ;; the generated preamble, not package operations in library source bodies.
  (let ((imports (make-hash-table :test 'equal))
        (exports (make-hash-table :test 'equal)))
    (mapcar
      (lambda (form)
        (let* ((binding (and (consp form) (eq (car form) 'let)
                             (consp (second form)) (first (second form))))
               (name (and (consp binding) (consp (second binding))
                          (consp (second (second binding)))
                          (second (second (second binding)))))
               (import-call (and (consp form) (third form)))
               (export-call (and (consp form) (fourth form)))
               (imported (and (consp import-call) (eq (car import-call) 'shadowing-import)
                              (consp (second import-call)) (second (second import-call))))
               (exported (and (consp export-call) (eq (car export-call) 'export)
                              (consp (second export-call)) (second (second export-call)))))
          (if (and (stringp name)
                   (equal form
                     `(let ((package (or (find-package ,name)
                                         (make-package ,name :use '("CL")))))
                        (shadowing-import ',imported package)
                        (export ',exported package))))
              (let* ((old-imports (gethash name imports))
                     (old-exports (gethash name exports))
                     (new-imports (remove-if (lambda (symbol) (member symbol old-imports)) imported))
                     (new-exports (remove-if (lambda (symbol) (member symbol old-exports)) exported)))
                (setf (gethash name imports) (union imported old-imports)
                      (gethash name exports) (union exported old-exports))
                `(let ,(second form)
                   ,@(when new-imports `((shadowing-import ',new-imports package)))
                   ,@(when new-exports `((export ',new-exports package)))))
              form)))
      forms)))

(defun interpreter-wat (&key wasi (compiler t))
  (let* ((*include-compiler* compiler) (*source-bootstrap-p* t)
         (*native-compiler-image* (and compiler *native-compiler-image*))
         (*clos-library* (if compiler
                             (if *native-compiler-image*
                                 (compact-bootstrap-package-forms *clos-library*)
                                 *clos-library*)
                             *interpreter-library*))
         (*clos-library-symbols* (if compiler *clos-library-symbols* (clos-library-symbols *clos-library*)))
         (*compile-evaluations-default* (and *native-compiler-image* (not wasi) t))
         (libraries (list (list *loop-library* *loop-library-symbols* 25 *loop-library-symbols*)
                          (list (compiler-image-library-forms) *clos-library-symbols* 24 *loop-library-symbols*)))
         (*runtime-library-prefixes* (if *runtime-library-optimize-prefixes*
                                        (runtime-library-prefixes libraries) *runtime-library-prefixes*))
         (*runtime-library-symbol-codes*
            (runtime-library-symbol-codes
              libraries))
         (*core-types* nil)
         (*core-roots* nil)
         (*wat-declaration-hook* (unless wasi #'core-wat-declaration))
        (*runtime-function-definitions*
          (make-array 0 :adjustable t :fill-pointer 0))
        (miricl-cross::*kernel-shared-workers*
          (when miricl-cross::*kernel-share-helpers* (make-hash-table :test 'equal)))
        (*runtime-output-literals* (make-hash-table :test 'equal))
        (*runtime-output-bytes* (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    #@(module
      ,@(when wasi (list (wasi-imports-wat)))
      ,(object-runtime-wat :wasi wasi)
      ,(vector-runtime-wat)
      ,(array-runtime-wat)
      ,(bit-array-runtime-wat)
      ,(array-adjust-runtime-wat)
      ,(readtable-runtime-wat)
      ,(pprint-runtime-wat)
      ,(print-circle-runtime-wat)
      ,(list-runtime-wat)
      ,(list-utilities-runtime-wat)
      ,(integer-runtime-wat)
      ,(rational-runtime-wat)
      ,(float-runtime-wat)
      ,(float-properties-runtime-wat)
      ,(numeric-runtime-wat)
      ,(transcendental-runtime-wat)
      ,(elementary-functions-runtime-wat)
      ,(inverse-functions-runtime-wat)
      ,(integer-bits-runtime-wat)
      ,(byte-fields-runtime-wat)
      ,(hash-runtime-wat)
      ,(string-runtime-wat)
      ,(character-runtime-wat)
      ,(symbol-runtime-wat)
      ,(symbol-functions-runtime-wat)
      ,(equality-runtime-wat)
      ,(values-runtime-wat)
      ,(package-runtime-wat)
      ,(type-runtime-wat)
      ,(derived-type-runtime-wat)
      ,(integer-type-runtime-wat)
      ,(real-type-runtime-wat)
      ,(array-type-runtime-wat)
      ,(complex-type-runtime-wat)
      ,(environment-runtime-wat)
      ,(condition-runtime-wat)
      ,(backtrace-runtime-wat)
      ,(debugger-runtime-wat)
      ,(eval-runtime-wat)
      ,(loop-runtime-wat)
      ,(clos-runtime-wat)
      ,(generic-functions-runtime-wat)
      ,(clos-defaults-runtime-wat)
      ,(development-runtime-wat)
      ,(fasl-codec-runtime-wat)
      ,(native-code-runtime-wat)
      ,(hir-runtime-wat)
      ,(native-optimizer-runtime-wat)
      ,(sequence-runtime-wat)
      ,(list-operations-runtime-wat)
      ,(sequence-construction-runtime-wat)
      ,(sequence-removal-runtime-wat)
      ,(sequence-duplicates-runtime-wat)
      ,(sequence-search-runtime-wat)
      ,(sequence-comparison-runtime-wat)
      ,(sequence-ordering-runtime-wat)
      ,(rounding-runtime-wat)
      ,(random-runtime-wat)
      ,(sequence-binding-runtime-wat)
      ,(tree-operations-runtime-wat)
      ,(sequence-reduce-runtime-wat)
      ,(apply-runtime-wat)
      ,(io-runtime-wat)
      ,(text-runtime-wat)
      ,(format-runtime-wat)
      ,(reporting-runtime-wat)
      ,(input-stream-runtime-wat)
      ,(stream-sequence-runtime-wat)
      ,(constructed-stream-runtime-wat)
      ,(file-runtime-wat)
      ,(file-host-runtime-wat)
      ,(time-runtime-wat)
      ,(javascript-runtime-wat)
      ,(thread-runtime-wat)
      ,@(when wasi (list (wasi-repl-wat)))
      ,($evaluate)
      ,@(when wasi (list (thread-native-wat)))
      (data $output-literal-data ,(runtime-library-data *runtime-output-bytes*))
      (global $output-literal-length i32 (i32.const ,(length *runtime-output-bytes*)))
      ;; Put common runtime functions before the snapshot accessors, so the
      ;; latter do not consume the short indices reserved by this layout.
      ,(runtime-function-layout *runtime-function-definitions*
                                :reserved-functions (if wasi 7 2)
                                :references (first *native-compiler-image*))
      ,@(unless wasi (list (core-image-runtime-wat)))

      ,(wat-fragment (if *native-compiler-image* (first *native-compiler-image*) "")))))
