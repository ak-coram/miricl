;;;; Packed bit-array operations, including unaligned displaced views.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $array-same-shape (($a :nullable-object) ($b :nullable-object)) (i32)
  (:locals ($rank i32) ($i i32))
  #@(local.set $rank (call $array-rank-value (local.get $a)))
  #@(if (i32.ne (local.get $rank) (call $array-rank-value (local.get $b))) (then (return (i32.const 0))))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $rank)))
    (if (i32.ne (call $array-dimension-value (local.get $a) (local.get $i))
                 (call $array-dimension-value (local.get $b) (local.get $i))) (then (return (i32.const 0))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(i32.const 1))

(define-runtime-function $bit-array-location (($array :nullable-object)) (:digits i32)
  (:locals ($offset i32))
  #@(block $resolved (loop $resolve
    (br_if $resolved (i32.ne (call $tag (local.get $array)) (i32.const 35)))
    (local.set $offset (i32.add (local.get $offset) (struct.get $array $offset (ref.cast (ref $array) (local.get $array)))))
    (local.set $array (struct.get $obj $a (local.get $array))) (br $resolve)))
  #@(ref.as_non_null (struct.get $obj $digits (local.get $array)))
  #@(local.get $offset))

(define-runtime-function $bit-read-word (($data :digits) ($offset i32)) (i32)
  (:locals ($word i32) ($index i32) ($shift i32))
  #@(local.set $index (i32.shr_u (local.get $offset) (i32.const 5)))
  #@(local.set $shift (i32.and (local.get $offset) (i32.const 31)))
  #@(local.set $word (array.get $digits (local.get $data) (local.get $index)))
  #@(if (i32.eqz (local.get $shift)) (then (return (local.get $word))))
  #@(local.set $word (i32.shr_u (local.get $word) (local.get $shift)))
  #@(local.set $index (i32.add (local.get $index) (i32.const 1)))
  #@(if (i32.lt_u (local.get $index) (array.len (local.get $data)))
    (then (local.set $word (i32.or (local.get $word)
      (i32.shl (array.get $digits (local.get $data) (local.get $index)) (i32.sub (i32.const 32) (local.get $shift)))))))
  #@(local.get $word))

(define-runtime-function $bit-write-word (($data :digits) ($offset i32) ($value i32) ($bits i32)) ()
  (:locals ($index i32) ($shift i32) ($first i32) ($mask i32))
  #@(local.set $index (i32.shr_u (local.get $offset) (i32.const 5)))
  #@(local.set $shift (i32.and (local.get $offset) (i32.const 31)))
  #@(local.set $first (i32.sub (i32.const 32) (local.get $shift)))
  #@(if (i32.lt_u (local.get $bits) (local.get $first)) (then (local.set $first (local.get $bits))))
  #@(local.set $mask (if (result i32) (i32.eq (local.get $first) (i32.const 32)) (then (i32.const -1))
    (else (i32.shl (i32.shr_u (i32.const -1) (i32.sub (i32.const 32) (local.get $first))) (local.get $shift)))))
  #@(array.set $digits (local.get $data) (local.get $index)
    (i32.or (i32.and (array.get $digits (local.get $data) (local.get $index)) (i32.xor (local.get $mask) (i32.const -1)))
      (i32.and (i32.shl (local.get $value) (local.get $shift)) (local.get $mask))))
  #@(if (i32.gt_u (local.get $bits) (local.get $first))
    (then
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (local.set $mask (i32.shr_u (i32.const -1) (i32.sub (i32.const 32) (i32.sub (local.get $bits) (local.get $first)))))
      (array.set $digits (local.get $data) (local.get $index)
        (i32.or (i32.and (array.get $digits (local.get $data) (local.get $index)) (i32.xor (local.get $mask) (i32.const -1)))
          (i32.and (i32.shr_u (local.get $value) (local.get $first)) (local.get $mask)))))))

(define-runtime-function $bit-region-overlap
    (($a :digits) ($b :digits) ($first i32) ($second i32) ($length i32)) (i32)
  #@(i32.and (ref.eq (local.get $a) (local.get $b))
    (i32.and (i32.ne (local.get $first) (local.get $second))
      (i32.and (i32.lt_u (local.get $first) (i32.add (local.get $second) (local.get $length)))
               (i32.lt_u (local.get $second) (i32.add (local.get $first) (local.get $length)))))))

(define-runtime-function $bit-region-snapshot (($data :digits) ($offset i32) ($length i32)) (:digits)
  (:locals ($copy :digits) ($i i32) ($words i32))
  #@(local.set $words (i32.shr_u (i32.add (local.get $length) (i32.const 31)) (i32.const 5)))
  #@(local.set $copy (array.new_default $digits (local.get $words)))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $words)))
    (array.set $digits (local.get $copy) (local.get $i)
      (call $bit-read-word (local.get $data) (i32.add (local.get $offset) (i32.shl (local.get $i) (i32.const 5)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(local.get $copy))

(define-runtime-function $bit-region-copy
    (($target :digits) ($source :digits) ($first i32) ($from i32) ($length i32)) ()
  (:locals ($remaining i32) ($bits i32) ($index i32) ($reverse i32) ($word i32))
  #@(local.set $remaining (local.get $length))
  #@(local.set $reverse (i32.and (ref.eq (local.get $target) (local.get $source)) (i32.gt_u (local.get $first) (local.get $from))))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $remaining)))
    (local.set $bits (local.get $remaining))
    (if (i32.gt_u (local.get $bits) (i32.const 32)) (then (local.set $bits (i32.const 32))))
    (local.set $index (if (result i32) (local.get $reverse)
      (then (i32.sub (local.get $remaining) (local.get $bits)))
      (else (i32.sub (local.get $length) (local.get $remaining)))))
    (local.set $word (call $bit-read-word (local.get $source) (i32.add (local.get $from) (local.get $index))))
    (call $bit-write-word (local.get $target) (i32.add (local.get $first) (local.get $index)) (local.get $word) (local.get $bits))
    (local.set $remaining (i32.sub (local.get $remaining) (local.get $bits))) (br $next))))

(define-runtime-function $bit-array-aligned
    (($op i32) ($data-a :digits) ($data-b :digits) ($data-result :digits)
     ($offset-a i32) ($offset-b i32) ($offset-result i32) ($length i32)) ()
  (:locals ($i i32) ($bits i32))
  #@(block $kernel
      (local.set $offset-a (i32.shr_u (local.get $offset-a) (i32.const 5)))
      (local.set $offset-b (i32.shr_u (local.get $offset-b) (i32.const 5)))
      (local.set $offset-result (i32.shr_u (local.get $offset-result) (i32.const 5)))
      (local.set $bits (i32.shr_u (local.get $length) (i32.const 5)))
      (block $aligned (loop $word (br_if $aligned (i32.eq (local.get $i) (local.get $bits)))
        (array.set $digits (local.get $data-result) (i32.add (local.get $offset-result) (local.get $i))
          (call $boole-word (local.get $op)
            (array.get $digits (local.get $data-a) (i32.add (local.get $offset-a) (local.get $i)))
            (array.get $digits (local.get $data-b) (i32.add (local.get $offset-b) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $word)))
      (local.set $bits (i32.and (local.get $length) (i32.const 31)))
      (if (local.get $bits)
        (then (call $bit-write-word (local.get $data-result)
          (i32.shl (i32.add (local.get $offset-result) (local.get $i)) (i32.const 5))
          (call $boole-word (local.get $op)
            (array.get $digits (local.get $data-a) (i32.add (local.get $offset-a) (local.get $i)))
            (array.get $digits (local.get $data-b) (i32.add (local.get $offset-b) (local.get $i)))) (local.get $bits))))
))

(define-runtime-function $bit-array-apply (($op i32) ($args :nullable-object)) (:nullable-object)
  (:locals ($a :nullable-object) ($b :nullable-object) ($result :nullable-object) ($storage :nullable-object)
           ($data-a :digits) ($data-b :digits) ($data-result :digits)
           ($offset-a i32) ($offset-b i32) ($offset-result i32) ($length i32) ($rank i32)
           ($i i32) ($bits i32) ($word i32))
  #@(local.set $a (call $car (local.get $args)))
  #@(if (i32.eq (local.get $op) (i32.const 3))
    (then ,(wat-arity 1 2) (local.set $b (local.get $a))
      (local.set $result (call $car (call $cdr (local.get $args)))))
    (else ,(wat-arity 2 3) (local.set $b (call $car (call $cdr (local.get $args))))
      (local.set $result (call $car (call $cdr (call $cdr (local.get $args)))))))
  #@(call $array-bit-check (local.get $a) (i32.const 0))
  #@(call $array-bit-check (local.get $b) (i32.const 0))
  (wat-fail-when #@(i32.eqz (call $array-same-shape (local.get $a) (local.get $b))) :malformed-form)
  #@(local.set $length (call $array-length (local.get $a)))
  #@(if (ref.is_null (local.get $result))
    (then
      (local.set $storage (call $make-bit-vector (local.get $length) (call $int (i32.const 0))))
      (local.set $rank (call $array-rank-value (local.get $a)))
      (local.set $result (if (result (ref null $obj)) (i32.eq (local.get $rank) (i32.const 1))
        (then (local.get $storage))
        (else (call $array-new (call $array-shape (local.get $a)) (i32.const 2) (local.get $storage) (i32.const 0) (i32.const -1))))))
    (else (if (i32.eq (call $id (local.get $result)) (i32.const 1)) (then (local.set $result (local.get $a))))))
  #@(call $array-bit-check (local.get $result) (i32.const 0))
  (wat-fail-when #@(i32.eqz (call $array-same-shape (local.get $a) (local.get $result))) :malformed-form)
  #@(call $bit-array-location (local.get $a)) #@(local.set $offset-a) #@(local.set $data-a)
  #@(call $bit-array-location (local.get $b)) #@(local.set $offset-b) #@(local.set $data-b)
  #@(call $bit-array-location (local.get $result)) #@(local.set $offset-result) #@(local.set $data-result)
  ;; Capture only partially overlapping views. Identical operands/results
  ;; operate in place, and ordinary calls allocate just the requested result.
  #@(if (call $bit-region-overlap (local.get $data-a) (local.get $data-result)
      (local.get $offset-a) (local.get $offset-result) (local.get $length))
    (then (local.set $data-a (call $bit-region-snapshot (local.get $data-a) (local.get $offset-a) (local.get $length)))
      (local.set $offset-a (i32.const 0))))
  #@(if (i32.eq (local.get $op) (i32.const 3))
    (then (local.set $data-b (local.get $data-a)) (local.set $offset-b (local.get $offset-a)))
    (else (if (call $bit-region-overlap (local.get $data-b) (local.get $data-result)
        (local.get $offset-b) (local.get $offset-result) (local.get $length))
      (then (local.set $data-b (call $bit-region-snapshot (local.get $data-b) (local.get $offset-b) (local.get $length)))
        (local.set $offset-b (i32.const 0))))))
  #@(if (i32.eqz (i32.and (i32.or (i32.or (local.get $offset-a) (local.get $offset-b)) (local.get $offset-result)) (i32.const 31)))
    (then (call $bit-array-aligned (local.get $op) (local.get $data-a) (local.get $data-b) (local.get $data-result)
      (local.get $offset-a) (local.get $offset-b) (local.get $offset-result) (local.get $length))
      (call $clear-values) (return (local.get $result))))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $length)))
    (local.set $bits (i32.sub (local.get $length) (local.get $i)))
    (if (i32.gt_u (local.get $bits) (i32.const 32)) (then (local.set $bits (i32.const 32))))
    (local.set $word (call $boole-word (local.get $op)
      (call $bit-read-word (local.get $data-a) (i32.add (local.get $offset-a) (local.get $i)))
      (call $bit-read-word (local.get $data-b) (i32.add (local.get $offset-b) (local.get $i)))))
    (call $bit-write-word (local.get $data-result) (i32.add (local.get $offset-result) (local.get $i)) (local.get $word) (local.get $bits))
    (local.set $i (i32.add (local.get $i) (local.get $bits))) (br $next)))
  #@(call $clear-values)
  #@(local.get $result))

(define-runtime-section bit-array-runtime-wat ()
  #@(global $bit-array-opcodes (ref $digits)
    (array.new_fixed $digits ,(length *bit-array-functions*)
      ,@(loop for (name . opcode) in *bit-array-functions* collect `(i32.const ,opcode))))
  ($array-same-shape) ($bit-array-location) ($bit-read-word) ($bit-write-word)
  ($bit-region-overlap) ($bit-region-snapshot) ($bit-region-copy) ($bit-array-aligned) ($bit-array-apply))
