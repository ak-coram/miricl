;;;; String streams, character positions, lookahead, and exceptional exits.
(in-package #:miricl-test)
(in-suite :miricl)

(test native-broadcast-streams
  (m:with-interpreter (vm :fuel 300000000)
    (dolist (form
      '((let* ((a (make-string-output-stream)) (b (make-string-output-stream))
               (s (make-broadcast-stream a b)))
          (format s "~A~%" 17) (write-sequence '(#\λ #\🙂) s)
          (write-string "abcde" s :start 1 :end 4) (write-line "z" s)
          (finish-output s) (force-output s)
          (list (eq (stream-element-type s) (stream-element-type b))
            (eq a (car (broadcast-stream-streams s))) (eq b (cadr (broadcast-stream-streams s)))
            (file-position s) (get-output-stream-string a) (get-output-stream-string b)))
        (let* ((target (make-string-output-stream))) (declare (special target))
          (let* ((synonym (make-synonym-stream 'target)) (s (make-broadcast-stream synonym)))
            (write-string "a" s)
            (list (get-output-stream-string target)
              (let ((target (make-string-output-stream))) (declare (special target))
                (write-string "b" s) (get-output-stream-string target)))))))
      (let ((expected (eval form)) (actual (m:evaluate vm form)))
        (is (equalp expected actual) "Broadcast stream mismatch ~S: expected ~S, received ~S" form expected actual)))
    ;; Host stream closure and position-setting policies differ. Check the
    ;; guest's state directly, including successful empty-stream positioning.
    (is (equal '(t t t broadcast-stream nil t nil nil t t nil #\λ -17 nil 0 0 t 1 :default)
      (m:evaluate vm '(let ((s (make-broadcast-stream)))
        (list (streamp s) (typep s 'broadcast-stream) (typep s (find-class 'broadcast-stream))
          (type-of s) (functionp s) (output-stream-p s) (input-stream-p s) (interactive-stream-p s)
          (stream-element-type s) (open-stream-p s) (broadcast-stream-streams s)
          (write-char #\λ s) (write-byte -17 s) (fresh-line s)
          (file-length s) (file-position s) (file-position s :start)
          (file-string-length s "abc") (stream-external-format s))))))
    (is (equal '(t nil t t) (m:evaluate vm
      '(let* ((a (make-string-output-stream)) (b (make-string-output-stream))
              (s (make-broadcast-stream a b)))
         (list (close s) (open-stream-p s) (open-stream-p a) (open-stream-p b))))))
    ;; FRESH-LINE must return the last component's value. Some hosts query
    ;; the first component instead. Check the specified behavior directly.
    (is (equal (list nil (format nil "a~%") "")
      (m:evaluate vm '(let ((a (make-string-output-stream)) (b (make-string-output-stream)))
        (write-char #\a a)
        (list (fresh-line (make-broadcast-stream a b))
          (get-output-stream-string a) (get-output-stream-string b))))))
    (is (equal (list t "" (format nil "b~%"))
      (m:evaluate vm '(let ((a (make-string-output-stream)) (b (make-string-output-stream)))
        (write-char #\b b)
        (list (fresh-line (make-broadcast-stream a b))
          (get-output-stream-string a) (get-output-stream-string b))))))
    ;; CLEAR-OUTPUT retains the interpreter's existing string buffer policy.
    (is (equal '("z" "z")
      (m:evaluate vm '(let* ((a (make-string-output-stream)) (b (make-string-output-stream))
                             (s (make-broadcast-stream a (make-broadcast-stream b))))
        (write-string "xy" s) (clear-output s) (write-string "z" s)
        (list (get-output-stream-string a) (get-output-stream-string b))))))
    (is (equal '("abababab" "ababab")
      (m:evaluate vm '(let* ((storage (make-array 8 :element-type 'character :initial-contents "abcdefgh"))
                             (source (make-array 6 :element-type 'character :displaced-to storage))
                             (target (make-array 8 :element-type 'character :displaced-to storage :fill-pointer 2))
                             (other (make-string-output-stream)))
        (with-output-to-string (first target)
          (write-sequence source (make-broadcast-stream first other)))
        (list storage (get-output-stream-string other))))))
    (is (eq t (m:evaluate vm '(let ((data (vector 17 'a)))
      (eq data (write-sequence data (make-broadcast-stream)))))))
    (dolist (function '(write-char write-string write-sequence fresh-line clear-output finish-output force-output))
      (let ((arguments (case function (write-char '(#\a s))
                                     ((write-string write-sequence) '("" s)) (t '(s)))))
        (is (eq t (m:evaluate vm `(let ((s (make-broadcast-stream)))
          (close s) (handler-case (,function ,@arguments)
                      (stream-error (c) (eq s (stream-error-stream c))))))))))
    (dolist (form '((make-broadcast-stream nil) (make-broadcast-stream 17)
                    (make-broadcast-stream (make-string-input-stream ""))
                    (broadcast-stream-streams nil) (broadcast-stream-streams (make-string-output-stream))
                    (write-byte nil (make-broadcast-stream))
                    (write-byte 17 (make-string-output-stream))
                    (file-string-length (make-broadcast-stream) 17)))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))
    (dolist (form '((broadcast-stream-streams) (broadcast-stream-streams nil nil)
                    (file-length) (file-length nil nil) (file-position) (file-position nil 0 nil)
                    (file-string-length) (file-string-length nil) (file-string-length nil "a" nil)
                    (stream-external-format) (stream-external-format nil nil)
                    (write-byte) (write-byte 1) (write-byte 1 nil nil)))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))
    (let ((stream (m:evaluate vm '(make-broadcast-stream))))
      (is (eq stream (m:evaluate vm `',stream)))
      (is (eq t (m:evaluate vm `(and (streamp ',stream) (typep ',stream 'broadcast-stream))))))))

(test native-string-stream-file-position
  (m:with-interpreter (vm)
    (is (equal '(0 #\b 1 t #\c t :eof t #\b)
      (m:evaluate vm '(let ((s (make-string-input-stream "abcde" 1 4)))
        (list (file-position s) (read-char s) (file-position s)
          (file-position s 1) (read-char s) (file-position s :end) (read-char s nil :eof)
          (file-position s :start) (read-char s))))))
    (is (equal '(3 t 1 "aZ")
      (m:evaluate vm '(let ((s (make-string-output-stream)))
        (write-string "abc" s)
        (let ((before (file-position s)) (moved (file-position s 1)))
          (list before moved (file-position s) (progn (write-char #\Z s) (get-output-stream-string s))))))))
    (is (equal '(t 1 1 "x" "x")
      (m:evaluate vm '(let* ((a (make-string-output-stream)) (b (make-string-output-stream))
                             (s (make-broadcast-stream a b)))
        (write-string "xyz" s)
        (list (file-position s 1) (file-position a) (file-position b)
          (get-output-stream-string a) (get-output-stream-string b))))))
    (is (eq t (m:evaluate vm '(let ((s (make-string-input-stream "abc")))
      (handler-case (file-position s 100) (stream-error (c) (eq s (stream-error-stream c))))))))
    (is (= 2 (m:evaluate vm '(let ((s (make-string-input-stream "(1")) (position nil))
      (handler-case
        (handler-bind ((end-of-file (lambda (condition) (declare (ignore condition))
                                     (setq position (file-position s)))))
          (read s))
        (end-of-file () position))))))
    (is (eq t (m:evaluate vm '(let ((target (make-array 8 :element-type 'character
                                                        :initial-contents "abxxxxxx" :fill-pointer 2)))
      (with-output-to-string (s target) (file-position s :end) (fresh-line s))
      (string= target (format nil "ab~%"))))))))

(test constructed-character-streams
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (form
      '((let* ((i (make-string-input-stream "abc")) (o (make-string-output-stream))
               (s (make-two-way-stream i o)))
          (list (streamp s) (typep s 'stream) (typep s 'two-way-stream)
            (input-stream-p s) (output-stream-p s) (open-stream-p s)
            (interactive-stream-p s) (stream-element-type s)
            (eq i (two-way-stream-input-stream s)) (eq o (two-way-stream-output-stream s))
            (read-char s) (peek-char nil s) (read-char s)
            (progn (write-char #\λ s) (write-line "🙂" s) (get-output-stream-string o))))
        (let* ((i (make-string-input-stream "123 456")) (o (make-string-output-stream))
               (s (make-two-way-stream i o)))
          (list (read-preserving-whitespace s) (read-char s) (read s)
            (read s nil :eof) (close s) (open-stream-p s) (open-stream-p i) (open-stream-p o)))
        (let* ((i (make-string-input-stream "abc")) (o (make-string-output-stream))
               (s (make-two-way-stream i o)) (data (make-string 5 :initial-element #\x)))
          (list (read-sequence data s :start 1) data
            (eq data (write-sequence data s :start 1 :end 4)) (get-output-stream-string o)))
        (let* ((o (make-string-output-stream))
               (s (make-two-way-stream (make-string-input-stream "") o)) (same nil))
          (format s (lambda (stream) (setq same (eq stream s)) (write-string "abc" stream)))
          (format s "~&~A" 42) (finish-output s) (force-output s)
          (list same (get-output-stream-string o)))
        (let* ((target (make-string-input-stream "a"))) (declare (special target))
          (let ((s (make-synonym-stream 'target)))
            (list (typep s 'synonym-stream) (typep s 'stream) (streamp s)
              (eq 'target (synonym-stream-symbol s)) (read-char s)
              (let ((target (make-string-input-stream "b"))) (declare (special target)) (read-char s))
              (let ((target (make-string-output-stream))) (declare (special target))
                (list (input-stream-p s) (output-stream-p s) (stream-element-type s)
                  (progn (format s "~A" 42) (get-output-stream-string target)))))))
        (let* ((target (make-string-input-stream "abc"))) (declare (special target))
          (close target) (let ((s (make-synonym-stream 'target))) (open-stream-p s)))
        (let* ((o (make-string-output-stream)) (i (make-string-input-stream "λ"))
               (a (make-two-way-stream i o)) (b (make-two-way-stream a a)))
          (list (read-char b) (progn (princ 42 b) (get-output-stream-string o))))))
      (is (equalp (eval form) (m:evaluate vm form)) "Constructed stream mismatch: ~S" form))
    ;; Synonym stream closure/introspection differs across hosts. The guest
    ;; tracks its own open state and closes no underlying stream.
    (is (equal '(t nil t t "a") (m:evaluate vm
      '(let* ((target (make-string-output-stream))) (declare (special target))
         (let ((s (make-synonym-stream 'target)))
           (format s (lambda (stream) (write-char #\a stream)))
           (list (close s) (open-stream-p s) (output-stream-p s)
                 (open-stream-p target) (get-output-stream-string target)))))))
    (is (equal '(t t t) (m:evaluate vm
      '(let* ((name (gensym)) (s (make-synonym-stream name)))
         (list (eq name (synonym-stream-symbol s)) (open-stream-p s) (close s))))))
    (dolist (form '((make-synonym-stream 17) (make-two-way-stream 17 18)
                    (make-two-way-stream (make-string-output-stream) (make-string-output-stream))
                    (make-two-way-stream (make-string-input-stream "") (make-string-input-stream ""))
                    (synonym-stream-symbol (make-string-input-stream ""))
                    (two-way-stream-input-stream (make-string-output-stream))
                    (two-way-stream-output-stream (make-string-input-stream ""))))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))
    (dolist (function '(read-char write-char read-sequence write-sequence))
      (let ((args (case function (write-char '(#\a s)) ((read-sequence write-sequence) '("a" s)) (t '(s)))))
        (is (eq t (m:evaluate vm `(let ((s (make-two-way-stream (make-string-input-stream "a") (make-string-output-stream))))
          (close s) (handler-case (,function ,@args) (stream-error (c) (eq s (stream-error-stream c))))))))))
    (is (eq t (m:evaluate vm '(let ((s (make-synonym-stream '*standard-input*)))
      (close s) (handler-case (read-char s) (stream-error (c) (eq s (stream-error-stream c))))))))))

(test constructed-stream-host-handles
  (m:with-interpreter (vm)
    (dolist (form '((make-two-way-stream (make-string-input-stream "a") (make-string-output-stream))
                    (make-synonym-stream '*terminal-io*)))
      (let ((stream (m:evaluate vm form)))
        (is (eq t (m:evaluate vm `(streamp ',stream))))
        (is (eq t (m:evaluate vm `(input-stream-p ',stream))))
        (is (eq t (m:evaluate vm `(output-stream-p ',stream))))
        (is (eq t (m:evaluate vm `(close ',stream))))
        (is (null (m:evaluate vm `(open-stream-p ',stream))))))))

(test string-input-streams
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (form
      '((let ((s (make-string-input-stream "aλ🙂")))
          (list (read-char s) (peek-char nil s) (read-char s) (read-char-no-hang s) (read-char s nil :eof)))
        (let ((s (make-string-input-stream " x y")))
          (list (peek-char t s) (read-char s) (peek-char #\y s) (read-char s)))
        (let ((s (make-string-input-stream " ;comment"))) (peek-char t s))
        (let ((s (make-string-input-stream "λ")))
          (let ((c (read-char s))) (unread-char c s) (list (listen s) (read-char s) (listen s))))
        (let ((s (make-string-input-stream "abc")))
          (list (streamp s) (typep s 'stream) (typep s 'string-stream) (input-stream-p s)
            (output-stream-p s) (open-stream-p s) (interactive-stream-p s) (stream-element-type s)))
        (let ((s (make-string-input-stream "")) (eof (list 17))) (eq eof (read-char s nil eof)))
        (let ((s (make-string-input-stream "")))
          (list (read-char s nil :eof t) (read-char-no-hang s nil :eof t) (peek-char t s nil :eof t)))
        (with-input-from-string (s "abcdef" :start 1 :end 4)
          (list (read-char s) (read-char s) (read-char s) (read-char s nil :eof)))
        (with-input-from-string (s "λ🙂") (values (read-char s) (read-char s)))
        (multiple-value-list (with-input-from-string (s "") (values)))
        (with-input-from-string (s "") (declare (ignore s)))
        (let ((index nil))
          (list (with-input-from-string (s "abcd" :index index) (list index (read-char s) index (read-char s))) index))
        (let ((index (list 1)))
          (list (with-input-from-string (s "abcd" :start (car index) :index (car index))
                  (read-char s)) index))
        (let ((index 17))
          (list (catch 'done (with-input-from-string (s "abcd" :index index)
            (read-char s) (throw 'done :done))) index))
        (with-input-from-string (declared-input "λ") (declare (special declared-input))
          (read-char (symbol-value 'declared-input)))
        (let ((*standard-input* (make-string-input-stream "abc")))
          (list (read-char) (peek-char) (read-char nil) (read-char-no-hang)))
        (let ((*terminal-io* (make-string-input-stream "abc"))) (read-char t))
        (let ((s (make-string-input-stream "abc"))) (list (close s) (streamp s) (open-stream-p s)))
        (let* ((storage (make-array 6 :element-type 'character :initial-contents "xλ🙂abz"))
               (source (make-array 4 :element-type 'character :displaced-to storage :displaced-index-offset 1 :fill-pointer 3)))
          (with-input-from-string (s source)
            (list (read-char s) (read-char s) (read-char s) (read-char s nil :eof))))))
      (is (equalp (eval form) (m:evaluate vm form)) "Input stream mismatch: ~S" form))
    ;; CLEAR-INPUT on a string stream has no effect in the guest. Hosts may
    ;; discard buffered input instead, so they cannot serve as the oracle.
    (is (eql #\a (m:evaluate vm
      '(let ((s (make-string-input-stream "abc"))) (clear-input s) (read-char s)))))
    (dolist (source '("" "abc" "a
b" "a
" "
" "λ🙂
a"))
      (let ((form `(with-input-from-string (s ,source)
                     (list (multiple-value-list (read-line s nil :eof))
                           (multiple-value-list (read-line s nil :eof))
                           (multiple-value-list (read-line s nil :eof))))))
        (is (equalp (eval form) (m:evaluate vm form)))))
    (dolist (function '(read-char read-char-no-hang peek-char read-line))
      (let ((call (if (eq function 'peek-char) '(peek-char nil s) (list function 's))))
        (is (eq t (m:evaluate vm `(let ((s (make-string-input-stream "")))
          (handler-case ,call (end-of-file (c) (eq s (stream-error-stream c))))))))))
    (dolist (form '((read-char 17) (make-string-input-stream 17) (make-string-input-stream "abc" -1)
                    (make-string-input-stream "abc" 0 4) (peek-char 17 (make-string-input-stream "a"))))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))
    (dolist (function '(read-char read-char-no-hang read-line listen))
      (is (eq t (m:evaluate vm `(let ((s (make-string-input-stream "a"))) (close s)
        (handler-case (,function s) (stream-error (c) (eq s (stream-error-stream c)))))))))))

(test input-stream-host-handles
  (m:with-interpreter (vm)
    (let ((stream (m:evaluate vm '(make-string-input-stream "aλ🙂"))))
      (is (eq t (m:evaluate vm `(input-stream-p ',stream))))
      (is (eql #\a (m:evaluate vm `(read-char ',stream))))
      (is (eql #\λ (m:evaluate vm `(peek-char nil ',stream))))
      (is (eql #\λ (m:evaluate vm `(read-char ',stream))))
      (is (eql #\🙂 (m:evaluate vm `(read-char ',stream))))
      (is (eq t (m:evaluate vm `(close ',stream))))
      (is (null (m:evaluate vm `(open-stream-p ',stream)))))))

(test reader-stream-integration
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (form
      '((with-input-from-string (s "1 2 (3) :start")
          (list (read s) (read s) (read s) (read s) (read s nil :eof)))
        (with-input-from-string (s "123 456")
          (list (read-preserving-whitespace s) (read-char s) (read s)))
        (with-input-from-string (s "123 456") (list (read s) (read-char s)))
        (let ((index nil)) (list (with-input-from-string (s "123 456" :index index) (read s)) index))
        (let ((*standard-input* (make-string-input-stream "#.(read *standard-input*) 42 17")))
          (list (read) (read)))
        (let ((*standard-input* (make-string-input-stream "#.(read-char *standard-input*)x 17")))
          (list (read) (read)))
        (with-input-from-string (s "1 ;done") (list (read s) (read s nil :eof)))
        (with-input-from-string (s "#1=(1 . #1#)") (let ((x (read s))) (eq x (cdr x))))
        (with-input-from-string (s "#(1 2)") (equalp #(1 2) (read s)))
        (with-input-from-string (s "123 456") (multiple-value-list (read s)))
        (with-input-from-string (s "123 456") (multiple-value-list (read-preserving-whitespace s)))))
      (is (equalp (eval form) (m:evaluate vm form)) "Stream READ mismatch: ~S" form))
    (dolist (source '("123   " "(1 2)   " "#\\a   " "#*10   " "#(1)   " "#x10   " "\"λ🙂\"   "))
      (dolist (preserve '(nil t))
        (let ((form `(multiple-value-list (read-from-string ,source t nil :preserve-whitespace ,preserve))))
          (destructuring-bind (object index) (m:evaluate vm form)
            (multiple-value-bind (expected boundary)
                (read-from-string source t nil :preserve-whitespace t)
              (is (equalp expected object))
              ;; READ may consume the whitespace delimiter after the object.
              (is (if preserve (= boundary index)
                      (<= boundary index (1+ boundary)))))))))
    (dolist (form
      '((multiple-value-list (read-from-string "xx123 yy" t nil :start 2 :end 5))
        (multiple-value-list (read-from-string "xx123 yy" t nil :end 5 :start 2))
        (multiple-value-list (read-from-string "  " nil :eof))
        (multiple-value-list (read-from-string "  " nil :eof :start 1 :end 1))
        (multiple-value-list (read-from-string "λ🙂123" t nil :start 2))
        (multiple-value-list (read-from-string "123" t nil :start 0 :start -1))
        (multiple-value-list (read-from-string "123" t nil :foo 17 :allow-other-keys t))
        (multiple-value-list (read-from-string (make-array 3 :element-type 'character :initial-contents "123" :fill-pointer 2)))
        (let* ((text (make-array 6 :element-type 'character :initial-contents "xx123y"))
               (view (make-array 3 :element-type 'character :displaced-to text :displaced-index-offset 2)))
          (multiple-value-list (read-from-string view)))))
      (is (equalp (eval form) (m:evaluate vm form))))
    (dolist (source '("(" "\"" "#|comment"))
      (is (eq t (m:evaluate vm `(let ((s (make-string-input-stream ,source)))
        (handler-case (read s nil :eof) (end-of-file (c) (eq s (stream-error-stream c)))))))))
    (dolist (source '("#*2" ")" "#1#"))
      (is (eq t (m:evaluate vm `(let ((s (make-string-input-stream ,source)))
        (handler-case (read s) (reader-error (c) (eq s (stream-error-stream c)))))))))
    (is (eq t (m:evaluate vm '(handler-case (read-from-string "#*2")
      (reader-error (c) (streamp (stream-error-stream c)))))))
    (dolist (form '((read-from-string "123" t nil :start)
                    (read-from-string "123" t nil :foo 17)
                    (read-from-string "123" t nil :allow-other-keys nil :allow-other-keys t :foo 17)))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))))

(test standard-output-streams
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (form
      '((with-output-to-string (*standard-output*)
          (write-string "a") (write-char #\λ) (format t "x") (princ "y"))
        (with-output-to-string (*standard-output*)
          (format t (lambda (s) (write-char #\λ s) (write-string "a" s))))
        (with-output-to-string (*terminal-io*)
          (write-string "a" t) (write-char #\λ t) (prin1 42 t) (fresh-line t))
        (with-output-to-string (*terminal-io*) (print 42 t))
        (with-output-to-string (*terminal-io*) (terpri t))
        (with-output-to-string (*standard-output*) (print 42) (terpri))
        (with-output-to-string (*terminal-io*) (write 42 :stream t))
        (let ((s (make-string-output-stream)))
          (let ((*standard-output* s)) (write-char #\a) (write-string "b") (format t "c"))
          (get-output-stream-string s))))
      (is (equalp (eval form) (m:evaluate vm form)) "Console stream mismatch: ~S" form))
    ;; CI runners may redirect host output through arbitrary stream types.
    ;; The guest's standard output is a console stream, not a string stream.
    (is (equal '(nil nil t t nil t nil) (m:evaluate vm
      '(list (streamp t) (typep t 'stream) (streamp *standard-output*)
             (typep *standard-output* 'stream) (typep *standard-output* 'string-stream)
             (output-stream-p *standard-output*) (input-stream-p *standard-output*)))))
    (dolist (form '((open-stream-p t) (output-stream-p t) (input-stream-p t)
                    (interactive-stream-p t) (stream-element-type t) (close t)))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))))

(test character-sequence-streams
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (kind '(string vector list))
      (dolist (start '(0 1 3))
        (dolist (end '(nil 3 4))
          (let* ((make (ecase kind
                        (string '(make-string 4 :initial-element #\x))
                        (vector '(make-array 4 :initial-element #\x))
