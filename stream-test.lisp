        (with-output-to-string (s)
          (write-string (make-array 5 :element-type 'character :initial-contents "aλ🙂bc" :fill-pointer 3) s))
        (let* ((storage (make-array 6 :element-type 'character :initial-contents "xaλ🙂bz"))
