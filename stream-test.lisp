    (is (equal "" (m:evaluate vm '(with-output-to-string (s) (write-string (make-array 0 :element-type nil) s)))))
    (is (equal (string #\Newline) (m:evaluate vm '(with-output-to-string (s) (write-line (make-array 0 :element-type nil) s)))))
