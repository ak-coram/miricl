                    (write-string "abc" (make-string-output-stream) :start -1)
                    (read-sequence '(1 . 2) (make-string-input-stream "abc"))
                    (write-sequence '(#\a . #\b) (make-string-output-stream))))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error () t))))))
    (dolist (form '((read-sequence (make-string 3)) (write-sequence "abc")
                    (write-string "abc" nil :start)
                    (write-line "abc" nil :unknown 1)
                    (write-sequence "abc" (make-string-output-stream) :allow-other-keys nil :unknown 1)))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))))
