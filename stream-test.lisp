    (dolist (form
      '((let ((data (make-array 6 :element-type 'character :initial-element #\x :fill-pointer 4)))
          (list (read-sequence data (make-string-input-stream "abc")) data (fill-pointer data)))
        (let* ((storage (make-array 8 :element-type 'character :initial-element #\x))
