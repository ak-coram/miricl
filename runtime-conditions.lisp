;;;; Guest conditions, dynamic handlers/restarts, and nonlocal control transfer.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; Condition: a class name, b slot plist, n legacy error code.
;; Class: a direct superclass names, b slot descriptions, c (environment defaults report).
;; Handler: a type, b function, c target (NIL for HANDLER-BIND).
;; Restart: a name, b function, c (target options); n distinguishes binding/case/system restarts.
;; The single exception carries its GC roots in globals, restored across cleanup forms.

(define-runtime-function $condition-class (($name :nullable-object)) (:nullable-object)
  (:locals ($scan :nullable-object) ($class :nullable-object))
  #@(local.set $scan (global.get $condition-classes))
  (wat-list-loop ($scan)
    #@(local.set $class (call $car (local.get $scan)))
    #@(if (i32.eq (struct.get $obj $n (local.get $class)) (call $id (local.get $name)))
        (then (return (local.get $class)))))
  #@(ref.null $obj))

(define-runtime-function $condition-subtype-p (($name :nullable-object) ($type :nullable-object)) (i32)
  (:locals ($class :nullable-object) ($parents :nullable-object))
  #@(if (ref.eq (local.get $name) (local.get $type)) (then (return (i32.const 1))))
  #@(local.set $class (call $condition-class (local.get $name)))
  #@(if (ref.is_null (local.get $class)) (then (return (i32.const 0))))
  #@(local.set $parents (struct.get $obj $a (local.get $class)))
  (wat-list-loop ($parents)
    #@(if (call $condition-subtype-p (call $car (local.get $parents)) (local.get $type))
        (then (return (i32.const 1)))))
  #@(i32.const 0))

(define-runtime-function $condition-slot (($condition :nullable-object) ($key :nullable-object)) (:nullable-object)
  (wat-fail-when #@(i32.ne (call $tag (local.get $condition)) (i32.const 17)) :expected-designator)
  #@(call $car (call $property-cell (struct.get $obj $b (local.get $condition)) (local.get $key))))

(define-runtime-function $put-condition-slot (($condition :nullable-object) ($key :nullable-object) ($value :nullable-object)) ()
  (:locals ($cell :nullable-object))
  #@(local.set $cell (call $property-cell (struct.get $obj $b (local.get $condition)) (local.get $key)))
  #@(if (ref.is_null (local.get $cell))
      (then (struct.set $obj $b (local.get $condition)
        (call $cons (local.get $key) (call $cons (local.get $value) (struct.get $obj $b (local.get $condition))))))
      (else (struct.set $obj $a (local.get $cell) (local.get $value)))))

(define-runtime-function $condition-init-value (($form :nullable-object) ($env :nullable-object)) (:nullable-object)
  #@(if (i32.eq (call $tag (local.get $form)) (i32.const 7))
    (then (if (ref.eq (call $car (local.get $form)) ,(clos-library-reference '%compiled-condition-init))
      (then (return (call $apply (call $car (call $cdr (call $cdr (local.get $form)))) (ref.null $obj)))))))
  #@(call $eval (local.get $form) (local.get $env)))

(define-runtime-function $condition-defaults (($class :nullable-object) ($condition :nullable-object)) ()
  (:locals ($scan :nullable-object) ($key :nullable-object) ($form :nullable-object))
  #@(local.set $scan (call $car (call $cdr (struct.get $obj $c (local.get $class)))))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $key (call $car (local.get $scan)))
    (local.set $form (call $car (call $cdr (local.get $scan))))
    (if (ref.is_null (call $property-cell (struct.get $obj $b (local.get $condition)) (local.get $key)))
        (then (struct.set $obj $b (local.get $condition)
          (call $prepend-list (struct.get $obj $b (local.get $condition))
            (call $cons (local.get $key) (call $cons
              (call $condition-init-value (local.get $form) (call $car (struct.get $obj $c (local.get $class)))) (ref.null $obj)))))))
    (local.set $scan (call $cdr (call $cdr (local.get $scan)))) (br $next)))
  #@(local.set $scan (struct.get $obj $a (local.get $class)))
  (wat-list-loop ($scan)
    #@(call $condition-defaults (call $condition-class (call $car (local.get $scan))) (local.get $condition))))

(define-runtime-function $slot-initarg-p (($class :nullable-object) ($slot :nullable-object) ($key :nullable-object)) (i32)
  (:locals ($scan :nullable-object) ($spec :nullable-object) ($options :nullable-object))
  #@(local.set $scan (struct.get $obj $b (local.get $class)))
  (wat-list-loop ($scan)
    #@(local.set $spec (call $car (local.get $scan)))
    #@(if (i32.eq (call $tag (local.get $spec)) (i32.const 7))
      (then (if (ref.eq (call $car (local.get $spec)) (local.get $slot))
        (then (local.set $options (call $cdr (local.get $spec)))
          (block $done (loop $next (br_if $done (ref.is_null (local.get $options)))
            (if (i32.and (i32.eq (call $id (call $car (local.get $options))) (i32.const ,(runtime-symbol-id :initarg)))
                         (ref.eq (call $car (call $cdr (local.get $options))) (local.get $key)))
                (then (return (i32.const 1))))
            (local.set $options (call $cdr (call $cdr (local.get $options)))) (br $next))))))))
  #@(local.set $scan (struct.get $obj $a (local.get $class)))
  (wat-list-loop ($scan)
    #@(if (call $slot-initarg-p (call $condition-class (call $car (local.get $scan))) (local.get $slot) (local.get $key))
        (then (return (i32.const 1)))))
  #@(i32.const 0))

(define-runtime-function $slot-initarg-value (($condition :nullable-object) ($slot :nullable-object)) (:nullable-object)
  (:locals ($scan :nullable-object) ($class :nullable-object))
  #@(local.set $scan (struct.get $obj $b (local.get $condition)))
  #@(local.set $class (call $condition-class (struct.get $obj $a (local.get $condition))))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (if (call $slot-initarg-p (local.get $class) (local.get $slot) (call $car (local.get $scan)))
        (then (return (call $cdr (local.get $scan)))))
    (local.set $scan (call $cdr (call $cdr (local.get $scan)))) (br $next)))
  #@(ref.null $obj))

(define-runtime-function $condition-init-slots (($class :nullable-object) ($condition :nullable-object)) ()
  (:locals ($scan :nullable-object) ($spec :nullable-object) ($name :nullable-object)
           ($options :nullable-object) ($key :nullable-object) ($value :nullable-object) ($found i32))
  #@(local.set $scan (struct.get $obj $b (local.get $class)))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (local.set $spec (call $car (local.get $scan)))
    (local.set $name (if (result (ref null $obj)) (call $symbolp (local.get $spec))
      (then (local.get $spec)) (else (call $car (local.get $spec)))))
    (if (ref.is_null (call $property-cell (struct.get $obj $b (local.get $condition)) (local.get $name)))
      (then
        (local.set $key (call $slot-initarg-value (local.get $condition) (local.get $name)))
        (local.set $found (i32.eqz (ref.is_null (local.get $key)))) (local.set $value (call $car (local.get $key)))
        (if (i32.eqz (local.get $found))
          (then
            (local.set $options (if (result (ref null $obj)) (call $symbolp (local.get $spec))
              (then (ref.null $obj)) (else (call $cdr (local.get $spec)))))
            (local.set $key (call $property-cell (local.get $options) (call $symbol (i32.const ,(runtime-symbol-id :initform)))))
            (if (i32.eqz (ref.is_null (local.get $key)))
              (then (local.set $found (i32.const 1))
                (local.set $value (call $condition-init-value (call $car (local.get $key)) (call $car (struct.get $obj $c (local.get $class)))))))))
        (if (local.get $found) (then (call $put-condition-slot (local.get $condition) (local.get $name) (local.get $value))))))
    (local.set $scan (call $cdr (local.get $scan))) (br $next)))
  #@(local.set $scan (struct.get $obj $a (local.get $class)))
  (wat-list-loop ($scan)
    #@(call $condition-init-slots (call $condition-class (call $car (local.get $scan))) (local.get $condition))))

(define-runtime-function $make-condition (($name :nullable-object) ($initargs :nullable-object)) (:nullable-object)
  (:locals ($class :nullable-object) ($condition :nullable-object) ($type :nullable-object)
           ($scan :nullable-object) ($candidate :nullable-object) ($candidate-name :nullable-object))
  #@(local.set $type (local.get $name))
  #@(if (i32.eq (call $tag (local.get $name)) (i32.const 23))
    (then (local.set $name (call $apply (call $symbol (i32.const ,(runtime-symbol-id 'class-name)))
      (call $cons (local.get $name) (ref.null $obj))))))
  #@(local.set $class (call $condition-class (local.get $name)))
  ;; Named conditions retain the direct path. Derived and compound condition
  ;; types reuse a concrete subtype, or materialize an intersection on demand.
  #@(if (ref.is_null (local.get $class))
    (then
      ,(wat-fail-when #@(ref.is_null (call $apply (call $symbol (i32.const ,(runtime-symbol-id 'subtypep)))
        (call $cons (local.get $type) (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'condition)))
          (ref.null $obj))))) :malformed-type)
      (local.set $scan (global.get $condition-classes))
      (block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
        (local.set $candidate (call $car (local.get $scan)))
        (local.set $candidate-name (call $symbol (struct.get $obj $n (local.get $candidate))))
        (if (i32.eqz (ref.is_null (call $apply (call $symbol (i32.const ,(runtime-symbol-id 'subtypep)))
              (call $cons (local.get $candidate-name) (call $cons (local.get $type) (ref.null $obj))))))
          (then (local.set $name (local.get $candidate-name)) (local.set $class (local.get $candidate))))
        (local.set $scan (call $cdr (local.get $scan))) (br $next)))
      (if (ref.is_null (local.get $class))
        (then
          (local.set $name (call $apply ,(clos-library-reference '%compound-condition-name)
            (call $cons (local.get $type) (ref.null $obj))))
          (local.set $class (call $condition-class (local.get $name)))))))
  (wat-fail-when #@(ref.is_null (local.get $class)) :malformed-type)
  (wat-fail-when #@(i32.rem_u (call $length (local.get $initargs)) (i32.const 2)) :wrong-arity)
  #@(local.set $condition (call $node (i32.const 17) (i32.const ,(runtime-error-code :condition))
    (local.get $name) (call $copy-list (local.get $initargs)) (ref.null $obj)))
  #@(call $condition-defaults (local.get $class) (local.get $condition))
  #@(call $condition-init-slots (local.get $class) (local.get $condition))
  #@(call $clear-values)
  #@(local.get $condition))

(define-runtime-function $coerce-condition (($datum :nullable-object) ($args :nullable-object) ($default :nullable-object)) (:nullable-object)
  #@(if (i32.eq (call $tag (local.get $datum)) (i32.const 17))
      (then (if (i32.eqz (ref.is_null (local.get $args)))
              (then (call $type-fail (local.get $args) (ref.null $obj)
                (i32.const ,(runtime-error-code :expected-designator)))))
            (return (local.get $datum))))
  #@(if (call $symbolp (local.get $datum)) (then (return (call $make-condition (local.get $datum) (local.get $args)))))
  (wat-fail-when #@(i32.and (i32.ne (call $tag (local.get $datum)) (i32.const 10))
                           (i32.ne (call $tag (local.get $datum)) (i32.const 8))) :expected-designator)
  #@(call $make-condition (local.get $default)
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id :format-control)))
      (call $cons (local.get $datum)
        (call $cons (call $symbol (i32.const ,(runtime-symbol-id :format-arguments)))
          (call $cons (local.get $args) (ref.null $obj)))))))

(define-runtime-function $transfer-to (($target :nullable-object) ($values :nullable-object)) ()
  #@(global.set $transfer-target (local.get $target))
  #@(global.set $transfer-values (local.get $values))
  #@(throw $transfer))

(define-runtime-function $signal-condition (($condition :nullable-object)) ()
  (:locals ($clusters :nullable-object) ($cluster :nullable-object) ($handler :nullable-object)
           ($saved :nullable-object) ($breaks :nullable-object) ($dynamic :nullable-object))
  #@(local.set $breaks (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*break-on-signals*)))))
  #@(if (i32.eqz (ref.is_null (local.get $breaks)))
      (then (if (call $typep (local.get $condition) (local.get $breaks))
        (then
          (local.set $dynamic (global.get $dynamic-variables))
          (global.set $dynamic-variables (call $bind (global.get $dynamic-variables)
            (call $symbol (i32.const ,(runtime-symbol-id '*break-on-signals*))) (ref.null $obj)))
          (global.set $dynamic-variables (call $bind (global.get $dynamic-variables)
            (call $symbol (i32.const ,(runtime-symbol-id '*debugger-hook*))) (ref.null $obj)))
          (call $debug-condition (local.get $condition))
          (global.set $dynamic-variables (local.get $dynamic))))))
  #@(local.set $saved (global.get $handlers))
  #@(local.set $clusters (local.get $saved))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $clusters)))
    (local.set $cluster (call $car (local.get $clusters)))
    (global.set $handlers (call $cdr (local.get $clusters)))
    (block $cluster-done (loop $handler-next (br_if $cluster-done (ref.is_null (local.get $cluster)))
      (local.set $handler (call $car (local.get $cluster)))
      (if (call $typep (local.get $condition) (struct.get $obj $a (local.get $handler)))
        (then
          (if (i32.eqz (ref.is_null (struct.get $obj $c (local.get $handler))))
            (then (global.set $transfer-function (struct.get $obj $b (local.get $handler)))
              (call $transfer-to (struct.get $obj $c (local.get $handler)) (call $cons (local.get $condition) (ref.null $obj)))))
          (drop (call $apply (struct.get $obj $b (local.get $handler)) (call $cons (local.get $condition) (ref.null $obj))))))
      (local.set $cluster (call $cdr (local.get $cluster))) (br $handler-next)))
    (local.set $clusters (call $cdr (local.get $clusters))) (br $next)))
  #@(global.set $handlers (local.get $saved))
  #@(call $clear-values))

(define-runtime-function $debug-condition (($condition :nullable-object)) ()
  (:locals ($hook :nullable-object) ($binding :nullable-object))
  #@(local.set $hook (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*debugger-hook*)))))
  #@(if (i32.eqz (ref.is_null (local.get $hook)))
      (then
        (local.set $binding (global.get $dynamic-variables))
        (global.set $dynamic-variables (call $bind (global.get $dynamic-variables)
          (call $symbol (i32.const ,(runtime-symbol-id '*debugger-hook*))) (ref.null $obj)))
        (drop (call $apply (local.get $hook) (call $cons (local.get $condition) (call $cons (local.get $hook) (ref.null $obj)))))
        (global.set $dynamic-variables (local.get $binding))))
  #@(global.set $last-condition (local.get $condition))
  #@(global.set $error (struct.get $obj $n (local.get $condition)))
  #@(call $capture-backtrace)
  #@(call $transfer-to (ref.null $obj) (ref.null $obj)))

(define-runtime-function $fail (($code i32)) ()
  (:locals ($condition :nullable-object))
  #@(local.set $condition (call $make-condition
    (call $symbol
      ,(reduce (lambda (entry tail)
                 (destructuring-bind (errors type) entry
                   `(if (result i32)
                        ,(reduce (lambda (a b) `(i32.or ,a ,b))
                                 (mapcar (lambda (error) `(i32.eq (local.get $code) (i32.const ,(runtime-error-code error)))) errors))
                        (then (i32.const ,(runtime-symbol-id type))) (else ,tail))))
               '(((:division-by-zero) division-by-zero) ((:expected-number :declared-type :expected-designator) type-error)
                 ((:unbound-variable) unbound-variable) ((:undefined-function) undefined-function)
                 ((:wrong-arity :malformed-form :unsupported :malformed-type) program-error)
                 ((:allocation) storage-condition) ((:invalid-float) floating-point-invalid-operation)
                 ((:invalid-package :package-conflict) package-error) ((:reader-syntax) reader-error)
                 ((:incomplete-input) end-of-file) ((:terminal-io) stream-error) ((:control-error) control-error))
               :from-end t :initial-value `(i32.const ,(runtime-symbol-id 'error))))
    (ref.null $obj)))
  #@(struct.set $obj $n (local.get $condition) (local.get $code))
  #@(if (i32.or (i32.eq (local.get $code) (i32.const ,(runtime-error-code :reader-syntax)))
                 (i32.eq (local.get $code) (i32.const ,(runtime-error-code :incomplete-input))))
    (then (call $put-condition-slot (local.get $condition) (call $symbol (i32.const ,(runtime-symbol-id :stream)))
      (global.get $reader-stream))))
  #@(if (i32.eq (local.get $code) (i32.const ,(runtime-error-code :unbound-variable)))
      (then (call $put-condition-slot (local.get $condition) (call $symbol (i32.const ,(runtime-symbol-id :name)))
        (call $symbol-object (global.get $unbound-symbol)))))
  #@(if (i32.eq (local.get $code) (i32.const ,(runtime-error-code :undefined-function)))
      (then (call $put-condition-slot (local.get $condition) (call $symbol (i32.const ,(runtime-symbol-id :name)))
        (global.get $undefined-name))))
  #@(call $signal-condition (local.get $condition))
  #@(call $debug-condition (local.get $condition)))

(define-runtime-function $type-fail (($datum :nullable-object) ($type :nullable-object) ($code i32)) ()
  (:locals ($condition :nullable-object))
  #@(local.set $condition (call $make-condition (call $symbol (i32.const ,(runtime-symbol-id 'type-error)))
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id :datum))) (call $cons (local.get $datum)
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id :expected-type))) (call $cons (local.get $type) (ref.null $obj)))))))
  #@(struct.set $obj $n (local.get $condition) (local.get $code))
  #@(call $signal-condition (local.get $condition))
  #@(call $debug-condition (local.get $condition)))

(define-runtime-function $division-error (($a :nullable-object) ($b :nullable-object)) ()
  (:locals ($condition :nullable-object))
  #@(local.set $condition (call $make-condition (call $symbol (i32.const ,(runtime-symbol-id 'division-by-zero)))
    (call $cons (call $symbol (i32.const ,(runtime-symbol-id :operation))) (call $cons (call $symbol (i32.const ,(runtime-symbol-id '/)))
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id :operands)))
        (call $cons (call $cons (local.get $a) (call $cons (local.get $b) (ref.null $obj))) (ref.null $obj)))))))
  #@(struct.set $obj $n (local.get $condition) (i32.const ,(runtime-error-code :division-by-zero)))
  #@(call $signal-condition (local.get $condition))
  #@(call $debug-condition (local.get $condition)))

(define-runtime-function $condition-access
    (($condition :nullable-object) ($name :nullable-object) ($slot :nullable-object)
     ($value :nullable-object) ($write i32)) (:nullable-object)
  #@(if (i32.eqz (if (result i32) (i32.eq (call $tag (local.get $condition)) (i32.const 17))
      (then (call $condition-subtype-p (struct.get $obj $a (local.get $condition)) (local.get $name)))
      (else (i32.const 0))))
    (then (call $type-fail (local.get $condition) (local.get $name)
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(if (local.get $write)
    (then (call $put-condition-slot (local.get $condition) (local.get $slot) (local.get $value))
      (return (local.get $value))))
  #@(call $condition-slot (local.get $condition) (local.get $slot)))

(define-runtime-function $condition-reader (($function :nullable-object) ($args :nullable-object)) (:nullable-object)
  (:locals ($condition :nullable-object) ($value :nullable-object))
  #@(if (i32.eq (struct.get $obj $n (local.get $function)) (i32.const 2147483646))
      (then ,(wat-arity 2) (local.set $value (call $car (local.get $args)))
        (local.set $args (call $cdr (local.get $args))))
      (else ,(wat-arity 1)))
  #@(local.set $condition (call $car (local.get $args)))
  #@(call $condition-access (local.get $condition) (struct.get $obj $b (local.get $function))
    (struct.get $obj $a (local.get $function)) (local.get $value)
    (i32.eq (struct.get $obj $n (local.get $function)) (i32.const 2147483646))))

(define-runtime-function $function-body-documentation (($body :nullable-object)) (:nullable-object :nullable-object)
  (:locals ($scan :nullable-object) ($doc :nullable-object) ($head :nullable-object)
           ($tail :nullable-object) ($cell :nullable-object))
  #@(local.set $scan (local.get $body))
  #@(block $scanned (loop $declaration
    (br_if $scanned (i32.ne (call $operator (call $car (local.get $scan)))
      (i32.const ,(runtime-symbol-id 'declare))))
    (local.set $scan (call $cdr (local.get $scan))) (br $declaration)))
  #@(if (i32.or (ref.is_null (call $cdr (local.get $scan)))
                (i32.eqz (call $stringp-native (call $car (local.get $scan)))))
    (then (return (local.get $body) (ref.null $obj))))
  #@(local.set $doc (call $car (local.get $scan)))
  #@(block $copied (loop $copy (br_if $copied (ref.eq (local.get $body) (local.get $scan)))
    (local.set $cell (call $cons (call $car (local.get $body)) (ref.null $obj)))
    (if (ref.is_null (local.get $tail)) (then (local.set $head (local.get $cell)))
      (else (struct.set $obj $b (local.get $tail) (local.get $cell))))
    (local.set $tail (local.get $cell))
    (local.set $body (call $cdr (local.get $body))) (br $copy)))
  #@(if (ref.is_null (local.get $tail))
    (then (return (call $cdr (local.get $scan)) (local.get $doc))))
  #@(struct.set $obj $b (local.get $tail) (call $cdr (local.get $scan)))
  #@(local.get $head) #@(local.get $doc))

(define-runtime-function $function-block-body (($name :nullable-object) ($body :nullable-object)) (:nullable-object)
  (:locals ($head :nullable-object) ($tail :nullable-object) ($cell :nullable-object))
  #@(block $copied (loop $copy
    (br_if $copied (i32.ne (call $operator (call $car (local.get $body))) (i32.const ,(runtime-symbol-id 'declare))))
    (local.set $cell (call $cons (call $car (local.get $body)) (ref.null $obj)))
    (if (ref.is_null (local.get $tail)) (then (local.set $head (local.get $cell)))
      (else (struct.set $obj $b (local.get $tail) (local.get $cell))))
    (local.set $tail (local.get $cell))
    (local.set $body (call $cdr (local.get $body))) (br $copy)))
