;;;; Reader case modes and independent readtable copies.
(in-package #:miricl-test)
(in-suite :miricl)

(test native-readtable-syntax-copy
  (m:with-interpreter (vm)
    (dolist (form
      '((let ((*readtable* (copy-readtable nil)))
          (list (multiple-value-list (set-syntax-from-char #\! #\Space))
                (multiple-value-list (read-from-string "!17!23"))))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\\) (symbol-name (read-from-string "!a")))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\|) (symbol-name (read-from-string "!a|")))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\") (read-from-string "!a\\!b!"))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\') (read-from-string "!17"))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\() (read-from-string "!17 23)"))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\;) (read-from-string (format nil "!ignored~%17")))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\#) (read-from-string "!xFF"))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\`) (eval (read-from-string "!,17")))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\,) (eval (read-from-string "`!17")))
        (let* ((a (copy-readtable nil)) (*readtable* a))
          (set-syntax-from-char #\! #\Space)
          (let ((b (copy-readtable a)))
            (set-syntax-from-char #\! #\X a)
            (let ((*readtable* b)) (read-from-string "!17"))))
        (let ((*readtable* (copy-readtable nil)))
          (set-syntax-from-char #\! #\Space)
          (set-syntax-from-char #\! #\! *readtable* *readtable*) (read-from-string "!17"))))
      (let ((expected (let ((*package* (find-package :cl-user))) (multiple-value-list (eval form))))
            (actual (multiple-value-list (m:evaluate vm form))))
        (is (equal expected actual) "Readtable syntax: ~S expected ~S actual ~S" form expected actual)))
    ;; CCL fails to copy non-ASCII whitespace syntax and to reset modified
    ;; whitespace entries when copying the standard readtable into a table.
    (is (equal '(17 3) (m:evaluate vm
      '(let* ((a (copy-readtable nil)) (b (copy-readtable nil)))
         (set-syntax-from-char #\λ #\Space a)
         (copy-readtable a b) (set-syntax-from-char #\λ #\X a)
         (let ((*readtable* b)) (multiple-value-list (read-from-string "λ17")))))))
    (is (equal "!17" (m:evaluate vm
      '(let ((*readtable* (copy-readtable nil)))
         (set-syntax-from-char #\! #\Space)
         (copy-readtable nil *readtable*) (symbol-name (read-from-string "!17"))))))
    (dolist (character '(#\Space #\Newline #\Tab #\Backspace #\Rubout))
      (is (eq t (m:evaluate vm `(let ((*readtable* (copy-readtable nil)))
                                (set-syntax-from-char ,character #\X)
                                (handler-case (read-from-string (concatenate 'string (string ,character) "Z"))
                                  (reader-error () t)))))))
    (is (= 17 (m:evaluate vm '(let ((*readtable* (copy-readtable nil)))
                               (set-syntax-from-char #\Newline #\;)
                               (read-from-string (format nil "~%ignored~%17"))))))
    (dolist (source '(".." "..." "...."))
      (is (eq t (m:evaluate vm `(handler-case (read-from-string ,source) (reader-error () t))))))
    (dolist (source '("#:." "#:.." "#:..." "|.|" "\\."))
      (is (equal (symbol-name (read-from-string source))
                 (m:evaluate vm `(symbol-name (read-from-string ,source))))))
    (dolist (form '((set-syntax-from-char) (set-syntax-from-char #\! #\Space nil)
                    (set-syntax-from-char 17 #\X) (set-syntax-from-char #\! 17)
                    (set-syntax-from-char #\! #\X (copy-readtable) 17)))
      (is (eq t (m:evaluate vm `(handler-case ,form (error () t))))))))

(test native-reader-macros
  (m:with-interpreter (vm)
    (dolist (form
      '((let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) 17))
          (list (multiple-value-list (read-from-string "?!"))
                (symbol-name (read-from-string "!?"))))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) 17) t)
          (list (multiple-value-list (read-from-string "?!"))
                (symbol-name (read-from-string "!?"))))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore char)) (read stream t nil t)))
          (read-from-string "(?42 ?(1 2))"))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) (values)))
          (read-from-string "(?1 ? 2 ?)"))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) (values)))
          (read-from-string "? ? 42"))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) (values)))
          (list (read-from-string "? ?" nil :eof)
                (handler-case (read-from-string "(? ?" nil :eof) (end-of-file () :incomplete))
                (handler-case (read-from-string "'? ?" nil :eof) (end-of-file () :incomplete))))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (get-macro-character #\" nil))
          (read-from-string "?hello?"))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (get-macro-character #\' nil))
          (equal (read-from-string "?42") '(quote 42)))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (get-macro-character #\; nil))
          (read-from-string (format nil "(?comment~%42 ?comment~%)")))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) 17))
          (let ((copy (copy-readtable)))
            (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) 23))
            (let ((*readtable* copy)) (read-from-string "?"))))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) 17) t)
          (set-syntax-from-char #\! #\? *readtable* *readtable*)
          (list (read-from-string "!") (symbol-name (read-from-string "x!"))
                (nth-value 1 (get-macro-character #\!))))
        (with-input-from-string (stream "1 2 3)X")
          (list (read-delimited-list #\) stream) (read-char stream)))
        (with-input-from-string (stream "1 (2 3) ]") (read-delimited-list #\] stream))
        (with-input-from-string (stream "1 2] ]")
          (mapcar (lambda (x) (if (symbolp x) (symbol-name x) x)) (read-delimited-list #\] stream)))
        (let ((*readtable* (copy-readtable nil)))
          (set-macro-character #\] (get-macro-character #\) nil))
          (set-macro-character #\[ (lambda (stream char) (declare (ignore char)) (read-delimited-list #\] stream t)))
          (read-from-string "[1 [2 3] 4]"))))
      (let ((expected (let ((*package* (find-package :cl-user))) (multiple-value-list (eval form))))
            (actual (multiple-value-list (m:evaluate vm form))))
        (is (equal expected actual) "Reader macros: ~S expected ~S actual ~S" form expected actual)))
    (dolist (form '((get-macro-character) (get-macro-character #\! nil nil)
                   (set-macro-character #\!) (read-delimited-list)
                   (read-delimited-list #\) nil nil nil)))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))))

(test native-dispatch-reader-macros
  (m:with-interpreter (vm)
    (dolist (form
      '((let ((*readtable* (copy-readtable nil)))
          (make-dispatch-macro-character #\! t)
          (set-dispatch-macro-character #\! #\a (lambda (s c n) (declare (ignore s c n)) 17))
          (list (symbol-name (read-from-string "x!a")) (read-from-string "!a")))
        (let ((*readtable* (copy-readtable nil)))
          (set-dispatch-macro-character #\# #\! (lambda (s c n) (declare (ignore s c n)) 17))
          (read-from-string "(#! #3!)"))
        (let ((*readtable* (copy-readtable nil)))
          (set-dispatch-macro-character #\# #\+ (lambda (s c n) (declare (ignore s c n)) 17))
          (read-from-string "(#+ 23)"))
        (let ((*readtable* (copy-readtable nil)))
          (set-dispatch-macro-character #\# #\! (lambda (s c n) (declare (ignore s c n)) (values)))
          (read-from-string "(1 #! 2 #!)"))
        (let ((*readtable* (copy-readtable nil)))
          (make-dispatch-macro-character #\!)
          (set-dispatch-macro-character #\! #\a (get-dispatch-macro-character #\# #\x nil))
          (read-from-string "!a2a"))
        (let ((*readtable* (copy-readtable nil)))
          (make-dispatch-macro-character #\!)
          (set-dispatch-macro-character #\! #\a (get-dispatch-macro-character #\# #\| nil))
          (read-from-string "(1 !a comment |# 2)"))
        (let ((*readtable* (copy-readtable nil)))
          (make-dispatch-macro-character #\!)
          (list (get-dispatch-macro-character #\! #\a)
                (get-dispatch-macro-character #\# #\0 nil)))))
      (let ((expected (multiple-value-list (eval form)))
            (actual (multiple-value-list (m:evaluate vm form))))
        (is (equal expected actual) "Dispatch reader: ~S expected ~S actual ~S" form expected actual)))
    ;; Copied dispatch tables are independent; ECL shares them after
    ;; SET-SYNTAX-FROM-CHAR, so changing ? also changes ! on that host.
    (is (equal '(23 29 (17 17)) (m:evaluate vm
      '(let ((*readtable* (copy-readtable nil)))
         (make-dispatch-macro-character #\!)
         (set-dispatch-macro-character #\! #\a (lambda (s c n) (declare (ignore s c n)) 17))
         (set-syntax-from-char #\? #\! *readtable* *readtable*)
         (let ((copy (copy-readtable)))
           (set-dispatch-macro-character #\! #\a (lambda (s c n) (declare (ignore s c n)) 23))
           (set-dispatch-macro-character #\? #\a (lambda (s c n) (declare (ignore s c n)) 29))
           (list (read-from-string "!a") (read-from-string "?a")
             (let ((*readtable* copy)) (list (read-from-string "!a") (read-from-string "?a")))))))))
    ;; Suppression discards a custom reader macro's value but still calls it.
    (is (equal '(nil 1) (m:evaluate vm
      '(let ((*readtable* (copy-readtable nil)) (count 0))
         (set-dispatch-macro-character #\# #\! (lambda (s c n) (declare (ignore s c n)) (incf count) 17))
         (list (let ((*read-suppress* t)) (read-from-string "#!")) count)))))
    ;; Lookup is case-insensitive, but the reader callback receives the
    ;; original subcharacter. CCL passes its uppercased lookup key instead.
    (is (equal '((97 nil) (65 17) (97 123456789012345678901234567890))
      (m:evaluate vm '(let ((*readtable* (copy-readtable nil)))
        (make-dispatch-macro-character #\!)
        (set-dispatch-macro-character #\! #\a
          (lambda (stream char n) (declare (ignore stream)) (list (char-code char) n)))
        (list (read-from-string "!a") (read-from-string "!17A")
              (read-from-string "!123456789012345678901234567890a"))))))
    (dolist (form '((make-dispatch-macro-character) (get-dispatch-macro-character #\#)
                   (set-dispatch-macro-character #\# #\!)
                   (make-dispatch-macro-character #\! nil nil)))
      (is (eq t (m:evaluate vm `(handler-case ,form (error () t))))))))

(test reader-pathname-syntax
  (m:with-interpreter (vm)
    (dolist (form
      '((multiple-value-call (lambda (path pos) (list (namestring path) pos))
          (parse-namestring ""))
        (namestring (parse-namestring "--dir/file.lisp++" nil "" :start 2 :end 15))
        (multiple-value-call (lambda (path pos) (list (namestring path) pos))
          (parse-namestring "hello world.lisp" nil "other/base.lisp" :junk-allowed t))
        (let ((path (pathname "file.lisp")))
          (list (eq path (parse-namestring path))
                (nth-value 1 (parse-namestring path nil "" :start 7))))
        (namestring (read-from-string "#P\"file.lisp\""))
        (let ((*read-eval* nil)) (namestring (read-from-string "#P\"file.lisp\"")))))
      (is (equal (eval form) (m:evaluate vm form)) "Pathname reader: ~S" form))
    ;; CLHS specifies an index into THING; SBCL returns a substring-relative
    ;; index here, so this check uses the specified value rather than the host.
    (is (= 15 (m:evaluate vm '(nth-value 1
      (parse-namestring "--dir/file.lisp++" nil "" :start 2 :end 15)))))
    (dolist (form '((parse-namestring) (parse-namestring "x" nil "" :unknown t)
                   (parse-namestring "x" nil "" :end)))
      (is (eq t (m:evaluate vm `(handler-case ,form (program-error () t))))))))

(test reader-suppression
  (m:with-interpreter (vm)
    (dolist (source '("NO-SUCH-PACKAGE:::X" ":" "::" "..." "(1 .. 2 . 3)"
                      "#(1 .. x)" "#999999999999999999()" "#*notbits" "#0*bad"
                      "#\\bogus-name" "#999\\Space" "#0'F" "#100:X" "#100.1"
                      "#0Rbad" "#999Rbad" "#3R444" "#100Xjunk" "#1Cwrong"
                      "#99S(no-such-structure)" "#9P()" "#3AHELLO" "##" "#999#"
                      "\"λ🙂\"" "'unknown-name" "`(unknown-name ,1)"))
      (let ((form `(let ((*read-suppress* t)) (multiple-value-list (read-from-string ,source)))))
        ;; Suppressed reads return NIL and consume the complete expression,
        ;; including strings and quotes (ECL returns their unsuppressed value).
        (is (equal (list nil (length source)) (m:evaluate vm form)) "Suppression mismatch for ~S" source)))
    (dolist (form
      '((let ((s (make-string-input-stream "uninterned-name 17")))
          (list (let ((*read-suppress* t)) (read s)) (read s)))
        (let ((s (make-string-input-stream "uninterned-name 17")))
          (list (let ((*read-suppress* t)) (read-preserving-whitespace s)) (read-char s) (read s)))
        (let ((*read-suppress* t)) (read (make-string-input-stream "") nil :eof))
        (let ((s (make-string-input-stream "(#999= #999#) 42")))
          (list (let ((*read-suppress* t)) (read s)) (read s)))
        (let ((package (make-package "SUPPRESSION-TEST" :use nil)))
          (unwind-protect
            (let ((*package* package) (*read-suppress* t))
              (read-from-string "never-intern-this")
              (not (find-symbol "NEVER-INTERN-THIS" package)))
            (delete-package package)))))
      (is (equal (eval form) (m:evaluate vm form)) "Suppression mismatch for ~S" form))
    ;; Suppression prevents evaluation even when *READ-EVAL* is NIL. CCL
    ;; signals a reader error here before honoring *READ-SUPPRESS*.
    (is (equal '(nil 0) (m:evaluate vm
      '(let ((*read-suppress* t) (*read-eval* nil))
         (let ((n 0)) (list (read-from-string "#.(setq n 1)") n))))))
    (dolist (source '("#<" "#)" "# " ")"))
      (is (eq t (m:evaluate vm `(handler-case
        (let ((*read-suppress* t)) (read-from-string ,source)) (reader-error () t))))))
    (is (= 42 (m:evaluate-string vm "(read-from-string \"42\")")))))

(test reader-numeric-controls
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (base '(2 8 10 16 36))
      (dolist (number '(0 123 -123 2147483647 -2147483648 2147483648 -2147483649
                       1073741823 1073741824 32767 32768 123456789012345678901234567890))
        (let* ((source (let ((*print-base* base) (*print-radix* nil)) (write-to-string number)))
               (form `(let ((*read-base* ,base)) (read-from-string ,source))))
          (is (= number (m:evaluate vm form)) "Reader integer ~A in base ~D" source base))))
    (dolist (base '(2 3 8 10 16 36))
      (dolist (format '(short-float single-float double-float long-float))
        (dolist (source '("10" "11/10" "+10" "-10" "123." "1.25" "1.25e2" "1.25f2" "1.25d2"
                          "1e2" "1s2" "1d2" "#x10" "#b10" "#o10" "#36r10"))
          (let ((form `(let ((*read-base* ,base) (*read-default-float-format* ',format))
                         (let ((x (read-from-string ,source)))
                           (list x (typep x 'single-float) (typep x 'double-float))))))
            ;; The guest aliases LONG-FLOAT to binary64 on every host.
            (is (equalp (eval `(let ((*read-base* ,base)
                                    (*read-default-float-format* ',(if (eq format 'long-float) 'double-float format)))
                               (let ((x (read-from-string ,source)))
                                 (list x (typep x 'single-float) (typep x 'double-float)))))
                        (m:evaluate vm form)) "Numeric reader mismatch: ~S" form)))))
    (dolist (format '(short-float single-float double-float long-float))
      (dolist (value '(0.0 -0.0 1.25 123456.75 0.0d0 -0.0d0 1.25d0 123456.75d0))
        (let* ((form `(let ((*read-default-float-format* ',format))
                        (read-from-string (format nil "~S" ,value))))
               (expected (eval form)) (actual (m:evaluate vm form)))
          (is (and (= expected actual) (eq (type-of expected) (type-of actual))
                   (= (float-sign expected) (float-sign actual)))
              "Float round-trip mismatch: ~S" form))))
    (dolist (source '("1/0" "0/0" "-1/00" "#x1/0" "#10r1.5" "#10r1e2"))
      (is (eq t (m:evaluate vm `(handler-case (read-from-string ,source) (reader-error () t))))))
    (dolist (base '(2 8 10 16 36))
      (dolist (name '("A" "NIL" "FOO" "E" "1A" "λ"))
        (is (eq t (m:evaluate vm `(let ((*read-base* ,base))
          (let ((symbol (make-symbol ,name)))
            (equal (symbol-name (read-from-string (format nil "~S" symbol))) ,name))))))))))

(test native-readtable-case
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (mode '(:upcase :downcase :preserve :invert))
      (dolist (source '("#:hello" "#:HELLO" "#:HeLLo" "#:λ" "#:Λ" "#:λΛ" "#:a|B|" "#:A\\b"
                        "#:a|BC|d" "#:ABC|d|EF" "#:|λ|a" "#:λ\\Λ" "#:|aλ🙂|" "#:|a\\|b|"
                        "#:hello123" "#:HELLO123" "#:123-+-" "#:||" "123" "1.5e0"))
          (let ((form `(let ((*readtable* (copy-readtable nil)))
                         (setf (readtable-case *readtable*) ',mode)
                         (let ((x (read-from-string ,source)))
                           (if (symbolp x) (symbol-name x) x)))))
            (is (equalp (eval form) (m:evaluate vm form)) "Case mismatch: ~S" form))))
    (dolist (form
      '((let* ((a (copy-readtable nil)) (b (copy-readtable a)))
          (list (readtablep a) (typep a 'readtable) (typep a (find-class 'readtable))
                (eq a b) (readtable-case a) (readtable-case b)))
        (let* ((a (copy-readtable nil)) (b (copy-readtable a)))
          (setf (readtable-case a) :downcase)
          (list (readtable-case a) (readtable-case b) (eq b (copy-readtable a b)) (readtable-case b)))
        (let ((*readtable* (copy-readtable nil)))
          (setf (readtable-case *readtable*) :invert)
          (list (readtable-case (copy-readtable)) (readtable-case (copy-readtable nil))))
        (let ((a (copy-readtable nil))) (list (eq a (copy-readtable a a)) (readtable-case a)))
        (let ((a (copy-readtable nil))) (multiple-value-list (setf (readtable-case a) (values :preserve 99))))))
      (is (equalp (eval form) (m:evaluate vm form))))
    (dolist (form '((readtablep nil) (readtablep 42) (readtablep "x")))
      (is (eq (eval form) (m:evaluate vm form))))
    (dolist (form '((readtable-case nil) (copy-readtable 3) (copy-readtable nil 3)
                   (setf (readtable-case (copy-readtable nil)) :invalid)
                   (setf (readtable-case nil) :upcase)))
      (is (eq t (m:evaluate vm `(handler-case ,form (type-error (c)
        (not (typep (type-error-datum c) (type-error-expected-type c)))))))))
    (let ((table (m:evaluate vm '(copy-readtable nil))))
      (is (m:guest-opaque-object-p table))
      (is (eq :upcase (m:evaluate vm `(readtable-case ,table)))))))
