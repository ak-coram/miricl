;;;; Optional WASI preview1 terminal adapter.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $wasi-host-service (($operation i32) ($argument f64)) (f64)
  (:locals ($p i32) ($error i32) ($time f64))
  ;; Scratch space follows live printer output, so TIME can query clocks in the
  ;; middle of a FORMAT call without overwriting its text.
  #@(local.set $p (i32.and (i32.add (global.get $cursor) (i32.const 7)) (i32.const -8)))
  #@(call $reserve (i32.const 96))
  #@(if (i32.eq (local.get $operation) (i32.const 3))
    (then
      (memory.fill (local.get $p) (i32.const 0) (i32.const 48))
      (i32.store offset=16 (local.get $p) (i32.const 1))
      (i64.store offset=24 (local.get $p) (i64.trunc_sat_f64_u (f64.mul (local.get $argument) (f64.const 1000000))))
      (i64.store offset=32 (local.get $p) (i64.const 1000000))
      (if (call $poll-oneoff (local.get $p) (i32.add (local.get $p) (i32.const 48))
            (i32.const 1) (i32.add (local.get $p) (i32.const 80)))
        (then (return (f64.const -1))))
      (if (i32.or (i32.ne (i32.load offset=80 (local.get $p)) (i32.const 1))
                  (i32.load16_u offset=56 (local.get $p))) (then (return (f64.const -1))))
      (return (f64.const 0))))
  #@(if (i32.gt_u (local.get $operation) (i32.const 2)) (then (return (f64.const -1))))
  #@(local.set $error (call $clock-time-get (local.get $operation) (i64.const 1000000) (local.get $p)))
  ;; Some preview1 runtimes provide only realtime and monotonic clocks.
  #@(if (i32.and (i32.ne (local.get $error) (i32.const 0)) (i32.eq (local.get $operation) (i32.const 2)))
    (then (local.set $error (call $clock-time-get (i32.const 1) (i64.const 1000000) (local.get $p)))))
  #@(if (local.get $error) (then (return (f64.const -1))))
  #@(local.set $time (f64.convert_i64_u (i64.load (local.get $p))))
  #@(if (result f64) (i32.eqz (local.get $operation))
    (then (f64.add (f64.div (local.get $time) (f64.const 1000000000)) (f64.const 2208988800)))
    (else (f64.div (local.get $time) (f64.const 1000000)))))

(define-runtime-function $terminal-write
    ()
    ()
  (:locals ($length i32)
           ($p i32)
           ($offset i32)
           ($written i32))
  #@(local.set $length (global.get $cursor))
  #@(local.set $p (i32.and (i32.add (local.get $length) (i32.const 3)) (i32.const -4)))
  #@(call $reserve (i32.const 16))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $length)))
    (i32.store (local.get $p) (local.get $offset))
    (i32.store offset=4 (local.get $p) (local.get $length))
    ,(wat-fail-when #@(call $fd-write (i32.const 1) (local.get $p) (i32.const 1) (i32.add (local.get $p) (i32.const 8))) :terminal-io)
    (local.set $written (i32.load offset=8 (local.get $p)))
    ,(wat-fail-when #@(i32.or (i32.eqz (local.get $written)) (i32.gt_u (local.get $written) (local.get $length))) :terminal-io)
    (local.set $offset (i32.add (local.get $offset) (local.get $written)))
    (local.set $length (i32.sub (local.get $length) (local.get $written))) (br $next))))

(define-runtime-function $terminal-read
    ()
    (i32)
  #@(i32.store (i32.const 0) (i32.const 16))
  #@(i32.store (i32.const 4) (i32.const 1))
  (wat-fail-when #@(call $fd-read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)) :terminal-io)
  #@(if (result i32) (i32.eqz (i32.load (i32.const 8)))
      (then (i32.const -1)) (else (i32.load8_u (i32.const 16)))))

(define-runtime-function $terminal-submit
    (($bytes :digits) ($length i32) ($eof i32))
    (i32)
  (:locals ($i i32))
  #@(global.set $cursor (i32.const 0))
  #@(call $reserve (local.get $length))
  #@(block $done (loop $copy (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
    (i32.store8 (local.get $i) (array.get $digits (local.get $bytes) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
  #@(drop (call $evaluate-source (local.get $length)))
  (wat-fail-when #@(i32.and (local.get $eof) (i32.eq (global.get $text-status) (i32.const 1))) :incomplete-input)
  #@(call $terminal-write)
  #@(global.get $text-status))

(define-runtime-function $start
    ()
    ()
  (:export "_start")
  (:locals ($bytes :digits)
           ($new :digits)
           ($length i32)
           ($c i32)
           ($status i32))
  #@(call $initialize)
  (wat-fail-when #@(call $random-get (i32.const 0) (i32.const 16)) :terminal-io)
  #@(call $seed-random (i32.load (i32.const 0)) (i32.load (i32.const 4))
    (i32.load (i32.const 8)) (i32.load (i32.const 12)))
  #@(local.set $bytes (array.new_default $digits (i32.const 256)))
  #@(loop $prompt
    (global.set $cursor (i32.const 0))
    (if (local.get $status) (then ,(emit-text "...> ")) (else ,(emit-text "miricl> ")))
    (call $terminal-write)
    (block $line (loop $read
      (local.set $c (call $terminal-read)) (br_if $line (i32.eq (local.get $c) (i32.const -1)))
      (if (i32.eq (local.get $length) (array.len (local.get $bytes)))
          (then (local.set $new (array.new_default $digits (i32.mul (local.get $length) (i32.const 2))))
                (array.copy $digits $digits (local.get $new) (i32.const 0) (local.get $bytes) (i32.const 0) (local.get $length))
                (local.set $bytes (local.get $new))))
      (array.set $digits (local.get $bytes) (local.get $length) (local.get $c))
      (local.set $length (i32.add (local.get $length) (i32.const 1)))
      (br_if $read (i32.ne (local.get $c) (i32.const 10)))))
    (if (i32.and (i32.eq (local.get $c) (i32.const -1)) (i32.eqz (local.get $length))) (then (return)))
    (block $handled
      (block $failed
        (try_table (catch $guest-error $failed) (catch $transfer $failed)
          (local.set $status (call $terminal-submit (local.get $bytes) (local.get $length) (i32.eq (local.get $c) (i32.const -1))))
          (br $handled)))
      ;; Boundary errors and transfers from terminal I/O share this recovery path.
      (call $unwind)
      (global.set $source (array.new_default $digits (i32.const 0)))
      (global.set $source-end (i32.const 0))
      (global.set $cursor (global.get $text-output-length)) ,(emit-text "Error: ") (call $print-error)
      (call $emit-char (i32.const 10)) (call $print-backtrace)
      (call $terminal-write) (local.set $status (i32.const 0)))
    (if (i32.or (i32.eq (local.get $c) (i32.const -1)) (i32.eq (local.get $status) (i32.const 2))) (then (return)))
    (if (i32.eqz (local.get $status)) (then (local.set $length (i32.const 0)))) (br $prompt)))

(define-runtime-section wasi-imports-wat ()
  #@(func $fd-read (import "wasi_snapshot_preview1" "fd_read")
          (param i32 i32 i32 i32) (result i32))
  #@(func $fd-write (import "wasi_snapshot_preview1" "fd_write")
          (param i32 i32 i32 i32) (result i32))
  #@(func $random-get (import "wasi_snapshot_preview1" "random_get")
          (param i32 i32) (result i32))
  #@(func $clock-time-get (import "wasi_snapshot_preview1" "clock_time_get")
          (param i32 i64 i32) (result i32))
  #@(func $poll-oneoff (import "wasi_snapshot_preview1" "poll_oneoff")
          (param i32 i32 i32 i32) (result i32))
  #@(tag $guest-error))

(define-runtime-section wasi-repl-wat ()
  #@(elem (table $host-services) (i32.const 0) func $wasi-host-service)
  ($wasi-host-service)
  ($terminal-write)
  ($terminal-read)
  ($terminal-submit)
  ($start))
