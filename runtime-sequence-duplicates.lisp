;;;; Duplicate removal shares keyword binding and the sequence copying/relinking loop.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $remove-duplicates-native
    (($sequence :nullable-object) ($key :nullable-object) ($test :nullable-object) ($test-not :nullable-object)
     ($negate i32) ($start :nullable-object) ($end :nullable-object) ($from-end i32) ($write i32)) (:nullable-object)
  (:locals ($length i32) ($first i32) ($stop i32) ($n i32) ($i i32) ($index i32) ($j i32)
           ($step i32) ($left i32) ($limit i32) ($string i32) ($vector i32) ($indexed i32) ($hash-test i32) ($kind i32)
           ($match i32) ($removed i32) ($word i32) ($keys (ref $objects)) ($marks :digits)
           ($scan :nullable-object) ($value :nullable-object) ($function :nullable-object) ($table :nullable-object))
  #@(local.set $length (call $proper-sequence-length (local.get $sequence)))
  #@(local.set $stop (if (result i32) (ref.is_null (local.get $end))
    (then (local.get $length)) (else (call $bounded-index (local.get $end) (local.get $length)))))
  #@(local.set $first (call $bounded-index (local.get $start) (local.get $stop)))
  #@(local.set $n (i32.sub (local.get $stop) (local.get $first)))
  #@(if (i32.eqz (ref.is_null (local.get $key))) (then (local.set $key (call $callable (local.get $key)))))
  #@(local.set $function (call $callable (if (result (ref null eq)) (local.get $negate)
    (then (local.get $test-not)) (else (local.get $test)))))
  #@(if (i32.lt_u (local.get $n) (i32.const 2)) (then (call $clear-values) (return (local.get $sequence))))
  #@(local.set $string (i32.eq (call $tag (local.get $sequence)) (i32.const 10)))
  #@(local.set $vector (i32.and (call $arrayp-native (local.get $sequence)) (i32.eqz (local.get $string))))
  #@(local.set $indexed (i32.or (local.get $string) (local.get $vector)))
  #@(local.set $keys (array.new_default $objects (local.get $n)))
  #@(local.set $marks (array.new_default $digits (i32.shr_u (i32.add (local.get $n) (i32.const 31)) (i32.const 5))))
  #@(local.set $scan (local.get $sequence))
  #@(if (i32.eqz (local.get $indexed))
    (then (block $skipped (loop $skip (br_if $skipped (i32.eq (local.get $i) (local.get $first)))
      (local.set $scan (call $cdr (local.get $scan)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $skip)))))
  #@(local.set $i (i32.const 0))
  #@(block $keyed (loop $extract (br_if $keyed (i32.eq (local.get $i) (local.get $n)))
    (local.set $value (if (result (ref null eq)) (local.get $string)
      (then (call $node (i32.const 16)
        (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $sequence))) (i32.add (local.get $first) (local.get $i)))
        (ref.null eq) (ref.null eq) (ref.null eq)))
      (else (if (result (ref null eq)) (local.get $vector)
        (then (call $sequence-value (local.get $sequence) (i32.add (local.get $first) (local.get $i))))
        (else (call $car (local.get $scan)))))))
    (array.set $objects (local.get $keys) (local.get $i) (call $sequence-key-value (local.get $key) (local.get $value)))
    (if (i32.eqz (local.get $indexed)) (then (local.set $scan (call $cdr (local.get $scan)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $extract)))
  #@(if (i32.eqz (local.get $negate))
    (then
      (local.set $hash-test (call $hash-test-function-id (local.get $function)))
      (if (i32.and (local.get $string) (ref.is_null (local.get $key)))
        (then
          (local.set $kind (call $sequence-character-kind (local.get $function)))
          (if (i32.eq (local.get $kind) (i32.const 2))
            (then (local.set $hash-test (i32.const ,(runtime-symbol-id 'eql)))))
          (if (i32.eq (local.get $kind) (i32.const 3))
            (then (local.set $hash-test (i32.const ,(runtime-symbol-id 'equalp)))))))))
  #@(if (local.get $hash-test)
    (then
      (local.set $table (call $node (i32.const 29) (i32.const 0) (call $symbol (local.get $hash-test)) (ref.null eq) (ref.null eq)))
      (local.set $step (select (i32.const 1) (i32.const -1) (local.get $from-end)))
      (local.set $index (select (i32.const 0) (i32.sub (local.get $n) (i32.const 1)) (local.get $from-end))))
    (else
      ;; Visit in sequence order. FROM-END compares against retained earlier
      ;; elements; the default compares against the remaining suffix.
      (local.set $step (i32.const 1))
      (local.set $index (i32.const 0))))
  #@(local.set $left (local.get $n))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $left)))
    (local.set $value (array.get $objects (local.get $keys) (local.get $index)))
    (local.set $match (i32.const 0))
    (if (local.get $hash-test)
      (then
        (local.set $match (i32.eqz (ref.is_null (call $hash-cell-native (local.get $value) (local.get $table)))))
        (if (i32.eqz (local.get $match))
          (then (drop (call $puthash-native (local.get $value) (local.get $table) (ref.null eq))))))
      (else
        (local.set $j (select (i32.const 0) (i32.add (local.get $index) (i32.const 1)) (local.get $from-end)))
        (local.set $limit (select (local.get $index) (local.get $n) (local.get $from-end)))
        (block $searched (loop $search (br_if $searched (i32.ge_u (local.get $j) (local.get $limit)))
          (if (i32.eqz (i32.and (array.get $digits (local.get $marks) (i32.shr_u (local.get $j) (i32.const 5)))
                               (i32.shl (i32.const 1) (local.get $j))))
            (then (local.set $match (call $sequence-item-match (i32.const 0) (local.get $value)
              (array.get $objects (local.get $keys) (local.get $j)) (ref.null eq)
              (local.get $function) (local.get $negate)))))
          (br_if $searched (local.get $match))
          (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $search)))))
    (if (local.get $match)
      (then
        (local.set $word (i32.shr_u (local.get $index) (i32.const 5)))
        (array.set $digits (local.get $marks) (local.get $word)
          (i32.or (array.get $digits (local.get $marks) (local.get $word)) (i32.shl (i32.const 1) (local.get $index))))
        (local.set $removed (i32.add (local.get $removed) (i32.const 1)))))
    (local.set $index (i32.add (local.get $index) (local.get $step)))
    (local.set $left (i32.sub (local.get $left) (i32.const 1))) (br $next)))
  #@(call $copy-with-removals (local.get $sequence) (local.get $length) (local.get $first) (local.get $stop)
    (local.get $marks) (local.get $removed) (local.get $write)))

(define-runtime-section sequence-duplicates-runtime-wat ()
  ($remove-duplicates-native))
