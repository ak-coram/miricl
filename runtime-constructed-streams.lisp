(define-runtime-function $streamp-native (($stream :nullable-object)) (i32)
  #@(i32.or (i32.eq (call $tag (local.get $stream)) (i32.const 22))
    (i32.or (i32.le_u (i32.sub (call $tag (local.get $stream)) (i32.const 43)) (i32.const 3))
      (i32.le_u (i32.sub (call $tag (local.get $stream)) (i32.const 39)) (i32.const 2)))))

(define-runtime-function $require-stream (($stream :nullable-object)) ()
  #@(if (i32.eqz (call $streamp-native (local.get $stream)))
    (then (call $list-type-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream))))))

;; Direction queries ignore the closed flag, and synonym queries consult the
;; dynamic binding on every call, rather than retaining an obsolete target.
(define-runtime-function $stream-direction (($stream :nullable-object) ($input i32)) (i32)
  #@(loop $resolve
    (call $require-stream (local.get $stream))
    (if (i32.eq (call $tag (local.get $stream)) (i32.const 41))
      (then (local.set $stream (call $symbol-value (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream))))) (br $resolve))))
  #@(if (i32.or (i32.eq (call $tag (local.get $stream)) (i32.const 40))
                  (i32.eq (call $tag (local.get $stream)) (i32.const 46))) (then (return (i32.const 1))))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 43)) (then (return (i32.eqz (local.get $input)))))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 45)) (then (return (local.get $input))))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 44))
    (then (return (i32.ne (i32.and (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 0))
      (select (i32.const 1) (i32.const 2) (local.get $input))) (i32.const 0)))))
  #@(i32.eq (call $tag (local.get $stream))
    (select (i32.const 39) (i32.const 22) (local.get $input))))

(define-runtime-function $stream-open-p (($stream :nullable-object)) (i32)
  #@(call $require-stream (local.get $stream))
  #@(if (i32.eq (call $tag (local.get $stream)) (i32.const 22))
    (then (return (i32.eqz (struct.get $text-stream $closed (ref.cast (ref $text-stream) (local.get $stream)))))))
  #@(ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $stream)))))

(define-runtime-function $require-stream-direction (($stream :nullable-object) ($input i32)) ()
  #@(if (i32.eqz (call $stream-direction (local.get $stream) (local.get $input)))
    (then (call $type-fail (local.get $stream)
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'satisfies)))
        (call $cons (if (result (ref null eq)) (local.get $input)
          (then ,(clos-library-reference '%input-stream-p)) (else ,(clos-library-reference '%output-stream-p))) (ref.null eq)))
      (i32.const ,(runtime-error-code :expected-designator))))))

(define-runtime-function $stream-component (($stream :nullable-object) ($input i32)) (:object)
  (:locals ($tag i32))
