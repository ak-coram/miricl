      (local.set $end (array.get $digits (struct.get $obj $digits (ref.cast (ref $obj) (local.get $stream))) (i32.const 1)))
      (if (i32.eqz (local.get $supplied))
        (then (return (call $int (i32.sub (call $value-n (local.get $stream)) (local.get $first))))))
      (local.set $position (if (result i32) (i32.eq (call $id (local.get $argument)) (i32.const ,(runtime-symbol-id :start)))
