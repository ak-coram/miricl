            (then (return (call $symbol (i32.const ,(runtime-symbol-id :default))))))
          (if (i32.and (local.get $supplied) (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'file-position))))
            (then (return (call $symbol (i32.const 1)))))
