      (then
        (if (if (result i32) (local.get $input)
              (then (i32.eqz (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $stream))))))
              (else (struct.get $text-stream $closed (ref.cast (ref $text-stream) (local.get $stream)))))
          (then (call $input-stream-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream-error)))))
        (return (ref.as_non_null (local.get $stream)))))
    (if (i32.and (i32.eq (local.get $tag) (i32.const 46)) (i32.eqz (local.get $input)))
      (then
        (if (i32.eqz (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $stream)))))
          (then (call $input-stream-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream-error)))))
        (local.set $stream (struct.get $obj $b (ref.cast (ref $obj) (local.get $stream)))) (br $resolve)))
    (if (i32.le_u (i32.sub (local.get $tag) (i32.const 40)) (i32.const 1))
      (then
        (if (i32.eqz (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $stream)))))
          (then (call $input-stream-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream-error)))))
        (local.set $stream (if (result (ref null eq)) (i32.eq (local.get $tag) (i32.const 41))
          (then (call $symbol-value (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream)))))
          (else (if (result (ref null eq)) (local.get $input)
            (then (struct.get $obj $a (ref.cast (ref $obj) (local.get $stream)))) (else (struct.get $obj $b (ref.cast (ref $obj) (local.get $stream))))))))
        (br $resolve))))
  #@(if (i32.or (i32.and (i32.eq (local.get $tag) (i32.const 43)) (i32.eqz (local.get $input)))
                (i32.le_u (i32.sub (local.get $tag) (i32.const 44)) (i32.const 2)))
    (then
      (if (i32.eqz (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $stream)))))
        (then (call $input-stream-error (local.get $stream) (i32.const ,(runtime-symbol-id 'stream-error)))))
      (if (i32.ge_u (local.get $tag) (i32.const 44))
        (then (call $require-stream-direction (local.get $stream) (local.get $input))))
      (return (ref.as_non_null (local.get $stream)))))
