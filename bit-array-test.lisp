;;;; Packed bit operations use SBCL as an independent boundary/aliasing oracle.
(in-package #:miricl-test)
(in-suite :miricl)

(test native-bit-array-operations
  (m:with-interpreter (vm :fuel 1000000000)
    (dolist (size '(0 1 7 31 32 33 65 99))
      (dolist (offset '(0 1 7 31 32 33))
        (let* ((capacity (+ size 70))
               (left (make-array capacity :element-type 'bit))
               (right (make-array capacity :element-type 'bit)))
          (dotimes (i capacity)
            (setf (bit left i) (ldb (byte 1 (mod i 5)) #b10110)
                  (bit right i) (ldb (byte 1 (mod i 7)) #b1101001)))
          (dolist (operator '(bit-and bit-andc1 bit-andc2 bit-eqv bit-ior bit-nand bit-nor bit-orc1 bit-orc2 bit-xor bit-not))
            (dolist (destination '(nil t :result :second))
              (let* ((result (case destination (:result 'target) (:second 'b) (t destination)))
                     (call (if (eq operator 'bit-not) `(,operator a ,result) `(,operator a b ,result)))
                     (form `(let* ((left (make-array ,capacity :element-type 'bit :initial-contents ',left))
                                   (right (make-array ,capacity :element-type 'bit :initial-contents ',right))
                                   (storage (make-array ,capacity :element-type 'bit :initial-element 1))
                                   (a (make-array ,size :element-type 'bit :displaced-to left :displaced-index-offset ,offset))
                                   (b (make-array ,size :element-type 'bit :displaced-to right :displaced-index-offset ,(mod (+ offset 11) 35)))
                                   (target (make-array ,size :element-type 'bit :displaced-to storage :displaced-index-offset ,(mod (+ offset 23) 35)))
                                   (result ,call))
                              (list (eq result a) (eq result target) result left right storage))))
                (is (equalp (eval form) (m:evaluate vm form)) "Bit operation mismatch for ~S (~D/~D, ~S)" operator size offset destination)))))))
    (dolist (form
      '((bit-not (make-array nil :element-type 'bit :initial-element 1))
        (bit-and (make-array '(2 2) :element-type 'bit :initial-contents '((1 1) (0 0)))
                 (make-array '(2 2) :element-type 'bit :initial-contents '((1 0) (1 0))))
        (let ((a (make-array 8 :element-type 'bit :initial-element 1 :fill-pointer 2)))
          (let ((r (bit-not a t))) (list (eq a r) (fill-pointer a) (loop for i below 8 collect (bit a i)))))
        (let ((a (make-array 8 :element-type 'bit :initial-element 1 :fill-pointer 2)))
          (let ((r (bit-not a))) (list (array-total-size r) (array-has-fill-pointer-p r) r)))
        (let ((a (make-array '(2 0 3) :element-type 'bit)))
          (list (array-dimensions (bit-not a)) (array-element-type (bit-not a))))
        (multiple-value-list (bit-xor #*011 #*101))))
      (is (equalp (eval form) (m:evaluate vm form)) "Bit shape mismatch for ~S" form))))

(test native-bit-array-errors
  (m:with-interpreter (vm)
    (dolist (source '("(bit-and)" "(bit-and #*1)" "(bit-and #*1 #*0 nil nil)"
                      "(bit-not)" "(bit-not #*1 nil nil)"))
      (is (eq t (m:evaluate-string vm (concatenate 'string
        "(handler-case " source " (program-error () t))")))))
    (dolist (source '("(bit-and #(1) #*1)" "(bit-not nil)" "(bit-and #*1 #*1 #(1))"))
      (is (eq t (m:evaluate-string vm (concatenate 'string
        "(handler-case " source " (type-error () t))")))))))

(test native-bit-array-overlapping-views
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (size '(1 31 32 33 65))
      (dolist (offsets '((0 1 2) (31 7 1) (1 33 9)))
        (dolist (operator '(bit-xor bit-not))
          (destructuring-bind (first second target) offsets
            (let* ((base (make-array (+ size 70) :element-type 'bit))
                   (expected nil))
              (dotimes (i (length base)) (setf (bit base i) (ldb (byte 1 (mod i 7)) #b1101001)))
              (setf expected (copy-seq base))
              (replace expected
                (if (eq operator 'bit-not) (bit-not (subseq base first (+ first size)))
                  (bit-xor (subseq base first (+ first size)) (subseq base second (+ second size))))
                :start1 target)
              (let ((form `(let* ((base (copy-seq ',base))
                                  (a (make-array ,size :element-type 'bit :displaced-to base :displaced-index-offset ,first))
                                  (b (make-array ,size :element-type 'bit :displaced-to base :displaced-index-offset ,second))
                                  (target (make-array ,size :element-type 'bit :displaced-to base :displaced-index-offset ,target)))
                             ,(if (eq operator 'bit-not) '(bit-not a target) '(bit-xor a b target)) base)))
                (is (equalp expected (m:evaluate vm form)) "Overlapping bit views for ~S ~D/~S" operator size offsets)))))))))

(test native-bit-array-aligned-words
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (size '(0 1 31 32 33 64 65 127))
      (let ((left (make-array size :element-type 'bit)) (right (make-array size :element-type 'bit)))
        (dotimes (i size)
          (setf (bit left i) (ldb (byte 1 (mod i 5)) #b11001)
                (bit right i) (ldb (byte 1 (mod i 7)) #b0110101)))
        (dolist (operator '(bit-and bit-andc1 bit-andc2 bit-eqv bit-ior bit-nand bit-nor bit-orc1 bit-orc2 bit-xor bit-not))
          (dolist (destination '(nil t :first :second))
            (let* ((target (case destination (:first 'a) (:second 'b) (t destination)))
                   (form `(let* ((a (copy-seq ',left)) (b (copy-seq ',right))
                                 (r ,(if (eq operator 'bit-not) `(,operator a ,target) `(,operator a b ,target))))
                            (list r a b (eq r a) (eq r b)))))
              (is (equalp (eval form) (m:evaluate vm form)) "Aligned bits for ~S/~D/~S" operator size destination))))))))

(test native-bit-region-copies
  (m:with-interpreter (vm :fuel 100000000)
    (dolist (size '(0 1 7 31 32 33 65 99))
      (dolist (from '(0 1 31 32 33))
        (dolist (target '(0 1 31 32 33))
          (dolist (same '(nil t))
            (let* ((length (+ size 70))
                   (a (make-array length :element-type 'bit))
                   (b (make-array length :element-type 'bit)))
              (dotimes (i length)
                (setf (bit a i) (ldb (byte 1 (mod i 5)) #b11001)
                      (bit b i) (ldb (byte 1 (mod i 7)) #b0110101)))
              (let ((form `(let* ((a (copy-seq ',a)) (b ,(if same 'a `(copy-seq ',b))))
                             (replace a b :start1 ,target :end1 ,(+ target size) :start2 ,from :end2 ,(+ from size)) a)))
                (is (equalp (eval form) (m:evaluate vm form)) "Bit copy ~D from ~D to ~D (alias ~S)" size from target same)))))))))
