;;;; Each miricl.fasl custom section holds one versioned compilation unit.
;;;; Bundles retain the units in load order inside a single WASM module.
;;;; Symbol names, rather than bootstrap IDs, keep files independent of images.
(defvar %fasl-records nil)
(defvar %fasl-seen nil)
(defvar %fasl-roots nil)
(defvar %fasl-values nil)
(defvar %fasl-states nil)
(defvar %fasl-pending nil)
(defvar %fasl-readtable nil)
(defvar %file-top-declarations nil)
(defvar %fasl-work nil)
(define-condition %fasl-not-created (error) ())

(defun %fasl-reference (object)
  (multiple-value-bind (index found) (gethash object %fasl-seen)
    (when found (return-from %fasl-reference index)))
  (let ((index (vector-push-extend object %fasl-records)))
    (setf (gethash object %fasl-seen) index)
    (push index %fasl-work)
    index))
(defun %fasl-dump (object)
  ;; Reserve graph references before encoding their contents. A worklist keeps
  ;; large constants independent of the host's control-stack depth.
  (let* ((%fasl-work nil) (root (%fasl-reference object)))
    (loop while %fasl-work do
      (let* ((index (pop %fasl-work)) (object (aref %fasl-records index)))
        (setf (aref %fasl-records index)
          (cond
            ((and %file-load-values (gethash object %file-load-values))
             (list 10 (%fasl-reference (car (gethash object %file-load-values)))))
            ((null object) '(0))
            ((numberp object) (let ((*read-default-float-format* 'single-float))
                               (list 1 (write-to-string object :readably t :base 10 :radix nil))))
            ((characterp object) (list 2 (char-code object)))
            ((typep object 'simple-string) (list 3 (copy-seq object)))
            ((symbolp object) (list 4 (symbol-name object)
                              (and (symbol-package object) (package-name (symbol-package object)))
                              (if (symbol-package object) 0 (%%compile 9 object))))
            ((consp object) (list 5 (%fasl-reference (car object)) (%fasl-reference (cdr object)) (%%compile 8 object)))
            ((arrayp object)
             (list 6 (array-dimensions object) (%fasl-reference (array-element-type object))
               (loop for i below (array-total-size object) collect (%fasl-reference (row-major-aref object i)))))
            ((pathnamep object)
             (list 7 (%fasl-reference (list :host (pathname-host object) :device (pathname-device object)
               :directory (pathname-directory object) :name (pathname-name object) :type (pathname-type object)
               :version (pathname-version object))) (if (typep object 'logical-pathname) 1 0)))
            ((packagep object) (list 8 (package-name object)))
            (t
             (multiple-value-bind (creation initialization) (make-load-form object)
               (let ((%compilation-complete t))
                 (list 9 (%fasl-reference (%compile-form creation nil))
                         (%fasl-reference (%compile-form initialization nil))))))))))
    root))

;; Collect instance references before constructing an initialization form.
;; This lets initialization wait for a creation dependency without leaving a
;; partially reconstructed form in the ordinary cons/vector graph.
(defun %fasl-dependencies (index)
  (let ((seen (make-hash-table)) (dependencies nil) (work (list index)))
    (loop while work do
      (let ((id (pop work)))
        (unless (gethash id seen)
          (setf (gethash id seen) t)
          (let ((record (aref %fasl-records id)))
            (case (car record)
              ((9 10) (pushnew id dependencies))
              (5 (push (caddr record) work) (push (cadr record) work))
              (6 (dolist (element (reverse (cadddr record))) (push element work))
                 (push (caddr record) work))
              (7 (push (cadr record) work)))))))
    (nreverse dependencies)))
(defun %fasl-initialize (index)
  (when (= (aref %fasl-states index) 2)
    (setf (aref %fasl-states index) 3)
    (handler-case
      (progn
        (dolist (dependency (%fasl-dependencies (caddr (aref %fasl-records index))))
          (%fasl-object dependency))
        (eval (%fasl-object (caddr (aref %fasl-records index))))
        (setf (aref %fasl-states index) 4))
      (%fasl-not-created () (setf (aref %fasl-states index) 2) (pushnew index %fasl-pending)))))
(defun %fasl-object (index)
  (unless (and (integerp index) (<= 0 index) (< index (length %fasl-records)))
    (error "Invalid compiled object reference."))
  (let ((state (aref %fasl-states index)) (record (aref %fasl-records index)))
    (when (= state 1) (error '%fasl-not-created))
    (when (>= state 2)
      (when (= state 2) (%fasl-initialize index))
      (return-from %fasl-object (aref %fasl-values index)))
    (setf (aref %fasl-states index) 1)
    (setf (aref %fasl-values index)
      (case (car record)
        (0 nil)
        (1 (let ((*readtable* %fasl-readtable) (*read-eval* nil) (*read-base* 10)
                 (*read-default-float-format* 'single-float)) (read-from-string (cadr record))))
        (2 (or (code-char (cadr record)) (error "Invalid compiled character.")))
        (3 (copy-seq (cadr record)))
        (4 (if (plusp (cadddr record)) (%%compile 10 (cadddr record) (cadr record))
               (if (caddr record) (intern (cadr record) (or (find-package (caddr record))
                               (error 'package-error :package (caddr record))))
                   (make-symbol (cadr record)))))
        (5 (%%compile 13 index))
        (6
         (let ((array (make-array (cadr record) :element-type (%fasl-object (caddr record)))))
           (setf (aref %fasl-values index) array (aref %fasl-states index) 3)
           (loop for element in (cadddr record) for i from 0 do (setf (row-major-aref array i) (%fasl-object element)))
           array))
        (7
         (let ((parts (%fasl-object (cadr record))))
           (when (and (= (caddr record) 1) (not (ignore-errors (logical-pathname-translations (getf parts :host)))))
             (setf (logical-pathname-translations (getf parts :host)) nil))
           (apply 'make-pathname parts)))
        (8 (or (find-package (cadr record)) (error 'package-error :package (cadr record))))
        ((9 10)
         (dolist (dependency (%fasl-dependencies (cadr record))) (%fasl-object dependency))
         (let ((value (eval (%fasl-object (cadr record)))))
           (setf (aref %fasl-values index) value (aref %fasl-states index) 2)
           (if (= (car record) 9) (%fasl-initialize index) (setf (aref %fasl-states index) 4)) value))
        (otherwise (error "Invalid compiled object kind."))))
    (unless (= (aref %fasl-states index) 2) (setf (aref %fasl-states index) 4))
    (aref %fasl-values index)))
(defun %fasl-finish-initializations ()
  (loop while %fasl-pending do
    (let ((pending %fasl-pending) (progress nil))
      (setq %fasl-pending nil)
      (dolist (index pending)
        (%fasl-initialize index)
        (when (= (aref %fasl-states index) 4) (setq progress t)))
      (when (and %fasl-pending (not progress)) (error "Circular compiled creation dependencies.")))))

(defun %compile-top-body (body environment compile-time-too)
  (let ((declarations nil))
    (loop while (and (consp (car body)) (eq (caar body) 'declare)) do
      (let ((declaration (pop body)))
        (push declaration declarations)
        (dolist (spec (cdr declaration))
          (when (eq (car spec) 'special)
            (dolist (name (cdr spec)) (setq environment (%%compile 11 environment name)))))))
    (let ((%file-top-declarations (append %file-top-declarations (nreverse declarations))))
      (dolist (form body) (%compile-top-level form environment compile-time-too)))))
(defun %compile-top-level (form environment compile-time-too)
  ;; Defining forms establish the compilation environment before later forms
  ;; are read, without making ordinary DEFUN definitions available for use.
  (let ((operator (and (consp form) (car form))))
    (when (member operator '(in-package defpackage defmacro deftype defclass defstruct define-condition))
      (unless compile-time-too (%%compile 7 environment form)))
    (multiple-value-bind (expansion expanded) (macroexpand-1 form environment)
      (when expanded (return-from %compile-top-level (%compile-top-level expansion environment compile-time-too))))
    (case operator
      (eval-when
        (let* ((situations (cadr form))
               (compile (or (intersection situations '(:compile-toplevel compile))
                            (and compile-time-too (intersection situations '(:execute eval)))))
               (load (intersection situations '(:load-toplevel load))))
          (if load (dolist (child (cddr form)) (%compile-top-level child environment compile))
              (when compile (%%compile 7 environment (cons 'progn (cddr form)))))))
      (progn (dolist (child (cdr form)) (%compile-top-level child environment compile-time-too)))
      (locally (%compile-top-body (cdr form) environment compile-time-too))
      ((macrolet symbol-macrolet)
        (let ((new-environment environment))
          (dolist (definition (cadr form))
            (setq new-environment
              (if (eq operator 'symbol-macrolet)
                  (%%compile 6 new-environment (car definition) (cadr definition))
                  (%%compile 5 new-environment (car definition)
                    (%%compile 7 environment
                      (apply '%macro-lambda (car definition) (cadr definition) (cddr definition)))))))
          (%compile-top-body (cddr form) new-environment compile-time-too)))
      (otherwise
        (when compile-time-too (%%compile 7 environment form))
        (let ((%compilation-complete t))
          (let ((compiled (%compile-form form environment)))
            (push (%fasl-dump (if %file-top-declarations
              (cons 'locally (append %file-top-declarations (list compiled))) compiled)) %fasl-roots)))))))

(defun %fasl-uleb (value bytes)
  (loop
    (let ((byte (logand value 127)))
      (setq value (ash value -7))
      (vector-push-extend (if (zerop value) byte (logior byte 128)) bytes)
      (when (zerop value) (return bytes)))))
(defun %fasl-write (path roots records)
  (let* ((*readtable* (copy-readtable nil)) (*print-circle* t) (*print-pretty* nil)
         (*print-level* nil) (*print-length* nil) (*print-array* t)
         (payload (%%compile 12 (write-to-string (list 1 roots (coerce records 'list)) :readably t :base 10 :radix nil)))
         (header (make-array 32 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (dolist (byte '(0 97 115 109 1 0 0 0 0)) (vector-push-extend byte header))
    (%fasl-uleb (+ 12 (length payload)) header)
    (vector-push-extend 11 header)
    (loop for character across "miricl.fasl" do (vector-push-extend (char-code character) header))
    (with-open-file (stream path :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
      (write-sequence header stream) (write-sequence payload stream))))
(defun %fasl-read-uleb (stream)
  (let ((value 0) (shift 0))
    (loop for byte = (read-byte stream) do
      (when (or (> shift 28) (and (= shift 28) (> byte 15)))
        (error "Invalid compiled section length."))
      (setq value (logior value (ash (logand byte 127) shift)))
      (unless (logbitp 7 byte) (return value)) (incf shift 7))))
(defun %fasl-read-header (stream)
  (dolist (byte '(0 97 115 109 1 0 0 0))
    (unless (= byte (read-byte stream)) (error "Invalid compiled file header."))))
(defun %fasl-section-end (stream)
  (unless (zerop (read-byte stream)) (error "Invalid compiled section kind."))
  (let* ((size (%fasl-read-uleb stream)) (end (+ (file-position stream) size)))
    (unless (and (> size 12) (<= end (file-length stream)))
      (error "Invalid compiled section size."))
    (unless (= (%fasl-read-uleb stream) 11) (error "Invalid compiled section name."))
    (loop for character across "miricl.fasl" do
      (unless (= (char-code character) (read-byte stream)) (error "Invalid compiled section name.")))
    (unless (< (file-position stream) end) (error "Invalid compiled section size."))
    end))
(defun %load-compiled-unit (stream end print)
  ;; Bind these afresh for each unit, as if loading its original FASL separately.
  (let* ((*package* *package*) (*readtable* *readtable*)
         (%fasl-readtable (copy-readtable nil))
         (source (%%compile 14 stream (file-position stream) end))
         (payload (let ((*readtable* %fasl-readtable) (*read-eval* nil) (*read-base* 10))
                    (multiple-value-bind (value position) (read-from-string source)
                      (unless (= position (length source)) (error "Invalid compiled payload size."))
                      value)))
         (%fasl-records (coerce (caddr payload) 'vector))
         (%fasl-values (make-array (length %fasl-records)))
         (%fasl-states (make-array (length %fasl-records) :initial-element 0)) (%fasl-pending nil))
    (unless (eql (car payload) 1) (error "Unsupported compiled file version."))
    (dolist (index (cadr payload))
      (let ((form (%fasl-object index)))
        (%fasl-finish-initializations)
        (let ((value (eval form))) (when print (print value)))))))
(defun %load-compiled-file (pathname truename options)
  (let ((*load-pathname* pathname) (*load-truename* truename))
    (%load-message truename (car options))
    (with-open-file (binary truename :element-type '(unsigned-byte 8))
      (%fasl-read-header binary)
      (loop while (< (file-position binary) (file-length binary)) do
        (let ((end (%fasl-section-end binary)))
          (%load-compiled-unit binary end (cadr options))
          (file-position binary end))))
    t))

(defun compile-file (input-file &key (output-file nil outputp) (verbose *compile-verbose*) (print *compile-print*) (external-format :default))
  (let* ((*package* *package*) (*readtable* *readtable*)
         (*compile-file-pathname* (merge-pathnames input-file)) (*compile-file-truename* (truename input-file))
         (target (if outputp (compile-file-pathname input-file :output-file output-file) (compile-file-pathname input-file)))
         (%file-compiling t) (%file-load-values (make-hash-table :test 'eq))
         (%fasl-records (make-array 32 :adjustable t :fill-pointer 0))
         (%fasl-seen (make-hash-table :test 'eq)) (%fasl-roots nil) (%file-top-declarations nil)
         (warnings nil) (failure nil))
    (when verbose (format t "~&; Compiling ~A~%" *compile-file-truename*))
    (handler-bind ((warning (lambda (condition) (setq warnings t) (unless (typep condition 'style-warning) (setq failure t)))))
      (with-open-file (stream *compile-file-truename* :external-format external-format)
        (let ((eof (list nil)))
          (loop for form = (read stream nil eof) until (eq form eof) do
            (when print (format t "~&; ~S~%" (if (consp form) (car form) form)))
            (%compile-top-level form nil nil))))
      (%fasl-write target (nreverse %fasl-roots) %fasl-records))
    (values (truename target) warnings failure)))
