;;;; Physical pathname components are independent of their printed namestring.
;; Local syntax uses '/', '.' and '*' and a customary lowercase case convention.
(defun %pathname-case (component case)
  (unless (member case '(:local :common))
    (error 'type-error :datum case :expected-type '(member :local :common)))
  (cond ((and (eq case :common) (stringp component))
         (cond ((string= component (string-upcase component)) (string-downcase component))
               ((string= component (string-downcase component)) (string-upcase component))
               (t component)))
        ((consp component) (mapcar (lambda (x) (%pathname-case x case)) component))
        (t component)))

(defun %pathname-parts (path)
  (let ((path (pathname path)))
    (or (%%pathname-metadata path nil)
        (%%pathname-metadata path
          (list nil nil (%pathname-directory path) (%pathname-name path) (%pathname-type path) nil)))))

(defun %pathname-case-component (path index case)
  (let ((p (pathname path)))
    (%pathname-case nil case)
    (%pathname-case (nth index (%pathname-parts p)) (if (typep p 'logical-pathname) :local case))))
(defun pathname-host (path &key (case :local)) (%pathname-case-component path 0 case))
(defun pathname-device (path &key (case :local)) (%pathname-case-component path 1 case))
(defun pathname-directory (path &key (case :local)) (%pathname-case-component path 2 case))
(defun pathname-name (path &key (case :local)) (%pathname-case-component path 3 case))
(defun pathname-type (path &key (case :local)) (%pathname-case-component path 4 case))
(defun pathname-version (path) (sixth (%pathname-parts path)))

(defun %copy-path-component (value)
  (cond ((stringp value) (copy-seq value))
        ((consp value) (mapcar #'%copy-path-component value)) (t value)))

(defun %pathname-directory-list (directory)
  (cond ((eq directory :wild) '(:absolute :wild-inferiors))
        ((stringp directory) (list :relative directory))
        ((member directory '(nil :unspecific)) directory)
        ((and (consp directory) (member (car directory) '(:absolute :relative)))
         (let ((previous (car directory)))
           (dolist (part (cdr directory))
             (unless (or (stringp part) (member part '(:wild :wild-inferiors :up :back)))
               (error 'type-error :datum directory :expected-type 'list))
             (when (and (member part '(:up :back)) (member previous '(:absolute :wild-inferiors)))
               (error 'file-error :pathname (pathname "")))
             (setq previous part)))
         directory)
        (t (error 'type-error :datum directory :expected-type '(or list string (member :wild :unspecific))))))

(defun %pathname-from-parts (parts)
  (when (and (stringp (first parts)) (%logical-host-entry (first parts)))
    (return-from %pathname-from-parts (%make-logical-parts parts)))
  (let* ((directory (third parts)) (name (fourth parts)) (type (fifth parts))
         (text (format nil "~A~A~A~A"
                 (if (consp directory)
                   (format nil "~A~{~A/~}" (if (eq (car directory) :absolute) "/" "")
                     (mapcar (lambda (x) (if (member x '(:up :back)) ".." (%pathname-component-string x)))
                       (cdr directory))) "")
                 (%pathname-component-string (if (stringp name) name (if (eq name :wild) :wild "")))
                 (if (or (stringp type) (eq type :wild)) "." "")
                 (%pathname-component-string (if (stringp type) type (if (eq type :wild) :wild "")))))
         (path (%%make-source-path text)))
    (%%pathname-metadata path parts)
    path))

(defun make-pathname (&key (defaults "") (case :local)
                          (host nil hostp) (device nil devicep) (directory nil directoryp)
                          (name nil namep) (type nil typep) (version nil versionp))
  (let* ((base (%pathname-parts defaults))
         (parts (list (if hostp (%pathname-case host case) (first base))
                      (if devicep (%pathname-case device case) (second base))
                      (if directoryp (%pathname-directory-list (%pathname-case directory case)) (third base))
                      (if namep (%pathname-case name case) (fourth base))
                      (if typep (%pathname-case type case) (fifth base))
                      (if versionp version (sixth base)))))
    (%pathname-case nil case)
    (dolist (part (list (fourth parts) (fifth parts)))
      (unless (or (stringp part) (member part '(nil :wild :unspecific)))
        (error 'type-error :datum part :expected-type '(or string (member nil :wild :unspecific)))))
    (unless (or (typep (sixth parts) '(integer 1 *)) (member (sixth parts) '(nil :wild :newest :unspecific)))
      (error 'type-error :datum (sixth parts) :expected-type '(or (integer 1 *) (member nil :wild :newest :unspecific))))
    (%pathname-from-parts (mapcar #'%copy-path-component parts))))

(defun merge-pathnames (path &optional (defaults *default-pathname-defaults*) (default-version :newest))
  (let* ((parts (%pathname-parts path)) (base (%pathname-parts defaults))
         (directory (third parts)) (previous nil))
    (setq directory (if (and (consp directory) (eq (car directory) :relative) (consp (third base)))
                      (append (third base) (cdr directory)) (or directory (third base))))
    (when (consp directory)
      (dolist (part directory)
        (if (and (eq part :back) (or (stringp (car previous)) (eq (car previous) :wild)))
            (pop previous) (push part previous)))
      (setq directory (nreverse previous)))
    (%pathname-from-parts
      (mapcar #'%copy-path-component
        (list (or (first parts) (first base)) (or (second parts) (second base)) directory
              (or (fourth parts) (fourth base)) (or (fifth parts) (fifth base))
              (or (sixth parts) (and (null (fourth parts)) (sixth base)) default-version))))))

(defun %wild-path-component-p (component)
  (cond ((member component '(:wild :wild-inferiors)) t)
        ((stringp component) (not (null (position #\* component))))
        ((consp component) (some #'%wild-path-component-p component))))

(defun wild-pathname-p (path &optional field)
  (let ((parts (%pathname-parts path)))
    (if (null field) (some #'%wild-path-component-p parts)
      (%wild-path-component-p
        (nth (or (position field '(:host :device :directory :name :type :version))
                 (error 'type-error :datum field :expected-type '(member nil :host :device :directory :name :type :version))) parts)))))

(defun %pathname-component-match-p (part pattern)
  (cond ((or (null pattern) (eq pattern :wild)) t)
        ((equal part pattern) t)
        ((and (stringp part) (stringp pattern) (not (%wild-path-component-p part)))
         (%%pathname-match part pattern))
        (t nil)))

(defun %pathname-directory-match-p (parts pattern)
  (cond ((null pattern) (null parts))
        ((eq pattern :wild) t)
        ((eq (car pattern) :wild-inferiors)
         (or (%pathname-directory-match-p parts (cdr pattern))
             (and parts (%pathname-directory-match-p (cdr parts) pattern))))
        ((null parts) nil)
        (t (and (%pathname-component-match-p (car parts) (car pattern))
                (%pathname-directory-match-p (cdr parts) (cdr pattern))))))

(defun pathname-match-p (path wildcard)
  (let* ((path (pathname path)) (parts (%pathname-parts path)) (pattern (%pathname-parts wildcard)))
    (and (%pathname-component-match-p (first parts) (first pattern))
         (%pathname-component-match-p (second parts) (second pattern))
         (or (null (third pattern)) (%pathname-directory-match-p (or (third parts) (and (typep path 'logical-pathname) '(:absolute))) (third pattern)))
         (%pathname-component-match-p (fourth parts) (fourth pattern))
         (%pathname-component-match-p (fifth parts) (fifth pattern))
         (%pathname-component-match-p (sixth parts) (sixth pattern)))))

(defun host-namestring (path) (let ((p (pathname path))) (if (typep p 'logical-pathname) (pathname-host p) "")))
(defun enough-namestring (path &optional (defaults *default-pathname-defaults*))
  (let ((text (namestring path)) (base (directory-namestring defaults)))
    (if (and (<= (length base) (length text)) (string= base text :end2 (length base)))
        (subseq text (length base)) text)))

;; Preserve components that local #P syntax cannot express, including versions.
(defun %pathname-read-form (path)
  (let* ((parts (%pathname-parts path))
         (plain (if (typep path 'logical-pathname)
                  (%pathname-parts (%parse-logical (namestring path) nil))
                  (list nil nil (%pathname-directory path) (%pathname-name path) (%pathname-type path) nil))))
    (unless (equal parts plain)
      (cons 'make-pathname
        (loop for key in '(:host :device :directory :name :type :version)
              for value in parts append (list key (list 'quote value)))))))
