;;;; Checked compiler boundaries. These routines must not inherit the unsafe
;;;; policy used for compiler kernels operating on validated internal records.
(in-package :miricl-compiler)

(define-condition compiler-input-error (program-error)
  ((context :initarg :context :reader compiler-error-context)
   (datum :initarg :datum :reader compiler-error-datum)
   (reason :initarg :reason :reader compiler-error-reason))
  (:report (lambda (condition stream)
    (let ((*print-circle* t) (*print-level* 4) (*print-length* 8))
      (format stream "Invalid compiler ~A: ~A.~%  Input: ~S"
        (compiler-error-context condition) (compiler-error-reason condition)
        (compiler-input-summary (compiler-error-datum condition)))))))

(defun compiler-input-summary (datum)
  (declare (optimize (safety 3)))
  ;; Printer depth/length alone do not bound strings or large integers, and
  ;; printing arbitrary user objects can invoke their PRINT-OBJECT methods.
  (let ((nodes 64) (characters 512))
    (labels ((text (string)
               (let ((size (min (length string) 80 (max 0 characters))))
                 (decf characters size)
                 (if (= size (length string)) string (concatenate 'string (subseq string 0 size) "..."))))
             (walk (object depth)
               (when (or (minusp (decf nodes)) (<= characters 0) (zerop depth))
                 (return-from walk "..."))
               (cond
                 ((null object) nil)
                 ((stringp object) (text object))
                 ((symbolp object)
                  (let ((size (+ (length (symbol-name object))
                                 (if (symbol-package object) (length (package-name (symbol-package object))) 0))))
                    (if (<= size (min 80 characters))
                        (progn (decf characters (+ size 3)) object) (text (symbol-name object)))))
                 ((integerp object)
                  (decf characters 40) (if (<= (integer-length object) 128) object "<large integer>"))
                 ((floatp object) (decf characters 32) object)
                 ((characterp object) (decf characters 16) object)
                 ((consp object)
                  (let ((items nil) (tail object))
                    (dotimes (i 8)
                      (unless (and (consp tail) (> nodes 0) (> characters 0)) (return))
                      (push (walk (car tail) (1- depth)) items) (setq tail (cdr tail)))
                    (nreconc items (if tail (list (if (consp tail) "..." (walk tail (1- depth)))) nil))))
                 ((simple-vector-p object)
                  (coerce (loop for i below (min 8 (length object)) collect (walk (svref object i) (1- depth))) 'vector))
                 (t "<object>"))))
      (walk datum 4))))

(defun compiler-input-fail (context datum reason)
  (declare (optimize (safety 3)))
  (error 'compiler-input-error :context context :datum datum :reason reason))

(defun compiler-list-length (object context)
  (declare (optimize (safety 3)))
  ;; Empty operand and attribute lists are frequent at checked boundaries.
  ;; They need no native-service call or multiple-value result packet.
  (when (null object) (return-from compiler-list-length 0))
  (multiple-value-bind (count native) (compiler-primitive 40 object)
    (when native
      (case count
        (-1 (compiler-input-fail context object "expected a proper list; found a dotted tail"))
        (-2 (compiler-input-fail context object "circular list"))
        (otherwise (return-from compiler-list-length count)))))
  ;; Floyd's algorithm checks both dotted tails and cycles without recursion,
  ;; allocation or relying on a declared LIST type for caller-supplied data.
  (let ((fast object) (slow object) (size 0))
    (loop
      (when (null fast) (return size))
      (unless (consp fast) (compiler-input-fail context object "expected a proper list; found a dotted tail"))
      (setq fast (cdr fast)) (incf size)
      (when (null fast) (return size))
      (unless (consp fast) (compiler-input-fail context object "expected a proper list; found a dotted tail"))
      (setq fast (cdr fast) slow (cdr slow)) (incf size)
      (when (eq fast slow) (compiler-input-fail context object "circular list")))))

(defun compiler-type-specifier (type &optional checked)
  "Validate type structure consumed by inference, without running type expanders.
Objects inside MEMBER and EQL remain literal data, including cyclic objects."
  (declare (optimize (safety 3)))
  (let ((seen (or checked (make-hash-table :test 'eq))) (work (list (cons type nil))))
    (loop while work do
      (let* ((job (pop work)) (item (car job)))
        (when (consp item)
          (cond
            ((cdr job) (setf (gethash item seen) :done))
            ((eq (gethash item seen) :active)
             (compiler-input-fail "type specifier" item "circular type expression"))
            ((not (gethash item seen))
             (let ((size (compiler-list-length item "type specifier")))
               (setf (gethash item seen) :active) (push (cons item t) work)
               (case (car item)
                 ((and or values)
                  (dolist (part (cdr item)) (push (cons part nil) work)))
                 ((not cons)
                  (unless (if (eq (car item) 'not) (= size 2) (<= 1 size 3))
                    (compiler-input-fail "type specifier" item "invalid type argument count"))
                  (dolist (part (cdr item)) (push (cons part nil) work)))
                 (function
                  (unless (<= 1 size 3)
                    (compiler-input-fail "function type" item "invalid type argument count"))
                  (when (= size 3) (push (cons (third item) nil) work)))
                 (integer
                  (unless (<= 1 size 3)
                    (compiler-input-fail "integer type" item "expected at most two interval bounds"))
                  (dolist (bound (cdr item))
                    (unless (or (eq bound '*) (integerp bound)
                                (and (consp bound) (= (compiler-list-length bound "integer type bound") 1)
                                     (integerp (car bound))))
                      (compiler-input-fail "integer type bound" bound "expected an integer, *, or (integer)"))))
                 ((signed-byte unsigned-byte)
                  (unless (and (<= 1 size 2)
                               (or (= size 1) (eq (second item) '*)
                                   (and (integerp (second item))
                                        (>= (second item) (if (eq (car item) 'signed-byte) 1 0)))))
                    (compiler-input-fail "integer type" item "invalid byte width")))
                 (mod
                  (unless (and (= size 2) (integerp (second item)) (plusp (second item)))
                    (compiler-input-fail "MOD type" item "expected a positive integer modulus")))
                 (simple-vector
                  (unless (and (<= 1 size 2)
                               (or (= size 1) (eq (second item) '*)
                                   (and (integerp (second item)) (<= 0 (second item)))))
                    (compiler-input-fail "simple-vector type" item "expected a nonnegative size or *")))
                 (eql
                  (unless (= size 2) (compiler-input-fail "EQL type" item "expected exactly one object"))))))))))
    type))

(defun compiler-variable-name (name context)
  (declare (optimize (safety 3)))
  (unless (and (symbolp name) name (not (constantp name))
               (not (member name lambda-list-keywords)))
    (compiler-input-fail context name "expected a nonconstant variable name"))
  name)

(defun compiler-function-name (name context)
  (declare (optimize (safety 3)))
  (unless (or (symbolp name)
              (and (consp name) (= (compiler-list-length name context) 2)
                   (eq (first name) 'setf) (symbolp (second name))))
    (compiler-input-fail context name "expected a symbol or (SETF symbol)"))
  name)

(defun compiler-lambda-list (parameters)
  (declare (optimize (safety 3)))
  (compiler-list-length parameters "lambda list")
  (let ((mode :required) (seen nil) (markers nil))
    (labels ((variable (name)
               (compiler-variable-name name "lambda parameter")
               ;; &AUX introduces sequential LET*-style bindings, which may
               ;; shadow parameters and earlier auxiliary bindings.
               (unless (eq mode :aux)
                 (when (member name seen)
                   (compiler-input-fail "lambda parameter" name "duplicate parameter name"))
                 (push name seen))))
      (loop while parameters for parameter = (pop parameters) do
        (cond
          ((member parameter lambda-list-keywords)
           (when (member parameter markers)
             (compiler-input-fail "lambda list" parameter "repeated lambda-list keyword"))
           (case parameter
             (&optional (unless (eq mode :required)
                          (compiler-input-fail "lambda list" parameter "misplaced &OPTIONAL"))
                        (setq mode :optional))
             (&rest (unless (and (member mode '(:required :optional)) parameters)
                      (compiler-input-fail "lambda list" parameter "&REST requires one variable before &KEY or &AUX"))
                    (variable (pop parameters)) (setq mode :after-rest))
             (&key (unless (member mode '(:required :optional :after-rest))
                     (compiler-input-fail "lambda list" parameter "misplaced &KEY"))
                   (setq mode :key))
             (&allow-other-keys (unless (eq mode :key)
                                  (compiler-input-fail "lambda list" parameter "misplaced &ALLOW-OTHER-KEYS"))
                                (setq mode :after-keys))
             (&aux (setq mode :aux))
             (otherwise (compiler-input-fail "lambda list" parameter "keyword is not valid in an ordinary lambda list")))
           (push parameter markers))
          ((member mode '(:after-rest :after-keys))
           (compiler-input-fail "lambda list" parameter "unexpected parameter after &REST or &ALLOW-OTHER-KEYS"))
          ((symbolp parameter) (variable parameter))
          (t
           (let ((size (compiler-list-length parameter "lambda parameter")))
             (unless (and (not (eq mode :required))
                          (<= 1 size (if (eq mode :aux) 2 3)))
               (compiler-input-fail "lambda parameter" parameter "invalid parameter specification"))
             (let ((name (first parameter)))
               (when (and (eq mode :key) (consp name))
                 (unless (and (= (compiler-list-length name "keyword parameter") 2) (symbolp (first name)))
                   (compiler-input-fail "keyword parameter" name "expected (keyword-name variable)"))
                 (setq name (second name)))
               (variable name))
             (when (= size 3) (variable (third parameter))))))))
  t))

(defun compiler-body (body)
  (declare (optimize (safety 3)))
  (compiler-list-length body "body")
  (when (and (stringp (first body)) (cdr body)) (setq body (cdr body)))
  (loop while (and (consp (first body)) (eq (caar body) 'declare)) do
    (compiler-list-length (first body) "DECLARE form")
    (dolist (declaration (cdar body))
      (unless (and (consp declaration) (symbolp (first declaration)))
        (compiler-input-fail "declaration" declaration "expected (declaration-name ...)"))
      (compiler-list-length declaration "declaration")
      (case (first declaration)
        (special
         (dolist (name (cdr declaration)) (compiler-variable-name name "SPECIAL declaration")))
        (type
         (unless (cdr declaration) (compiler-input-fail "TYPE declaration" declaration "missing type specifier"))
         (compiler-type-specifier (second declaration))
         (dolist (name (cddr declaration)) (compiler-variable-name name "TYPE declaration variable")))
        ((inline notinline)
         (dolist (name (cdr declaration)) (compiler-function-name name "function declaration")))
        (ftype
         (unless (cdr declaration) (compiler-input-fail "FTYPE declaration" declaration "missing function type"))
         (compiler-type-specifier (second declaration))
         (dolist (name (cddr declaration)) (compiler-function-name name "FTYPE declaration name"))))
      (when (eq (first declaration) 'optimize)
        (dolist (quality (cdr declaration))
          (unless (or (symbolp quality)
                      (and (consp quality) (= (compiler-list-length quality "optimization quality") 2)
                           (symbolp (first quality)) (typep (second quality) '(integer 0 3))))
            (compiler-input-fail "optimization quality" quality "expected a quality name or (name level), with level from 0 through 3")))))
    (setq body (cdr body)))
  t)

(defun compiler-source-form (form)
  (declare (optimize (safety 3)))
  ;; Inspect only syntax consumed here. In particular, quoted objects and
  ;; macro arguments can contain arbitrary data, including dotted/cyclic data.
  (when (consp form)
    (let ((size (compiler-list-length form "source form")) (operator (first form)))
      (unless (or (symbolp operator) (consp operator))
        (compiler-input-fail "operator" operator "expected a function name or lambda expression"))
      (case operator
        ((quote function go)
         (unless (= size 2) (compiler-input-fail "source form" form "expected exactly one argument")))
        (if (unless (<= 3 size 4) (compiler-input-fail "IF form" form "expected a test, consequent and optional alternative")))
        (the (unless (= size 3) (compiler-input-fail "THE form" form "expected a type and a value form"))
             (compiler-type-specifier (second form)))
        (load-time-value
         (unless (and (<= 2 size 3) (member (third form) '(nil t)))
           (compiler-input-fail "LOAD-TIME-VALUE form" form "expected a form and optional boolean read-only flag")))
        (lambda
         (unless (>= size 2) (compiler-input-fail "lambda expression" form "missing lambda list"))
         (compiler-lambda-list (second form)) (compiler-body (cddr form)))
        (defun
         (unless (>= size 3) (compiler-input-fail "DEFUN form" form "expected a name, lambda list and body"))
         (compiler-function-name (second form) "function name")
         (compiler-lambda-list (third form)) (compiler-body (cdddr form)))
        ((let let*)
         (unless (>= size 2) (compiler-input-fail "binding form" form "missing binding list"))
         (compiler-list-length (second form) "binding list")
         (let ((names nil))
           (dolist (binding (second form))
             (let ((name binding))
               (when (consp binding)
                 (unless (<= 1 (compiler-list-length binding "binding") 2)
                   (compiler-input-fail "binding" binding "expected a variable and optional initializer"))
                 (setq name (first binding)))
               (compiler-variable-name name "binding")
               (when (and (eq operator 'let) (member name names))
                 (compiler-input-fail "LET binding" binding "duplicate variable name"))
               (push name names))))
         (compiler-body (cddr form)))
        ((flet labels)
         (unless (>= size 2) (compiler-input-fail "local functions" form "missing definition list"))
         (compiler-list-length (second form) "local function definitions")
         (let ((names nil))
           (dolist (definition (second form))
             (unless (>= (compiler-list-length definition "local function definition") 2)
               (compiler-input-fail "local function definition" definition "expected a name, lambda list and body"))
             (compiler-function-name (first definition) "local function name")
             (when (member (first definition) names :test #'equal)
               (compiler-input-fail "local function definition" definition "duplicate function name"))
             (push (first definition) names)
             (compiler-lambda-list (second definition)) (compiler-body (cddr definition))))
         (compiler-body (cddr form)))
        (locally (compiler-body (cdr form)))
        (setq
         (unless (oddp size) (compiler-input-fail "SETQ form" form "expected variable/value pairs"))
         (loop for pairs on (cdr form) by #'cddr do (compiler-variable-name (first pairs) "SETQ variable")))
        (block
         (unless (and (>= size 2) (symbolp (second form)))
           (compiler-input-fail "BLOCK form" form "expected a block name followed by body forms")))
        (return-from
         (unless (and (<= 2 size 3) (symbolp (second form)))
           (compiler-input-fail "RETURN-FROM form" form "expected a block name and optional value")))
        ((catch unwind-protect multiple-value-prog1 multiple-value-call)
         (unless (>= size 2) (compiler-input-fail "source form" form "missing required argument")))
        ((throw progv)
         (unless (and (>= size 3) (or (eq operator 'progv) (= size 3)))
           (compiler-input-fail "source form" form "expected two arguments before any body forms"))))))
  form)
