(in-package #:miricl-test)
(in-suite :miricl)

(test runtime-tree-substitution-worker-host
  (dolist (tree '(nil a 1 (1 2 1) (1 (2 1) . 1) ((1 . 2) (3 1) nil)))
    (dolist (write '(nil t))
      (dolist (alist '(nil t))
        (let* ((source (copy-tree tree)) (expected-source (copy-tree tree))
               (item (if alist '((1 . :new) (a . :letter)) 1))
               (actual (miricl-runtime:substitute-tree-values source item :new
                         (vector nil #'eql 0 nil write alist)))
               (expected (if alist
                             (if write (nsublis item expected-source) (sublis item expected-source))
                             (if write (nsubst :new item expected-source) (subst :new item expected-source)))))
          (is (equal expected actual))
          (is (equal expected-source source))))))
  (let* ((source (list (list 1 2) 3)) (untouched (car source))
         (actual (miricl-runtime:substitute-tree-values source 3 9 (vector nil #'eql 0 nil nil nil))))
    (is (equal '((1 2) 9) actual))
    (is (eq untouched (car actual)))
    (is (equal '((1 2) 3) source)))
  (let* ((source (list 1 2 3)) (tails (loop for cell on source collect cell)))
    (is (eq source (miricl-runtime:substitute-tree-values source 2 9 (vector nil #'eql 0 nil t nil))))
    (is (every #'eq tails (loop for cell on source collect cell))))
  (dolist (car-cycle '(nil t))
    (let ((source (list 1)))
      (if car-cycle (setf (car source) source) (setf (cdr source) source))
      (signals type-error
        (miricl-runtime:substitute-tree-values source :absent :new (vector nil #'eql 0 nil nil nil)))))
  (let ((source (list 1 2 3)))
    (signals type-error
      (miricl-runtime:substitute-tree-values source nil :new
        (vector nil (lambda (x) (when (eql x 1) (setf (cdr source) source)) nil) 1 nil nil nil))))
  (is (equal '(1 :new 3)
             (miricl-runtime:substitute-tree-values '(1 2 3) 2 :new (vector nil #'eql 0 nil nil nil)))))

(test runtime-tree-copy-worker-host
  (dolist (tree '(nil a 1 (1 2 1) (1 (2 1) . 1) ((1 . 2) (3 1) nil)))
    (let ((copy (miricl-runtime:copy-tree-value tree)))
      (is (equal tree copy))
      (if (consp tree) (is (not (eq tree copy))) (is (eq tree copy)))))
  (let* ((shared (list 1 2)) (source (list shared shared)) (copy (miricl-runtime:copy-tree-value source)))
    (is (equal source copy))
    (is (not (eq (first copy) shared)))
    (is (not (eq (first copy) (second copy))))
    (setf (car (first copy)) :changed)
    (is (equal '((1 2) (1 2)) source)))
  (dolist (car-cycle '(nil t))
    (let ((source (list 1)))
      (if car-cycle (setf (car source) source) (setf (cdr source) source))
      (signals type-error (miricl-runtime:copy-tree-value source))))
  (let ((source (loop for i below 20000 collect i)))
    (is (equal source (miricl-runtime:copy-tree-value source))))
  (is (equal '(1 2 3) (miricl-runtime:copy-tree-value '(1 2 3)))))
