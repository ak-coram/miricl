;;;; miricl.asd

(asdf:defsystem #:miricl/cross
  :description "Host cross-compilation to MIRICL Wasm, without Wasmtime or a guest bootstrap"
  :serial t
  :depends-on (#:alexandria #:named-readtables)
  :components ((:file "package")
               (:file "miricl-readtables")
               (:file "runtime-bootstrap")
               (:file "fasl-utilities")
               (:file "hir-code")
               (:file "fasl-format")
               (:file "whole-program")
               (:file "compiler-input")
               (:file "compiler-statistics")
               (:file "hir")
               (:file "hir-interpreter")
               (:file "hir-reconstruction")
               (:file "hir-types")
               (:file "hir-optimize")
               (:file "wasm-compiler")
               (:file "wasm-optimizer")
               (:file "wasm-disassembly")
               (:file "wasm-module-optimizer")
               (:file "runtime-kernel-library")
               (:file "runtime-iteration-expansion-kernels")
               (:file "runtime-character-kernels")
               (:file "runtime-list-mapping-kernels")
               (:file "runtime-reader-kernels")
               (:file "runtime-integer-field-kernels")
               (:file "runtime-reduce-kernels")
               (:file "runtime-sequence-edit-kernels")
               (:file "runtime-count-kernels")
               (:file "runtime-string-case-loop-kernels")
               (:file "runtime-search-kernels")
               (:file "runtime-mismatch-kernels")
               (:file "runtime-set-kernels")
               (:file "runtime-character-sequence-kernels")
               (:file "runtime-package-kernels")
               (:file "runtime-package-entry-kernels")
               (:file "runtime-tree-kernels")
               (:file "runtime-format-kernels")
               (:file "runtime-array-type-kernels")
               (:file "runtime-stream-sequence-kernels")
               (:file "runtime-integer-type-kernels")
               (:file "runtime-clos-method-kernels")
               (:file "runtime-real-type-kernels")
               (:file "runtime-array-upgrade-kernels")
               (:file "runtime-clos-initarg-kernels")
               (:file "runtime-complex-type-kernels")
               (:file "runtime-generic-dispatch-kernels")
               (:file "runtime-compound-type-kernels")
               (:file "runtime-array-adjust-kernels")
               (:file "cross-compiler")))

(asdf:defsystem #:miricl
  :author "Ákos Kiss <ak@coram.pub>"
  :license "LGPL-3.0-or-later"
  :serial t
  :depends-on (#:miricl/cross
               #:cffi)
  :components ((:file "wasmtime")
               (:file "runtime-dsl")
               (:file "runtime-library")
               (:file "runtime-objects")
               (:file "runtime-vectors")
               (:file "runtime-arrays")
               (:file "runtime-bit-arrays")
