;;;; miricl.asd

(asdf:defsystem #:miricl
  :author "Ákos Kiss <ak@coram.pub>"
  :license "LGPL-3.0-or-later"
  :serial t
  :depends-on (#:alexandria
               #:cffi
               #:named-readtables)
  :components ((:file "package")
               (:file "wasmtime")
               (:file "miricl-readtables")
               (:file "runtime-bootstrap")
               (:file "runtime-dsl")
               (:file "runtime-library")
               (:file "runtime-objects")
               (:file "runtime-vectors")
               (:file "runtime-arrays")
               (:file "runtime-bit-arrays")
               (:file "runtime-array-adjust")
               (:file "runtime-readtables")
               (:file "runtime-pprint")
               (:file "runtime-print-circle")
               (:file "runtime-lists")
               (:file "runtime-numbers")
               (:file "runtime-transcendentals")
               (:file "runtime-elementary-functions")
               (:file "runtime-inverse-functions")
               (:file "runtime-rounding")
               (:file "runtime-random")
               (:file "runtime-float-properties")
               (:file "runtime-bits")
               (:file "runtime-byte-fields")
               (:file "runtime-hash")
               (:file "runtime-strings")
               (:file "runtime-characters")
               (:file "runtime-symbols")
               (:file "runtime-symbol-functions")
               (:file "runtime-values")
               (:file "runtime-packages")
               (:file "runtime-types")
               (:file "runtime-derived-types")
               (:file "runtime-integer-types")
               (:file "runtime-real-types")
               (:file "runtime-array-types")
               (:file "runtime-complex-types")
               (:file "runtime-environment")
               (:file "runtime-conditions")
               (:file "runtime-eval")
               (:file "runtime-loop")
               (:static-file "clos-library.lisp")
               (:static-file "method-combination-library.lisp")
               (:static-file "development-library.lisp")
               (:static-file "pathname-library.lisp")
               (:static-file "logical-pathname-library.lisp")
               (:static-file "filesystem-library.lisp")
               (:static-file "time-library.lisp")
               (:static-file "compiler-library.lisp")
               (:static-file "file-compiler-library.lisp")
               (:static-file "evaluation-library.lisp")
               (:file "fasl-utilities")
               (:file "fasl-format")
               (:file "whole-program")
               (:file "hir")
               (:file "wasm-compiler")
               (:file "wasm-optimizer")
               (:file "wasm-module-optimizer")
               (:static-file "environment-library.lisp")
               (:static-file "pretty-library.lisp")
               (:static-file "javascript-library.lisp")
               (:static-file "thread-library.lisp")
               (:static-file "bundle-library.lisp")
               (:file "runtime-clos")
               (:file "runtime-generic-functions")
               (:file "runtime-development")
               (:file "runtime-fasl-codec")
               (:file "runtime-native-code")
               (:file "runtime-sequences")
               (:file "runtime-list-operations")
               (:file "runtime-tree-operations")
               (:file "runtime-sequence-construction")
               (:file "runtime-sequence-removal")
               (:file "runtime-sequence-duplicates")
               (:file "runtime-sequence-search")
               (:file "runtime-sequence-comparison")
               (:file "runtime-sequence-ordering")
               (:file "runtime-sequence-binding")
               (:file "runtime-sequence-reduce")
               (:file "runtime-apply")
               (:file "runtime-backtrace")
               (:file "runtime-io")
               (:file "runtime-text-codec")
               (:file "runtime-text-number")
               (:file "runtime-text-labels")
               (:file "runtime-text-reader")
               (:file "runtime-text-arrays")
               (:file "runtime-text-printer")
               (:file "runtime-text")
               (:file "runtime-format")
               (:file "runtime-reporting")
               (:file "runtime-input-streams")
               (:file "runtime-stream-sequences")
               (:file "runtime-constructed-streams")
               (:file "runtime-files")
               (:file "runtime-file-host")
               (:file "runtime-time")
               (:file "runtime-javascript")
               (:file "runtime-threads")
               (:file "runtime-wasi")
               (:file "runtime-thread-native")
               (:file "runtime")
               (:file "scripts/repl-websocket")
               (:file "scripts/repl-filesystem")
               (:file "scripts/repl-http")
               (:file "scripts/repl-console")
               (:file "scripts/repl-bridge")
               (:file "scripts/repl-host-filesystem")
               (:file "scripts/repl-terminal")
               (:file "scripts/repl-command")
               (:file "runtime-compiler-image")
               (:file "miricl")
               (:file "interpreter-reader"))
  :in-order-to ((test-op (test-op "miricl/test"))))

(asdf:defsystem #:miricl/test
  :serial t
  :depends-on (#:miricl
               #:fiveam)
  :components ((:file "miricl-test") (:file "wasm-optimizer-test") (:file "float-properties-test") (:file "transcendental-test") (:file "derived-type-test") (:file "package-test") (:file "symbol-test")
               (:file "condition-test") (:file "format-loop-test") (:file "clos-test")
               (:file "development-test") (:file "sequence-test") (:file "character-test")
               (:file "equality-test") (:file "integer-bit-test") (:file "hash-test")
               (:file "sequence-duplicates-test") (:file "sequence-substitution-test")
               (:file "sequence-comparison-test") (:file "reader-labels-test")
               (:file "tree-test")
               (:file "sequence-ordering-test")
               (:file "rounding-test")
               (:file "random-test")
               (:file "time-test")
               (:file "string-parsing-test")
               (:file "byte-fields-test") (:file "vector-test") (:file "array-test") (:file "bit-array-test") (:file "readtable-test") (:file "pprint-test") (:file "stream-test") (:file "filesystem-test"))
  :perform (test-op (o c)
             (let ((results (symbol-call :fiveam '#:run :miricl)))
               (unless results
                 (error "miricl suite executed no checks."))
               (unless (symbol-call :fiveam '#:explain! results)
                 (error "miricl tests failed.")))))

(asdf:defsystem #:miricl/*
  :depends-on (#:miricl
               #:miricl/test))
