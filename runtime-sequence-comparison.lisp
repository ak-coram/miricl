  #@(local.set $count2 (i32.sub (local.get $stop2) (local.get $first2)))
  #@(local.set $left (select (local.get $count1) (local.get $count2) (i32.lt_u (local.get $count1) (local.get $count2))))
  #@(local.set $i (select (i32.sub (local.get $stop1) (i32.const 1)) (local.get $first1) (local.get $reverse)))
  #@(local.set $j (select (i32.sub (local.get $stop2) (i32.const 1)) (local.get $first2) (local.get $reverse)))
  #@(local.set $step (select (i32.const -1) (i32.const 1) (local.get $reverse)))
  #@(if (local.get $left)
    (then
      (if (i32.and (ref.is_null (local.get $key))
          (i32.and (i32.eq (call $tag (local.get $a)) (i32.const 10))
                   (i32.eq (call $tag (local.get $b)) (i32.const 10))))
        (then (local.set $fast (call $sequence-character-kind (local.get $function)))))
      (local.set $list1 (i32.eqz (call $arrayp-native (local.get $a))))
      (local.set $list2 (i32.eqz (call $arrayp-native (local.get $b))))
      (local.set $scan1 (local.get $a)) (local.set $scan2 (local.get $b))
      (if (local.get $list1)
        (then
          (block $positioned (loop $skip (br_if $positioned (i32.eq (local.get $skip) (local.get $first1)))
            (local.set $scan1 (call $cdr (local.get $scan1)))
            (local.set $skip (i32.add (local.get $skip) (i32.const 1))) (br $skip)))
          (if (local.get $reverse)
            (then (local.set $buffer1 (call $sequence-list-buffer (local.get $scan1) (local.get $count1)))))))
      (local.set $skip (i32.const 0))
      (if (local.get $list2)
        (then
          (block $positioned (loop $skip (br_if $positioned (i32.eq (local.get $skip) (local.get $first2)))
            (local.set $scan2 (call $cdr (local.get $scan2)))
            (local.set $skip (i32.add (local.get $skip) (i32.const 1))) (br $skip)))
          (if (local.get $reverse)
            (then (local.set $buffer2 (call $sequence-list-buffer (local.get $scan2) (local.get $count2)))))))))
  #@(block $done (loop $next (br_if $done (i32.eqz (local.get $left)))
    (if (local.get $fast)
      (then
        (local.set $code1 (array.get $digits (struct.get $obj $digits (local.get $a)) (local.get $i)))
        (local.set $code2 (array.get $digits (struct.get $obj $digits (local.get $b)) (local.get $j)))
        (if (i32.eq (local.get $fast) (i32.const 3))
          (then (local.set $code1 (call $string-upcase-code (local.get $code1)))
            (local.set $code2 (call $string-upcase-code (local.get $code2)))))
        (local.set $match (i32.xor (i32.eq (local.get $code1) (local.get $code2)) (local.get $negate))))
      (else
        (local.set $value1 (if (result (ref null $obj)) (local.get $list1)
          (then (call $car (if (result (ref null $obj)) (local.get $reverse)
            (then (array.get $objects (local.get $buffer1) (i32.sub (local.get $i) (local.get $first1))))
            (else (local.get $scan1)))))
          (else (call $sequence-value (local.get $a) (local.get $i)))))
        (local.set $value2 (if (result (ref null $obj)) (local.get $list2)
          (then (call $car (if (result (ref null $obj)) (local.get $reverse)
            (then (array.get $objects (local.get $buffer2) (i32.sub (local.get $j) (local.get $first2))))
            (else (local.get $scan2)))))
          (else (call $sequence-value (local.get $b) (local.get $j)))))
        (local.set $value1 (call $sequence-key-value (local.get $key) (local.get $value1)))
        (local.set $match (call $sequence-item-match (i32.const 0) (local.get $value1) (local.get $value2)
          (local.get $key) (local.get $function) (local.get $negate)))))
    (if (i32.eqz (local.get $match))
      (then (call $clear-values) (return (call $int (i32.add (local.get $i) (local.get $reverse))))))
    (if (i32.eqz (local.get $reverse))
      (then
        (if (local.get $list1) (then (local.set $scan1 (call $cdr (local.get $scan1)))))
        (if (local.get $list2) (then (local.set $scan2 (call $cdr (local.get $scan2)))))))
    (local.set $i (i32.add (local.get $i) (local.get $step)))
    (local.set $j (i32.add (local.get $j) (local.get $step)))
