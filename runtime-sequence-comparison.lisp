  #@(call $clear-values)
  #@(if (i32.eq (local.get $count1) (local.get $count2)) (then (return (ref.null $obj))))
  #@(call $int (i32.add (local.get $i) (local.get $reverse))))

;; KMP is valid for the standard character equivalence relations. Arbitrary
;; callbacks retain ordinary pairwise matching, without assuming transitivity.
(define-runtime-function $search-characters
    (($pattern :digits) ($source :digits) ($first1 i32) ($stop1 i32) ($first2 i32) ($stop2 i32)
     ($fold i32) ($reverse i32)) (:nullable-object)
  (:locals ($length i32) ($i i32) ($j i32) ($code i32) ($result i32) ($left i32) ($step i32)
           ($table :digits) ($copy :digits))
  #@(local.set $length (i32.sub (local.get $stop1) (local.get $first1)))
  #@(if (i32.eq (local.get $length) (i32.const 1))
    (then
      (local.set $code (array.get $digits (local.get $pattern) (local.get $first1)))
      (if (local.get $fold) (then (local.set $code (call $string-upcase-code (local.get $code)))))
      (local.set $result (call $sequence-character-scan (local.get $source) (local.get $first2) (local.get $stop2)
        (local.get $code) (local.get $fold) (i32.const 0) (local.get $reverse) (i32.const 0)))
      (if (i32.lt_s (local.get $result) (i32.const 0)) (then (return (ref.null $obj))))
      (return (call $int (local.get $result)))))
  #@(if (i32.or (local.get $fold) (local.get $reverse))
    (then
      (local.set $copy (array.new_default $digits (local.get $length)))
      (block $folded (loop $next (br_if $folded (i32.eq (local.get $i) (local.get $length)))
        (local.set $code (array.get $digits (local.get $pattern)
          (select (i32.sub (i32.sub (local.get $stop1) (i32.const 1)) (local.get $i))
            (i32.add (local.get $first1) (local.get $i)) (local.get $reverse))))
        (if (local.get $fold) (then (local.set $code (call $string-upcase-code (local.get $code)))))
        (array.set $digits (local.get $copy) (local.get $i) (local.get $code))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (local.set $pattern (local.get $copy)) (local.set $first1 (i32.const 0))))
  #@(local.set $table (array.new_default $digits (local.get $length)))
  #@(local.set $i (i32.const 1))
  #@(block $built (loop $prefix (br_if $built (i32.eq (local.get $i) (local.get $length)))
    (local.set $code (array.get $digits (local.get $pattern) (i32.add (local.get $first1) (local.get $i))))
    (block $ready (loop $fallback
      (br_if $ready (i32.eqz (local.get $j)))
      (br_if $ready (i32.eq (local.get $code) (array.get $digits (local.get $pattern) (i32.add (local.get $first1) (local.get $j)))))
      (local.set $j (array.get $digits (local.get $table) (i32.sub (local.get $j) (i32.const 1)))) (br $fallback)))
    (if (i32.eq (local.get $code) (array.get $digits (local.get $pattern) (i32.add (local.get $first1) (local.get $j))))
      (then (local.set $j (i32.add (local.get $j) (i32.const 1)))))
    (array.set $digits (local.get $table) (local.get $i) (local.get $j))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $prefix)))
  #@(local.set $j (i32.const 0))
  #@(local.set $i (select (i32.sub (local.get $stop2) (i32.const 1)) (local.get $first2) (local.get $reverse)))
  #@(local.set $step (select (i32.const -1) (i32.const 1) (local.get $reverse)))
  #@(local.set $left (i32.sub (local.get $stop2) (local.get $first2)))
  #@(block $done (loop $scan (br_if $done (i32.eqz (local.get $left)))
    (local.set $code (array.get $digits (local.get $source) (local.get $i)))
    (if (local.get $fold) (then (local.set $code (call $string-upcase-code (local.get $code)))))
    (block $ready (loop $fallback
      (br_if $ready (i32.eqz (local.get $j)))
      (br_if $ready (i32.eq (local.get $code) (array.get $digits (local.get $pattern) (i32.add (local.get $first1) (local.get $j)))))
      (local.set $j (array.get $digits (local.get $table) (i32.sub (local.get $j) (i32.const 1)))) (br $fallback)))
    (if (i32.eq (local.get $code) (array.get $digits (local.get $pattern) (i32.add (local.get $first1) (local.get $j))))
      (then (local.set $j (i32.add (local.get $j) (i32.const 1)))))
