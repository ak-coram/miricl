;;;; Reentrant compiled loading keeps the outer literal graph and unit context.
(progn
(defclass startup-load-probe () ((value :initarg :value :reader startup-load-value)))
(defvar *startup-load-events* nil)
(defvar *startup-load-fail* nil)
(defmethod make-load-form ((object startup-load-probe) &optional environment)
  (declare (ignore object environment))
  (values
    '(progn
       (load "/startup-context-inner.wasm" :verbose nil)
       (make-instance 'startup-load-probe :value :loaded))
    nil))
(unwind-protect
    (progn
      (with-open-file (stream "/startup-context-inner.lisp" :direction :output :if-exists :supersede)
        (write-string "(when *startup-load-fail* (error \"Nested load fixture failure.\"))
(push :inner *startup-load-events*) (values)" stream))
      (with-open-file (stream "/startup-context-outer.lisp" :direction :output :if-exists :supersede)
        (write-string "(defparameter *startup-load-graph*
  '#.(let ((shared (list :shared))
           (object (make-instance 'startup-load-probe :value :compile-time)))
       (setf (cdr shared) shared)
       (vector shared object shared #(1 2 3))))
(push :outer *startup-load-events*) (values)" stream))
      (compile-file "/startup-context-inner.lisp" :output-file "/startup-context-inner.wasm" :verbose nil)
      (compile-file "/startup-context-outer.lisp" :output-file "/startup-context-outer.wasm" :verbose nil)
      (setq *startup-load-fail* t)
      (unless (handler-case (progn (load "/startup-context-outer.wasm" :verbose nil) nil)
                (error () t))
        (error "The nested load fixture did not signal its requested failure."))
      (setq *startup-load-fail* nil)
      (setq *startup-load-events* nil)
      (load "/startup-context-outer.wasm" :verbose nil)
      (let* ((first *startup-load-graph*)
             (valid (and (eq (svref first 0) (svref first 2))
                      (eq (cdr (svref first 0)) (svref first 0))
                      (eq (startup-load-value (svref first 1)) :loaded)
                      (equalp (svref first 3) #(1 2 3))
                      (equal *startup-load-events* '(:outer :inner)))))
        (load "/startup-context-outer.wasm" :verbose nil)
        (unless (and valid (not (eq first *startup-load-graph*))
                     (eq (svref *startup-load-graph* 0) (svref *startup-load-graph* 2))
                     (eq (cdr (svref *startup-load-graph* 0)) (svref *startup-load-graph* 0))
                     (eq (startup-load-value (svref *startup-load-graph* 1)) :loaded)
                     (equalp (svref *startup-load-graph* 3) #(1 2 3))
                     (equal *startup-load-events* '(:outer :inner :outer :inner)))
          (error "Nested compiled LOAD failed to preserve the outer unit's literal graph.")))
      t)
  (dolist (file '("/startup-context-inner.lisp" "/startup-context-inner.wasm"
                  "/startup-context-outer.lisp" "/startup-context-outer.wasm"))
    (when (probe-file file) (delete-file file)))
  (setq *startup-load-fail* nil))
 t)
