;;;; Reporting adapter only: upstream INIT and RT remain unmodified.
(defpackage :miricl-ansi-runner (:use :cl))
(in-package :miricl-ansi-runner)
(defvar *origins* (make-hash-table :test 'equal))
(defvar *cursor* 0)
(defvar *loading-files* nil)
(setq *default-pathname-defaults* #P"/ansi/")

;; Install a registration observer after RT loads. Preserve LOAD's multiple
;; values and all its dynamic bindings, and restore both functions afterwards.
(let ((load-function #'load) (add-function nil) (add-symbol nil))
  (unwind-protect
    (progn
      (setf (symbol-function 'load)
        (lambda (file &rest options)
          (push file *loading-files*)
          (multiple-value-prog1 (apply load-function file options)
            (pop *loading-files*)
            (let ((rt (find-package "REGRESSION-TEST")))
              (when (and rt (not add-function))
                (setq add-symbol (find-symbol "ADD-ENTRY" rt))
                (when (and add-symbol (fboundp add-symbol))
                  (setq add-function (symbol-function add-symbol))
                  (let ((name-function (symbol-function (find-symbol "NAME" rt))))
                    (setf (symbol-function add-symbol)
                      (lambda (entry)
                        (setf (gethash (funcall name-function entry) *origins*)
                          (and *load-truename* (namestring *load-truename*)))
                        (funcall add-function entry))))))))))
      (let ((*package* (find-package "CL-USER"))) (load "init.lsp")))
    (setf (symbol-function 'load) load-function)
    (when add-function (setf (symbol-function add-symbol) add-function))))

(defvar *entries* (coerce (cdr rt::*entries*) 'vector))
(defun json-string (text)
  (write-char #\")
  (loop for char across text do
    (case char
      (#\" (write-string "\\\""))
      (#\\ (write-string "\\\\"))
      (otherwise (if (< (char-code char) 32)
                   (format t "\\u~4,'0X" (char-code char)) (write-char char)))))
  (write-char #\"))
(defun print-plan ()
  (let ((*package* (find-package "CL-USER")) (*print-case* :upcase)
        (*print-base* 10) (*print-radix* nil) (*print-circle* t))
    (write-char #\[)
    (loop for entry across *entries* for first = t then nil do
      (unless first (write-char #\,))
      (write-string "{\"name\":")
      (json-string (write-to-string (rt::name entry)))
      (write-string ",\"file\":")
      (json-string (or (gethash (rt::name entry) *origins*) "unknown"))
      (when (eq (rt::name entry) 'cl-test::get-universal-time.3)
        (write-string ",\"minimumTimeout\":7000"))
      (write-char #\}))
    (write-char #\]))
  (values))
(defun run-next-test ()
  (let ((entry (aref *entries* *cursor*))
        (*package* (find-package "CL-TEST"))
        (*default-pathname-defaults* rt::*sandbox-path*))
    ;; Advance before evaluation so an interrupted test does not repeat.
    (incf *cursor*)
    (if (rt::do-entry entry) :pass :fail)))
(values)
