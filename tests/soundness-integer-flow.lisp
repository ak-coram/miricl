;; Scalar snapshots survive the backedge, user callbacks and numeric promotion.
(loop for (speed space) in '((1 2) (3 1))
      always
  (let* ((sum
           (miricl-compiler:compile-native
             `(lambda (array count seed before after)
                (declare (type (vector fixnum) array) (type (integer 0 8) count)
                         (integer seed) (optimize (speed ,speed) (space ,space) (safety 1)))
                (let ((total seed))
                  (declare (integer total))
                  (dotimes (i count (values total :done))
                    (funcall before i)
                    (setq total (+ total (let ((saved (aref array i)))
                                           (funcall after i)
                                           saved))))))))
         (delta
           (miricl-compiler:compile-native
             `(lambda (count seed step)
                (declare (type (integer 0 8) count) (integer seed step)
                         (optimize (speed ,speed) (space ,space) (safety 1)))
                (let ((total seed))
                  (declare (integer total))
                  (dotimes (i count total)
                    (setq total (- total step)))))))
         (sum-codes
           (miricl-compiler:compile-native
             `(lambda (string count seed)
                (declare (type string string) (type (integer 0 8) count) (integer seed)
                         (optimize (speed ,speed) (space ,space) (safety 1) (debug 0)))
                (let ((total seed))
                  (declare (integer total))
                  (dotimes (i count total)
                    (setq total (+ total (char-code (char string i)))))))))
         (text (copy-seq "aλz"))
         (substring (make-array 2 :element-type 'character :displaced-to text :displaced-index-offset 1))
         (owned (make-array 3 :element-type 'fixnum :initial-contents '(1 2 -2)))
         (other (make-array 4 :element-type 'fixnum :initial-contents '(0 30 40 50)))
         (view (make-array 3 :element-type 'fixnum :adjustable t :displaced-to owned))
         (events nil)
         (before (lambda (i) (push (list :before i) events) (values :ignored :extra)))
         (after (lambda (i) (push (list :after i) events) (values :also-ignored :extra)))
         (change (lambda (i)
                   (funcall after i)
                   (when (zerop i) (adjust-array view 3 :displaced-to other :displaced-index-offset 1)))))
    (and (equal (multiple-value-list (funcall sum owned 3 9223372036854775807 before after))
                '(9223372036854775808 :done))
         (equal (multiple-value-list (funcall sum owned 2 1073741823 before after))
                '(1073741826 :done))
         (= (funcall delta 2 -9223372036854775808 3) -9223372036854775814)
         (= (funcall sum-codes text 3 0) (reduce #'+ text :key #'char-code))
         (= (funcall sum-codes substring 2 1) (reduce #'+ substring :key #'char-code :initial-value 1))
         (progn
           (setq events nil)
           (equal (multiple-value-list (funcall sum view 2 0 before change)) '(41 :done)))
         (equal (reverse events) '((:before 0) (:after 0) (:before 1) (:after 1)))
         (handler-case (progn (funcall sum view 4 0 before after) nil) (error () t))
         (equal (multiple-value-list (funcall sum view 1 8 before after)) '(38 :done)))))
