;;;; Compare generated RT definitions across implementations without depending
;;;; on implementation-specific character names in their generated test names.
(in-package :cl-user)

(defun %ansi-test-key (object)
  (let ((*print-base* 10) (*print-radix* nil) (*print-readably* nil) (*print-pretty* nil)
        (remaining 2048) (characters-left 16384))
    (with-output-to-string (stream)
      (labels ((emit-string (value)
                 (decf characters-left (length value))
                 (when (minusp characters-left) (return-from %ansi-test-key nil))
                 (write-char #\" stream)
                 (loop for char across value do
                   (when (or (char= char #\") (char= char #\\)) (write-char #\\ stream))
                   (write-char char stream))
                 (write-char #\" stream))
               (emit (value depth)
                 (when (or (> depth 256) (minusp (decf remaining)))
                   (return-from %ansi-test-key nil))
                 (cond
                   ((null value) (write-char #\N stream))
                   ((symbolp value)
                    ;; Uninterned symbol identity cannot be captured by names.
                    (unless (symbol-package value) (return-from %ansi-test-key nil))
                    (write-char #\S stream)
                    (emit-string (package-name (symbol-package value)))
                    (emit-string (symbol-name value)))
                   ((characterp value)
                    (write-char #\C stream) (prin1 (char-code value) stream)
                    (write-char #\; stream))
                   ((integerp value)
                    (when (> (integer-length value) 4096) (return-from %ansi-test-key nil))
                    (write-char #\I stream) (prin1 value stream) (write-char #\; stream))
                   ((stringp value)
                    (write-char #\T stream) (emit-string value))
                   ((consp value)
                    (write-char #\( stream) (emit (car value) (1+ depth))
                    (write-char #\. stream) (emit (cdr value) (1+ depth))
                    (write-char #\) stream))
                   (t (return-from %ansi-test-key nil)))))
        (emit object 0)))))

(defun %ansi-entry-for (name-string key &optional excluded)
  (let ((name (ignore-errors (read-from-string name-string))))
    (when (and name (gethash name rt::*entries-table*))
      (return-from %ansi-entry-for (rt::get-entry name)))
    (when key
      (let ((match nil))
        (dolist (entry (cdr rt::*entries*))
          (when (and (not (member entry excluded :test #'eq))
                     (equal key (%ansi-test-key (list (rt::form entry) (rt::vals entry)))))
            ;; Ambiguous definitions must remain unmatched.
            (when match (return-from %ansi-entry-for nil))
            (setf match entry)))
        match))))

(defun %ansi-entry-index (excluded)
  (let ((index (make-hash-table :test 'equal)))
    (dolist (entry (cdr rt::*entries*))
      (unless (member (rt::name entry) excluded :test #'equal)
        (let ((key (%ansi-test-key (list (rt::form entry) (rt::vals entry)))))
          (when key
            (setf (gethash key index) (if (gethash key index) t entry))))))
    index))
