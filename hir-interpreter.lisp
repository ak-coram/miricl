;;;; Lower the compiler's semantic HIR to the interpreter's compact code.
(in-package :miricl-compiler)

(defun hir-code-parameters (parameters)
  ;; Defaults and AUX initializers are already code, not executable metadata.
  (copy-hir-parameters
    (mapcar (lambda (parameter)
              (if (consp parameter)
                  (if (consp (first parameter)) (list (first parameter)) (first parameter))
                  parameter)) parameters)))

(defun hir-code-debug-sites (function register)
  (let ((sites nil) (indices (make-hash-table :test 'eq)) (count 0))
    (dolist (block (hir-function-blocks function))
      (dolist (instruction (hir-block-instructions block))
        (when (member (hir-instruction-opcode instruction) '(:debug-step :debug-resume))
          (let ((site (first (hir-instruction-attributes instruction))))
            (when site
              (unless (eq (hir-debug-site-owner site) function)
                (hir-code-error site "debug site belongs to another function"))
              (unless (gethash site indices)
                (setf (gethash site indices) (1+ count)) (incf count) (push site sites)))))))
    (labels ((capture (identity)
               (or (position identity (hir-function-captures function))
                   (hir-code-error identity "visible debug binding was not captured")))
             (scope (site)
               (let ((result nil))
                 (dolist (entry (hir-debug-site-variables site))
                   (let* ((binding (cdr entry)) (special (hir-binding-special-p binding))
                          (local (eq (hir-binding-owner binding) function)))
                     (setq result (nconc result
                       (list (cond (special 4) (local 0) (t 1))
                         (cond (special 0) (local (funcall register (hir-binding-cell binding))) (t (capture binding)))
                         (car entry) (let ((type (assoc binding (hir-debug-site-types site))))
                                       (if type (copy-hir-debug-type-checked (cdr type)) t)))))))
                 (dolist (entry (hir-debug-site-functions site))
                   (let* ((binding (cdr entry)) (local (eq (hir-binding-owner binding) function)))
                     (setq result (nconc result
                       (list (if local 2 3) (if local (funcall register (hir-binding-cell binding)) (capture binding))
                         (hir-code-name (car entry)) t)))))
                 (dolist (entry (hir-debug-site-targets site))
                   (let* ((target (cdr entry)) (local (eq (hir-target-owner target) function))
                          (tag (consp (car entry))))
                     (setq result (nconc result
                       (list (if tag (if local 7 8) (if local 5 6))
                         (if local (funcall register (hir-target-token target)) (capture target))
                         (hir-target-name target) t)))))
                 (dolist (entry (hir-debug-site-macros site))
                   (setq result (nconc result (list (first entry) 0 (second entry) (third entry)))))
                 (coerce result 'simple-vector))))
      (values
        (coerce (loop for site in (nreverse sites) collect
          (vector (hir-debug-site-kind site) (hir-debug-site-operator site)
            (if (hir-debug-site-value site) (1+ (funcall register (hir-debug-site-value site))) 0)
            (if (hir-debug-site-parent site) (or (gethash (hir-debug-site-parent site) indices)
                                              (hir-code-error site "missing debug parent")) 0)
            (scope site)
            (loop for parent = (hir-debug-site-parent site) then (hir-debug-site-parent parent)
                  while parent count t) (hir-debug-site-form site))) 'simple-vector)
        indices))))

(defun hir-code-debug-info (function register &optional aliases)
  (vector
    (coerce (loop for binding in (hir-function-bindings function)
                  when (hir-binding-cell binding)
                    append (list (funcall register (hir-binding-cell binding)) (hir-code-name (hir-binding-name binding))
                             (+ (if (hir-binding-local binding) 1 0)
                                (if (and aliases (>= (svref aliases (hir-value-id (hir-binding-cell binding))) 0)) 2 0))))
      'simple-vector)
    (coerce (loop for identity in (hir-function-captures function)
                  append (if (%hir-binding-p identity)
                    (list (hir-code-name (hir-binding-name identity)) (if (hir-binding-local identity) 1 0))
                    (list (hir-target-name identity) 2))) 'simple-vector)))

(defun hir-code-cell-aliases (function captured)
  ;; Prove from actual uses, not mutable record flags, that a cell has no
  ;; observable identity and never changes. Typed reads may carry a stronger
  ;; scoped assertion; retain those rather than moving that fact to its input.
  (let* ((count (hir-function-value-count function))
         (candidates (make-array count :initial-element nil))
         (reads (make-array count :initial-element nil))
         (aliases (make-array count :initial-element -1)))
    (when (>= (hir-function-debug-level function) 3) (return-from hir-code-cell-aliases aliases))
    (dolist (value (hir-function-values function))
      (let ((producer (hir-value-producer value)))
        (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :cell-new)
                   (not (gethash value captured)))
          (setf (svref candidates (hir-value-id value)) t))))
    (dolist (block (hir-function-blocks function))
      (dolist (instruction (cons (hir-block-terminator block) (hir-block-instructions block)))
        (loop for input in (hir-instruction-inputs instruction) for position from 0 do
          (let ((id (hir-value-id input)))
            (if (and (zerop position) (eq (hir-instruction-opcode instruction) :cell-read))
                (push instruction (svref reads id))
                (setf (svref candidates id) nil))))))
    (dolist (value (hir-function-values function))
      (let ((id (hir-value-id value)))
        (when (svref candidates id)
          (let* ((initial (first (hir-instruction-inputs (hir-value-producer value))))
                 (initial-type (hir-value-type initial)) (all t))
            (dolist (read (svref reads id))
              (let ((output (hir-instruction-output read)))
                (if (and output (not (hir-value-declaration output))
                         (or (eq (hir-value-type output) t) (equal (hir-value-type output) initial-type)))
                    (setf (svref aliases (hir-value-id output)) (hir-value-id initial))
                    (setq all nil))))
            (when all (setf (svref aliases id) (hir-value-id initial)))))))
    aliases))

(defun hir-code-register (value plans)
  (let* ((function (hir-value-owner value)) (plan (gethash function plans))
         (aliases (svref plan 0)) (indices (svref plan 1)) (id (hir-value-id value)) (remaining (length aliases)))
    (loop while (>= (svref aliases id) 0) do
      (when (minusp (decf remaining)) (hir-code-error id "circular HIR value aliases"))
      (setq id (svref aliases id)))
    (svref indices id)))

(defun hir-code-single-calls (function)
  ;; A call may return arbitrary values. Avoid materializing the value group
  ;; only when every use discards all but the primary value, and no scoped
  ;; result assertion would be lost by removing that projection.
  (let ((single (make-array (hir-function-value-count function) :initial-element nil)))
    (when (>= (hir-function-debug-level function) 3) (return-from hir-code-single-calls single))
    (dolist (value (hir-function-values function))
      (let ((producer (hir-value-producer value)))
        (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :call)
                   (eq (hir-value-type value) t))
          (setf (svref single (hir-value-id value)) t))))
    (dolist (block (hir-function-blocks function))
      (dolist (instruction (cons (hir-block-terminator block) (hir-block-instructions block)))
        (loop for input in (hir-instruction-inputs instruction) for index from 0 do
          (unless (and (eq (hir-instruction-opcode instruction) :primary) (zerop index)
                       (hir-instruction-output instruction)
                       (eq (hir-value-type (hir-instruction-output instruction)) t))
            (setf (svref single (hir-value-id input)) nil)))))
    single))

(defun hir-code-scope-aliases (function captured aliases)
  ;; Uncaptured lexical exits need no runtime target. Derive escape facts
  ;; from captures and uses rather than trusting mutable target flags.
  (declare (type simple-vector function aliases) (type hash-table captured))
  (when (>= (hir-function-debug-level function) 2)
    (return-from hir-code-scope-aliases nil))
  (let ((candidates (make-array (length aliases) :initial-element nil)))
    (declare (type simple-vector candidates))
    (dolist (value (hir-function-values function))
      (declare (type simple-vector value))
      (let ((producer (hir-value-producer value)))
        (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :block-enter)
                   (eq (hir-value-type value) t) (not (gethash value captured)))
          (setf (svref candidates (hir-value-id value)) t))))
    (dolist (block (hir-function-blocks function))
      (declare (type simple-vector block))
      (dolist (instruction (cons (hir-block-terminator block) (hir-block-instructions block)))
        (declare (type simple-vector instruction))
        (loop for input in (hir-instruction-inputs instruction) for position from 0 do
          (when (and (svref candidates (hir-value-id input))
                     (not (case (hir-instruction-opcode instruction)
                            (:block-environment (and (zerop position)
                              (eq (hir-value-type (hir-instruction-output instruction)) t)))
                            (:block-return (and (= position 1) (hir-instruction-attributes instruction))))))
            (setf (svref candidates (hir-value-id input)) nil)))))
    (dolist (value (hir-function-values function))
      (declare (type simple-vector value))
      (let ((producer (hir-value-producer value)))
        (when (%hir-instruction-p producer)
          (let ((input (first (hir-instruction-inputs producer))))
            (when (or (svref candidates (hir-value-id value))
                      (and (eq (hir-instruction-opcode producer) :block-environment)
                           (svref candidates (hir-value-id input))))
              (setf (svref aliases (hir-value-id value)) (hir-value-id input)))))))))

(defun emit-hir-code (unit)
  "Emit a portable wire payload from caller-owned HIR."
  (declare (optimize (safety 3)))
  (verify-hir unit)
  (emit-hir-code-checked unit))

(defun emit-hir-code-checked (unit &optional executable-p)
  ;; UNIT is exclusively compiler-owned or has just crossed a checked public
  ;; boundary. Executable descriptors never escape through the wire API.
  (let* ((functions (hir-unit-functions unit)) (indices (make-hash-table :test 'eq))
         (literals (make-array 0 :adjustable t :fill-pointer 0))
         (literal-indices (make-hash-table :test 'eq))
         (descriptors (make-array (length functions)))
         (fixed-call-base (position-if (lambda (spec)
           (and (eq (first spec) :call-primary) (eql (second spec) (third spec))))
           *hir-code-operations*))
         (debug-sites (make-hash-table :test 'eq))
         (plans (make-hash-table :test 'eq)) (captured (make-hash-table :test 'eq)))
    (loop for function in functions for i from 0 do (setf (gethash function indices) i))
    (dolist (function functions)
      (dolist (identity (hir-function-captures function))
        (setf (gethash (if (%hir-binding-p identity) (hir-binding-cell identity)
                          (hir-target-token identity)) captured) t)))
    (dolist (function functions)
      (let* ((aliases (hir-code-cell-aliases function captured))
             (single (hir-code-single-calls function))
             (registers (make-array (length aliases) :initial-element -1)) (count 0))
        (hir-code-scope-aliases function captured aliases)
        (dolist (value (hir-function-values function))
          (let ((producer (hir-value-producer value)))
            (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :primary)
                       (svref single (hir-value-id (first (hir-instruction-inputs producer)))))
              (setf (svref aliases (hir-value-id value))
                    (hir-value-id (first (hir-instruction-inputs producer)))))))
        (dotimes (id (length aliases))
          (when (minusp (svref aliases id)) (setf (svref registers id) count) (incf count)))
        (setf (gethash function plans) (vector aliases registers count single 0 nil 0))))
    (dolist (function functions)
      (multiple-value-bind (sites indices) (hir-code-debug-sites function (lambda (value) (hir-code-register value plans)))
        (setf (gethash function debug-sites) (cons sites indices))))
    (labels ((literal (object)
               (multiple-value-bind (index found) (gethash object literal-indices)
                 (if found index (setf (gethash object literal-indices) (vector-push-extend object literals)))))
             (register (value) (hir-code-register value plans))
             (block-code (block function)
               (let ((bytes (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
                 (labels ((word (n)
                            (unless (typep n '(unsigned-byte 31)) (hir-code-error n "operand exceeds 31 bits"))
                            (loop (vector-push-extend (code-char (logior (logand n 127) (if (> n 127) 128 0))) bytes)
                                  (setq n (ash n -7)) (when (zerop n) (return)))))
                   (dolist (instruction (append (hir-block-instructions block) (list (hir-block-terminator block))))
                     (let* ((opcode (hir-instruction-opcode instruction))
                            (inputs (hir-instruction-inputs instruction))
                            (output (hir-instruction-output instruction))
                            (attributes (hir-instruction-attributes instruction))
                            (local-exit (and (eq opcode :block-return) attributes
                              (>= (svref (svref (gethash (hir-value-owner (second inputs)) plans) 0)
                                         (hir-value-id (second inputs))) 0)))
                            (number (position (if local-exit :checked-jump opcode) *hir-code-operations* :key #'first))
                            (spec (and number (svref *hir-code-operations* number))))
                       (when local-exit (setq opcode :checked-jump inputs (cddr inputs)))
                       (unless number (hir-code-error opcode "unsupported opcode"))
                       (unless (eq (not (null output)) (not (null (fifth spec))))
                         (hir-code-error opcode "invalid instruction result"))
                       (unless (and output (>= (svref (svref (gethash (hir-value-owner output) plans) 0)
                                                              (hir-value-id output)) 0))
                       (when (eq opcode :function-reference)
                         (case (second attributes) (inline (setq number 35)) (notinline (setq number 36))))
                       (when (and (eq opcode :call)
                                  (svref (svref (gethash (hir-value-owner output) plans) 3) (hir-value-id output)))
                         (setq number (if (<= 2 (length inputs) 6)
                                          (+ fixed-call-base (- (length inputs) 2)) 37)
                               spec (svref *hir-code-operations* number)))
                       (when (and (eq opcode :call) (hir-instruction-attributes instruction))
                         (setq number (position (if (eq (first spec) :call-primary) :call-primary :call)
                                        *hir-code-operations* :key #'first :from-end t)
                               spec (svref *hir-code-operations* number)))
                       (let ((plan (gethash function plans)))
                         (setf (svref plan 4) (max (svref plan 4) (length inputs)))
                         (when (eq (first spec) :call-primary) (incf (svref plan 6)))
                         (when (eq opcode :block-enter)
                           (push (register output) (svref plan 5))
                           (push (hir-block-id (hir-target-block (first attributes))) (svref plan 5))))
                       (vector-push-extend (code-char (+ number (* 64 (hir-instruction-safety-level instruction)))) bytes)
                       (when output (word (register output)))
                       (unless (eql (second spec) (third spec)) (word (length inputs)))
                       (dolist (input inputs) (word (register input)))
                       (case opcode
                         ((:constant :function-reference :global-read :global-write :dynamic-bind)
                          (word (literal (first attributes))))
                         ((:argument :argument-present :rest-argument :dynamic-rest-argument :value-ref :capture :control-call :restart-signal
                           :check-apply-arguments :checked-argument)
                          (word (first attributes)))
                         (:check-arguments (word (first attributes)) (word (1+ (second attributes))))
                         ((:keyword-present :keyword-argument)
                          (word (first attributes)) (word (literal (second attributes))))
                         (:check-keywords
                          (word (first attributes))
                          (word (literal (copy-hir-keyword-check (rest attributes)))))
                         (:closure (word (gethash (first attributes) indices)))
                         (:block-enter (word (hir-block-id (hir-target-block (first attributes)))))
                         ((:branch :jump :checked-jump) (dolist (target attributes) (word (hir-block-id target))))
                         ((:debug-step :debug-resume)
                          (word (if (first attributes)
                            (or (gethash (first attributes) (cdr (gethash (hir-value-owner (hir-function-environment function)) debug-sites)))
                                (hir-code-error attributes "missing debug site")) 0)))
                         (:block-return (word (if attributes (1+ (hir-block-id (first attributes))) 0)))))))
                   (coerce bytes 'simple-string)))))
      (loop for function in functions for i from 0 do
        (let* ((plan (gethash function plans))
               (blocks (map 'vector (lambda (block)
                         (vector (if (hir-block-parameters block) (1+ (register (first (hir-block-parameters block)))) 0)
                           (if (hir-block-environment block) (1+ (register (hir-block-environment block))) 0)
                           (block-code block function))) (hir-function-blocks function)))
               (info (hir-code-debug-info function #'register (svref plan 0)))
               (debug (vector (svref info 0) (svref info 1) (car (gethash function debug-sites))))
               (types (coerce
                        (loop for value in (hir-function-values function)
                              for type = (hir-value-type value)
                              for declaration = (hir-value-declaration value)
                              unless (or (eq type t) (>= (svref (svref plan 0) (hir-value-id value)) 0))
                                append
                                ;; A complemented register marks a possible
                                ;; check on this observation. Keep the ordinary
                                ;; type entry independent of that check.
                                (nconc (when declaration
                                         (list (lognot (register value)) 'fixnum))
                                       (list (register value)
                                             (if executable-p (copy-hir-debug-type-checked type) type))))
                        'simple-vector))
               (parameters (hir-code-parameters (hir-function-parameters function))))
          (setf (svref descriptors i)
          (if executable-p
            (vector (hir-function-name function) (svref plan 2)
              (register (hir-function-environment function)) (hir-block-id (hir-function-entry function))
              (length (hir-function-captures function)) blocks debug
              (svref plan 4) (coerce (nreverse (svref plan 5)) 'simple-vector)
              types parameters (svref plan 6) (hir-function-debug-level function)
              (hir-function-optimization-policy function))
          (vector (hir-function-name function) (svref plan 2)
            (register (hir-function-environment function)) (hir-block-id (hir-function-entry function))
            (length (hir-function-captures function))
            (pack-hir-blocks blocks) debug types parameters
            (+ (hir-function-debug-level function) (* 4 (hir-function-optimization-policy function)))))))))
    (vector (coerce literals 'simple-vector) descriptors)))

(defun hir-unit-function (unit)
  ;; The freshly emitted executable payload has no outside aliases. The
  ;; private runtime constructor installs it directly, without a wire round trip.
  (miricl::%%hir-function-checked (emit-hir-code-checked unit t)))

(defun compile-hir (source &key name)
  "Compile a lambda through the shared HIR frontend for interpreter execution."
  (let* ((*compiling-evaluation* t) (*hir-debug-info-enabled* t)
         (*hir-debug-write-types* t) (unit (compile-to-hir source :name name)))
    (hir-unit-function unit)))

(defun hir-debug-check-write (value type)
  (unless (typep value type) (error 'type-error :datum value :expected-type type))
  value)

(defun compile-hir-in-scope (source scope registers captures &optional name debugger-p source-environment)
  ;; The factory's parameters hold existing cells and target tokens, rather
  ;; than their values. Escaping closures therefore retain the original cell.
  (let ((miricl-compiler::*compiling-evaluation* t))
    (compiler-source-form source)
    (unless (and (consp source) (eq (car source) 'lambda))
      (compiler-input-fail "lambda expression" source "expected a lambda expression"))
    (compiler-function-name name "function name")
    (when source-environment (compiler-primitive 48 source-environment))
    (unless (and (simple-vector-p registers) (simple-vector-p captures))
      (hir-code-error scope "invalid live debug registers"))
    (let* ((scope (svref (svref (copy-hir-debug-sites
                     (vector (vector 0 nil 0 0 scope 0 nil)) (length registers) (length captures)) 0) 4))
           (arguments nil) (variables nil) (functions nil) (targets nil) (factory nil) (macros nil)
           (*hir-unit* (make-hir-unit-record)) (*hir-specials* nil)
           (*hir-debug-level* (if debugger-p 2 (or (compiler-primitive 33 nil) 1)))
           (*hir-size-policy* (or (compiler-primitive 52 nil) 25))
           (*hir-macro-context* (hir-import-macro-context source-environment nil nil)) (*hir-debug-write-types* t)
           (*hir-safety-level* 3) (*hir-types* nil) (*hir-inline-policy* nil) (*hir-inlining* nil)
           (*hir-function-index* nil)
           (*hir-inline-small-functions* nil) (*hir-debug-info-enabled* (not debugger-p)) (*hir-debug-sites* nil)
           (*hir-source-path* nil) (*hir-origin* nil)
           (*hir-function* (make-hir-function-record nil nil nil nil nil nil nil nil nil 0 0 2 *hir-size-policy*))
           (*hir-block* (hir-new-block)) (*hir-dynamic* (hir-new-value :dynamic *hir-function*)))
      (setf (hir-function-entry *hir-function*) *hir-block*
            (hir-function-environment *hir-function*) *hir-dynamic*
            (hir-block-environment *hir-block*) *hir-dynamic*)
      (push *hir-function* (hir-unit-functions *hir-unit*))
      (loop for i from 0 below (length scope) by 4 do
        (let* ((kind (svref scope i)) (index (svref scope (1+ i)))
               (name (svref scope (+ i 2))) (type (svref scope (+ i 3)))
               (object (unless (or (= kind 4) (>= kind 9)) (svref (if (member kind '(1 3 6 8)) captures registers) index)))
               (value (unless (or (= kind 4) (>= kind 9))
                        (prog1 (hir-emit :argument nil (if (<= kind 3) :single :dynamic) (list (length arguments)))
                          (push object arguments)))))
          (cond
            ((>= kind 9)
             (push (list kind name type nil) macros))
            ((<= kind 4)
             (when (and (/= kind 4) (not (consp object)))
               (hir-code-error object "live lexical binding is not a value cell"))
             (let ((binding (make-hir-binding-record name *hir-function* value (= kind 4))))
               (when (member kind '(2 3)) (setf (hir-binding-local binding) (make-hir-local-record)))
               (push binding (hir-function-bindings *hir-function*))
               (push (cons binding type) *hir-types*)
               (if (member kind '(2 3)) (push (cons name binding) functions)
                   (push (cons name binding) variables))))
            (t (let ((target (make-hir-target-record name *hir-function* *hir-block* value t)))
                 (push (cons (if (<= kind 6) name (list :tag name)) target) targets))))))
      (setq variables (nreverse variables) functions (nreverse functions) targets (nreverse targets))
      (when macros
        (let ((environment source-environment))
          (dolist (entry (reverse variables))
            (setq environment (compiler-primitive (if (hir-binding-special-p (cdr entry)) 11 3) environment (car entry))))
          (dolist (entry (reverse functions))
            (setq environment (compiler-primitive 4 environment (car entry) nil)))
          (dolist (entry macros)
            (setq environment (compiler-primitive (if (= (first entry) 9) 6 5) environment (second entry) (third entry)))
            (setf (fourth entry) (cdr (assoc (second entry) (if (= (first entry) 9) variables functions)))))
          (setq *hir-macro-context* (list environment variables functions macros))))
      (let ((closure (hir-close source variables functions targets)))
        (when name
          (setf (hir-function-name (first (hir-instruction-attributes (hir-value-producer closure)))) name))
        (hir-terminate :return (list (hir-multiple closure)) nil))
      (setf (hir-function-parameters *hir-function*) (mapcar (lambda (argument) (declare (ignore argument)) (gensym)) arguments)
            (hir-block-instructions *hir-block*) (nreverse (hir-block-instructions *hir-block*))
            (hir-function-blocks *hir-function*) (nreverse (hir-function-blocks *hir-function*))
            (hir-function-values *hir-function*) (nreverse (hir-function-values *hir-function*))
            (hir-unit-functions *hir-unit*) (nreverse (hir-unit-functions *hir-unit*)))
      (hir-clear-source *hir-unit*)
      (setq factory (hir-unit-function *hir-unit*))
      ;; Instantiating the factory only captures existing cells. The returned
      ;; function's body runs after this compilation guard has unwound.
      (apply factory (nreverse arguments)))))

(defun eval-hir-in-frame (form scope registers captures)
  (let ((miricl-compiler::*compiling-evaluation* t))
    (compiler-source-form form))
  (funcall (compile-hir-in-scope (list 'lambda nil form) scope registers captures nil t)))

(defun compile-hir-in-environment (source environment &optional name)
  "Compile SOURCE while retaining the actual cells of a runtime lexical environment."
  (let ((miricl-compiler::*compiling-evaluation* t)
        (*hir-debug-info-enabled* t)
        (*hir-debug-write-types* t))
    ;; Source validation itself creates lexical helper functions. Include it
    ;; in preparation so a bootstrap helper cannot recursively compile itself.
    (compiler-source-form source)
    (unless (and (consp source) (eq (car source) 'lambda))
      (compiler-input-fail "lambda expression" source "expected a lambda expression"))
    (compiler-function-name name "function name")
    (if (null environment)
        (hir-unit-function (lower-source-to-hir source name))
        (let ((packet (compiler-primitive 48 environment)))
          (unless (and (simple-vector-p packet) (= (length packet) 3))
            (hir-code-error environment "invalid lexical environment snapshot"))
          (compile-hir-in-scope source (svref packet 0) (svref packet 1) (svref packet 2) name nil environment)))))

(defun eval-hir-in-environment (form environment)
  "Evaluate FORM in a checked runtime lexical environment, preserving all values."
  (let ((miricl-compiler::*compiling-evaluation* t))
    (compiler-source-form form))
  (funcall (compile-hir-in-environment (list 'lambda nil form) environment)))
