;;;; Lower the compiler's semantic HIR to the interpreter's compact code.
(in-package :miricl-compiler)

(defun hir-code-parameters (parameters)
  ;; Defaults and AUX initializers are already code, not executable metadata.
  (mapcar (lambda (parameter) (if (consp parameter) (first parameter) parameter)) parameters))

(defun hir-code-debug-info (function register &optional aliases)
  (vector
    (coerce (loop for binding in (hir-function-bindings function)
                  when (hir-binding-cell binding)
                    append (list (funcall register (hir-binding-cell binding)) (hir-binding-name binding)
                             (+ (if (hir-binding-local binding) 1 0)
                                (if (and aliases (>= (svref aliases (hir-value-id (hir-binding-cell binding))) 0)) 2 0))))
      'simple-vector)
    (coerce (loop for identity in (hir-function-captures function)
                  append (if (%hir-binding-p identity)
                    (list (hir-binding-name identity) (if (hir-binding-local identity) 1 0))
                    (list (hir-target-name identity) 2))) 'simple-vector)))

(defun hir-code-cell-aliases (function captured)
  ;; Prove from actual uses, not mutable record flags, that a cell has no
  ;; observable identity and never changes. Typed reads may carry a stronger
  ;; scoped assertion; retain those rather than moving that fact to its input.
  (let* ((count (hir-function-value-count function))
         (candidates (make-array count :initial-element nil))
         (reads (make-array count :initial-element nil))
         (aliases (make-array count :initial-element -1)))
    (when (>= (hir-function-debug-level function) 3) (return-from hir-code-cell-aliases aliases))
    (dolist (value (hir-function-values function))
      (let ((producer (hir-value-producer value)))
        (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :cell-new)
                   (not (gethash value captured)))
          (setf (svref candidates (hir-value-id value)) t))))
    (dolist (block (hir-function-blocks function))
      (dolist (instruction (cons (hir-block-terminator block) (hir-block-instructions block)))
        (loop for input in (hir-instruction-inputs instruction) for position from 0 do
          (let ((id (hir-value-id input)))
            (if (and (zerop position) (eq (hir-instruction-opcode instruction) :cell-read))
                (push instruction (svref reads id))
                (setf (svref candidates id) nil))))))
    (dolist (value (hir-function-values function))
      (let ((id (hir-value-id value)))
        (when (svref candidates id)
          (let* ((initial (first (hir-instruction-inputs (hir-value-producer value))))
                 (initial-type (hir-value-type initial)) (all t))
            (dolist (read (svref reads id))
              (let ((output (hir-instruction-output read)))
                (if (and output (or (eq (hir-value-type output) t) (equal (hir-value-type output) initial-type)))
                    (setf (svref aliases (hir-value-id output)) (hir-value-id initial))
                    (setq all nil))))
            (when all (setf (svref aliases id) (hir-value-id initial)))))))
    aliases))

(defun hir-code-register (value plans)
  (let* ((function (hir-value-owner value)) (plan (gethash function plans))
         (aliases (svref plan 0)) (indices (svref plan 1)) (id (hir-value-id value)) (remaining (length aliases)))
    (loop while (>= (svref aliases id) 0) do
      (when (minusp (decf remaining)) (hir-code-error id "circular HIR value aliases"))
      (setq id (svref aliases id)))
    (svref indices id)))

(defun hir-code-single-calls (function)
  ;; A call may return arbitrary values. Avoid materializing the value group
  ;; only when every use discards all but the primary value, and no scoped
  ;; result assertion would be lost by removing that projection.
  (let ((single (make-array (hir-function-value-count function) :initial-element nil)))
    (when (>= (hir-function-debug-level function) 3) (return-from hir-code-single-calls single))
    (dolist (value (hir-function-values function))
      (let ((producer (hir-value-producer value)))
        (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :call)
                   (eq (hir-value-type value) t))
          (setf (svref single (hir-value-id value)) t))))
    (dolist (block (hir-function-blocks function))
      (dolist (instruction (cons (hir-block-terminator block) (hir-block-instructions block)))
        (loop for input in (hir-instruction-inputs instruction) for index from 0 do
          (unless (and (eq (hir-instruction-opcode instruction) :primary) (zerop index)
                       (hir-instruction-output instruction)
                       (eq (hir-value-type (hir-instruction-output instruction)) t))
            (setf (svref single (hir-value-id input)) nil)))))
    single))

(defun hir-code-scope-aliases (function captured aliases)
  ;; Uncaptured lexical exits need no runtime target. Derive escape facts
  ;; from captures and uses rather than trusting mutable target flags.
  (declare (type simple-vector function aliases) (type hash-table captured))
  (when (>= (hir-function-debug-level function) 2)
    (return-from hir-code-scope-aliases nil))
  (let ((candidates (make-array (length aliases) :initial-element nil)))
    (declare (type simple-vector candidates))
    (dolist (value (hir-function-values function))
      (declare (type simple-vector value))
      (let ((producer (hir-value-producer value)))
        (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :block-enter)
                   (eq (hir-value-type value) t) (not (gethash value captured)))
          (setf (svref candidates (hir-value-id value)) t))))
    (dolist (block (hir-function-blocks function))
      (declare (type simple-vector block))
      (dolist (instruction (cons (hir-block-terminator block) (hir-block-instructions block)))
        (declare (type simple-vector instruction))
        (loop for input in (hir-instruction-inputs instruction) for position from 0 do
          (when (and (svref candidates (hir-value-id input))
                     (not (case (hir-instruction-opcode instruction)
                            (:block-environment (and (zerop position)
                              (eq (hir-value-type (hir-instruction-output instruction)) t)))
                            (:block-return (and (= position 1) (hir-instruction-attributes instruction))))))
            (setf (svref candidates (hir-value-id input)) nil)))))
    (dolist (value (hir-function-values function))
      (declare (type simple-vector value))
      (let ((producer (hir-value-producer value)))
        (when (%hir-instruction-p producer)
          (let ((input (first (hir-instruction-inputs producer))))
            (when (or (svref candidates (hir-value-id value))
                      (and (eq (hir-instruction-opcode producer) :block-environment)
                           (svref candidates (hir-value-id input))))
              (setf (svref aliases (hir-value-id value)) (hir-value-id input)))))))))

(defun emit-hir-code (unit)
  (declare (optimize (safety 3)))
  (verify-hir unit)
  (let* ((functions (hir-unit-functions unit)) (indices (make-hash-table :test 'eq))
         (literals (make-array 0 :adjustable t :fill-pointer 0))
         (literal-indices (make-hash-table :test 'eq))
         (descriptors (make-array (length functions)))
         (fixed-call-base (position-if (lambda (spec)
           (and (eq (first spec) :call-primary) (eql (second spec) (third spec))))
           *hir-code-operations*))
         (plans (make-hash-table :test 'eq)) (captured (make-hash-table :test 'eq)))
    (loop for function in functions for i from 0 do (setf (gethash function indices) i))
    (dolist (function functions)
      (dolist (identity (hir-function-captures function))
        (setf (gethash (if (%hir-binding-p identity) (hir-binding-cell identity)
                          (hir-target-token identity)) captured) t)))
    (dolist (function functions)
      (let* ((aliases (hir-code-cell-aliases function captured))
             (single (hir-code-single-calls function))
             (registers (make-array (length aliases) :initial-element -1)) (count 0))
        (hir-code-scope-aliases function captured aliases)
        (dolist (value (hir-function-values function))
          (let ((producer (hir-value-producer value)))
            (when (and (%hir-instruction-p producer) (eq (hir-instruction-opcode producer) :primary)
                       (svref single (hir-value-id (first (hir-instruction-inputs producer)))))
              (setf (svref aliases (hir-value-id value))
                    (hir-value-id (first (hir-instruction-inputs producer)))))))
        (dotimes (id (length aliases))
          (when (minusp (svref aliases id)) (setf (svref registers id) count) (incf count)))
        (setf (gethash function plans) (vector aliases registers count single))))
    (labels ((literal (object)
               (multiple-value-bind (index found) (gethash object literal-indices)
                 (if found index (setf (gethash object literal-indices) (vector-push-extend object literals)))))
             (register (value) (hir-code-register value plans))
             (block-code (block)
               (let ((bytes (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
                 (labels ((word (n)
                            (unless (typep n '(unsigned-byte 31)) (hir-code-error n "operand exceeds 31 bits"))
                            (loop (vector-push-extend (code-char (logior (logand n 127) (if (> n 127) 128 0))) bytes)
                                  (setq n (ash n -7)) (when (zerop n) (return)))))
                   (dolist (instruction (append (hir-block-instructions block) (list (hir-block-terminator block))))
                     (let* ((opcode (hir-instruction-opcode instruction))
                            (inputs (hir-instruction-inputs instruction))
                            (output (hir-instruction-output instruction))
                            (attributes (hir-instruction-attributes instruction))
                            (local-exit (and (eq opcode :block-return) attributes
                              (>= (svref (svref (gethash (hir-value-owner (second inputs)) plans) 0)
                                         (hir-value-id (second inputs))) 0)))
                            (number (position (if local-exit :checked-jump opcode) *hir-code-operations* :key #'first))
                            (spec (and number (svref *hir-code-operations* number))))
                       (when local-exit (setq opcode :checked-jump inputs (cddr inputs)))
                       (unless number (hir-code-error opcode "unsupported opcode"))
                       (unless (eq (not (null output)) (not (null (fifth spec))))
                         (hir-code-error opcode "invalid instruction result"))
                       (unless (and output (>= (svref (svref (gethash (hir-value-owner output) plans) 0)
                                                              (hir-value-id output)) 0))
                       (when (eq opcode :function-reference)
                         (case (second attributes) (inline (setq number 35)) (notinline (setq number 36))))
                       (when (and (eq opcode :call)
                                  (svref (svref (gethash (hir-value-owner output) plans) 3) (hir-value-id output)))
                         (setq number (if (<= 2 (length inputs) 6)
                                          (+ fixed-call-base (- (length inputs) 2)) 37)
                               spec (svref *hir-code-operations* number)))
                       (vector-push-extend (code-char (+ number (* 64 (hir-instruction-safety-level instruction)))) bytes)
                       (when output (word (register output)))
                       (unless (eql (second spec) (third spec)) (word (length inputs)))
                       (dolist (input inputs) (word (register input)))
                       (case opcode
                         ((:constant :function-reference :global-read :global-write :dynamic-bind)
                          (word (literal (first attributes))))
                         ((:argument :rest-argument :value-ref :capture :control-call :restart-signal
                           :check-apply-arguments :checked-argument)
                          (word (first attributes)))
                         (:check-arguments (word (first attributes)) (word (1+ (second attributes))))
                         (:closure (word (gethash (first attributes) indices)))
                         (:block-enter (word (hir-block-id (hir-target-block (first attributes)))))
                         ((:branch :jump :checked-jump) (dolist (target attributes) (word (hir-block-id target))))
                         (:block-return (word (if attributes (1+ (hir-block-id (first attributes))) 0)))))))
                   (coerce bytes 'simple-string)))))
      (loop for function in functions for i from 0 do
        (setf (svref descriptors i)
          (vector (hir-function-name function) (svref (gethash function plans) 2)
            (register (hir-function-environment function)) (hir-block-id (hir-function-entry function))
            (length (hir-function-captures function))
            (pack-hir-blocks (map 'vector (lambda (block)
              (vector (if (hir-block-parameters block) (1+ (register (first (hir-block-parameters block)))) 0)
                (if (hir-block-environment block) (1+ (register (hir-block-environment block))) 0)
                (block-code block))) (hir-function-blocks function)))
            (hir-code-debug-info function #'register (svref (gethash function plans) 0))
            (coerce (loop for value in (hir-function-values function)
                          unless (or (eq (hir-value-type value) t)
                                     (>= (svref (svref (gethash function plans) 0) (hir-value-id value)) 0))
                            append (list (register value) (hir-value-type value))) 'simple-vector)
            (hir-code-parameters (hir-function-parameters function))))))
    (vector (coerce literals 'simple-vector) descriptors)))

(defun compile-hir (source &key name)
  "Compile a lambda through the shared HIR frontend for interpreter execution."
  (let ((unit (compile-to-hir source :name name)))
    ;; Debug level 3 still uses source stepping and the evaluator's named,
    ;; writable lexical cells. Do not trade those facilities for speed.
    (if (some (lambda (function) (= (hir-function-debug-level function) 3)) (hir-unit-functions unit))
        (eval (list 'function source))
        (load-hir-code (emit-hir-code unit)))))

(defun hir-code-to-unit (payload)
  "Reconstruct semantic HIR for native compilation of a compact-code FASL."
  (declare (optimize (safety 3)))
  (let* ((payload (validate-hir-code payload)) (literals (svref payload 0))
         (descriptors (svref payload 1)) (count (length descriptors))
         (functions (make-array count)) (values (make-array count))
         (blocks (make-array count)) (captures (make-array count))
         (closures nil) (instructions nil))
    ;; Reserve canonical identities before connecting code and capture edges.
    (dotimes (fi count)
      (let* ((d (svref descriptors fi))
             (value-count (+ (svref d 1) (svref d 11)))
             (f (make-hir-function-record (svref d 0) nil (svref d 10)
                  nil nil nil nil nil nil value-count))
             (vs (make-array value-count)) (bs (make-array (length (svref d 5)))))
        (setf (svref functions fi) f (svref values fi) vs (svref blocks fi) bs
              (svref captures fi) (make-array (svref d 4) :initial-element nil))
        (dotimes (i (length vs)) (setf (svref vs i) (make-hir-value-record i :single f nil)))
        (loop for i from 0 below (length (svref d 9)) by 2 do
          (let ((type (svref (svref d 9) (1+ i))))
            (compiler-type-specifier type)
            (setf (hir-value-type (svref vs (svref (svref d 9) i))) type)))
        (dotimes (i (length bs))
          (setf (svref bs i) (make-hir-block-record i)))
        (setf (hir-function-values f) (coerce vs 'list)
              (hir-function-blocks f) (coerce bs 'list)
              (hir-function-block-count f) (length bs)
              (hir-function-environment f) (svref vs (svref d 2))
              (hir-function-entry f) (svref bs (svref d 3)))
        (setf (hir-value-kind (hir-function-environment f)) :dynamic
              (hir-value-producer (hir-function-environment f)) f)
        (dotimes (bi (length bs))
          (let* ((bd (svref (svref d 5) bi)) (block (svref bs bi)) (parameter (svref bd 0)))
            (when (plusp parameter)
              (let ((value (svref vs (1- parameter))))
                (when (hir-value-producer value) (hir-code-error parameter "register has multiple definitions"))
                (setf (hir-block-parameters block) (list value)
                      (hir-value-producer value) block (hir-value-kind value) :multiple)))
            (when (plusp (svref bd 1))
              (setf (hir-block-environment block) (svref vs (1- (svref bd 1)))))))))
    (dotimes (fi count)
      (let* ((d (svref descriptors fi)) (f (svref functions fi))
             (vs (svref values fi)) (bs (svref blocks fi)) (next-group (svref d 1)))
        (dotimes (bi (length bs))
          (let* ((block (svref bs bi)) (code (svref (svref (svref d 5) bi) 2)) (pc 0) (body nil))
            (let ((scratch (make-array (+ 6 (svref d 7)) :initial-element 0)))
              (loop while (< pc (length code)) do
                (setq pc (read-hir-code-instruction code pc scratch))
                (let* ((number (svref scratch 0)) (spec (svref *hir-code-operations* number))
                       (opcode (cond ((<= 35 number 36) :function-reference)
                                     ((eq (first spec) :checked-jump) :jump) (t (first spec))))
                       (out (svref scratch 2)) (n (svref scratch 3))
                       (inputs (loop for i below n collect (svref vs (svref scratch (+ i 6)))))
                       (a (when (plusp (fourth spec)) (svref scratch 4)))
                       (b (when (> (fourth spec) 1) (svref scratch 5)))
                       (output (when (plusp out) (svref vs (1- out))))
                       (instruction (make-hir-instruction-record opcode inputs output nil nil :control (svref scratch 1))))
                  (when (eq opcode :call-primary)
                    ;; Reconstruct ordinary semantic HIR. The shared native
                    ;; liveness pass can scalarize this pair again; consumers
                    ;; need no second set of call/type/control-flow rules.
                    (let* ((group (svref vs next-group))
                           (call (make-hir-instruction-record :call inputs group nil nil :call (svref scratch 1))))
                      (incf next-group)
                      (setf (hir-value-kind group) :multiple (hir-value-producer group) call
                            (hir-instruction-opcode instruction) :primary
                            (hir-instruction-inputs instruction) (list group))
                      (setq opcode :primary inputs (list group))
                      (push (list fi call) instructions) (push call body)))
                  (when output
                    (when (hir-value-producer output) (hir-code-error out "register has multiple definitions"))
                    (setf (hir-value-producer output) instruction
                          (hir-value-kind output)
                          (case opcode
                            ((:values :call :multiple-value-call :control-call :restart-signal) :multiple)
                            ((:dynamic-bind :block-enter :block-environment) :dynamic)
                            (otherwise :single))))
                  (setf (hir-instruction-attributes instruction)
                    (case opcode
                      ((:constant :global-read :global-write :dynamic-bind)
                       (list (svref literals a)))
                      (:function-reference
                       (case number (35 (list (svref literals a) 'inline))
                         (36 (list (svref literals a) 'notinline)) (otherwise (list (svref literals a)))))
                      ((:argument :rest-argument :value-ref :control-call :restart-signal
                        :check-apply-arguments :checked-argument) (list a))
                      (:check-arguments (list a (1- b)))
                      (:capture (list a nil))
                      (:closure
                       (let ((child (svref functions a)))
                         (when (and (hir-function-parent child) (not (eq (hir-function-parent child) f)))
                           (hir-code-error a "function has multiple lexical parents"))
                         (setf (hir-function-parent child) f)
                         (push (list fi a inputs) closures) (list child)))
                      (:cell-new
                       (let ((binding (make-hir-binding-record (gensym "HIR-LOCAL-") f output nil nil t)))
                         (push binding (hir-function-bindings f)) (list binding)))
                      (:block-enter (list (make-hir-target-record nil f (svref bs a) output)))
                      (:block-environment nil)
                      (:branch (list (svref bs a) (svref bs b)))
                      (:jump (list (svref bs a)))
                      (:block-return (when (plusp a) (list (svref bs (1- a)))))))
                  (when (eq opcode :checked-argument)
                    ;; The source frontend normally dominates this private
                    ;; access with an APPLY check. Reestablish that boundary
                    ;; for serialized IR before native list traversal.
                    (let ((check (make-hir-instruction-record :check-apply-list inputs nil nil nil :check)))
                      (push (list fi check) instructions) (push check body)))
                  (push (list fi instruction) instructions)
                  (if (sixth spec) (setf (hir-block-terminator block) instruction)
                      (push instruction body))))
              (setf (hir-block-instructions block) (nreverse body)))))))
    ;; Captures use binding identities, including captures forwarded through
    ;; intermediate closures. Resolve those edges with a bounded worklist.
    (labels ((capture-identity (fi value)
               (let ((producer (hir-value-producer value)))
                 (when (%hir-instruction-p producer)
                   (case (hir-instruction-opcode producer)
                     ((:cell-new :block-enter) (first (hir-instruction-attributes producer)))
                     (:capture (svref (svref captures fi) (first (hir-instruction-attributes producer)))))))))
      (loop with pending = closures while pending do
        (let ((next nil) (progress nil))
          (dolist (closure pending)
            (let ((fi (first closure)) (child (second closure)) (complete t))
              (loop for input in (third closure) for i from 0 do
                (let ((id (capture-identity fi input)) (previous (svref (svref captures child) i)))
                  (unless id (setq complete nil))
                  (when (and id previous (not (eq id previous)))
                    (hir-code-error child "inconsistent lexical capture identity"))
                  (when (and id (null previous))
                    (setf (svref (svref captures child) i) id) (setq progress t))))
              (unless complete (push closure next))))
          (when (and next (not progress)) (hir-code-error payload "unresolved or circular lexical captures"))
          (setq pending next)))
      (dotimes (fi count)
        (let ((f (svref functions fi)))
          (setf (hir-function-captures f) (coerce (svref captures fi) 'list))
          (dolist (id (hir-function-captures f))
            (cond ((%hir-binding-p id) (setf (hir-binding-captured-p id) t))
                  ((%hir-target-p id) (setf (hir-target-captured-p id) t))
                  (t (hir-code-error fi "function has no lexical capture source"))))))
      (dolist (entry instructions)
        (let* ((fi (first entry)) (instruction (second entry))
               (opcode (hir-instruction-opcode instruction)))
          (case opcode
            (:capture
             (let ((id (svref (svref captures fi) (first (hir-instruction-attributes instruction)))))
               (setf (second (hir-instruction-attributes instruction)) id)
               (when (%hir-target-p id) (setf (hir-value-kind (hir-instruction-output instruction)) :dynamic))))
            (:block-environment
             (let ((id (capture-identity fi (first (hir-instruction-inputs instruction)))))
               (unless (%hir-target-p id) (hir-code-error payload "block environment has no lexical target"))
               (setf (hir-instruction-attributes instruction) (list id))))))))
    (let ((unit (make-hir-unit :functions (coerce functions 'list))))
      (verify-hir unit)
      (verify-hir-code-operands unit)
      (verify-hir-code-dominance unit)
      unit)))

(defun verify-hir-code-operands (unit)
  ;; A wire-level register is not a proof of an internal representation. The
  ;; native ABI uses unchecked context/cell accesses, unlike the guarded VM.
  (declare (optimize (safety 3)))
  (labels ((identity-of (value)
             (let ((producer (hir-value-producer value)))
               (when (%hir-instruction-p producer)
                 (case (hir-instruction-opcode producer)
                   ((:cell-new :block-enter) (first (hir-instruction-attributes producer)))
                   (:capture (second (hir-instruction-attributes producer)))))))
           (context-p (value)
             (or (eq value (hir-function-environment (hir-value-owner value)))
                 (let ((producer (hir-value-producer value)))
                   (and (%hir-instruction-p producer)
                        (member (hir-instruction-opcode producer) '(:dynamic-bind :block-environment))))))
           (group (value)
             (unless (eq (hir-value-kind value) :multiple)
               (hir-code-error (hir-value-id value) "expected a multiple-value register"))))
    (dolist (function (hir-unit-functions unit))
      (dolist (block (hir-function-blocks function))
        (when (and (hir-block-environment block) (not (context-p (hir-block-environment block))))
          (hir-code-error (hir-block-id block) "block has no dynamic environment"))
        (dolist (instruction (append (hir-block-instructions block) (list (hir-block-terminator block))))
          (let ((opcode (hir-instruction-opcode instruction)) (inputs (hir-instruction-inputs instruction)))
            (loop for input in inputs for index from 0 do
              (when (and (context-p input)
                         (not (and (zerop index)
                           (member opcode '(:dynamic-bind :environment-restore :global-read :global-write :block-enter
                                            :call :control-call :restart-signal :multiple-value-call :block-return :throw)))))
                (hir-code-error opcode "private environment used as Lisp data")))
            (when (member opcode '(:dynamic-bind :environment-restore :global-read :global-write :block-enter
                                  :call :control-call :restart-signal :multiple-value-call :block-return :throw))
              (unless (context-p (first inputs)) (hir-code-error opcode "operand is not a dynamic environment")))
            (when (member opcode '(:cell-read :cell-write))
              (unless (%hir-binding-p (identity-of (first inputs)))
                (hir-code-error opcode "operand is not a lexical cell")))
            (when (eq opcode :block-return)
              (unless (%hir-target-p (identity-of (second inputs)))
                (hir-code-error opcode "operand is not a lexical control target"))
              (when (third inputs) (group (third inputs))))
            (case opcode
              ((:primary :value-ref :values-list :return) (group (first inputs)))
              (:jump (when inputs (group (first inputs))))
              (:throw (group (third inputs)))
              (:multiple-value-call (mapc #'group (cddr inputs)))))))))
  t)

(defun verify-hir-code-dominance (unit)
  ;; Immediate dominators use linear storage. Include lexical exception landing
  ;; edges: a captured RETURN-FROM/GO can reach its owner's target block.
  (declare (optimize (safety 3)))
  (dolist (function (hir-unit-functions unit))
    (let* ((blocks (coerce (hir-function-blocks function) 'vector)) (n (length blocks))
           (successors (make-array n :initial-element nil)) (predecessors (make-array n :initial-element nil))
           (seen (make-array n :initial-element nil)) (rank (make-array n :initial-element -1))
           (dom (make-array n :initial-element -1)) (order nil)
           (entry (hir-block-id (hir-function-entry function)))
           (definition (make-array (hir-function-value-count function) :initial-element -1))
           (position (make-array (hir-function-value-count function) :initial-element -1)))
      (setf (svref definition (hir-value-id (hir-function-environment function))) -2)
      (dotimes (i n)
        (let ((block (svref blocks i)))
          (dolist (target (hir-instruction-attributes (hir-block-terminator block)))
            (pushnew (hir-block-id target) (svref successors i)))
          (dolist (value (hir-block-parameters block))
            (setf (svref definition (hir-value-id value)) i (svref position (hir-value-id value)) -2))
          (loop for instruction in (hir-block-instructions block) for p from 0 do
            (when (eq (hir-instruction-opcode instruction) :block-enter)
              (pushnew (hir-block-id (hir-target-block (first (hir-instruction-attributes instruction))))
                       (svref successors i)))
            (let ((output (hir-instruction-output instruction)))
              (when output (setf (svref definition (hir-value-id output)) i
                                (svref position (hir-value-id output)) p))))
          (dolist (target (svref successors i)) (pushnew i (svref predecessors target)))))
      (let ((work (list (cons entry nil))))
        (loop while work do
          (let* ((item (pop work)) (i (car item)))
            (cond ((cdr item) (push i order))
                  ((not (svref seen i))
                   (setf (svref seen i) t) (push (cons i t) work)
                   (dolist (target (svref successors i))
                     (unless (svref seen target) (push (cons target nil) work))))))))
      (loop for i in order for r from 0 do (setf (svref rank i) r))
      (setf (svref dom entry) entry)
      (labels ((intersect-paths (a b)
                 (loop until (= a b) do
                   (loop while (> (svref rank a) (svref rank b)) do (setq a (svref dom a)))
                   (loop while (> (svref rank b) (svref rank a)) do (setq b (svref dom b)))) a)
               (use (value block p)
                 (when (svref seen block)
                   (let* ((id (hir-value-id value)) (d (svref definition id)) (walk block))
                     (unless (= d -2)
                       (when (or (minusp d) (not (svref seen d)))
                         (hir-code-error id "register definition does not reach its use"))
                       (if (= d block)
                           (unless (< (svref position id) p)
                             (hir-code-error id "register used before its definition"))
                           (progn
                             (loop while (> (svref rank walk) (svref rank d)) do (setq walk (svref dom walk)))
                             (unless (= walk d) (hir-code-error id "register definition does not dominate its use")))))))))
        (loop with changed = t while changed do
          (setq changed nil)
          (dolist (i (cdr order))
            (let ((parent -1))
              (dolist (pred (svref predecessors i))
                (when (not (minusp (svref dom pred)))
                  (setq parent (if (minusp parent) pred (intersect-paths parent pred)))))
              (unless (= parent (svref dom i)) (setf (svref dom i) parent) (setq changed t)))))
        (dotimes (i n)
          (let ((block (svref blocks i)))
            (when (hir-block-environment block) (use (hir-block-environment block) i -1))
            (loop for instruction in (append (hir-block-instructions block) (list (hir-block-terminator block)))
                  for p from 0 do
              (dolist (value (hir-instruction-inputs instruction)) (use value i p))))))))
  t)
