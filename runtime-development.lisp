;;;; Macro environments and source loading in the standalone guest.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; Lexical function bindings have their own namespace (tags 30/31).
(define-runtime-function $function-environment (($env :nullable-object)) (:nullable-object)
  (:locals ($functions :nullable-object) ($binding :nullable-object) ($tag i32))
  #@(if (ref.is_null (local.get $env)) (then (return (ref.null eq))))
  ;; Environment spines are immutable. Cache their projection onto the
  ;; function namespace in the otherwise unused N/C fields of each cons.
  ;; Keep binding objects, so LABELS initialization remains visible.
  #@(if (call $value-n (local.get $env))
    (then (return (struct.get $obj $c (ref.cast (ref $obj) (local.get $env))))))
  #@(local.set $functions (call $function-environment (struct.get $obj $b (ref.cast (ref $obj) (local.get $env)))))
  #@(local.set $binding (struct.get $obj $a (ref.cast (ref $obj) (local.get $env))))
  #@(local.set $tag (call $tag (local.get $binding)))
  #@(if (i32.and (i32.ge_u (local.get $tag) (i32.const 30))
                 (i32.le_u (local.get $tag) (i32.const 32)))
    (then (local.set $functions (call $cons (local.get $binding) (local.get $functions)))))
  #@(struct.set $obj $c (ref.cast (ref $obj) (local.get $env)) (local.get $functions))
  #@(struct.set $obj $n (ref.cast (ref $obj) (local.get $env)) (i32.const 1))
  #@(local.get $functions))

(define-runtime-function $lexical-function (($name :nullable-object) ($env :nullable-object)) (:nullable-object)
  (:locals ($setf i32))
  #@(if (i32.eq (call $tag (local.get $name)) (i32.const 7))
    (then (local.set $setf (i32.const 1)) (local.set $name (call $car (call $cdr (local.get $name))))))
  #@(call $lexical-function-id (call $id (local.get $name)) (local.get $env) (local.get $setf)))

(define-runtime-function $lexical-function-id (($id i32) ($env :nullable-object) ($setf i32)) (:nullable-object)
  (:locals ($binding :nullable-object))
  #@(local.set $env (call $function-environment (local.get $env)))
  #@(block $done (loop $next
    (br_if $done (ref.is_null (local.get $env)))
    (local.set $binding (struct.get $obj $a (ref.cast (ref $obj) (local.get $env))))
    (if (i32.and (if (result i32) (local.get $setf)
                      (then (i32.eq (call $tag (local.get $binding)) (i32.const 32)))
                      (else (i32.or (i32.eq (call $tag (local.get $binding)) (i32.const 30))
                                     (i32.eq (call $tag (local.get $binding)) (i32.const 31)))))
                    (i32.eq (call $value-n (local.get $binding)) (local.get $id)))
      (then (return (local.get $binding))))
    (local.set $env (struct.get $obj $b (ref.cast (ref $obj) (local.get $env)))) (br $next)))
  #@(ref.null eq))

(define-runtime-function $macro-function (($name :nullable-object) ($env :nullable-object)) (:nullable-object)
  (:locals ($binding :nullable-object) ($id i32))
  #@(call $require-symbol (local.get $name))
  #@(local.set $binding (call $lexical-function (local.get $name) (local.get $env)))
  #@(if (i32.eqz (ref.is_null (local.get $binding)))
    (then (return (if (result (ref null eq)) (i32.eq (call $tag (local.get $binding)) (i32.const 31))
      (then (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding)))) (else (ref.null eq))))))
  #@(local.set $id (call $id (local.get $name)))
  #@(call $symbol-index-get (global.get $macro-bindings) (local.get $id)))

(define-runtime-function $set-macro (($name :nullable-object) ($value :nullable-object)) (:nullable-object)
  #@(call $require-symbol (local.get $name))
  #@(call $symbol-index-set (global.get $macro-bindings) (call $id (local.get $name)) (local.get $value))
  #@(local.get $value))

(define-runtime-function $compiler-macro-access
    (($name :nullable-object) ($env :nullable-object) ($value :nullable-object) ($write i32)) (:nullable-object)
  (:locals ($symbol :nullable-object) ($binding :nullable-object) ($setf i32))
  #@(local.set $setf (i32.eq (call $tag (local.get $name)) (i32.const 7)))
  #@(local.set $symbol (call $function-name-symbol (local.get $name)))
  #@(if (local.get $write)
    (then
      (if (i32.and (i32.eqz (ref.is_null (local.get $value)))
                   (i32.ne (call $tag (local.get $value)) (i32.const 8)))
        (then (call $type-fail (local.get $value) (call $symbol-value ,(clos-library-reference '%compiler-function-type))
          (i32.const ,(runtime-error-code :expected-designator)))))
      (if (ref.is_null (global.get $compiler-macros))
        (then (if (ref.is_null (local.get $value)) (then (return (ref.null eq))))
          (global.set $compiler-macros ,(empty-symbol-index-wat)))))
    (else (if (i32.eqz (ref.is_null (call $lexical-function (local.get $name) (local.get $env))))
      (then (return (ref.null eq))))
      (if (ref.is_null (global.get $compiler-macros)) (then (return (ref.null eq))))))
  #@(local.set $binding (call $symbol-index-get (ref.as_non_null (global.get $compiler-macros))
    (call $id (local.get $symbol))))
  #@(if (local.get $write)
    (then
      (if (ref.is_null (local.get $binding))
        (then (if (ref.is_null (local.get $value)) (then (return (ref.null eq))))
          (local.set $binding (call $node (i32.const 9) (call $id (local.get $symbol))
            (ref.null eq) (ref.null eq) (ref.null eq)))
          (call $symbol-index-set (ref.as_non_null (global.get $compiler-macros))
            (call $id (local.get $symbol)) (local.get $binding))))
      (if (local.get $setf) (then (struct.set $obj $b (ref.cast (ref $obj) (local.get $binding)) (local.get $value)))
        (else (struct.set $obj $a (ref.cast (ref $obj) (local.get $binding)) (local.get $value))))
      (if (i32.and (ref.is_null (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding))))
                   (ref.is_null (struct.get $obj $b (ref.cast (ref $obj) (local.get $binding)))))
        (then (call $symbol-index-set (ref.as_non_null (global.get $compiler-macros))
          (call $id (local.get $symbol)) (ref.null eq))))
      (return (local.get $value))))
  #@(if (ref.is_null (local.get $binding)) (then (return (ref.null eq))))
  #@(if (result (ref null eq)) (local.get $setf)
    (then (struct.get $obj $b (ref.cast (ref $obj) (local.get $binding)))) (else (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding))))))

(define-runtime-function $setf-expander-access
    (($name :nullable-object) ($function :nullable-object) ($env :nullable-object) ($write i32)) (:nullable-object)
  #@(call $require-symbol (local.get $name))
  #@(if (local.get $write)
    (then
      (if (ref.is_null (global.get $setf-expanders))
        (then (global.set $setf-expanders ,(empty-symbol-index-wat))))
      (call $symbol-index-set (ref.as_non_null (global.get $setf-expanders))
        (call $id (local.get $name)) (local.get $function))
      (return (local.get $name))))
  #@(if (ref.is_null (global.get $setf-expanders)) (then (return (ref.null eq))))
  #@(if (i32.eqz (ref.is_null (call $lexical-function (local.get $name) (local.get $env))))
    (then (return (ref.null eq))))
  #@(call $symbol-index-get (ref.as_non_null (global.get $setf-expanders)) (call $id (local.get $name))))

(define-runtime-function $make-symbol-macro-binding
    (($name :nullable-object) ($expansion :nullable-object)) (:nullable-object)
  #@(call $node (i32.const 9) (call $id (local.get $name))
    (call $node (i32.const 11) (i32.const 2) (local.get $expansion) (ref.null eq) (local.get $name))
    (call $closure
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'quote)))
        (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'function))) (ref.null eq)))
      (call $cons (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'quote)))
        (call $cons (local.get $expansion) (ref.null eq))) (ref.null eq)) (ref.null eq))
    (ref.null eq)))

(define-runtime-function $symbol-macro-binding (($name :nullable-object) ($env :nullable-object)) (:nullable-object)
  (:locals ($binding :nullable-object))
  #@(if (i32.eqz (call $symbolp (local.get $name))) (then (return (ref.null eq))))
  #@(local.set $binding (call $find (local.get $env) (call $id (local.get $name))))
  #@(if (i32.eqz (ref.is_null (local.get $binding)))
    (then
      (if (ref.is_null (struct.get $obj $c (ref.cast (ref $obj) (local.get $binding))))
        (then (if (i32.eqz (ref.is_null (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding)))))
          (then (if (i32.eq (call $value-n (struct.get $obj $a (ref.cast (ref $obj) (local.get $binding)))) (i32.const 2))
            (then (return (local.get $binding))))))))
      (return (ref.null eq))))
  #@(if (ref.is_null (global.get $symbol-macros)) (then (return (ref.null eq))))
  #@(call $symbol-index-get (ref.as_non_null (global.get $symbol-macros)) (call $id (local.get $name))))

(define-runtime-function $define-symbol-macro (($name :nullable-object) ($expansion :nullable-object)) (:nullable-object)
  #@(call $check-variable (local.get $name))
  (wat-fail-when #@(call $specialp (local.get $name)) :malformed-form)
  #@(if (ref.is_null (global.get $symbol-macros))
    (then (global.set $symbol-macros ,(empty-symbol-index-wat))))
  #@(call $symbol-index-set (ref.as_non_null (global.get $symbol-macros)) (call $id (local.get $name))
    (call $make-symbol-macro-binding (local.get $name) (local.get $expansion)))
  #@(call $clear-values)
  #@(local.get $name))

(define-runtime-function $constant-function (($value :nullable-object) ($macro i32)) (:nullable-object)
  #@(call $node (i32.const 8) (i32.const 2147483644) (local.get $value) (call $bool (local.get $macro)) (ref.null eq)))

(define-runtime-function $constant-macro-function (($expansion :nullable-object)) (:nullable-object)
  #@(call $constant-function (local.get $expansion) (i32.const 1)))

(define-runtime-function $macroexpand-1 (($form :nullable-object) ($env :nullable-object)) (:nullable-object)
  (:locals ($fn :nullable-object) ($hook :nullable-object))
  #@(if (i32.eq (call $tag (local.get $form)) (i32.const 7))
    (then (if (call $symbolp (call $car (local.get $form)))
      (then (local.set $fn (call $macro-function (call $car (local.get $form)) (local.get $env)))))))
  #@(if (call $symbolp (local.get $form))
    (then (local.set $fn (call $symbol-macro-binding (local.get $form) (local.get $env)))
      (if (i32.eqz (ref.is_null (local.get $fn)))
        (then (local.set $fn (struct.get $obj $b (ref.cast (ref $obj) (local.get $fn))))))))
  #@(if (ref.is_null (local.get $fn))
    (then (return (call $two-values (local.get $form) (ref.null eq)))))
  #@(local.set $hook (call $symbol-value (call $symbol (i32.const ,(runtime-symbol-id '*macroexpand-hook*)))))
  ;; The usual hook is the saved native FUNCALL object. Its behavior is known
  ;; even if the FUNCALL symbol is subsequently rebound. Custom hooks retain
  ;; their ordinary call path and observe every expansion.
  #@(if (if (result i32) (i32.eq (call $tag (local.get $hook)) (i32.const 8))
          (then (i32.eq (call $value-n (local.get $hook)) (i32.const ,(1+ (runtime-symbol-id 'funcall)))))
          (else (i32.const 0)))
    (then
      (if (i32.eq (call $value-n (local.get $fn)) (i32.const 2147483644))
        (then
          (if (i32.eqz (ref.is_null (struct.get $obj $b (ref.cast (ref $obj) (local.get $fn)))))
            (then (call $arity (call $cdr (local.get $form)) (i32.const 0) (i32.const 0))))
          (return (call $two-values (struct.get $obj $a (ref.cast (ref $obj) (local.get $fn))) (call $symbol (i32.const 1))))))
      (local.set $form (call $apply (local.get $fn)
        (call $cons (local.get $form) (call $cons (local.get $env) (ref.null eq))))))
    (else (local.set $form (call $apply (local.get $hook)
      (call $cons (local.get $fn) (call $cons (local.get $form) (call $cons (local.get $env) (ref.null eq))))))))
  #@(call $two-values (local.get $form) (call $symbol (i32.const 1))))

;; Keep these as ordinary macro functions: MACROLET and *MACROEXPAND-HOOK*
;; still use the standard expansion path. Variable places need no temporary
;; bindings or interpreted lambda-list destructuring on every iteration.
(defun $values-expansion-cl ()
  (runtime-function-definition '$values-expansion-cl
    (wat-fragment (miricl-cross:runtime-kernel-wat '$values-expansion-cl 'miricl-runtime:expand-values-form))))

(define-runtime-function $values-expansion (($form :nullable-object)) (:nullable-object)
  #@(call $check-apply-list (local.get $form))
  #@(call $values-expansion-cl (local.get $form)))

(define-runtime-function $modifier-expansion
    (($form :nullable-object) ($env :nullable-object) ($decrement i32)) (:nullable-object)
  (:locals ($args :nullable-object) ($place :nullable-object)
           ($delta :nullable-object) ($operator :nullable-object)
           ($temp :nullable-object) ($value :nullable-object))
  #@(local.set $args (call $cdr (local.get $form)))
  (wat-arity 1 2)
  #@(local.set $place (call $car (local.get $args)))
  #@(local.set $delta (if (result (ref null eq)) (ref.is_null (call $cdr (local.get $args)))
    (then (call $int (i32.const 1))) (else (call $car (call $cdr (local.get $args))))))
  #@(local.set $operator (call $symbol
    (select (i32.const ,(runtime-symbol-id '-)) (i32.const ,(runtime-symbol-id '+)) (local.get $decrement))))
  #@(if (i32.and (call $symbolp (local.get $place))
      (ref.is_null (call $symbol-macro-binding (local.get $place) (local.get $env))))
    (then
      ;; The delta must run before reading the place's value. Literal numbers
      ;; need no binding; other forms use a fresh variable to enforce this.
      (if (i32.eqz (i32.and (i32.ge_u (call $tag (local.get $delta)) (i32.const 1))
                            (i32.le_u (call $tag (local.get $delta)) (i32.const 5))))
        (then (local.set $temp (call $new-symbol ,(wat-text-literal "DELTA") (ref.null eq)))))
      (local.set $value (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'setq)))
      (call $cons (local.get $place) (call $cons
        (call $cons (local.get $operator) (call $cons (local.get $place)
          (call $cons (if (result (ref null eq)) (ref.is_null (local.get $temp))
            (then (local.get $delta)) (else (local.get $temp))) (ref.null eq)))) (ref.null eq)))))
      (if (ref.is_null (local.get $temp)) (then (return (local.get $value))))
      (return (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'let)))
        (call $cons (call $cons (call $cons (local.get $temp)
          (call $cons (local.get $delta) (ref.null eq))) (ref.null eq))
          (call $cons (local.get $value) (ref.null eq)))))))
  #@(call $apply ,(clos-library-reference '%modify-place)
    (call $cons (local.get $place) (call $cons (local.get $operator)
      (call $cons (local.get $delta) (call $cons (local.get $env) (ref.null eq)))))))

