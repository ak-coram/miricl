;;;; Integer subtype intervals, including symbolic endpoints for huge widths.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(define-runtime-function $integer-all-ones-p (($x :object)) (i32)
  (:locals ($digits :digits) ($i i32) ($last i32) ($value i32))
  #@(local.set $digits (ref.as_non_null (struct.get $obj $digits (local.get $x))))
  #@(local.set $last (i32.sub (array.len (local.get $digits)) (i32.const 1)))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (local.get $last)))
    (if (i32.ne (array.get $digits (local.get $digits) (local.get $i)) (i32.const 32767)) (then (return (i32.const 0))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(local.set $value (array.get $digits (local.get $digits) (local.get $last)))
  #@(i32.eqz (i32.and (local.get $value) (i32.add (local.get $value) (i32.const 1)))))

;; Internal endpoint: N sign, A exponent, B true for 2^exponent-1. These are
;; never exposed as Lisp integers and need no enormous digit arrays.
(define-runtime-function $integer-power-endpoint (($exponent :object) ($sign i32) ($ones i32)) (:object)
  #@(if (i32.eqz (struct.get $obj $n (local.get $exponent)))
    (then (return (call $int (select (i32.const 0) (local.get $sign) (local.get $ones))))))
  #@(call $node (i32.const 9) (local.get $sign) (local.get $exponent) (call $bool (local.get $ones)) (ref.null $obj)))

(define-runtime-function $integer-endpoint-width (($x :object)) (:object)
  #@(if (i32.eq (call $tag (local.get $x)) (i32.const 1))
    (then (return (call $int (call $bitlength (local.get $x))))))
  #@(if (result (ref $obj)) (ref.is_null (struct.get $obj $b (local.get $x)))
    (then (call $iadd (ref.as_non_null (struct.get $obj $a (local.get $x))) (call $int (i32.const 1))))
    (else (ref.as_non_null (struct.get $obj $a (local.get $x))))))

(define-runtime-function $integer-endpoint-compare (($a :object) ($b :object)) (i32)
  (:locals ($sign i32) ($cmp i32) ($width :object))
  #@(if (i32.and (i32.eq (call $tag (local.get $a)) (i32.const 1)) (i32.eq (call $tag (local.get $b)) (i32.const 1)))
    (then (return (call $compare (local.get $a) (local.get $b)))))
  #@(local.set $sign (struct.get $obj $n (local.get $a)))
  #@(if (i32.ne (local.get $sign) (struct.get $obj $n (local.get $b)))
    (then (return (select (i32.const -1) (i32.const 1) (i32.lt_s (local.get $sign) (struct.get $obj $n (local.get $b)))))))
  #@(if (i32.eq (call $tag (local.get $a)) (i32.const 1))
    (then (return (i32.sub (i32.const 0) (call $integer-endpoint-compare (local.get $b) (local.get $a))))))
  #@(local.set $width (call $integer-endpoint-width (local.get $a)))
  #@(local.set $cmp (call $compare (local.get $width) (call $integer-endpoint-width (local.get $b))))
  #@(if (local.get $cmp) (then (return (i32.mul (local.get $sign) (local.get $cmp)))))
  #@(if (i32.eq (call $tag (local.get $b)) (i32.const 1))
    (then (local.set $cmp (if (result i32) (ref.is_null (struct.get $obj $b (local.get $a)))
      (then (i32.sub (call $integer-power-of-two-p (local.get $b)) (i32.const 1)))
      (else (i32.sub (i32.const 1) (call $integer-all-ones-p (local.get $b)))))))
    (else
      (if (ref.eq (struct.get $obj $b (local.get $a)) (struct.get $obj $b (local.get $b))) (then (return (i32.const 0))))
      (if (call $eql (local.get $width) (call $int (i32.const 1))) (then (return (i32.const 0))))
      (local.set $cmp (select (i32.const -1) (i32.const 1) (ref.is_null (struct.get $obj $b (local.get $a)))))))
  #@(i32.mul (local.get $sign) (local.get $cmp)))

;; Normalize real interval designators to the integer points they contain.
(define-runtime-function $integer-interval-bound (($bound :nullable-object) ($lower i32)) (:nullable-object)
  (:locals ($exclusive i32) ($sign i32) ($number :object) ($quotient :object) ($remainder :object))
  #@(if (i32.eq (call $id (local.get $bound)) (i32.const ,(runtime-symbol-id '*))) (then (return (ref.null $obj))))
  #@(if (i32.eq (call $tag (local.get $bound)) (i32.const 7))
    (then (call $arity (local.get $bound) (i32.const 1) (i32.const 1))
      (local.set $bound (call $car (local.get $bound))) (local.set $exclusive (i32.const 1))))
  #@(local.set $number (call $rational (call $real (local.get $bound))))
  #@(if (i32.eq (call $tag (local.get $number)) (i32.const 1))
    (then (if (i32.eqz (local.get $exclusive)) (then (return (local.get $number))))
      (return (call $iadd (local.get $number) (call $int (select (i32.const 1) (i32.const -1) (local.get $lower)))))))
  #@(local.set $sign (struct.get $obj $n (call $numerator (local.get $number))))
  #@(call $idiv (call $iabs (call $numerator (local.get $number))) (call $denominator (local.get $number)))
  #@(local.set $remainder) #@(local.set $quotient)
  #@(if (i32.lt_s (local.get $sign) (i32.const 0)) (then (local.set $quotient (call $negative (local.get $quotient)))))
  #@(if (if (result i32) (struct.get $obj $n (local.get $remainder))
      (then (i32.eq (local.get $lower) (i32.gt_s (local.get $sign) (i32.const 0)))) (else (local.get $exclusive)))
    (then (local.set $quotient (call $iadd (local.get $quotient) (call $int (select (i32.const 1) (i32.const -1) (local.get $lower)))))))
  #@(local.get $quotient))

;; Kind 1 is an integer interval; kind 2 is NIL; kind 0 is outside this
;; kernel. COVERAGE permits a target real/rational interval's integer points.
(define-runtime-function $integer-type-interval (($type :nullable-object) ($coverage i32)) (:nullable-object :nullable-object i32)
  (:locals ($name :nullable-object) ($args :nullable-object) ($width :nullable-object)
           ($lower :nullable-object) ($upper :nullable-object) ($unsigned i32) ($id i32))
  #@(if (ref.is_null (local.get $type)) (then (return (ref.null $obj) (ref.null $obj) (i32.const 2))))
  #@(local.set $name (local.get $type))
  #@(if (i32.eq (call $tag (local.get $type)) (i32.const 23))
    (then (local.set $name (call $car (call $property-cell (struct.get $obj $b (local.get $type))
      (call $symbol (i32.const ,(runtime-symbol-id :name))))))))
  #@(if (i32.eq (call $tag (local.get $type)) (i32.const 7))
    (then (local.set $name (call $car (local.get $type))) (local.set $args (call $cdr (local.get $type)))))
  #@(local.set $id (call $id (local.get $name)))
  (wat-symbol-case #@(local.get $id)
    (fixnum #@(return (call $int (i32.const -536870912)) (call $int (i32.const 536870911)) (i32.const 1)))
    (bit #@(return (call $int (i32.const 0)) (call $int (i32.const 1)) (i32.const 1)))
    (mod
      #@(local.set $width (call $car (local.get $args)))
      #@(if (i32.ne (call $tag (local.get $width)) (i32.const 1))
        (then (call $list-type-error (local.get $width) (i32.const ,(runtime-symbol-id 'integer)))))
      (wat-fail-when #@(i32.le_s (struct.get $obj $n (local.get $width)) (i32.const 0)) :malformed-type)
      #@(return (call $int (i32.const 0)) (call $iadd (ref.as_non_null (local.get $width)) (call $int (i32.const -1))) (i32.const 1))))
  #@(if (i32.or (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'integer)))
      (i32.and (local.get $coverage) (i32.or (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'real)))
        (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'rational))))))
    (then
      (if (i32.eqz (ref.is_null (local.get $args)))
        (then (local.set $lower (call $integer-interval-bound (call $car (local.get $args)) (i32.const 1)))
          (if (i32.eqz (ref.is_null (call $cdr (local.get $args))))
            (then (local.set $upper (call $integer-interval-bound (call $car (call $cdr (local.get $args))) (i32.const 0)))))))
      (return (local.get $lower) (local.get $upper) (i32.const 1))))
  #@(if (i32.and (local.get $coverage) (i32.or (i32.eq (local.get $id) (i32.const 1))
      (i32.or (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'number)))
        (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'atom))))))
    (then (return (ref.null $obj) (ref.null $obj) (i32.const 1))))
  (wat-symbol-case #@(local.get $id)
    ((float single-float double-float short-float long-float ratio complex null boolean keyword
      symbol character base-char standard-char extended-char cons list sequence array vector
      simple-array simple-vector string simple-string base-string simple-base-string bit-vector simple-bit-vector
      function compiled-function)
     #@(if (local.get $coverage)
       (then (return (ref.null $obj) (ref.null $obj) (i32.const 2))))))
  #@(if (i32.and (i32.ne (local.get $id) (i32.const ,(runtime-symbol-id 'signed-byte)))
                (i32.ne (local.get $id) (i32.const ,(runtime-symbol-id 'unsigned-byte))))
    (then (return (ref.null $obj) (ref.null $obj) (i32.const 0))))
  #@(local.set $unsigned (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'unsigned-byte))))
  #@(if (local.get $unsigned) (then (local.set $lower (call $int (i32.const 0)))))
  #@(local.set $width (call $car (local.get $args)))
  #@(if (i32.or (ref.is_null (local.get $args)) (i32.eq (call $id (local.get $width)) (i32.const ,(runtime-symbol-id '*))))
    (then (return (local.get $lower) (ref.null $obj) (i32.const 1))))
  #@(if (i32.ne (call $tag (local.get $width)) (i32.const 1))
    (then (call $list-type-error (local.get $width) (i32.const ,(runtime-symbol-id 'integer)))))
  (wat-fail-when #@(i32.or (i32.lt_s (struct.get $obj $n (local.get $width)) (i32.const 0))
    (i32.and (i32.eqz (local.get $unsigned)) (i32.eqz (struct.get $obj $n (local.get $width))))) :malformed-type)
  #@(if (i32.eqz (local.get $unsigned))
    (then (local.set $width (call $iadd (ref.as_non_null (local.get $width)) (call $int (i32.const -1))))
      (local.set $lower (call $integer-power-endpoint (ref.as_non_null (local.get $width)) (i32.const -1) (i32.const 0)))))
  #@(local.set $upper (call $integer-power-endpoint (ref.as_non_null (local.get $width)) (i32.const 1) (i32.const 1)))
  #@(local.get $lower) #@(local.get $upper) #@(i32.const 1))

(define-runtime-function $integer-subtypep (($a :nullable-object) ($b :nullable-object)) (:nullable-object)
  (:locals ($lower :nullable-object) ($upper :nullable-object) ($to-lower :nullable-object) ($to-upper :nullable-object) ($kind i32))
  #@(call $integer-type-interval (local.get $a) (i32.const 0))
  #@(local.set $kind) #@(local.set $upper) #@(local.set $lower)
  #@(if (i32.eqz (local.get $kind)) (then (return (call $two-values (ref.null $obj) (ref.null $obj)))))
  #@(if (i32.eq (local.get $kind) (i32.const 2))
    (then (return (call $two-values (call $symbol (i32.const 1)) (call $symbol (i32.const 1))))))
  #@(if (i32.and (i32.eqz (ref.is_null (local.get $lower))) (i32.eqz (ref.is_null (local.get $upper))))
    (then (if (i32.gt_s (call $integer-endpoint-compare (ref.as_non_null (local.get $lower)) (ref.as_non_null (local.get $upper))) (i32.const 0))
      (then (return (call $two-values (call $symbol (i32.const 1)) (call $symbol (i32.const 1))))))))
  ;; BIGNUM is the union of the two integer ranges outside FIXNUM. A
  ;; nonempty integer interval is contained in it only on one side.
  #@(if (i32.or (i32.eq (call $id (local.get $b)) (i32.const ,(runtime-symbol-id 'bignum)))
      (ref.eq (local.get $b) (call $named-class (call $symbol (i32.const ,(runtime-symbol-id 'bignum))))))
    (then (return (call $two-values (call $bool (i32.or
      (if (result i32) (ref.is_null (local.get $upper)) (then (i32.const 0))
        (else (i32.lt_s (call $integer-endpoint-compare (ref.as_non_null (local.get $upper))
          (call $int (i32.const -536870912))) (i32.const 0))))
      (if (result i32) (ref.is_null (local.get $lower)) (then (i32.const 0))
        (else (i32.gt_s (call $integer-endpoint-compare (ref.as_non_null (local.get $lower))
          (call $int (i32.const 536870911))) (i32.const 0))))))
      (call $symbol (i32.const 1))))))
  #@(call $integer-type-interval (local.get $b) (i32.const 1))
  #@(local.set $kind) #@(local.set $to-upper) #@(local.set $to-lower)
  #@(if (i32.eqz (local.get $kind)) (then (return (call $two-values (ref.null $obj) (ref.null $obj)))))
  #@(if (i32.eq (local.get $kind) (i32.const 2)) (then (return (call $two-values (ref.null $obj) (call $symbol (i32.const 1))))))
  #@(if (i32.eqz (ref.is_null (local.get $to-lower)))
    (then (if (ref.is_null (local.get $lower)) (then (return (call $two-values (ref.null $obj) (call $symbol (i32.const 1))))))
      (if (i32.lt_s (call $integer-endpoint-compare (ref.as_non_null (local.get $lower)) (ref.as_non_null (local.get $to-lower))) (i32.const 0))
        (then (return (call $two-values (ref.null $obj) (call $symbol (i32.const 1))))))))
  #@(if (i32.eqz (ref.is_null (local.get $to-upper)))
    (then (if (ref.is_null (local.get $upper)) (then (return (call $two-values (ref.null $obj) (call $symbol (i32.const 1))))))
      (if (i32.gt_s (call $integer-endpoint-compare (ref.as_non_null (local.get $upper)) (ref.as_non_null (local.get $to-upper))) (i32.const 0))
        (then (return (call $two-values (ref.null $obj) (call $symbol (i32.const 1))))))))
  #@(call $two-values (call $symbol (i32.const 1)) (call $symbol (i32.const 1))))

(define-runtime-section integer-type-runtime-wat ()
  ($integer-all-ones-p) ($integer-power-endpoint) ($integer-endpoint-width) ($integer-endpoint-compare)
  ($integer-interval-bound) ($integer-type-interval) ($integer-subtypep))
