        (br_if $done (i32.or (i32.ne (call $tag (local.get $x)) (i32.const 7)) (i32.eq (local.get $i) (i32.const 16))))
        (local.set $hash (call $hash-mix (local.get $hash)
          (call $hash-code (local.get $test) (call $car (local.get $x)) (i32.sub (local.get $depth) (i32.const 1)))))
        (local.set $x (call $cdr (local.get $x)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (if (i32.lt_u (local.get $i) (i32.const 16))
