          (call $hash-code (local.get $test) (local.get $x) (i32.sub (local.get $depth) (i32.const 1)))))))))
  #@(local.get $hash))

(define-runtime-function $require-hash-table (($table :nullable-object)) (:object)
  #@(if (i32.ne (call $tag (local.get $table)) (i32.const 29))
    (then (call $type-fail (local.get $table) (call $symbol (i32.const ,(runtime-symbol-id 'hash-table)))
      (i32.const ,(runtime-error-code :expected-designator)))))
  #@(ref.as_non_null (local.get $table)))

(define-runtime-function $hash-index-link
    (($table :nullable-object) ($parent :nullable-object) ($hash i32) ($node :nullable-object)) ()
  #@(if (ref.is_null (local.get $parent))
    (then (struct.set $obj $c (ref.cast (ref $obj) (local.get $table)) (local.get $node)))
    (else (if (i32.and (local.get $hash) (call $value-n (local.get $parent)))
      (then (struct.set $obj $b (ref.cast (ref $obj) (local.get $parent)) (local.get $node)))
      (else (struct.set $obj $a (ref.cast (ref $obj) (local.get $parent)) (local.get $node)))))))

(define-runtime-function $hash-index-find
    (($key :nullable-object) ($table :nullable-object) ($hash i32)) (:nullable-object)
  (:locals ($scan :nullable-object) ($test i32))
  #@(local.set $test (call $id (struct.get $obj $a (ref.cast (ref $obj) (local.get $table)))))
  #@(local.set $scan (struct.get $obj $c (ref.cast (ref $obj) (local.get $table))))
  #@(block $leaf (loop $branch (br_if $leaf (i32.ne (call $tag (local.get $scan)) (i32.const 11)))
    (local.set $scan (if (result (ref null eq)) (i32.and (local.get $hash) (call $value-n (local.get $scan)))
      (then (struct.get $obj $b (ref.cast (ref $obj) (local.get $scan)))) (else (struct.get $obj $a (ref.cast (ref $obj) (local.get $scan)))))) (br $branch)))
  #@(block $done (loop $next (br_if $done (ref.is_null (local.get $scan)))
    (if (i32.ne (call $value-n (local.get $scan)) (local.get $hash)) (then (br $done)))
    (if (call $hash-key-match (local.get $test) (local.get $key) (call $car (local.get $scan)))
      (then (return (local.get $scan))))
