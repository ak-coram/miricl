;;;; A GC-owned compressed binary hash trie, with a separate enumeration spine.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

;; Weak tables have a negative count header (-1 for weak keys, -2 for weak
;; values). Their storage and iteration live entirely in the JS adapter.
(define-runtime-function $weak-hash-p (($table :nullable-object)) (i32)
  #@(i32.lt_s (call $value-n (local.get $table)) (i32.const 0)))

(define-runtime-function $weak-hash-bridge
    (($operation i32) ($table externref) ($left externref) ($right externref)) (i32)
  (:export-raw "weak-hash-bridge")
  (:locals ($object (ref $obj)))
  #@(local.set $object (ref.cast (ref $obj)
    (call $require-hash-table (ref.cast (ref null eq) (any.convert_extern (local.get $table))))))
  #@(if (i32.eqz (local.get $operation))
    (then (return (if (result i32) (call $weak-hash-p (local.get $object))
      (then (i32.sub (i32.const 0) (call $value-n (local.get $object)))) (else (i32.const 0))))))
  #@(if (i32.eq (local.get $operation) (i32.const 1))
    (then (return (call $hash-code (call $id (struct.get $obj $a (local.get $object)))
      (ref.cast (ref null eq) (any.convert_extern (local.get $left))) (i32.const 4)))))
  #@(if (i32.eq (local.get $operation) (i32.const 2))
    (then (return (call $hash-key-match (call $id (struct.get $obj $a (local.get $object)))
      (ref.cast (ref null eq) (any.convert_extern (local.get $left)))
      (ref.cast (ref null eq) (any.convert_extern (local.get $right)))))))
  #@(if (i32.eq (local.get $operation) (i32.const 5))
    (then (struct.set $obj $b (local.get $object) (ref.null eq))
      (struct.set $obj $c (local.get $object) (ref.null eq)) (return (i32.const 0))))
  (wat-fail-when #@(i32.or (i32.lt_u (local.get $operation) (i32.const 3))
                         (i32.gt_u (local.get $operation) (i32.const 4))) :unsupported)
  (wat-fail-when #@(call $value-n (local.get $object)) :unsupported)
  #@(struct.set $obj $n (local.get $object) (i32.sub (i32.const 2) (local.get $operation)))
  #@(i32.const 0))

(define-runtime-function $hash-count (($table :nullable-object)) (:nullable-object)
  #@(drop (call $require-hash-table (local.get $table)))
  #@(if (call $weak-hash-p (local.get $table))
    (then (return (call $javascript (i32.const 20) (local.get $table) (ref.null eq) (ref.null eq)))))
  #@(call $int (call $value-n (local.get $table))))

(define-runtime-function $hash-entries (($table :nullable-object)) (:nullable-object)
  #@(if (call $weak-hash-p (local.get $table))
    (then (return (call $javascript (i32.const 22) (local.get $table) (ref.null eq) (ref.null eq)))))
  #@(struct.get $obj $b (ref.cast (ref $obj) (local.get $table))))

(define-runtime-function $make-hash-table-object
    (($test :nullable-object) ($size :nullable-object) ($rehash :nullable-object) ($threshold :nullable-object)) (:nullable-object)
  #@(struct.new $hash-table (call $allocate-object-tag (i32.const 29)) (i32.const 0) (f64.const 0)
    (ref.null $digits) (local.get $test) (ref.null eq) (ref.null eq)
    (local.get $size) (local.get $rehash) (local.get $threshold)))

(define-runtime-function $hash-test-designator (($test :nullable-object)) (i32)
  (:locals ($binding :nullable-object) ($id i32))
  #@(if (call $symbolp (local.get $test))
    (then
      (local.set $id (call $id (local.get $test)))
      ,(wat-symbol-case #@(local.get $id) ((eq eql equal equalp) #@(return (local.get $id))))
      (local.set $binding (call $function-binding (local.get $test)))
      (if (ref.is_null (local.get $binding)) (then (return (i32.const 0))))
      (local.set $test (call $binding-value (local.get $binding)))))
  #@(if (i32.ne (call $tag (local.get $test)) (i32.const 8)) (then (return (i32.const 0))))
  #@(call $hash-test-function-id (local.get $test)))

(define-runtime-function $hash-test-designator-p (($test :nullable-object)) (:nullable-object)
  #@(call $bool (call $hash-test-designator (local.get $test))))

(define-runtime-function $make-hash-table-native (($args :nullable-object)) (:nullable-object)
  (:locals ($test :nullable-object) ($size :nullable-object) ($rehash :nullable-object) ($threshold :nullable-object)
           ($keyword :nullable-object) ($value :nullable-object) ($id i32) ($seen i32) ($allow i32) ($unknown i32))
  #@(block $bound (loop $keys (br_if $bound (ref.is_null (local.get $args)))
    (local.set $keyword (call $car (local.get $args))) (local.set $args (call $cdr (local.get $args)))
    ,(wat-fail-when #@(ref.is_null (local.get $args)) :wrong-arity)
    (local.set $value (call $car (local.get $args))) (local.set $args (call $cdr (local.get $args)))
    (local.set $id (call $id (local.get $keyword)))
    ,(runtime-wat-forms
      (loop for (keyword variable) in '((:test $test) (:size $size) (:rehash-size $rehash)
                                       (:rehash-threshold $threshold) (:allow-other-keys $allow))
        for bit = 1 then (* bit 2) collect
        `(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id keyword)))
          (then
            (if (i32.eqz (i32.and (local.get $seen) (i32.const ,bit)))
              (then (local.set ,variable ,(if (eq variable '$allow)
                '(i32.eqz (ref.is_null (local.get $value))) '(local.get $value)))
                (local.set $seen (i32.or (local.get $seen) (i32.const ,bit))))) (br $keys)))))
    (local.set $unknown (i32.const 1)) (br $keys)))
  (wat-fail-when #@(i32.and (local.get $unknown) (i32.eqz (local.get $allow))) :wrong-arity)
  #@(if (i32.and (local.get $seen) (i32.const 1))
    (then
      (local.set $id (call $hash-test-designator (local.get $test)))
      (if (i32.eqz (local.get $id))
        (then (call $type-fail (local.get $test)
          (call $cons (call $symbol (i32.const ,(runtime-symbol-id 'satisfies)))
            (call $cons ,(clos-library-reference '%%hash-test-designator-p) (ref.null eq)))
          (i32.const ,(runtime-error-code :expected-designator)))))
      (local.set $test (call $symbol (local.get $id))))
    (else (local.set $test (call $symbol (i32.const ,(runtime-symbol-id 'eql))))))
  (runtime-wat-forms
    (loop for (variable bit type default) in
      '(($size 2 %hash-size-type 16) ($rehash 4 %hash-rehash-size-type 2) ($threshold 8 %hash-threshold-type 1)) collect
      `(if (i32.and (local.get $seen) (i32.const ,bit))
        (then (call $check-type (local.get ,variable) (call $symbol-value ,(clos-library-reference type))))
        (else (local.set ,variable (call $int (i32.const ,default)))))))
  #@(call $clear-values)
  #@(call $make-hash-table-object (local.get $test) (local.get $size) (local.get $rehash) (local.get $threshold)))

;; Properties of internal scratch tables use the same default hints.
(define-runtime-function $hash-table-property (($table :nullable-object) ($mode i32)) (:nullable-object)
  (:locals ($typed (ref $hash-table)) ($size :nullable-object) ($count :nullable-object))
  #@(drop (call $require-hash-table (local.get $table)))
  #@(if (i32.eqz (local.get $mode)) (then (return (struct.get $obj $a (ref.cast (ref $obj) (local.get $table))))))
  #@(if (ref.test (ref $hash-table) (local.get $table))
    (then
      (local.set $typed (ref.cast (ref $hash-table) (local.get $table)))
      (if (i32.eq (local.get $mode) (i32.const 2)) (then (return (struct.get $hash-table $rehash-size (local.get $typed)))))
      (if (i32.eq (local.get $mode) (i32.const 3)) (then (return (struct.get $hash-table $rehash-threshold (local.get $typed)))))
      (local.set $size (struct.get $hash-table $size-hint (local.get $typed))))
    (else
      (if (i32.eq (local.get $mode) (i32.const 2)) (then (return (call $int (i32.const 2)))))
      (if (i32.eq (local.get $mode) (i32.const 3)) (then (return (call $int (i32.const 1)))))
      (local.set $size (call $int (i32.const 16)))))
  #@(local.set $count (call $hash-count (local.get $table)))
  #@(if (result (ref null eq)) (i32.ge_s (call $cmpabs (ref.as_non_null (local.get $size)) (ref.as_non_null (local.get $count))) (i32.const 0))
    (then (local.get $size)) (else (local.get $count))))

(define-runtime-function $hash-iterator-state (($table :nullable-object)) (:nullable-object)
  #@(drop (call $require-hash-table (local.get $table)))
  #@(if (call $weak-hash-p (local.get $table))
    (then (return (call $javascript (i32.const 23) (local.get $table) (ref.null eq) (ref.null eq)))))
  #@(call $cons (struct.get $obj $b (ref.cast (ref $obj) (call $require-hash-table (local.get $table)))) (ref.null eq)))

(define-runtime-function $hash-iterator-next (($state :nullable-object)) (:nullable-object)
  (:locals ($scan :nullable-object) ($entry :nullable-object))
  #@(if (i32.eq (call $tag (local.get $state)) (i32.const 47))
    (then
      (local.set $entry (call $javascript (i32.const 24) (local.get $state) (ref.null eq) (ref.null eq)))
      (if (ref.is_null (local.get $entry)) (then (call $clear-values) (return (ref.null eq))))
      (return (call $three-values (call $symbol (i32.const 1)) (call $car (local.get $entry)) (call $cdr (local.get $entry))))))
  #@(local.set $scan (call $car (local.get $state)))
  #@(if (ref.is_null (local.get $scan)) (then (call $clear-values) (return (ref.null eq))))
  #@(local.set $entry (call $car (local.get $scan)))
  #@(struct.set $obj $a (ref.cast (ref $obj) (local.get $state)) (call $cdr (local.get $scan)))
  #@(call $three-values (call $symbol (i32.const 1)) (call $car (local.get $entry)) (call $cdr (local.get $entry))))

(define-runtime-function $hash-mix (($hash i32) ($value i32)) (i32)
  #@(i32.mul (i32.xor (local.get $hash) (local.get $value)) (i32.const 16777619)))

(define-runtime-function $hash-test-function-id (($function :nullable-object)) (i32)
  (:locals ($id i32))
  #@(local.set $id (i32.sub (call $value-n (local.get $function)) (i32.const 1)))
  (wat-symbol-case #@(local.get $id)
    ((eq eql equal equalp) #@(return (local.get $id))))
  #@(i32.const 0))

(define-runtime-function $hash-string-code (($x :nullable-object) ($hash i32) ($fold i32)) (i32)
  (:locals ($data :digits) ($i i32) ($code i32))
  #@(local.set $data (ref.as_non_null (struct.get $obj $digits (ref.cast (ref $obj) (local.get $x)))))
  #@(block $done (loop $next (br_if $done (i32.eq (local.get $i) (array.len (local.get $data))))
    (local.set $code (array.get $digits (local.get $data) (local.get $i)))
    (if (local.get $fold) (then (local.set $code (call $string-upcase-code (local.get $code)))))
    (local.set $hash (call $hash-mix (local.get $hash) (local.get $code)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  #@(local.get $hash))

(define-runtime-function $hash-code (($test i32) ($x :nullable-object) ($depth i32)) (i32)
  (:locals ($tag i32) ($hash i32) ($i i32) ($fold i32) ($bits i64)
           ($data (ref $objects)) ($length i32) ($characters i32))
  #@(local.set $tag (call $tag (local.get $x)))
  #@(if (ref.is_null (local.get $x)) (then (return (call $hash-mix (i32.const -2128831035) (i32.const 0)))))
  #@(if (i32.eq (local.get $test) (i32.const ,(runtime-symbol-id 'eq)))
    (then (return (call $hash-mix (i32.const -2128831035)
      (if (result i32) (ref.test (ref i31) (local.get $x))
        (then (i31.get_s (ref.cast (ref i31) (local.get $x))))
        (else (struct.get $obj $tag (ref.cast (ref $obj) (local.get $x)))))))))
  #@(local.set $fold (i32.eq (local.get $test) (i32.const ,(runtime-symbol-id 'equalp))))
  #@(if (i32.le_u (i32.sub (local.get $tag) (i32.const 35)) (i32.const 1))
    (then (return (call $hash-array-code (local.get $test) (local.get $x) (local.get $depth)))))
  #@(if (i32.eq (local.get $tag) (i32.const 34))
    (then
      ;; EQUAL compares general vectors by identity, even after mutation.
      ;; SXHASH uses test=0: keep nested non-string arrays image-independent.
      (if (i32.eqz (local.get $fold))
        (then (return (call $hash-mix (i32.const -2128831035)
          (if (result i32) (local.get $test) (then (struct.get $obj $tag (ref.cast (ref $obj) (local.get $x)))) (else (i32.const 34)))))))
      (local.set $data (call $vector-data (local.get $x)))
      (local.set $length (array.len (local.get $data)))
      (local.set $characters (i32.const 1))
      (block $checked (loop $check (br_if $checked (i32.eq (local.get $i) (local.get $length)))
        (if (i32.ne (call $tag (array.get $objects (local.get $data) (local.get $i))) (i32.const 16))
          (then (local.set $characters (i32.const 0)) (br $checked)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $check)))
      (local.set $hash (call $hash-mix (i32.const -2128831035) (select (i32.const 10) (i32.const 34) (local.get $characters))))
      (if (i32.and (i32.eqz (local.get $characters)) (i32.eqz (local.get $depth))) (then (return (local.get $hash))))
      (if (i32.and (i32.eqz (local.get $characters)) (i32.gt_u (local.get $length) (i32.const 16)))
        (then (local.set $length (i32.const 16))))
      (local.set $i (i32.const 0))
      (block $hashed (loop $next (br_if $hashed (i32.eq (local.get $i) (local.get $length)))
        (local.set $hash (call $hash-mix (local.get $hash)
          (if (result i32) (local.get $characters)
            (then (call $string-upcase-code (call $value-n (array.get $objects (local.get $data) (local.get $i)))))
            (else (call $hash-code (local.get $test) (array.get $objects (local.get $data) (local.get $i))
              (i32.sub (local.get $depth) (i32.const 1)))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (return (local.get $hash))))
  #@(if (i32.and (local.get $fold) (i32.and (i32.ge_u (local.get $tag) (i32.const 1)) (i32.le_u (local.get $tag) (i32.const 5))))
    (then
      (if (i32.eq (local.get $tag) (i32.const 5))
        (then
          (if (call $zero (ref.as_non_null (struct.get $obj $b (ref.cast (ref $obj) (local.get $x)))))
            (then (return (call $hash-code (local.get $test) (struct.get $obj $a (ref.cast (ref $obj) (local.get $x))) (local.get $depth)))))
          (return (call $hash-mix
            (call $hash-code (local.get $test) (struct.get $obj $a (ref.cast (ref $obj) (local.get $x))) (local.get $depth))
            (call $hash-code (local.get $test) (struct.get $obj $b (ref.cast (ref $obj) (local.get $x))) (local.get $depth))))))
      (local.set $x (call $rational (ref.as_non_null (local.get $x))))
      (local.set $tag (call $tag (local.get $x)))))
  #@(local.set $hash (call $hash-mix (i32.const -2128831035) (local.get $tag)))
  #@(if (i32.eq (local.get $tag) (i32.const 1))
    (then
      (local.set $hash (call $hash-mix (local.get $hash) (call $value-n (local.get $x))))
      (block $done (loop $next (br_if $done (i32.eq (local.get $i) (call $integer-length (ref.as_non_null (local.get $x)))))
        (local.set $hash (call $hash-mix (local.get $hash) (call $digit (ref.as_non_null (local.get $x)) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (return (local.get $hash))))
  #@(if (i32.or (i32.eq (local.get $tag) (i32.const 2)) (i32.eq (local.get $tag) (i32.const 5)))
    (then (return (call $hash-mix
      (call $hash-mix (local.get $hash) (call $hash-code (local.get $test) (struct.get $obj $a (ref.cast (ref $obj) (local.get $x))) (local.get $depth)))
      (call $hash-code (local.get $test) (struct.get $obj $b (ref.cast (ref $obj) (local.get $x))) (local.get $depth))))))
  #@(if (i32.or (i32.eq (local.get $tag) (i32.const 3)) (i32.eq (local.get $tag) (i32.const 4)))
    (then
      (local.set $bits (i64.reinterpret_f64 (struct.get $obj $f (ref.cast (ref $obj) (local.get $x)))))
      (return (call $hash-mix (call $hash-mix (local.get $hash) (i32.wrap_i64 (local.get $bits)))
        (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32)))))))
  #@(if (i32.eq (local.get $tag) (i32.const 16))
    (then (return (call $hash-mix (local.get $hash)
      (if (result i32) (local.get $fold) (then (call $string-upcase-code (call $value-n (local.get $x))))
        (else (call $value-n (local.get $x))))))))
  ;; Symbol hashes use names, never mutable package membership or image-local IDs.
  #@(if (i32.eq (local.get $tag) (i32.const 6))
    (then (return (call $hash-string-code (call $symbol-name (local.get $x)) (local.get $hash) (i32.const 0)))))
  ;; EQ/EQL keys of mutable aggregate types must keep their hash after mutation.
  #@(if (i32.eq (local.get $test) (i32.const ,(runtime-symbol-id 'eql)))
    (then (return (call $hash-mix (local.get $hash) (struct.get $obj $tag (ref.cast (ref $obj) (local.get $x)))))))
  #@(if (i32.eq (local.get $tag) (i32.const 10))
    (then (return (call $hash-string-code (local.get $x) (local.get $hash) (local.get $fold)))))
  #@(if (i32.eq (local.get $tag) (i32.const 28))
    (then (return (call $hash-code (i32.const ,(runtime-symbol-id 'equal))
      (call $pathname-parts (local.get $x)) (local.get $depth)))))
  ;; Bounded structural hashing must terminate for circular and deeply nested keys.
  #@(if (i32.and (i32.eq (local.get $tag) (i32.const 7))
        (i32.ne (local.get $depth) (i32.const 0)))
    (then
