  #@(ref.null eq))

(define-runtime-function $hash-index-add (($table :nullable-object) ($entry :nullable-object)) ()
  (:locals ($scan :nullable-object) ($parent :nullable-object) ($node :nullable-object)
           ($hash i32) ($other i32) ($mask i32))
  #@(local.set $hash (call $value-n (local.get $entry)))
  #@(local.set $scan (struct.get $obj $c (ref.cast (ref $obj) (local.get $table))))
  #@(if (ref.is_null (local.get $scan))
    (then (struct.set $obj $c (ref.cast (ref $obj) (local.get $table)) (local.get $entry)) (return)))
  #@(block $leaf (loop $branch (br_if $leaf (i32.ne (call $tag (local.get $scan)) (i32.const 11)))
    (local.set $parent (local.get $scan))
    (local.set $scan (if (result (ref null eq)) (i32.and (local.get $hash) (call $value-n (local.get $scan)))
