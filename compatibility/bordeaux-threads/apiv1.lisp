;;;; Bordeaux Threads APIv1 over MIRICL's cooperative Wasm scheduler.
(in-package #:bordeaux-threads)

(deftype thread () 'miricl-threads:thread)
(deftype lock () '(satisfies miricl-threads:lockp))
(deftype recursive-lock () 'miricl-threads:recursive-lock)
(deftype semaphore () 'miricl-threads:semaphore)

(defun %make-thread (function name)
  (miricl-threads:make-thread function :name name))
(defun current-thread () (miricl-threads:current-thread))
(defun threadp (object) (miricl-threads:threadp object))
(defun thread-name (thread) (miricl-threads:thread-name thread))
(defun thread-alive-p (thread) (miricl-threads:thread-alive-p thread))
(defun all-threads () (miricl-threads:all-threads))
(defun thread-yield () (miricl-threads:thread-yield))
(defun join-thread (thread) (miricl-threads:join-thread thread))
(defun interrupt-thread (thread function &rest arguments)
  (apply #'miricl-threads:interrupt-thread thread function arguments))
(defun destroy-thread (thread)
  (signal-error-if-current-thread thread)
  (miricl-threads:destroy-thread thread))

(defun lock-p (object) (miricl-threads:lockp object))
(defun recursive-lock-p (object) (miricl-threads:recursive-lock-p object))
(defun make-lock (&optional name) (miricl-threads:make-lock :name name))
(defun acquire-lock (lock &optional (wait-p t))
  (miricl-threads:acquire-lock lock :wait wait-p))
(defun release-lock (lock) (miricl-threads:release-lock lock))
(defmacro with-lock-held ((place) &body body)
  `(miricl-threads:with-lock-held (,place) ,@body))
(defun make-recursive-lock (&optional name)
  (miricl-threads:make-recursive-lock :name name))
(defun acquire-recursive-lock (lock)
  (miricl-threads:acquire-recursive-lock lock))
(defun release-recursive-lock (lock)
  (miricl-threads:release-recursive-lock lock))
(defmacro with-recursive-lock-held ((place &key timeout) &body body)
  `(miricl-threads:with-recursive-lock-held (,place :timeout ,timeout) ,@body))

(defun make-condition-variable (&key name)
  (miricl-threads:make-condition-variable :name name))
(defun condition-wait (condition-variable lock &key timeout)
  ;; The native wait atomically releases the lock and reacquires it on unwind.
  (miricl-threads:condition-wait condition-variable lock :timeout timeout))
(defun condition-notify (condition-variable)
  (miricl-threads:condition-notify condition-variable))
(defun make-semaphore (&key name (count 0))
  (miricl-threads:make-semaphore :name name :count count))
(defun semaphorep (object) (miricl-threads:semaphorep object))
(defun signal-semaphore (semaphore &key (count 1))
  (miricl-threads:signal-semaphore semaphore :count count))
(defun wait-on-semaphore (semaphore &key timeout)
  (miricl-threads:wait-on-semaphore semaphore :timeout timeout))

;; The upstream timeout implementation retains its public condition protocol.
(mark-supported)
