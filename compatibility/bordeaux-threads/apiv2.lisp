;;;; Native hooks for the unchanged Bordeaux Threads APIv2 wrappers.
(in-package #:bordeaux-threads-2)

(deftype native-thread () 'miricl-threads:thread)
(deftype native-lock () '(satisfies miricl-threads:lockp))
(deftype native-recursive-lock () 'miricl-threads:recursive-lock)
(deftype condition-variable () 'miricl-threads:condition-variable)
(deftype semaphore () 'miricl-threads:semaphore)

(defun %make-thread (function name)
  (miricl-threads:make-thread function :name name))
(defun %current-thread () (miricl-threads:current-thread))
(defun %thread-name (thread) (miricl-threads:thread-name thread))
(defun %thread-alive-p (thread) (miricl-threads:thread-alive-p thread))
(defun %all-threads () (miricl-threads:all-threads))
(defun %thread-yield () (miricl-threads:thread-yield))
(defun %interrupt-thread (thread function)
  (miricl-threads:interrupt-thread thread function))
(defun %destroy-thread (thread) (miricl-threads:destroy-thread thread))
(defun %join-thread (thread)
  ;; APIv2 owns the wrapper's captured values and abnormal-exit condition.
  (handler-case (miricl-threads:join-thread thread)
    (miricl-threads:abnormal-exit () nil)))

(defun %make-lock (name) (miricl-threads:make-lock :name name))
(defun %acquire-lock (lock wait-p timeout)
  (miricl-threads:acquire-lock lock :wait wait-p :timeout timeout))
(defun %release-lock (lock) (miricl-threads:release-lock lock))
(defmacro %with-lock ((place timeout) &body body)
  `(miricl-threads:with-lock-held (,place :timeout ,timeout) ,@body))
(defun %make-recursive-lock (name)
  (miricl-threads:make-recursive-lock :name name))
(defun %acquire-recursive-lock (lock wait-p timeout)
  (miricl-threads:acquire-recursive-lock lock :wait wait-p :timeout timeout))
(defun %release-recursive-lock (lock)
  (miricl-threads:release-recursive-lock lock))
(defmacro %with-recursive-lock ((place timeout) &body body)
  `(miricl-threads:with-recursive-lock-held (,place :timeout ,timeout) ,@body))

(defun %make-semaphore (name count)
  (miricl-threads:make-semaphore :name name :count count))
(defun %signal-semaphore (semaphore count)
  (miricl-threads:signal-semaphore semaphore :count count))
(defun %wait-on-semaphore (semaphore timeout)
  (miricl-threads:wait-on-semaphore semaphore :timeout timeout))
(defun %make-condition-variable (name)
  (miricl-threads:make-condition-variable :name name))
(defun %condition-wait (condition-variable lock timeout)
  (miricl-threads:condition-wait condition-variable lock :timeout timeout))
(defun %condition-notify (condition-variable)
  (miricl-threads:condition-notify condition-variable))
(defun %condition-broadcast (condition-variable)
  (miricl-threads:condition-broadcast condition-variable))
