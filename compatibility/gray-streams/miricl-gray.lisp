;;;; Extensible streams. The portable character defaults originate in the
;;;; McCLIM compatibility protocol; ordinary CL I/O uses the runtime bridge.
(defpackage #:miricl-gray
  (:use #:cl)
  (:export #:fundamental-stream #:fundamental-input-stream #:fundamental-output-stream
           #:fundamental-character-stream #:fundamental-binary-stream
           #:fundamental-character-input-stream #:fundamental-character-output-stream
           #:fundamental-binary-input-stream #:fundamental-binary-output-stream
           #:stream-read-char #:stream-unread-char #:stream-read-char-no-hang
           #:stream-peek-char #:stream-listen #:stream-read-line #:stream-clear-input
           #:stream-write-char #:stream-line-column #:stream-start-line-p
           #:stream-write-string #:stream-terpri #:stream-fresh-line
           #:stream-finish-output #:stream-force-output #:stream-clear-output
           #:stream-advance-to-column #:stream-read-byte #:stream-write-byte
           #:stream-read-sequence #:stream-write-sequence #:stream-file-position))
(in-package #:miricl-gray)

(defun %private (name)
  (or (miricl-compiler::compiler-primitive 10 1 name)
      (error "The extensible stream runtime is unavailable: ~A." name)))

;; Native default methods enter the preserved primitive without reentering the
;; public generic. Gray components of native constructed streams still dispatch.
(eval-when (:load-toplevel :execute)
  (dolist (entry '((close (stream &key abort)) (open-stream-p (stream))
                   (stream-element-type (stream))))
    (unless (typep (fdefinition (first entry)) 'generic-function)
      (let ((original (fdefinition (first entry)))
            (operation (position (first entry) '(nil nil nil open-stream-p stream-element-type close))))
        (setf (fdefinition (first entry))
              (lambda (&rest arguments)
                (progv (list (%private "%GRAY-NATIVE-CALL")) (list (cons operation (first arguments)))
                  (apply original arguments)))))
      (funcall (%private "%PROMOTE") (first entry) (second entry) '(t) nil))))

(defmethod miricl-mop:validate-superclass
    ((class standard-class) (superclass (eql (find-class 'stream))))
  (declare (ignore class superclass)) t)

(defclass fundamental-stream (stream standard-object)
  ((open-p :initform t :accessor %open-p)
   ;; Pending characters belong to the stream, including across recursive READs
   ;; on other streams. The reader may inspect arbitrarily far ahead; it never
   ;; imposes multiple UNREAD-CHAR calls on the user's one-character protocol.
   (pending :initform nil :accessor %pending)
   (last-character :initform nil :accessor %last-character)))
(defclass fundamental-input-stream (fundamental-stream) ())
(defclass fundamental-output-stream (fundamental-stream) ())
(defclass fundamental-character-stream (fundamental-stream) ())
(defclass fundamental-binary-stream (fundamental-stream) ())
(defclass fundamental-character-input-stream (fundamental-input-stream fundamental-character-stream) ())
(defclass fundamental-character-output-stream (fundamental-output-stream fundamental-character-stream) ())
(defclass fundamental-binary-input-stream (fundamental-input-stream fundamental-binary-stream) ())
(defclass fundamental-binary-output-stream (fundamental-output-stream fundamental-binary-stream) ())

(defmethod close ((stream fundamental-stream) &key abort) (declare (ignore abort)) t)
(defmethod close :around ((stream fundamental-stream) &key abort)
  (declare (ignore abort))
  (prog1 (call-next-method) (setf (%open-p stream) nil)))
(defmethod open-stream-p ((stream fundamental-stream)) (%open-p stream))
(defmethod stream-element-type ((stream fundamental-stream))
  ;; Direction-only subclasses are character streams in this extension. Binary
  ;; subclasses must supply their actual element type, rather than assuming u8.
  (if (typep stream 'fundamental-binary-stream)
      (error "A binary Gray stream must define STREAM-ELEMENT-TYPE.") 'character))

(defgeneric stream-read-char (stream))
(defgeneric stream-unread-char (stream character))
(defgeneric stream-read-char-no-hang (stream))
(defgeneric stream-peek-char (stream))
(defgeneric stream-listen (stream))
(defgeneric stream-read-line (stream))
(defgeneric stream-clear-input (stream))
(defgeneric stream-write-char (stream character))
(defgeneric stream-line-column (stream))
(defgeneric stream-start-line-p (stream))
(defgeneric stream-write-string (stream string &optional start end))
(defgeneric stream-terpri (stream))
(defgeneric stream-fresh-line (stream))
(defgeneric stream-finish-output (stream))
(defgeneric stream-force-output (stream))
(defgeneric stream-clear-output (stream))
(defgeneric stream-advance-to-column (stream column))
(defgeneric stream-read-byte (stream))
(defgeneric stream-write-byte (stream byte))
(defgeneric stream-read-sequence (stream sequence start end &key &allow-other-keys))
(defgeneric stream-write-sequence (stream sequence start end &key &allow-other-keys))
(defgeneric stream-file-position (stream &optional position))

(defvar *raw-access* nil)
(defun %character-result (value &optional no-hang)
  (unless (or (characterp value) (eq value :eof) (and no-hang (null value)))
    (error 'type-error :datum value :expected-type
           (if no-hang '(or character null (eql :eof)) '(or character (eql :eof)))))
  value)
(defun %check-open (stream)
  (unless (and (funcall (fdefinition 'open-stream-p) stream) (%open-p stream))
    (error 'stream-error :stream stream)))
(defun %check-pending (stream)
  (let ((pending (%pending stream)))
    (unless (or (null pending) (list-length pending))
      (error 'stream-error :stream stream))
    (dolist (character pending) (check-type character character))
    pending))
(defun %raw-read (stream)
  (let ((*raw-access* stream)) (%character-result (stream-read-char stream))))
(defun %lookahead (stream ahead take)
  (%check-open stream)
  (check-type ahead (integer 0 2147483647))
  (%check-pending stream)
  (when (and (zerop ahead) (not take) (null (%pending stream)))
    (return-from %lookahead (%character-result (stream-peek-char stream))))
  (loop while (<= (length (%pending stream)) ahead) do
    (let ((character (%raw-read stream)))
      (%check-pending stream)
      (when (eq character :eof) (return-from %lookahead :eof))
      (setf (%pending stream) (nconc (%pending stream) (list character)))))
  (let ((character (nth ahead (%pending stream))))
    (when take
      (setf (%pending stream) (nthcdr (1+ ahead) (%pending stream))
            (%last-character stream) character))
    character))
(defmethod stream-read-char :around ((stream fundamental-input-stream))
  (if (eq *raw-access* stream) (call-next-method)
      (let ((value (if (%check-pending stream) (pop (%pending stream)) (call-next-method))))
        (%character-result value)
        (setf (%last-character stream) (and (characterp value) value)) value)))
(defmethod stream-unread-char :around ((stream fundamental-input-stream) character)
  (if (eq *raw-access* stream) (call-next-method)
      (progn
        (unless (and (characterp character) (eql character (%last-character stream)))
          (error 'stream-error :stream stream))
        (if (%check-pending stream)
            (push character (%pending stream))
            ;; With no later lookahead the physical and logical last read
            ;; coincide, so preserve the user's actual unread method/effects.
            (call-next-method))
        (setf (%last-character stream) nil) nil)))
(defmethod stream-read-char-no-hang :around ((stream fundamental-input-stream))
  (if (eq *raw-access* stream) (call-next-method)
      (let ((value (if (%pending stream) (pop (%pending stream)) (call-next-method))))
        (%character-result value t)
        (setf (%last-character stream) (and (characterp value) value)) value)))
(defmethod stream-peek-char :around ((stream fundamental-input-stream))
  (if (and (not (eq *raw-access* stream)) (%check-pending stream)) (car (%pending stream))
      (%character-result (call-next-method))))
(defmethod stream-listen :around ((stream fundamental-input-stream))
  (if (and (not (eq *raw-access* stream)) (%pending stream)) t (not (null (call-next-method)))))
(defmethod stream-clear-input :around ((stream fundamental-input-stream))
  (setf (%pending stream) nil (%last-character stream) nil)
  (call-next-method))
(defmethod stream-read-char-no-hang ((stream fundamental-input-stream)) (stream-read-char stream))
(defmethod stream-peek-char ((stream fundamental-input-stream))
  (let ((character (stream-read-char stream)))
    (unless (eq character :eof) (stream-unread-char stream character)) character))
(defmethod stream-listen ((stream fundamental-input-stream)) nil)
(defun %read-line (stream)
  (let ((characters (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
    (loop for character = (stream-read-char stream) do
      (cond ((eq character :eof) (return (values characters t)))
            ((char= character #\Newline) (return (values characters nil)))
            (t (vector-push-extend character characters))))))
(defmethod stream-read-line ((stream fundamental-input-stream)) (%read-line stream))
(defmethod stream-read-line :around ((stream fundamental-input-stream))
  (let ((prefix (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
    (unless (eq *raw-access* stream)
      (loop while (%check-pending stream) do
        (let ((character (pop (%pending stream))))
          (when (char= character #\Newline)
            (return-from stream-read-line (values prefix nil)))
          (vector-push-extend character prefix))))
    (multiple-value-bind (line missing-newline) (call-next-method)
      (check-type line string)
      (values (if (zerop (length prefix)) line (concatenate 'string prefix line))
              (not (null missing-newline))))))
(defmethod stream-clear-input ((stream fundamental-input-stream)) nil)
(defmethod stream-line-column ((stream fundamental-output-stream)) nil)
(defun %column (stream)
  (let ((column (stream-line-column stream)))
    (unless (or (null column) (typep column '(integer 0)))
      (error 'type-error :datum column :expected-type '(or null (integer 0))))
    column))
(defmethod stream-start-line-p ((stream fundamental-output-stream)) (eql (%column stream) 0))
(defmethod stream-write-string ((stream fundamental-output-stream) string &optional (start 0) end)
  (loop for index from start below (or end (length string)) do
    (stream-write-char stream (char string index))) string)
(defmethod stream-terpri ((stream fundamental-output-stream)) (stream-write-char stream #\Newline) nil)
(defmethod stream-fresh-line ((stream fundamental-output-stream))
  (unless (stream-start-line-p stream) (stream-terpri stream) t))
(defmethod stream-finish-output ((stream fundamental-output-stream)) nil)
(defmethod stream-force-output ((stream fundamental-output-stream)) nil)
(defmethod stream-clear-output ((stream fundamental-output-stream)) nil)
(defmethod stream-advance-to-column ((stream fundamental-output-stream) column)
  (let ((current (%column stream)))
    (when current (loop repeat (max 0 (- column current)) do (stream-write-char stream #\Space)) t)))
(defmethod stream-file-position ((stream fundamental-stream) &optional position)
  (declare (ignore position)) nil)

;; These are runtime type queries, not compiler proofs. Validate the type
;; expression shell before the target's ordinary TYPEP/SUBTYPEP machinery.
(defun %element-type (stream)
  (let ((type (funcall (fdefinition 'stream-element-type) stream)))
    (miricl-compiler::compiler-type-specifier type) type))
(defun %binary-p (stream)
  (multiple-value-bind (integerp knownp) (subtypep (%element-type stream) 'integer)
    (and knownp integerp)))
(defun %byte-result (stream value &optional (eofp t))
  (unless (and eofp (eq value :eof))
    (let ((type (%element-type stream)))
      (unless (and (integerp value) (typep value type))
        (error 'type-error :datum value :expected-type (list 'and 'integer type)))))
  value)
(defun %sequence-end (sequence start end)
  (let ((length (if (listp sequence)
                    (or (list-length sequence) (error "Circular stream sequence."))
                    (length sequence))))
    (unless (and (integerp start) (<= 0 start) (integerp end) (<= start end length))
      (error "Invalid stream sequence bounds ~S and ~S." start end))
    end))
(defun %bounds-packet (packet)
  (unless (and (vectorp packet) (= (length packet) 2))
    (error 'type-error :datum packet :expected-type '(vector t 2)))
  (values (aref packet 0) (aref packet 1)))
(defun %read-sequence-index (value start end)
  (unless (and (integerp value) (<= start value end))
    (error 'type-error :datum value :expected-type (list 'integer start end))) value)

(defmethod stream-read-sequence ((stream fundamental-input-stream) sequence start end &key)
  (%sequence-end sequence start end)
  (loop for index from start below end do
    (%check-open stream)
    (let* ((binary (%binary-p stream))
           (value (if binary (%byte-result stream (stream-read-byte stream))
                      (%character-result (stream-read-char stream)))))
      (when (eq value :eof) (return-from stream-read-sequence index))
      ;; The callback can adjust an array or replace a list's reachable tail.
      (%sequence-end sequence index end)
      (setf (elt sequence index) value)))
  end)
(defmethod stream-read-sequence :around
    ((stream fundamental-input-stream) sequence start end &key)
  (%sequence-end sequence start end)
  (let ((index start))
    (when (%check-pending stream)
      (when (%binary-p stream)
        (error "Cannot read binary elements while character lookahead is pending."))
      (loop while (and (< index end) (%check-pending stream)) do
        (%sequence-end sequence index end)
        (setf (elt sequence index) (pop (%pending stream)))
        (incf index)))
    (when (= index end) (return-from stream-read-sequence index))
    (let ((result (if (= index start) (call-next-method)
                      (call-next-method stream sequence index end))))
      (%sequence-end sequence index end)
      (%read-sequence-index result index end))))
(defmethod stream-write-sequence ((stream fundamental-output-stream) sequence start end &key)
  (%sequence-end sequence start end)
  (loop for index from start below end do
    (%check-open stream)
    (let ((binary (%binary-p stream)))
      (%sequence-end sequence index end)
      (let ((value (elt sequence index)))
        (if binary
            (progn (%byte-result stream value nil) (stream-write-byte stream value))
            (progn (check-type value character) (stream-write-char stream value))))))
  sequence)

;; Numeric operation tags belong solely to the runtime/optional-module boundary.
;; Every callback value is checked here before a native extractor consumes it.
(defun %dispatch (operation stream a b)
  (when (zerop operation) (return-from %dispatch (typep stream 'fundamental-stream)))
  (case operation
    (3 (return-from %dispatch (funcall (fdefinition 'open-stream-p) stream)))
    (4 (return-from %dispatch (funcall (fdefinition 'stream-element-type) stream)))
    (5 (return-from %dispatch (funcall (fdefinition 'close) stream :abort a))))
  (check-type stream fundamental-stream)
  (case operation
    (1 (return-from %dispatch (typep stream 'fundamental-input-stream)))
    (2 (return-from %dispatch (typep stream 'fundamental-output-stream)))
    (6 (return-from %dispatch nil)))
  (%check-open stream)
  (when (and (member operation '(9 10 11 12 13 19 21 24 25 26 27))
             (not (typep stream 'fundamental-output-stream)))
    (error 'type-error :datum stream :expected-type 'fundamental-output-stream))
  (case operation
    (7 (%lookahead stream a b))
    (8 (stream-unread-char stream a) nil)
    (9 (let ((column (%column stream))) (and column (min column 2147483647))))
    (10 (stream-write-string stream a 0 (length a)) nil)
    (11 (stream-clear-output stream) nil)
    (12 (stream-finish-output stream) nil)
    (13 (stream-force-output stream) nil)
    (14 (not (null (stream-listen stream))))
    (15 (stream-clear-input stream) nil)
    (16 (%character-result (stream-read-char-no-hang stream) t))
    (17 (multiple-value-bind (line missing) (stream-read-line stream)
          (check-type line string)
          (values (if (and missing (zerop (length line)))
                      (if a (error 'end-of-file :stream stream) b) line)
                  (not (null missing)))))
    (19 (not (null (stream-fresh-line stream))))
    (18 (let ((position (if b (stream-file-position stream a) (stream-file-position stream))))
          (if b
              (progn
                (when position (setf (%pending stream) nil (%last-character stream) nil))
                (not (null position)))
              (progn
                (unless (or (null position) (typep position '(integer 0)))
                  (error 'type-error :datum position :expected-type '(or null (integer 0))))
                ;; Buffered characters need not correspond one-to-one to bytes.
                (unless (%check-pending stream) position)))))
    (20 (unless (%binary-p stream) (error "READ-BYTE requires a binary stream."))
        (when (%check-pending stream) (error "Character lookahead is pending on this stream."))
        (%byte-result stream (stream-read-byte stream)))
    (21 (unless (%binary-p stream) (error "WRITE-BYTE requires a binary stream."))
        (%byte-result stream a nil) (stream-write-byte stream a) nil)
    (22 (%binary-p stream))
    (23 (multiple-value-bind (start end) (%bounds-packet b)
          (%sequence-end a start end)
          (let ((index (stream-read-sequence stream a start end)))
            (%sequence-end a start end)
            (%read-sequence-index index start end))))
    (24 (multiple-value-bind (start end) (%bounds-packet b)
          (%sequence-end a start end)
          (stream-write-sequence stream a start end) nil))
    (25 (check-type a character) (stream-write-char stream a) nil)
    (26 (multiple-value-bind (start end) (%bounds-packet b)
          (check-type a string) (%sequence-end a start end)
          (stream-write-string stream a start end) nil))
    (27 (stream-terpri stream) nil)
    (otherwise (error "Unsupported Gray stream bridge operation ~S." operation))))
(eval-when (:load-toplevel :execute)
  (setf (symbol-value (%private "%GRAY-DISPATCH")) #'%dispatch))
