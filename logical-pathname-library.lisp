;;;; Logical hosts and wildcard translation share the physical pathname layout.
(defparameter %logical-hosts nil)
(defun %logical-host-entry (host)
  (unless (stringp host) (error 'type-error :datum host :expected-type 'string))
  (assoc host %logical-hosts :test #'string-equal))
(defun %logical-string-host (text)
  (let ((colon (position #\: text)))
    (when colon (let ((host (subseq text 0 colon)))
      (when (%logical-host-entry host) (string-upcase host))))))
(defun %logical-component (text)
  (cond ((string= text "") nil) ((string= text "*") :wild)
        ((string= text "**") :wild-inferiors) (t (string-upcase text))))
(defun %logical-text (parts)
  (let ((directory (third parts)) (type (fifth parts)) (version (sixth parts)))
    (format nil "~A:~A~{~A;~}~A~A~A~A~A"
      (first parts) (if (and directory (eq (car directory) :relative)) ";" "")
      (mapcar #'%pathname-component-string (cdr directory))
      (%pathname-component-string (or (fourth parts) ""))
      (if (or type version) "." "") (%pathname-component-string (or type ""))
      (if version "." "")
      (case version (:newest "NEWEST") (:wild "*") (otherwise (or version ""))))))
(defun %make-logical-parts (parts)
  (setq parts (mapcar #'%copy-path-component parts))
  (setf (first parts) (string-upcase (first parts)) (second parts) :unspecific)
  (loop for cell on (cddr parts) do
    (setf (car cell) (let ((value (car cell)))
      (cond ((stringp value) (string-upcase value))
            ((consp value) (mapcar (lambda (x) (if (stringp x) (string-upcase x) x)) value))
            (t value)))))
  (%%make-logical-path (%logical-text parts) parts))
(defun %parse-logical (text host)
  (let* ((colon (position #\: text)) (start (if colon (1+ colon) 0))
         (host (if colon (subseq text 0 colon) host)) (directory nil) (fields nil) (word start))
    (unless (and host (%logical-host-entry host))
      (error 'type-error :datum text :expected-type '(or logical-pathname stream)))
    (loop for i from start below (length text) for c = (char text i) do
      (unless (or (and (char>= c #\a) (char<= c #\z)) (and (char>= c #\A) (char<= c #\Z))
                  (and (char>= c #\0) (char<= c #\9)) (find c "-.*;"))
        (error 'type-error :datum text :expected-type 'logical-pathname)))
    (when (and (< start (length text)) (char= (char text start) #\;))
      (setq directory '(:relative) start (1+ start) word start))
    (unless directory (setq directory '(:absolute)))
    (loop for i from start below (length text) when (char= (char text i) #\;) do
      (when (= word i) (error 'parse-error))
      (setq directory (append directory (list (%logical-component (subseq text word i)))) word (1+ i)))
    (loop for i from word to (length text) when (or (= i (length text)) (char= (char text i) #\.)) do
      (push (%logical-component (subseq text word i)) fields) (setq word (1+ i)))
    (setq fields (nreverse fields))
    (when (> (length fields) 3) (error 'parse-error))
    (let ((version (third fields)))
      (when version
        (setq version (cond ((eq version :wild) :wild) ((equal version "NEWEST") :newest)
                            ((and (stringp version) (every #'digit-char-p version)) (parse-integer version))
                            (t (error 'parse-error)))))
      (%make-logical-parts (list (string-upcase host) :unspecific directory (first fields) (second fields) version)))))
(defun logical-pathname (pathspec)
  (cond ((typep pathspec 'logical-pathname) pathspec)
        ((stringp pathspec) (%parse-logical pathspec nil))
        ((or (typep pathspec 'file-stream) (typep pathspec 'synonym-stream))
         (logical-pathname (pathname pathspec)))
        (t (error 'type-error :datum pathspec :expected-type '(or logical-pathname string file-stream)))))
(defun logical-pathname-translations (host)
  (let ((entry (%logical-host-entry host)))
    (unless entry (error 'type-error :datum host :expected-type 'string))
    (cdr entry)))
(defun (setf logical-pathname-translations) (translations host)
  (let ((entry (%logical-host-entry host)))
    (unless entry (setq entry (cons (string-upcase host) nil)) (push entry %logical-hosts))
    (let ((rules (mapcar (lambda (rule)
      (unless (and (consp rule) (consp (cdr rule))) (error 'type-error :datum rule :expected-type 'list))
      (list (if (stringp (first rule)) (%parse-logical (first rule) host) (logical-pathname (first rule)))
            (pathname (second rule)))) translations)))
      (setf (cdr entry) rules))
    translations))
(defun load-logical-pathname-translations (host)
  (if (%logical-host-entry host) nil
    (let ((file (format nil "/logical-pathnames/~A.lisp" (string-upcase host))))
      (load file)
      (unless (%logical-host-entry host) (error 'file-error :pathname file)) t)))

;; A successful capture is (T . captures); NIL means no match. Captures are
;; substrings or directory lists, so translation never mutates source metadata.
(defun %pathname-string-captures (text pattern)
  (labels ((match (i p)
    (let ((star (position #\* pattern :start p)))
      (if (null star)
        (and (string= text pattern :start1 i :start2 p) (list t))
        (let ((prefix (- star p)))
          (when (and (<= (+ i prefix) (length text))
                     (string= text pattern :start1 i :end1 (+ i prefix) :start2 p :end2 star))
            (loop for end from (+ i prefix) to (length text)
              for rest = (match end (1+ star)) when rest do
                (return (cons t (cons (subseq text (+ i prefix) end) (cdr rest)))))))))))
    (match 0 0)))
(defun %pathname-directory-captures (parts pattern)
  (cond ((null pattern) (and (null parts) (list t)))
        ((eq (car pattern) :wild-inferiors)
         (loop for tail on (append parts (list nil)) for n from 0
           for remaining = (nthcdr n parts)
           for rest = (%pathname-directory-captures remaining (cdr pattern))
           when rest return (cons t (cons (subseq parts 0 n) (cdr rest)))))
        ((null parts) nil)
        (t (let ((rest (%pathname-directory-captures (cdr parts) (cdr pattern))))
             (when (and rest (%pathname-component-match-p (car parts) (car pattern)))
               (if (eq (car pattern) :wild) (cons t (cons (list (car parts)) (cdr rest))) rest))))))
(defun %pathname-insert-string (source from to)
  (cond ((or (null to) (eq to :wild)) source)
        ((and (stringp to) (position #\* to))
         (let ((captures (and (stringp source) (stringp from) (%pathname-string-captures source from)))
               (start 0) (pieces nil))
           (unless captures (error 'error))
           (setq captures (cdr captures))
           (loop for i below (length to) when (char= (char to i) #\*) do
             (unless captures (error 'error))
             (push (subseq to start i) pieces) (push (pop captures) pieces) (setq start (1+ i)))
           (apply #'concatenate 'string (append (nreverse pieces) (list (subseq to start))))))
        (t to)))
(defun translate-pathname (source from-wildcard to-wildcard &key)
  (let* ((source (pathname source)) (from (pathname from-wildcard)) (to (pathname to-wildcard))
         (s (%pathname-parts source)) (f (%pathname-parts from)) (target (%pathname-parts to))
         (flip (not (eq (typep source 'logical-pathname) (typep to 'logical-pathname))))
         (captures (if (null (third f)) (list t (cdr (third s)))
                     (%pathname-directory-captures (or (third s) (and (typep source 'logical-pathname) '(:absolute))) (third f)))) (directory nil))
    (unless (pathname-match-p source from) (error 'error))
    (setq captures (cdr captures))
    (when flip (setq captures (mapcar (lambda (x) (%pathname-case x :common)) captures)))
    (if (null (third target)) (setq directory (if flip (%pathname-case (third s) :common) (third s)))
      (dolist (part (third target))
        (if (member part '(:wild :wild-inferiors))
          (progn (unless captures (error 'error)) (setq directory (append directory (pop captures))))
          (setq directory (append directory (list part))))))
    (%pathname-from-parts
      (list (first target) (second target)
        directory
        (%pathname-insert-string (if flip (%pathname-case (fourth s) :common) (fourth s))
          (if flip (%pathname-case (fourth f) :common) (fourth f)) (fourth target))
        (%pathname-insert-string (if flip (%pathname-case (fifth s) :common) (fifth s))
          (if flip (%pathname-case (fifth f) :common) (fifth f)) (fifth target))
        (%pathname-insert-string (sixth s) (sixth f) (sixth target))))))
(defun translate-logical-pathname (pathspec &key)
  (let ((path (pathname pathspec)) (seen nil))
    (loop while (typep path 'logical-pathname) do
      (when (member path seen :test #'equal) (error 'file-error :pathname path))
      (push path seen)
      (let ((rule (find path (logical-pathname-translations (pathname-host path)) :key #'car :test #'pathname-match-p)))
        (unless rule (error 'file-error :pathname path))
        (setq path (translate-pathname path (first rule) (second rule)))))
    path))
