;;;; Shared trigonometric and exponential kernels without host math imports.
(in-package #:miricl)
(named-readtables:in-readtable :miricl-wat)

(defun elementary-factorial (n)
  (loop for i from 2 to n for product = i then (* product i)
        finally (return (if (< n 2) 1 product))))

(defun fixed-two-over-pi (bits)
  "Build an integer approximation using Machin's formula and guard bits."
  (let ((scale (ash 1 (+ bits 64))))
    (labels ((inverse-atan (q)
               (loop for power = q then (* power q q)
                     for odd from 1 by 2
                     for sign = 1 then (- sign)
                     for term = (truncate scale (* power odd))
                     until (zerop term) sum (* sign term))))
      (truncate (ash scale (1+ bits))
                (- (* 16 (inverse-atan 5)) (* 4 (inverse-atan 239)))))))

(define-runtime-function $reduce-large-angle (($x f64)) (f64 i32)
  (:locals ($mantissa i64) ($exponent i32) ($shift i32) ($quadrant i32)
           ($product :object) ($whole :object) ($denominator :object) ($fraction :object))
  #@(if (ref.is_null (global.get $two-over-pi))
    (then (global.set $two-over-pi
      (call $integer (i32.const 1)
        ,(let ((digits (loop with n = (fixed-two-over-pi 2304)
                             until (zerop n) collect (ldb (byte 15 0) n)
                             do (setf n (ash n -15)))))
           `(array.new_fixed $digits ,(length digits)
              ,@(loop for digit in digits collect `(i32.const ,digit))))))))
  #@(call $float-parts (call $float (i32.const 4) (local.get $x)))
  #@(local.set $exponent) #@(local.set $mantissa)
  #@(local.set $shift (i32.sub (i32.const 2304) (local.get $exponent)))
  #@(local.set $product (call $imul (call $uint64 (local.get $mantissa))
    (ref.as_non_null (global.get $two-over-pi))))
  #@(local.set $whole (ref.as_non_null (call $ash-native (local.get $product)
    (call $int (i32.sub (i32.const 0) (local.get $shift))))))
  #@(local.set $quadrant (i32.and (call $digit (local.get $whole) (i32.const 0)) (i32.const 3)))
  #@(local.set $fraction (call $iadd (local.get $product)
    (call $negative (ref.as_non_null (call $ash-native (local.get $whole) (call $int (local.get $shift)))))))
  #@(local.set $denominator (ref.as_non_null (call $ash-native (call $int (i32.const 1))
    (call $int (local.get $shift)))))
  #@(if (i32.gt_s (call $cmpabs (local.get $fraction)
    (ref.as_non_null (call $ash-native (local.get $denominator) (call $int (i32.const -1))))) (i32.const 0))
    (then (local.set $fraction (call $iadd (local.get $fraction) (call $negative (local.get $denominator))))
      (local.set $quadrant (i32.and (i32.add (local.get $quadrant) (i32.const 1)) (i32.const 3)))))
  ;; Only the float converter sees this temporary fraction. Its numerator and
  ;; denominator need no GCD: conversion rounds their quotient directly.
  #@(f64.mul (call $coerce-float (call $node (i32.const 2) (i32.const 0)
    (local.get $fraction) (local.get $denominator) (ref.null eq)) (i32.const 4))
    (f64.const 1.5707963267948966))
  #@(local.get $quadrant))

(define-runtime-function $sincos-f64 (($x f64)) (f64 f64)
  (:locals ($r f64) ($tail f64) ($n f64) ($t f64) ($square f64)
           ($sine f64) ($cosine f64) ($swap f64) ($quadrant i32))
  #@(if (f64.lt (f64.abs (local.get $x)) (f64.const 1e-8))
    (then (return (local.get $x) (f64.const 1))))
  #@(local.set $r (f64.abs (local.get $x)))
  #@(if (f64.gt (local.get $r) (f64.const 0.7853981633974483))
    (then
      (if (f64.lt (local.get $r) (f64.const 1048576))
        (then
          (local.set $n (f64.nearest (f64.mul (local.get $r) (f64.const 0.6366197723675814))))
          (local.set $quadrant (i32.and (i32.trunc_f64_u (local.get $n)) (i32.const 3)))
          ;; The first two split constants have 33 significant bits, so their
          ;; products with n are exact throughout this fast reduction range.
          (local.set $r (f64.sub (local.get $r) (f64.mul (local.get $n) (f64.const 1.5707963267341256))))
          (local.set $t (f64.mul (local.get $n) (f64.const 6.077100506303966e-11)))
          (local.set $swap (f64.sub (local.get $r) (local.get $t)))
          (local.set $tail (f64.sub (f64.sub (f64.sub (local.get $r) (local.get $swap)) (local.get $t))
            (f64.mul (local.get $n) (f64.const 2.0222662487959506e-21))))
          (local.set $r (local.get $swap)))
        (else (call $reduce-large-angle (local.get $r))
          (local.set $quadrant) (local.set $r)))))
  #@(local.set $square (f64.mul (local.get $r) (local.get $r)))
  #@(local.set $sine (f64.add (local.get $r)
    (f64.mul (f64.mul (local.get $r) (local.get $square))
      ,(wat-horner-polynomial '$square
         (loop for i from 1 to 8 collect (/ (if (oddp i) -1 1) (elementary-factorial (1+ (* i 2)))))))))
  #@(local.set $cosine (f64.add (f64.const 1)
    (f64.mul (local.get $square)
      ,(wat-horner-polynomial '$square
         (loop for i from 1 to 9 collect (/ (if (oddp i) -1 1) (elementary-factorial (* i 2))))))))
  #@(local.set $swap (local.get $sine))
  #@(local.set $sine (f64.add (local.get $sine) (f64.mul (local.get $tail) (local.get $cosine))))
  #@(local.set $cosine (f64.sub (local.get $cosine) (f64.mul (local.get $tail) (local.get $swap))))
  #@(if (i32.and (local.get $quadrant) (i32.const 1))
    (then (local.set $swap (local.get $sine))
      (local.set $sine (local.get $cosine)) (local.set $cosine (f64.neg (local.get $swap)))))
  #@(if (i32.and (local.get $quadrant) (i32.const 2))
    (then (local.set $sine (f64.neg (local.get $sine))) (local.set $cosine (f64.neg (local.get $cosine)))))
  #@(if (i64.lt_s (i64.reinterpret_f64 (local.get $x)) (i64.const 0))
    (then (local.set $sine (f64.neg (local.get $sine)))))
  #@(local.get $sine) #@(local.get $cosine))

(define-runtime-function $expm1-small-f64 (($x f64)) (f64)
  #@(f64.mul (local.get $x)
    ,(wat-horner-polynomial '$x (loop for i from 1 to 16 collect (/ (elementary-factorial i))))))

(define-runtime-function $exp-f64 (($x f64) ($adjust i32)) (f64)
  (:locals ($n f64) ($r f64))
  ;; Callers diagnose positive overflow before constructing a Lisp float.
  #@(if (f64.gt (f64.add (local.get $x) (f64.mul (f64.convert_i32_s (local.get $adjust))
    (f64.const 0.6931471805599453))) (f64.const 709.782712893384))
    (then (return (f64.reinterpret_i64 (i64.const 9218868437227405312)))))
  #@(if (f64.lt (local.get $x) (f64.const -745.1332191019412)) (then (return (f64.const 0))))
  #@(local.set $n (f64.nearest (f64.mul (local.get $x) (f64.const 1.4426950408889634))))
  #@(local.set $r (f64.sub
    (f64.sub (local.get $x) (f64.mul (local.get $n) (f64.const 0.6931471803691238)))
    (f64.mul (local.get $n) (f64.const 1.9082149292705877e-10))))
  #@(call $scale-binary (f64.add (f64.const 1) (call $expm1-small-f64 (local.get $r)))
    (i32.add (i32.trunc_f64_s (local.get $n)) (local.get $adjust))))

(define-runtime-function $sinhcosh-f64 (($x f64)) (f64 f64)
  (:locals ($h f64) ($c f64) ($s f64))
  #@(if (f64.lt (f64.abs (local.get $x)) (f64.const 0.5))
    (then
      (local.set $h (call $expm1-small-f64 (local.get $x)))
      (local.set $s (f64.mul (f64.const 0.5)
        (f64.add (local.get $h) (f64.div (local.get $h) (f64.add (f64.const 1) (local.get $h))))))
      (local.set $c (f64.add (f64.const 1) (f64.mul (f64.const 0.5)
        (f64.mul (local.get $h) (f64.div (local.get $h) (f64.add (f64.const 1) (local.get $h))))))))
    (else
      (local.set $h (call $exp-f64 (f64.abs (local.get $x)) (i32.const -1)))
      (local.set $c (f64.add (local.get $h) (f64.div (f64.const 0.25) (local.get $h))))
      (local.set $s (f64.copysign (f64.sub (local.get $h) (f64.div (f64.const 0.25) (local.get $h))) (local.get $x)))))
  #@(local.get $s) #@(local.get $c))

(define-runtime-function $complex-tan-f64 (($x f64) ($y f64)) (f64 f64)
  (:locals ($s f64) ($c f64) ($t f64) ($d f64) ($sh f64) ($ch f64))
  #@(call $sincos-f64 (local.get $x)) #@(local.set $c) #@(local.set $s)
  #@(if (f64.gt (f64.abs (local.get $y)) (f64.const 20))
    (then
      ;; Double sine/cosine rather than x, which can be the largest float.
      (local.set $t (f64.mul (f64.const 2) (f64.mul (local.get $s) (local.get $c))))
      (local.set $c (f64.mul (f64.sub (local.get $c) (local.get $s)) (f64.add (local.get $c) (local.get $s))))
      (local.set $s (local.get $t))
      (local.set $t (if (result f64) (f64.gt (f64.abs (local.get $y)) (f64.const 373))
        (then (f64.const 0))
        (else (call $exp-f64 (f64.mul (f64.const -2) (f64.abs (local.get $y))) (i32.const 0)))))
      (local.set $d (f64.add (f64.const 1)
        (f64.add (f64.mul (f64.const 2) (f64.mul (local.get $c) (local.get $t))) (f64.mul (local.get $t) (local.get $t)))))
      (return (f64.div (f64.mul (f64.const 2) (f64.mul (local.get $s) (local.get $t))) (local.get $d))
        (f64.copysign (f64.div (f64.sub (f64.const 1) (f64.mul (local.get $t) (local.get $t))) (local.get $d)) (local.get $y)))))
  #@(call $sinhcosh-f64 (local.get $y))
  #@(local.set $ch) #@(local.set $sh)
  ;; This denominator remains accurate near the real poles, where adding
  ;; cos(2x) to cosh(2y) would cancel nearly equal numbers.
  #@(local.set $d (f64.add (f64.mul (local.get $c) (local.get $c)) (f64.mul (local.get $sh) (local.get $sh))))
  #@(f64.div (f64.mul (local.get $s) (local.get $c)) (local.get $d))
  #@(f64.div (f64.mul (local.get $sh) (local.get $ch)) (local.get $d)))

(define-runtime-function $elementary-error (($type i32) ($operation i32) ($args :nullable-object)) ()
  #@(drop (call $apply (call $symbol (i32.const ,(runtime-symbol-id 'error)))
    (call $cons (call $symbol (local.get $type))
      (call $cons (call $symbol (i32.const ,(runtime-symbol-id :operation)))
        (call $cons (call $symbol (local.get $operation))
          (call $cons (call $symbol (i32.const ,(runtime-symbol-id :operands)))
            (call $cons (local.get $args) (ref.null eq))))))))
  #@(unreachable))

(define-runtime-function $elementary-float
    (($kind i32) ($value f64) ($operation i32) ($args :nullable-object)) (:object)
  #@(if (f64.ne (local.get $value) (local.get $value))
    (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-invalid-operation))
      (local.get $operation) (local.get $args))))
  #@(if (i32.eq (local.get $kind) (i32.const 3))
    (then
      ;; Diagnose before demotion: an embedding host may enable IEEE traps.
      (if (f64.ge (f64.abs (local.get $value)) (f64.const 3.4028235677973366e38))
        (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
          (local.get $operation) (local.get $args))))
      (local.set $value (f64.promote_f32 (f32.demote_f64 (local.get $value))))))
  #@(if (i64.eq (i64.and (i64.reinterpret_f64 (local.get $value)) (i64.const 9218868437227405312))
      (i64.const 9218868437227405312))
    (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
      (local.get $operation) (local.get $args))))
  #@(call $float (local.get $kind) (local.get $value)))

(define-runtime-function $elementary-native (($id i32) ($args :nullable-object)) (:object)
  (:locals ($z :object) ($kind i32) ($complex i32) ($x f64) ($y f64)
           ($s f64) ($c f64) ($sh f64) ($ch f64) ($r f64) ($i f64) ($h f64))
  #@(local.set $z (call $number (call $car (local.get $args))))
  #@(local.set $kind (call $transcendental-kind (local.get $z)))
  #@(local.set $complex (i32.eq (call $tag (local.get $z)) (i32.const 5)))
  #@(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'cis)))
    (then (drop (call $real (local.get $z)))))
  #@(local.set $x (call $coerce-float (call $part (local.get $z) (i32.const 0)) (i32.const 4)))
  #@(if (local.get $complex)
    (then (local.set $y (call $coerce-float (call $part (local.get $z) (i32.const 1)) (i32.const 4)))))
  (wat-symbol-case #@(local.get $id)
    ((sin cos tan cis)
      #@(if (i32.and (local.get $complex) (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'tan))))
        (then (call $complex-tan-f64 (local.get $x) (local.get $y))
          (local.set $i) (local.set $r))
        (else
          (call $sincos-f64 (local.get $x)) (local.set $c) (local.set $s)
          (if (local.get $complex)
            (then
              (if (f64.gt (f64.abs (local.get $y)) (f64.const 710.4758600739439))
                (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
                  (local.get $id) (local.get $args))))
              (call $sinhcosh-f64 (local.get $y)) (local.set $ch) (local.set $sh)
              (if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'sin)))
                (then (local.set $r (f64.mul (local.get $s) (local.get $ch)))
                  (local.set $i (f64.mul (local.get $c) (local.get $sh))))
                (else (local.set $r (f64.mul (local.get $c) (local.get $ch)))
                  (local.set $i (f64.neg (f64.mul (local.get $s) (local.get $sh)))))))
            (else
              (if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'cis)))
                (then (local.set $complex (i32.const 1)) (local.set $r (local.get $c)) (local.set $i (local.get $s)))
                (else (local.set $r (if (result f64) (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'sin)))
                  (then (local.get $s))
                  (else (if (result f64) (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'cos)))
                    (then (local.get $c)) (else (f64.div (local.get $s) (local.get $c))))))))))))))
    (exp
      #@(if (local.get $complex)
        (then
          (call $sincos-f64 (local.get $y)) (local.set $c) (local.set $s)
          (if (f64.gt (local.get $x) (f64.const 700))
            (then
              (local.set $h (call $exp-f64 (local.get $x) (i32.const -1)))
              (if (f64.gt (local.get $h) (f64.const 1.7976931348623157e308))
                (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
                  (local.get $id) (local.get $args))))
              (local.set $s (f64.mul (f64.const 2) (local.get $s)))
              (local.set $c (f64.mul (f64.const 2) (local.get $c))))
            (else (local.set $h (call $exp-f64 (local.get $x) (i32.const 0)))))
          (local.set $r (f64.mul (local.get $h) (local.get $c)))
          (local.set $i (f64.mul (local.get $h) (local.get $s))))
        (else (local.set $r (call $exp-f64 (local.get $x) (i32.const 0)))))
      ;; EXP has no mathematical zero. Diagnose loss to zero in the result
      ;; format, while allowing an exactly zero complex component.
      #@(if (i32.and (i32.eqz (ref.is_null (call $symbol-value
          (call $symbol (i32.const ,(runtime-symbol-id '*trap-floating-point-underflow*))))))
        (if (result i32) (i32.eq (local.get $kind) (i32.const 3))
        (then (i32.and (f64.le (f64.abs (local.get $r)) (f64.const 7.006492321624085e-46))
          (f64.le (f64.abs (local.get $i)) (f64.const 7.006492321624085e-46))))
        (else (i32.and (f64.eq (local.get $r) (f64.const 0)) (f64.eq (local.get $i) (f64.const 0))))))
        (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-underflow))
          (local.get $id) (local.get $args)))))
    ((sinh cosh tanh)
      #@(if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'tanh)))
        (then (call $complex-tan-f64 (local.get $y) (local.get $x))
          (local.set $r) (local.set $i))
        (else
          (if (f64.gt (f64.abs (local.get $x)) (f64.const 710.4758600739439))
            (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
              (local.get $id) (local.get $args))))
          (call $sinhcosh-f64 (local.get $x)) (local.set $ch) (local.set $sh)
          (if (local.get $complex)
            (then
              (call $sincos-f64 (local.get $y)) (local.set $c) (local.set $s)
              (if (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'sinh)))
                (then (local.set $r (f64.mul (local.get $sh) (local.get $c)))
                  (local.set $i (f64.mul (local.get $ch) (local.get $s))))
                (else (local.set $r (f64.mul (local.get $ch) (local.get $c)))
                  (local.set $i (f64.mul (local.get $sh) (local.get $s))))))
            (else (local.set $r (select (local.get $sh) (local.get $ch)
              (i32.eq (local.get $id) (i32.const ,(runtime-symbol-id 'sinh)))))))))))
  #@(if (result (ref eq)) (local.get $complex)
    (then (call $complex (call $elementary-float (local.get $kind) (local.get $r) (local.get $id) (local.get $args))
      (call $elementary-float (local.get $kind) (local.get $i) (local.get $id) (local.get $args))))
    (else (call $elementary-float (local.get $kind) (local.get $r) (local.get $id) (local.get $args)))))

(define-runtime-function $expt-float-product
    (($x f64) ($y f64) ($kind i32) ($args :nullable-object)) (f64)
  (:locals ($product f64))
  #@(if (f64.gt (f64.abs (local.get $x)) (f64.const 1))
    (then (if (f64.gt (f64.abs (local.get $y))
      (f64.div (f64.const 1.7976931348623157e308) (f64.abs (local.get $x))))
      (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
        (i32.const ,(runtime-symbol-id 'expt)) (local.get $args))))))
  #@(local.set $product (f64.mul (local.get $x) (local.get $y)))
  #@(if (i32.eq (local.get $kind) (i32.const 3))
    (then
      (if (f64.ge (f64.abs (local.get $product)) (f64.const 3.4028235677973366e38))
        (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
          (i32.const ,(runtime-symbol-id 'expt)) (local.get $args))))
      (local.set $product (f64.promote_f32 (f32.demote_f64 (local.get $product))))))
  #@(if (i32.and (i32.eqz (ref.is_null (call $symbol-value
      (call $symbol (i32.const ,(runtime-symbol-id '*trap-floating-point-underflow*))))))
    (i32.and (f64.eq (local.get $product) (f64.const 0))
      (i32.and (f64.ne (local.get $x) (f64.const 0)) (f64.ne (local.get $y) (f64.const 0)))))
    (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-underflow))
      (i32.const ,(runtime-symbol-id 'expt)) (local.get $args))))
  #@(local.get $product))

(define-runtime-function $expt-float-integer
    (($base :object) ($power :object) ($args :nullable-object)) (:object)
  (:locals ($kind i32) ($bit i32) ($x f64) ($result f64))
  #@(local.set $kind (call $tag (local.get $base)))
  #@(local.set $x (struct.get $obj $f (ref.cast (ref $obj) (local.get $base))))
  #@(local.set $bit (call $bitlength (local.get $power)))
  #@(if (i32.eqz (local.get $bit)) (then (return (call $float (local.get $kind) (f64.const 1)))))
  #@(if (i32.lt_s (call $value-n (local.get $power)) (i32.const 0))
    (then
      (if (f64.eq (local.get $x) (f64.const 0))
        (then (call $division-error (local.get $base) (local.get $power))))
      (if (f64.le (f64.abs (local.get $x)) (f64.const 5.562684646268003e-309))
        (then (call $elementary-error (i32.const ,(runtime-symbol-id 'floating-point-overflow))
          (i32.const ,(runtime-symbol-id 'expt)) (local.get $args))))
      (local.set $x (f64.div (f64.const 1) (local.get $x)))
      (local.set $x (call $expt-float-product (local.get $x) (f64.const 1) (local.get $kind) (local.get $args)))))
  #@(local.set $result (local.get $x))
  #@(local.set $bit (i32.sub (local.get $bit) (i32.const 1)))
  #@(block $done (loop $next
    (br_if $done (i32.eqz (local.get $bit)))
    (local.set $bit (i32.sub (local.get $bit) (i32.const 1)))
    (local.set $result (call $expt-float-product (local.get $result) (local.get $result) (local.get $kind) (local.get $args)))
    (if (i32.and (i32.shr_u (call $digit (local.get $power) (i32.div_u (local.get $bit) (i32.const 15)))
      (i32.rem_u (local.get $bit) (i32.const 15))) (i32.const 1))
      (then (local.set $result (call $expt-float-product (local.get $result) (local.get $x) (local.get $kind) (local.get $args)))))
    (br $next)))
  #@(call $float (local.get $kind) (local.get $result)))

(define-runtime-function $expt-transcendental (($base :object) ($power :object)) (:object)
  (:locals ($kind i32))
