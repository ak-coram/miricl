;;;; Native miricl threading facilities on the shared Wasm scheduler.
;;;; Public keyword conventions follow APIv2 to support a future library backend.
(in-package #:miricl-threads)

(defun %thread (op &optional a b) (miricl::%%thread op a b))
(defmacro %critical (&body body)
  (let ((old (gensym)))
    (list 'let (list (list old '(%thread 17 1)))
      (list 'unwind-protect (cons 'progn body) (list '%thread 13 old)))))

;; The low mask bit protects scheduler internals. The next bit defers interrupts
;; across explicit waits too. Nested scheduler critical sections retain it.
(defmacro without-interrupts (&body body)
  "Defer asynchronous Lisp interrupts in BODY, restoring the prior mask on exit."
  (list '%thread 19 (list 'function (list* 'lambda nil body)) nil))
(defmacro with-interrupts (&body body)
  "Enable asynchronous Lisp interrupts in BODY, restoring the prior mask on exit."
  (list '%thread 19 (list 'function (list* 'lambda nil body)) t))

(define-condition thread-error (error)
  ((message :initarg :message :reader %message))
  (:report (lambda (c stream) (write-string (%message c) stream))))
(define-condition abnormal-exit (thread-error)
  ((condition :initarg :condition :reader abnormal-exit-condition)
   (thread :initarg :thread :reader abnormal-exit-thread)))
(defun %error (message) (error 'thread-error :message message))

(defstruct (thread (:constructor %new-thread (native name))) native name joiners)
(defun threadp (object) (thread-p object))
(defun current-thread () (%thread 3 (%thread 0)))
(defun thread-alive-p (thread) (check-type thread thread) (%thread 7 (thread-native thread)))
(defun all-threads () (%thread 11))
(defun thread-yield () (%thread 4) (values))
(defun start-multiprocessing () nil)
(defconstant +supports-threads-p+ t)
(defparameter *standard-io-bindings*
  '((*package* . (find-package :cl-user)) (*readtable* . (copy-readtable nil))
    (*read-base* . 10) (*read-default-float-format* . 'single-float)
    (*read-eval* . t) (*read-suppress* . nil)
    (*print-array* . t) (*print-base* . 10) (*print-case* . :upcase)
    (*print-escape* . t) (*print-gensym* . t) (*print-pretty* . nil)
    (*print-circle* . nil) (*print-level* . nil) (*print-length* . nil)
    (*print-lines* . nil) (*print-miser-width* . nil)
    (*print-pprint-dispatch* . (copy-pprint-dispatch nil))
    (*print-radix* . nil) (*print-readably* . t) (*print-right-margin* . nil)
    (*random-state* . (make-random-state t))))
(defparameter *default-special-bindings* nil)

(defun %entry (thread function bindings)
  (let ((outcome
          (catch '%thread-exit
            (handler-case
                (progn
                  (%thread 16)
                  (let ((bindings (remove-duplicates bindings :key #'car :from-end t)))
                    (progv (mapcar #'car bindings)
                        (mapcar (lambda (binding) (eval (cdr binding))) bindings)
                      (cons (multiple-value-list
                        (if (or (miricl::%%debugger 11) *debugger-hook*)
                            (handler-bind ((serious-condition #'miricl-debugger::%unhandled-thread-condition))
                              (funcall function))
                            (funcall function))) nil))))
              (serious-condition (condition) (cons nil condition))))))
    (%finish thread outcome)))
(defun %finish (thread outcome)
  (%critical
    (%thread 8 (thread-native thread) outcome)
    (dolist (waiter (thread-joiners thread)) (%thread 6 (thread-native waiter)))
    (setf (thread-joiners thread) nil))
  nil)
(defun %host-failed (thread)
  (%finish thread (cons nil (make-condition 'thread-error
    :message "The host terminated the thread with an exception."))))
(defun make-thread (function &key (name "Anonymous thread") (initial-bindings *default-special-bindings*))
  (check-type function function)
  (setq name (or name "Anonymous thread"))
  (check-type name string)
  (unless (%thread 14) (%error "This host must enter the asynchronous green-thread driver first."))
  (%critical
    (let* ((thread (%new-thread nil name))
           (native (%thread 1 (lambda () (%entry thread function initial-bindings)))))
      (setf (thread-native thread) native)
      (%thread 2 native thread))))
(defun join-thread (thread)
  (check-type thread thread)
  (when (eq thread (current-thread)) (%error "A thread cannot join itself."))
  (%critical
    (unwind-protect
        (loop while (thread-alive-p thread) do
          (pushnew (current-thread) (thread-joiners thread))
          (%thread 5))
      (setf (thread-joiners thread) (remove (current-thread) (thread-joiners thread)))))
  (let ((condition (%thread 10 (thread-native thread))))
    (when condition
      (error 'abnormal-exit :thread thread :condition condition :message "The joined thread exited abnormally.")))
  (values-list (%thread 9 (thread-native thread))))
(defun interrupt-thread (thread function &rest arguments)
  (check-type thread thread)
  (check-type function function)
  (%critical
    (unless (thread-alive-p thread) (%error "Cannot interrupt a terminated thread."))
    (%thread 12 (thread-native thread)
      (if arguments (lambda () (apply function arguments)) function)))
  (values))
(defun destroy-thread (thread)
  (when (eq thread (current-thread)) (%error "Cannot destroy the current thread."))
  (interrupt-thread thread (lambda ()
    (throw '%thread-exit (cons nil (make-condition 'thread-error :message "Thread was destroyed.")))))
  (values))

(define-condition timeout (serious-condition)
  ((length :initarg :length :reader %timeout-length))
  (:report "A thread timeout occurred."))
(defun %call-with-timeout (seconds function)
  (check-type seconds (real 0 *))
  (let* ((owner (current-thread)) (active t)
         (timer (make-thread (lambda ()
           (sleep seconds)
           (interrupt-thread owner (lambda () (when active (error 'timeout :length seconds)))))
           :name "Timeout")))
    (unwind-protect (funcall function)
      (%critical (setq active nil)
        (when (thread-alive-p timer) (destroy-thread timer))))))
(defmacro with-timeout ((seconds) &body body)
  (list '%call-with-timeout seconds (cons 'lambda (cons nil body))))

(defstruct (lock (:constructor %new-lock (name recursive))) name recursive owner (depth 0) waiters)
(defun lockp (object) (and (lock-p object) (not (lock-recursive object))))
(defun recursive-lock-p (object) (and (lock-p object) (lock-recursive object)))
(deftype recursive-lock () '(and lock (satisfies recursive-lock-p)))
(defun make-lock (&key name)
  (check-type name (or null string))
  (%new-lock name nil))
(defun make-recursive-lock (&key name)
  (check-type name (or null string))
  (%new-lock name t))
(defun %deadline (timeout)
  (when timeout
    (check-type timeout (real 0 *))
    (+ (get-internal-real-time) (* timeout internal-time-units-per-second))))
(defun %remaining (deadline)
  (when deadline (max 0 (/ (- deadline (get-internal-real-time)) internal-time-units-per-second))))
(defun acquire-lock (lock &key (wait t) timeout)
  (check-type lock (satisfies lockp))
  (%acquire-lock lock wait timeout))
(defun %acquire-lock (lock wait-p timeout)
  (let ((deadline (%deadline timeout)) (me (current-thread)))
    (%critical
      (loop
        (when (or (null (lock-owner lock)) (and (eq (lock-owner lock) me) (lock-recursive lock)))
          (setf (lock-owner lock) me)
          (setf (lock-depth lock) (1+ (lock-depth lock)))
          (return t))
        (when (eq (lock-owner lock) me) (%error "The current thread already owns this nonrecursive lock."))
        (unless wait-p (return nil))
        (when (and deadline (zerop (%remaining deadline))) (return nil))
        (unwind-protect
            (progn (setf (lock-waiters lock) (append (lock-waiters lock) (list me)))
              (%thread 5 (%remaining deadline)))
          (setf (lock-waiters lock) (remove me (lock-waiters lock))))))))
(defun release-lock (lock)
  (check-type lock (satisfies lockp))
  (%release-lock lock))
(defun %release-lock (lock)
  (%critical
    (unless (eq (lock-owner lock) (current-thread)) (%error "Only the owning thread may release a lock."))
    (setf (lock-depth lock) (1- (lock-depth lock)))
    (when (zerop (lock-depth lock))
      (setf (lock-owner lock) nil)
      (dolist (waiter (lock-waiters lock)) (%thread 6 (thread-native waiter)))))
  lock)
(defun acquire-recursive-lock (lock &key (wait t) timeout)
  (check-type lock recursive-lock)
  (%acquire-lock lock wait timeout))
(defun release-recursive-lock (lock)
  (check-type lock recursive-lock)
  (%release-lock lock))
(defun %lock-form (place timeout body acquire release)
  (let ((lock (gensym)))
    (list 'let (list (list lock place))
      (list 'when (list acquire lock :wait t :timeout timeout)
        (list 'unwind-protect (cons 'locally body) (list release lock))))))
(defmacro with-lock-held ((place &key timeout) &body body)
  (%lock-form place timeout body 'acquire-lock 'release-lock))
(defmacro with-recursive-lock-held ((place &key timeout) &body body)
  (%lock-form place timeout body 'acquire-recursive-lock 'release-recursive-lock))

(defstruct (condition-variable (:constructor %new-condition-variable (name))) name waiters)
(defun make-condition-variable (&key name)
  (check-type name (or null string))
  (%new-condition-variable name))
(defun condition-wait (condition-variable lock &key timeout)
  (check-type condition-variable condition-variable)
  (check-type lock (satisfies lockp))
  (let ((deadline (%deadline timeout)) (me (current-thread)) (notified nil))
    (%critical
      (unless (and (eq (lock-owner lock) me) (= (lock-depth lock) 1))
        (%error "CONDITION-WAIT requires a lock held exactly once by the calling thread."))
      (let ((waiter (cons me nil)))
        (setf (condition-variable-waiters condition-variable)
          (append (condition-variable-waiters condition-variable) (list waiter)))
        (release-lock lock)
        (unwind-protect
            (progn (%thread 5 (%remaining deadline)) (setq notified (cdr waiter)))
          (setf (condition-variable-waiters condition-variable)
            (remove waiter (condition-variable-waiters condition-variable)))
          (acquire-lock lock :wait t))))
    notified))
(defun condition-notify (condition-variable)
  (check-type condition-variable condition-variable)
  (%critical
    (let ((waiter (car (condition-variable-waiters condition-variable))))
      (setf (condition-variable-waiters condition-variable)
        (cdr (condition-variable-waiters condition-variable)))
      (when waiter (setf (cdr waiter) t) (%thread 6 (thread-native (car waiter))))))
  nil)
(defun condition-broadcast (condition-variable)
  (check-type condition-variable condition-variable)
  (%critical
    (loop while (condition-variable-waiters condition-variable) do (condition-notify condition-variable)))
  nil)

(defstruct (semaphore (:constructor %new-semaphore (name count lock condition))) name count lock condition)
(defun semaphorep (object) (semaphore-p object))
(defun make-semaphore (&key name (count 0))
  (check-type name (or null string))
  (check-type count (integer 0 *))
  (%new-semaphore name count (make-lock) (make-condition-variable)))
(defun signal-semaphore (semaphore &key (count 1))
  (check-type semaphore semaphore)
  (check-type count (integer 0 *))
  (with-lock-held ((semaphore-lock semaphore))
    (setf (semaphore-count semaphore) (+ (semaphore-count semaphore) count))
    (condition-broadcast (semaphore-condition semaphore)))
  t)
(defun wait-on-semaphore (semaphore &key timeout)
  (check-type semaphore semaphore)
  (let ((deadline (%deadline timeout)))
    (with-lock-held ((semaphore-lock semaphore))
      (loop while (zerop (semaphore-count semaphore)) do
        (when (and deadline (zerop (%remaining deadline))) (return-from wait-on-semaphore nil))
        (condition-wait (semaphore-condition semaphore) (semaphore-lock semaphore) :timeout (%remaining deadline)))
      (setf (semaphore-count semaphore) (1- (semaphore-count semaphore))) t)))

;; A Wasm32 counter. Scheduling is suppressed across read/modify/write;
;; Lisp objects still live in the common WasmGC heap, without shared memory.
(defstruct (atomic-integer (:constructor %new-atomic-integer (cell))) cell)
(defconstant %atomic-integer-mask (1- (ash 1 32)))
(defun make-atomic-integer (&key (value 0))
  (check-type value (unsigned-byte 32))
  (%new-atomic-integer value))
(defun atomic-integer-value (integer)
  (check-type integer atomic-integer)
  (atomic-integer-cell integer))
(defun (setf atomic-integer-value) (value integer)
  (check-type integer atomic-integer)
  (check-type value (unsigned-byte 32))
  (%critical (setf (atomic-integer-cell integer) value)))
(defun atomic-integer-compare-and-swap (integer old new)
  (check-type integer atomic-integer)
  (check-type old (unsigned-byte 32))
  (check-type new (unsigned-byte 32))
  (%critical
    (when (= (atomic-integer-cell integer) old)
      (setf (atomic-integer-cell integer) new) t)))
(defun atomic-integer-incf (integer &optional (delta 1))
  (check-type integer atomic-integer)
  (check-type delta (unsigned-byte 32))
  (%critical (setf (atomic-integer-cell integer)
    (logand %atomic-integer-mask (+ (atomic-integer-cell integer) delta)))))
(defun atomic-integer-decf (integer &optional (delta 1))
  (check-type integer atomic-integer)
  (check-type delta (unsigned-byte 32))
  (%critical (setf (atomic-integer-cell integer)
    (logand %atomic-integer-mask (- (atomic-integer-cell integer) delta)))))

(%thread 2 (%thread 0) (%new-thread (%thread 0) "Main thread"))
(pushnew :miricl-threads *features*)
